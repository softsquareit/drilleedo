parameters:
    level: 5
    paths:
        - src
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    ignoreErrors:
        # Doctrine repository methods not yet typed (ServiceEntityRepository uses @method phpdoc)
        - '#Call to an undefined method Doctrine\\ORM\\EntityRepository#'
        # Pre-existing: inherited if(true) placeholder in editProfessional photo upload
        - message: '#If condition is always true#'
          path: src/Controller/Admin/ProfessionalController.php
