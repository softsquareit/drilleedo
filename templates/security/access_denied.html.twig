{% extends 'base.html.twig' %}

{% block title %}Access Denied | Drilleedo{% endblock %}

{% block body %}
<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="mb-4">
                <i class="feather-lock text-danger" style="font-size: 4rem;"></i>
            </div>
            <h1 class="display-5 fw-bold text-dark mb-3">Access Denied</h1>
            <p class="lead text-muted mb-5">
                Sorry, you do not have permission to access the requested page or perform this action.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a href="{{ path('app_home') }}" class="btn btn-primary rounded-pill px-4 py-2" style="background-color: var(--color-primary); border: none;">
                    <i class="feather-arrow-left me-2"></i> Return to Homepage
                </a>
                {% if is_granted('ROLE_USER') %}
                    {% if is_granted('ROLE_PROFESSIONAL') %}
                        <a href="{{ path('professional_dashboard') }}" class="btn btn-outline-dark rounded-pill px-4 py-2">
                            Go to Dashboard
                        </a>
                    {% elseif is_granted('ROLE_COMPANY') %}
                        <a href="{{ path('company_dashboard') }}" class="btn btn-outline-dark rounded-pill px-4 py-2">
                            Go to Dashboard
                        </a>
                    {% elseif is_granted('ROLE_INDIVIDUAL') %}
                        <a href="{{ path('individual_dashboard') }}" class="btn btn-outline-dark rounded-pill px-4 py-2">
                            Go to Dashboard
                        </a>
                    {% endif %}
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-outline-dark rounded-pill px-4 py-2">
                        Login
                    </a>
                {% endif %}
            </div>
            <div class="mt-5 text-muted small">
                If you believe this is an error, please contact <a href="mailto:support@drilleedo.com" class="text-decoration-none">support@drilleedo.com</a>.
            </div>
        </div>
    </div>
</div>
{% endblock %}
