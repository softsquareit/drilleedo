{% extends 'base.html.twig' %}

{% block title %}{{ 'security.login_title'|trans }} | Drilleedo{% endblock %}
{% block meta_description %}Log in to your Drilleedo account to manage your renovation projects, receive quotes from professionals, and communicate with contractors across Canada.{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --drl-navy: #0d2151;
            --drl-blue: #00509e;
            --drl-orange: #e8501a;
            --drl-orange-hover: #c43d10;
            --glass-bg: rgba(255, 255, 255, 0.9);
            --glass-border: rgba(255, 255, 255, 0.2);
        }

        body {
            background: #f8fafc;
        }

        .auth-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: stretch;
            background: #fff;
        }

        /* Left Side: Immersive Brand Side */
        .auth-side-brand {
            flex: 1;
            position: relative;
            background: linear-gradient(135deg, var(--drl-navy) 0%, var(--drl-blue) 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 80px;
            color: #fff;
            overflow: hidden;
        }

        .auth-side-brand::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('{{ asset('uploads/banners/login.png') }}') center/cover no-repeat;
            opacity: 0.15;
            z-index: 1;
        }

        .auth-side-brand::after {
            content: '';
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(232, 80, 26, 0.2) 0%, transparent 70%);
            bottom: -150px;
            left: -150px;
            border-radius: 50%;
            z-index: 2;
        }

        .auth-brand-content {
            position: relative;
            z-index: 10;
            max-width: 500px;
        }

        .auth-logo {
            font-size: 32px;
            font-weight: 900;
            color: #fff;
            margin-bottom: 40px;
            display: block;
            text-decoration: none;
        }

        .auth-logo span { color: var(--drl-orange); }

        .auth-brand-title {
            font-size: 48px;
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 24px;
            letter-spacing: -1px;
            color: #fff;
        }

        .auth-brand-text {
            font-size: 18px;
            color: rgba(255, 255, 255, 0.9);
            line-height: 1.6;
            margin-bottom: 40px;
        }

        .auth-stats {
            display: flex;
            gap: 40px;
        }

        .auth-stat-item h4 {
            font-size: 24px;
            font-weight: 800;
            color: #ff9d66; /* Lighter orange for better contrast on navy */
            margin-bottom: 4px;
        }

        .auth-stat-item p {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.6);
            margin: 0;
        }

        /* Right Side: Form Side */
        .auth-side-form {
            width: 550px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 80px;
            background: #fff;
            position: relative;
        }

        .auth-form-header {
            margin-bottom: 40px;
        }

        .auth-form-header h2 {
            font-size: 32px;
            font-weight: 800;
            color: var(--drl-navy);
            margin-bottom: 8px;
        }

        .auth-form-header p {
            color: #64748b;
            font-size: 16px;
        }

        /* Premium Inputs */
        .form-group-premium {
            margin-bottom: 24px;
            position: relative;
        }

        .form-group-premium label {
            display: block;
            font-size: 14px;
            font-weight: 700;
            color: var(--drl-navy);
            margin-bottom: 8px;
            transition: color 0.2s;
        }

        .form-control-premium {
            width: 100%;
            height: 56px;
            background: #f8fafc;
            border: 2px solid #f1f5f9;
            border-radius: 12px;
            padding: 0 20px;
            font-size: 16px;
            font-weight: 500;
            color: var(--drl-navy);
            transition: all 0.2s;
        }

        .form-control-premium:focus {
            background: #fff;
            border-color: var(--drl-blue);
            box-shadow: 0 0 0 4px rgba(0, 80, 158, 0.1);
            outline: none;
        }

        .form-control-premium:focus + label {
            color: var(--drl-blue);
        }

        /* Remember & Forgot */
        .auth-flex {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 32px;
        }

        .auth-checkbox {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            user-select: none;
        }

        .auth-checkbox input {
            width: 20px;
            height: 20px;
            accent-color: var(--drl-orange);
            cursor: pointer;
        }

        .auth-checkbox span {
            font-size: 14px;
            font-weight: 600;
            color: #475569;
        }

        .forgot-link {
            font-size: 14px;
            font-weight: 700;
            color: var(--drl-blue);
            text-decoration: none;
        }

        .forgot-link:hover { text-decoration: underline; }

        /* Login Button */
        .btn-auth {
            width: 100%;
            height: 56px;
            background: var(--drl-orange);
            color: #fff;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 8px 24px rgba(232, 80, 26, 0.2);
        }

        .btn-auth:hover {
            background: var(--drl-orange-hover);
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(232, 80, 26, 0.3);
        }

        .auth-footer {
            margin-top: 40px;
            text-align: center;
            font-size: 15px;
            color: #64748b;
        }

        .auth-footer a {
            font-weight: 700;
            color: var(--drl-blue);
            text-decoration: none;
        }

        .auth-footer a:hover { text-decoration: underline; }

        /* Responsive */
        @media (max-width: 1024px) {
            .auth-side-brand { display: none; }
            .auth-side-form { width: 100%; padding: 40px; align-items: center; }
            .auth-side-form > div, .auth-side-form form { width: 100%; max-width: 450px; }
        }

        @media (max-width: 576px) {
            .auth-side-form { padding: 30px 20px; }
            .auth-brand-title { font-size: 32px; }
        }
    </style>
{% endblock %}

{% block body %}
<div class="auth-wrapper">
    <!-- Left Side: Brand Immersive -->
    <div class="auth-side-brand">
        <div class="auth-brand-content">
            <a href="{{ path('app_home') }}" class="auth-logo">Drilleedo<span>.</span></a>
            <h1 class="auth-brand-title">{{ 'security.hero_title'|trans|raw }}</h1>
            <p class="auth-brand-text">{{ 'security.hero_desc'|trans }}</p>
            
            <div class="auth-stats">
                <div class="auth-stat-item">
                    <h4>1.5k+</h4>
                    <p>{{ 'security.stat_pros'|trans }}</p>
                </div>
                <div class="auth-stat-item">
                    <h4>10k+</h4>
                    <p>{{ 'security.stat_projects'|trans }}</p>
                </div>
                <div class="auth-stat-item">
                    <h4>4.9/5</h4>
                    <p>{{ 'security.stat_rating'|trans }}</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Side: Login Form -->
    <div class="auth-side-form">
        <div>
            <div class="auth-form-header">
                <h2>{{ 'security.welcome'|trans }}</h2>
                <p>{{ 'security.welcome_sub'|trans }}</p>
            </div>

            <form method="post">
                {% if error %}
                    <div class="alert alert-danger border-0 rounded-4 p-3 mb-4" style="background: #fff1f2; color: #e11d48; font-size: 14px; font-weight: 600;">
                        <i class="feather-alert-circle me-2"></i> {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="alert alert-info border-0 rounded-4 p-3 mb-4" style="background: #f0f9ff; color: #0369a1; font-size: 14px;">
                        {{ 'security.logged_in_as'|trans }} <strong>{{ app.user.userIdentifier }}</strong>, <a href="{{ path('app_logout') }}" class="text-danger fw-bold">{{ 'auth.logout'|trans }}</a>
                    </div>
                {% endif %}

                <div class="form-group-premium">
                    <label for="username">{{ 'security.email'|trans }}</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control-premium" placeholder="name@company.com" required autofocus autocomplete="email">
                </div>

                <div class="form-group-premium">
                    <label for="password">{{ 'security.password'|trans }}</label>
                    <input type="password" name="_password" id="password" class="form-control-premium" placeholder="••••••••" required autocomplete="current-password">
                </div>

                <div class="auth-flex">
                    <label class="auth-checkbox">
                        <input type="checkbox" name="_remember_me" checked>
                        <span>{{ 'security.remember_me'|trans }}</span>
                    </label>
                    <a href="{{ path('contact') }}?subject=Password+Reset" class="forgot-link">{{ 'security.forgot_password'|trans }}</a>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn-auth">
                    {{ 'security.sign_in'|trans }} <i class="feather-arrow-right"></i>
                </button>

                <div class="auth-footer">
                    {{ 'security.no_account'|trans }} <a href="{{ path('app_register') }}">{{ 'security.register_link'|trans }}</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
