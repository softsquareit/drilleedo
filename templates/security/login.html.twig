{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}



    <div class="rbt-page-banner-wrapper">
    <!-- Banner BG Image -->
        <div class="rbt-banner-image" style="background-image: url('{{ asset('uploads/banners/login.png') }}');"></div>

    <div class="rbt-banner-content">
        <div class="rbt-banner-content-top">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                           <h1 class="hero-main-title  text-center " style="font-size: var(--h1);">Welcome back! Quick access</h1>
                        <br><br>
                    </div>
                    <div class="container">
            <div class="row gy-5 row--30">
                <div class="col-lg-6 offset-lg-3">
                    <div class="rbt-contact-form contact-form-style-1 max-width-auto shadow-lg p-5 rounded-3 border-top-4 border-primary">
                        <h3 class="title text-center mb-4 hero-main-title">Login</h3>
                        <form method="post">
                            {% if error %}
                                <div class="alert alert-danger rbt-alert-danger mb-4">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                            {% endif %}

                            {% if app.user %}
                                <div class="mb-3 text-center">
                                    You are logged in as <span class="fw-bold">{{ app.user.userIdentifier }}</span>, <a href="{{ logout_path() }}" class="text-danger">Logout</a>
                                </div>
                            {% endif %}

                            <div class="form-group">
                                <input name="_username" value="{{ last_username }}" type="email" required autofocus />
                                <label>Email address *</label>
                                <span class="focus-border"></span>
                            </div>
                            <div class="form-group">
                                <input name="_password" type="password" required>
                                <label>Password *</label>
                                <span class="focus-border"></span>
                            </div>

                            <div class="row mb--30 align-items-center">
                                <div class="col-lg-6">
                                    <div class="rbt-checkbox">
                                        <input type="checkbox" id="rememberme" name="_remember_me">
                                        <label for="rememberme">Remember me</label>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="rbt-lost-password text-end">
                                        <a class="rbt-btn-link" href="#">Lost your password?</a>
                                    </div>
                                </div>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="form-submit-group mt-4">
                                <button type="submit" class="rbt-btn btn-md btn-gradient hover-icon-reverse w-100">
                                    <span class="icon-reverse-wrapper">
                                        <span class="btn-text">Log In</span>
                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                    </span>
                                </button>
                            </div>

                            <div class="text-center mt-4 text-muted">
                                Don't have an account? <a href="{{ path('app_register') }}" class="text-primary fw-bold">Register Now</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
                </div>
            </div>
        </div>
    </div>
</div>


{% endblock %}
