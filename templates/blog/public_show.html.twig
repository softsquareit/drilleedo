{% extends 'base.html.twig' %}

{% block title %}{{ blog.title }} – Drilleedo{% endblock %}

{% block body %}
    <div class="rbt-page-banner-wrapper">
        <div class="rbt-banner-image" style="background-image: url('{{ asset('uploads/banners/smartideas.png') }}');"></div>
        <div class="rbt-banner-content">
            <div class="rbt-banner-content-top">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <ul class="page-list">
                                <li class="rbt-breadcrumb-item"><a href="{{ path('app_home') }}">Home</a></li>
                                <li><div class="icon-right"><i class="feather-chevron-right"></i></div></li>
                                <li class="rbt-breadcrumb-item"><a href="{{ path('public_blog_list') }}">Blogs</a></li>
                                <li><div class="icon-right"><i class="feather-chevron-right"></i></div></li>
                                <li class="rbt-breadcrumb-item active">{{ blog.title }}</li>
                            </ul>
                            <div class="title-wrapper">
                                <h1 class="hero-main-title">{{ blog.title }}</h1>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="rbt-blog-details-area rbt-section-gapBottom mt--80">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-8 offset-lg-2">
                    <div class="content">
                        <div class="post-thumbnail mb--30">
                            <img class="w-100 radius-10" src="{{ blog.mainImg ? (blog.mainImg starts with 'http' ? blog.mainImg : asset('uploads/blog/' ~ blog.mainImg)) : asset('assets/drilleedo/images/bg/bg-image-1.jpg') }}" alt="{{ blog.title }}">
                        </div>
                        
                        <div class="blog-content-inner">
                            {{ blog.description|raw }}
                        </div>

                        <div class="rbt-comment-area mt--60">
                            <h4 class="title">{{ blog.comments|length }} Comments</h4>
                            <ul class="comment-list">
                                {% for comment in blog.comments %}
                                    <li class="comment">
                                        <div class="comment-body">
                                            <div class="single-comment">
                                                <div class="comment-img">
                                                    <img src="{{ asset('assets/drilleedo/images/testimonial/client-01.png') }}" alt="User">
                                                </div>
                                                <div class="comment-inner">
                                                    <h6 class="title">{{ comment.user.email }}</h6>
                                                    <span class="date">{{ comment.createdAt|date('M d, Y') }}</span>
                                                    <p>{{ comment.content }}</p>
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>

                        <div class="rbt-comment-form mt--60">
                            <h4 class="title">Leave a Reply</h4>
                            {{ form_start(commentForm) }}
                                <div class="row g-5">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            {{ form_widget(commentForm.content, {'attr': {'placeholder': 'Your Comment'}}) }}
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <button class="rbt-btn btn-gradient" type="submit">Post Comment</button>
                                    </div>
                                </div>
                            {{ form_end(commentForm) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
