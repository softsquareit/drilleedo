{% extends 'base.html.twig' %}

{% block title %}{{ pageTitle }} | Drilleedo Canada{% endblock %}
{% block meta_description %}Discover the latest {{ pageTitle|lower }} and inspiration on Drilleedo.{% endblock %}

{% block body %}
<main id="main-content">
<style>
/* ══ BLOGS & IDEAS PAGE ══════════════════════════════════════════════════
   Design charter based on /home-renovation-ideas.
   ═════════════════════════════════════════════════════════════════════════ */

/* ── 1. Hero ── */
.si-hero {
  min-height: 280px;
  background: linear-gradient(120deg, #0d2151 0%, #1a3a6b 50%, #00509e 100%);
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.si-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--si-bg-img) center / cover no-repeat;
  opacity: 0.08;
}

.si-hero::after {
  content: '';
  position: absolute;
  right: -120px;
  bottom: -120px;
  width: 400px;
  height: 400px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232,80,26,0.18) 0%, transparent 70%);
  pointer-events: none;
}

.si-hero__inner {
  position: relative;
  z-index: 2;
  padding: 60px 0;
}

.si-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.9);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 999px;
  padding: 6px 16px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  margin-bottom: 16px;
}

.si-hero__title {
  font-size: clamp(28px, 4.5vw, 50px);
  font-weight: 900;
  color: #fff;
  margin: 0 0 14px;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.si-hero__title span { color: #f97316; }

.si-hero__sub {
  font-size: 17px;
  color: rgba(255,255,255,0.75);
  max-width: 540px;
  line-height: 1.7;
  margin-bottom: 26px;
}

.si-hero__count {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.12);
  color: #fff;
  border: 1px solid rgba(255,255,255,0.22);
  border-radius: 8px;
  padding: 9px 18px;
  font-size: 14px;
  font-weight: 700;
}

.si-hero__count span { color: #f97316; font-size: 18px; font-weight: 900; }

/* ── 2. Category chips strip ── */
.si-cats {
  background: #fff;
  border-bottom: 1px solid #e2e8f0;
  box-shadow: 0 2px 8px rgba(13,33,81,0.05);
  position: sticky;
  top: 0;
  z-index: 40;
  overflow-x: auto;
}

.si-cats::-webkit-scrollbar { height: 0; }

.si-cats__inner {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 28px;
  max-width: 1200px;
  margin: 0 auto;
  min-width: max-content;
}

.si-cat-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 16px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
  cursor: pointer;
  border: 1.5px solid #e2e8f0;
  background: #fff;
  color: #334155;
  transition: all 0.15s;
  text-decoration: none;
}

.si-cat-chip:hover,
.si-cat-chip.active {
  background: #0d2151;
  color: #fff;
  border-color: #0d2151;
}

/* ── 3. Main layout wrapper ── */
.si-page { max-width: 1200px; margin: 0 auto; padding: 0 28px; }
.si-wrap  { padding: 52px 0 80px; }

/* ── 4. Featured block (hero card + 3 side) ── */
.si-featured {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 40px;
}

.si-card-main {
  border-radius: 16px;
  overflow: hidden;
  background: #fff;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(13,33,81,0.06);
  display: flex;
  flex-direction: column;
  transition: transform 0.22s, box-shadow 0.22s;
}

.si-card-main:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 36px rgba(13,33,81,0.13);
}

.si-card-main__img {
  height: 260px;
  overflow: hidden;
  position: relative;
}

.si-card-main__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.38s;
}

.si-card-main:hover .si-card-main__img img { transform: scale(1.05); }

.si-card-main__body {
  padding: 22px 22px 20px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.si-card-cat {
  display: inline-block;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: #00509e;
  background: #e8f4fd;
  border-radius: 999px;
  padding: 3px 10px;
  margin-bottom: 10px;
  align-self: flex-start;
}

.si-card-main__title {
  font-size: 20px;
  font-weight: 900;
  color: #0d2151;
  margin: 0 0 10px;
  line-height: 1.25;
}

.si-card-main__title a { color: inherit; text-decoration: none; }
.si-card-main__title a:hover { color: #00509e; }

.si-card-main__desc {
  font-size: 14px;
  color: #64748b;
  line-height: 1.7;
  flex: 1;
  margin-bottom: 16px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.si-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
  font-weight: 700;
  color: #e8501a;
  text-decoration: none;
  transition: gap 0.15s;
  margin-top: auto;
}

.si-link:hover { gap: 10px; color: #c43d10; }

.si-side-col { display: flex; flex-direction: column; gap: 14px; }

.si-card-side {
  display: flex;
  gap: 14px;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s;
  flex: 1;
}

.si-card-side:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(13,33,81,0.1);
}

.si-card-side__img {
  width: 120px;
  flex-shrink: 0;
  overflow: hidden;
  position: relative;
}

.si-card-side__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.35s;
}

.si-card-side:hover .si-card-side__img img { transform: scale(1.07); }

.si-card-side__body {
  padding: 14px 14px 14px 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
}

.si-card-side__title {
  font-size: 15px;
  font-weight: 800;
  color: #0d2151;
  margin: 0 0 8px;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.si-card-side__title a { color: inherit; text-decoration: none; }
.si-card-side__title a:hover { color: #00509e; }

/* ── 5. Separator ── */
.si-sep {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 28px;
}

.si-sep__line { flex: 1; height: 1px; background: #e2e8f0; }

.si-sep__label {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: #e8f4fd;
  color: #00509e;
  border: 1px solid rgba(0,80,158,0.18);
  border-radius: 999px;
  padding: 6px 16px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  white-space: nowrap;
}

/* ── 6. Grid ── */
.si-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 52px;
}

.si-card-grid {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.22s, box-shadow 0.22s;
}

.si-card-grid:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 32px rgba(13,33,81,0.11);
}

.si-card-grid__img {
  height: 200px;
  overflow: hidden;
  position: relative;
}

.si-card-grid__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.38s;
}

.si-card-grid:hover .si-card-grid__img img { transform: scale(1.06); }

.si-card-grid__body {
  padding: 20px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.si-card-grid__title {
  font-size: 18px;
  font-weight: 800;
  color: #0d2151;
  margin: 0 0 10px;
  line-height: 1.3;
}

.si-card-grid__title a { color: inherit; text-decoration: none; }
.si-card-grid__title a:hover { color: #00509e; }

.si-card-grid__desc {
  font-size: 14px;
  color: #64748b;
  line-height: 1.65;
  flex: 1;
  margin-bottom: 16px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── 7. Pagination ── */
.si-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-top: 8px;
}

.si-pagination a,
.si-pagination span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  border: 1.5px solid #e2e8f0;
  color: #0d2151;
  background: #fff;
  transition: all 0.15s;
}

.si-pagination a:hover { background: #0d2151; color: #fff; border-color: #0d2151; }
.si-pagination span.active { background: #00509e; color: #fff; border-color: #00509e; }

/* ── 8. Empty state ── */
.si-empty {
  text-align: center;
  padding: 40px 20px;
  grid-column: 1 / -1;
  background: #fff;
  border-radius: 16px;
  border: 1px dashed #cbd5e1;
  margin-bottom: 40px;
}

.si-empty__icon { font-size: 48px; margin-bottom: 16px; color: #64748b; }
.si-empty h4 { font-size: 20px; font-weight: 800; color: #0d2151; margin-bottom: 8px; }
.si-empty p  { font-size: 14px; color: #64748b; }

/* ── 9. CTA Banner ── */
.si-cta-banner {
  background: linear-gradient(120deg, #0d2151 0%, #1a3a6b 60%, #00509e 100%);
  border-radius: 16px;
  padding: 40px 36px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 40px;
  flex-wrap: wrap;
}

.si-cta-banner__text h3 {
  font-size: 22px;
  font-weight: 900;
  color: #fff;
  margin: 0 0 6px;
}

.si-cta-banner__text p {
  font-size: 14px;
  color: rgba(255,255,255,0.7);
  margin: 0;
}

.si-cta-banner__btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #e8501a;
  color: #fff;
  font-size: 14px;
  font-weight: 800;
  padding: 12px 24px;
  border-radius: 8px;
  text-decoration: none;
  white-space: nowrap;
  box-shadow: 0 4px 16px rgba(232,80,26,0.3);
  transition: background 0.15s, transform 0.15s;
}

.si-cta-banner__btn:hover { background: #c43d10; color: #fff; transform: translateY(-2px); }

/* ── 10. Trust Strip ── */
.si-trust-strip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
  margin: 60px 0 20px;
  padding-top: 40px;
  border-top: 1px solid #e2e8f0;
}

.si-trust-item {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 700;
  color: #64748b;
  background: #f8fafc;
  padding: 8px 16px;
  border-radius: 999px;
  border: 1px solid #e2e8f0;
}

.si-trust-item i { color: #e8501a; font-size: 16px; }

/* ── 11. Pro Reminder ── */
.si-pro-reminder {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  padding: 36px 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 60px;
  flex-wrap: wrap;
}

.si-pro-reminder__content h3 {
  font-size: 20px;
  font-weight: 900;
  color: #0d2151;
  margin: 0 0 8px;
}

.si-pro-reminder__content p {
  font-size: 14px;
  color: #64748b;
  margin: 0;
}

.si-pro-reminder__btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #fff;
  color: #0d2151;
  border: 2px solid #0d2151;
  font-size: 14px;
  font-weight: 800;
  padding: 12px 24px;
  border-radius: 8px;
  text-decoration: none;
  white-space: nowrap;
  transition: all 0.15s;
}

.si-pro-reminder__btn:hover {
  background: #0d2151;
  color: #fff;
}

/* ── Responsive ── */
@media (max-width: 1024px) {
  .si-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
  .si-featured { grid-template-columns: 1fr; }
  .si-card-side { flex-direction: column; }
  .si-card-side__img { width: 100%; height: 140px; }
  .si-pro-reminder { flex-direction: column; text-align: center; }
}

@media (max-width: 540px) {
  .si-grid { grid-template-columns: 1fr; }
  .si-page { padding: 0 16px; }
  .si-hero { min-height: 220px; }
  .si-cta-banner { padding: 30px 20px; text-align: center; justify-content: center; }
}
</style>

{# ══════════════════════════════════════════════════════════════════════════
   1. HERO
══════════════════════════════════════════════════════════════════════════ #}
<section class="si-hero" aria-labelledby="si-hero-title"
         style="--si-bg-img: url('{{ asset('uploads/banners/smartideas.png') }}');">
  <div class="container">
    <div class="si-hero__inner">
      <div class="si-eyebrow">
        <i class="fas fa-file-alt" aria-hidden="true"></i>
        Drilleedo
      </div>
      <h1 class="si-hero__title" id="si-hero-title">
        {{ pageTitle }}
      </h1>
      <p class="si-hero__sub">
        Discover the latest {{ pageTitle|lower }} and inspiration. Stay updated with tips from professionals.
      </p>
      <div class="d-flex gap-3 flex-wrap align-items-center">
        <div class="si-hero__count">
          <i class="feather-book-open" aria-hidden="true"></i>
          <span>{{ totalItems }}</span> Items Available
        </div>
        
        {# CTA hero button #}
        <a href="{{ path('app_register') }}"
           class="si-eyebrow"
           style="background:rgba(232,80,26,0.9);border-color:rgba(232,80,26,0.6);text-decoration:none;">
          <i class="feather-edit" aria-hidden="true"></i>
          Post Your Project
        </a>
      </div>
    </div>
  </div>
</section>

{# ══════════════════════════════════════════════════════════════════════════
   2. CATEGORY CHIPS
══════════════════════════════════════════════════════════════════════════ #}
<div class="si-cats" role="navigation" aria-label="Filter by category">
  <div class="si-cats__inner">
    <a href="{{ path(pageRoute) }}" class="si-cat-chip {{ not currentCategory ? 'active' : '' }}">
      <i class="feather-grid" aria-hidden="true"></i> All Categories
    </a>
    {# Filters cleanly for parent categories only #}
    {% for cat in categories %}
      {% if cat.parent is null %}
        <a href="{{ path(pageRoute, {category: cat.id}) }}" class="si-cat-chip {{ currentCategory == cat.id ? 'active' : '' }}">
          {% if cat.icon %}<i class="{{ cat.icon }}" aria-hidden="true"></i>{% endif %}
          {{ cat.name }}
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

{# ══════════════════════════════════════════════════════════════════════════
   3. CONTENT
══════════════════════════════════════════════════════════════════════════ #}
<div class="si-wrap">
  <div class="si-page">

    {# ── CTA Banner (Always visible if it's page 1, to break emptiness) ── #}
    {% if currentPage == 1 %}
    <div class="si-cta-banner" role="complementary">
      <div class="si-cta-banner__text">
        <h3>Ready to start your {{ pageTitle|lower }}?</h3>
        <p>Get connected with 1,500+ verified professionals and receive free quotes.</p>
      </div>
      <a href="{{ path('professionals_list') }}" class="si-cta-banner__btn">
        Find a Professional <i class="feather-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
    {% endif %}

    {% if items|length > 0 %}
      
      {# ── FEATURED BLOCK ── #}
      {% if currentPage == 1 %}
      <div class="si-featured">
        {# Main card #}
        {% set mainItem = items[0] %}
        <div class="si-card-main">
          <div class="si-card-main__img">
            <a href="{{ path('public_blog_show', {id: mainItem.id}) }}" tabindex="-1" aria-hidden="true">
              <img src="{{ mainItem.mainImg
                ? (mainItem.mainImg starts with 'http' ? mainItem.mainImg : asset('uploads/blog/' ~ mainItem.mainImg))
                : asset('assets/drilleedo/images/bg/bg-image-1.jpg') }}"
                   alt="{{ mainItem.title }}"
                   loading="eager">
            </a>
          </div>
          <div class="si-card-main__body">
            {% if mainItem.category %}
              <span class="si-card-cat">{{ mainItem.category.name }}</span>
            {% else %}
              <span class="si-card-cat">✨ Featured</span>
            {% endif %}
            <h2 class="si-card-main__title">
              <a href="{{ path('public_blog_show', {id: mainItem.id}) }}">{{ mainItem.title }}</a>
            </h2>
            {% if mainItem.shortDesc %}
              <p class="si-card-main__desc">{{ mainItem.shortDesc }}</p>
            {% endif %}
            <a href="{{ path('public_blog_show', {id: mainItem.id}) }}" class="si-link">
              Read More <i class="feather-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>

        {# Side cards #}
        {% if items|length > 1 %}
        <div class="si-side-col">
          {% for sideItem in items|slice(1, 3) %}
            <div class="si-card-side">
              <div class="si-card-side__img">
                <a href="{{ path('public_blog_show', {id: sideItem.id}) }}" tabindex="-1" aria-hidden="true">
                  <img src="{{ sideItem.mainImg
                    ? (sideItem.mainImg starts with 'http' ? sideItem.mainImg : asset('uploads/blog/' ~ sideItem.mainImg))
                    : asset('assets/drilleedo/images/bg/bg-image-1.jpg') }}"
                       alt="{{ sideItem.title }}"
                       loading="lazy">
                </a>
              </div>
              <div class="si-card-side__body">
                <h3 class="si-card-side__title">
                  <a href="{{ path('public_blog_show', {id: sideItem.id}) }}">{{ sideItem.title }}</a>
                </h3>
                <a href="{{ path('public_blog_show', {id: sideItem.id}) }}" class="si-link" style="font-size:13px;">
                  View <i class="feather-arrow-right" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      
      {# Grid separator #}
      {% if items|length > 4 %}
      <div class="si-sep">
        <span class="si-sep__line"></span>
        <span class="si-sep__label">
          <i class="fas fa-th" aria-hidden="true"></i>
          More {{ pageTitle }}
        </span>
        <span class="si-sep__line"></span>
      </div>
      {% endif %}
      {% endif %}

      {# ── MORE ITEMS GRID ── #}
      <div class="si-grid">
        {% set gridItems = currentPage == 1 ? items|slice(4) : items %}
        {% for gridIdea in gridItems %}
          <div class="si-card-grid">
            <div class="si-card-grid__img">
              <a href="{{ path('public_blog_show', {id: gridIdea.id}) }}" tabindex="-1" aria-hidden="true">
                <img src="{{ gridIdea.mainImg
                  ? (gridIdea.mainImg starts with 'http' ? gridIdea.mainImg : asset('uploads/blog/' ~ gridIdea.mainImg))
                  : asset('assets/drilleedo/images/bg/bg-image-1.jpg') }}"
                     alt="{{ gridIdea.title }}"
                     loading="lazy">
              </a>
            </div>
            <div class="si-card-grid__body">
              {% if gridIdea.category %}
                <span class="si-card-cat">{{ gridIdea.category.name }}</span>
              {% endif %}
              <h3 class="si-card-grid__title">
                <a href="{{ path('public_blog_show', {id: gridIdea.id}) }}">{{ gridIdea.title }}</a>
              </h3>
              {% if gridIdea.shortDesc %}
                <p class="si-card-grid__desc">{{ gridIdea.shortDesc }}</p>
              {% endif %}
              <a href="{{ path('public_blog_show', {id: gridIdea.id}) }}" class="si-link">
                Read More <i class="feather-arrow-right" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        {% endfor %}
      </div>

    {% else %}
      {# ── Empty state (never truly empty because of banner above) ── #}
      <div class="si-empty">
        <div class="si-empty__icon"><i class="feather-search"></i></div>
        <h4>No items found</h4>
        <p>Try adjusting your category filters to see more {{ pageTitle|lower }}.</p>
      </div>
    {% endif %}

    {# ══ PAGINATION ══ #}
    {% if totalPages > 1 %}
      <nav class="si-pagination" aria-label="Page navigation">
        {% if currentPage > 1 %}
          <a href="{{ path(pageRoute, {page: currentPage - 1, category: currentCategory}) }}" aria-label="Previous page">
            <i class="feather-chevron-left" aria-hidden="true"></i>
          </a>
        {% endif %}

        {% for p in 1..totalPages %}
          {% if p == currentPage %}
            <span class="active" aria-current="page">{{ p }}</span>
          {% else %}
            <a href="{{ path(pageRoute, {page: p, category: currentCategory}) }}">{{ p }}</a>
          {% endif %}
        {% endfor %}

        {% if currentPage < totalPages %}
          <a href="{{ path(pageRoute, {page: currentPage + 1, category: currentCategory}) }}" aria-label="Next page">
            <i class="feather-chevron-right" aria-hidden="true"></i>
          </a>
        {% endif %}
      </nav>
    {% endif %}

    {# ── TRUST STRIP ── #}
    <div class="si-trust-strip">
      <div class="si-trust-item"><i class="feather-check-circle"></i> Verified Contractors</div>
      <div class="si-trust-item"><i class="feather-message-square"></i> Free Quotes</div>
      <div class="si-trust-item"><i class="fas fa-star"></i> Real Reviews</div>
      <div class="si-trust-item"><i class="feather-shield"></i> RBQ Insured</div>
    </div>

    {# ── PRO REMINDER CTA ── #}
    <div class="si-pro-reminder">
      <div class="si-pro-reminder__content">
        <h3>Are you a Top-Rated Professional?</h3>
        <p>Join thousands of contractors growing their business securely on Drilleedo.</p>
      </div>
      <a href="{{ path('app_register') }}" class="si-pro-reminder__btn">
        List Your Business <i class="feather-chevron-right"></i>
      </a>
    </div>

  </div>{# /si-page #}
</div>{# /si-wrap #}

</main>
{% endblock %}
