{% extends 'professional/base_professional.html.twig' %}

{% block title %}Notifications - Drilleedo Pro{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 style="font-size: 24px; font-weight: 800; color: #0d2151; margin: 0 0 4px;">Notification History</h2>
            <p style="font-size: 15px; color: #64748b; margin: 0;">View all your past activity and alerts.</p>
        </div>
        <form method="post" action="{{ path('notification_mark_all_read') }}" style="margin:0;">
            <input type="hidden" name="_token" value="{{ csrf_token('mark-all-read') }}">
            <button type="submit" class="btn btn-outline-primary rounded-pill px-4 btn-sm fw-bold">
                <i class="ph-check-all me-2"></i> Mark all as read
            </button>
        </form>
    </div>

    <div class="drl-card p-0 overflow-hidden">
        <div class="list-group list-group-flush">
            {% for notification in notifications %}
                <div class="list-group-item p-4 border-0 border-bottom {{ not notification.isRead ? 'bg-primary bg-opacity-10' : '' }}" style="transition: all 0.2s;">
                        <div class="d-flex gap-4">
                            <div style="flex-shrink: 0; width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px;
                                {% if 'Accepted' in notification.title or 'Completed' in notification.title %}background: #f0fdf4; color: #16a34a;
                                {% elseif 'Rejected' in notification.title or 'Withdrawn' in notification.title %}background: #fef2f2; color: #ef4444;
                                {% else %}background: #eff6ff; color: #00509e;{% endif %}">
                            
                            {% if 'Accepted' in notification.title or 'Completed' in notification.title %}
                                <i class="ph-check-circle"></i>
                            {% elseif 'Rejected' in notification.title or 'Withdrawn' in notification.title %}
                                <i class="ph-x-circle"></i>
                            {% else %}
                                <i class="ph-bell"></i>
                            {% endif %}
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="mb-0 fw-bold text-dark" style="font-size: 16px;">{{ notification.title|default('Notification') }}</h5>
                                <span class="text-muted small fw-bold text-uppercase" style="font-size: 11px;">{{ notification.createdAt|date('d/m/Y H:i') }}</span>
                            </div>
                            <p class="text-muted mb-3" style="font-size: 14px; line-height: 1.5;">{{ notification.message }}</p>

                            {# CTA link based on notification type #}
                            <div class="d-flex align-items-center gap-3">
                                {% if 'Accepted' in notification.title or 'Rejected' in notification.title %}
                                    <a href="{{ path('professional_offers') }}"
                                       class="drl-act-btn drl-act-btn--view"
                                       style="text-decoration:none; font-size:12px; padding:5px 10px; border-radius:6px; display:inline-flex; align-items:center; gap:4px;">
                                        <i class="feather-eye"></i>
                                        <span>View My Offers</span>
                                    </a>
                                {% elseif 'Request' in notification.title or 'Direct' in notification.title %}
                                    <a href="{{ path('professional_direct_requests') }}"
                                       class="drl-act-btn drl-act-btn--view"
                                       style="text-decoration:none; font-size:12px; padding:5px 10px; border-radius:6px; display:inline-flex; align-items:center; gap:4px;">
                                        <i class="feather-inbox"></i>
                                        <span>View Requests</span>
                                    </a>
                                {% else %}
                                    <a href="{{ path('professional_dashboard') }}"
                                       class="drl-act-btn drl-act-btn--view"
                                       style="text-decoration:none; font-size:12px; padding:5px 10px; border-radius:6px; display:inline-flex; align-items:center; gap:4px;">
                                        <i class="feather-home"></i>
                                        <span>Dashboard</span>
                                    </a>
                                {% endif %}

                                {% if not notification.isRead %}
                                    <span class="drl-tag" style="background:#eff6ff; color:#00509e; font-size:10px; padding:2px 8px; border-radius:20px; font-weight:700;">
                                        <i class="feather-circle" style="font-size:7px;"></i> Unread
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="text-center py-5 px-4">
                    <div class="bg-light rounded-circle p-4 d-inline-flex mb-4">
                        <i class="ph-bell-slash ph-4x text-muted opacity-25"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">No notifications found</h5>
                    <p class="text-muted mb-0">Your notification history will appear here once you receive alerts.</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
