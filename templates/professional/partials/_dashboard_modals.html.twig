<!-- Edit Logo Modal -->
<div class="modal fade" id="editLogoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content drl-modal-content">
            <div class="modal-header drl-modal-header">
                <h5 class="modal-title drl-modal-title">
                    <i class="ph-user me-2"></i>{{ 'pro_dash.modal_update_photo'|trans }}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body drl-modal-body">
                <form id="uploadLogoForm" enctype="multipart/form-data">
                    <label for="logoInput" class="pro-upload-area mb-4 w-100" style="display: block; width: 100%; padding: 40px 20px; text-align: center; border: 2px dashed #cbd5e1; border-radius: 12px; background: #f8fafc; cursor: pointer; transition: all 0.3s ease;">
                        <div class="pro-upload-icon" style="width: 48px; height: 48px; border-radius: 50%; background: #eff6ff; color: #00509e; font-size: 20px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 12px;">
                            <i class="ph-image"></i>
                        </div>
                        <p class="pro-upload-text m-0" style="font-size: 15px; font-weight: 700; color: #475569;">{{ 'pro_dash.upload_click_drag'|trans }}</p>
                        <p style="font-size: 12px; color: #94a3b8; margin-top: 8px;">{{ 'pro_dash.upload_photo_hint'|trans }}</p>
                        <input type="file" id="logoInput" name="logo" class="pro-file-input" accept="image/*" required style="display: none;">
                    </label>
                    <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-link text-muted text-decoration-none fw-bold" data-bs-dismiss="modal">{{ 'pro_dash.btn_cancel'|trans }}</button>
                        <button type="submit" class="drl-btn-orange">
                            <i class="ph-upload me-2"></i> {{ 'pro_dash.btn_upload_photo'|trans }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Banner Modal -->
