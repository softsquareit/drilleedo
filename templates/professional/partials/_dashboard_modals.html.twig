<!-- Edit Logo Modal -->
<div class="modal fade" id="editLogoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border: none; border-radius: 16px; box-shadow: 0 10px 40px rgba(13,33,81,0.2);">
            <div class="modal-header" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; border-radius: 16px 16px 0 0; padding: 20px 24px;">
                <h5 class="modal-title" style="font-weight: 800; color: #0d2151; margin: 0;">Update Profile Photo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 32px;">
                <form id="uploadLogoForm" enctype="multipart/form-data">
                    <label for="logoInput" class="pro-upload-area mb-4 w-100" style="display: block; width: 100%; padding: 40px 20px; text-align: center; border: 2px dashed #cbd5e1; border-radius: 12px; background: #f8fafc; cursor: pointer; transition: all 0.3s ease;">
                        <div class="pro-upload-icon" style="width: 48px; height: 48px; border-radius: 50%; background: #eff6ff; color: #00509e; font-size: 20px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 12px;">
                            <i class="feather-image"></i>
                        </div>
                        <p class="pro-upload-text m-0" style="font-size: 15px; font-weight: 700; color: #475569;">Click to select or drag image here</p>
                        <p style="font-size: 12px; color: #94a3b8; margin-top: 8px;">Recommended: Square image, at least 400x400px</p>
                        <input type="file" id="logoInput" name="logo" class="pro-file-input" accept="image/*" required style="display: none;">
                    </label>
                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <button type="button" style="padding: 12px 24px; font-weight: 700; color: #64748b; background: transparent; border: 1px solid #cbd5e1; border-radius: 8px;" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="drl-btn-orange">
                            <i class="feather-upload"></i> Upload Photo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Banner Modal -->
<div class="modal fade" id="editBannerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border: none; border-radius: 16px; box-shadow: 0 10px 40px rgba(13,33,81,0.2);">
            <div class="modal-header" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; border-radius: 16px 16px 0 0; padding: 20px 24px;">
                <h5 class="modal-title" style="font-weight: 800; color: #0d2151; margin: 0;">Update Cover Banner</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 32px;">
                <form id="uploadBannerForm" enctype="multipart/form-data">
                    <label for="bannerInput" class="pro-upload-area mb-4 w-100" style="display: block; width: 100%; padding: 40px 20px; text-align: center; border: 2px dashed #cbd5e1; border-radius: 12px; background: #f8fafc; cursor: pointer; transition: all 0.3s ease;">
                        <div class="pro-upload-icon" style="width: 48px; height: 48px; border-radius: 50%; background: #eff6ff; color: #00509e; font-size: 20px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 12px;">
                            <i class="feather-layout"></i>
                        </div>
                        <p class="pro-upload-text m-0" style="font-size: 15px; font-weight: 700; color: #475569;">Click to select or drag banner here</p>
                        <p style="font-size: 12px; color: #94a3b8; margin-top: 8px;">Recommended: 1920x400px for best results</p>
                        <input type="file" id="bannerInput" name="banner" class="pro-file-input" accept="image/*" required style="display:none;">
                    </label>
                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <button type="button" style="padding: 12px 24px; font-weight: 700; color: #64748b; background: transparent; border: 1px solid #cbd5e1; border-radius: 8px;" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="drl-btn-orange">
                            <i class="feather-upload"></i> Upload Banner
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const logoForm = document.getElementById('uploadLogoForm');
    const bannerForm = document.getElementById('uploadBannerForm');

    // Add visual feedback for file selection
    document.querySelectorAll('.pro-file-input').forEach(input => {
        input.addEventListener('change', function(e) {
            const fileName = e.target.files[0]?.name;
            const textEl = e.target.previousElementSibling.previousElementSibling;
            if (fileName && textEl) {
                textEl.textContent = fileName;
                textEl.style.color = '#00509e';
            }
        });
    });

    async function handleUpload(form, url, selector, isBackground = false) {
        const formData = new FormData(form);
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalBtnText = submitBtn.innerHTML;

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="feather-loader animate-spin"></i> Uploading...';

        try {
            const response = await fetch(url, {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                if (isBackground) {
                    const bannerDivs = document.querySelectorAll('.pro-header-cover');
                    bannerDivs.forEach(el => el.style.backgroundImage = `url('${result.url}')`);
                } else {
                    const avatarImgs = document.querySelectorAll('.pro-avatar-img');
                    avatarImgs.forEach(el => el.src = result.url);
                }

                form.closest('.modal').querySelector('.btn-close').click();
                
                // Show success toast/alert could be added here
            } else {
                globalAlert('Error: ' + (result.error || 'Unknown error occurred'), 'Upload Failed');
            }
        } catch (error) {
            console.error('Upload failed:', error);
            globalAlert('An error occurred during upload.', 'Network Error');
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnText;
            form.reset();
            // Reset text
            const textEl = form.querySelector('.pro-upload-text');
            if(textEl) {
                textEl.textContent = 'Click to select or drag image here';
                textEl.style.color = '#475569';
            }
        }
    }

    if (logoForm) {
        logoForm.addEventListener('submit', function(e) {
            e.preventDefault();
            handleUpload(logoForm, '{{ path('dashboard_upload_logo') }}', '.pro-avatar-img');
        });
    }

    if (bannerForm) {
        bannerForm.addEventListener('submit', function(e) {
            e.preventDefault();
            handleUpload(bannerForm, '{{ path('dashboard_upload_banner') }}', '.pro-header-cover', true);
        });
    }
});
</script>

<style>
.animate-spin { animation: spin 1s linear infinite; }
@keyframes spin { 100% { transform: rotate(360deg); } }
.pro-upload-area:hover { border-color: #00509e !important; background: #eff6ff !important; }
</style>
