<!-- Edit Logo Modal -->
<div class="modal fade" id="editLogoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content pro-modal-content">
            <div class="modal-header pro-modal-header">
                <h5 class="modal-title fw-bold">Update Profile Photo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pro-modal-body">
                <form id="uploadLogoForm" enctype="multipart/form-data">
                    <label for="logoInput" class="pro-upload-area mb-4">
                        <div class="pro-upload-icon">
                            <i class="feather-image"></i>
                        </div>
                        <p class="pro-upload-text">Click to select or drag image here</p>
                        <p class="pro-text-muted" style="font-size: 1rem; margin-top: 8px;">Recommended: Square image, at least 400x400px</p>
                        <input type="file" id="logoInput" name="logo" class="pro-file-input" accept="image/*" required>
                    </label>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="pro-btn pro-btn-outline" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="pro-btn pro-btn-primary">
                            <i class="feather-upload"></i> Upload Photo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Banner Modal -->
<div class="modal fade" id="editBannerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content pro-modal-content">
            <div class="modal-header pro-modal-header">
                <h5 class="modal-title fw-bold">Update Cover Banner</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pro-modal-body">
                <form id="uploadBannerForm" enctype="multipart/form-data">
                    <label for="bannerInput" class="pro-upload-area mb-4">
                        <div class="pro-upload-icon">
                            <i class="feather-layout"></i>
                        </div>
                        <p class="pro-upload-text">Click to select or drag banner here</p>
                        <p class="pro-text-muted" style="font-size: 1rem; margin-top: 8px;">Recommended: 1920x400px for best results</p>
                        <input type="file" id="bannerInput" name="banner" class="pro-file-input" accept="image/*" required>
                    </label>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="pro-btn pro-btn-outline" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="pro-btn pro-btn-primary">
                            <i class="feather-upload"></i> Upload Banner
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const logoForm = document.getElementById('uploadLogoForm');
    const bannerForm = document.getElementById('uploadBannerForm');

    // Add visual feedback for file selection
    document.querySelectorAll('.pro-file-input').forEach(input => {
        input.addEventListener('change', function(e) {
            const fileName = e.target.files[0]?.name;
            const textEl = e.target.previousElementSibling;
            if (fileName && textEl) {
                textEl.textContent = fileName;
                textEl.classList.add('text-primary');
            }
        });
    });

    async function handleUpload(form, url, selector, isBackground = false) {
        const formData = new FormData(form);
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalBtnText = submitBtn.innerHTML;

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="feather-loader animate-spin"></i> Uploading...';

        try {
            const response = await fetch(url, {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                if (isBackground) {
                    const bannerDivs = document.querySelectorAll('.pro-header-cover');
                    bannerDivs.forEach(el => el.style.backgroundImage = `url('${result.url}')`);
                } else {
                    const avatarImgs = document.querySelectorAll('.pro-avatar-img');
                    avatarImgs.forEach(el => el.src = result.url);
                }

                form.closest('.modal').querySelector('.btn-close').click();
                
                // Show success toast/alert could be added here
            } else {
                alert('Error: ' + (result.error || 'Unknown error occurred'));
            }
        } catch (error) {
            console.error('Upload failed:', error);
            alert('An error occurred during upload.');
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnText;
            form.reset();
            // Reset text
            const textEl = form.querySelector('.pro-upload-text');
            if(textEl) {
                textEl.textContent = 'Click to select or drag image here';
                textEl.classList.remove('text-primary');
            }
        }
    }

    if (logoForm) {
        logoForm.addEventListener('submit', function(e) {
            e.preventDefault();
            handleUpload(logoForm, '{{ path('dashboard_upload_logo') }}', '.pro-avatar-img');
        });
    }

    if (bannerForm) {
        bannerForm.addEventListener('submit', function(e) {
            e.preventDefault();
            handleUpload(bannerForm, '{{ path('dashboard_upload_banner') }}', '.pro-header-cover', true);
        });
    }
});
</script>

<style>
.animate-spin { animation: spin 1s linear infinite; }
@keyframes spin { 100% { transform: rotate(360deg); } }
</style>
