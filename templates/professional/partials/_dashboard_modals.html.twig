{# ── Upload feedback toast ── #}
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
    <div id="uploadToast" class="toast align-items-center border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000">
        <div class="d-flex">
            <div class="toast-body fw-bold d-flex align-items-center gap-2" id="uploadToastBody">
                <i class="ph-warning-circle text-danger"></i>
                <span id="uploadToastMsg"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const logoForm = document.getElementById('uploadLogoForm');
    const bannerForm = document.getElementById('uploadBannerForm');

    const _t = {
        uploadSuccess: {{ 'pro_dash.upload_success_msg'|trans|json_encode|raw }},
        uploadError: {{ 'pro_dash.upload_error_generic'|trans|json_encode|raw }},
        uploadErrorPrefix: {{ 'pro_dash.upload_error_prefix'|trans|json_encode|raw }},
        uploadErrorNetwork: {{ 'pro_dash.upload_error_network'|trans|json_encode|raw }},
        uploadClickDrag: {{ 'pro_dash.upload_click_drag'|trans|json_encode|raw }}
    };

    function showToast(message, isError = true) {
        const toastEl = document.getElementById('uploadToast');
        const toastMsg = document.getElementById('uploadToastMsg');
        const toastBody = document.getElementById('uploadToastBody');
        toastMsg.textContent = message;
        toastEl.className = 'toast align-items-center border-0 shadow text-bg-' + (isError ? 'danger' : 'success');
        const icon = toastBody.querySelector('i');
        if (icon) icon.className = isError ? 'ph-warning-circle' : 'ph-check-circle';
        new bootstrap.Toast(toastEl).show();
    }

    // Add visual feedback for file selection
    document.querySelectorAll('.pro-file-input').forEach(input => {
        input.addEventListener('change', function(e) {
            const fileName = e.target.files[0]?.name;
            const textEl = e.target.previousElementSibling.previousElementSibling;
            if (fileName && textEl) {
                textEl.textContent = fileName;
                textEl.style.color = getComputedStyle(document.documentElement).getPropertyValue('--drl-B').trim() || '#00497F';
            }
        });
    });

    async function handleUpload(form, url, selector, isBackground = false) {
        const formData = new FormData(form);
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalBtnText = submitBtn.innerHTML;

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="ph-spinner animate-spin"></i> Uploading...';

        try {
            const response = await fetch(url, {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                if (isBackground) {
                    const bannerDivs = document.querySelectorAll('.pro-header-cover');
                    bannerDivs.forEach(el => el.style.backgroundImage = `url('${result.url}')`);
                } else {
                    const avatarImgs = document.querySelectorAll('.pro-avatar-img');
                    avatarImgs.forEach(el => el.src = result.url);
                }

                form.closest('.modal').querySelector('.btn-close').click();
                showToast(_t.uploadSuccess, false);
            } else {
                showToast(_t.uploadErrorPrefix + ' ' + (result.error || _t.uploadError));
            }
        } catch (error) {
            console.error('Upload failed:', error);
            showToast(_t.uploadErrorNetwork);
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnText;
            form.reset();
            // Reset text
            const textEl = form.querySelector('.pro-upload-text');
            if(textEl) {
                textEl.textContent = _t.uploadClickDrag;
                textEl.style.color = '#475569';
            }
        }
    }

    if (logoForm) {
        logoForm.addEventListener('submit', function(e) {
            e.preventDefault();
            handleUpload(logoForm, '{{ path('dashboard_upload_logo') }}', '.pro-avatar-img');
        });
    }

    if (bannerForm) {
        bannerForm.addEventListener('submit', function(e) {
            e.preventDefault();
            handleUpload(bannerForm, '{{ path('dashboard_upload_banner') }}', '.pro-header-cover', true);
        });
    }
});
</script>

<style>
.animate-spin { animation: spin 1s linear infinite; }
@keyframes spin { 100% { transform: rotate(360deg); } }
</style>
