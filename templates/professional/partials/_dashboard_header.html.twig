<div class="pro-dashboard-header">
    <div class="pro-header-cover" style="background-image: url('{{ app.user.banner ? asset('uploads/banners/' ~ app.user.banner) : asset('assets/drilleedo/images/bg/bg-image-22.jpg') }}');">
        <div class="pro-header-overlay"></div>
        <button class="pro-btn-icon pro-header-edit-cover" data-bs-toggle="modal" data-bs-target="#editBannerModal">
            <i class="feather-camera"></i>
        </button>
    </div>
    
    <div class="pro-header-content">
        <div class="pro-header-profile">
            <div class="pro-avatar-wrapper">
                {% if app.user.logo %}
                    <img src="{{ asset('uploads/logos/' ~ app.user.logo) }}" alt="Professional" class="pro-avatar-img">
                {% else %}
                    <img src="{{ asset('assets/drilleedo/images/team/avatar.jpg') }}" alt="Professional" class="pro-avatar-img">
                {% endif %}
                <button class="pro-btn-icon pro-avatar-edit" data-bs-toggle="modal" data-bs-target="#editLogoModal">
                    <i class="feather-camera"></i>
                </button>
            </div>
            
            <div class="pro-header-info">
                <h3 class="pro-header-name">{{ app.user.companyName|default(app.user.email) }}</h3>
                <div class="pro-header-meta">
                    <span class="pro-badge primary">Professional</span>
                    <span class="pro-divider"></span>
                    <div class="pro-rating">
                        <i class="fas fa-star text-warning"></i>
                        <span class="pro-text-dark fw-bold">4.9</span>
                        <span class="pro-text-muted">(15 Reviews)</span>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="pro-header-actions">
            <a href="{{ path('professional_projects') }}" class="pro-btn pro-btn-primary">
                <i class="feather-plus"></i> New Project
            </a>
        </div>
    </div>
</div>
