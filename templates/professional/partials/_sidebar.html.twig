<div class="drl-card h-100" style="box-shadow: 0 4px 20px rgba(13,33,81,0.05); overflow: visible;">
    <!-- Profile Info Section (Overlaps Banner) -->
    <div class="d-flex flex-column align-items-center p-4 text-center border-bottom" style="position: relative;">
        
        <div class="pro-avatar-wrapper" style="width: 110px; height: 110px; border-radius: 50%; border: 4px solid #fff; box-shadow: 0 4px 15px rgba(13,33,81,0.1); position: relative; margin-top: -65px; margin-bottom: 20px; background: #fff; z-index: 10;">
            {% if app.user.logo %}
                <img src="{{ asset('uploads/logos/' ~ app.user.logo) }}" alt="Professional" class="pro-avatar-img" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">
            {% else %}
                <img src="{{ asset('assets/drilleedo/images/team/avatar.jpg') }}" alt="Professional" class="pro-avatar-img" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">
            {% endif %}
            
            <button class="pro-btn-icon pro-avatar-edit" data-bs-toggle="modal" data-bs-target="#editLogoModal" style="position: absolute; bottom: 0; right: 0; background: #00509e; color: #fff; border: 3px solid #fff; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <i class="feather-camera" style="font-size: 14px;"></i>
            </button>
        </div>
        
        <h4 style="font-size: 18px; font-weight: 800; color: #0d2151; margin: 0 0 6px; line-height: 1.2;">{{ app.user.companyName|default(app.user.email) }}</h4>
        
        <div class="d-flex justify-content-center align-items-center gap-2 mb-4">
            <span class="drl-badge" style="background: #eff6ff; color: #00509e; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 800; text-transform: uppercase;">Professional</span>
            {% set avgRating = app.user.stats ? app.user.stats.averageRating : 0 %}
            {% if avgRating > 0 %}
            <div class="pro-rating" style="display: flex; align-items: center; gap: 4px; font-size: 13px;">
                <i class="feather-star" style="color: #f59e0b; fill: #f59e0b;"></i>
                <span class="pro-text-dark fw-bold" style="color: #0d2151;">{{ avgRating|number_format(1) }}</span>
            </div>
            {% endif %}
        </div>
        
        <a href="{{ path('professional_projects') }}" class="drl-btn-orange w-100" style="padding: 10px; font-size: 14px; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 8px;">
            <i class="feather-plus"></i> New Project
        </a>
    </div>

    <!-- Navigation Section -->
    <nav class="p-3">
        <style>
            .drl-sidebar-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #475569;
                font-size: 14px;
                font-weight: 700;
                border-radius: 8px;
                text-decoration: none;
                transition: all 0.2s ease;
                margin-bottom: 4px;
            }
            .drl-sidebar-link i {
                font-size: 18px;
                width: 24px;
                text-align: center;
                color: #94a3b8;
                transition: all 0.2s ease;
            }
            .drl-sidebar-link:hover {
                background: #f8fafc;
                color: #00509e;
            }
            .drl-sidebar-link:hover i {
                color: #00509e;
            }
            .drl-sidebar-link.active {
                background: #eff6ff;
                color: #00509e;
            }
            .drl-sidebar-link.active i {
                color: #00509e;
            }
            .drl-sidebar-link.danger {
                color: #ef4444;
            }
            .drl-sidebar-link.danger i {
                color: #ef4444;
            }
            .drl-sidebar-link.danger:hover {
                background: #fef2f2;
                color: #ef4444;
            }
            .drl-sidebar-section-title {
                font-size: 11px;
                font-weight: 800;
                color: #94a3b8;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                margin: 20px 0 8px 16px;
            }
        </style>

        <div class="drl-sidebar-section-title">Overview</div>
        <a href="{{ path('professional_dashboard') }}" class="drl-sidebar-link {% if app.request.get('_route') == 'professional_dashboard' %}active{% endif %}">
            <i class="ph-squares-four"></i> <span>Dashboard</span>
        </a>
        <a href="{{ path('professional_notifications') }}" class="drl-sidebar-link {% if app.request.get('_route') == 'professional_notifications' %}active{% endif %}">
            <i class="ph-bell"></i> <span>Notifications</span>
            {% if unreadCount is defined and unreadCount > 0 %}
                <span class="ms-auto badge bg-danger rounded-pill drl-notif-badge" id="drlNotifBadge" style="font-size: 10px;">{{ unreadCount }}</span>
            {% else %}
                <span class="ms-auto badge bg-danger rounded-pill drl-notif-badge d-none" id="drlNotifBadge" style="font-size: 10px;"></span>
            {% endif %}
        </a>
        <a href="{{ path('professional_profile') }}" class="drl-sidebar-link {% if app.request.get('_route') == 'professional_profile' %}active{% endif %}">
            <i class="ph-user"></i> <span>My Profile</span>
        </a>
        <a href="{{ path('professional_projects') }}" class="drl-sidebar-link {% if app.request.get('_route') starts with 'professional_project' %}active{% endif %}">
            <i class="ph-portfolio"></i> <span>Portfolio Projects</span>
        </a>

        <div class="drl-sidebar-section-title">Lead Management</div>
        <a href="{{ path('professional_quotes') }}" class="drl-sidebar-link {% if app.request.get('_route') in ['professional_quotes', 'offer_send'] %}active{% endif %}">
            <i class="ph-clipboard-text"></i> <span>Quote Requests</span>
        </a>
        <a href="{{ path('professional_direct_requests') }}" class="drl-sidebar-link d-flex justify-content-between align-items-center {% if app.request.get('_route') == 'professional_direct_requests' %}active{% endif %}">
            <div class="d-flex align-items-center gap-3">
                <i class="ph-inbox"></i> <span>Direct Requests</span>
            </div>
            {# Optional badge for pending requests #}
            {% if pendingDirectRequestsCount is defined and pendingDirectRequestsCount > 0 %}
                <span class="drl-tag drl-tag--danger" style="padding: 2px 6px; font-size: 10px;">{{ pendingDirectRequestsCount }}</span>
            {% endif %}
        </a>
        <a href="{{ path('professional_offers') }}" class="drl-sidebar-link {% if app.request.get('_route') in ['professional_offers', 'offer_view', 'offer_finalize'] %}active{% endif %}">
            <i class="ph-paper-plane-tilt"></i> <span>My Offers</span>
        </a>

        <div class="drl-sidebar-section-title">Account</div>
        <a href="{{ path('professional_settings') }}" class="drl-sidebar-link {% if app.request.get('_route') == 'professional_settings' %}active{% endif %}">
            <i class="ph-gear"></i> <span>Settings</span>
        </a>
        <a href="{{ path('app_logout') }}" class="drl-sidebar-link danger mt-2 pt-2 border-top">
            <i class="ph-sign-out"></i> <span>Logout</span>
        </a>
    </nav>
</div>

{# ── Notification badge polling (every 30s) ── #}
<script>
(function () {
    const badge = document.getElementById('drlNotifBadge');
    if (!badge) return;
    function poll() {
        fetch('{{ path("notification_unread_count") }}', {credentials: 'same-origin'})
            .then(r => r.ok ? r.json() : null)
            .then(data => {
                if (!data) return;
                if (data.count > 0) {
                    badge.textContent = data.count;
                    badge.classList.remove('d-none');
                } else {
                    badge.classList.add('d-none');
                }
            })
            .catch(() => {});
    }
    setInterval(poll, 30000);
})();
</script>
