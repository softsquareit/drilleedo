{% extends 'base.html.twig' %}

{% block title %}{{ 'pro_pub.list_page_title'|trans }} – Drilleedo{% endblock %}


{% block body %}
    <!-- Start Banner -->
    <div class="zenith-banner">
        <div class="container">
            <div class="row">
                <div class="col-lg-10 offset-lg-1 text-center">
                    <div class="zenith-title-wrapper">
                        <a href="#" class="zenith-badge">
                            <span>🛠️</span> {{ professionals|length }} {{ 'pro_pub.list_trusted_badge'|trans }}
                        </a>
                        <h1 class="zenith-title">{{ 'pro_pub.list_hero_title'|trans }}</h1>
                        <p class="description text-white opacity-75" style="max-width: 600px; margin: 0 auto; font-size: 1.2rem;">
                            {{ 'pro_pub.list_hero_sub'|trans }}
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Banner -->

    <div class="rbt-section-gapBottom">
        <div class="container">

            <!-- Start Filter Bar -->
            <div class="row">
                <div class="col-lg-10 offset-lg-1">
                    <div class="zenith-filter-bar">
                        <form action="{{ path('professionals_list') }}" method="get">
                            <div class="row g-4 align-items-center">
                                <div class="col-lg-3 col-md-6">
                                    <div class="filter-select rbt-modern-select">
                                        <select class="w-100" name="category" onchange="this.form.submit()" style="border: none; background: #f8fafc; padding: 10px 15px; border-radius: 8px; font-weight: 500;">
                                            <option value="">{{ 'pro_pub.list_all_categories'|trans }}</option>
                                            {% for cat in categories %}
                                                <option value="{{ cat.id }}" {% if currentCategory == cat.id %}selected{% endif %}>{{ cat.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6">
                                      <div class="search-input-group">
                                        <input type="text" name="location" placeholder="{{ 'pro_pub.list_ph_city'|trans }}" value="{{ currentLocation }}" style="width: 100%; border: none; background: #f8fafc; padding: 10px 15px; border-radius: 8px; font-weight: 500;">
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-12">
                                      <div class="d-flex align-items-center bg-light rounded-3 p-1">
                                          <input type="text" class="form-control border-0 bg-transparent shadow-none" disabled placeholder="{{ 'pro_pub.list_ph_name_search'|trans }}" style="padding: 10px 15px;">
                                          <button type="submit" class="btn btn-primary btn-sm rounded-3 px-3 py-2 ms-2">
                                             {{ 'pro_pub.list_btn_search'|trans }}
                                          </button>
                                      </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <!-- End Filter Bar -->

            <!-- Start Card Grid -->
            <div class="row g-5">
                {% for pro in professionals %}
                    <div class="col-lg-4 col-md-6 col-12" data-sal-delay="150" data-sal="slide-up" data-sal-duration="800">
                        <div class="zenith-card">
                            <div class="zenith-card-img-wrapper">
                                <a href="{{ path('professional_show', {id: pro.id}) }}">
                                    {% if pro.banner %}
                                        <img src="{{ asset('uploads/banners/' ~ pro.banner) }}" alt="{{ pro.tradeName }}" class="banner-img">
                                    {% else %}
                                        <img src="{{ asset('assets/drilleedo/images/bg/bg-image-1.jpg') }}" alt="Default Banner" class="banner-img">
                                    {% endif %}
                                </a>
                            </div>
                            <div class="zenith-logo-overlay">
                                {% if pro.logo %}
                                        <img src="{{ asset('uploads/logos/' ~ pro.logo) }}" alt="Logo" class="zenith-logo-img">
                                {% else %}
                                        <div class="zenith-logo-placeholder">{{ pro.tradeName|first|default('P')|upper }}</div>
                                {% endif %}
                            </div>

                            <div class="zenith-card-body">
                                <h4 class="zenith-card-title">
                                    <a href="{{ path('professional_show', {id: pro.id}) }}">
                                        {{ pro.tradeName ?: pro.companyName ?: (pro.firstName ~ ' ' ~ pro.lastName) }}
                                    </a>
                                </h4>

                                <div class="zenith-badges-row">
                                    <span class="zenith-mini-badge primary">{{ pro.category.localizedTitle(app.request.locale)|default('Professional') }}</span>

                                    {% if pro.expYears > 0 %}
                                        <span class="zenith-mini-badge"><i class="ph-medal"></i> {{ pro.expYears }} {{ 'pro_pub.list_exp_years'|trans }}</span>
                                    {% endif %}
                                </div>

                                <div class="zenith-meta">
                                    <div class="zenith-location">
                                        <i class="ph-map-pin"></i>
                                        {{ pro.city|default('pro_pub.list_no_location'|trans) }}
                                    </div>
                                    <a href="{{ path('professional_show', {id: pro.id}) }}" class="btn-zenith-icon">
                                        <i class="ph-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                         <div class="rbt-empty-state text-center py-5">
                             <div class="mb-4" style="font-size: 3rem;">🔍</div>
                             <h3 class="title">{{ 'pro_pub.list_no_result_title'|trans }}</h3>
                             <p class="description">{{ 'pro_pub.list_no_result_sub'|trans }}</p>
                             <a href="{{ path('professionals_list') }}" class="rbt-btn btn-border btn-sm radius-round">{{ 'pro_pub.list_clear_filters'|trans }}</a>
                         </div>
                    </div>
                {% endfor %}
            </div>
            <!-- End Card Grid -->

        </div>
    </div>
{% endblock %}
