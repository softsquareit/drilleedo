{% extends 'professional/base_professional.html.twig' %}

{% block title %}{{ 'Paramètres'|trans }} - {{ app.user.companyName }}{% endblock %}

{% block body %}
    <div class="drl-card">
        <div class="drl-card-head border-bottom">
            <div>
                <h4 class="drl-card-title">{{ 'Paramètres du compte'|trans }}</h4>
                <p class="drl-card-sub">{{ 'Gérez vos préférences de compte, vos informations de contact et vos détails commerciaux'|trans }}</p>
            </div>
        </div>

        <div class="row g-4 p-4">
            <div class="col-lg-3">
                <div class="sticky-top" style="top: 20px;">
                    <nav>
                        <ul class="nav flex-column drl-sidebar-nav" style="gap: 4px;">
                            <li class="nav-item">
                                <a class="nav-link active" data-bs-toggle="list" href="#contact" role="tab" style="border-radius: 8px; padding: 12px 16px; display: flex; align-items: center; gap: 12px; font-weight: 700;">
                                    <i class="ph-user"></i> {{ 'Infos de contact'|trans }}
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="list" href="#address" role="tab" style="border-radius: 8px; padding: 12px 16px; display: flex; align-items: center; gap: 12px; font-weight: 700;">
                                    <i class="ph-map-pin"></i> {{ "Carnet d'adresses"|trans }}
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="list" href="#categories" role="tab" style="border-radius: 8px; padding: 12px 16px; display: flex; align-items: center; gap: 12px; font-weight: 700;">
                                    <i class="ph-tag"></i> {{ 'Catégorie de service'|trans }}
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="list" href="#links" role="tab" style="border-radius: 8px; padding: 12px 16px; display: flex; align-items: center; gap: 12px; font-weight: 700;">
                                    <i class="ph-link"></i> {{ 'Liens sociaux'|trans }}
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="list" href="#security" role="tab" style="border-radius: 8px; padding: 12px 16px; display: flex; align-items: center; gap: 12px; font-weight: 700;">
                                    <i class="ph-lock"></i> {{ 'Sécurité'|trans }}
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>

            <div class="col-lg-9">
                <div class="tab-content">
                    
                    <!-- Contact Info -->
                    <div class="tab-pane fade show active" id="contact" role="tabpanel">
                        <div class="drl-card mb-4" style="box-shadow: 0 4px 15px rgba(13,33,81,0.05);">
                            <div class="drl-card-head border-bottom">
                                <h6 class="drl-card-title m-0" style="font-size: 16px;">{{ 'Informations de contact'|trans }}</h6>
                            </div>
                            <div class="p-4">
                                {{ form_start(contactForm, {'attr': {'class': 'row g-4'}}) }}
                                    <div class="col-lg-6">
                                        <div>
                                            <label class="drl-label">{{ 'Prénom'|trans }}</label>
                                            {{ form_widget(contactForm.firstName, {'attr': {'class': 'drl-input'}}) }}
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div>
                                            <label class="drl-label">{{ 'Nom'|trans }}</label>
                                            {{ form_widget(contactForm.lastName, {'attr': {'class': 'drl-input'}}) }}
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div>
                                            <label class="drl-label">{{ 'Email'|trans }}</label>
                                            {{ form_widget(contactForm.email, {'attr': {'class': 'drl-input'}}) }}
                                        </div>
                                    </div>
                                     <div class="col-lg-6">
                                        <div>
                                            <label class="drl-label">{{ 'Téléphone'|trans }}</label>
                                            {{ form_widget(contactForm.phone, {'attr': {'class': 'drl-input'}}) }}
                                        </div>
                                    </div>
                                     <div class="col-12 mt-4 pt-3 border-top">
                                         <button type="submit" class="drl-btn-orange">
                                            <i class="ph-floppy-disk"></i> {{ 'Enregistrer les infos'|trans }}
                                        </button>
                                    </div>
                                {{ form_end(contactForm) }}
                            </div>
                        </div>
                    </div>

                     <!-- Address -->
                    <div class="tab-pane fade" id="address" role="tabpanel">
                        <div class="drl-card mb-4" style="box-shadow: 0 4px 15px rgba(13,33,81,0.05);">
                            <div class="drl-card-head border-bottom">
                                <h6 class="drl-card-title m-0" style="font-size: 16px;">{{ 'Ajouter une nouvelle adresse'|trans }}</h6>
                            </div>
                            <div class="p-4">
                                {{ form_start(addressForm, {'attr': {'class': 'row g-4'}}) }}
                                    <div class="col-12">
                                        <div>
                                            <label class="drl-label">{{ 'Rue'|trans }}</label>
                                            {{ form_widget(addressForm.street, {'attr': {'class': 'drl-input'}}) }}
                                        </div>
                                    </div>
                                     <div class="col-lg-6">
                                        <div>
                                            <label class="drl-label">{{ 'Ville'|trans }}</label>
                                            {{ form_widget(addressForm.city, {'attr': {'class': 'drl-input'}}) }}
                                        </div>
                                    </div>
                                     <div class="col-lg-6">
                                        <div>
                                            <label class="drl-label">{{ 'Code postal'|trans }}</label>
                                            {{ form_widget(addressForm.postalCode, {'attr': {'class': 'drl-input'}}) }}
                                        </div>
                                    </div>
                                    <div class="col-12 mt-4 pt-3 border-top">
                                         <button type="submit" class="drl-btn-orange">
                                            <i class="ph-plus"></i> {{ addressForm.save.vars.label|default('Ajouter cette adresse'|trans) }}
                                         </button>
                                    </div>
                                {{ form_end(addressForm) }}
                            </div>
                        </div>
                        
                        <div class="drl-card" style="box-shadow: 0 4px 15px rgba(13,33,81,0.05);">
                            <div class="drl-card-head border-bottom">
                                <h6 class="drl-card-title m-0" style="font-size: 16px;">{{ 'Adresses enregistrées'|trans }}</h6>
                            </div>
                            <div class="table-responsive">
                                <table class="table mb-0 drl-table">
                                    <thead>
                                        <tr>
                                            <th>{{ 'Adresse'|trans }}</th>
                                            <th>{{ 'Ville'|trans }}</th>
                                            <th>{{ 'Code postal'|trans }}</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for addr in user.adresse %}
                                            <tr>
                                                <td style="font-weight: 700; color: #0d2151;">{{ addr.street }}</td>
                                                <td style="color: #475569;">{{ addr.city }}</td>
                                                <td style="color: #64748b;">{{ addr.postalCode }}</td>
                                                <td>
                                                    <a href="#" class="drl-act-btn" style="background: #fef2f2; color: #ef4444;" title="{{ 'Supprimer'|trans }}">
                                                        <i class="ph-trash"></i> {{ 'Supprimer'|trans }}
                                                    </a>
                                                </td>
                                            </tr>
                                        {% else %}
                                             <tr>
                                                 <td colspan="4" class="text-center py-5">
                                                     <div style="width:48px; height:48px; border-radius:50%; background:#f8fafc; color:#94a3b8; font-size:20px; display:inline-flex; align-items:center; justify-content:center; margin-bottom:12px;">
                                                         <i class="ph-map-pin"></i>
                                                     </div>
                                                     <p style="font-size:14px; color:#64748b; margin:0;">{{ "Aucune adresse enregistrée."|trans }}</p>
                                                 </td>
                                             </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                     <!-- Categories -->
                    <div class="tab-pane fade" id="categories" role="tabpanel">
                        <div class="drl-card mb-4" style="box-shadow: 0 4px 15px rgba(13,33,81,0.05);">
                            <div class="drl-card-head border-bottom">
                                <h6 class="drl-card-title m-0" style="font-size: 16px;">{{ 'Sélecteur de catégorie de service'|trans }}</h6>
                            </div>
                            <div class="p-4">
                                {{ form_start(categoryForm) }}
                                    <p style="color: #64748b; font-size: 14px; margin-bottom: 24px;">{{ 'Sélectionnez la catégorie de service principale pour votre profil.'|trans }}</p>
                                    
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-6">
                                            <div>
                                                <label class="drl-label" for="{{ categoryForm.parentCategory.vars.id }}">{{ 'Industrie / Secteur'|trans }}</label>
                                                {{ form_widget(categoryForm.parentCategory, {'attr': {'class': 'drl-input'}}) }}
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div>
                                                <label class="drl-label" for="{{ categoryForm.category.vars.id }}">{{ 'Service spécifique'|trans }}</label>
                                                {{ form_widget(categoryForm.category, {
                                                    'attr': {
                                                        'class': 'drl-input child-category-select',
                                                        'data-selected-id': user.category ? user.category.id : ''
                                                    }
                                                }) }}
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-4 pt-3 border-top">
                                         <button type="submit" class="drl-btn-orange">
                                            <i class="ph-tag"></i> {{ 'Mettre à jour la catégorie'|trans }}
                                         </button>
                                    </div>
                                {{ form_end(categoryForm) }}
                            </div>
                        </div>
                    </div>

                    <!-- Links -->
                    <div class="tab-pane fade" id="links" role="tabpanel">
                        <div class="drl-card mb-4" style="box-shadow: 0 4px 15px rgba(13,33,81,0.05);">
                            <div class="drl-card-head border-bottom">
                                <h6 class="drl-card-title m-0" style="font-size: 16px;">{{ 'Profil social'|trans }}</h6>
                            </div>
                            <div class="p-4">
                                {{ form_start(socialLinksForm, {'attr': {'class': 'row g-4'}}) }}
                                    
                                    <div class="col-12">
                                        <div>
                                            <label class="drl-label"><i class="ph-facebook-logo" style="color: #1877f2;"></i> Facebook</label>
                                            {{ form_widget(socialLinksForm.facebook, {'attr': {'class': 'drl-input'}}) }}
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div>
                                            <label class="drl-label"><i class="ph-twitter-logo" style="color: #1da1f2;"></i> Twitter</label>
                                            {{ form_widget(socialLinksForm.twitter, {'attr': {'class': 'drl-input'}}) }}
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div>
                                            <label class="drl-label"><i class="ph-linkedin-logo" style="color: #0a66c2;"></i> LinkedIn</label>
                                            {{ form_widget(socialLinksForm.linkedin, {'attr': {'class': 'drl-input'}}) }}
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div>
                                            <label class="drl-label"><i class="ph-globe" style="color: #64748b;"></i> {{ 'Site web'|trans }}</label>
                                            {{ form_widget(socialLinksForm.website, {'attr': {'class': 'drl-input'}}) }}
                                        </div>
                                    </div>
                                    
                                    <div class="col-12">
                                        <div>
                                            <label class="drl-label"><i class="ph-instagram-logo" style="color: #e1306c;"></i> Instagram</label>
                                            {{ form_widget(socialLinksForm.instagram, {'attr': {'class': 'drl-input'}}) }}
                                        </div>
                                    </div>

                                    <div class="col-12 mt-4 pt-3 border-top">
                                         <button type="submit" class="drl-btn-orange">
                                            <i class="ph-link"></i> {{ 'Mettre à jour les liens'|trans }}
                                         </button>
                                    </div>
                                {{ form_end(socialLinksForm) }}
                            </div>
                        </div>
                    </div>

                    <!-- Security -->
                    <div class="tab-pane fade" id="security" role="tabpanel">
                        <div class="drl-card mb-4" style="box-shadow: 0 4px 15px rgba(13,33,81,0.05);">
                            <div class="drl-card-head border-bottom">
                                <h6 class="drl-card-title m-0" style="font-size: 16px;">{{ 'Changer le mot de passe'|trans }}</h6>
                            </div>
                            <div class="p-4">
                                {{ form_start(passwordForm, {'attr': {'class': 'row g-4'}}) }}
                                    <div class="col-12">
                                        <div>
                                            <label class="drl-label">{{ 'Nouveau mot de passe'|trans }}</label>
                                            {{ form_widget(passwordForm.plainPassword.first, {'attr': {'class': 'drl-input', 'placeholder': '...'}}) }}
                                            {{ form_errors(passwordForm.plainPassword.first) }}
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div>
                                            <label class="drl-label">{{ 'Confirmer le nouveau mot de passe'|trans }}</label>
                                            {{ form_widget(passwordForm.plainPassword.second, {'attr': {'class': 'drl-input', 'placeholder': '...'}}) }}
                                            {{ form_errors(passwordForm.plainPassword.second) }}
                                        </div>
                                    </div>
                                    <div class="col-12 mt-4 pt-3 border-top">
                                         <button type="submit" class="drl-btn-orange">
                                            <i class="ph-shield"></i> {{ 'Mettre à jour le mot de passe'|trans }}
                                         </button>
                                    </div>
                                {{ form_end(passwordForm) }}
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<style>
    .tab-pane { transition: all 0.3s ease; }
    
    .nav-link {
        color: #64748b !important;
        border: 1px solid transparent !important;
        transition: all 0.2s ease;
    }
    
    .nav-link:hover {
        background: #f8fafc !important;
        color: #0d2151 !important;
    }
    
    .nav-link.active {
        background: white !important;
        color: #e8501a !important;
        border-color: #e2e8f0 !important;
        box-shadow: 0 4px 12px rgba(13,33,81,0.06) !important;
    }
</style>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Handle tab switching
    const tabLinks = document.querySelectorAll('[data-bs-toggle="list"]');
    
    tabLinks.forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            
            // Remove active class from all links
            tabLinks.forEach(l => l.classList.remove('active'));
            
            // Add active class to clicked link
            this.classList.add('active');
            
            // Hide all tab panes
            const tabPanes = document.querySelectorAll('.tab-pane');
            tabPanes.forEach(pane => {
                pane.classList.remove('show', 'active');
            });
            
            // Show target tab pane
            const targetId = this.getAttribute('href');
            const targetPane = document.querySelector(targetId);
            if (targetPane) {
                targetPane.classList.add('show', 'active');
            }
        });
    });
});
</script>
{% endblock %}
