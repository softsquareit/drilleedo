{% extends 'professional/base_professional.html.twig' %}

{% block title %}Settings - {{ app.user.companyName }}{% endblock %}

{% block body %}
    <div class="drl-card">
        <div class="drl-card-head border-bottom">
            <div>
                <h4 class="drl-card-title">Account Settings</h4>
                <p class="drl-card-sub">Manage your account preferences, contact information, and business details</p>
            </div>
        </div>

        <div class="row g-4 p-4">
            <div class="col-lg-3">
                <div class="sticky-top" style="top: 20px;">
                    <nav>
                        <ul class="nav flex-column" style="gap: 8px;">
                            <li class="nav-item">
                                <a class="nav-link active" data-bs-toggle="list" href="#contact" role="tab" style="color: #475569; font-weight: 700; border-radius: 8px; padding: 10px 16px; display: flex; align-items: center; gap: 10px;">
                                    <i class="feather-user"></i> Contact Info
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="list" href="#address" role="tab" style="color: #475569; font-weight: 700; border-radius: 8px; padding: 10px 16px; display: flex; align-items: center; gap: 10px;">
                                    <i class="feather-map-pin"></i> Address Book
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="list" href="#categories" role="tab" style="color: #475569; font-weight: 700; border-radius: 8px; padding: 10px 16px; display: flex; align-items: center; gap: 10px;">
                                    <i class="feather-tag"></i> Service Category
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="list" href="#links" role="tab" style="color: #475569; font-weight: 700; border-radius: 8px; padding: 10px 16px; display: flex; align-items: center; gap: 10px;">
                                    <i class="feather-link"></i> Social Links
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="list" href="#security" role="tab" style="color: #475569; font-weight: 700; border-radius: 8px; padding: 10px 16px; display: flex; align-items: center; gap: 10px;">
                                    <i class="feather-lock"></i> Security
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>

            <div class="col-lg-9">
                <div class="tab-content">
                    
                    <!-- Contact Info -->
                    <div class="tab-pane fade show active" id="contact" role="tabpanel">
                        <div class="drl-card mb-4" style="box-shadow: 0 4px 15px rgba(13,33,81,0.05);">
                            <div class="drl-card-head border-bottom">
                                <h6 class="drl-card-title m-0" style="font-size: 16px;">Contact Information</h6>
                            </div>
                            <div class="p-4">
                                {{ form_start(contactForm, {'attr': {'class': 'row g-4'}}) }}
                                    <div class="col-lg-6">
                                        <div>
                                            <label class="drl-form-label">First Name</label>
                                            {{ form_widget(contactForm.firstName, {'attr': {'class': 'drl-form-control w-100'}}) }}
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div>
                                            <label class="drl-form-label">Last Name</label>
                                            {{ form_widget(contactForm.lastName, {'attr': {'class': 'drl-form-control w-100'}}) }}
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div>
                                            <label class="drl-form-label">Email</label>
                                            {{ form_widget(contactForm.email, {'attr': {'class': 'drl-form-control w-100'}}) }}
                                        </div>
                                    </div>
                                     <div class="col-lg-6">
                                        <div>
                                            <label class="drl-form-label">Phone</label>
                                            {{ form_widget(contactForm.phone, {'attr': {'class': 'drl-form-control w-100'}}) }}
                                        </div>
                                    </div>
                                     <div class="col-12 mt-4 pt-3 border-top">
                                        <button type="submit" class="drl-btn-orange">
                                            <i class="feather-save"></i> {{ contactForm.save.vars.label|default('Save Changes') }}
                                        </button>
                                    </div>
                                {{ form_end(contactForm) }}
                            </div>
                        </div>
                    </div>

                     <!-- Address -->
                    <div class="tab-pane fade" id="address" role="tabpanel">
                        <div class="drl-card mb-4" style="box-shadow: 0 4px 15px rgba(13,33,81,0.05);">
                            <div class="drl-card-head border-bottom">
                                <h6 class="drl-card-title m-0" style="font-size: 16px;">Add New Address</h6>
                            </div>
                            <div class="p-4">
                                {{ form_start(addressForm, {'attr': {'class': 'row g-4'}}) }}
                                    <div class="col-12">
                                        <div>
                                            <label class="drl-form-label">Street</label>
                                            {{ form_widget(addressForm.street, {'attr': {'class': 'drl-form-control w-100'}}) }}
                                        </div>
                                    </div>
                                     <div class="col-lg-6">
                                        <div>
                                            <label class="drl-form-label">City</label>
                                            {{ form_widget(addressForm.city, {'attr': {'class': 'drl-form-control w-100'}}) }}
                                        </div>
                                    </div>
                                     <div class="col-lg-6">
                                        <div>
                                            <label class="drl-form-label">Postal Code</label>
                                            {{ form_widget(addressForm.postalCode, {'attr': {'class': 'drl-form-control w-100'}}) }}
                                        </div>
                                    </div>
                                    <div class="col-12 mt-4 pt-3 border-top">
                                        <button type="submit" class="drl-btn-orange">
                                            <i class="feather-plus"></i> {{ addressForm.save.vars.label|default('Add Address') }}
                                        </button>
                                    </div>
                                {{ form_end(addressForm) }}
                            </div>
                        </div>
                        
                        <div class="drl-card" style="box-shadow: 0 4px 15px rgba(13,33,81,0.05);">
                            <div class="drl-card-head border-bottom">
                                <h6 class="drl-card-title m-0" style="font-size: 16px;">Saved Addresses</h6>
                            </div>
                            <div class="table-responsive">
                                <table class="table mb-0 drl-table">
                                    <thead>
                                        <tr>
                                            <th>Address</th>
                                            <th>City</th>
                                            <th>Zip</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for addr in user.adresse %}
                                            <tr>
                                                <td style="font-weight: 700; color: #0d2151;">{{ addr.street }}</td>
                                                <td style="color: #475569;">{{ addr.city }}</td>
                                                <td style="color: #64748b;">{{ addr.postalCode }}</td>
                                                <td>
                                                    <a href="#" class="drl-act-btn" style="background: #fef2f2; color: #ef4444;" title="Delete Address">
                                                        <i class="feather-trash-2"></i> Delete
                                                    </a>
                                                </td>
                                            </tr>
                                        {% else %}
                                             <tr>
                                                 <td colspan="4" class="text-center py-5">
                                                     <div style="width:48px; height:48px; border-radius:50%; background:#f8fafc; color:#94a3b8; font-size:20px; display:inline-flex; align-items:center; justify-content:center; margin-bottom:12px;">
                                                         <i class="feather-map-pin"></i>
                                                     </div>
                                                     <p style="font-size:14px; color:#64748b; margin:0;">No addresses saved.</p>
                                                 </td>
                                             </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                     <!-- Categories -->
                    <div class="tab-pane fade" id="categories" role="tabpanel">
                        <div class="drl-card mb-4" style="box-shadow: 0 4px 15px rgba(13,33,81,0.05);">
                            <div class="drl-card-head border-bottom">
                                <h6 class="drl-card-title m-0" style="font-size: 16px;">Select Service Category</h6>
                            </div>
                            <div class="p-4">
                                {{ form_start(categoryForm) }}
                                    <p style="color: #64748b; font-size: 14px; margin-bottom: 24px;">Select the primary service category for your profile.</p>
                                    
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-6">
                                            <div>
                                                <label class="drl-form-label" for="{{ categoryForm.parentCategory.vars.id }}">Industry/Sector</label>
                                                {{ form_widget(categoryForm.parentCategory, {'attr': {'class': 'drl-form-control form-select w-100'}}) }}
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div>
                                                <label class="drl-form-label" for="{{ categoryForm.category.vars.id }}">Specific Service</label>
                                                {{ form_widget(categoryForm.category, {
                                                    'attr': {
                                                        'class': 'drl-form-control form-select w-100 child-category-select',
                                                        'data-selected-id': user.category ? user.category.id : ''
                                                    }
                                                }) }}
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-4 pt-3 border-top">
                                        <button type="submit" class="drl-btn-orange">
                                            <i class="feather-tag"></i> Update Category
                                        </button>
                                    </div>
                                {{ form_end(categoryForm) }}
                            </div>
                        </div>
                    </div>

                    <!-- Links -->
                    <div class="tab-pane fade" id="links" role="tabpanel">
                        <div class="drl-card mb-4" style="box-shadow: 0 4px 15px rgba(13,33,81,0.05);">
                            <div class="drl-card-head border-bottom">
                                <h6 class="drl-card-title m-0" style="font-size: 16px;">Social Profile</h6>
                            </div>
                            <div class="p-4">
                                {{ form_start(socialLinksForm, {'attr': {'class': 'row g-4'}}) }}
                                    
                                    <div class="col-12">
                                        <div>
                                            <label class="drl-form-label"><i class="feather-facebook" style="color: #1877f2;"></i> Facebook</label>
                                            {{ form_widget(socialLinksForm.facebook, {'attr': {'class': 'drl-form-control w-100'}}) }}
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div>
                                            <label class="drl-form-label"><i class="feather-twitter" style="color: #1da1f2;"></i> Twitter</label>
                                            {{ form_widget(socialLinksForm.twitter, {'attr': {'class': 'drl-form-control w-100'}}) }}
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div>
                                            <label class="drl-form-label"><i class="feather-linkedin" style="color: #0a66c2;"></i> LinkedIn</label>
                                            {{ form_widget(socialLinksForm.linkedin, {'attr': {'class': 'drl-form-control w-100'}}) }}
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div>
                                            <label class="drl-form-label"><i class="feather-globe" style="color: #64748b;"></i> Website</label>
                                            {{ form_widget(socialLinksForm.website, {'attr': {'class': 'drl-form-control w-100'}}) }}
                                        </div>
                                    </div>
                                    
                                    <div class="col-12">
                                        <div>
                                            <label class="drl-form-label"><i class="feather-instagram" style="color: #e1306c;"></i> Instagram</label>
                                            {{ form_widget(socialLinksForm.instagram, {'attr': {'class': 'drl-form-control w-100'}}) }}
                                        </div>
                                    </div>

                                    <div class="col-12 mt-4 pt-3 border-top">
                                        <button type="submit" class="drl-btn-orange">
                                            <i class="feather-link"></i> Update Social Links
                                        </button>
                                    </div>
                                {{ form_end(socialLinksForm) }}
                            </div>
                        </div>
                    </div>

                    <!-- Security -->
                    <div class="tab-pane fade" id="security" role="tabpanel">
                        <div class="drl-card mb-4" style="box-shadow: 0 4px 15px rgba(13,33,81,0.05);">
                            <div class="drl-card-head border-bottom">
                                <h6 class="drl-card-title m-0" style="font-size: 16px;">Change Password</h6>
                            </div>
                            <div class="p-4">
                                {{ form_start(passwordForm, {'attr': {'class': 'row g-4'}}) }}
                                    <div class="col-12">
                                        <div>
                                            <label class="drl-form-label">New Password</label>
                                            {{ form_widget(passwordForm.plainPassword.first, {'attr': {'class': 'drl-form-control w-100', 'placeholder': 'Enter new password...'}}) }}
                                            {{ form_errors(passwordForm.plainPassword.first) }}
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div>
                                            <label class="drl-form-label">Confirm New Password</label>
                                            {{ form_widget(passwordForm.plainPassword.second, {'attr': {'class': 'drl-form-control w-100', 'placeholder': 'Repeat new password...'}}) }}
                                            {{ form_errors(passwordForm.plainPassword.second) }}
                                        </div>
                                    </div>
                                    <div class="col-12 mt-4 pt-3 border-top">
                                        <button type="submit" class="drl-btn-orange">
                                            <i class="feather-shield"></i> Update Password
                                        </button>
                                    </div>
                                {{ form_end(passwordForm) }}
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<style>
    /* Add some specific styles for the tab nav to mimic pro-sidebar */
    .nav-link {
        transition: all 0.2s ease;
    }
    .nav-link:hover {
        background: #f8fafc;
        color: #00509e !important;
    }
    .nav-link.active {
        background: #eff6ff;
        color: #00509e !important;
    }
</style>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Handle tab switching
    const tabLinks = document.querySelectorAll('[data-bs-toggle="list"]');
    
    tabLinks.forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            
            // Remove active class from all links
            tabLinks.forEach(l => l.classList.remove('active'));
            
            // Add active class to clicked link
            this.classList.add('active');
            
            // Hide all tab panes
            const tabPanes = document.querySelectorAll('.tab-pane');
            tabPanes.forEach(pane => {
                pane.classList.remove('show', 'active');
            });
            
            // Show target tab pane
            const targetId = this.getAttribute('href');
            const targetPane = document.querySelector(targetId);
            if (targetPane) {
                targetPane.classList.add('show', 'active');
            }
        });
    });
});
</script>
{% endblock %}
