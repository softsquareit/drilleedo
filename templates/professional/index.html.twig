{% extends 'professional/base_professional.html.twig' %}

{% block title %}Dashboard - {{ app.user.companyName|default('Professional') }}{% endblock %}

{% block body %}
    {# ── Profile Completion Banner ── #}
    {% if profileCompletion < 100 %}
    <div class="pro-alert pro-alert-warning d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4" role="alert" style="padding: 16px 20px;">
        <div class="d-flex align-items-center gap-3">
            <i class="feather-user-check" style="font-size:1.4rem;"></i>
            <div>
                <strong>Complete your profile</strong> — {{ profileCompletion }}% done.
                A complete profile gets <strong>3× more quote requests</strong> from clients.
            </div>
        </div>
        <div class="d-flex align-items-center gap-3" style="flex-shrink:0;">
            <div class="progress" style="width:160px; height:8px; background:rgba(255,255,255,0.4); border-radius:999px;">
                <div class="progress-bar bg-white" role="progressbar" style="width:{{ profileCompletion }}%; border-radius:999px;"></div>
            </div>
            <a href="{{ path('professional_profile') }}" class="pro-btn pro-btn-sm" style="background:#fff; color:var(--pro-warning,#f59e0b); border-radius:8px; padding:6px 14px; font-weight:700; text-decoration:none; flex-shrink:0;">Complete now →</a>
        </div>
    </div>
    {% endif %}

    {# ── Pending Direct Requests Alert ── #}
    {% if pendingDirectRequestsCount > 0 %}
    <div class="pro-alert pro-alert-info d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4" role="alert" style="padding: 14px 20px;">
        <div class="d-flex align-items-center gap-2">
            <i class="feather-bell" style="font-size:1.2rem;"></i>
            <span>You have <strong>{{ pendingDirectRequestsCount }} direct {{ pendingDirectRequestsCount == 1 ? 'request' : 'requests' }}</strong> waiting for your response.</span>
        </div>
        <a href="{{ path('professional_direct_requests') }}" class="pro-btn pro-btn-primary pro-btn-sm">View Requests →</a>
    </div>
    {% endif %}

    {# ── KPI Cards ── #}
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="pro-stat-card primary">
                <div class="pro-stat-header">
                    <div class="pro-stat-icon">
                        <i class="feather-message-square"></i>
                    </div>
                </div>
                <div class="pro-stat-info">
                    <h3 class="pro-stat-value">{{ quoteCount }}</h3>
                    <p class="pro-stat-label">Available Quotes</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="pro-stat-card warning">
                <div class="pro-stat-header">
                    <div class="pro-stat-icon">
                        <i class="feather-send"></i>
                    </div>
                </div>
                <div class="pro-stat-info">
                    <h3 class="pro-stat-value">{{ offerCount }}</h3>
                    <p class="pro-stat-label">Offers Sent</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="pro-stat-card success">
                <div class="pro-stat-header">
                    <div class="pro-stat-icon">
                        <i class="feather-check-circle"></i>
                    </div>
                </div>
                <div class="pro-stat-info">
                    <h3 class="pro-stat-value">{{ acceptedCount }}</h3>
                    <p class="pro-stat-label">Accepted</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="pro-stat-card info">
                <div class="pro-stat-header">
                    <div class="pro-stat-icon">
                        <i class="feather-briefcase"></i>
                    </div>
                </div>
                <div class="pro-stat-info">
                    <h3 class="pro-stat-value">{{ projectCount }}</h3>
                    <p class="pro-stat-label">Projects</p>
                </div>
            </div>
        </div>
    </div>

    {# ── Reputation & Availability ── #}
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="pro-card pro-card-elevated px-4 py-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-4">
                        <div class="text-center border-end pe-4">
                            <div class="pro-text-muted small text-uppercase fw-bold mb-1">Reputation</div>
                            <div class="d-flex align-items-baseline gap-1">
                                <span class="fs-3 fw-bold">{{ stats ? stats.averageRating|number_format(1) : '5.0' }}</span>
                                <i class="fas fa-star text-warning"></i>
                            </div>
                            <div class="small text-muted">{{ stats ? stats.reviewCount : 0 }} reviews</div>
                        </div>
                        <div class="text-center border-end pe-4 px-2">
                            <div class="pro-text-muted small text-uppercase fw-bold mb-1">Response</div>
                            <div class="fs-4 fw-bold">{{ stats and stats.avgResponseTime ? stats.avgResponseTime|format_response_time : 'Instant' }}</div>
                            <div class="small text-muted">Average time</div>
                        </div>
                        <div class="text-center px-2">
                            <div class="pro-text-muted small text-uppercase fw-bold mb-1">Completion</div>
                            <div class="fs-4 fw-bold">{{ stats ? (stats.completionRate * 100)|round : 100 }}%</div>
                            <div class="small text-muted">Project success</div>
                        </div>
                    </div>
                    
                    <div class="ms-auto border-start ps-4 py-1">
                        <div class="pro-text-muted small text-uppercase fw-bold mb-2">My Availability</div>
                        <form action="{{ path('professional_update_availability') }}" method="POST" class="d-flex gap-2">
                            <input type="hidden" name="status" id="availability_status_input">
                            <div class="btn-group pro-btn-group" role="group">
                                <button type="submit" class="pro-btn pro-btn-sm {{ app.user.availabilityStatus == 'AVAILABLE' ? 'pro-btn-success' : 'pro-btn-outline' }}" onclick="document.getElementById('availability_status_input').value='AVAILABLE'">Available</button>
                                <button type="submit" class="pro-btn pro-btn-sm {{ app.user.availabilityStatus == 'BUSY' ? 'pro-btn-warning' : 'pro-btn-outline' }}" onclick="document.getElementById('availability_status_input').value='BUSY'">Busy</button>
                                <button type="submit" class="pro-btn pro-btn-sm {{ app.user.availabilityStatus == 'UNAVAILABLE' ? 'pro-btn-danger' : 'pro-btn-outline' }}" onclick="document.getElementById('availability_status_input').value='UNAVAILABLE'">Off</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="pro-card pro-card-elevated h-100 d-flex align-items-center justify-content-center p-3 text-center">
                <div>
                    <div class="fs-2 fw-bold text-primary mb-0">{{ conversionRate }}%</div>
                    <div class="small text-muted text-uppercase fw-bold">Lead Conversion</div>
                    <div class="progress mt-2" style="height: 4px; border-radius: 99px; width: 80px; margin: 0 auto;">
                        <div class="progress-bar" style="width: {{ conversionRate }}%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        {# ── Recent Offers ── #}
        <div class="col-lg-8">
            <div class="pro-card pro-card-elevated">
                <div class="pro-card-header">
                    <div>
                        <h4 class="pro-card-title">Recent Offers</h4>
                        <p class="pro-card-subtitle">Your latest submitted offers</p>
                    </div>
                    <a href="{{ path('professional_offers') }}" class="pro-btn pro-btn-outline pro-btn-sm">
                        View All <i class="feather-arrow-right"></i>
                    </a>
                </div>

                <div class="pro-table-wrapper">
                    <table class="pro-table">
                        <thead>
                            <tr>
                                <th>Quote Request</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for offer in recentOffers %}
                                <tr>
                                    <td>
                                        <span class="pro-fw-semibold">{{ offer.quoteRequest ? offer.quoteRequest.title : 'Direct Request' }}</span>
                                    </td>
                                    <td>
                                        <span class="pro-text-primary pro-fw-bold">{{ offer.price|number_format(2) }} $</span>
                                    </td>
                                    <td>
                                        {% if offer.status == 'DRAFT' %}
                                            <span class="pro-badge secondary"><i class="feather-file" style="font-size:0.65rem;"></i> Draft</span>
                                        {% elseif offer.status == 'PUBLISHED' %}
                                            <span class="pro-badge info"><i class="feather-send" style="font-size:0.65rem;"></i> Sent</span>
                                        {% elseif offer.status == 'REJECTED' %}
                                            <span class="pro-badge warning"><i class="feather-clock" style="font-size:0.65rem;"></i> In Review</span>
                                        {% elseif offer.status == 'ACCEPTED' %}
                                            {% if offer.quoteRequest and offer.quoteRequest.status == 'Closed' %}
                                                <span class="pro-badge secondary"><i class="feather-lock" style="font-size:0.65rem;"></i> Completed</span>
                                            {% else %}
                                                <span class="pro-badge success"><i class="feather-check-circle" style="font-size:0.65rem;"></i> Accepted</span>
                                            {% endif %}
                                        {% elseif offer.status == 'REJECTED' %}
                                            <span class="pro-badge danger"><i class="feather-x-circle" style="font-size:0.65rem;"></i> Rejected</span>
                                        {% else %}
                                            <span class="pro-badge secondary">{{ offer.status }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="pro-text-muted">{{ offer.createdAt|date('M d, Y') }}</span>
                                    </td>
                                    <td>
                                        {% if offer.status == 'ACCEPTED' and offer.quoteRequest and offer.quoteRequest.status != 'Closed' %}
                                            <button type="button" class="pro-action-badge success" data-bs-toggle="modal" data-bs-target="#finalizeModal{{ offer.id }}">
                                                <i class="feather-check-circle"></i> Finalize
                                            </button>

                                        {% elseif offer.quoteRequest or offer.directRequest %}
                                            <a href="{{ path('offer_view', {id: offer.id}) }}" class="pro-action-badge view">
                                                <i class="feather-eye"></i> View
                                            </a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="pro-table-empty">
                                        <div class="pro-empty-state">
                                            <div class="pro-empty-icon">
                                                <i class="feather-send"></i>
                                            </div>
                                            <h6 class="pro-empty-title">No offers yet</h6>
                                            <p class="pro-empty-text">Browse quote requests to start submitting offers</p>
                                            <a href="{{ path('professional_quotes') }}" class="pro-btn pro-btn-primary pro-btn-sm mt-2">
                                                <i class="feather-search"></i> Browse Quotes
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {# ── Notifications Panel ── #}
        <div class="col-lg-4">
            <div class="pro-card pro-card-elevated">
                <div class="pro-card-header">
                    <div>
                        <h4 class="pro-card-title">
                            Notifications
                            {% if unreadCount > 0 %}
                                <span class="pro-badge danger" style="font-size:1rem; vertical-align:middle; margin-left:6px;">{{ unreadCount }}</span>
                            {% endif %}
                        </h4>
                    </div>
                    {% if unreadCount > 0 %}
                        <form method="post" action="{{ path('notification_mark_all_read') }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('mark-all-read') }}">
                            <button type="submit" class="pro-btn pro-btn-outline pro-btn-sm" style="font-size:1rem;">
                                Mark all read
                            </button>
                        </form>
                    {% endif %}
                </div>

                <div class="pro-card-body" style="max-height: 420px; overflow-y: auto; padding: 0;">
                    {% for notification in notifications %}
                        <div class="d-flex align-items-start gap-3 px-3 py-3 {{ not notification.read ? 'bg-light' : '' }}" style="border-bottom: 1px solid rgba(0,0,0,0.06);">
                            <div style="min-width: 36px; width: 36px; height: 36px; border-radius: 50%; display:flex; align-items:center; justify-content:center;
                                {% if 'Accepted' in notification.title or 'Completed' in notification.title %}background:rgba(16,185,129,0.12);{% elseif 'Rejected' in notification.title or 'Withdrawn' in notification.title %}background:rgba(239,68,68,0.12);{% else %}background:rgba(67,97,238,0.12);{% endif %}">
                                {% if 'Accepted' in notification.title or 'Completed' in notification.title %}
                                    <i class="feather-check-circle" style="font-size:0.85rem; color:#10b981;"></i>
                                {% elseif 'Rejected' in notification.title or 'Withdrawn' in notification.title %}
                                    <i class="feather-x-circle" style="font-size:0.85rem; color:#ef4444;"></i>
                                {% else %}
                                    <i class="feather-bell" style="font-size:0.85rem; color:#4361ee;"></i>
                                {% endif %}
                            </div>
                            <div class="flex-grow-1" style="min-width:0;">
                                <p class="mb-1 {{ not notification.read ? 'pro-fw-semibold' : '' }}" style="font-size:1rem; line-height:1.4; color:var(--pro-text-dark,#1e293b);">
                                    {{ notification.title }}
                                </p>
                                <p class="mb-0 pro-text-muted text-truncate" style="font-size:1.1rem;">{{ notification.message|slice(0, 80) }}{% if notification.message|length > 80 %}...{% endif %}</p>
                                <small class="pro-text-muted" style="font-size:1rem;">{{ notification.createdAt|date('M d, H:i') }}</small>
                            </div>
                        </div>
                    {% else %}
                        <div class="text-center py-5 px-3">
                            <div style="width: 48px; height: 48px; border-radius: 50%; background: rgba(67,97,238,0.1); display:inline-flex; align-items:center; justify-content:center; margin-bottom:12px;">
                                <i class="feather-bell-off" style="font-size:1.2rem; color:var(--pro-primary,#4361ee);"></i>
                            </div>
                            <p class="pro-text-muted mb-0" style="font-size:1rem;">No notifications yet</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block modals %}
    {{ parent() }}
    {% for offer in recentOffers %}
        {% if offer.status == 'ACCEPTED' and offer.quoteRequest and offer.quoteRequest.status != 'Closed' %}
            <!-- Finalize Modal -->
            <div class="modal fade" id="finalizeModal{{ offer.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg text-start" style="border-radius: 16px;">
                        <div class="modal-body p-4 text-center">
                            <div class="mb-4">
                                <div class="pro-stat-icon success mx-auto" style="width: 70px; height: 70px; font-size: 32px; background: rgba(16, 185, 129, 0.1); color: var(--pro-success);">
                                    <i class="feather-check-circle"></i>
                                </div>
                            </div>
                            <h4 class="fw-bold text-dark mb-2">Finalize Request?</h4>
                            <p class="text-muted px-4 mb-4">Mark this request as completed? The individual will be notified that the work is successfully done.</p>
                            <div class="d-flex flex-column gap-3 mt-4">
                                <form method="post" action="{{ path('offer_finalize', {id: offer.id}) }}" class="w-100">
                                    <input type="hidden" name="_token" value="{{ csrf_token('finalize-offer-' ~ offer.id) }}">
                                    <button type="submit" class="pro-btn pro-btn-primary w-100 py-3 justify-content-center">
                                        <i class="feather-check-circle"></i> Yes, Mark as Completed
                                    </button>
                                </form>
                                <button type="button" class="pro-btn pro-btn-outline w-100 py-3 justify-content-center" data-bs-dismiss="modal">
                                    No, Not Yet
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}
{% endblock %}
