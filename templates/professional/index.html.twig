{% extends 'professional/base_professional.html.twig' %}

{% block title %}Dashboard - {{ app.user.companyName|default('Professional') }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h2 style="font-size: 24px; font-weight: 800; color: #0d2151; margin: 0 0 4px;">Welcome back, {{ app.user.personalInfos.firstName|default('Pro') }}! 👋</h2>
            <p style="font-size: 15px; color: #64748b; margin: 0;">Here is what's happening with your business today.</p>
        </div>
        <div>
            <form action="{{ path('professional_update_availability') }}" method="POST" class="d-flex align-items-center gap-2 bg-white p-1" style="border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 2px 5px rgba(13,33,81,0.02);">
                <input type="hidden" name="status" id="availability_status_input">
                <button type="submit" class="drl-avail-btn {% if app.user.availabilityStatus == 'AVAILABLE' %}active-avail{% endif %}" onclick="document.getElementById('availability_status_input').value='AVAILABLE'" style="padding: 6px 16px; border-radius: 6px; font-size: 13px; font-weight: 700; border: none; background: transparent; color: #64748b; transition: all 0.2s;">
                    <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#10b981; margin-right:4px;"></span> Available
                </button>
                <button type="submit" class="drl-avail-btn {% if app.user.availabilityStatus == 'BUSY' %}active-busy{% endif %}" onclick="document.getElementById('availability_status_input').value='BUSY'" style="padding: 6px 16px; border-radius: 6px; font-size: 13px; font-weight: 700; border: none; background: transparent; color: #64748b; transition: all 0.2s;">
                    <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#f59e0b; margin-right:4px;"></span> Busy
                </button>
                <button type="submit" class="drl-avail-btn {% if app.user.availabilityStatus == 'UNAVAILABLE' %}active-off{% endif %}" onclick="document.getElementById('availability_status_input').value='UNAVAILABLE'" style="padding: 6px 16px; border-radius: 6px; font-size: 13px; font-weight: 700; border: none; background: transparent; color: #64748b; transition: all 0.2s;">
                    <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#94a3b8; margin-right:4px;"></span> Off
                </button>
            </form>
            <style>
                .active-avail { background: #ecfdf5 !important; color: #047857 !important; border-bottom: none; }
                .active-busy { background: #fffbeb !important; color: #b45309 !important; border-bottom: none; }
                .active-off { background: #f1f5f9 !important; color: #475569 !important; border-bottom: none; }
                .drl-avail-btn:hover { background: #f8fafc; color: #0d2151; }
            </style>
        </div>
    </div>

    {# ── Hero Alerts Stack ── #}
    {% set priorityAlerts = [] %}

    {# 1. New Requests in Category #}
    {% if quoteCount > 0 %}
        {% set priorityAlerts = priorityAlerts|merge([{
            'type': 'new_request',
            'title': 'New Opportunities!',
            'message': 'There are ' ~ quoteCount ~ ' new requests matching your category: ' ~ (userCategory.name|default('your specialty')) ~ '.',
            'action_url': path('professional_quotes'),
            'action_text': 'View Demands',
            'icon': 'ph-sparkle',
            'color': 'primary'
        }]) %}
    {% endif %}

    {# 2. Pending Direct Requests #}
    {% if pendingDirectRequestsCount > 0 %}
        {% set priorityAlerts = priorityAlerts|merge([{
            'type': 'direct_request',
            'title': 'Pending Direct ' ~ (pendingDirectRequestsCount == 1 ? 'Request' : 'Requests'),
            'message': 'You have ' ~ pendingDirectRequestsCount ~ ' direct requests waiting for your response.',
            'action_url': path('professional_direct_requests'),
            'action_text': 'Respond Now',
            'icon': 'ph-envelope-simple-open',
            'color': 'info'
        }]) %}
    {% endif %}

    {# 3. Scan Notifications for Accepted/Rejected Offers #}
    {% for n in notifications|filter(n => not n.isRead) %}
        {% if 'Accepted' in n.title %}
             {% set priorityAlerts = priorityAlerts|merge([{
                'type': 'offer_accepted',
                'title': n.title,
                'message': n.message,
                'action_url': path('professional_offers'),
                'action_text': 'View Details',
                'icon': 'ph-check-circle',
                'color': 'success'
            }]) %}
        {% elseif 'Rejected' in n.title %}
             {% set priorityAlerts = priorityAlerts|merge([{
                'type': 'offer_rejected',
                'title': n.title,
                'message': n.message,
                'action_url': path('professional_offers'),
                'action_text': 'View Details',
                'icon': 'ph-x-circle',
                'color': 'danger'
            }]) %}
        {% endif %}
    {% endfor %}

    {% if priorityAlerts|length > 0 %}
    <div class="alerts-stack mb-5">
        {% for alert in priorityAlerts %}
            <div class="drl-card border-0 shadow-sm mb-3 position-relative overflow-hidden" 
                 style="background: white; border-radius: 16px; padding: 24px; border-left: 6px solid var(--bs-{{ alert.color }}) !important;">
                
                <div class="d-flex align-items-center gap-4">
                    <div class="alert-icon-wrapper rounded-circle d-flex align-items-center justify-content-center text-{{ alert.color }} bg-{{ alert.color }} bg-opacity-10" 
                         style="width: 56px; height: 56px; font-size: 28px; flex-shrink: 0;">
                        <i class="{{ alert.icon }}"></i>
                    </div>
                    
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h5 class="fw-bold text-dark mb-1" style="font-size: 18px;">{{ alert.title }}</h5>
                                <p class="text-muted mb-0" style="font-size: 15px;">{{ alert.message }}</p>
                            </div>
                            <a href="{{ alert.action_url }}" class="btn btn-{{ alert.color }} rounded-pill px-4 fw-bold shadow-sm">
                                {{ alert.action_text }} <i class="ph-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>

                {# Subtle background pattern decoration #}
                <div style="position: absolute; right: -20px; bottom: -20px; font-size: 120px; opacity: 0.03; pointer-events: none; transform: rotate(-15deg);">
                    <i class="{{ alert.icon }}"></i>
                </div>
            </div>
        {% endfor %}
    </div>
    {% endif %}

    {# ── Profile Completion Banner ── #}
    {% if profileCompletion < 100 %}
    <div class="drl-card d-flex align-items-center justify-content-between flex-wrap gap-3 mb-5" style="padding: 24px; border-radius: 16px; background: linear-gradient(135deg, #ffffff 0%, #fffbf2 100%); border: 1px solid #fee2e2;">
        <div class="d-flex align-items-center gap-4">
            <div style="width: 56px; height: 56px; border-radius: 14px; background: #fff7ed; color: #f97316; display: flex; align-items: center; justify-content: center; font-size: 24px; box-shadow: inset 0 0 0 1px rgba(249,115,22,0.1);">
                <i class="ph-user-focus"></i>
            </div>
            <div>
                <h5 style="margin: 0 0 4px; font-size: 17px; font-weight: 800; color: #0d2151;">Complete your business profile ({{ profileCompletion }}%)</h5>
                <p style="margin: 0; font-size: 14px; color: #64748b;">Profiles with logos and banners receive <strong>300% more matching leads</strong>.</p>
            </div>
        </div>
        <div class="d-flex flex-column align-items-end gap-2" style="flex-shrink:0;">
            <div class="drl-pro-warn-bar" style="width:180px; height:8px; border-radius:999px; background: #f1f5f9;">
                <div class="drl-pro-warn-progress" style="width:{{ profileCompletion }}%; height:100%; border-radius:999px; background: linear-gradient(to right, #f97316, #fb923c);"></div>
            </div>
            <a href="{{ path('professional_profile') }}" class="text-decoration-none fw-bold" style="font-size: 14px; color: #f97316;">Finish Profile Setup <i class="ph-arrow-right"></i></a>
        </div>
    </div>
    {% endif %}

    {# ── KPI Metrics Cards ── #}
    <div class="row g-4 mb-5">
        <div class="col-xl-3 col-md-6">
            <div class="drl-card drl-card--hover border-0 shadow-sm" style="border-radius: 16px; padding: 24px;">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="text-uppercase fw-bold text-muted mb-2" style="letter-spacing: 1px; font-size: 11px;">Quotes Available</p>
                        <h3 class="fw-bold mb-0" style="font-size: 32px; color: #0d2151;">{{ quoteCount }}</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: #eff6ff; color: #00509e; font-size: 22px;">
                        <i class="ph-clipboard-text"></i>
                    </div>
                </div>
                <div class="mt-3 py-2 px-3 rounded-pill bg-light d-inline-flex align-items-center" style="font-size: 12px; font-weight: 700; color: #00509e;">
                    <i class="ph-trend-up me-2"></i> Opportunities
                </div>
            </div>
        </div>
        
        <div class="col-xl-3 col-md-6">
            <div class="drl-card drl-card--hover border-0 shadow-sm" style="border-radius: 16px; padding: 24px;">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="text-uppercase fw-bold text-muted mb-2" style="letter-spacing: 1px; font-size: 11px;">Offers Sent</p>
                        <h3 class="fw-bold mb-0" style="font-size: 32px; color: #0d2151;">{{ offerCount }}</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: #fff7ed; color: #ea580c; font-size: 22px;">
                        <i class="ph-paper-plane-tilt"></i>
                    </div>
                </div>
                <div class="mt-3 py-2 px-3 rounded-pill bg-light d-inline-flex align-items-center" style="font-size: 12px; font-weight: 700; color: #64748b;">
                    <i class="ph-clock me-2"></i> Awaiting Client
                </div>
            </div>
        </div>
        
        <div class="col-xl-3 col-md-6">
            <div class="drl-card drl-card--hover border-0 shadow-sm" style="border-radius: 16px; padding: 24px;">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="text-uppercase fw-bold text-muted mb-2" style="letter-spacing: 1px; font-size: 11px;">Win Rate</p>
                        <h3 class="fw-bold mb-0" style="font-size: 32px; color: #0d2151;">{{ conversionRate }}<span class="fs-6 opacity-50">%</span></h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: #f0fdf4; color: #16a34a; font-size: 22px;">
                        <i class="ph-chart-pie"></i>
                    </div>
                </div>
                <div class="mt-3 py-2 px-3 rounded-pill bg-light d-inline-flex align-items-center" style="font-size: 12px; font-weight: 700; color: #16a34a;">
                    <i class="ph-check-circle me-2"></i> {{ acceptedCount }} Won
                </div>
            </div>
        </div>
        
        <div class="col-xl-3 col-md-6">
            <div class="drl-card drl-card--hover border-0 shadow-sm" style="border-radius: 16px; padding: 24px;">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="text-uppercase fw-bold text-muted mb-2" style="letter-spacing: 1px; font-size: 11px;">Avg Response</p>
                        <h3 class="fw-bold mb-0" style="font-size: 22px; color: #0d2151;">{{ (stats and stats.avgResponseTime) ? stats.avgResponseTime|format_response_time : 'Instant' }}</h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: #f8fafc; color: #475569; font-size: 22px;">
                        <i class="ph-timer"></i>
                    </div>
                </div>
                <div class="mt-3 py-2 px-3 rounded-pill bg-navy-light d-inline-flex align-items-center" style="font-size: 12px; font-weight: 700; color: #0d2151;">
                    <i class="ph-lightning me-2"></i> Market Leader
                </div>
            </div>
        </div>
    </div>

    {# ── Recent Activity Section ── #}
    <div class="row g-4">
        <div class="col-12">
            <div class="drl-card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
                <div class="drl-card-head p-4 border-bottom d-flex justify-content-between align-items-center bg-white">
                    <div>
                        <h4 class="fw-bold text-dark mb-1" style="font-size: 20px;">Recent Business Actions</h4>
                        <p class="text-muted small mb-0">Track the lifecycle of your submitted quotes and incoming leads.</p>
                    </div>
                    <a href="{{ path('professional_offers') }}" class="btn btn-light rounded-pill px-4 fw-bold border" style="font-size: 13px;">
                        View All Offers <i class="ph-arrow-right ms-1"></i>
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table mb-0 align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3 text-uppercase small fw-bold text-muted" style="font-size: 11px; letter-spacing: 0.5px;">Quote Request</th>
                                <th class="py-3 text-uppercase small fw-bold text-muted" style="font-size: 11px; letter-spacing: 0.5px;">Amount</th>
                                <th class="py-3 text-uppercase small fw-bold text-muted" style="font-size: 11px; letter-spacing: 0.5px;">Status</th>
                                <th class="py-3 text-uppercase small fw-bold text-muted" style="font-size: 11px; letter-spacing: 0.5px;">Date</th>
                                <th class="pe-4 py-3 text-end text-uppercase small fw-bold text-muted" style="font-size: 11px; letter-spacing: 0.5px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for offer in recentOffers %}
                                <tr class="border-bottom">
                                    <td class="ps-4 py-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center text-primary bg-primary bg-opacity-10" style="width: 40px; height: 40px; font-size: 18px; flex-shrink: 0;">
                                                <i class="ph-{% if offer.quoteRequest %}file-text{% else %}user{% endif %}"></i>
                                            </div>
                                            <div>
                                                <strong class="text-dark d-block mb-0" style="font-size: 15px;">{{ offer.quoteRequest ? offer.quoteRequest.title|slice(0,50) ~ (offer.quoteRequest.title|length > 50 ? '...' : '') : 'Direct Request' }}</strong>
                                                <span class="text-muted small">#{{ offer.id }} • {{ offer.quoteRequest ? offer.quoteRequest.category.name : 'Direct' }}</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4">
                                        <span class="fw-bold text-primary" style="font-size: 15px;">{{ offer.price|number_format(2) }} $</span>
                                    </td>
                                    <td class="py-4">
                                        {% if offer.status == 'DRAFT' %}
                                            <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary fw-bold px-3 py-2" style="font-size: 11px;"><i class="ph-pencil-line me-1"></i> Draft</span>
                                        {% elseif offer.status == 'PUBLISHED' %}
                                            <span class="badge rounded-pill bg-info bg-opacity-10 text-info fw-bold px-3 py-2" style="font-size: 11px;"><i class="ph-paper-plane-tilt me-1"></i> Sent</span>
                                        {% elseif offer.status == 'REJECTED' %}
                                            <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger fw-bold px-3 py-2" style="font-size: 11px;"><i class="ph-x-circle me-1"></i> Rejected</span>
                                        {% elseif offer.status == 'ACCEPTED' %}
                                            {% if offer.quoteRequest and offer.quoteRequest.status == 'Closed' %}
                                                <span class="badge rounded-pill bg-dark bg-opacity-10 text-dark fw-bold px-3 py-2" style="font-size: 11px;"><i class="ph-lock me-1"></i> Completed</span>
                                            {% else %}
                                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success fw-bold px-3 py-2" style="font-size: 11px;"><i class="ph-check-circle me-1"></i> Accepted</span>
                                            {% endif %}
                                        {% else %}
                                            <span class="badge rounded-pill bg-light text-muted fw-bold px-3 py-2">{{ offer.status }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="py-4 text-muted small">
                                        {{ offer.createdAt|date('M d, Y') }}
                                    </td>
                                    <td class="pe-4 py-4 text-end">
                                        {% if offer.status == 'ACCEPTED' and offer.quoteRequest and offer.quoteRequest.status != 'Closed' %}
                                            <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#finalizeModal{{ offer.id }}">
                                                <i class="ph-check-circle"></i> Mark Complete
                                            </button>
                                        {% elseif offer.quoteRequest or offer.directRequest %}
                                            <a href="{{ path('offer_view', {id: offer.id}) }}" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold d-inline-flex align-items-center gap-1">
                                                <i class="ph-eye"></i> View Offer
                                            </a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <div class="bg-light rounded-circle p-4 d-inline-flex mb-4">
                                            <i class="ph-suitcase ph-3x text-muted opacity-25"></i>
                                        </div>
                                        <h5 class="fw-bold text-dark mb-2">No recent offers</h5>
                                        <p class="text-muted mb-4 px-5">Submit your first offer to start winning new clients and growing your business.</p>
                                        <a href="{{ path('professional_quotes') }}" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                                            <i class="ph-magnifying-glass me-2"></i> Find Demands
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block modals %}
    {{ parent() }}
    {% for offer in recentOffers %}
        {% if offer.status == 'ACCEPTED' and offer.quoteRequest and offer.quoteRequest.status != 'Closed' %}
            <!-- Finalize Modal -->
            <div class="modal fade" id="finalizeModal{{ offer.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content drl-modal-content text-center">
                <div class="modal-body drl-modal-body py-5 px-4 text-center">
                    <div class="mb-4">
                        <div class="drl-stat-icon drl-stat-icon--3 mx-auto shadow-sm" style="width: 80px; height: 80px; font-size: 36px;">
                            <i class="feather-check-circle"></i>
                        </div>
                    </div>
                    <h4 class="drl-card-title mb-2" style="font-size: 22px;">Finalize Request?</h4>
                    <p class="text-muted mb-4">Mark this request as completed? The individual will be notified that the work is successfully done.</p>
                    <div class="d-flex flex-column gap-2 mt-4">
                        <form method="post" action="{{ path('offer_finalize', {id: offer.id}) }}" class="w-100">
                            <input type="hidden" name="_token" value="{{ csrf_token('finalize-offer-' ~ offer.id) }}">
                            <button type="submit" class="drl-btn-orange w-100 justify-content-center" style="background:#16a34a; box-shadow: 0 4px 14px rgba(22,163,74,0.25);">
                                <i class="feather-check-circle me-2"></i> Yes, Mark as Completed
                            </button>
                        </form>
                        <button type="button" class="btn btn-link text-muted text-decoration-none fw-bold" data-bs-dismiss="modal">
                            No, Not Yet
                        </button>
                    </div>
                </div>
            </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}
{% endblock %}
