{% extends 'professional/base_professional.html.twig' %}

{% block title %}My Offers - {{ app.user.companyName|default('Professional') }}{% endblock %}

{% block body %}
    <div class="pro-card pro-card-elevated">
        <div class="pro-card-header border-bottom">
            <div>
                <h4 class="pro-card-title">My Offers</h4>
                <p class="pro-card-subtitle">Track and manage all offers you've sent to potential clients</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="pro-badge primary">{{ offers|length }} Total</span>
                <a href="{{ path('professional_quotes') }}" class="pro-btn pro-btn-primary pro-btn-sm">
                    <i class="feather-plus"></i> New Offer
                </a>
            </div>
        </div>

        <div class="pro-table-wrapper">
            <table class="pro-table">
                <thead>
                    <tr>
                        <th>Quote Request</th>
                        <th>Amount</th>
                        <th>Message</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for offer in offers %}
                        <tr>
                            <td>
                                {% if offer.quoteRequest %}
                                    <div>
                                        <span class="pro-fw-semibold d-block">{{ offer.quoteRequest.title }}</span>
                                        <small class="pro-text-muted">
                                            <i class="feather-tag" ></i>
                                            {{ offer.quoteRequest.category ? offer.quoteRequest.category.name : 'N/A' }}
                                        </small>
                                    </div>
                                {% elseif offer.directRequest is defined and offer.directRequest %}
                                    <span class="pro-fw-semibold">{{ offer.directRequest.title|default('Direct Request') }}</span>
                                {% else %}
                                    <span class="pro-text-muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="pro-fw-bold" style="color:#10b981; font-size:1rem;">{{ offer.price|number_format(2) }} $</span>
                            </td>
                            <td>
                                <span class="pro-text-muted" style="font-size:1rem;">{{ offer.description|slice(0, 50) }}{% if offer.description|length > 50 %}...{% endif %}</span>
                            </td>
                            <td>
                                <span class="pro-text-muted">{{ offer.createdAt|date('M d, Y') }}</span>
                                {% if offer.updatedAt %}
                                    <br><small class="pro-text-muted" ><i class="feather-edit-3" style="font-size:0.65rem;"></i> {{ offer.updatedAt|date('M d') }}</small>
                                {% endif %}
                            </td>
                            <td>
                                {% if offer.status == 'DRAFT' %}
                                    <span class="pro-badge secondary"><i class="feather-file" style="font-size:0.65rem;"></i> Draft</span>
                                {% elseif offer.status == 'PUBLISHED' %}
                                    <span class="pro-badge info"><i class="feather-send" style="font-size:0.65rem;"></i> Sent</span>
                                {% elseif offer.status == 'ACCEPTED' %}
                                    {% if offer.quoteRequest and offer.quoteRequest.status == 'Closed' %}
                                        <span class="pro-badge secondary"><i class="feather-lock" style="font-size:0.65rem;"></i> Completed</span>
                                    {% else %}
                                        <span class="pro-badge success"><i class="feather-check-circle" style="font-size:0.65rem;"></i> Accepted</span>
                                    {% endif %}
                                {% elseif offer.status == 'REJECTED' %}
                                    <span class="pro-badge danger"><i class="feather-x-circle" style="font-size:0.65rem;"></i> Rejected</span>
                                {% else %}
                                    <span class="pro-badge secondary">{{ offer.status }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    {# View button — ALWAYS available #}
                                    <a href="{{ path('offer_view', {id: offer.id}) }}" class="pro-action-badge view" title="View Offer">
                                        <i class="feather-eye"></i>
                                    </a>

                                    {# Edit button — only for DRAFT offers, opens modal #}
                                    {% if offer.status == 'DRAFT' %}
                                        <button type="button" class="pro-action-badge edit" data-bs-toggle="modal" data-bs-target="#editOfferModal{{ offer.id }}" title="Edit Offer">
                                            <i class="feather-edit-2"></i>
                                        </button>
                                    {% else %}
                                        <span class="pro-action-badge view disabled" style="opacity: 0.5; cursor: not-allowed;" title="Published offers cannot be edited">
                                            <i class="feather-edit-2"></i>
                                        </span>
                                    {% endif %}

                                    {# Finalize button — only for ACCEPTED offers where request is not yet Closed #}
                                    {% if offer.status == 'ACCEPTED' and offer.quoteRequest and offer.quoteRequest.status != 'Closed' %}
                                        <button type="button" class="pro-action-badge view" style="background: rgba(16, 185, 129, 0.1); color: var(--pro-success-dark);" data-bs-toggle="modal" data-bs-target="#finalizeOfferModal{{ offer.id }}" title="Finalize Request">
                                            <i class="feather-check-circle"></i>
                                        </button>
                                    {% endif %}

                                    {# Delete button — only for DRAFT offers #}
                                    {% if offer.status == 'DRAFT' %}
                                        <button type="button" class="pro-action-badge delete" data-bs-toggle="modal" data-bs-target="#deleteOfferModal{{ offer.id }}" title="Delete Offer">
                                            <i class="feather-trash-2"></i>
                                        </button>
                                    {% endif %}

                                    {# Completed indicator #}
                                    {% if offer.status == 'ACCEPTED' and offer.quoteRequest and offer.quoteRequest.status == 'Closed' %}
                                        <span class="d-inline-flex align-items-center gap-1" style="color:#10b981; font-size:0.75rem;" title="Completed">
                                            <i class="feather-award" ></i>
                                        </span>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="pro-table-empty">
                                <div class="pro-empty-state">
                                    <div class="pro-empty-icon">
                                        <i class="feather-send"></i>
                                    </div>
                                    <h6 class="pro-empty-title">No offers sent yet</h6>
                                    <p class="pro-empty-text">Browse available quote requests and submit your best offer</p>
                                    <a href="{{ path('professional_quotes') }}" class="pro-btn pro-btn-primary pro-btn-sm mt-2">
                                        <i class="feather-search"></i> Browse Quotes
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block modals %}
    {{ parent() }}
    {% for offer in offers %}
        {% if offer.status == 'ACCEPTED' and offer.quoteRequest and offer.quoteRequest.status != 'Closed' %}
            <!-- Finalize Modal -->
            <div class="modal fade" id="finalizeOfferModal{{ offer.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg text-start" style="border-radius: 16px;">
                        <div class="modal-body p-4 text-center">
                            <div class="mb-4">
                                <div class="pro-stat-icon success mx-auto" style="width: 70px; height: 70px; font-size: 32px; background: rgba(16, 185, 129, 0.1); color: var(--pro-success);">
                                    <i class="feather-check-circle"></i>
                                </div>
                            </div>
                            <h4 class="fw-bold text-dark mb-2">Finalize Request?</h4>
                            <p class="text-muted px-4 mb-4">Mark this request as completed? The client will be notified that the work is successfully done.</p>
                            <div class="d-flex flex-column gap-3 mt-4">
                                <form method="post" action="{{ path('offer_finalize', {id: offer.id}) }}" class="w-100">
                                    <input type="hidden" name="_token" value="{{ csrf_token('finalize-offer-' ~ offer.id) }}">
                                    <button type="submit" class="pro-btn pro-btn-primary w-100 py-3 justify-content-center">
                                        <i class="feather-check-circle"></i> Yes, Mark as Completed
                                    </button>
                                </form>
                                <button type="button" class="pro-btn pro-btn-outline w-100 py-3 justify-content-center" data-bs-dismiss="modal">
                                    No, Not Yet
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        {% if offer.status == 'DRAFT' %}
            <!-- Edit Modal -->
            <div class="modal fade" id="editOfferModal{{ offer.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content pro-modal-content">
                        <div class="modal-header pro-modal-header border-bottom p-4">
                            <div>
                                <h5 class="modal-title fw-bold" style="font-size: 1.8rem;">Edit Your Offer</h5>
                                <p class="pro-text-muted mb-0" style="font-size: 1.1rem;">Update your proposal for: <strong>{{ (offer.quoteRequest ? offer.quoteRequest.title : (offer.directRequest ? offer.directRequest.title : 'Request')) }}</strong></p>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body pro-modal-body p-4">
                            {% set editForm = editForms[offer.id] %}
                            {{ form_start(editForm, {'attr': {'class': 'pro-form-row', 'id': 'editOfferForm' ~ offer.id, 'novalidate': 'novalidate'}}) }}
                                <div class="row g-4">
                                    <div class="col-12">
                                        <div class="pro-form-group">
                                            <label class="pro-form-label">Proposed Price ($) <span class="pro-text-danger">*</span></label>
                                            {{ form_widget(editForm.price, {'attr': {'class': 'pro-form-input', 'placeholder': 'e.g. 500'}}) }}
                                            {{ form_errors(editForm.price) }}
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="pro-form-group">
                                            <label class="pro-form-label">Message to Client <span class="pro-text-danger">*</span></label>
                                            {{ form_widget(editForm.description, {'attr': {'class': 'pro-form-textarea', 'rows': '6', 'placeholder': 'Explain your offer...'}}) }}
                                            {{ form_errors(editForm.description) }}
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="pro-form-group">
                                            <label class="pro-form-label">Supporting Documents <span class="pro-text-muted">(Optional)</span></label>
                                            {{ form_widget(editForm.documents, {'attr': {'class': 'pro-form-input'}}) }}
                                            {{ form_errors(editForm.documents) }}
                                            {% if offer.documents|length > 0 %}
                                                <div class="mt-2">
                                                    <p class="small text-muted mb-1">Current documents:</p>
                                                    <div class="d-flex flex-wrap gap-1">
                                                        {% for doc in offer.documents %}
                                                            <span class="badge bg-light text-dark border">{{ doc|slice(0, 20) }}...</span>
                                                        {% endfor %}
                                                    </div>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-4 d-flex gap-2">
                                    <button type="submit" name="action" value="publish" class="pro-btn pro-btn-primary flex-grow-1 py-3">
                                        <i class="feather-send"></i> Publish Offer
                                    </button>
                                    <button type="submit" name="action" value="draft" class="pro-btn pro-btn-outline flex-grow-1 py-3">
                                        <i class="feather-save"></i> Update Draft
                                    </button>
                                </div>
                            {{ form_end(editForm) }}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delete Modal -->
            <div class="modal fade" id="deleteOfferModal{{ offer.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg text-start" style="border-radius: 16px;">
                        <div class="modal-body p-4 text-center">
                            <div class="mb-4">
                                <div class="pro-stat-icon danger mx-auto" style="width: 70px; height: 70px; font-size: 32px; background: rgba(239, 68, 68, 0.1); color: var(--pro-danger);">
                                    <i class="feather-alert-triangle"></i>
                                </div>
                            </div>
                            <h4 class="fw-bold text-dark mb-2">Delete this offer?</h4>
                            <p class="text-muted px-4 mb-4">Are you sure you want to permanently delete this draft offer? This action cannot be undone.</p>
                            <div class="d-flex flex-column gap-3 mt-4">
                                <form method="post" action="{{ path('offer_delete', {id: offer.id}) }}" class="w-100">
                                     <input type="hidden" name="_token" value="{{ csrf_token('delete-offer-' ~ offer.id) }}">
                                    <button type="submit" class="pro-btn pro-btn-danger w-100 py-3 justify-content-center">
                                        <i class="feather-trash-2"></i> Yes, Delete Permanently
                                    </button>
                                </form>
                                <button type="button" class="pro-btn pro-btn-outline w-100 py-3 justify-content-center" data-bs-dismiss="modal">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}
{% endblock %}
