{% extends 'professional/base_professional.html.twig' %}

{% block title %}My Offers - {{ app.user.companyName|default('Professional') }}{% endblock %}

{% block body %}
    <div class="drl-card">
        <div class="drl-card-head border-bottom">
            <div>
                <h4 class="drl-card-title">My Offers</h4>
                <p class="drl-card-sub">Track and manage all offers you've sent to potential clients</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="drl-badge" style="background: #eff6ff; color: #00509e; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 700;">{{ offers|length }} Total</span>
                <a href="{{ path('professional_quotes') }}" class="drl-btn-orange" style="padding: 8px 16px; font-size: 13px; text-decoration: none;">
                    <i class="feather-plus"></i> New Offer
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table mb-0 drl-table">
                <thead>
                    <tr>
                        <th>Quote Request</th>
                        <th>Amount</th>
                        <th>Message</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for offer in offers %}
                        <tr>
                            <td>
                                {% if offer.quoteRequest %}
                                    <div>
                                        <span style="font-weight: 800; color: #0d2151; display: block;">{{ offer.quoteRequest.title }}</span>
                                        <small style="color: #64748b; font-size: 12px;">
                                            <i class="feather-tag" ></i>
                                            {{ offer.quoteRequest.category ? offer.quoteRequest.category.name : 'N/A' }}
                                        </small>
                                    </div>
                                {% elseif offer.directRequest is defined and offer.directRequest %}
                                    <span style="font-weight: 800; color: #0d2151; display: block;">{{ offer.directRequest.title|default('Direct Request') }}</span>
                                {% else %}
                                    <span style="color: #94a3b8;">—</span>
                                {% endif %}
                            </td>
                            <td>
                                <span style="font-weight: 800; color: #16a34a; font-size: 15px;">{{ offer.price|number_format(2) }} $</span>
                            </td>
                            <td>
                                <span style="color: #64748b; font-size: 13px;">{{ offer.description|slice(0, 50) }}{% if offer.description|length > 50 %}...{% endif %}</span>
                            </td>
                            <td>
                                <span style="color: #64748b; font-size: 13px;">{{ offer.createdAt|date('M d, Y') }}</span>
                                {% if offer.updatedAt %}
                                    <br><small style="color: #94a3b8; font-size: 11px;" ><i class="feather-edit-3"></i> {{ offer.updatedAt|date('M d') }}</small>
                                {% endif %}
                            </td>
                            <td>
                                {% if offer.status == 'DRAFT' %}
                                    <span class="drl-tag drl-tag--draft"><i class="feather-file" style="font-size: 11px;"></i> Draft</span>
                                {% elseif offer.status == 'PUBLISHED' %}
                                    <span class="drl-tag drl-tag--sent"><i class="feather-send" style="font-size: 11px;"></i> Sent</span>
                                {% elseif offer.status == 'ACCEPTED' %}
                                    {% if offer.quoteRequest and offer.quoteRequest.status == 'Closed' %}
                                        <span class="drl-tag drl-tag--draft"><i class="feather-lock" style="font-size: 11px;"></i> Completed</span>
                                    {% else %}
                                        <span class="drl-tag drl-tag--success"><i class="feather-check-circle" style="font-size: 11px;"></i> Accepted</span>
                                    {% endif %}
                                {% elseif offer.status == 'REJECTED' %}
                                    <span class="drl-tag drl-tag--danger"><i class="feather-x-circle" style="font-size: 11px;"></i> Rejected</span>
                                {% else %}
                                    <span class="drl-tag drl-tag--draft">{{ offer.status }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    {# View button — ALWAYS available #}
                                    <a href="{{ path('offer_view', {id: offer.id}) }}" class="drl-act-btn drl-act-btn--view" title="View Offer" style="text-decoration:none;">
                                        <i class="feather-eye"></i>
                                    </a>

                                    {# Edit button — only for DRAFT offers, opens modal #}
                                    {% if offer.status == 'DRAFT' %}
                                        <button type="button" class="drl-act-btn drl-act-btn--view" style="border:none;" data-bs-toggle="modal" data-bs-target="#editOfferModal{{ offer.id }}" title="Edit Offer">
                                            <i class="feather-edit-2"></i>
                                        </button>
                                    {% else %}
                                        <span class="drl-act-btn drl-act-btn--view" style="opacity: 0.5; cursor: not-allowed; border:none;" title="Published offers cannot be edited">
                                            <i class="feather-edit-2"></i>
                                        </span>
                                    {% endif %}

                                    {# Finalize button — only for ACCEPTED offers where request is not yet Closed #}
                                    {% if offer.status == 'ACCEPTED' and offer.quoteRequest and offer.quoteRequest.status != 'Closed' %}
                                        <button type="button" class="drl-act-btn" style="background: rgba(22, 163, 74, 0.1); color: #16a34a; border:none;" data-bs-toggle="modal" data-bs-target="#finalizeOfferModal{{ offer.id }}" title="Finalize Request">
                                            <i class="feather-check-circle"></i>
                                        </button>
                                    {% endif %}

                                    {# Delete button — only for DRAFT offers #}
                                    {% if offer.status == 'DRAFT' %}
                                        <button type="button" class="drl-act-btn" style="background: #fef2f2; color: #ef4444; border:none;" data-bs-toggle="modal" data-bs-target="#deleteOfferModal{{ offer.id }}" title="Delete Offer">
                                            <i class="feather-trash-2"></i>
                                        </button>
                                    {% endif %}

                                    {# Completed indicator #}
                                    {% if offer.status == 'ACCEPTED' and offer.quoteRequest and offer.quoteRequest.status == 'Closed' %}
                                        <span class="d-inline-flex align-items-center gap-1" style="color: #16a34a; font-size: 13px;" title="Completed">
                                            <i class="feather-award" ></i>
                                        </span>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div style="width:56px; height:56px; border-radius:50%; background:#f8fafc; color:#94a3b8; font-size:24px; display:inline-flex; align-items:center; justify-content:center; margin-bottom:12px;">
                                    <i class="feather-send"></i>
                                </div>
                                <h6 style="font-size:16px; font-weight:800; color:#0d2151; margin:0 0 6px;">No offers sent yet</h6>
                                <p style="font-size:14px; color:#64748b; margin:0 0 16px;">Browse available quote requests and submit your best offer</p>
                                <a href="{{ path('professional_quotes') }}" class="drl-btn-orange" style="padding: 8px 16px; font-size: 13px; text-decoration:none;">
                                    <i class="feather-search"></i> Browse Quotes
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block modals %}
    {{ parent() }}
    {% for offer in offers %}
        {% if offer.status == 'ACCEPTED' and offer.quoteRequest and offer.quoteRequest.status != 'Closed' %}
            <!-- Finalize Modal -->
            <div class="modal fade" id="finalizeOfferModal{{ offer.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content text-center" style="border: none; border-radius: 16px; box-shadow: 0 10px 40px rgba(13,33,81,0.2);">
                        <div class="modal-body pt-5 px-4 pb-4">
                            <div class="mb-4">
                                <div style="width: 72px; height: 72px; border-radius: 50%; background: #f0fdf4; color: #16a34a; font-size: 32px; display: inline-flex; align-items: center; justify-content: center; margin: 0 auto;">
                                    <i class="feather-check-circle"></i>
                                </div>
                            </div>
                            <h4 style="font-size: 20px; font-weight: 800; color: #0d2151; margin-bottom: 12px;">Finalize Request?</h4>
                            <p style="font-size: 14px; color: #64748b; margin-bottom: 32px;">Mark this request as completed? The client will be notified that the work is successfully done.</p>
                            <div class="d-flex flex-column gap-3 mt-4">
                                <form method="post" action="{{ path('offer_finalize', {id: offer.id}) }}" class="w-100">
                                    <input type="hidden" name="_token" value="{{ csrf_token('finalize-offer-' ~ offer.id) }}">
                                    <button type="submit" class="drl-btn-orange w-100 justify-content-center" style="background:#16a34a; box-shadow: 0 4px 14px rgba(22,163,74,0.25); padding: 14px;">
                                        <i class="feather-check-circle"></i> Yes, Mark as Completed
                                    </button>
                                </form>
                                <button type="button" style="width: 100%; justify-content: center; padding: 14px; background: transparent; border: 1px solid #cbd5e1; border-radius: 8px; color: #64748b; font-weight: 700; font-size: 14px;" data-bs-dismiss="modal">
                                    No, Not Yet
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        {% if offer.status == 'DRAFT' %}
            <!-- Edit Modal -->
            <div class="modal fade" id="editOfferModal{{ offer.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content" style="border: none; border-radius: 16px; box-shadow: 0 10px 40px rgba(13,33,81,0.2);">
                        <div class="modal-header" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; border-radius: 16px 16px 0 0; padding: 20px 24px;">
                            <div>
                                <h5 class="modal-title" style="font-weight: 800; color: #0d2151; margin: 0;">Edit Your Offer</h5>
                                <p style="font-size: 13px; color: #64748b; margin: 4px 0 0;">Update your proposal for: <strong>{{ (offer.quoteRequest ? offer.quoteRequest.title : (offer.directRequest ? offer.directRequest.title : 'Request')) }}</strong></p>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body" style="padding: 32px; max-height: 75vh; overflow-y: auto;">
                            {% set editForm = editForms[offer.id] %}
                            {{ form_start(editForm, {'attr': {'id': 'editOfferForm' ~ offer.id, 'novalidate': 'novalidate'}}) }}
                                <div class="row g-4">
                                    <div class="col-12">
                                        <div>
                                            <label class="drl-form-label">Proposed Price ($) <span style="color:#ef4444;">*</span></label>
                                            {{ form_widget(editForm.price, {'attr': {'class': 'drl-form-control w-100', 'placeholder': 'e.g. 500'}}) }}
                                            {{ form_errors(editForm.price) }}
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div>
                                            <label class="drl-form-label">Message to Client <span style="color:#ef4444;">*</span></label>
                                            {{ form_widget(editForm.description, {'attr': {'class': 'drl-form-control w-100', 'rows': '6', 'placeholder': 'Explain your offer...'}}) }}
                                            {{ form_errors(editForm.description) }}
                                        </div>
                                        <div class="mt-4">
                                            <label class="drl-form-label">Supporting Documents <span style="font-weight: 400; color: #94a3b8; font-size: 11px;">(Optional)</span></label>
                                            {{ form_widget(editForm.documents, {'attr': {'class': 'drl-form-control w-100'}}) }}
                                            {{ form_errors(editForm.documents) }}
                                            {% if offer.documents|length > 0 %}
                                                <div class="mt-2">
                                                    <p style="font-size: 12px; color: #64748b; margin-bottom: 8px;">Current documents:</p>
                                                    <div class="d-flex flex-wrap gap-2">
                                                        {% for doc in offer.documents %}
                                                            <span style="background: #f8fafc; border: 1px solid #e2e8f0; color: #475569; padding: 4px 8px; border-radius: 6px; font-size: 12px;">{{ doc|slice(0, 20) }}...</span>
                                                        {% endfor %}
                                                    </div>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-4 pt-4 border-top d-flex gap-3">
                                    <button type="submit" name="action" value="draft" style="width: 50%; justify-content: center; padding: 12px; background: transparent; border: 1px solid #cbd5e1; border-radius: 8px; color: #64748b; font-weight: 700; font-size: 14px;">
                                        <i class="feather-save"></i> Update Draft
                                    </button>
                                    <button type="submit" name="action" value="publish" class="drl-btn-orange" style="width: 50%; justify-content: center; padding: 12px;">
                                        <i class="feather-send"></i> Publish Offer
                                    </button>
                                </div>
                            {{ form_end(editForm) }}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delete Modal -->
            <div class="modal fade" id="deleteOfferModal{{ offer.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content text-center" style="border: none; border-radius: 16px; box-shadow: 0 10px 40px rgba(13,33,81,0.2);">
                        <div class="modal-body pt-5 px-4 pb-4">
                            <div class="mb-4">
                                <div style="width: 72px; height: 72px; border-radius: 50%; background: #fef2f2; color: #ef4444; font-size: 32px; display: inline-flex; align-items: center; justify-content: center; margin: 0 auto;">
                                    <i class="feather-alert-triangle"></i>
                                </div>
                            </div>
                            <h4 style="font-size: 20px; font-weight: 800; color: #0d2151; margin-bottom: 12px;">Delete this offer?</h4>
                            <p style="font-size: 14px; color: #64748b; margin-bottom: 32px;">Are you sure you want to permanently delete this draft offer? This action cannot be undone.</p>
                            <div class="d-flex flex-column gap-3 mt-4">
                                <form method="post" action="{{ path('offer_delete', {id: offer.id}) }}" class="w-100">
                                     <input type="hidden" name="_token" value="{{ csrf_token('delete-offer-' ~ offer.id) }}">
                                    <button type="submit" class="drl-btn-orange w-100 justify-content-center" style="background:#ef4444; box-shadow: 0 4px 14px rgba(239,68,68,0.25); padding: 14px;">
                                        <i class="feather-trash-2"></i> Yes, Delete Permanently
                                    </button>
                                </form>
                                <button type="button" style="width: 100%; justify-content: center; padding: 14px; background: transparent; border: 1px solid #cbd5e1; border-radius: 8px; color: #64748b; font-weight: 700; font-size: 14px;" data-bs-dismiss="modal">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}
{% endblock %}
