{% extends 'professional/base_professional.html.twig' %}

{% block title %}Quote Requests - {{ app.user.companyName|default('Professional') }}{% endblock %}

{% block body %}
    <div class="drl-card">
        <div class="drl-card-head border-bottom">
            <div>
                <h4 class="drl-card-title">Quote Requests</h4>
                <p class="drl-card-sub">Opportunities from individuals in your service category</p>
            </div>
            <span class="drl-badge" style="background: #eff6ff; color: #00509e; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 700;">{{ quotes|length }} Available</span>
        </div>

        <div class="table-responsive">
            <table class="table mb-0 drl-table">
                <thead>
                    <tr>
                        <th>Request Details</th>
                        <th>Category</th>
                        <th>Client</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for quote in quotes %}
                        <tr>
                            <td>
                                <div>
                                    <span style="font-weight: 800; color: #0d2151; display: block;">{{ quote.title }}</span>
                                    <span style="font-size: 13px; color: #64748b; margin-top: 4px;">{{ quote.description|slice(0, 70) }}{% if quote.description|length > 70 %}...{% endif %}</span>
                                </div>
                            </td>
                            <td>
                                {% if quote.category %}
                                    <span class="drl-tag drl-tag--draft" style="background:#f8fafc; color:#475569;">{{ quote.category.localizedTitle(app.request.locale) }}</span>
                                {% else %}
                                    <span style="color:#94a3b8;">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% set clientName = quote.individual.personalInfos ? (quote.individual.personalInfos.firstName|default('') ~ ' ' ~ quote.individual.personalInfos.lastName|default(''))|trim : '' %}
                                <span style="color: #475569; font-weight: 600;">{{ clientName ?: quote.individual.email|default('Client') }}</span>
                            </td>
                            <td>
                                <span style="color: #64748b; font-size: 13px;">{{ quote.creationDate|date('M d, Y') }}</span>
                            </td>
                            <td>
                                {# Show if this pro already sent an offer #}
                                {% if quote.id in myOfferQuoteIds|keys %}
                                    {% set myStatus = myOfferQuoteIds[quote.id] %}
                                    {% if myStatus == 'PENDING' %}
                                        <span class="drl-tag drl-tag--sent"><i class="feather-check" style="font-size: 11px;"></i> Offer Sent</span>
                                    {% elseif myStatus == 'ACCEPTED' %}
                                        <span class="drl-tag drl-tag--success"><i class="feather-check-circle" style="font-size: 11px;"></i> Accepted</span>
                                    {% elseif myStatus == 'REJECTED' %}
                                        <span class="drl-tag drl-tag--danger"><i class="feather-x-circle" style="font-size: 11px;"></i> Rejected</span>
                                    {% endif %}
                                {% else %}
                                    {% if quote.status == 'Accepted' %}
                                        <span class="drl-tag drl-tag--draft"><i class="feather-lock" style="font-size: 11px;"></i> Taken</span>
                                    {% else %}
                                        <span class="drl-tag drl-tag--success"><i class="feather-zap" style="font-size: 11px;"></i> Open</span>
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap align-items-center">
                                {# Always-available: view request details #}
                                <a href="{{ path('offer_send', {id: quote.id}) }}"
                                   class="drl-act-btn drl-act-btn--view"
                                   style="text-decoration:none; font-size:12px; padding:5px 10px; border-radius:6px; display:inline-flex; align-items:center; gap:4px;"
                                   title="View Request Details">
                                    <i class="feather-eye"></i>
                                    <span>Details</span>
                                </a>

                                {% if quote.id in myOfferQuoteIds|keys %}
                                    <a href="{{ path('offer_send', {id: quote.id}) }}"
                                       class="drl-act-btn drl-act-btn--view"
                                       style="text-decoration:none; font-size:12px; padding:5px 10px; border-radius:6px; display:inline-flex; align-items:center; gap:4px;">
                                        <i class="feather-edit-2"></i>
                                        <span>Edit Offer</span>
                                    </a>
                                {% elseif quote.status != 'Accepted' %}
                                    <a href="{{ path('offer_send', {id: quote.id}) }}"
                                       class="drl-btn-orange"
                                       style="padding:5px 12px; font-size:12px; text-decoration:none; border-radius:6px; display:inline-flex; align-items:center; gap:5px;">
                                        <i class="feather-send"></i>
                                        <span>Submit Offer</span>
                                    </a>
                                {% endif %}
                            </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div style="width:56px; height:56px; border-radius:50%; background:#f8fafc; color:#94a3b8; font-size:24px; display:inline-flex; align-items:center; justify-content:center; margin-bottom:12px;">
                                    <i class="feather-message-square"></i>
                                </div>
                                <h6 style="font-size:16px; font-weight:800; color:#0d2151; margin:0 0 6px;">No quote requests</h6>
                                <p style="font-size:14px; color:#64748b; margin:0 0 16px;">No active quote requests found in your category</p>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
