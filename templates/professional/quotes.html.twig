{% extends 'professional/base_professional.html.twig' %}

{% block title %}Quote Requests - {{ app.user.companyName|default('Professional') }}{% endblock %}

{% block body %}
    <div class="pro-card pro-card-elevated">
        <div class="pro-card-header border-bottom">
            <div>
                <h4 class="pro-card-title">Quote Requests</h4>
                <p class="pro-card-subtitle">Opportunities from individuals in your service category</p>
            </div>
            <span class="pro-badge info">{{ quotes|length }} Available</span>
        </div>

        <div class="pro-table-wrapper">
            <table class="pro-table">
                <thead>
                    <tr>
                        <th>Request Details</th>
                        <th>Category</th>
                        <th>Client</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for quote in quotes %}
                        <tr>
                            <td>
                                <div>
                                    <span class="pro-fw-semibold d-block">{{ quote.title }}</span>
                                    <span class="pro-text-muted">{{ quote.description|slice(0, 70) }}{% if quote.description|length > 70 %}...{% endif %}</span>
                                </div>
                            </td>
                            <td>
                                {% if quote.category %}
                                    <span class="pro-badge info" >{{ quote.category.name }}</span>
                                {% else %}
                                    <span class="pro-text-muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% set clientName = quote.individual.personalInfos ? (quote.individual.personalInfos.firstName|default('') ~ ' ' ~ quote.individual.personalInfos.lastName|default(''))|trim : '' %}
                                <span>{{ clientName ?: quote.individual.email|default('Client') }}</span>
                            </td>
                            <td>
                                <span class="pro-text-muted">{{ quote.creationDate|date('M d, Y') }}</span>
                            </td>
                            <td>
                                {# Show if this pro already sent an offer #}
                                {% if quote.id in myOfferQuoteIds|keys %}
                                    {% set myStatus = myOfferQuoteIds[quote.id] %}
                                    {% if myStatus == 'PENDING' %}
                                        <span class="pro-badge primary" ><i class="feather-check" ></i> Offer Sent</span>
                                    {% elseif myStatus == 'ACCEPTED' %}
                                        <span class="pro-badge success" ><i class="feather-check-circle" ></i> Accepted</span>
                                    {% elseif myStatus == 'REJECTED' %}
                                        <span class="pro-badge danger" ><i class="feather-x-circle" ></i> Rejected</span>
                                    {% endif %}
                                {% else %}
                                    {% if quote.status == 'Accepted' %}
                                        <span class="pro-badge secondary" ><i class="feather-lock" ></i> Taken</span>
                                    {% else %}
                                        <span class="pro-badge success" ><i class="feather-zap" ></i> Open</span>
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td>
                                {% if quote.id in myOfferQuoteIds|keys %}
                                    <a href="{{ path('offer_send', {id: quote.id}) }}" class="pro-action-badge edit">
                                        <i class="feather-edit-2"></i> Edit Offer
                                    </a>
                                {% elseif quote.status != 'Accepted' %}
                                    <a href="{{ path('offer_send', {id: quote.id}) }}" class="pro-action-badge view">
                                        <i class="feather-send"></i> Submit Offer
                                    </a>
                                {% else %}
                                    <span class="pro-text-muted">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="pro-table-empty">
                                <div class="pro-empty-state">
                                    <div class="pro-empty-icon">
                                        <i class="feather-message-square"></i>
                                    </div>
                                    <h6 class="pro-empty-title">No quote requests</h6>
                                    <p class="pro-empty-text">No active quote requests found in your category</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
