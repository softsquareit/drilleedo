{% extends 'professional/base_professional.html.twig' %}

{% block title %}{{ 'Mes Projets'|trans }} - {{ app.user.companyName }}{% endblock %}

{% block body %}
    <div class="drl-card">
        <div class="drl-card-head">
            <div>
                <h4 class="drl-card-title">{{ 'Mes Projets'|trans }}</h4>
                <p class="drl-card-sub">{{ 'Présentez votre portfolio et suivez vos travaux terminés'|trans }}</p>
            </div>
            <button type="button" class="drl-btn-orange" style="padding: 8px 16px; font-size: 13px;" data-bs-toggle="modal" data-bs-target="#newProjectModal">
                <i class="ph-plus"></i> {{ 'Ajouter un projet'|trans }}
            </button>
        </div>

        <div class="table-responsive">
            <table class="table mb-0 drl-table" id="projectsTable">
                <thead>
                    <tr>
                        <th>{{ 'Nom du projet'|trans }}</th>
                        <th>{{ 'Dates'|trans }}</th>
                        <th>{{ 'Visibilité'|trans }}</th>
                        <th>{{ 'Statut'|trans }}</th>
                        <th>{{ 'Actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for project in projects %}
                        <tr>
                            <td>
                                <span style="font-weight: 800; color: #0d2151;">{{ project.name }}</span>
                                <p style="font-size: 13px; color: #64748b; margin: 4px 0 0;">{{ project.description|slice(0, 60) }}...</p>
                            </td>
                             <td>
                                <div style="font-size: 13px; color: #64748b; line-height: 1.6;">
                                    <div><strong style="color: #94a3b8; font-size: 11px; text-transform: uppercase;">{{ 'Début'|trans }}:</strong> {{ project.startDate|date('M d, Y') }}</div>
                                    {% if project.EndDate %}
                                        <div><strong style="color: #94a3b8; font-size: 11px; text-transform: uppercase;">{{ 'Fin'|trans }}:</strong> {{ project.EndDate|date('M d, Y') }}</div>
                                    {% endif %}
                                </div>
                            </td>
                            <td>
                                {% if project.isState %}
                                    <span class="drl-tag drl-tag--success"><i class="ph-eye" style="font-size: 11px;"></i> {{ 'Publié'|trans }}</span>
                                {% else %}
                                    <span class="drl-tag drl-tag--draft"><i class="ph-eye-slash" style="font-size: 11px;"></i> {{ 'Brouillon'|trans }}</span>
                                {% endif %}
                            </td>
                             <td>
                                {% if project.EndDate %}
                                    <span class="drl-tag drl-tag--success"><i class="ph-flag" style="font-size: 11px;"></i> {{ 'Terminé'|trans }}</span>
                                {% else %}
                                    <span class="drl-tag drl-tag--sent"><i class="ph-spinner ph-spin" style="font-size: 11px;"></i> {{ 'En cours'|trans }}</span>
                                {% endif %}
                            </td>
                            <td>
                                 <div class="d-flex gap-2">
                                    <button type="button" class="drl-act-btn drl-act-btn--view" style="border:none;" title="{{ 'Modifier'|trans }}" data-bs-toggle="modal" data-bs-target="#editProjectModal{{ project.id }}">
                                        <i class="ph-pencil-simple-line"></i> {{ 'Modifier'|trans }}
                                    </button>
                                    <button type="button" class="drl-act-btn" style="background:#fef2f2; color:#ef4444; border:none;" data-bs-toggle="modal" data-bs-target="#deleteProjectModal{{ project.id }}" title="{{ 'Supprimer'|trans }}">
                                        <i class="ph-trash"></i> {{ 'Supprimer'|trans }}
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                             <td colspan="5" class="text-center py-5">
                                <div style="width:56px; height:56px; border-radius:50%; background:#f8fafc; color:#94a3b8; font-size:24px; display:inline-flex; align-items:center; justify-content:center; margin-bottom:12px;">
                                    <i class="ph-briefcase"></i>
                                </div>
                                <h6 style="font-size:16px; font-weight:800; color:#0d2151; margin:0 0 6px;">{{ 'Aucun projet pour le moment'|trans }}</h6>
                                <p style="font-size:14px; color:#64748b; margin:0 0 16px;">{{ "Ajoutez votre premier projet pour présenter votre travail"|trans }}</p>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block modals %}
    {{ parent() }}
    <!-- Add Project Modal -->
    <div class="modal fade" id="newProjectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" style="border: none; border-radius: 16px; box-shadow: 0 10px 40px rgba(13,33,81,0.2);">
                 <div class="modal-header drl-modal-header">
                    <div>
                        <h5 class="modal-title drl-modal-title">
                            <i class="ph-plus-circle me-2"></i>{{ 'Ajouter un nouveau projet'|trans }}
                        </h5>
                        <p class="mb-0 opacity-75 small mt-1">{{ "Présentez vos derniers travaux à vos clients potentiels"|trans }}</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body drl-modal-body" style="max-height: 75vh; overflow-y: auto;">
                    {{ form_start(projectForm, {'attr': {'id': 'addProjectForm'}}) }}
                        <div class="row g-4">
                             <div class="col-12">
                                <div>
                                    <label class="drl-label">{{ 'Nom du projet'|trans }} <span class="text-danger">*</span></label>
                                    {{ form_widget(projectForm.name, {'attr': {'class': 'drl-input', 'placeholder': 'Ex: Rénovation moderne de cuisine'|trans}}) }}
                                    {{ form_errors(projectForm.name) }}
                                </div>
                            </div>
                             <div class="col-12">
                                <div>
                                    <label class="drl-label">{{ 'Description'|trans }} <span class="text-danger">*</span></label>
                                    {{ form_widget(projectForm.description, {'attr': {'class': 'drl-input', 'rows': 4, 'placeholder': "Décrivez l'étendue, les défis et les résultats de ce projet..."|trans}}) }}
                                    {{ form_errors(projectForm.description) }}
                                </div>
                            </div>
                             <div class="col-md-6">
                                <div>
                                    <label class="drl-label">{{ 'Date de début'|trans }} <span class="text-danger">*</span></label>
                                    {{ form_widget(projectForm.startDate, {'attr': {'class': 'drl-input'}}) }}
                                    {{ form_errors(projectForm.startDate) }}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div>
                                    <label class="drl-label">{{ 'Date de fin'|trans }} <span class="small opacity-50 fw-normal">({{ 'Optionnel'|trans }})</span></label>
                                    {{ form_widget(projectForm.EndDate, {'attr': {'class': 'drl-input'}}) }}
                                    {{ form_errors(projectForm.EndDate) }}
                                    <p class="small text-muted mb-0 mt-1">{{ "Laissez vide si le projet est en cours"|trans }}</p>
                                </div>
                            </div>
                            
                            <!-- Drag & Drop Photo -->
                            <div class="col-12">
                                <div>
                                     <label class="drl-label">{{ 'Photo principale du projet'|trans }} <span class="text-danger">*</span></label>
                                    <div class="pro-upload-zone" id="mainPhotoZone" style="border-radius: 12px; border: 2px dashed #cbd5e1; background: #f8fafc;">
                                        <i class="ph-image pro-upload-icon" style="color: #94a3b8;"></i>
                                        <p class="pro-upload-text" style="color: #0d2151; font-weight: 700;">{{ "Glisser & déposer ou Cliquer pour télécharger"|trans }}</p>
                                        <p class="pro-upload-hint" style="color: #64748b;">PNG, JPG, ou WEBP (Max 5MB)</p>
                                        {{ form_widget(projectForm.mainPhoto, {'attr': {'class': 'd-none', 'accept': 'image/*'}}) }}
                                    </div>
                                    <div id="mainPhotoPreview" class="pro-preview-grid" style="display: none; margin-top: 16px;"></div>
                                    {{ form_errors(projectForm.mainPhoto) }}
                                </div>
                            </div>

                            <div class="col-12">
                                <div>
                                     <label class="drl-label">{{ "Galerie du projet"|trans }} <span class="small opacity-50 fw-normal">({{ "Images multiples optionnelles"|trans }})</span></label>
                                    <div class="pro-upload-zone" id="galleryZone" style="border-radius: 12px; border: 2px dashed #cbd5e1; background: #f8fafc;">
                                        <i class="ph-grid-four pro-upload-icon" style="color: #94a3b8;"></i>
                                        <p class="pro-upload-text" style="color: #0d2151; font-weight: 700;">{{ "Télécharger plusieurs photos"|trans }}</p>
                                        <p class="pro-upload-hint" style="color: #64748b;">{{ "Mettez en avant différents angles ou détails"|trans }}</p>
                                        {{ form_widget(projectForm.gallery, {'attr': {'class': 'd-none', 'accept': 'image/*', 'multiple': 'multiple'}}) }}
                                    </div>
                                    <div id="galleryPreview" class="pro-preview-grid" style="margin-top: 16px;"></div>
                                    {{ form_errors(projectForm.gallery) }}
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="d-flex align-items-center gap-3 p-3 rounded" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                    <div class="form-check form-switch mb-0">
                                        {{ form_widget(projectForm.state, {'attr': {'class': 'form-check-input', 'style': 'width: 40px; height: 20px;'}}) }}
                                    </div>
                                     <div>
                                        <label class="drl-label mb-0" for="{{ projectForm.state.vars.id }}">{{ "Publier immédiatement"|trans }}</label>
                                        <p class="small text-muted mb-0">{{ "Le rendre public l'affichera immédiatement sur votre profil"|trans }}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {{ form_end(projectForm) }}
                </div>
                 <div class="modal-footer drl-modal-footer">
                    <button type="button" class="btn btn-link text-muted text-decoration-none fw-bold" data-bs-dismiss="modal">{{ 'Annuler'|trans }}</button>
                    <button type="submit" form="addProjectForm" class="drl-btn-orange px-5">
                        <i class="ph-floppy-disk me-2"></i> {{ 'Créer le projet'|trans }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit and Delete Modals for Each Project -->
    {% for project in projects %}
        <!-- Edit Modal -->
        <div class="modal fade" id="editProjectModal{{ project.id }}" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content drl-modal-content">
                     <div class="modal-header drl-modal-header">
                        <div>
                            <h5 class="modal-title drl-modal-title">
                                <i class="ph-pencil me-2"></i>{{ 'Modifier les détails du projet'|trans }}
                            </h5>
                            <p class="mb-0 opacity-75 small mt-1">{{ "Modifiez les informations de votre projet et la galerie"|trans }}</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body drl-modal-body" style="max-height: 75vh; overflow-y: auto;">
                        {% set editForm = editForms[project.id] %}
                        {{ form_start(editForm, {'attr': {'id': 'editProjectForm' ~ project.id}}) }}
                            <div class="row g-4">
                                 <div class="col-12">
                                    <div>
                                        <label class="drl-label">{{ 'Nom du projet'|trans }} <span class="text-danger">*</span></label>
                                        {{ form_widget(editForm.name, {'attr': {'class': 'drl-input'}}) }}
                                        {{ form_errors(editForm.name) }}
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div>
                                        <label class="drl-label">{{ 'Description'|trans }} <span class="text-danger">*</span></label>
                                        {{ form_widget(editForm.description, {'attr': {'class': 'drl-input', 'rows': 4}}) }}
                                        {{ form_errors(editForm.description) }}
                                    </div>
                                </div>
                                 <div class="col-md-6">
                                    <div>
                                        <label class="drl-label">{{ 'Date de début'|trans }}</label>
                                        {{ form_widget(editForm.startDate, {'attr': {'class': 'drl-input'}}) }}
                                        {{ form_errors(editForm.startDate) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div>
                                        <label class="drl-label">{{ 'Date de fin'|trans }}</label>
                                        {{ form_widget(editForm.EndDate, {'attr': {'class': 'drl-input'}}) }}
                                        {{ form_errors(editForm.EndDate) }}
                                    </div>
                                </div>

                                <!-- Main Photo Edit -->
                                 <div class="col-12">
                                    <div>
                                        <label class="drl-label">{{ 'Photo principale du projet'|trans }}</label>
                                        <div class="pro-upload-zone mb-3" id="mainPhotoZone{{ project.id }}" style="border-radius: 12px; border: 2px dashed #cbd5e1; background: #f8fafc;">
                                            <i class="ph-image pro-upload-icon" style="color: #94a3b8;"></i>
                                            <p class="pro-upload-text" style="color: #0d2151; font-weight: 700;">{{ "Remplacer la photo actuelle"|trans }}</p>
                                            {{ form_widget(editForm.mainPhoto, {'attr': {'class': 'd-none', 'accept': 'image/*'}}) }}
                                        </div>
                                        <div id="mainPhotoPreview{{ project.id }}" class="pro-preview-grid">
                                            {% if project.mainPhoto %}
                                                <div class="pro-preview-item" style="border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                                                    <img src="{{ asset('uploads/projects/' ~ project.mainPhoto) }}" alt="Current">
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="d-flex align-items-center gap-3 p-3 rounded" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                        <div class="form-check form-switch mb-0">
                                            {{ form_widget(editForm.state, {'attr': {'class': 'form-check-input', 'style': 'width: 40px; height: 20px;'}}) }}
                                        </div>
                                         <div>
                                            <label class="drl-label mb-0" for="{{ editForm.state.vars.id }}">{{ 'Publié'|trans }}</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {# Skip gallery in simple edit modal for now #}
                            {{ form_row(editForm.gallery, {'attr': {'class': 'd-none'}}) }}
                        {{ form_end(editForm) }}
                    </div>
                     <div class="modal-footer drl-modal-footer">
                        <button type="button" class="btn btn-link text-muted text-decoration-none fw-bold" data-bs-dismiss="modal">{{ 'Annuler'|trans }}</button>
                        <button type="submit" form="editProjectForm{{ project.id }}" class="drl-btn-orange px-5" style="background: #16a34a; box-shadow: 0 4px 14px rgba(22,163,74,0.25);">
                            <i class="ph-floppy-disk me-2"></i> {{ 'Enregistrer les modifications'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Modal -->
        <div class="modal fade" id="deleteProjectModal{{ project.id }}" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content drl-modal-content text-center">
                    <div class="modal-body drl-modal-body py-5 px-4 text-center">
                         <div class="mb-4">
                            <div class="drl-stat-icon drl-stat-icon--2 mx-auto shadow-sm" style="width: 72px; height: 72px; font-size: 32px; background: #fef2f2; color: #ef4444; border-color: #fee2e2;">
                                <i class="ph-warning"></i>
                            </div>
                        </div>
                         <h4 class="drl-card-title mb-2" style="font-size: 20px;">{{ 'Supprimer le projet ?'|trans }}</h4>
                        <p class="text-muted mb-4">
                            {{ 'Êtes-vous sûr de vouloir supprimer définitivement'|trans }} <strong>"{{ project.name }}"</strong>? {{ 'Cette action est irréversible.'|trans }}
                        </p>
                        <div class="d-flex flex-column gap-2 mt-4">
                            <form method="post" action="{{ path('professional_project_delete', {id: project.id}) }}" class="w-100">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                                 <button type="submit" class="drl-btn-orange w-100 justify-content-center" style="background:#ef4444; box-shadow: 0 4px 14px rgba(239,68,68,0.25);">
                                    <i class="ph-trash me-2"></i> {{ 'Oui, supprimer définitivement'|trans }}
                                </button>
                            </form>
                            <button type="button" class="btn btn-link text-muted text-decoration-none fw-bold" data-bs-dismiss="modal">
                                {{ 'Annuler'|trans }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}

<script>
document.addEventListener('DOMContentLoaded', function() {
    function setupDragAndDrop(zoneId, inputId, previewId, multiple = false) {
        const zone = document.getElementById(zoneId);
        const input = document.getElementById(inputId);
        const preview = document.getElementById(previewId);

        if (!zone || !input || !preview) return;

        zone.addEventListener('click', () => input.click());

        zone.addEventListener('dragover', (e) => {
            e.preventDefault();
            zone.style.borderColor = '#00509e';
            zone.style.backgroundColor = '#eff6ff';
        });

        ['dragleave', 'dragend'].forEach(type => {
            zone.addEventListener(type, () => {
                zone.style.borderColor = '#cbd5e1';
                zone.style.backgroundColor = '#f8fafc';
            });
        });

        zone.addEventListener('drop', (e) => {
            e.preventDefault();
            zone.style.borderColor = '#cbd5e1';
            zone.style.backgroundColor = '#f8fafc';
            if (e.dataTransfer.files.length) {
                input.files = e.dataTransfer.files;
                updatePreviews(e.dataTransfer.files, preview, multiple);
            }
        });

        input.addEventListener('change', () => {
            updatePreviews(input.files, preview, multiple);
        });
    }

    function updatePreviews(files, previewContainer, multiple) {
        if (!multiple) previewContainer.innerHTML = '';
        previewContainer.style.display = 'grid';

        Array.from(files).forEach(file => {
            if (file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const item = document.createElement('div');
                    item.className = 'pro-preview-item';
                    item.style = 'border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-top: 10px;';
                    item.innerHTML = `<img src="${e.target.result}" alt="Preview" style="width:100%; height:auto;">`;
                    previewContainer.appendChild(item);
                };
                reader.readAsDataURL(file);
            }
        });
    }

    // Initialize Add Project
    setupDragAndDrop('mainPhotoZone', '{{ projectForm.mainPhoto.vars.id }}', 'mainPhotoPreview', false);
    setupDragAndDrop('galleryZone', '{{ projectForm.gallery.vars.id }}', 'galleryPreview', true);

    // Initialize Edit Projects
    {% for project in projects %}
        {% set ef = editForms[project.id] %}
        setupDragAndDrop('mainPhotoZone{{ project.id }}', '{{ ef.mainPhoto.vars.id }}', 'mainPhotoPreview{{ project.id }}', false);
    {% endfor %}

    // Reopen Add Modal if errors
    {% if not projectForm.vars.valid %}
        const newProjModal = new bootstrap.Modal(document.getElementById('newProjectModal'));
        newProjModal.show();
    {% endif %}
});
</script>
{% endblock %}
