{% extends 'professional/base_professional.html.twig' %}

{% block title %}My Projects - {{ app.user.companyName }}{% endblock %}

{% block body %}
    <div class="pro-card pro-card-elevated">
        <div class="pro-card-header">
            <div>
                <h4 class="pro-card-title">My Projects</h4>
                <p class="pro-card-subtitle">Showcase your portfolio and track your completed work</p>
            </div>
            <button type="button" class="pro-btn pro-btn-primary" data-bs-toggle="modal" data-bs-target="#newProjectModal">
                <i class="feather-plus"></i> Add Project
            </button>
        </div>

        <div class="pro-table-wrapper">
            <table class="pro-table">
                <thead>
                    <tr>
                        <th>Project Name</th>
                        <th>Dates</th>
                        <th>Visibility</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for project in projects %}
                        <tr>
                            <th>
                                <span class="pro-fw-semibold">{{ project.name }}</span>
                                <p class="pro-text-muted" style="font-size: 0.8125rem; margin-top: 4px;">{{ project.description|slice(0, 60) }}...</p>
                            </th>
                            <td>
                                <div class="pro-text-muted" style="font-size: 1.4rem;">
                                    <div>Start: {{ project.startDate|date('M d, Y') }}</div>
                                    {% if project.EndDate %}
                                        <div>End: {{ project.EndDate|date('M d, Y') }}</div>
                                    {% endif %}
                                </div>
                            </td>
                            <td>
                                {% if project.isState %}
                                    <span class="pro-badge success"><i class="feather-eye"></i> Published</span>
                                {% else %}
                                    <span class="pro-badge pro-badge-outline"><i class="feather-eye-off"></i> Draft</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if project.EndDate %}
                                    <span class="pro-badge info">Completed</span>
                                {% else %}
                                    <span class="pro-badge primary">In Progress</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a href="{{ path('professional_project_edit', {id: project.id}) }}" class="pro-btn pro-btn-outline pro-btn-sm" title="Edit">
                                        <i class="feather-edit"></i>
                                    </a>
                                    <form method="post" action="{{ path('professional_project_delete', {id: project.id}) }}" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this project?');">
                                        <button type="submit" class="pro-btn pro-btn-outline pro-btn-sm" style="color: var(--pro-danger); border-color: var(--pro-danger);" title="Delete">
                                            <i class="feather-trash-2"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="pro-table-empty">
                                <div class="pro-empty-state">
                                    <div class="pro-empty-icon">
                                        <i class="feather-briefcase"></i>
                                    </div>
                                    <h6 class="pro-empty-title">No projects yet</h6>
                                    <p class="pro-empty-text">Add your first project to showcase your work</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block modals %}
<div class="modal fade" id="newProjectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content pro-modal-content">
            <div class="modal-header pro-modal-header">
                <h5 class="modal-title fw-bold">Add New Project</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pro-modal-body">
                {{ form_start(projectForm, {'attr': {'class': 'pro-form-row'}}) }}
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="pro-form-group">
                                <label class="pro-form-label">Project Name</label>
                                {{ form_widget(projectForm.name, {'attr': {'class': 'pro-form-input'}}) }}
                                {{ form_errors(projectForm.name) }}
                            </div>
                        </div>
                         <div class="col-12">
                             <div class="pro-form-group">
                                 <label class="pro-form-label">Description</label>
                                 {{ form_widget(projectForm.description, {'attr': {'class': 'pro-form-textarea', 'rows': 3}}) }}
                                 {{ form_errors(projectForm.description) }}
                             </div>
                         </div>
                        <div class="col-md-6">
                             <div class="pro-form-group">
                                <label class="pro-form-label">Start Date</label>
                                {{ form_widget(projectForm.startDate, {'attr': {'class': 'pro-form-input'}}) }}
                                {{ form_errors(projectForm.startDate) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                             <div class="pro-form-group">
                                <label class="pro-form-label">End Date <span class="pro-text-muted">(Optional)</span></label>
                                {{ form_widget(projectForm.EndDate, {'attr': {'class': 'pro-form-input'}}) }}
                                {{ form_errors(projectForm.EndDate) }}
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="pro-form-group">
                                <label class="pro-form-label">Main Project Photo</label>
                                {{ form_widget(projectForm.mainPhoto, {'attr': {'class': 'pro-form-input', 'accept': 'image/*'}}) }}
                                {{ form_errors(projectForm.mainPhoto) }}
                                <p class="pro-form-help">Recommended size: 800x600px</p>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="pro-form-group">
                                <label class="pro-form-label">Project Gallery <span class="pro-text-muted">(Multiple images)</span></label>
                                {{ form_widget(projectForm.gallery, {'attr': {'class': 'pro-form-input', 'accept': 'image/*', 'multiple': 'multiple'}}) }}
                                {{ form_errors(projectForm.gallery) }}
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch pro-form-group mb-0">
                                {{ form_widget(projectForm.state, {'attr': {'class': 'form-check-input'}}) }}
                                <label class="pro-form-label mb-0 ms-2" for="{{ projectForm.state.vars.id }}">Publish this project immediately</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-flex justify-content-end gap-2 mt-2">
                                <button type="button" class="pro-btn pro-btn-outline" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="pro-btn pro-btn-primary">
                                    <i class="feather-save"></i> Save Project
                                </button>
                            </div>
                        </div>
                    </div>
                {{ form_end(projectForm) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
