{% extends 'professional/base_professional.html.twig' %}

{% block title %}My Projects - {{ app.user.companyName }}{% endblock %}

{% block body %}
    <div class="pro-card pro-card-elevated">
        <div class="pro-card-header">
            <div>
                <h4 class="pro-card-title">My Projects</h4>
                <p class="pro-card-subtitle">Showcase your portfolio and track your completed work</p>
            </div>
            <button type="button" class="pro-btn pro-btn-primary" data-bs-toggle="modal" data-bs-target="#newProjectModal">
                <i class="feather-plus"></i> Add Project
            </button>
        </div>

        <div class="pro-table-wrapper">
            <table class="pro-table">
                <thead>
                    <tr>
                        <th>Project Name</th>
                        <th>Dates</th>
                        <th>Visibility</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for project in projects %}
                        <tr>
                            <th>
                                <span class="pro-fw-semibold">{{ project.name }}</span>
                                <p class="pro-text-muted" style="font-size: 1rem; margin-top: 4px;">{{ project.description|slice(0, 60) }}...</p>
                            </th>
                            <td>
                                <div class="pro-text-muted" style="font-size: 1.4rem;">
                                    <div>Start: {{ project.startDate|date('M d, Y') }}</div>
                                    {% if project.EndDate %}
                                        <div>End: {{ project.EndDate|date('M d, Y') }}</div>
                                    {% endif %}
                                </div>
                            </td>
                            <td>
                                {% if project.isState %}
                                    <span class="pro-badge success"><i class="feather-eye"></i> Published</span>
                                {% else %}
                                    <span class="pro-badge pro-badge-outline"><i class="feather-eye-off"></i> Draft</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if project.EndDate %}
                                    <span class="pro-badge info">Completed</span>
                                {% else %}
                                    <span class="pro-badge primary">In Progress</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <button type="button" class="pro-action-badge edit" title="Edit" data-bs-toggle="modal" data-bs-target="#editProjectModal{{ project.id }}">
                                        <i class="feather-edit-2"></i> Edit
                                    </button>
                                    <button type="button" class="pro-action-badge delete" data-bs-toggle="modal" data-bs-target="#deleteProjectModal{{ project.id }}" title="Delete">
                                        <i class="feather-trash-2"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="pro-table-empty">
                                <div class="pro-empty-state">
                                    <div class="pro-empty-icon">
                                        <i class="feather-briefcase"></i>
                                    </div>
                                    <h6 class="pro-empty-title">No projects yet</h6>
                                    <p class="pro-empty-text">Add your first project to showcase your work</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block modals %}
    {{ parent() }}
    <div class="modal fade" id="newProjectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content pro-modal-content">
            <div class="modal-header pro-modal-header">
                <div>
                    <h5 class="modal-title fw-bold" style="font-size: 2rem;">Add New Project</h5>
                    <p class="pro-text-muted mb-0" style="font-size: 1.3rem;">Showcase your latest work to potential clients</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pro-modal-body">
                {{ form_start(projectForm, {'attr': {'class': 'pro-form-row', 'id': 'addProjectForm'}}) }}
                    <div class="row g-4">
                        <div class="col-12">
                            <div class="pro-form-group">
                                <label class="pro-form-label">Project Name <span class="pro-text-danger">*</span></label>
                                {{ form_widget(projectForm.name, {'attr': {'class': 'pro-form-input', 'placeholder': 'e.g. Modern Kitchen Renovation'}}) }}
                                {{ form_errors(projectForm.name) }}
                            </div>
                        </div>
                         <div class="col-12">
                             <div class="pro-form-group">
                                 <label class="pro-form-label">Description <span class="pro-text-danger">*</span></label>
                                 {{ form_widget(projectForm.description, {'attr': {'class': 'pro-form-textarea', 'rows': 4, 'placeholder': 'Describe the scope, challenges, and results of this project...'}}) }}
                                 {{ form_errors(projectForm.description) }}
                             </div>
                         </div>
                        <div class="col-md-6">
                             <div class="pro-form-group">
                                <label class="pro-form-label">Start Date</label>
                                {{ form_widget(projectForm.startDate, {'attr': {'class': 'pro-form-input'}}) }}
                                {{ form_errors(projectForm.startDate) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                             <div class="pro-form-group">
                                <label class="pro-form-label">End Date <span class="pro-text-muted">(Optional)</span></label>
                                {{ form_widget(projectForm.EndDate, {'attr': {'class': 'pro-form-input'}}) }}
                                {{ form_errors(projectForm.EndDate) }}
                                <p class="pro-form-help">Leave empty if project is ongoing</p>
                            </div>
                        </div>
                        
                        <!-- Drag & Drop Photo -->
                        <div class="col-12">
                            <div class="pro-form-group">
                                <label class="pro-form-label">Main Project Photo <span class="pro-text-danger">*</span></label>
                                <div class="pro-upload-zone" id="mainPhotoZone">
                                    <i class="feather-image pro-upload-icon"></i>
                                    <p class="pro-upload-text">Drag & drop or Click to upload</p>
                                    <p class="pro-upload-hint">PNG, JPG, or WEBP (Max 5MB)</p>
                                    {{ form_widget(projectForm.mainPhoto, {'attr': {'class': 'd-none', 'accept': 'image/*'}}) }}
                                </div>
                                <div id="mainPhotoPreview" class="pro-preview-grid" style="display: none;"></div>
                                {{ form_errors(projectForm.mainPhoto) }}
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="pro-form-group">
                                <label class="pro-form-label">Project Gallery <span class="pro-text-muted">(Optional multiple images)</span></label>
                                <div class="pro-upload-zone" id="galleryZone">
                                    <i class="feather-grid pro-upload-icon"></i>
                                    <p class="pro-upload-text">Upload multiple gallery photos</p>
                                    <p class="pro-upload-hint">Highlight different angles or details</p>
                                    {{ form_widget(projectForm.gallery, {'attr': {'class': 'd-none', 'accept': 'image/*', 'multiple': 'multiple'}}) }}
                                </div>
                                <div id="galleryPreview" class="pro-preview-grid"></div>
                                {{ form_errors(projectForm.gallery) }}
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="d-flex align-items-center gap-3 p-3 rounded" style="background: var(--pro-slate-50); border: 1px solid var(--pro-slate-200);">
                                <div class="form-check form-switch mb-0">
                                    {{ form_widget(projectForm.state, {'attr': {'class': 'form-check-input', 'style': 'width: 40px; height: 20px;'}}) }}
                                </div>
                                <div>
                                    <label class="pro-form-label mb-0" for="{{ projectForm.state.vars.id }}">Publish Immediately</label>
                                    <p class="pro-text-muted mb-0" style="font-size: 1.1rem;">Making this public will show it on your profile</p>
                                </div>
                            </div>
                        </div>
                    </div>
                {{ form_end(projectForm) }}
            </div>
            <div class="modal-footer pro-modal-footer">
                <button type="button" class="pro-btn pro-btn-outline" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="addProjectForm" class="pro-btn pro-btn-primary">
                    <i class="feather-save"></i> Create Project
                </button>
            </div>
        </div>
    </div>
</div>

{% endblock %}

<!-- Edit and Delete Modals for Each Project -->
{% for project in projects %}
    <!-- Edit Modal -->
    <div class="modal fade" id="editProjectModal{{ project.id }}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content pro-modal-content">
                <div class="modal-header pro-modal-header">
                    <div>
                        <h5 class="modal-title fw-bold" style="font-size: 2rem;">Edit Project</h5>
                        <p class="pro-text-muted mb-0" style="font-size: 1.3rem;">Modify your project details and images</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pro-modal-body">
                    {% set editForm = editForms[project.id] %}
                    {{ form_start(editForm, {'attr': {'class': 'pro-form-row', 'id': 'editProjectForm' ~ project.id}}) }}
                        <div class="row g-4">
                            <div class="col-12">
                                <div class="pro-form-group">
                                    <label class="pro-form-label">Project Name <span class="pro-text-danger">*</span></label>
                                    {{ form_widget(editForm.name, {'attr': {'class': 'pro-form-input'}}) }}
                                    {{ form_errors(editForm.name) }}
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="pro-form-group">
                                    <label class="pro-form-label">Description <span class="pro-text-danger">*</span></label>
                                    {{ form_widget(editForm.description, {'attr': {'class': 'pro-form-textarea', 'rows': 4}}) }}
                                    {{ form_errors(editForm.description) }}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="pro-form-group">
                                    <label class="pro-form-label">Start Date</label>
                                    {{ form_widget(editForm.startDate, {'attr': {'class': 'pro-form-input'}}) }}
                                    {{ form_errors(editForm.startDate) }}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="pro-form-group">
                                    <label class="pro-form-label">End Date</label>
                                    {{ form_widget(editForm.EndDate, {'attr': {'class': 'pro-form-input'}}) }}
                                    {{ form_errors(editForm.EndDate) }}
                                </div>
                            </div>

                            <!-- Main Photo Edit -->
                            <div class="col-12">
                                <div class="pro-form-group">
                                    <label class="pro-form-label">Main Project Photo</label>
                                    <div class="pro-upload-zone mb-3" id="mainPhotoZone{{ project.id }}">
                                        <i class="feather-image pro-upload-icon"></i>
                                        <p class="pro-upload-text">Replace current photo</p>
                                        {{ form_widget(editForm.mainPhoto, {'attr': {'class': 'd-none', 'accept': 'image/*'}}) }}
                                    </div>
                                    <div id="mainPhotoPreview{{ project.id }}" class="pro-preview-grid">
                                        {% if project.mainPhoto %}
                                            <div class="pro-preview-item">
                                                <img src="{{ asset('uploads/projects/' ~ project.mainPhoto) }}" alt="Current">
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="d-flex align-items-center gap-3 p-3 rounded" style="background: var(--pro-slate-50); border: 1px solid var(--pro-slate-200);">
                                    <div class="form-check form-switch mb-0">
                                        {{ form_widget(editForm.state, {'attr': {'class': 'form-check-input', 'style': 'width: 40px; height: 20px;'}}) }}
                                    </div>
                                    <div>
                                        <label class="pro-form-label mb-0" for="{{ editForm.state.vars.id }}">Published</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {# We skip gallery in simple edit for now to avoid complexity, but usually ProjetType handles it #}
                        {{ form_row(editForm.gallery, {'attr': {'class': 'd-none'}}) }}
                    {{ form_end(editForm) }}
                </div>
                <div class="modal-footer pro-modal-footer">
                    <button type="button" class="pro-btn pro-btn-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" form="editProjectForm{{ project.id }}" class="pro-btn pro-btn-primary">
                        <i class="feather-save"></i> Save Changes
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteProjectModal{{ project.id }}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content pro-modal-content text-center">
                <div class="modal-body pro-modal-body pt-5">
                    <div class="mb-4">
                        <div class="pro-stat-icon danger mx-auto" style="width: 70px; height: 70px; font-size: 32px;">
                            <i class="feather-alert-triangle"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2" style="font-size: 2rem;">Delete Project?</h4>
                    <p class="pro-text-muted px-4 mb-4" style="font-size: 1.4rem;">
                        Are you sure you want to permanently delete <strong>"{{ project.name }}"</strong>? This action cannot be undone.
                    </p>
                    <div class="d-flex flex-column gap-3 mt-2">
                        <form method="post" action="{{ path('professional_project_delete', {id: project.id}) }}" class="w-100">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                            <button type="submit" class="pro-btn pro-btn-danger w-100 py-3">
                                <i class="feather-trash-2"></i> Yes, Delete Permanently
                            </button>
                        </form>
                        <button type="button" class="pro-btn pro-btn-outline w-100 py-3" data-bs-dismiss="modal">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endfor %}

<script>
document.addEventListener('DOMContentLoaded', function() {
    function setupDragAndDrop(zoneId, inputId, previewId, multiple = false) {
        const zone = document.getElementById(zoneId);
        const input = document.getElementById(inputId);
        const preview = document.getElementById(previewId);

        if (!zone || !input || !preview) return;

        zone.addEventListener('click', () => input.click());

        zone.addEventListener('dragover', (e) => {
            e.preventDefault();
            zone.classList.add('dragover');
        });

        ['dragleave', 'dragend'].forEach(type => {
            zone.addEventListener(type, () => zone.classList.remove('dragover'));
        });

        zone.addEventListener('drop', (e) => {
            e.preventDefault();
            zone.classList.remove('dragover');
            if (e.dataTransfer.files.length) {
                input.files = e.dataTransfer.files;
                updatePreviews(e.dataTransfer.files, preview, multiple);
            }
        });

        input.addEventListener('change', () => {
            updatePreviews(input.files, preview, multiple);
        });
    }

    function updatePreviews(files, previewContainer, multiple) {
        if (!multiple) previewContainer.innerHTML = '';
        previewContainer.style.display = 'grid';

        Array.from(files).forEach(file => {
            if (file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const item = document.createElement('div');
                    item.className = 'pro-preview-item';
                    item.innerHTML = `<img src="${e.target.result}" alt="Preview">`;
                    previewContainer.appendChild(item);
                };
                reader.readAsDataURL(file);
            }
        });
    }

    // Initialize Add Project
    setupDragAndDrop('mainPhotoZone', '{{ projectForm.mainPhoto.vars.id }}', 'mainPhotoPreview', false);
    setupDragAndDrop('galleryZone', '{{ projectForm.gallery.vars.id }}', 'galleryPreview', true);

    // Initialize Edit Projects
    {% for project in projects %}
        {% set ef = editForms[project.id] %}
        setupDragAndDrop('mainPhotoZone{{ project.id }}', '{{ ef.mainPhoto.vars.id }}', 'mainPhotoPreview{{ project.id }}', false);
    {% endfor %}

    // Reopen Add Modal if errors
    {% if not projectForm.vars.valid %}
        const newProjModal = new bootstrap.Modal(document.getElementById('newProjectModal'));
        newProjModal.show();
    {% endif %}
});
</script>
{% endblock %}
