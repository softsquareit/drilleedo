{% extends 'professional/base_professional.html.twig' %}

{% block title %}{{ 'menu.my_profile'|trans }} – {{ app.user.displayName }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ── Profile Page — Drilleedo Brand ──────────────────────── */
.prf-header {
    background: var(--drl-W);
    border: 1.5px solid var(--drl-L);
    border-radius: var(--drl-rx);
    overflow: hidden;
    box-shadow: var(--drl-sh);
    margin-bottom: 24px;
}
.prf-header-body {
    padding: 24px 28px;
    display: flex;
    align-items: flex-start;
    gap: 24px;
}
.prf-avatar-wrap { flex-shrink: 0; position: relative; }
.prf-avatar {
    width: 100px; height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--drl-W);
    box-shadow: var(--drl-sh);
    display: block;
}
.prf-avatar-edit {
    position: absolute; bottom: 2px; right: 2px;
    width: 30px; height: 30px;
    background: var(--drl-B);
    border: 2px solid var(--drl-W);
    border-radius: 50%;
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; font-size: 12px;
    transition: background var(--drl-t);
}
.prf-avatar-edit:hover { background: var(--drl-S); }
.prf-info { flex: 1; min-width: 0; }
.prf-name { font-size: 22px; font-weight: 900; color: var(--drl-D); margin: 0 0 6px; line-height: 1.2; }
.prf-email { font-size: 14px; color: var(--drl-M); margin: 0 0 12px; }
.prf-badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
.prf-badge {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 12px; border-radius: 50px;
    font-size: 11px; font-weight: 800;
    text-transform: uppercase; letter-spacing: .04em;
}
.prf-badge--blue   { background: rgba(63,169,245,.12);  color: var(--drl-B); }
.prf-badge--gold   { background: var(--drl-C);           color: #b45309; }
.prf-badge--green  { background: rgba(22,163,74,.1);     color: #16a34a; }
.prf-badge--avail  { background: rgba(22,163,74,.1);     color: #16a34a; }
.prf-badge--busy   { background: rgba(255,138,61,.12);   color: #b45309; }
.prf-badge--unavail{ background: rgba(239,68,68,.1);     color: #dc2626; }
.prf-badge--navy   { background: rgba(0,73,127,.08);     color: var(--drl-B); }
.prf-stats-row { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 4px; }
.prf-stat-item { display: flex; flex-direction: column; align-items: flex-start; }
.prf-stat-val { font-size: 20px; font-weight: 900; color: var(--drl-D); line-height: 1; }
.prf-stat-lbl { font-size: 11px; color: var(--drl-M); font-weight: 700; text-transform: uppercase; margin-top: 3px; opacity: .7; }
.prf-edit-btn { flex-shrink: 0; align-self: flex-start; }

/* Completion bar */
.prf-completion {
    padding: 14px 28px;
    background: var(--drl-L);
    border-top: 3px solid var(--drl-O);
    display: flex; align-items: center; gap: 16px;
}
.prf-completion-label { font-size: 13px; font-weight: 700; color: var(--drl-M); white-space: nowrap; }
.prf-completion-bar { flex: 1; height: 8px; background: rgba(255,255,255,.6); border-radius: 99px; overflow: hidden; }
.prf-completion-fill {
    height: 100%; border-radius: 99px;
    background: linear-gradient(90deg, var(--drl-O), #ffb347);
    transition: width .6s cubic-bezier(.4,0,.2,1);
}
.prf-completion-pct { font-size: 13px; font-weight: 800; color: var(--drl-D); white-space: nowrap; }

/* Profile tabs */
.prf-tabs {
    border-bottom: 2px solid var(--drl-L);
    display: flex; gap: 4px;
    padding: 0 4px;
    margin-bottom: 24px;
}
.prf-tab-btn {
    padding: 12px 18px;
    font-size: 14px; font-weight: 700;
    color: var(--drl-M);
    background: none; border: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    cursor: pointer;
    display: flex; align-items: center; gap: 7px;
    transition: color var(--drl-t);
}
.prf-tab-btn:hover { color: var(--drl-B); }
.prf-tab-btn.active { color: var(--drl-B); border-bottom-color: var(--drl-B); }
.prf-tab-btn i { font-size: 16px; }
.prf-tab-pane { display: none; }
.prf-tab-pane.active { display: block; }

/* Info rows */
.prf-section-title {
    font-size: 11px; font-weight: 800; color: var(--drl-M);
    text-transform: uppercase; letter-spacing: .05em;
    margin: 0 0 16px; opacity: .7;
}
.prf-field {
    display: flex; align-items: flex-start; gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--drl-L);
}
.prf-field:last-child { border-bottom: none; }
.prf-field-icon {
    width: 40px; height: 40px;
    border-radius: var(--drl-r);
    display: flex; align-items: center; justify-content: center;
    font-size: 17px; flex-shrink: 0;
}
.prf-field-icon--blue  { background: rgba(63,169,245,.1);  color: var(--drl-B); }
.prf-field-icon--orng  { background: rgba(255,138,61,.1);  color: var(--drl-O); }
.prf-field-icon--green { background: rgba(22,163,74,.1);   color: #16a34a; }
.prf-field-icon--navy  { background: rgba(0,73,127,.08);   color: var(--drl-B); }
.prf-field-icon--slate { background: var(--drl-L);         color: var(--drl-M); }
.prf-field-label {
    font-size: 11px; font-weight: 700; color: var(--drl-M);
    text-transform: uppercase; letter-spacing: .04em;
    margin-bottom: 3px; opacity: .8;
}
.prf-field-val { font-size: 14px; font-weight: 600; color: var(--drl-D); line-height: 1.55; margin: 0; }
.prf-field-empty { color: var(--drl-M); font-style: italic; opacity: .6; }

/* Tag pills */
.prf-tag-list { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
.prf-tag {
    background: var(--drl-L); color: var(--drl-M);
    border-radius: 50px; padding: 3px 10px;
    font-size: 12px; font-weight: 700;
}

/* Services list */
.prf-service-list { list-style: none; padding: 0; margin: 4px 0 0; display: flex; flex-direction: column; gap: 6px; }
.prf-service-list li { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: var(--drl-D); }
.prf-service-list li::before {
    content: ''; width: 6px; height: 6px;
    border-radius: 50%; background: var(--drl-S); flex-shrink: 0;
}

/* Trust badges */
.prf-trust-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; margin-top: 4px; }
.prf-trust-item {
    background: var(--drl-L); border: 1.5px solid var(--drl-L);
    border-radius: var(--drl-r); padding: 14px;
    display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center;
    transition: var(--drl-t);
}
.prf-trust-item.active { background: rgba(22,163,74,.06); border-color: rgba(22,163,74,.25); }
.prf-trust-icon {
    width: 40px; height: 40px; border-radius: var(--drl-r);
    display: flex; align-items: center; justify-content: center; font-size: 18px;
}
.prf-trust-item:not(.active) .prf-trust-icon { background: rgba(255,255,255,.7); color: var(--drl-M); }
.prf-trust-item.active .prf-trust-icon { background: rgba(22,163,74,.15); color: #16a34a; }
.prf-trust-label { font-size: 12px; font-weight: 700; color: var(--drl-M); }
.prf-trust-item.active .prf-trust-label { color: #15803d; }

/* Hours list */
.prf-hours-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; }
.prf-hours-list li {
    display: flex; justify-content: space-between;
    font-size: 13px; color: var(--drl-M); font-weight: 600;
    padding: 4px 0; border-bottom: 1px dotted var(--drl-L);
}

/* Edit modal */
.prf-modal-tabs {
    display: flex; gap: 8px; padding: 16px 24px;
    border-bottom: 1px solid var(--drl-L); margin-bottom: 0;
    background: var(--drl-W);
}
.prf-modal-tab-btn {
    padding: 9px 18px; font-size: 13px; font-weight: 800;
    border-radius: 50px; border: 1.5px solid transparent;
    background: transparent; color: var(--drl-M);
    cursor: pointer; transition: var(--drl-t);
    display: flex; align-items: center; gap: 8px;
    text-transform: uppercase; letter-spacing: .04em;
}
.prf-modal-tab-btn i { font-size: 16px; }
.prf-modal-tab-btn:hover { color: var(--drl-B); background: rgba(63,169,245,.08); border-color: var(--drl-L); }
.prf-modal-tab-btn.active {
    background: var(--drl-B); color: #fff;
    border-color: var(--drl-B);
    box-shadow: 0 4px 14px rgba(0,73,127,.25);
}
.drl-modal-header--premium {
    background: linear-gradient(135deg, #002d50 0%, var(--drl-B) 100%);
    color: #fff; padding: 32px 32px 24px; border-bottom: none;
}
.drl-modal-header--premium .modal-title { font-size: 24px; font-weight: 900; }
.drl-modal-header--premium p { color: rgba(255,255,255,.7); font-size: 14px; margin-top: 4px; }
.prf-modal-body--scrolled { padding: 32px; max-height: 65vh; }
.prf-modal-section-title {
    font-size: 12px; font-weight: 900; color: var(--drl-M);
    text-transform: uppercase; letter-spacing: .1em;
    margin-bottom: 20px; padding-bottom: 10px;
    border-bottom: 1px solid var(--drl-L); opacity: .7;
}

@media (max-width: 768px) {
    .prf-header-body { flex-wrap: wrap; }
    .prf-stats-row { gap: 14px; }
    .prf-edit-btn { width: 100%; }
    .prf-trust-grid { grid-template-columns: repeat(2, 1fr); }
}
.prf-modal-body--scrolled {
    max-height: 550px;
    overflow-y: auto;
    padding: 0;
}
.prf-modal-tabs.sticky-top {
    position: sticky; top: 0; z-index: 100;
    background: var(--drl-W);
    border-bottom: 1px solid var(--drl-L);
}
</style>
{% endblock %}

{% block body %}
{% set user = app.user %}
{% set stats = user.stats %}
{% set avgRating = stats and stats.averageRating ? stats.averageRating : 0 %}
{% set reviewCount = stats and stats.reviewCount ? stats.reviewCount : 0 %}

{# ── Profile Completion ── #}
{% set filled = 0 %}
{% if user.companyName %}{% set filled = filled + 1 %}{% endif %}
{% if user.logo %}{% set filled = filled + 1 %}{% endif %}
{% if user.banner %}{% set filled = filled + 1 %}{% endif %}
{% if user.about %}{% set filled = filled + 1 %}{% endif %}
{% if user.category %}{% set filled = filled + 1 %}{% endif %}
{% if user.city %}{% set filled = filled + 1 %}{% endif %}
{% if user.expYears %}{% set filled = filled + 1 %}{% endif %}
{% if user.whyChooseUs %}{% set filled = filled + 1 %}{% endif %}
{% if user.services %}{% set filled = filled + 1 %}{% endif %}
{% if user.phoneNum %}{% set filled = filled + 1 %}{% endif %}
{% set totalFields = 10 %}
{% set completionPct = ((filled / totalFields) * 100)|round %}

{# ══════════════════════════════════════════════════════════════
   PROFILE HEADER CARD
══════════════════════════════════════════════════════════════ #}
<div class="prf-header">
    <div class="prf-header-body">
        {# Avatar #}
        <div class="prf-avatar-wrap">
            {% if user.logo %}
                <img src="{{ asset('uploads/logos/' ~ user.logo) }}" alt="{{ user.displayName }}" class="prf-avatar pro-avatar-img">
            {% else %}
                <img src="{{ asset('assets/drilleedo/images/team/avatar.jpg') }}" alt="{{ user.displayName }}" class="prf-avatar pro-avatar-img">
            {% endif %}
            <button class="prf-avatar-edit" data-bs-toggle="modal" data-bs-target="#editLogoModal" title="{{ 'prf.btn_change_photo'|trans }}">
                <i class="ph-camera"></i>
            </button>
        </div>

        {# Info #}
        <div class="prf-info">
            <h1 class="prf-name">{{ user.displayName }}</h1>
            <p class="prf-email">{{ user.email }}</p>

            <div class="prf-badges">
                {# Availability #}
                {% if user.availabilityStatus == 'AVAILABLE' %}
                    <span class="prf-badge prf-badge--avail"><i class="ph-check-circle"></i> {{ 'prf.avail_available'|trans }}</span>
                {% elseif user.availabilityStatus == 'BUSY' %}
                    <span class="prf-badge prf-badge--busy"><i class="ph-clock"></i> {{ 'prf.avail_busy'|trans }}</span>
                {% else %}
                    <span class="prf-badge prf-badge--unavail"><i class="ph-x-circle"></i> {{ 'prf.avail_unavailable'|trans }}</span>
                {% endif %}

                {# Verified #}
                {% if user.isVerified %}
                    <span class="prf-badge prf-badge--blue"><i class="ph-shield-check"></i> {{ 'prf.badge_verified'|trans }}</span>
                {% endif %}

                {# Top Rated #}
                {% if user.isTopRated %}
                    <span class="prf-badge prf-badge--gold"><i class="ph-star"></i> {{ 'prf.badge_top_rated'|trans }}</span>
                {% endif %}

                {# RBQ #}
                {% if user.isRbqCertified %}
                    <span class="prf-badge prf-badge--navy"><i class="ph-medal"></i> {{ 'prf.badge_rbq'|trans }}</span>
                {% endif %}

                {# Insurance #}
                {% if user.hasInsurance %}
                    <span class="prf-badge prf-badge--green"><i class="ph-umbrella"></i> {{ 'prf.badge_insured'|trans }}</span>
                {% endif %}

                {# Category #}
                {% if user.category %}
                    <span class="prf-badge prf-badge--navy"><i class="ph-tag"></i> {{ user.category.localizedTitle(app.request.locale) }}</span>
                {% endif %}
            </div>

            <div class="prf-stats-row">
                {% if avgRating > 0 %}
                <div class="prf-stat-item">
                    <div class="prf-stat-val" style="color: #f59e0b;">
                        <i class="ph-star" style="fill: #f59e0b; font-size: 16px; vertical-align: middle;"></i>
                        {{ avgRating|number_format(1) }}
                    </div>
                    <div class="prf-stat-lbl">{{ 'prf.lbl_rating'|trans }}</div>
                </div>
                {% endif %}
                {% if reviewCount > 0 %}
                <div class="prf-stat-item">
                    <div class="prf-stat-val">{{ reviewCount }}</div>
                    <div class="prf-stat-lbl">{{ 'prf.lbl_reviews'|trans }}</div>
                </div>
                {% endif %}
                {% if user.expYears %}
                <div class="prf-stat-item">
                    <div class="prf-stat-val">{{ user.expYears }} {{ 'prf.lbl_years'|trans }}</div>
                    <div class="prf-stat-lbl">{{ 'prf.lbl_experience'|trans }}</div>
                </div>
                {% endif %}
                {% if user.city %}
                <div class="prf-stat-item">
                    <div class="prf-stat-val" style="font-size: 15px;">{{ user.city }}</div>
                    <div class="prf-stat-lbl">{{ 'prf.lbl_city'|trans }}</div>
                </div>
                {% endif %}
                {% if user.minPrice %}
                <div class="prf-stat-item">
                    <div class="prf-stat-val">{{ user.minPrice }} $</div>
                    <div class="prf-stat-lbl">{{ 'prf.lbl_min_price'|trans }}</div>
                </div>
                {% endif %}
            </div>
        </div>

        {# Edit button #}
        <div class="prf-edit-btn">
            <button type="button" class="drl-btn-orange" style="padding: 10px 20px; font-size: 13px;" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                <i class="ph-pencil me-1"></i> {{ 'prf.btn_edit_profile'|trans }}
            </button>
        </div>
    </div>

    {# Completion bar #}
    <div class="prf-completion">
        <span class="prf-completion-label">{{ 'prf.completion_label'|trans }}</span>
        <div class="prf-completion-bar">
            <div class="prf-completion-fill" style="width: {{ completionPct }}%;"></div>
        </div>
        <span class="prf-completion-pct">{{ completionPct }}%</span>
        {% if completionPct < 100 %}
            <a href="#" onclick="document.querySelector('[data-bs-target=\'#editProfileModal\']').click(); return false;" class="drl-tag drl-tag--info ms-2" style="font-size: 11px; text-decoration: none;">{{ 'prf.btn_complete'|trans }}</a>
        {% endif %}
    </div>
</div>

{# ══════════════════════════════════════════════════════════════
   TABBED CONTENT
══════════════════════════════════════════════════════════════ #}
<div class="drl-card p-4">

    {# Tabs nav #}
    <div class="prf-tabs" role="tablist">
        <button class="prf-tab-btn active" data-tab="presentation" type="button">
            <i class="ph-user-circle"></i> {{ 'prf.tab_presentation'|trans }}
        </button>
        <button class="prf-tab-btn" data-tab="services" type="button">
            <i class="ph-briefcase"></i> {{ 'prf.tab_activity'|trans }}
        </button>
        <button class="prf-tab-btn" data-tab="trust" type="button">
            <i class="ph-shield-check"></i> {{ 'prf.tab_trust'|trans }}
        </button>
    </div>

    {# ── Tab 1: Présentation ── #}
    <div class="prf-tab-pane active" id="pane-presentation">
        <div class="row g-4">
            <div class="col-lg-8">

                {# About #}
                <p class="prf-section-title">{{ 'prf.section_about'|trans }}</p>
                <div class="prf-field" style="border-bottom: none; padding-top: 0;">
                    <div class="prf-field-icon prf-field-icon--blue">
                        <i class="ph-file-text"></i>
                    </div>
                    <div class="flex-grow-1">
                        {% if user.about %}
                            <p class="prf-field-val" style="white-space: pre-line;">{{ user.about }}</p>
                        {% else %}
                            <p class="prf-field-val prf-field-empty">{{ 'prf.not_filled'|trans }}</p>
                        {% endif %}
                    </div>
                </div>

                <p class="prf-section-title mt-4">{{ 'prf.section_contact'|trans }}</p>

                <div class="prf-field">
                    <div class="prf-field-icon prf-field-icon--slate">
                        <i class="ph-envelope"></i>
                    </div>
                    <div>
                        <p class="prf-field-label">Email</p>
                        <p class="prf-field-val">{{ user.email }}</p>
                    </div>
                </div>

                <div class="prf-field">
                    <div class="prf-field-icon prf-field-icon--orng">
                        <i class="ph-map-pin"></i>
                    </div>
                    <div>
                        <p class="prf-field-label">{{ 'prf.lbl_city'|trans }}</p>
                        <p class="prf-field-val {% if not user.city %}prf-field-empty{% endif %}">{{ user.city ?: 'prf.not_filled_f'|trans }}</p>
                    </div>
                </div>

                {% if user.phoneNum %}
                <div class="prf-field">
                    <div class="prf-field-icon prf-field-icon--navy">
                        <i class="ph-phone"></i>
                    </div>
                    <div>
                        <p class="prf-field-label">{{ 'prf.lbl_phone'|trans }}</p>
                        <p class="prf-field-val">{{ user.phoneNum }}</p>
                    </div>
                </div>
                {% endif %}

                <div class="prf-field">
                    <div class="prf-field-icon prf-field-icon--blue">
                        <i class="ph-navigation-arrow"></i>
                    </div>
                    <div>
                        <p class="prf-field-label">{{ 'prf.lbl_zone'|trans }}</p>
                        <p class="prf-field-val {% if not user.interventionZone %}prf-field-empty{% endif %}">
                            {% if user.interventionZone %}
                                {{ user.interventionZone }}{% if user.interventionRadius %} ({{ user.interventionRadius }} km){% endif %}
                            {% elseif user.interventionRadius %}
                                {{ 'prf.radius_km'|trans({'%radius%': user.interventionRadius}) }}
                            {% else %}
                                {{ 'prf.not_filled_f'|trans }}
                            {% endif %}
                        </p>
                    </div>
                </div>

            </div>

            <div class="col-lg-4">

                {# Languages #}
                <p class="prf-section-title">{{ 'prf.lbl_languages'|trans }}</p>
                <div class="prf-field" style="padding-top: 0; border-bottom: none;">
                    <div class="prf-field-icon prf-field-icon--navy">
                        <i class="ph-globe"></i>
                    </div>
                    <div>
                        {% if user.languages and user.languages|length > 0 %}
                            <div class="prf-tag-list">
                                {% set langMap = {'FR': 'prf.lang_fr'|trans, 'EN': 'prf.lang_en'|trans, 'ES': 'prf.lang_es'|trans, 'IT': 'prf.lang_it'|trans} %}
                                {% for lang in user.languages %}
                                    <span class="prf-tag">{{ langMap[lang] ?? lang }}</span>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="prf-field-val prf-field-empty">{{ 'prf.not_filled_pl'|trans }}</p>
                        {% endif %}
                    </div>
                </div>

                {# Opening hours #}
                {% if user.openingHours and user.openingHours|length > 0 %}
                <p class="prf-section-title mt-4">{{ 'prf.lbl_hours'|trans }}</p>
                <ul class="prf-hours-list">
                    {% for line in user.openingHours %}
                        <li><span>{{ line }}</span></li>
                    {% endfor %}
                </ul>
                {% endif %}

            </div>
        </div>
    </div>

    {# ── Tab 2: Activité & Services ── #}
    <div class="prf-tab-pane" id="pane-services">
        <div class="row g-4">

            <div class="col-lg-6">
                <p class="prf-section-title">{{ 'prf.lbl_sector'|trans }}</p>
                <div class="prf-field" style="padding-top: 0; border-bottom: none;">
                    <div class="prf-field-icon prf-field-icon--blue">
                        <i class="ph-squares-four"></i>
                    </div>
                    <div>
                        {% if user.category %}
                            {% if user.category.parent %}
                                <p class="prf-field-label">{{ 'prf.lbl_sector_short'|trans }}</p>
                                <p class="prf-field-val">{{ user.category.parent.localizedTitle(app.request.locale) }}</p>
                                <p class="prf-field-label mt-2">{{ 'prf.lbl_specialized'|trans }}</p>
                            {% endif %}
                            <p class="prf-field-val">{{ user.category.localizedTitle(app.request.locale) }}</p>
                        {% else %}
                            <p class="prf-field-val prf-field-empty">{{ 'prf.not_filled'|trans }}</p>
                        {% endif %}
                    </div>
                </div>

                <p class="prf-section-title mt-4">{{ 'prf.section_services'|trans }}</p>
                {% if user.services and user.services|length > 0 %}
                    <ul class="prf-service-list">
                        {% for item in user.services %}
                            <li>{{ item }}</li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="prf-field-val prf-field-empty">{{ 'prf.no_services'|trans }}</p>
                {% endif %}
            </div>

            <div class="col-lg-6">
                <p class="prf-section-title">{{ 'prf.section_why'|trans }}</p>
                {% if user.whyChooseUs and user.whyChooseUs|length > 0 %}
                    <ul class="prf-service-list" style="list-style: none;">
                        {% for item in user.whyChooseUs %}
                            <li style="color: #16a34a;">
                                <i class="ph-check-circle" style="font-size: 14px; color: #16a34a; margin-right: 4px;"></i>
                                <span style="color: #0d2151;">{{ item }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="prf-field-val prf-field-empty">{{ 'prf.not_filled'|trans }}</p>
                {% endif %}

                <p class="prf-section-title mt-4">{{ 'prf.lbl_availability'|trans }}</p>
                <div class="prf-field" style="padding-top: 0; border-bottom: none;">
                    <div class="prf-field-icon {% if user.availabilityStatus == 'AVAILABLE' %}prf-field-icon--green{% elseif user.availabilityStatus == 'BUSY' %}prf-field-icon--orng{% else %}prf-field-icon--slate{% endif %}">
                        <i class="ph-clock"></i>
                    </div>
                    <div>
                        <p class="prf-field-label">{{ 'prf.lbl_current_status'|trans }}</p>
                        <p class="prf-field-val">
                            {% if user.availabilityStatus == 'AVAILABLE' %}
                                <span style="color: #16a34a; font-weight: 800;">{{ 'prf.avail_available'|trans }}</span>
                            {% elseif user.availabilityStatus == 'BUSY' %}
                                <span style="color: #d97706; font-weight: 800;">{{ 'prf.avail_busy'|trans }}</span>
                            {% else %}
                                <span style="color: #dc2626; font-weight: 800;">{{ 'prf.avail_unavailable_lbl'|trans }}</span>
                            {% endif %}
                        </p>
                        <form method="post" action="{{ path('professional_update_availability') }}" class="mt-2 d-flex gap-2 flex-wrap">
                            <input type="hidden" name="_token" value="{{ csrf_token('update-availability') }}">
                            <button type="submit" name="status" value="AVAILABLE" class="drl-btn btn-sm {% if user.availabilityStatus == 'AVAILABLE' %}drl-btn-green{% else %}drl-btn-outline{% endif %}" style="padding: 4px 12px; font-size: 12px;">{{ 'prf.avail_available'|trans }}</button>
                            <button type="submit" name="status" value="BUSY" class="drl-btn btn-sm {% if user.availabilityStatus == 'BUSY' %}drl-btn-orange{% else %}drl-btn-outline{% endif %}" style="padding: 4px 12px; font-size: 12px;">{{ 'prf.avail_busy'|trans }}</button>
                            <button type="submit" name="status" value="UNAVAILABLE" class="drl-btn btn-sm {% if user.availabilityStatus == 'UNAVAILABLE' %}drl-btn-danger{% else %}drl-btn-outline{% endif %}" style="padding: 4px 12px; font-size: 12px;">{{ 'prf.avail_unavailable_lbl'|trans }}</button>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>

    {# ── Tab 3: Confiance & Certifications ── #}
    <div class="prf-tab-pane" id="pane-trust">
        <p class="prf-section-title">{{ 'prf.trust_badges_title'|trans }}</p>
        <div class="prf-trust-grid">
            <div class="prf-trust-item {{ user.isVerified ? 'active' }}">
                <div class="prf-trust-icon"><i class="ph-shield-check"></i></div>
                <span class="prf-trust-label">{{ 'prf.trust_verified'|trans }}</span>
            </div>
            <div class="prf-trust-item {{ user.isTopRated ? 'active' }}">
                <div class="prf-trust-icon"><i class="ph-star"></i></div>
                <span class="prf-trust-label">{{ 'prf.trust_top_rated'|trans }}</span>
            </div>
            <div class="prf-trust-item {{ user.isRbqCertified ? 'active' }}">
                <div class="prf-trust-icon"><i class="ph-medal"></i></div>
                <span class="prf-trust-label">{{ 'prf.trust_rbq'|trans }}</span>
            </div>
            <div class="prf-trust-item {{ user.hasInsurance ? 'active' }}">
                <div class="prf-trust-icon"><i class="ph-umbrella"></i></div>
                <span class="prf-trust-label">{{ 'prf.trust_insured'|trans }}</span>
            </div>
            <div class="prf-trust-item {{ user.hasFreeQuotes ? 'active' }}">
                <div class="prf-trust-icon"><i class="ph-gift"></i></div>
                <span class="prf-trust-label">{{ 'prf.trust_free_quotes'|trans }}</span>
            </div>
            <div class="prf-trust-item {{ user.hasGuaranteedWork ? 'active' }}">
                <div class="prf-trust-icon"><i class="ph-check-square"></i></div>
                <span class="prf-trust-label">{{ 'prf.trust_guaranteed'|trans }}</span>
            </div>
        </div>

        <p class="prf-section-title mt-4">{{ 'prf.pricing_title'|trans }}</p>
        <div class="row g-3 mt-0">
            <div class="col-sm-6 col-lg-3">
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; text-align: center;">
                    <div style="font-size: 22px; font-weight: 900; color: #0d2151;">{{ user.minPrice ? user.minPrice ~ ' $' : '—' }}</div>
                    <div style="font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase;">{{ 'prf.lbl_min_price_stat'|trans }}</div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; text-align: center;">
                    <div style="font-size: 22px; font-weight: 900; color: #0d2151;">{{ user.interventionRadius ? user.interventionRadius ~ ' km' : '—' }}</div>
                    <div style="font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase;">{{ 'prf.lbl_radius_stat'|trans }}</div>
                </div>
            </div>
        </div>

        {% if user.licenceNum or user.companyNum %}
        <p class="prf-section-title mt-4">{{ 'prf.legal_title'|trans }}</p>
        <div class="row g-3 mt-0">
            {% if user.licenceNum %}
            <div class="col-sm-6">
                <div class="prf-field" style="border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px; gap: 12px;">
                    <div class="prf-field-icon prf-field-icon--navy"><i class="ph-hash"></i></div>
                    <div>
                        <p class="prf-field-label">{{ 'prf.lbl_licence_short'|trans }}</p>
                        <p class="prf-field-val">{{ user.licenceNum }}</p>
                    </div>
                </div>
            </div>
            {% endif %}
            {% if user.companyNum %}
            <div class="col-sm-6">
                <div class="prf-field" style="border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px; gap: 12px;">
                    <div class="prf-field-icon prf-field-icon--navy"><i class="ph-briefcase"></i></div>
                    <div>
                        <p class="prf-field-label">{{ 'prf.lbl_company_short'|trans }}</p>
                        <p class="prf-field-val">{{ user.companyNum }}</p>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
        {% endif %}

    </div>

</div>

<script>
// Tab switching
document.querySelectorAll('.prf-tab-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        const tab = this.dataset.tab;
        document.querySelectorAll('.prf-tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.prf-tab-pane').forEach(p => p.classList.remove('active'));
        this.classList.add('active');
        document.getElementById('pane-' + tab).classList.add('active');
    });
});

// Reopen modal on validation error
{% if not form.vars.valid %}
    window.addEventListener('load', function() {
        var modal = new bootstrap.Modal(document.getElementById('editProfileModal'));
        modal.show();
    });
{% endif %}
</script>
{% endblock %}

{% block modals %}
    {{ parent() }}

    {# ══════════════════════════════════════════════════════════════
       EDIT PROFILE MODAL — tabbed, fully sectioned
    ══════════════════════════════════════════════════════════════ #}
    <div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content drl-modal-content">
                <div class="modal-header drl-modal-header--premium">
                    <div class="w-100">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="modal-title mb-0">
                                <i class="ph-user-focus me-2"></i>{{ 'prf.btn_edit_profile'|trans }}
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <p class="mb-0">{{ 'prf.modal_subtitle'|trans }}</p>
                    </div>
                </div>

                {{ form_start(form, {'attr': {'id': 'profileUpdateForm', 'novalidate': 'novalidate'}}) }}
                <div class="p-0">
                    {# Modal Tabs #}
                    <div class="prf-modal-tabs sticky-top">
                        <button type="button" class="prf-modal-tab-btn active" data-modal-tab="tab-identity">
                            <i class="ph-identification-card"></i> {{ 'prf.modal_tab_identity'|trans }}
                        </button>
                        <button type="button" class="prf-modal-tab-btn" data-modal-tab="tab-activity">
                            <i class="ph-briefcase"></i> {{ 'prf.modal_tab_activity'|trans }}
                        </button>
                        <button type="button" class="prf-modal-tab-btn" data-modal-tab="tab-presence">
                            <i class="ph-info"></i> {{ 'prf.modal_tab_presence'|trans }}
                        </button>
                        <button type="button" class="prf-modal-tab-btn" data-modal-tab="tab-trust">
                            <i class="ph-shield-check"></i> {{ 'prf.modal_tab_certs'|trans }}
                        </button>
                    </div>

                    <div class="prf-modal-body--scrolled">

                        {# ── Tab: Identité ── #}
                        <div class="prf-modal-tab-pane" id="tab-identity">
                            <h6 class="prf-modal-section-title">{{ 'prf.section_basic'|trans }}</h6>
                            <div class="row g-4 mt-0">
                                <div class="col-lg-12">
                                    <label class="drl-label">{{ 'prf.lbl_company_name'|trans }}</label>
                                    {{ form_widget(form.company_name, {'attr': {'class': 'drl-input', 'placeholder': 'Ex: Construction Tremblay Inc.'}}) }}
                                    {{ form_errors(form.company_name) }}
                                </div>
                                <div class="col-lg-6">
                                    <label class="drl-label">{{ 'prf.lbl_pro_email'|trans }}</label>
                                    {{ form_widget(form.email, {'attr': {'class': 'drl-input', 'placeholder': 'contact@monentreprise.ca'}}) }}
                                    {{ form_errors(form.email) }}
                                </div>
                                <div class="col-lg-6">
                                    <label class="drl-label">{{ 'prf.lbl_phone'|trans }}</label>
                                    {{ form_widget(form.phoneNum, {'attr': {'class': 'drl-input', 'placeholder': 'Ex: 514-123-4567'}}) }}
                                    {{ form_errors(form.phoneNum) }}
                                </div>
                                <div class="col-lg-6">
                                    <label class="drl-label">{{ 'prf.lbl_city'|trans }}</label>
                                    {{ form_widget(form.city, {'attr': {'class': 'drl-input', 'placeholder': 'Ex: Montréal'}}) }}
                                    {{ form_errors(form.city) }}
                                </div>
                                <div class="col-lg-6">
                                    <label class="drl-label">{{ 'prf.lbl_exp_years'|trans }}</label>
                                    {{ form_widget(form.exp_years, {'attr': {'class': 'drl-input', 'placeholder': 'Ex: 10'}}) }}
                                    {{ form_errors(form.exp_years) }}
                                </div>
                                <div class="col-12">
                                    <label class="drl-label">{{ 'prf.lbl_about_me'|trans }}</label>
                                    {{ form_widget(form.about, {'attr': {'class': 'drl-input', 'rows': '6', 'placeholder': 'prf.ph_about'|trans}}) }}
                                    {{ form_errors(form.about) }}
                                </div>
                            </div>
                        </div>

                        {# ── Tab: Activité ── #}
                        <div class="prf-modal-tab-pane d-none" id="tab-activity">
                            <h6 class="prf-modal-section-title">{{ 'prf.section_expertise'|trans }}</h6>
                            <div class="row g-4 mt-0">
                                <div class="col-lg-6">
                                    <label class="drl-label" for="{{ form.parentCategory.vars.id }}">{{ 'prf.lbl_sector'|trans }}</label>
                                    {{ form_widget(form.parentCategory, {'attr': {'class': 'drl-input form-select parent-category-select selectpicker', 'data-live-search': 'true'}}) }}
                                    {{ form_errors(form.parentCategory) }}
                                </div>
                                <div class="col-lg-6">
                                    <label class="drl-label" for="{{ form.category.vars.id }}">{{ 'prf.lbl_specialized'|trans }}</label>
                                    {{ form_widget(form.category, {
                                        'attr': {
                                            'class': 'drl-input form-select child-category-select selectpicker',
                                            'data-selected-id': app.user.category ? app.user.category.id : '',
                                            'data-live-search': 'true'
                                        }
                                    }) }}
                                    {{ form_errors(form.category) }}
                                </div>
                                <div class="col-12">
                                    <label class="drl-label">{{ 'prf.section_why'|trans }} <span class="text-muted fw-normal" style="font-size: 12px; text-transform: none; letter-spacing: 0;">({{ 'prf.hint_one_per_line'|trans }})</span></label>
                                    {{ form_widget(form.whyChooseUs, {'attr': {'class': 'drl-input', 'rows': '5', 'placeholder': 'prf.ph_why_choose'|trans}}) }}
                                    {{ form_errors(form.whyChooseUs) }}
                                </div>
                                <div class="col-12">
                                    <label class="drl-label">{{ 'prf.lbl_my_services'|trans }} <span class="text-muted fw-normal" style="font-size: 12px; text-transform: none; letter-spacing: 0;">({{ 'prf.hint_one_per_line'|trans }})</span></label>
                                    {{ form_widget(form.services, {'attr': {'class': 'drl-input', 'rows': '5', 'placeholder': 'prf.ph_services'|trans}}) }}
                                    {{ form_errors(form.services) }}
                                </div>

                                <h6 class="prf-modal-section-title mt-4">{{ 'prf.section_conditions'|trans }}</h6>
                                <div class="col-lg-6">
                                    <label class="drl-label">{{ 'prf.lbl_zone'|trans }}</label>
                                    {{ form_widget(form.interventionZone, {'attr': {'class': 'drl-input', 'placeholder': 'prf.ph_zone'|trans}}) }}
                                    {{ form_errors(form.interventionZone) }}
                                </div>
                                <div class="col-lg-6">
                                    <label class="drl-label">{{ 'prf.lbl_radius'|trans }}</label>
                                    {{ form_widget(form.interventionRadius, {'attr': {'class': 'drl-input', 'placeholder': '40'}}) }}
                                    {{ form_errors(form.interventionRadius) }}
                                </div>
                                <div class="col-lg-6">
                                    <label class="drl-label">{{ 'prf.lbl_availability'|trans }}</label>
                                    {{ form_widget(form.availabilityStatus, {'attr': {'class': 'drl-input form-select'}}) }}
                                    {{ form_errors(form.availabilityStatus) }}
                                </div>
                                <div class="col-lg-6">
                                    <label class="drl-label">{{ 'prf.lbl_min_price_form'|trans }}</label>
                                    {{ form_widget(form.minPrice, {'attr': {'class': 'drl-input', 'placeholder': 'Ex: 200'}}) }}
                                    {{ form_errors(form.minPrice) }}
                                </div>
                                <div class="col-12">
                                    <label class="drl-label">{{ 'prf.lbl_hours_form'|trans }}</label>
                                    {{ form_widget(form.openingHours, {'attr': {'class': 'drl-input', 'rows': '4', 'placeholder': 'prf.ph_hours'|trans}}) }}
                                    {{ form_errors(form.openingHours) }}
                                </div>
                            </div>
                        </div>

                        {# ── Tab: Présence ── #}
                        <div class="prf-modal-tab-pane d-none" id="tab-presence">
                            <h6 class="prf-modal-section-title">{{ 'prf.section_comm'|trans }}</h6>
                            <div class="row g-4 mt-0">
                                <div class="col-lg-6">
                                    <label class="drl-label">{{ 'prf.lbl_languages'|trans }}</label>
                                    <div class="drl-input p-3 h-auto" style="min-height: 120px;">
                                        {{ form_widget(form.languages) }}
                                    </div>
                                    {{ form_errors(form.languages) }}
                                </div>
                                <div class="col-lg-6">
                                    <label class="drl-label">{{ 'prf.lbl_contact_prefs'|trans }}</label>
                                    <div class="drl-input p-3 h-auto" style="min-height: 120px;">
                                        {{ form_widget(form.contactPrefs) }}
                                    </div>
                                    {{ form_errors(form.contactPrefs) }}
                                </div>
                            </div>
                        </div>

                        {# ── Tab: Certifications ── #}
                        <div class="prf-modal-tab-pane d-none" id="tab-trust">
                            <h6 class="prf-modal-section-title">{{ 'prf.section_trust_proof'|trans }}</h6>
                            <div class="row g-4 mt-0">
                                <div class="col-12">
                                    <div class="drl-input h-auto p-4">
                                        <div class="row g-4">
                                            <div class="col-md-6">
                                                <label class="d-flex align-items-center gap-3 cursor-pointer mb-0">
                                                    {{ form_widget(form.hasInsurance, {'attr': {'class': 'form-check-input mt-0'}}) }}
                                                    <div>
                                                        <span class="d-block fw-bold text-dark">{{ 'prf.lbl_insurance'|trans }}</span>
                                                        <span class="d-block small text-muted">{{ 'prf.lbl_insurance_sub'|trans }}</span>
                                                    </div>
                                                </label>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="d-flex align-items-center gap-3 cursor-pointer mb-0">
                                                    {{ form_widget(form.rbqCertified, {'attr': {'class': 'form-check-input mt-0'}}) }}
                                                    <div>
                                                        <span class="d-block fw-bold text-dark">{{ 'prf.badge_rbq'|trans }}</span>
                                                        <span class="d-block small text-muted">{{ 'prf.lbl_rbq_sub'|trans }}</span>
                                                    </div>
                                                </label>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="d-flex align-items-center gap-3 cursor-pointer mb-0">
                                                    {{ form_widget(form.freeQuotes, {'attr': {'class': 'form-check-input mt-0'}}) }}
                                                    <div>
                                                        <span class="d-block fw-bold text-dark">{{ 'prf.lbl_free_quotes'|trans }}</span>
                                                        <span class="d-block small text-muted">{{ 'prf.lbl_free_quotes_sub'|trans }}</span>
                                                    </div>
                                                </label>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="d-flex align-items-center gap-3 cursor-pointer mb-0">
                                                    {{ form_widget(form.guaranteedWork, {'attr': {'class': 'form-check-input mt-0'}}) }}
                                                    <div>
                                                        <span class="d-block fw-bold text-dark">{{ 'prf.lbl_guaranteed'|trans }}</span>
                                                        <span class="d-block small text-muted">{{ 'prf.lbl_guaranteed_sub'|trans }}</span>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <label class="drl-label">{{ 'prf.lbl_licence_num'|trans }}</label>
                                    {{ form_widget(form.licenceNum, {'attr': {'class': 'drl-input', 'placeholder': 'Ex: 1234-5678-90'}}) }}
                                    {{ form_errors(form.licenceNum) }}
                                </div>
                                <div class="col-lg-6">
                                    <label class="drl-label">{{ 'prf.lbl_company_num'|trans }}</label>
                                    {{ form_widget(form.companyNum, {'attr': {'class': 'drl-input', 'placeholder': 'Ex: 1160123456'}}) }}
                                    {{ form_errors(form.companyNum) }}
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="modal-footer drl-modal-footer">
                    <button type="button" class="btn btn-link text-muted text-decoration-none fw-bold" data-bs-dismiss="modal">{{ 'pro_dash.btn_cancel'|trans }}</button>
                    <button type="submit" form="profileUpdateForm" class="drl-btn-orange px-5">
                        <i class="ph-floppy-disk me-2"></i> {{ 'prf.btn_save'|trans }}
                    </button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <script>
    // Modal inner tabs
    document.querySelectorAll('.prf-modal-tab-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const target = this.dataset.modalTab;
            document.querySelectorAll('.prf-modal-tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.prf-modal-tab-pane').forEach(p => p.classList.add('d-none'));
            this.classList.add('active');
            document.getElementById(target).classList.remove('d-none');
        });
    });
    </script>
{% endblock %}
