{% extends 'professional/base_professional.html.twig' %}

{% block title %}My Profile - {{ app.user.companyName }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <div class="drl-card">
        <div class="drl-card-head">
            <div>
                <h4 class="drl-card-title">My Profile</h4>
                <p class="drl-card-sub">View and manage your professional information</p>
            </div>
            <button type="button" class="drl-btn-orange" style="padding: 8px 16px; font-size: 13px;" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                <i class="feather-edit"></i> Edit Profile
            </button>
        </div>

        <div class="p-4">
            <!-- Banner and Profile Photo -->
            <div class="mb-5">
                <div class="tutor-bg-photo position-relative" style="height: 250px; background-image: url('{{ app.user.banner ? asset('uploads/banners/' ~ app.user.banner) : asset('assets/drilleedo/images/bg/bg-image-22.jpg') }}'); background-size: cover; background-position: center; border-radius: 12px;"></div>
                <div class="rbt-tutor-information-left" style="margin-top: -60px; position: relative; z-index: 1;">
                    <div class="thumbnail rbt-avatars size-lg" style="margin-left: 2rem;">
                        {% if app.user.logo %}
                            <img src="{{ asset('uploads/logos/' ~ app.user.logo) }}" alt="Professional" style="border-radius: 50%; width: 120px; height: 120px; object-fit: cover; border: 4px solid white; box-shadow: 0 4px 16px rgba(13,33,81,0.15);">
                        {% else %}
                            <img src="{{ asset('assets/drilleedo/images/team/avatar.jpg') }}" alt="Professional" style="border-radius: 50%; width: 120px; height: 120px; object-fit: cover; border: 4px solid white; box-shadow: 0 4px 16px rgba(13,33,81,0.15);">
                        {% endif %}
                    </div>
                </div>
                <div class="mt-3 px-3">
                    <h5 class="mb-1" style="color: #0d2151; font-weight: 800;">{{ app.user.companyName }}</h5>
                    <p style="color: #64748b; font-size: 14px; margin: 0;">{{ app.user.email }}</p>
                </div>
            </div>

            <!-- Profile Information -->
            <div class="row g-4 mt-2">
                <div class="col-md-6">
                    <div class="d-flex align-items-start gap-3">
                        <div style="width: 44px; height: 44px; border-radius: 10px; background: #eff6ff; color: #00509e; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                            <i class="feather-briefcase"></i>
                        </div>
                        <div class="flex-grow-1">
                            <p style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 2px;">Professional Name</p>
                            <p style="font-weight: 700; color: #0d2151; margin: 0;">{{ app.user.companyName ?: 'Not set' }}</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="d-flex align-items-start gap-3">
                        <div style="width: 44px; height: 44px; border-radius: 10px; background: #f8fafc; color: #0d2151; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                            <i class="feather-mail"></i>
                        </div>
                        <div class="flex-grow-1">
                            <p style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 2px;">Email</p>
                            <p style="font-weight: 700; color: #0d2151; margin: 0;">{{ app.user.email }}</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="d-flex align-items-start gap-3">
                        <div style="width: 44px; height: 44px; border-radius: 10px; background: #fff7ed; color: #e8501a; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                            <i class="feather-map-pin"></i>
                        </div>
                        <div class="flex-grow-1">
                            <p style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 2px;">City</p>
                            <p style="font-weight: 700; color: #0d2151; margin: 0;">{{ app.user.city ?: 'Not set' }}</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="d-flex align-items-start gap-3">
                        <div style="width: 44px; height: 44px; border-radius: 10px; background: #eff6ff; color: #00509e; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                            <i class="feather-award"></i>
                        </div>
                        <div class="flex-grow-1">
                            <p style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 2px;">Years of Experience</p>
                            <p style="font-weight: 700; color: #0d2151; margin: 0;">{{ app.user.expYears ?: 'Not set' }}</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="d-flex align-items-start gap-3">
                        <div style="width: 44px; height: 44px; border-radius: 10px; background: #f8fafc; color: #0d2151; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                            <i class="feather-tag"></i>
                        </div>
                        <div class="flex-grow-1">
                            <p style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 2px;">Category</p>
                            <p style="font-weight: 700; color: #0d2151; margin: 0;">{{ app.user.category ? app.user.category.name : 'Not set' }}</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-12 mt-4 pt-3 border-top">
                    <div class="d-flex align-items-start gap-3">
                        <div style="width: 44px; height: 44px; border-radius: 10px; background: #eff6ff; color: #00509e; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                            <i class="feather-file-text"></i>
                        </div>
                        <div class="flex-grow-1">
                            <p style="font-size: 14px; font-weight: 800; color: #0d2151; margin-bottom: 6px;">About Me</p>
                            <p class="mb-0 text-break" style="color: #475569; line-height: 1.6;">{{ app.user.about ?: 'Not set' }}</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mt-4">
                    <div class="d-flex align-items-start gap-3">
                        <div style="width: 44px; height: 44px; border-radius: 10px; background: #f0fdf4; color: #16a34a; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                            <i class="feather-check-circle"></i>
                        </div>
                        <div class="flex-grow-1">
                            <p style="font-size: 14px; font-weight: 800; color: #0d2151; margin-bottom: 6px;">Why Choose Me</p>
                            {% if app.user.whyChooseUs %}
                                {% if app.user.whyChooseUs is iterable %}
                                    <ul class="mb-0 ps-3" style="color: #475569; line-height: 1.6;">
                                        {% for item in app.user.whyChooseUs %}
                                            <li>{{ item }}</li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <p class="mb-0" style="color: #475569; line-height: 1.6;">{{ app.user.whyChooseUs }}</p>
                                {% endif %}
                            {% else %}
                                <p class="mb-0" style="color: #94a3b8;">Not set</p>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mt-4">
                    <div class="d-flex align-items-start gap-3">
                        <div style="width: 44px; height: 44px; border-radius: 10px; background: #fff7ed; color: #e8501a; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                            <i class="feather-list"></i>
                        </div>
                        <div class="flex-grow-1">
                            <p style="font-size: 14px; font-weight: 800; color: #0d2151; margin-bottom: 6px;">Services</p>
                            {% if app.user.services %}
                                {% if app.user.services is iterable %}
                                    <ul class="mb-0 ps-3" style="color: #475569; line-height: 1.6;">
                                        {% for item in app.user.services %}
                                            <li>{{ item }}</li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <p class="mb-0" style="color: #475569; line-height: 1.6;">{{ app.user.services }}</p>
                                {% endif %}
                            {% else %}
                                <p class="mb-0" style="color: #94a3b8;">Not set</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block script %}
    <script>
        document.getElementById('{{ form.logoFile.vars.id }}')?.addEventListener('change', function(event) {
            const [file] = event.target.files;
            if (file) {
                 const reader = new FileReader();
                 reader.onload = function(e) {
                     const img = document.getElementById('logo-preview');
                     if(img) img.src = e.target.result;
                 };
                 reader.readAsDataURL(file);
            }
        });

        document.getElementById('{{ form.bannerFile.vars.id }}')?.addEventListener('change', function(event) {
            const [file] = event.target.files;
            if (file) {
                 const reader = new FileReader();
                 reader.onload = function(e) {
                     const bannerDiv = document.getElementById('banner-preview-box');
                     if(bannerDiv) bannerDiv.style.backgroundImage = `url('${e.target.result}')`;
                 };
                 reader.readAsDataURL(file);
            }
        });
        // Reopen modal if form has errors
        {% if not form.vars.valid %}
            const editModal = new bootstrap.Modal(document.getElementById('editProfileModal'));
            editModal.show();
        {% endif %}
    </script>
{% endblock %}

{% block modals %}
    {{ parent() }}
    <!-- Edit Profile Modal -->
    <div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content" style="border: none; border-radius: 16px; box-shadow: 0 10px 40px rgba(13,33,81,0.2);">
                <div class="modal-header" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; border-radius: 16px 16px 0 0; padding: 20px 24px;">
                    <h5 class="modal-title" id="editProfileModalLabel" style="font-weight: 800; color: #0d2151; margin: 0;">Edit Profile</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="max-height: 75vh; overflow-y: auto; padding: 32px;">
                    {{ form_start(form, {'attr': {'class': 'row g-4', 'id': 'profileUpdateForm'}}) }}
                   
                        <div class="col-lg-6">
                            <div>
                                <label class="drl-form-label" for="{{ form.company_name.vars.id }}">Professional Name</label>
                                {{ form_widget(form.company_name, {'attr': {'class': 'drl-form-control w-100', 'placeholder': 'John Doe Construction'}}) }}
                                {{ form_errors(form.company_name) }}
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="drl-form-label" for="{{ form.parentCategory.vars.id }}">Industry/Sector</label>
                                    {{ form_widget(form.parentCategory, {'attr': {'class': 'drl-form-control w-100 form-select parent-category-select selectpicker', 'data-live-search': 'true'}}) }}
                                    {{ form_errors(form.parentCategory) }}
                                </div>
                                <div class="col-md-6">
                                    <label class="drl-form-label" for="{{ form.category.vars.id }}">Specific Service</label>
                                    {{ form_widget(form.category, {
                                        'attr': {
                                            'class': 'drl-form-control w-100 form-select child-category-select selectpicker',
                                            'data-selected-id': app.user.category ? app.user.category.id : '',
                                            'data-live-search': 'true'
                                        }
                                    }) }}
                                    {{ form_errors(form.category) }}
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div>
                                <label class="drl-form-label" for="{{ form.email.vars.id }}">Email</label>
                                {{ form_widget(form.email, {'attr': {'class': 'drl-form-control w-100', 'placeholder': 'contact@example.com'}}) }}
                                {{ form_errors(form.email) }}
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div>
                                <label class="drl-form-label" for="{{ form.city.vars.id }}">City</label>
                                {{ form_widget(form.city, {'attr': {'class': 'drl-form-control w-100', 'placeholder': 'Montreal'}}) }}
                                {{ form_errors(form.city) }}
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div>
                                <label class="drl-form-label" for="{{ form.exp_years.vars.id }}">Years of Experience</label>
                                {{ form_widget(form.exp_years, {'attr': {'class': 'drl-form-control w-100', 'placeholder': '5'}}) }}
                                {{ form_errors(form.exp_years) }}
                            </div>
                        </div>

                        <div class="col-12 mt-4 pt-3 border-top">
                            <div>
                                <label class="drl-form-label">About Me</label>
                                {{ form_widget(form.about, {'attr': {'class': 'drl-form-control w-100', 'rows': '4', 'placeholder': 'Tell clients about your business...'}}) }}
                                {{ form_errors(form.about) }}
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div>
                                <label class="drl-form-label">Why Choose Me <span style="font-weight: 400; color: #94a3b8; font-size: 11px;">(One item per line)</span></label>
                                {{ form_widget(form.whyChooseUs, {'attr': {'class': 'drl-form-control w-100', 'rows': '5'}}) }}
                                {{ form_errors(form.whyChooseUs) }}
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div>
                                <label class="drl-form-label">Services <span style="font-weight: 400; color: #94a3b8; font-size: 11px;">(One item per line)</span></label>
                                {{ form_widget(form.services, {'attr': {'class': 'drl-form-control w-100', 'rows': '5'}}) }}
                                {{ form_errors(form.services) }}
                            </div>
                        </div>
                    {{ form_end(form) }}
                </div>
                <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #e2e8f0; border-radius: 0 0 16px 16px; padding: 16px 24px;">
                    <button type="button" style="padding: 10px 20px; font-size: 14px; font-weight: 700; background: #fff; border: 1px solid #cbd5e1; border-radius: 8px; color: #64748b;" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" form="profileUpdateForm" class="drl-btn-orange">
                        <i class="feather-save"></i> Save Changes
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
