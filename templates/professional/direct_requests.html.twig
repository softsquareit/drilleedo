{% extends 'professional/base_professional.html.twig' %}

{% block title %}{{ 'Demandes directes'|trans }} - {{ app.user.companyName }}{% endblock %}

{% block body %}
    <div class="drl-card">
        <div class="drl-card-head border-bottom">
            <div>
                <h4 class="drl-card-title">{{ 'Demandes directes'|trans }}</h4>
                <p class="drl-card-sub">{{ 'Demandes qui vous sont envoyées directement par des particuliers'|trans }}</p>
            </div>
            <span class="drl-badge" style="background: #eff6ff; color: #00509e; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 700;">{{ directRequests|length }} {{ 'Total'|trans }}</span>
        </div>

        <div class="table-responsive">
            <table class="table mb-0 drl-table">
                <thead>
                    <tr>
                        <th>{{ 'Détails de la demande'|trans }}</th>
                        <th>{{ 'Particulier'|trans }}</th>
                        <th>{{ 'Catégorie'|trans }}</th>
                        <th>{{ 'Date'|trans }}</th>
                        <th>{{ 'Statut'|trans }}</th>
                        <th>{{ 'Action'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for request in directRequests %}
                        <tr>
                            <td>
                            <div>
                                    <span style="font-weight: 800; color: #0d2151; display: block;">
                                        {{ request.title }}
                                    </span>
                                    <span style="font-size: 12px; color: #94a3b8;">
                                        #{{ request.id }} &bull; {{ request.description|slice(0, 55) }}...
                                    </span>
                                </div>
                            </td>
                            <td>
                                <span style="font-weight: 600; color: #475569;">{{ request.individual.personalInfos.firstName|default('Utilisateur'|trans) }} {{ request.individual.personalInfos.lastName|default('') }}</span>
                            </td>
                            <td>
                                <span class="drl-tag drl-tag--draft" style="background:#f8fafc; color:#475569;">{{ request.category.localizedTitle(app.request.locale)|default('Général'|trans) }}</span>
                            </td>
                            <td>
                                <span style="font-size: 13px; color: #64748b;">{{ request.creationDate|date('d/m/Y') }}</span>
                            </td>
                            <td>
                                {% if request.status == 'PUBLISHED' %}
                                    <span class="drl-tag drl-tag--sent"><i class="ph-globe" style="font-size: 11px;"></i> {{ 'Publiée'|trans }}</span>
                                {% elseif request.status in ['Accepted'] %}
                                    <span class="drl-tag drl-tag--success"><i class="ph-check-circle" style="font-size: 11px;"></i> {{ 'Acceptée'|trans }}</span>
                                {% elseif request.status in ['Closed'] %}
                                    <span class="drl-tag drl-tag--draft"><i class="ph-lock" style="font-size: 11px;"></i> {{ 'Clôturée'|trans }}</span>
                                {% else %}
                                    <span class="drl-tag drl-tag--draft">{{ request.status|trans }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap align-items-center">
                                {# View details — always available #}
                                <a href="{{ path('offer_send_direct', {id: request.id}) }}"
                                   class="drl-act-btn drl-act-btn--view"
                                   style="text-decoration:none; font-size:12px; padding: 5px 10px; border-radius:6px; display:inline-flex; align-items:center; gap:4px;"
                                   title="{{ 'Voir les détails de la demande'|trans }}">
                                    <i class="ph-eye"></i>
                                    <span>{{ 'Détails'|trans }}</span>
                                </a>

                                {# Submit offer — only if request is PUBLISHED and not yet Accepted/Closed #}
                                {% if request.status == 'PUBLISHED' %}
                                    <a href="{{ path('offer_send_direct', {id: request.id}) }}"
                                       class="drl-btn-orange"
                                       style="padding: 5px 12px; font-size:12px; text-decoration:none; border-radius:6px; display:inline-flex; align-items:center; gap:5px;">
                                        <i class="ph-paper-plane-tilt"></i>
                                        <span>{{ 'Répondre'|trans }}</span>
                                    </a>
                                {% elseif request.status in ['Accepted', 'Closed'] %}
                                    <span class="drl-tag drl-tag--draft" style="font-size:11px;">
                                        <i class="ph-lock" style="font-size:10px;"></i> {{ 'Clôturée'|trans }}
                                    </span>
                                {% endif %}
                            </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div style="width:56px; height:56px; border-radius:50%; background:#f8fafc; color:#94a3b8; font-size:24px; display:inline-flex; align-items:center; justify-content:center; margin-bottom:12px;">
                                    <i class="ph-inbox"></i>
                                </div>
                                <h6 style="font-size:16px; font-weight:800; color:#0d2151; margin:0 0 6px;">{{ 'Aucune demande directe'|trans }}</h6>
                                <p style="font-size:14px; color:#64748b; margin:0;">{{ "Aucune demande directe ne vous a été envoyée pour le moment"|trans }}</p>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
