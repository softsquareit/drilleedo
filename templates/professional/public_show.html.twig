{% extends 'base.html.twig' %}

{% block title %}{{ professional.tradeName ?: professional.companyName ?: 'pro_pub.show_page_title'|trans }} – Drilleedo{% endblock %}

{% block stylesheets %}
<style>
/* ── Charte Drilleedo overrides ── */
:root {
    --B: #00497F; --S: #3FA9F5; --O: #FF8A3D;
    --D: #0C1825; --M: #4A6073; --L: #E4EBF2;
    --zenith-bg-light: #f8fafc;
    --zenith-border: #e2e8f0;
    --zenith-primary: #0C1825;
    --color-primary: #00497F;
}

/* ── Hero banner ── */
.zenith-hero-wrapper { background: linear-gradient(135deg,#002d50,#00497F 60%,#0a6eab) !important; }
.zenith-hero-bg::before { background: linear-gradient(to bottom, rgba(0,29,64,.25), rgba(0,40,80,.85)) !important; }

/* ── Profile header text ── */
.zenith-name { font-weight: 900 !important; letter-spacing: -1px !important; line-height: 1.1 !important; }
.zenith-verified-badge {
    background: rgba(34,197,94,.15) !important; color: #4ade80 !important;
    border-color: rgba(34,197,94,.35) !important; font-weight: 700 !important;
}

/* ── Content boxes ── */
.zenith-box {
    border-radius: 20px !important; border-color: var(--L) !important;
    box-shadow: 0 2px 14px rgba(0,73,127,.07) !important;
    transition: box-shadow .2s ease !important;
}
.zenith-box:hover { box-shadow: 0 8px 32px rgba(0,73,127,.12) !important; }

/* ── Section titles ── */
.zenith-section-title { color: var(--D) !important; font-weight: 900 !important; letter-spacing: -.5px !important; }
.zenith-section-title::before { background: var(--O) !important; border-radius: 4px !important; }

/* ── Sidebar sticky card ── */
.zenith-sticky-card {
    border-radius: 20px !important; border: 1.5px solid var(--L) !important;
    box-shadow: 0 8px 36px rgba(0,73,127,.12) !important;
}

/* ── CTA buttons ── */
.pro-btn.pro-btn-primary {
    background: var(--O) !important; border-radius: 12px !important;
    box-shadow: 0 4px 18px rgba(255,138,61,.32) !important;
    font-weight: 700 !important; transition: all .18s !important;
}
.pro-btn.pro-btn-primary:hover { background: #e87830 !important; transform: translateY(-2px) !important; }
.pro-btn.pro-btn-outline {
    border: 1.5px solid var(--L) !important; border-radius: 12px !important;
    color: var(--D) !important; font-weight: 700 !important; transition: all .18s !important;
    background: #fff !important;
}
.pro-btn.pro-btn-outline:hover { border-color: var(--S) !important; color: var(--B) !important; }

/* ── Why choose + services lists ── */
.zenith-grid-list li i {
    background: rgba(63,169,245,.1) !important; color: var(--S) !important;
    border-radius: 50% !important;
}

/* ── Project card overlay ── */
.zenith-project-overlay { background: linear-gradient(to top, rgba(0,29,64,.85), transparent) !important; }

/* ── FAQ accordion ── */
.accordion-button:not(.collapsed) {
    color: var(--B) !important; background: rgba(0,73,127,.05) !important;
    box-shadow: none !important;
}
.accordion-button:focus { box-shadow: 0 0 0 3px rgba(63,169,245,.2) !important; }
.accordion-item { border-color: var(--L) !important; border-radius: 12px !important; overflow: hidden !important; margin-bottom: 8px !important; }

    /* Zenith Hero Section */
    .zenith-hero-wrapper {
        position: relative;
        background: #0f172a;
        margin-bottom: 80px;
    }

    .zenith-hero-bg {
        height: 480px;
        width: 100%;
        background-size: cover;
        background-position: center;
        position: relative;
    }

    .zenith-hero-bg::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to bottom, rgba(15, 23, 42, 0.3), rgba(15, 23, 42, 0.9));
    }

    .zenith-profile-header {
        position: absolute;
        bottom: -60px;
        left: 0;
        right: 0;
        z-index: 10;
        padding-bottom: 20px;
    }

    .zenith-avatar-large {
        width: 160px;
        height: 160px;
        border-radius: 50%;
        border: 5px solid #fff;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        background: #fff;
        overflow: hidden;
        margin-bottom: 20px;
    }

    .zenith-avatar-large img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .zenith-avatar-placeholder {
        width: 100%;
        height: 100%;
        background: #0F172A;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        font-weight: 700;
    }

    .zenith-name {

        font-size: 3.5rem;
        color: #fff;
        margin-bottom: 10px;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .zenith-verified-badge {
         display: inline-flex;
         align-items: center;
         gap: 8px;
         background: rgba(34, 197, 94, 0.2);
         color: #4ade80;
         border: 1px solid rgba(34, 197, 94, 0.4);
         padding: 8px 18px;
         border-radius: 50px;
         font-size: 1.1rem;
         font-weight: 600;
         backdrop-filter: blur(4px);
    }

    /* Content Layout */
    .zenith-section-title {

        font-size: 2rem;
        margin-bottom: 1.5rem;
        color: var(--zenith-primary);
        position: relative;
        padding-left: 20px;
    }

    .zenith-section-title::before {
        content: '';
        position: absolute;
        left: 0;
        top: 8px;
        bottom: 8px;
        width: 4px;
        background: var(--color-primary);
        border-radius: 4px;
    }

    .zenith-box {
        background: #fff;
        border-radius: 16px;
        padding: 40px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        border: 1px solid var(--zenith-border);
        margin-bottom: 40px;
    }

    .zenith-grid-list li {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
        color: #475569;
        font-size: 1.4rem;
    }

    .zenith-grid-list li i {
        color: var(--color-primary);
        background: rgba(59, 130, 246, 0.1);
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 14px;
    }

    /* Sticker Sidebar */
    .zenith-sticky-card {
        position: sticky;
        top: 120px;
        background: #fff;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.08);
        border: 1px solid var(--zenith-border);
    }

    .zenith-contact-btn {
        width: 100%;
        padding: 16px;
        font-weight: 600;
        border-radius: 12px;
        transition: 0.3s;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .zenith-btn-primary {
        background: var(--color-primary);
        color: #fff !important;
        box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
    }
    .zenith-btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(59, 130, 246, 0.5);
    }

    .zenith-btn-secondary {
        background: #f1f5f9;
        color: #475569 !important;
    }
    .zenith-btn-secondary:hover {
        background: #e2e8f0;
        color: #0f172a !important;
    }

    /* Projects Grid */
    .zenith-project-card {
        border-radius: 12px;
        overflow: hidden;
        position: relative;
        height: 280px;
        group: project;
    }

    .zenith-project-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: 0.5s;
    }

    .zenith-project-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 20px;
        opacity: 0;
        transition: 0.3s;
    }

    .zenith-project-card:hover img {
        transform: scale(1.1);
    }
    .zenith-project-card:hover .zenith-project-overlay {
        opacity: 1;
    }

    @media (max-width: 991px) {
        .zenith-hero-bg { height: 350px; }
        .zenith-name { font-size: 2.5rem; }
        .zenith-hero-wrapper { margin-bottom: 220px; }
        .zenith-profile-header { bottom: -200px; text-align: center; }
        .zenith-avatar-large { margin: 0 auto 20px; }
        .zenith-sticky-card { position: static; margin-top: 40px; }
    }
</style>
{% endblock %}

{% block body %}

<div class="zenith-hero-wrapper">
    <div class="zenith-hero-bg" style="{% if professional.banner %}background-image: url('{{ asset('uploads/banners/' ~ professional.banner) }}');{% else %}background-color: #0F172A;{% endif %}">
        <div class="container h-100">
            <div class="row h-100 align-items-end">
                <div class="col-lg-12">
                     <div class="zenith-profile-header">
                        <div class="d-lg-flex align-items-end gap-5">
                            <div class="zenith-avatar-large flex-shrink-0">
                                {% if professional.logo %}
                                    <img src="{{ asset('uploads/logos/' ~ professional.logo) }}" alt="Profile Photo">
                                {% else %}
                                    <div class="zenith-avatar-placeholder">{{ professional.tradeName|first|default('P')|upper }}</div>
                                {% endif %}
                            </div>
                            <div class="mb-4">
                                <h1 class="zenith-name">{{ professional.tradeName ?: professional.companyName ?: (professional.firstName ~ ' ' ~ professional.lastName) }}</h1>
                                <div class="d-flex align-items-center flex-wrap gap-3">
                                    <span class="zenith-verified-badge"><i class="ph-check-circle"></i> {{ 'pro_pub.show_verified_badge'|trans }}</span>
                                    <span class="text-white opacity-75"><i class="ph-map-pin"></i> {{ professional.city|default('Canada') }}</span>
                                    <span class="text-white opacity-75">| {{ professional.category.localizedTitle(app.request.locale)|default('pro_pub.show_default_service'|trans) }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="rbt-section-gapBottom">
    <div class="container">
        <div class="row g-5">
            <!-- Left Side Content -->
            <div class="col-lg-8">

                <!-- Section: About -->
                <div class="zenith-box">
                    <h3 class="zenith-section-title">{{ 'pro_pub.show_bio_title'|trans }}</h3>
                    {% if professional.about %}
                        <p style="color: #64748b; line-height: 1.8; white-space: pre-wrap;">{{ professional.about }}</p>
                    {% else %}
                        <p class="lead mb-4" style="color: #334155; font-weight: 500;">
                            {{ 'pro_pub.show_dedicated_pro'|trans }}
                            {{ professional.category ? professional.category.localizedTitle(app.request.locale)|lower : 'pro_pub.show_renovation'|trans }} {{ 'pro_pub.show_high_quality'|trans }}
                        </p>
                        <p style="color: #64748b; line-height: 1.8;">
                            {{ 'pro_pub.show_with_exp'|trans }} {{ professional.expYears|default('pro_pub.show_several'|trans) }} {{ 'pro_pub.show_exp_sentence1'|trans }}
                            {{ 'pro_pub.show_exp_sentence2'|trans }}
                            {{ 'pro_pub.show_exp_sentence3'|trans }}
                        </p>
                    {% endif %}
                </div>

                <!-- Section: Highlights -->
                <div class="zenith-box">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <h4 class="mb-4 font-primary">{{ 'pro_pub.show_why_hire'|trans }}</h4>
                            <ul class="zenith-grid-list list-unstyled">
                                {% if professional.whyChooseUs|length > 0 %}
                                    {% for item in professional.whyChooseUs %}
                                        <li><i class="ph-medal"></i> {{ item }}</li>
                                    {% endfor %}
                                {% else %}
                                    <li><i class="ph-medal"></i> {{ professional.expYears|default(1) }}+ {{ 'pro_pub.show_exp_years_short'|trans }}</li>
                                    <li><i class="ph-check-square"></i> {{ 'pro_pub.show_quality'|trans }}</li>
                                    <li><i class="ph-clock"></i> {{ 'pro_pub.show_punctual'|trans }}</li>
                                    <li><i class="ph-thumbs-up"></i> {{ 'pro_pub.show_client_centered'|trans }}</li>
                                {% endif %}
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h4 class="mb-4 font-primary">{{ 'pro_pub.show_services_title'|trans }}</h4>
                            <ul class="zenith-grid-list list-unstyled">
                                {% if professional.services|length > 0 %}
                                    {% for item in professional.services %}
                                        <li><i class="ph-wrench"></i> {{ item }}</li>
                                    {% endfor %}
                                {% else %}
                                    <li><i class="ph-wrench"></i> {{ professional.category.localizedTitle(app.request.locale)|default('pro_pub.show_default_service_item'|trans) }}</li>
                                    <li><i class="ph-clipboard-text"></i> {{ 'pro_pub.show_consultations'|trans }}</li>
                                    <li><i class="ph-gear-six"></i> {{ 'pro_pub.show_maintenance'|trans }}</li>
                                    <li><i class="ph-package"></i> {{ 'pro_pub.show_custom_install'|trans }}</li>
                                {% endif %}
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="mb-5">
                    <h3 class="zenith-section-title">{{ 'pro_pub.show_portfolio_title'|trans }}</h3>
                    <div class="row g-4">
                        {% for project in professional.projets %}
                            <div class="col-md-6">
                                <a href="{{ path('project_show', {'id': project.id}) }}" class="d-block" style="text-decoration: none;">
                                    <div class="zenith-project-card">
                                        <img src="{{ project.mainPhoto ? asset('uploads/projects/' ~ project.mainPhoto) : asset('assets/drilleedo/assets/images/bg/bg-image-1.jpg') }}" alt="{{ project.name }}">
                                        <div class="zenith-project-overlay">
                                            <span class="pro-badge primary mb-2 w-auto align-self-start">{{ project.startDate|date('M Y') }}</span>
                                            <h4 class="text-white mb-0 h5">{{ project.name }}</h4>
                                            <p class="text-white-50 small mb-0">{{ project.description|slice(0, 50) }}...</p>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        {% else %}
                            <div class="col-12">
                                <div class="p-5 text-center bg-light rounded-3 border border-dashed">
                                    <p class="mb-0 text-muted">{{ 'pro_pub.show_no_projects'|trans }}</p>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                 <div class="zenith-box p-0 overflow-hidden">
                    <div class="p-4 border-bottom">
                         <h3 class="zenith-section-title mb-0">{{ 'pro_pub.show_faq_title'|trans }}</h3>
                    </div>
                    <div class="accordion accordion-flush" id="accordionFAQ">
                         <div class="accordion-item">
                            <h2 class="accordion-header" id="headingOne">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                    {{ 'pro_pub.show_faq_q1'|trans }}
                                </button>
                            </h2>
                            <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionFAQ">
                                <div class="accordion-body text-muted">
                                    {{ 'pro_pub.show_faq_a1'|trans }}
                                </div>
                            </div>
                        </div>
                         <div class="accordion-item">
                            <h2 class="accordion-header" id="headingTwo">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                    {{ 'pro_pub.show_faq_q2'|trans }}
                                </button>
                            </h2>
                            <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionFAQ">
                                <div class="accordion-body text-muted">
                                    {{ 'pro_pub.show_faq_a2_prefix'|trans }} {{ professional.city|default('pro_pub.show_default_region'|trans) }} {{ 'pro_pub.show_faq_a2_suffix'|trans }}
                                </div>
                            </div>
                        </div>
                    </div>
                 </div>

            </div>

             <!-- Right Sidebar -->
            <div class="col-lg-4">
