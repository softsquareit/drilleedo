                    </a>
                </div>
            </div>

            {# — Image — #}
            <div class="fp-hero-img-col fp-anim" style="transition-delay:.1s;">
                <img class="fp-hero-img"
                     src="{{ asset('assets/drilleedo/images/stock/about_canada_homes.jpg') }}"
                     alt="Trouver un professionnel de rénovation">
                <div class="fp-hero-badge">
                    <i class="ph-bold ph-shield-check"></i>
                    <div class="fp-hero-badge__text">Pros vérifiés<br>et évalués</div>
                </div>
                <div class="fp-hero-badge2">
                    <span class="fp-hero-badge2__num">GRATUIT</span>
                    <span class="fp-hero-badge2__lbl">Sans engagement</span>
                </div>
            </div>

        </div>
    </div>
</section>

