                    <span class="fp-hero-badge2__num">{{ 'fp_pg.hero_badge2_num'|trans }}</span>
                    <span class="fp-hero-badge2__lbl">{{ 'fp_pg.hero_badge2_lbl'|trans }}</span>
                </div>
            </div>

        </div>
    </div>
</section>

