{% extends 'base.html.twig' %}

{% block title %}Trouver un professionnel | Drilleedo Canada{% endblock %}
{% block meta_description %}Parcourez des professionnels vérifiés, comparez leurs profils et contactez directement l'entrepreneur qui correspond à votre projet. 100 % gratuit, sans engagement.{% endblock %}

{% block body %}
<main id="main-content">
<script src="https://unpkg.com/@phosphor-icons/web"></script>
<style>
/* ══ FIND-A-PRO — Drilleedo Brand System ═══════════════════════════════════
   #00497F · #3FA9F5 · #FF8A3D · #0C1825 · #4A6073 · #E4EBF2
   ══════════════════════════════════════════════════════════════════════════ */
:root {
  --B:#00497F; --S:#3FA9F5; --O:#FF8A3D;
  --D:#0C1825; --M:#4A6073; --L:#E4EBF2; --W:#fff;
  --F:'Instrument Sans',system-ui,sans-serif;
  --sh: 0 4px 24px rgba(0,73,127,.10);
  --sh-md: 0 10px 40px rgba(0,73,127,.14);
  --t: all .22s ease;
}
* { box-sizing: border-box; }
.fp-wrap { max-width:1140px; margin:0 auto; padding:0 24px; font-family:var(--F); color:var(--D); }

/* ── 1. HERO ── */
.fp-hero {
    background: var(--B);
    padding: 96px 0 80px;
    position: relative; overflow: hidden;
}
.fp-hero::before {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 28px 28px; pointer-events: none;
}
.fp-hero::after {
    content: ''; position: absolute; right: -80px; top: -80px;
    width: 480px; height: 480px; border-radius: 50%;
    background: radial-gradient(circle, rgba(255,138,61,.10) 0%, transparent 68%);
    pointer-events: none;
}
.fp-hero-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 56px; align-items: center; position: relative; z-index: 2;
}
.fp-hero-pill {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(63,169,245,.18); color: #3FA9F5;
    border: 1px solid rgba(63,169,245,.40);
    border-radius: 50px; padding: 6px 18px;
    font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
    margin-bottom: 20px;
}
.fp-hero h1 {
    font-size: clamp(28px,4.2vw,52px); font-weight: 900; color: #fff;
    margin: 0 0 6px; line-height: 1.08; letter-spacing: -.03em;
}
.fp-hero h1 .hl-sky { color: #3FA9F5; }
.fp-hero__sub {
    font-size: 17px; color: rgba(255,255,255,.78);
    max-width: 500px; line-height: 1.75; margin: 16px 0 28px;
}
.fp-hero-trust {
    display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 32px;
}
.fp-hero-trust span {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(63,169,245,.10); border: 1px solid rgba(63,169,245,.25);
    color: rgba(255,255,255,.90); font-size: 13px; font-weight: 600;
    padding: 5px 14px; border-radius: 50px;
}
.fp-hero-trust i { color: #3FA9F5; font-size: 14px; }
.fp-hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

/* image col */
.fp-hero-img-col { position: relative; }
.fp-hero-img {
    width: 100%; height: 430px; object-fit: cover;
    border-radius: 22px; box-shadow: 0 28px 64px rgba(0,0,0,.30); display: block;
}
.fp-hero-badge {
    position: absolute; bottom: 28px; right: -14px;
    background: #fff; color: var(--D);
    padding: 12px 18px; border-radius: 16px;
    box-shadow: 0 8px 28px rgba(0,73,127,.18);
    display: flex; align-items: center; gap: 10px;
}
.fp-hero-badge i { color: var(--S); font-size: 22px; }
.fp-hero-badge__text { font-size: 12px; font-weight: 800; line-height: 1.35; }
.fp-hero-badge2 {
    position: absolute; top: 24px; left: -18px;
    background: var(--O); color: #fff;
    padding: 12px 18px; border-radius: 16px;
    box-shadow: 0 6px 22px rgba(255,138,61,.42);
}
.fp-hero-badge2__num { font-size: 22px; font-weight: 900; line-height: 1; display: block; }
.fp-hero-badge2__lbl { font-size: 10px; font-weight: 700; opacity: .9; text-transform: uppercase; letter-spacing: .05em; }

/* ── 2. STEPS OVERVIEW ── */
.fp-overview {
    background: #f4f8fc;
    padding: 88px 0;
    border-top: 3px solid var(--B);
}
.fp-section-hd { text-align: center; margin-bottom: 56px; }
.fp-section-pill {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(63,169,245,.10); color: var(--S);
    border: 1px solid rgba(63,169,245,.2);
    border-radius: 50px; padding: 6px 18px;
    font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
    margin-bottom: 16px;
}
.fp-section-title {
    font-size: clamp(26px,3.5vw,38px); font-weight: 900; color: var(--B) !important;
    letter-spacing: -.025em; margin: 0 0 12px; line-height: 1.13;
}
.fp-section-title span { color: var(--B); }
.fp-section-sub {
    font-size: 16px; color: var(--M); max-width: 520px; margin: 0 auto; line-height: 1.75;
}
.fp-steps-row {
    display: grid; grid-template-columns: repeat(4,1fr);
    position: relative; gap: 14px;
}
.fp-steps-row::before {
    content: ''; position: absolute;
    top: 34px; left: calc(12.5% + 8px); right: calc(12.5% + 8px);
    height: 2px; background: var(--B); opacity: .25; z-index: 0;
}
.fp-ovr-step { text-align: center; padding: 0 8px; position: relative; z-index: 1; }
.fp-ovr-circle {
    width: 68px; height: 68px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 24px; margin: 0 auto 18px; position: relative; z-index: 2;
}
.fp-ovr-circle--1 { background: var(--S); color: #fff; box-shadow: 0 6px 22px rgba(63,169,245,.35); }
.fp-ovr-circle--2 { background: var(--S); color: #fff; box-shadow: 0 6px 22px rgba(63,169,245,.35); }
.fp-ovr-circle--3 { background: var(--S); color: #fff; box-shadow: 0 6px 22px rgba(63,169,245,.35); }
.fp-ovr-circle--4 { background: var(--S); color: #fff; box-shadow: 0 6px 22px rgba(63,169,245,.35); }
.fp-ovr-num {
    position: absolute; top: -4px; right: -4px;
    width: 22px; height: 22px; border-radius: 50%;
    background: var(--O); color: #fff;
    font-size: 10px; font-weight: 900;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 8px rgba(255,138,61,.4); border: 2px solid #fff;
}
.fp-ovr-card {
    background: #fff; border-radius: 20px; padding: 20px 16px 22px;
    border: 1.5px solid var(--L);
    box-shadow: 0 2px 12px rgba(0,73,127,.06);
    transition: var(--t);
}
.fp-ovr-card:hover {
    box-shadow: 0 10px 32px rgba(0,73,127,.14); transform: translateY(-5px);
}
/* Accent couleur bas de carte = couleur du cercle correspondant */
.fp-ovr-title { font-size: 14px; font-weight: 800; color: var(--B) !important; margin: 0 0 6px; }
.fp-ovr-text  { font-size: 12px; color: var(--M); line-height: 1.6; margin: 0; }

/* ── 3. SPLIT PHASES ── */
.fp-phase { padding: 88px 0; background: var(--W); border-bottom: 1px solid var(--L); }
.fp-phase:last-of-type { border-bottom: none; }
.fp-phase--alt { background: #f4f8fc; }
.fp-phase-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 64px; align-items: center;
}
.fp-phase-grid--rev { direction: rtl; }
.fp-phase-grid--rev > * { direction: ltr; }
.fp-phase-img-wrap {
    position: relative; border-radius: 22px; overflow: hidden;
    box-shadow: 0 16px 52px rgba(0,73,127,.16);
}
.fp-phase-img-wrap img { width: 100%; height: 380px; object-fit: cover; display: block; }
.fp-phase-img-tag {
    position: absolute; bottom: 20px; right: 20px;
    background: rgba(0,40,80,.85); backdrop-filter: blur(10px);
    color: #fff; padding: 10px 16px; border-radius: 12px;
    font-size: 12px; font-weight: 700;
    display: flex; align-items: center; gap: 6px;
}
.fp-phase-img-tag i { color: var(--S); }
.fp-phase-label {
    display: inline-flex; align-items: center; gap: 7px;
    border-radius: 50px; padding: 6px 16px;
    font-size: 11px; font-weight: 800;
    letter-spacing: .08em; text-transform: uppercase; margin-bottom: 14px;
}
.fp-phase-step {
    font-size: 11px; font-weight: 800; color: var(--S);
    letter-spacing: .12em; text-transform: uppercase; margin-bottom: 8px;
}
.fp-phase-title {
    font-size: clamp(22px,2.8vw,32px); font-weight: 900; color: var(--B) !important;
    letter-spacing: -.025em; margin: 0 0 14px; line-height: 1.15;
}
.fp-phase-desc { font-size: 15px; color: var(--M); line-height: 1.8; margin-bottom: 24px; }
.fp-feat-list { list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-direction: column; gap: 12px; }
.fp-feat-item { display: flex; gap: 12px; align-items: flex-start; }
.fp-feat-ico {
    width: 40px; height: 40px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; flex-shrink: 0;
}
.fp-feat-item h4 { font-size: 14px; font-weight: 800; color: var(--B) !important; margin: 0 0 2px; line-height: 1.4; }
.fp-feat-item p  { font-size: 13px; color: var(--M); margin: 0; line-height: 1.55; }

/* ── 4. CTA FINAL ── */
.fp-cta {
    background: var(--B);
    padding: 96px 0; text-align: center; position: relative; overflow: hidden;
}
.fp-cta::before {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,.025) 1px, transparent 1px);
    background-size: 28px 28px; pointer-events: none;
}
.fp-cta::after {
    content: ''; position: absolute; right: -80px; bottom: -80px;
    width: 400px; height: 400px; border-radius: 50%;
    background: radial-gradient(circle, rgba(255,138,61,.08) 0%, transparent 68%);
    pointer-events: none;
}
.fp-cta__inner { position: relative; z-index: 2; }
.fp-cta-tag {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(63,169,245,.18); border: 1px solid rgba(63,169,245,.35);
    color: #3FA9F5; font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase;
    padding: 6px 16px; border-radius: 50px; margin-bottom: 18px;
}
.fp-cta h2 {
    font-size: clamp(26px,4vw,44px); font-weight: 900; color: #fff;
    margin: 0 0 14px; letter-spacing: -.025em; line-height: 1.13;
}
.fp-cta h2 span { color: #3FA9F5; }
.fp-cta__sub {
    font-size: 16px; color: rgba(255,255,255,.72);
    margin: 0 auto 36px; max-width: 460px; line-height: 1.75;
}
.fp-cta-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

/* ── BUTTONS ── */
.fp-btn-s {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--S); color: #fff; font-family: var(--F);
    font-size: 15px; font-weight: 800;
    padding: 14px 30px; border-radius: 50px; text-decoration: none;
    box-shadow: 0 4px 18px rgba(63,169,245,.38); transition: var(--t);
}
.fp-btn-s:hover { background: #2d96e0; transform: translateY(-2px); color: #fff; box-shadow: 0 8px 28px rgba(63,169,245,.48); }
.fp-btn-ghost {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,.1); color: #fff; font-family: var(--F);
    font-size: 15px; font-weight: 700;
    padding: 13px 26px; border-radius: 50px; text-decoration: none;
    border: 2px solid rgba(255,255,255,.28); transition: var(--t);
}
.fp-btn-ghost:hover { background: rgba(255,255,255,.18); border-color: rgba(255,255,255,.55); color: #fff; }
.fp-btn-b {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--B); color: #fff; font-family: var(--F);
    font-size: 15px; font-weight: 800;
    padding: 13px 28px; border-radius: 50px; text-decoration: none;
    box-shadow: 0 4px 18px rgba(0,73,127,.30); transition: var(--t);
}
.fp-btn-b:hover { background: #003a66; transform: translateY(-2px); color: #fff; box-shadow: 0 8px 28px rgba(0,73,127,.40); }
.fp-btn-outline {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,.1); color: #fff; font-family: var(--F);
    font-size: 15px; font-weight: 700;
    padding: 13px 26px; border-radius: 50px; text-decoration: none;
    border: 2px solid rgba(255,255,255,.3); transition: var(--t);
}
.fp-btn-outline:hover { background: rgba(255,255,255,.18); border-color: rgba(255,255,255,.6); color: #fff; }

/* ── FAQ ── */
.fp-faq-list { display: flex; flex-direction: column; gap: 8px; max-width: 820px; margin: 0 auto; }
.fp-faq-item {
    background: #fff; border: 1.5px solid var(--L); border-radius: 14px;
    overflow: hidden; transition: border-color .2s, box-shadow .2s;
}
.fp-faq-item:hover { border-color: rgba(63,169,245,.35); box-shadow: 0 4px 16px rgba(0,73,127,.08); }
.fp-faq-btn {
    width: 100%; display: flex; justify-content: space-between; align-items: center;
    padding: 18px 22px; background: none; border: none;
    font-family: var(--F); font-size: 15px; font-weight: 700; color: var(--D);
    cursor: pointer; gap: 12px; text-align: left;
}
.fp-faq-btn:hover { background: #f5f8fc; }
.fp-faq-btn.open { color: var(--B); }
.fp-faq-arrow {
    width: 26px; height: 26px; border-radius: 50%;
    background: rgba(63,169,245,.1); color: var(--S);
    font-size: 16px; font-weight: 900;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; transition: transform .25s, background .2s;
}
.fp-faq-btn.open .fp-faq-arrow { transform: rotate(45deg); background: var(--S); color: #fff; }
.fp-faq-body { display: none; padding: 0 22px 18px; font-family: var(--F); font-size: 14px; color: var(--M); line-height: 1.8; }
.fp-faq-body.open { display: block; }

/* Scroll reveal */
.fp-anim { opacity: 0; transform: translateY(22px); transition: all .55s cubic-bezier(.16,1,.3,1); }
.fp-anim.visible { opacity: 1; transform: none; }

/* ── Responsive ── */
@media (max-width: 992px) {
    .fp-hero-grid { grid-template-columns: 1fr; }
    .fp-hero-img-col { display: none; }
    .fp-steps-row { grid-template-columns: repeat(2,1fr); }
    .fp-steps-row::before { display: none; }
    .fp-phase-grid { grid-template-columns: 1fr; gap: 36px; }
    .fp-phase-grid--rev { direction: ltr; }
}
@media (max-width: 600px) {
    .fp-steps-row { grid-template-columns: 1fr 1fr; }
    .fp-overview, .fp-phase, .fp-cta { padding: 64px 0; }
    .fp-hero { padding: 64px 0 52px; }
    .fp-phase-img-wrap img { height: 260px; }
}
</style>

{# ══ 1. HERO ═══════════════════════════════════════════════════════════════ #}
<section class="fp-hero">
    <div class="fp-wrap">
        <div class="fp-hero-grid">

            {# — Texte — #}
            <div class="fp-anim">
                <div class="fp-hero-pill">
                    <i class="ph-bold ph-magnifying-glass"></i> {{ 'fp_pg.hero_pill'|trans }}
                </div>
                <h1>
                    {{ 'fp_pg.hero_h1_line1'|trans }}<br>
                    {{ 'fp_pg.hero_h1_line2'|trans }}<br>
                    <span class="hl-sky">{{ 'fp_pg.hero_h1_span'|trans }}</span>
