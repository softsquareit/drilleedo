{# ══ 3. LES 4 ÉTAPES ══════════════════════════════════════════════════════ #}
<section class="fp-overview">
    <div class="fp-wrap">

        <div class="fp-section-hd fp-anim">
            <div class="fp-section-pill">
                <i class="ph-bold ph-list-numbers"></i> Comment ça fonctionne
            </div>
            <h2 class="fp-section-title">Trouvez votre pro en <span>4 étapes simples</span></h2>
            <p class="fp-section-sub">Cherchez, comparez et contactez le bon professionnel — en quelques minutes, gratuitement et sans engagement.</p>
        </div>

        <div class="fp-steps-row fp-anim">

            <div class="fp-ovr-step">
                <div class="fp-ovr-circle fp-ovr-circle--1">
                    <i class="ph-bold ph-user-plus"></i>
                    <span class="fp-ovr-num">1</span>
                </div>
                <div class="fp-ovr-card">
                    <div class="fp-ovr-title">Créez votre profil</div>
                    <p class="fp-ovr-text">Inscrivez-vous en quelques minutes — et accédez à toutes les fonctionnalités de Drilleedo.</p>
                </div>
            </div>

            <div class="fp-ovr-step">
                <div class="fp-ovr-circle fp-ovr-circle--2">
                    <i class="ph-bold ph-funnel"></i>
                    <span class="fp-ovr-num">2</span>
                </div>
                <div class="fp-ovr-card">
                    <div class="fp-ovr-title">Recherchez par catégorie et région</div>
                    <p class="fp-ovr-text">Utilisez nos filtres intelligents pour cibler exactement le professionnel dont vous avez besoin — au bon endroit, au bon moment.</p>
                </div>
