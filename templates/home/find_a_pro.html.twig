            </div>

            {# — Image — #}
            <div class="fp-hero-img-col fp-anim" style="transition-delay:.1s;">
                <img class="fp-hero-img"
                     src="{{ asset('assets/drilleedo/images/stock/find-a-pro_b.png') }}"
                     alt="{{ 'fp_pg.hero_img_alt'|trans }}">
                <div class="fp-hero-badge">
                    <i class="ph-bold ph-shield-check"></i>
                    <div class="fp-hero-badge__text">{{ 'fp_pg.hero_badge_text'|trans }}</div>
