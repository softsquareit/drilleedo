{# ══ 3. LES 4 ÉTAPES ══════════════════════════════════════════════════════ #}
<section class="fp-overview">
    <div class="fp-wrap">

        <div class="fp-section-hd fp-anim">
            <div class="fp-section-pill">
                <i class="ph-bold ph-list-numbers"></i> {{ 'fp_pg.overview_pill'|trans }}
            </div>
            <h2 class="fp-section-title">{{ 'fp_pg.overview_h2'|trans }} <span>{{ 'fp_pg.overview_h2_span'|trans }}</span></h2>
            <p class="fp-section-sub">{{ 'fp_pg.overview_sub'|trans }}</p>
        </div>

        <div class="fp-steps-row fp-anim">

            <div class="fp-ovr-step">
                <div class="fp-ovr-circle fp-ovr-circle--1">
                    <i class="ph-bold ph-user-plus"></i>
                    <span class="fp-ovr-num">{{ 'fp_pg.step1_num'|trans }}</span>
                </div>
                <div class="fp-ovr-card">
                    <div class="fp-ovr-title">{{ 'fp_pg.step1_title'|trans }}</div>
                    <p class="fp-ovr-text">{{ 'fp_pg.step1_desc'|trans }}</p>
                </div>
            </div>

            <div class="fp-ovr-step">
                <div class="fp-ovr-circle fp-ovr-circle--2">
                    <i class="ph-bold ph-funnel"></i>
                    <span class="fp-ovr-num">{{ 'fp_pg.step2_num'|trans }}</span>
                </div>
                <div class="fp-ovr-card">
                    <div class="fp-ovr-title">{{ 'fp_pg.step2_title'|trans }}</div>
                    <p class="fp-ovr-text">{{ 'fp_pg.step2_desc'|trans }}</p>
                </div>
            </div>

            <div class="fp-ovr-step">
                <div class="fp-ovr-circle fp-ovr-circle--3">
                    <i class="ph-bold ph-scales"></i>
                    <span class="fp-ovr-num">{{ 'fp_pg.step3_num'|trans }}</span>
                </div>
                <div class="fp-ovr-card">
                    <div class="fp-ovr-title">{{ 'fp_pg.step3_title'|trans }}</div>
                    <p class="fp-ovr-text">{{ 'fp_pg.step3_desc'|trans }}</p>
                </div>
            </div>

            <div class="fp-ovr-step">
                <div class="fp-ovr-circle fp-ovr-circle--4">
                    <i class="ph-bold ph-chat-circle-dots"></i>
                    <span class="fp-ovr-num">{{ 'fp_pg.step4_num'|trans }}</span>
                </div>
