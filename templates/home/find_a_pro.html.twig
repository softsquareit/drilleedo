{% extends 'base.html.twig' %}

{% block title %}Trouver un professionnel | Drilleedo Canada{% endblock %}
{% block meta_description %}Parcourez des professionnels vérifiés, comparez leurs profils et contactez directement l'entrepreneur qui correspond à votre projet. 100 % gratuit, sans engagement.{% endblock %}

{% block body %}
<main id="main-content">
<script src="https://unpkg.com/@phosphor-icons/web"></script>
<style>
/* ══ FIND-A-PRO — même charte que /how-it-works ═══════════════════════════
   #00497F · #3FA9F5 · #FF8A3D · #0C1825 · #4A6073
   ══════════════════════════════════════════════════════════════════════════ */
:root { --B:#00497F; --S:#3FA9F5; --O:#FF8A3D; --D:#0C1825; --M:#4A6073; }

.fp-wrap { max-width:1140px; margin:0 auto; padding:0 24px; }

/* ── Hero ── */
.fp-hero {
    background: linear-gradient(125deg, #003660 0%, #00497F 55%, #0a6eab 100%);
    padding: 88px 0 76px;
    position: relative; overflow: hidden;
}
.fp-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,.035) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
}
.fp-hero::after {
    content: '';
    position: absolute; left: -80px; bottom: -80px;
    width: 480px; height: 480px; border-radius: 50%;
    background: radial-gradient(circle, rgba(63,169,245,.18) 0%, transparent 68%);
    pointer-events: none;
}
.fp-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px; align-items: center;
    position: relative; z-index: 2;
}
.fp-hero-pill {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,255,255,.1); color: rgba(255,255,255,.9);
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 999px; padding: 6px 16px;
    font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    margin-bottom: 20px;
}
.fp-hero h1 {
    font-size: clamp(28px,4.2vw,52px);
    font-weight: 900; color: #fff; margin: 0 0 6px;
    line-height: 1.08; letter-spacing: -.025em;
    text-shadow: 0 4px 28px rgba(0,0,0,.28);
}
.fp-hero h1 .hl-sky { color: #3FA9F5; }
.fp-hero__sub {
    font-size: 17px; color: rgba(255,255,255,.75);
    max-width: 500px; line-height: 1.75; margin: 16px 0 28px;
}
.fp-hero-trust {
    display: flex; gap: 18px; flex-wrap: wrap; margin-bottom: 32px;
}
.fp-hero-trust span {
    display: inline-flex; align-items: center; gap: 6px;
    color: rgba(255,255,255,.8); font-size: 13px; font-weight: 600;
}
.fp-hero-trust i { color: #3FA9F5; font-size: 15px; }
.fp-hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

/* image col */
.fp-hero-img-col { position: relative; }
.fp-hero-img {
    width: 100%; height: 430px; object-fit: cover;
    border-radius: 20px;
    box-shadow: 0 28px 64px rgba(0,0,0,.35);
    display: block;
}
.fp-hero-badge {
    position: absolute; bottom: 28px; right: -14px;
    background: #fff; color: #0C1825;
    padding: 12px 18px; border-radius: 14px;
    box-shadow: 0 8px 28px rgba(0,0,0,.15);
    display: flex; align-items: center; gap: 10px;
}
.fp-hero-badge i { color: #3FA9F5; font-size: 22px; }
.fp-hero-badge__text { font-size: 12px; font-weight: 800; line-height: 1.35; }
.fp-hero-badge2 {
    position: absolute; top: 24px; left: -18px;
    background: #FF8A3D; color: #fff;
    padding: 12px 18px; border-radius: 12px;
    box-shadow: 0 6px 22px rgba(255,138,61,.4);
}
.fp-hero-badge2__num { font-size: 22px; font-weight: 900; line-height: 1; display: block; }
.fp-hero-badge2__lbl { font-size: 10px; font-weight: 700; opacity: .9; text-transform: uppercase; letter-spacing: .05em; }

/* ── Avantages strip ── */
.fp-adv {
    background: #fff;
    padding: 60px 0 52px;
    border-bottom: 1px solid #e4ebf2;
}
.fp-adv__headline {
    text-align: center;
    font-size: clamp(22px, 3vw, 34px);
    font-weight: 900; color: #0C1825;
    letter-spacing: -.02em; margin: 0 0 8px;
}
.fp-adv__headline span { color: #3FA9F5; }
.fp-adv__sub {
    text-align: center; font-size: 15px; color: #4A6073;
    max-width: 500px; margin: 0 auto 40px; line-height: 1.65;
}
.fp-adv-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 1px; background: #e4ebf2;
    border: 1px solid #e4ebf2; border-radius: 16px; overflow: hidden;
    max-width: 960px; margin: 0 auto;
}
.fp-adv-cell {
    background: #fff; padding: 24px 20px; text-align: center;
    transition: background .2s;
}
.fp-adv-cell:hover { background: #f4f8ff; }
.fp-adv-cell__ico {
    width: 48px; height: 48px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; margin: 0 auto 12px;
}
.fp-adv-cell__title { font-size: 14px; font-weight: 800; color: #0C1825; margin: 0 0 4px; }
.fp-adv-cell__text  { font-size: 12px; color: #4A6073; margin: 0; line-height: 1.55; }

/* ── Steps overview ── */
.fp-overview {
    background: #f4f8ff;
    padding: 90px 0;
}
.fp-section-hd { text-align: center; margin-bottom: 56px; }
.fp-section-pill {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(63,169,245,.1); color: #3FA9F5;
    border: 1px solid rgba(63,169,245,.2);
    border-radius: 999px; padding: 6px 16px;
    font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    margin-bottom: 14px;
}
.fp-section-title {
    font-size: clamp(24px,3.5vw,36px);
    font-weight: 900; color: #0C1825; letter-spacing: -.02em;
    margin: 0 0 10px; line-height: 1.15;
}
.fp-section-title span { color: #00497F; }
.fp-section-sub {
    font-size: 15px; color: #4A6073;
    max-width: 500px; margin: 0 auto; line-height: 1.7;
}
/* Connected row */
.fp-steps-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    position: relative; gap: 12px;
}
.fp-steps-row::before {
    content: '';
    position: absolute;
    top: 31px;
    left: calc(12.5% + 8px);
    right: calc(12.5% + 8px);
    height: 0;
    border-top: 2px dashed rgba(63,169,245,.3);
    z-index: 0;
}
.fp-ovr-step {
    text-align: center; padding: 0 8px;
    position: relative; z-index: 1;
}
.fp-ovr-circle {
    width: 62px; height: 62px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 24px; margin: 0 auto 16px;
    position: relative; z-index: 2;
    box-shadow: 0 6px 20px rgba(0,0,0,.12);
}
.fp-ovr-circle--1 { background: linear-gradient(135deg, #00497F, #003a66); color: #fff; }
.fp-ovr-circle--2 { background: linear-gradient(135deg, #3FA9F5, #1e88e5); color: #fff; }
.fp-ovr-circle--3 { background: linear-gradient(135deg, #FF8A3D, #e05000); color: #fff; }
.fp-ovr-circle--4 { background: linear-gradient(135deg, #16a34a, #22c55e); color: #fff; }
.fp-ovr-num {
    position: absolute; top: -4px; right: -4px;
    width: 21px; height: 21px; border-radius: 50%;
    background: #fff; color: #0C1825;
    font-size: 10px; font-weight: 900;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 6px rgba(0,0,0,.1);
}
.fp-ovr-card {
    background: #fff; border-radius: 16px; padding: 20px 16px 22px;
    border: 1px solid #dde8f8;
    box-shadow: 0 2px 10px rgba(0,73,127,.06);
    transition: box-shadow .2s, transform .2s;
}
.fp-ovr-card:hover {
    box-shadow: 0 10px 30px rgba(0,73,127,.1);
    transform: translateY(-3px);
}
.fp-ovr-title { font-size: 14px; font-weight: 800; color: #0C1825; margin: 0 0 6px; }
.fp-ovr-text  { font-size: 12px; color: #4A6073; line-height: 1.6; margin: 0; }

/* ── Split Phases ── */
.fp-phase { padding: 88px 0; }
.fp-phase--alt { background: #fafbff; }
.fp-phase-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px; align-items: center;
}
.fp-phase-grid--rev { direction: rtl; }
.fp-phase-grid--rev > * { direction: ltr; }
.fp-phase-img-wrap {
    position: relative; border-radius: 20px; overflow: hidden;
    box-shadow: 0 18px 54px rgba(0,73,127,.14);
}
.fp-phase-img-wrap img {
    width: 100%; height: 380px; object-fit: cover; display: block;
}
.fp-phase-img-tag {
    position: absolute; bottom: 20px; right: 20px;
    background: rgba(12,24,37,.82); backdrop-filter: blur(10px);
    color: #fff; padding: 10px 16px; border-radius: 10px;
    font-size: 12px; font-weight: 700;
    display: flex; align-items: center; gap: 6px;
}
.fp-phase-img-tag i { color: #3FA9F5; }
.fp-phase-label {
    display: inline-flex; align-items: center; gap: 7px;
    border-radius: 999px; padding: 5px 14px;
    font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase; margin-bottom: 14px;
}
.fp-phase-step {
    font-size: 12px; font-weight: 700; color: rgba(0,0,0,.28);
    letter-spacing: .1em; text-transform: uppercase; margin-bottom: 6px;
}
.fp-phase-title {
    font-size: clamp(22px,2.8vw,32px);
    font-weight: 900; color: #0C1825;
    letter-spacing: -.02em; margin: 0 0 12px; line-height: 1.2;
}
.fp-phase-desc {
    font-size: 15px; color: #4A6073; line-height: 1.8; margin-bottom: 24px;
}
.fp-feat-list { list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-direction: column; gap: 14px; }
.fp-feat-item { display: flex; gap: 12px; align-items: flex-start; }
.fp-feat-ico {
    width: 40px; height: 40px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; flex-shrink: 0;
}
.fp-feat-item h4 { font-size: 14px; font-weight: 800; color: #0C1825; margin: 0 0 2px; }
.fp-feat-item p  { font-size: 13px; color: #4A6073; margin: 0; line-height: 1.55; }

/* ── CTA ── */
.fp-cta {
    background: linear-gradient(135deg, #0C1825 0%, #003660 100%);
    padding: 88px 0; text-align: center;
    position: relative; overflow: hidden;
}
.fp-cta::before {
    content: ''; position: absolute;
    left: -100px; top: -100px;
    width: 440px; height: 440px; border-radius: 50%;
    background: rgba(63,169,245,.08); pointer-events: none;
}
.fp-cta::after {
    content: ''; position: absolute;
    right: -60px; bottom: -60px;
    width: 300px; height: 300px; border-radius: 50%;
    background: rgba(255,138,61,.06); pointer-events: none;
}
.fp-cta__inner { position: relative; z-index: 2; }
.fp-cta-tag {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(63,169,245,.18); border: 1px solid rgba(63,169,245,.35);
    color: #3FA9F5; font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase;
    padding: 5px 14px; border-radius: 50px; margin-bottom: 18px;
}
.fp-cta h2 {
    font-size: clamp(26px,4vw,44px);
    font-weight: 900; color: #fff; margin: 0 0 12px;
    letter-spacing: -.02em; line-height: 1.15;
}
.fp-cta h2 span { color: #3FA9F5; }
.fp-cta__sub {
    font-size: 16px; color: rgba(255,255,255,.7);
    margin: 0 auto 36px; max-width: 460px; line-height: 1.7;
}
.fp-cta-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

/* ── Buttons ── */
.fp-btn-s {
    display: inline-flex; align-items: center; gap: 8px;
    background: #3FA9F5; color: #fff;
    font-size: 15px; font-weight: 800;
    padding: 14px 30px; border-radius: 8px; text-decoration: none;
    box-shadow: 0 4px 20px rgba(63,169,245,.4); transition: all .2s;
}
.fp-btn-s:hover { background: #2a95e0; transform: translateY(-2px); color: #fff; }
.fp-btn-ghost {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,.1); color: #fff;
    font-size: 15px; font-weight: 700;
    padding: 13px 24px; border-radius: 8px; text-decoration: none;
    border: 2px solid rgba(255,255,255,.25); transition: all .18s;
}
.fp-btn-ghost:hover { background: rgba(255,255,255,.18); border-color: rgba(255,255,255,.5); color: #fff; }
.fp-btn-b {
    display: inline-flex; align-items: center; gap: 8px;
    background: #00497F; color: #fff;
    font-size: 15px; font-weight: 800;
    padding: 13px 26px; border-radius: 8px; text-decoration: none;
    box-shadow: 0 4px 16px rgba(0,73,127,.3); transition: all .18s;
}
.fp-btn-b:hover { background: #003a66; transform: translateY(-2px); color: #fff; }
.fp-btn-outline {
    display: inline-flex; align-items: center; gap: 8px;
    background: transparent; color: #fff;
    font-size: 15px; font-weight: 700;
    padding: 13px 26px; border-radius: 8px; text-decoration: none;
    border: 2px solid rgba(255,255,255,.3); transition: all .18s;
}
.fp-btn-outline:hover { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.6); color: #fff; }

/* Scroll reveal */
.fp-anim { opacity: 0; transform: translateY(22px); transition: all .55s cubic-bezier(.16,1,.3,1); }
.fp-anim.visible { opacity: 1; transform: none; }

/* ── Responsive ── */
@media (max-width: 992px) {
    .fp-hero-grid { grid-template-columns: 1fr; }
    .fp-hero-img-col { display: none; }
    .fp-steps-row { grid-template-columns: repeat(2, 1fr); }
    .fp-steps-row::before { display: none; }
    .fp-adv-grid { grid-template-columns: repeat(2, 1fr); }
    .fp-phase-grid { grid-template-columns: 1fr; gap: 36px; }
    .fp-phase-grid--rev { direction: ltr; }
}
@media (max-width: 600px) {
    .fp-adv-grid { grid-template-columns: 1fr; }
    .fp-steps-row { grid-template-columns: 1fr 1fr; }
    .fp-overview, .fp-phase, .fp-cta, .fp-adv { padding: 60px 0; }
    .fp-hero { padding: 64px 0 52px; }
    .fp-phase-img-wrap img { height: 260px; }
}
</style>

{# ══ 1. HERO ═══════════════════════════════════════════════════════════════ #}
<section class="fp-hero">
    <div class="fp-wrap">
        <div class="fp-hero-grid">

            {# — Texte — #}
            <div class="fp-anim">
                <div class="fp-hero-pill">
                    <i class="ph-bold ph-magnifying-glass"></i> Je cherche un professionnel
                </div>
                <h1>
                    Trouvez l'entrepreneur<br>
                    <span class="hl-sky">fait pour votre projet</span>
                </h1>
                <p class="fp-hero__sub">
                    Parcourez des profils vérifiés, comparez les réalisations et les avis,
                    puis contactez directement le bon pro — gratuitement, à votre rythme.
                </p>
                <div class="fp-hero-trust">
                    <span><i class="ph-bold ph-user-check"></i> Profils vérifiés</span>
                    <span><i class="ph-bold ph-currency-dollar-simple"></i> 100 % gratuit</span>
                    <span><i class="ph-bold ph-hand-pointing"></i> Contact direct</span>
                </div>
                <div class="fp-hero-actions">
                    <a href="{{ path('professionals_list') }}" class="fp-btn-s">
                        Explorer les pros <i class="ph-bold ph-arrow-right"></i>
                    </a>
                    <a href="{{ path('app_register') }}" class="fp-btn-ghost">
                        Créer mon compte
                    </a>
                </div>
            </div>

            {# — Image — #}
            <div class="fp-hero-img-col fp-anim" style="transition-delay:.1s;">
                <img class="fp-hero-img"
                     src="{{ asset('assets/drilleedo/images/stock/about_canada_homes.jpg') }}"
                     alt="Trouver un professionnel de rénovation">
                <div class="fp-hero-badge">
                    <i class="ph-bold ph-shield-check"></i>
                    <div class="fp-hero-badge__text">Pros vérifiés<br>et évalués</div>
                </div>
                <div class="fp-hero-badge2">
                    <span class="fp-hero-badge2__num">GRATUIT</span>
                    <span class="fp-hero-badge2__lbl">Sans engagement</span>
                </div>
            </div>

        </div>
    </div>
</section>

{# ══ 2. VOS AVANTAGES ══════════════════════════════════════════════════════ #}
<section class="fp-adv fp-anim">
    <div class="fp-wrap">
        <h2 class="fp-adv__headline">Parcourez, comparez, choisissez.<br><span>Librement.</span></h2>
        <p class="fp-adv__sub">Aucun engagement, aucun frais. Vous avancez à votre rythme et prenez vos décisions en toute confiance.</p>
        <div class="fp-adv-grid">
            <div class="fp-adv-cell">
                <div class="fp-adv-cell__ico" style="background:rgba(0,73,127,.08);color:#00497F;">
                    <i class="ph-bold ph-sliders"></i>
                </div>
                <div class="fp-adv-cell__title">Choix libre et personnalisé</div>
                <p class="fp-adv-cell__text">Filtrez par catégorie, ville et spécialité pour trouver exactement ce dont vous avez besoin.</p>
            </div>
            <div class="fp-adv-cell">
                <div class="fp-adv-cell__ico" style="background:rgba(63,169,245,.1);color:#3FA9F5;">
                    <i class="ph-bold ph-user-check"></i>
                </div>
                <div class="fp-adv-cell__title">Profils vérifiés et détaillés</div>
                <p class="fp-adv-cell__text">Accédez aux réalisations, compétences et coordonnées de chaque professionnel.</p>
            </div>
            <div class="fp-adv-cell">
                <div class="fp-adv-cell__ico" style="background:rgba(255,138,61,.1);color:#FF8A3D;">
                    <i class="ph-bold ph-star"></i>
                </div>
                <div class="fp-adv-cell__title">Avis et transparence</div>
                <p class="fp-adv-cell__text">Lisez les avis d'autres clients pour choisir en toute confiance.</p>
            </div>
            <div class="fp-adv-cell">
                <div class="fp-adv-cell__ico" style="background:rgba(22,163,74,.1);color:#16a34a;">
                    <i class="ph-bold ph-lightning"></i>
                </div>
                <div class="fp-adv-cell__title">Contact rapide et direct</div>
                <p class="fp-adv-cell__text">Entrez en contact en un clic — sans intermédiaire, sans délai.</p>
            </div>
        </div>
    </div>
</section>

{# ══ 3. LES 4 ÉTAPES ══════════════════════════════════════════════════════ #}
<section class="fp-overview">
    <div class="fp-wrap">

        <div class="fp-section-hd fp-anim">
            <div class="fp-section-pill">
                <i class="ph-bold ph-list-numbers"></i> Comment ça fonctionne
            </div>
            <h2 class="fp-section-title">Trouvez votre pro en <span>4 étapes</span></h2>
            <p class="fp-section-sub">Cherchez, comparez et contactez le bon professionnel — en quelques minutes, sans rien débourser.</p>
        </div>

        <div class="fp-steps-row fp-anim">

            <div class="fp-ovr-step">
                <div class="fp-ovr-circle fp-ovr-circle--1">
                    <i class="ph-bold ph-user-plus"></i>
                    <span class="fp-ovr-num">1</span>
                </div>
                <div class="fp-ovr-card">
                    <div class="fp-ovr-title">Créez votre profil</div>
                    <p class="fp-ovr-text">Inscrivez-vous pour sauvegarder vos recherches, suivre vos échanges et gérer vos projets.</p>
                </div>
            </div>

            <div class="fp-ovr-step">
                <div class="fp-ovr-circle fp-ovr-circle--2">
                    <i class="ph-bold ph-funnel"></i>
                    <span class="fp-ovr-num">2</span>
                </div>
                <div class="fp-ovr-card">
                    <div class="fp-ovr-title">Recherchez par catégorie</div>
                    <p class="fp-ovr-text">Filtrez les pros par type de travaux, ville et disponibilité pour cibler les bons profils.</p>
                </div>
            </div>

            <div class="fp-ovr-step">
                <div class="fp-ovr-circle fp-ovr-circle--3">
                    <i class="ph-bold ph-scales"></i>
                    <span class="fp-ovr-num">3</span>
                </div>
                <div class="fp-ovr-card">
                    <div class="fp-ovr-title">Comparez les profils</div>
                    <p class="fp-ovr-text">Services, réalisations, avis clients — évaluez plusieurs pros avant de décider.</p>
                </div>
            </div>

            <div class="fp-ovr-step">
                <div class="fp-ovr-circle fp-ovr-circle--4">
                    <i class="ph-bold ph-chat-circle-dots"></i>
                    <span class="fp-ovr-num">4</span>
                </div>
                <div class="fp-ovr-card">
                    <div class="fp-ovr-title">Contactez directement</div>
                    <p class="fp-ovr-text">Entrez en contact avec le pro choisi et discutez directement de votre projet.</p>
                </div>
            </div>

        </div>
    </div>
</section>

{# ══ 4. ÉTAPE 1 + 2 — CHERCHEZ ET FILTREZ ══════════════════════════════════ #}
<section class="fp-phase fp-anim">
    <div class="fp-wrap">
        <div class="fp-phase-grid">

            <div>
                <div class="fp-phase-step">Étapes 1 &amp; 2</div>
                <div class="fp-phase-label" style="background:rgba(0,73,127,.08);color:#00497F;border:1px solid rgba(0,73,127,.15);">
                    <i class="ph-bold ph-funnel"></i> Cherchez et filtrez
