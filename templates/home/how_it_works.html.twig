<main id="main-content">
<style>
/* ══ UNIFIED HOW IT WORKS PAGE ═════════════════════════════════════════════
   Design charter based on Drilleedo Pro & Smart Ideas.
   ═════════════════════════════════════════════════════════════════════════ */

/* ── 1. Hero ── */
.hiw-hero {
  min-height: 480px;
  background: linear-gradient(135deg, #0d2151 0%, #1a3a6b 50%, #00509e 100%);
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  text-align: center;
  padding: 80px 0;
}

.hiw-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}

.hiw-hero::after {
  content: '';
  position: absolute;
  left: 50%;
  top: -150px;
  transform: translateX(-50%);
  width: 800px;
  height: 800px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232,80,26,0.15) 0%, transparent 70%);
  pointer-events: none;
}

.hiw-hero__inner {
  position: relative;
  z-index: 2;
  max-width: 800px;
  margin: 0 auto;
}

.hiw-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.12);
  color: #fff;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 999px;
  padding: 8px 20px;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 24px;
}

.hiw-eyebrow i { color: #f97316; }

.hiw-hero__title {
  font-size: clamp(36px, 5vw, 64px);
  font-weight: 900;
  color: #fff;
  margin: 0 0 20px;
  line-height: 1.15;
  letter-spacing: -0.02em;
}

.hiw-hero__title span {
  background: linear-gradient(90deg, #f97316, #e8501a);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hiw-hero__sub {
  font-size: 18px;
  color: rgba(255,255,255,0.8);
  line-height: 1.6;
  margin-bottom: 36px;
  max-width: 640px;
  margin-left: auto;
  margin-right: auto;
}

.hiw-hero__actions {
  display: flex;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
}

.hiw-btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #e8501a;
  color: #fff;
  font-size: 16px;
  font-weight: 800;
  padding: 16px 36px;
  border-radius: 12px;
  text-decoration: none;
  box-shadow: 0 8px 24px rgba(232,80,26,0.3);
  transition: transform 0.2s, background 0.2s;
}

.hiw-btn-primary:hover {
  background: #c43d10;
  transform: translateY(-3px);
  color: #fff;
}

/* ── 2. Sticky Navigation ── */
.hiw-nav {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid #e2e8f0;
  box-shadow: 0 4px 20px rgba(0,0,0,0.03);
}

.hiw-nav__list {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12px;
  padding: 16px 20px;
  margin: 0;
  list-style: none;
  overflow-x: auto;
}

.hiw-nav__list::-webkit-scrollbar { display: none; }

.hiw-nav__link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 24px;
  border-radius: 999px;
  font-size: 14px;
  font-weight: 700;
  color: #64748b;
  text-decoration: none;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.hiw-nav__link:hover,
.hiw-nav__link.active {
  background: #0d2151;
  color: #fff;
  border-color: #0d2151;
}

/* ── 3. General Section Styling ── */
.hiw-section {
  padding: 100px 0;
  position: relative;
}

.hiw-section--alt {
  background: linear-gradient(170deg, #f8fafc 0%, #f1f5f9 100%);
}

.hiw-section-header {
  text-align: center;
  margin-bottom: 60px;
}

.hiw-section-label {
  display: inline-block;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #e8501a;
  background: rgba(232,80,26,0.1);
  padding: 6px 16px;
  border-radius: 999px;
  margin-bottom: 16px;
}

.hiw-section-title {
  font-size: clamp(30px, 4vw, 42px);
  font-weight: 900;
  color: #0d2151;
  margin: 0 0 16px;
  line-height: 1.2;
}

.hiw-section-desc {
  font-size: 18px;
  color: #64748b;
  max-width: 600px;
  margin: 0 auto;
  line-height: 1.6;
}

/* ── 4. Process Grid (Overview) ── */
.hiw-process {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
  position: relative;
}

.hiw-process::before {
  content: '';
  position: absolute;
  top: 45px;
  left: 12%;
  right: 12%;
  height: 3px;
  background: repeating-linear-gradient(90deg, #cbd5e1 0, #cbd5e1 10px, transparent 10px, transparent 20px);
  z-index: 0;
}

.hiw-step-card {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  padding: 40px 24px;
  text-align: center;
  position: relative;
  z-index: 1;
  box-shadow: 0 10px 30px rgba(13,33,81,0.03);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.hiw-step-card:hover {
  transform: translateY(-10px);
  border-color: #bfdbfe;
  box-shadow: 0 20px 40px rgba(13,33,81,0.08);
}

.hiw-step-icon {
  width: 90px;
  height: 90px;
  border-radius: 50%;
  margin: 0 auto 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.1);
}

.hiw-step-card:nth-child(1) .hiw-step-icon { background: linear-gradient(135deg, #0d2151, #1a3a6b); color:#fff; }
.hiw-step-card:nth-child(2) .hiw-step-icon { background: linear-gradient(135deg, #00509e, #3b82f6); color:#fff; }
.hiw-step-card:nth-child(3) .hiw-step-icon { background: linear-gradient(135deg, #e8501a, #f97316); color:#fff; }
.hiw-step-card:nth-child(4) .hiw-step-icon { background: linear-gradient(135deg, #16a34a, #22c55e); color:#fff; }

.hiw-step-title {
  font-size: 20px;
  font-weight: 800;
  color: #1e293b;
  margin-bottom: 12px;
}

.hiw-step-text {
  font-size: 15px;
  color: #64748b;
  line-height: 1.6;
}

/* ── 5. Split Sections ── */
.hiw-split {
  display: flex;
  align-items: center;
  gap: 60px;
}

.hiw-split--reverse {
  flex-direction: row-reverse;
}

.hiw-split__content { flex: 1; }
.hiw-split__image {
  flex: 1;
  position: relative;
}

.hiw-split__image img {
  width: 100%;
  border-radius: 24px;
  box-shadow: 0 20px 50px rgba(13,33,81,0.15);
}

.hiw-split__image::before {
  content: '';
  position: absolute;
  top: -20px;
  left: -20px;
  width: 100%;
  height: 100%;
  border-radius: 24px;
  background: #f1f5f9;
  z-index: -1;
}

.hiw-split--reverse .hiw-split__image::before {
  left: auto;
  right: -20px;
}

.hiw-feature-list {
  list-style: none;
  padding: 0;
  margin: 30px 0;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.hiw-feature-item {
  display: flex;
  gap: 16px;
}

.hiw-feature-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: #e8f4fd;
  color: #00509e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
}

.hiw-feature-text h4 {
  font-size: 18px;
  font-weight: 800;
  color: #0d2151;
  margin: 0 0 6px;
}

.hiw-feature-text p {
  font-size: 15px;
  color: #64748b;
  margin: 0;
  line-height: 1.6;
}

/* ── Responsive ── */
@media (max-width: 1024px) {
  .hiw-process { grid-template-columns: repeat(2, 1fr); gap: 40px; }
  .hiw-process::before { display: none; }
  .hiw-split { flex-direction: column; text-align: center; gap: 40px; }
  .hiw-split--reverse { flex-direction: column; }
  .hiw-feature-item { text-align: left; }
  .hiw-split__image::before { display: none; }
}

@media (max-width: 540px) {
  .hiw-process { grid-template-columns: 1fr; }
  .hiw-hero { padding: 60px 0; }
  .hiw-section { padding: 60px 0; }
  .hiw-btn-primary { width: 100%; justify-content: center; }
}

html { scroll-behavior: smooth; }
</style>

