{% extends 'base.html.twig' %}

{% block title %}Comment ça marche | Drilleedo Canada{% endblock %}
{% block meta_description %}Soumettez votre projet de rénovation 100 % gratuitement et recevez des offres de professionnels vérifiés. Simple, rapide, sans engagement.{% endblock %}

{% block body %}
<main id="main-content">
<script src="https://unpkg.com/@phosphor-icons/web"></script>
<style>
/* ══ HOW IT WORKS ══════════════════════════════════════════════════════════
   Charte : #00497F · #3FA9F5 · #FF8A3D · #0C1825 · #4A6073
   ══════════════════════════════════════════════════════════════════════════ */
:root { --B:#00497F; --S:#3FA9F5; --O:#FF8A3D; --D:#0C1825; --M:#4A6073; }

.hw-wrap { max-width:1140px; margin:0 auto; padding:0 24px; }

/* ────────────────────────────────────────────────
   1. HERO
   ──────────────────────────────────────────────── */
.hw-hero {
    background: linear-gradient(125deg, #0C1825 0%, #00497F 60%, #003660 100%);
    padding: 88px 0 76px;
    position: relative; overflow: hidden;
}
.hw-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,.035) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
}
.hw-hero::after {
    content: '';
    position: absolute; right: -100px; top: -100px;
    width: 520px; height: 520px; border-radius: 50%;
    background: radial-gradient(circle, rgba(255,138,61,.14) 0%, transparent 68%);
    pointer-events: none;
}
.hw-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px; align-items: center;
    position: relative; z-index: 2;
}
/* text col */
.hw-hero-pill {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,255,255,.1); color: rgba(255,255,255,.9);
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 999px; padding: 6px 16px;
    font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    margin-bottom: 20px;
}
.hw-hero h1 {
    font-size: clamp(28px,4.2vw,52px);
    font-weight: 900; color: #fff; margin: 0 0 6px;
    line-height: 1.08; letter-spacing: -.025em;
    text-shadow: 0 4px 28px rgba(0,0,0,.3);
}
.hw-hero h1 .hl-free {
    display: inline-block;
    color: #FF8A3D;
}
.hw-hero__sub {
    font-size: 17px; color: rgba(255,255,255,.75);
    max-width: 500px; line-height: 1.75; margin: 16px 0 28px;
}
.hw-hero-trust {
    display: flex; gap: 18px; flex-wrap: wrap; margin-bottom: 32px;
}
.hw-hero-trust span {
    display: inline-flex; align-items: center; gap: 6px;
    color: rgba(255,255,255,.8); font-size: 13px; font-weight: 600;
}
.hw-hero-trust i { color: #FF8A3D; font-size: 15px; }
.hw-hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

/* image col */
.hw-hero-img-col { position: relative; }
.hw-hero-img {
    width: 100%; height: 430px; object-fit: cover;
    border-radius: 20px;
    box-shadow: 0 28px 64px rgba(0,0,0,.35);
    display: block;
}
.hw-hero-badge {
    position: absolute; bottom: 28px; left: -18px;
    background: #FF8A3D; color: #fff;
    padding: 14px 22px; border-radius: 14px;
    box-shadow: 0 8px 28px rgba(255,138,61,.45);
}
.hw-hero-badge__num {
    font-size: 26px; font-weight: 900; line-height: 1;
    display: block;
}
.hw-hero-badge__lbl {
    font-size: 11px; font-weight: 700; opacity: .9;
    text-transform: uppercase; letter-spacing: .05em;
}
.hw-hero-badge2 {
    position: absolute; top: 28px; right: -14px;
    background: #fff; color: #0C1825;
    padding: 10px 16px; border-radius: 12px;
    box-shadow: 0 6px 24px rgba(0,0,0,.15);
    display: flex; align-items: center; gap: 8px;
}
.hw-hero-badge2 i { color: #FF8A3D; font-size: 20px; }
.hw-hero-badge2__text { font-size: 12px; font-weight: 800; line-height: 1.3; }

/* ────────────────────────────────────────────────
   2. GRATUIT STRIP
   ──────────────────────────────────────────────── */
.hw-free {
    background: #fff;
    padding: 60px 0 52px;
    border-bottom: 1px solid #e4ebf2;
}
.hw-free__headline {
    text-align: center;
    font-size: clamp(24px, 3.5vw, 38px);
    font-weight: 900; color: #0C1825;
    letter-spacing: -.02em; margin: 0 0 8px;
}
.hw-free__headline span { color: #FF8A3D; }
.hw-free__sub {
    text-align: center; font-size: 15px; color: #4A6073;
    max-width: 480px; margin: 0 auto 40px; line-height: 1.65;
}
.hw-free-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: #e4ebf2;
    border: 1px solid #e4ebf2; border-radius: 16px; overflow: hidden;
    max-width: 860px; margin: 0 auto;
}
.hw-free-cell {
    background: #fff; padding: 28px 24px; text-align: center;
    transition: background .2s;
}
.hw-free-cell:hover { background: #f8faff; }
.hw-free-cell__ico {
    width: 52px; height: 52px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 22px; margin: 0 auto 14px;
}
.hw-free-cell__title { font-size: 15px; font-weight: 800; color: #0C1825; margin: 0 0 5px; }
.hw-free-cell__text  { font-size: 13px; color: #4A6073; margin: 0; line-height: 1.6; }

/* ────────────────────────────────────────────────
   3. 4 ÉTAPES — OVERVIEW
   ──────────────────────────────────────────────── */
.hw-overview {
    background: #f4f8ff;
    padding: 90px 0;
}
.hw-section-hd { text-align: center; margin-bottom: 56px; }
.hw-section-pill {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,138,61,.1); color: #FF8A3D;
    border: 1px solid rgba(255,138,61,.2);
    border-radius: 999px; padding: 6px 16px;
    font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    margin-bottom: 14px;
}
.hw-section-title {
    font-size: clamp(24px,3.5vw,36px);
    font-weight: 900; color: #0C1825; letter-spacing: -.02em;
    margin: 0 0 10px; line-height: 1.15;
}
.hw-section-title span { color: #00497F; }
.hw-section-sub {
    font-size: 15px; color: #4A6073;
    max-width: 500px; margin: 0 auto; line-height: 1.7;
}

/* Connected cards row */
.hw-steps-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    position: relative;
    gap: 12px;
}
.hw-steps-row::before {
    content: '';
    position: absolute;
    top: 31px;
    left: calc(12.5% + 8px);
    right: calc(12.5% + 8px);
    height: 0;
    border-top: 2px dashed rgba(0,73,127,.22);
    z-index: 0;
}
.hw-ovr-step {
    text-align: center;
    padding: 0 8px;
    position: relative; z-index: 1;
}
.hw-ovr-circle {
    width: 62px; height: 62px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 24px; margin: 0 auto 16px;
    position: relative; z-index: 2;
    box-shadow: 0 6px 20px rgba(0,0,0,.12);
}
.hw-ovr-circle--1 { background: linear-gradient(135deg, #00497F, #003a66); color: #fff; }
.hw-ovr-circle--2 { background: linear-gradient(135deg, #3FA9F5, #1e88e5); color: #fff; }
.hw-ovr-circle--3 { background: linear-gradient(135deg, #FF8A3D, #e05000); color: #fff; }
.hw-ovr-circle--4 { background: linear-gradient(135deg, #16a34a, #22c55e); color: #fff; }
.hw-ovr-num {
    position: absolute; top: -4px; right: -4px;
    width: 21px; height: 21px; border-radius: 50%;
    background: #fff; color: #0C1825;
    font-size: 10px; font-weight: 900;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 6px rgba(0,0,0,.1);
}
.hw-ovr-card {
    background: #fff; border-radius: 16px; padding: 20px 16px 22px;
    border: 1px solid #dde8f8;
    box-shadow: 0 2px 10px rgba(0,73,127,.06);
    transition: box-shadow .2s, transform .2s;
    margin-top: 0;
}
.hw-ovr-card:hover {
    box-shadow: 0 10px 30px rgba(0,73,127,.1);
    transform: translateY(-3px);
}
.hw-ovr-title { font-size: 14px; font-weight: 800; color: #0C1825; margin: 0 0 6px; }
.hw-ovr-text  { font-size: 12px; color: #4A6073; line-height: 1.6; margin: 0; }

/* ────────────────────────────────────────────────
   4. SPLIT PHASES
   ──────────────────────────────────────────────── */
.hw-phase { padding: 88px 0; }
.hw-phase--alt { background: #fafbff; }
.hw-phase-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px; align-items: center;
}
.hw-phase-grid--rev { direction: rtl; }
.hw-phase-grid--rev > * { direction: ltr; }

/* image */
.hw-phase-img-wrap {
    position: relative; border-radius: 20px; overflow: hidden;
    box-shadow: 0 18px 54px rgba(0,73,127,.14);
}
.hw-phase-img-wrap img {
    width: 100%; height: 380px; object-fit: cover; display: block;
}
.hw-phase-img-tag {
    position: absolute; bottom: 20px; right: 20px;
    background: rgba(12,24,37,.82); backdrop-filter: blur(10px);
    color: #fff; padding: 10px 16px; border-radius: 10px;
    font-size: 12px; font-weight: 700;
    display: flex; align-items: center; gap: 6px;
}
.hw-phase-img-tag i { color: #FF8A3D; }

/* text */
.hw-phase-label {
    display: inline-flex; align-items: center; gap: 7px;
    border-radius: 999px; padding: 5px 14px;
    font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase; margin-bottom: 14px;
}
.hw-phase-step {
    font-size: 12px; font-weight: 700; color: rgba(0,0,0,.3);
    letter-spacing: .1em; text-transform: uppercase; margin-bottom: 6px;
}
.hw-phase-title {
    font-size: clamp(22px,2.8vw,32px);
    font-weight: 900; color: #0C1825;
    letter-spacing: -.02em; margin: 0 0 12px; line-height: 1.2;
}
.hw-phase-desc {
    font-size: 15px; color: #4A6073; line-height: 1.8; margin-bottom: 24px;
}
.hw-feat-list { list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-direction: column; gap: 14px; }
.hw-feat-item { display: flex; gap: 12px; align-items: flex-start; }
.hw-feat-ico {
    width: 40px; height: 40px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; flex-shrink: 0;
}
.hw-feat-item h4 { font-size: 14px; font-weight: 800; color: #0C1825; margin: 0 0 2px; }
.hw-feat-item p  { font-size: 13px; color: #4A6073; margin: 0; line-height: 1.55; }

/* ────────────────────────────────────────────────
   5. CTA FINAL
   ──────────────────────────────────────────────── */
.hw-cta {
    background: linear-gradient(135deg, #0C1825 0%, #003660 100%);
    padding: 88px 0; text-align: center;
    position: relative; overflow: hidden;
}
.hw-cta::before {
    content: ''; position: absolute;
    right: -100px; bottom: -100px;
    width: 440px; height: 440px; border-radius: 50%;
    background: rgba(255,138,61,.08); pointer-events: none;
}
.hw-cta::after {
    content: ''; position: absolute;
    left: -60px; top: -60px;
    width: 280px; height: 280px; border-radius: 50%;
    background: rgba(63,169,245,.06); pointer-events: none;
}
.hw-cta__inner { position: relative; z-index: 2; }
.hw-cta-tag {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,138,61,.18); border: 1px solid rgba(255,138,61,.35);
    color: #FF8A3D; font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase;
    padding: 5px 14px; border-radius: 50px; margin-bottom: 18px;
}
.hw-cta h2 {
    font-size: clamp(26px,4vw,44px);
    font-weight: 900; color: #fff; margin: 0 0 12px;
    letter-spacing: -.02em; line-height: 1.15;
}
.hw-cta h2 span { color: #FF8A3D; }
.hw-cta__sub {
    font-size: 16px; color: rgba(255,255,255,.7);
    margin: 0 auto 36px; max-width: 460px; line-height: 1.7;
}
.hw-cta-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

/* ── Buttons ── */
.hw-btn-o {
    display: inline-flex; align-items: center; gap: 8px;
    background: #FF8A3D; color: #fff;
    font-size: 15px; font-weight: 800;
    padding: 14px 30px; border-radius: 8px; text-decoration: none;
    box-shadow: 0 4px 20px rgba(255,138,61,.4); transition: all .2s;
}
.hw-btn-o:hover { background: #e87830; transform: translateY(-2px); color: #fff; }
.hw-btn-ghost {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,.1); color: #fff;
    font-size: 15px; font-weight: 700;
    padding: 13px 24px; border-radius: 8px; text-decoration: none;
    border: 2px solid rgba(255,255,255,.25); transition: all .18s;
}
.hw-btn-ghost:hover { background: rgba(255,255,255,.18); border-color: rgba(255,255,255,.5); color: #fff; }
.hw-btn-outline {
    display: inline-flex; align-items: center; gap: 8px;
    background: transparent; color: #fff;
    font-size: 15px; font-weight: 700;
    padding: 13px 26px; border-radius: 8px; text-decoration: none;
    border: 2px solid rgba(255,255,255,.3); transition: all .18s;
}
.hw-btn-outline:hover { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.6); color: #fff; }
.hw-btn-b {
    display: inline-flex; align-items: center; gap: 8px;
    background: #00497F; color: #fff;
    font-size: 15px; font-weight: 800;
    padding: 13px 26px; border-radius: 8px; text-decoration: none;
    box-shadow: 0 4px 16px rgba(0,73,127,.3); transition: all .18s;
}
.hw-btn-b:hover { background: #003a66; transform: translateY(-2px); color: #fff; }

/* Scroll reveal */
.hw-anim { opacity: 0; transform: translateY(22px); transition: all .55s cubic-bezier(.16,1,.3,1); }
.hw-anim.visible { opacity: 1; transform: none; }

/* ── Responsive ── */
@media (max-width: 992px) {
    .hw-hero-grid { grid-template-columns: 1fr; }
    .hw-hero-img-col { display: none; }
    .hw-steps-row { grid-template-columns: repeat(2, 1fr); }
    .hw-steps-row::before { display: none; }
    .hw-phase-grid { grid-template-columns: 1fr; gap: 36px; }
    .hw-phase-grid--rev { direction: ltr; }
}
@media (max-width: 600px) {
    .hw-free-grid { grid-template-columns: 1fr; }
    .hw-steps-row { grid-template-columns: 1fr 1fr; }
    .hw-overview, .hw-phase, .hw-cta, .hw-free { padding: 60px 0; }
    .hw-hero { padding: 64px 0 52px; }
    .hw-phase-img-wrap img { height: 260px; }
}
</style>

{# ══ 1. HERO ═══════════════════════════════════════════════════════════════ #}
<section class="hw-hero">
    <div class="hw-wrap">
        <div class="hw-hero-grid">

            {# — Texte — #}
            <div class="hw-anim">
                <div class="hw-hero-pill">
                    <i class="ph-bold ph-house-line"></i> Propriétaires &amp; locataires
                </div>
                <h1>
                    Trouvez le bon pro.<br>
                    <span class="hl-free">100 % gratuit.</span>
                </h1>
                <p class="hw-hero__sub">
                    Décrivez votre projet en 2 minutes, recevez plusieurs soumissions
                    de professionnels vérifiés dans votre région — sans rien débourser.
                </p>
                <div class="hw-hero-trust">
                    <span><i class="ph-bold ph-currency-dollar-simple"></i> Soumissions gratuites</span>
                    <span><i class="ph-bold ph-shield-check"></i> Pros vérifiés</span>
                    <span><i class="ph-bold ph-check-circle"></i> Sans obligation</span>
                </div>
                <div class="hw-hero-actions">
                    <a href="{{ path('app_register') }}" class="hw-btn-o">
                        Soumettre mon projet <i class="ph-bold ph-arrow-right"></i>
                    </a>
                    <a href="{{ path('professionals_list') }}" class="hw-btn-ghost">
                        Explorer les pros
                    </a>
                </div>
            </div>

            {# — Image — #}
            <div class="hw-hero-img-col hw-anim" style="transition-delay:.1s;">
                <img class="hw-hero-img"
                     src="{{ asset('assets/drilleedo/images/stock/hero_reno.jpg') }}"
                     alt="Projet de rénovation">
                <div class="hw-hero-badge">
                    <span class="hw-hero-badge__num">GRATUIT</span>
                    <span class="hw-hero-badge__lbl">Aucun frais pour soumettre</span>
                </div>
                <div class="hw-hero-badge2">
                    <i class="ph-bold ph-star"></i>
                    <div class="hw-hero-badge2__text">Pros vérifiés<br>et évalués</div>
                </div>
            </div>

        </div>
    </div>
</section>

{# ══ 2. C'EST GRATUIT ══════════════════════════════════════════════════════ #}
<section class="hw-free hw-anim">
    <div class="hw-wrap">
        <h2 class="hw-free__headline">C'est <span>100&nbsp;% gratuit</span> — vraiment.</h2>
        <p class="hw-free__sub">Pas de frais cachés, pas de surprise. Vous comparez librement et mandatez uniquement si une offre vous convient.</p>
        <div class="hw-free-grid">
            <div class="hw-free-cell">
                <div class="hw-free-cell__ico" style="background:rgba(255,138,61,.1);color:#FF8A3D;">
                    <i class="ph-bold ph-currency-dollar-simple"></i>
                </div>
                <div class="hw-free-cell__title">Aucun frais de soumission</div>
                <p class="hw-free-cell__text">Décrivez votre projet et recevez des offres sans rien payer.</p>
            </div>
            <div class="hw-free-cell">
                <div class="hw-free-cell__ico" style="background:rgba(0,73,127,.08);color:#00497F;">
                    <i class="ph-bold ph-scales"></i>
                </div>
                <div class="hw-free-cell__title">Comparez sans engagement</div>
                <p class="hw-free-cell__text">Analysez les propositions en toute liberté, sans obligation d'accepter.</p>
            </div>
            <div class="hw-free-cell">
                <div class="hw-free-cell__ico" style="background:rgba(22,163,74,.1);color:#16a34a;">
                    <i class="ph-bold ph-check-fat"></i>
                </div>
                <div class="hw-free-cell__title">Mandatez si ça vous convient</div>
                <p class="hw-free-cell__text">Vous choisissez uniquement si une offre correspond vraiment à vos attentes.</p>
            </div>
        </div>
    </div>
</section>

{# ══ 3. LES 4 ÉTAPES — VUE D'ENSEMBLE ═════════════════════════════════════ #}
<section class="hw-overview">
    <div class="hw-wrap">

        <div class="hw-section-hd hw-anim">
            <div class="hw-section-pill">
                <i class="ph-bold ph-list-numbers"></i> Comment ça fonctionne
            </div>
            <h2 class="hw-section-title">Simple, rapide, <span>en 4 étapes</span></h2>
            <p class="hw-section-sub">De la description de votre projet au choix du bon professionnel — en quelques minutes.</p>
        </div>

        <div class="hw-steps-row hw-anim">

            <div class="hw-ovr-step">
                <div class="hw-ovr-circle hw-ovr-circle--1">
                    <i class="ph-bold ph-user-plus"></i>
                    <span class="hw-ovr-num">1</span>
                </div>
                <div class="hw-ovr-card">
                    <div class="hw-ovr-title">Créez votre profil</div>
                    <p class="hw-ovr-text">Inscrivez-vous en quelques minutes pour gérer vos projets et suivre vos échanges.</p>
                </div>
            </div>

            <div class="hw-ovr-step">
                <div class="hw-ovr-circle hw-ovr-circle--2">
                    <i class="ph-bold ph-note-pencil"></i>
                    <span class="hw-ovr-num">2</span>
                </div>
                <div class="hw-ovr-card">
                    <div class="hw-ovr-title">Décrivez votre projet</div>
                    <p class="hw-ovr-text">Type de travaux, budget, délais, localisation — formulaire simple, 2 minutes chrono.</p>
                </div>
            </div>

            <div class="hw-ovr-step">
                <div class="hw-ovr-circle hw-ovr-circle--3">
                    <i class="ph-bold ph-envelope-open"></i>
                    <span class="hw-ovr-num">3</span>
                </div>
                <div class="hw-ovr-card">
                    <div class="hw-ovr-title">Recevez des soumissions</div>
                    <p class="hw-ovr-text">Des pros qualifiés de votre zone vous envoient leurs offres avec prix et délais.</p>
                </div>
            </div>

            <div class="hw-ovr-step">
                <div class="hw-ovr-circle hw-ovr-circle--4">
                    <i class="ph-bold ph-check-fat"></i>
                    <span class="hw-ovr-num">4</span>
                </div>
                <div class="hw-ovr-card">
                    <div class="hw-ovr-title">Comparez et choisissez</div>
                    <p class="hw-ovr-text">Analysez les propositions et mandatez uniquement si une offre vous convient.</p>
                </div>
            </div>

        </div>
    </div>
</section>

{# ══ 4. ÉTAPE 1 + 2 — PUBLIEZ VOTRE PROJET ════════════════════════════════ #}
<section class="hw-phase hw-anim">
    <div class="hw-wrap">
        <div class="hw-phase-grid">

            <div>
                <div class="hw-phase-step">Étapes 1 &amp; 2</div>
                <div class="hw-phase-label" style="background:rgba(0,73,127,.08);color:#00497F;border:1px solid rgba(0,73,127,.15);">
                    <i class="ph-bold ph-note-pencil"></i> Publiez votre demande
                </div>
