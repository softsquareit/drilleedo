{% extends 'base.html.twig' %}

{% block title %}Je veux une soumission — Comment ça marche | Drilleedo Canada{% endblock %}
{% block meta_description %}Publiez votre projet en 2 minutes — recevez jusqu'à 5 soumissions de professionnels vérifiés. Gratuit. Sans engagement. Sans carte de crédit. Jamais.{% endblock %}

{% block body %}
<main id="main-content">
<script src="https://unpkg.com/@phosphor-icons/web"></script>
<style>
/* ══ HOW IT WORKS — Drilleedo Brand System
   Helper Blue #00497F · Sky #3FA9F5 · Orange #FF8A3D · Cream #FFFBEB
   ══════════════════════════════════════════════════════════════════════════ */
:root {
  --B: #00497F; --S: #3FA9F5; --O: #FF8A3D;
  --C: #FFFBEB; --D: #0C1825; --M: #4A6073; --L: #E4EBF2; --W: #FFFFFF;
  --F: 'Instrument Sans', system-ui, sans-serif;
  --r: 14px; --rl: 22px; --rx: 28px;
  --sh:    0 4px 24px rgba(0,73,127,.12);
  --sh-md: 0 8px 40px rgba(0,73,127,.15);
  --sh-lg: 0 16px 60px rgba(0,73,127,.18);
  --t: all .22s ease;
}

.hw-wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; font-family: var(--F); color: var(--D); }
.hw-wrap * { box-sizing: border-box; }
.hw-wrap h1,.hw-wrap h2,.hw-wrap h3,.hw-wrap h4 {
  font-family: var(--F); font-weight: 900; letter-spacing: -.8px;
}

/* ── 1. HERO ── */
.hw-hero {
  background: linear-gradient(160deg, #002d50 0%, var(--B) 55%, #0a5490 100%);
  padding: 88px 0 76px; position: relative; overflow: hidden;
}
.hw-hero::before {
  content: ''; position: absolute; inset: 0;
  background-image: radial-gradient(rgba(255,255,255,.03) 1px, transparent 1px);
  background-size: 28px 28px; pointer-events: none;
}
.hw-hero::after {
  content: ''; position: absolute; right: -100px; top: -100px;
  width: 520px; height: 520px; border-radius: 50%;
  background: radial-gradient(circle, rgba(255,138,61,.14) 0%, transparent 68%);
  pointer-events: none;
}
.hw-hero-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 56px; align-items: center; position: relative; z-index: 2;
}
.hw-hero-pill {
  display: inline-flex; align-items: center; gap: 7px;
  background: rgba(255,255,255,.1); color: rgba(255,255,255,.9);
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 50px; padding: 7px 18px;
  font-size: 12px; font-weight: 700; letter-spacing: .6px; text-transform: uppercase;
  margin-bottom: 20px;
}
.hw-hero h1 {
  font-size: clamp(28px,4.2vw,52px); font-weight: 900; color: #fff;
  margin: 0 0 6px; line-height: 1.08; letter-spacing: -2px;
}
.hw-hero h1 .hl-free { color: var(--O); display: inline-block; }
.hw-hero__sub {
  font-size: 17px; color: rgba(255,255,255,.75);
  max-width: 500px; line-height: 1.75; margin: 16px 0 28px;
}
.hw-hero-trust {
  display: flex; gap: 18px; flex-wrap: wrap; margin-bottom: 32px;
}
.hw-hero-trust span {
  display: inline-flex; align-items: center; gap: 6px;
  color: rgba(255,255,255,.8); font-size: 13px; font-weight: 600;
}
.hw-hero-trust i { color: var(--O); font-size: 15px; }
.hw-hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

.hw-hero-img-col { position: relative; }
.hw-hero-img {
  width: 100%; height: 430px; object-fit: cover;
  border-radius: var(--rx); box-shadow: 0 28px 64px rgba(0,0,0,.35); display: block;
}
.hw-hero-badge {
  position: absolute; bottom: 28px; left: -18px;
  background: var(--O); color: #fff;
  padding: 14px 22px; border-radius: var(--rl);
  box-shadow: 0 8px 28px rgba(255,138,61,.45);
}
.hw-hero-badge__num { font-size: 26px; font-weight: 900; line-height: 1; display: block; }
.hw-hero-badge__lbl { font-size: 11px; font-weight: 700; opacity: .9; text-transform: uppercase; letter-spacing: .05em; }
.hw-hero-badge2 {
  position: absolute; top: 28px; right: -14px;
  background: var(--W); color: var(--D);
  padding: 10px 16px; border-radius: var(--r);
  box-shadow: var(--sh); display: flex; align-items: center; gap: 8px;
}
.hw-hero-badge2 i { color: var(--O); font-size: 20px; }
.hw-hero-badge2__text { font-size: 12px; font-weight: 800; line-height: 1.3; }

/* ── 2. GRATUIT STRIP ── */
.hw-free {
  background: var(--W); padding: 64px 0 56px;
  border-top: 3px solid var(--O); border-bottom: 1px solid var(--L);
}
.hw-free__headline {
  text-align: center; font-size: clamp(24px,3.5vw,38px);
  font-weight: 900; color: var(--D); letter-spacing: -1.5px; margin: 0 0 8px;
}
.hw-free__headline span { color: var(--O); }
.hw-free__sub {
  text-align: center; font-size: 15px; color: var(--M);
  max-width: 480px; margin: 0 auto 40px; line-height: 1.65;
}
.hw-free-grid {
  display: grid; grid-template-columns: repeat(3,1fr);
  gap: 1px; background: var(--L);
  border: 1.5px solid var(--L); border-radius: var(--rx); overflow: hidden;
  max-width: 860px; margin: 0 auto;
}
.hw-free-cell {
  background: var(--W); padding: 32px 24px; text-align: center; transition: var(--t);
}
.hw-free-cell:hover { background: var(--C); }
.hw-free-cell__ico {
  width: 54px; height: 54px; border-radius: var(--rl);
  display: flex; align-items: center; justify-content: center;
  font-size: 22px; margin: 0 auto 14px;
}
.hw-free-cell__title { font-size: 15px; font-weight: 800; color: var(--D); margin: 0 0 5px; }
.hw-free-cell__text  { font-size: 13px; color: var(--M); margin: 0; line-height: 1.6; }

/* ── 3. 4 ÉTAPES — OVERVIEW ── */
.hw-overview {
  background: linear-gradient(160deg, #eef6ff 0%, #e3f0fd 50%, #d9ecfb 100%);
  padding: 96px 0;
}
.hw-section-hd { text-align: center; margin-bottom: 56px; }
.hw-section-pill {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(255,138,61,.10); color: var(--O);
  border: 1px solid rgba(255,138,61,.2);
  border-radius: 50px; padding: 7px 18px;
  font-size: 12px; font-weight: 700; letter-spacing: .6px; text-transform: uppercase;
  margin-bottom: 16px;
}
.hw-section-title {
  font-size: clamp(28px,3.5vw,40px); font-weight: 900; color: var(--D);
  letter-spacing: -1.5px; margin: 0 0 12px; line-height: 1.13;
}
.hw-section-title span { color: var(--B); }
.hw-section-sub {
  font-size: 17px; color: var(--M); max-width: 540px; margin: 0 auto; line-height: 1.75;
}

.hw-steps-row {
  display: grid; grid-template-columns: repeat(4,1fr);
  position: relative; gap: 16px;
}
.hw-steps-row::before {
  content: ''; position: absolute;
  top: 31px; left: calc(12.5% + 8px); right: calc(12.5% + 8px);
  height: 2px;
  background: linear-gradient(90deg, rgba(255,138,61,.5), rgba(63,169,245,.5));
  z-index: 0;
}
.hw-ovr-step { text-align: center; padding: 0 8px; position: relative; z-index: 1; }
.hw-ovr-circle {
  width: 62px; height: 62px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24px; margin: 0 auto 16px; position: relative; z-index: 2;
  background: linear-gradient(135deg, var(--B), var(--S)); color: #fff;
  box-shadow: 0 6px 20px rgba(0,73,127,.25);
}
.hw-ovr-num {
  position: absolute; top: -4px; right: -4px;
  width: 22px; height: 22px; border-radius: 50%;
  background: var(--O); color: #fff;
  font-size: 10px; font-weight: 900;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2px 8px rgba(255,138,61,.4);
  border: 2px solid var(--W);
}
.hw-ovr-card {
  background: var(--W); border-radius: var(--rx); padding: 20px 16px 22px;
  border: 1.5px solid var(--L);
  box-shadow: 0 2px 12px rgba(0,73,127,.06);
  transition: var(--t);
}
.hw-ovr-card:hover {
  border-color: var(--S); transform: translateY(-4px);
  box-shadow: var(--sh-md); border-bottom: 3px solid var(--S);
}
.hw-ovr-title { font-size: 14px; font-weight: 800; color: var(--D); margin: 0 0 6px; }
.hw-ovr-text  { font-size: 12px; color: var(--M); line-height: 1.6; margin: 0; }

/* ── 4. SPLIT PHASES ── */
.hw-phase { padding: 96px 0; background: var(--W); }
.hw-phase--alt { background: var(--C); }
.hw-phase-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 64px; align-items: center;
}
.hw-phase-grid--rev { direction: rtl; }
.hw-phase-grid--rev > * { direction: ltr; }

.hw-phase-img-wrap {
  position: relative; border-radius: var(--rx); overflow: hidden;
  box-shadow: var(--sh-lg);
}
.hw-phase-img-wrap img { width: 100%; height: 380px; object-fit: cover; display: block; }
.hw-phase-img-tag {
  position: absolute; bottom: 20px; right: 20px;
  background: rgba(12,24,37,.85); backdrop-filter: blur(10px);
  color: #fff; padding: 10px 16px; border-radius: var(--r);
  font-size: 12px; font-weight: 700;
  display: flex; align-items: center; gap: 6px;
}
.hw-phase-img-tag i { color: var(--O); }

.hw-phase-label {
  display: inline-flex; align-items: center; gap: 7px;
  border-radius: 50px; padding: 7px 16px;
  font-size: 12px; font-weight: 700; letter-spacing: .6px; text-transform: uppercase;
  margin-bottom: 14px;
}
.hw-phase-step {
  font-size: 12px; font-weight: 700; color: var(--M);
  letter-spacing: .1em; text-transform: uppercase; margin-bottom: 6px;
}
.hw-phase-title {
  font-size: clamp(22px,2.8vw,32px); font-weight: 900; color: var(--D);
  letter-spacing: -1.2px; margin: 0 0 12px; line-height: 1.15;
}
.hw-phase-desc { font-size: 15px; color: var(--M); line-height: 1.8; margin-bottom: 24px; }
.hw-feat-list {
  list-style: none; padding: 0; margin: 0 0 28px;
  display: flex; flex-direction: column; gap: 14px;
}
.hw-feat-item { display: flex; gap: 12px; align-items: flex-start; }
.hw-feat-ico {
  width: 42px; height: 42px; border-radius: var(--r);
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; flex-shrink: 0;
}
.hw-feat-item h4 { font-size: 14px; font-weight: 800; color: var(--D); margin: 0 0 2px; }
.hw-feat-item p  { font-size: 13px; color: var(--M); margin: 0; line-height: 1.55; }

/* ── 5. CTA FINAL ── */
.hw-cta {
  background: linear-gradient(160deg, #002d50 0%, var(--B) 55%, #0a5490 100%);
  padding: 96px 0; text-align: center; position: relative; overflow: hidden;
}
.hw-cta::before {
  content: ''; position: absolute; right: -100px; bottom: -100px;
  width: 440px; height: 440px; border-radius: 50%;
  background: radial-gradient(circle, rgba(255,138,61,.08) 0%, transparent 70%);
  pointer-events: none;
}
.hw-cta::after {
  content: ''; position: absolute; left: -60px; top: -60px;
  width: 280px; height: 280px; border-radius: 50%;
  background: radial-gradient(circle, rgba(63,169,245,.07) 0%, transparent 70%);
  pointer-events: none;
}
.hw-cta__inner { position: relative; z-index: 2; }
.hw-cta-tag {
  display: inline-flex; align-items: center; gap: 7px;
  background: rgba(255,138,61,.18); border: 1px solid rgba(255,138,61,.35);
  color: var(--O); font-size: 12px; font-weight: 700;
  letter-spacing: .6px; text-transform: uppercase;
  padding: 7px 18px; border-radius: 50px; margin-bottom: 18px;
}
.hw-cta h2 {
  font-size: clamp(26px,4vw,44px); font-weight: 900; color: #fff;
  margin: 0 0 12px; letter-spacing: -1.5px; line-height: 1.13;
}
.hw-cta h2 span { color: var(--O); }
.hw-cta__sub {
  font-size: 16px; color: rgba(255,255,255,.73);
  margin: 0 auto 36px; max-width: 460px; line-height: 1.7;
}
.hw-cta-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

/* ── Buttons ── */
.hw-btn-o {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--O); color: #fff; font-family: var(--F);
  font-size: 15px; font-weight: 800; padding: 14px 30px;
  border-radius: 50px; text-decoration: none;
  box-shadow: 0 4px 20px rgba(255,138,61,.4); transition: var(--t);
}
.hw-btn-o:hover { background: #e87830; transform: translateY(-2px); color: #fff; box-shadow: 0 8px 28px rgba(255,138,61,.45); }

.hw-btn-ghost {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,.1); color: #fff; font-family: var(--F);
  font-size: 15px; font-weight: 700; padding: 13px 24px;
  border-radius: 50px; text-decoration: none;
  border: 2px solid rgba(255,255,255,.25); transition: var(--t);
}
.hw-btn-ghost:hover { background: rgba(255,255,255,.18); border-color: rgba(255,255,255,.5); color: #fff; }

.hw-btn-outline {
  display: inline-flex; align-items: center; gap: 8px;
  background: transparent; color: #fff; font-family: var(--F);
  font-size: 15px; font-weight: 700; padding: 13px 26px;
  border-radius: 50px; text-decoration: none;
  border: 2px solid rgba(255,255,255,.3); transition: var(--t);
}
.hw-btn-outline:hover { background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.6); color: #fff; }

.hw-btn-b {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--B); color: #fff; font-family: var(--F);
  font-size: 15px; font-weight: 800; padding: 13px 26px;
  border-radius: 50px; text-decoration: none;
  box-shadow: 0 4px 16px rgba(0,73,127,.3); transition: var(--t);
}
.hw-btn-b:hover { background: #003a66; transform: translateY(-2px); color: #fff; box-shadow: 0 8px 24px rgba(0,73,127,.35); }

/* Scroll reveal */
.hw-anim { opacity: 0; transform: translateY(22px); transition: all .55s cubic-bezier(.16,1,.3,1); }
.hw-anim.visible { opacity: 1; transform: none; }

/* ── FAQ ── */
.hw-faq-list { display: flex; flex-direction: column; gap: 10px; max-width: 820px; margin: 0 auto; }
.hw-faq-item { background: #fff; border: 1px solid #dde8f5; border-radius: 12px; overflow: hidden; transition: border-color .2s, box-shadow .2s; }
.hw-faq-item:hover { border-color: var(--S); box-shadow: 0 4px 16px rgba(0,73,127,.08); }
.hw-faq-btn { width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 18px 22px; background: none; border: none; font-size: 15px; font-weight: 700; color: #0C1825; cursor: pointer; gap: 12px; text-align: left; }
.hw-faq-btn:hover { background: #f5f8fc; }
.hw-faq-btn.open { color: var(--B); }
.hw-faq-arrow { width: 26px; height: 26px; border-radius: 50%; background: #e8f0f8; color: #00497F; font-size: 16px; font-weight: 900; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: transform .25s, background .2s; }
.hw-faq-btn.open .hw-faq-arrow { transform: rotate(45deg); background: var(--B); color: #fff; }
.hw-faq-body { display: none; padding: 0 22px 18px; font-size: 14px; color: #4A6073; line-height: 1.8; }
.hw-faq-body.open { display: block; }

/* ── Responsive ── */
@media (max-width: 992px) {
  .hw-hero-grid { grid-template-columns: 1fr; }
  .hw-hero-img-col { display: none; }
  .hw-steps-row { grid-template-columns: repeat(2,1fr); }
  .hw-steps-row::before { display: none; }
  .hw-phase-grid { grid-template-columns: 1fr; gap: 36px; }
  .hw-phase-grid--rev { direction: ltr; }
}
@media (max-width: 600px) {
  .hw-free-grid { grid-template-columns: 1fr; }
  .hw-steps-row { grid-template-columns: 1fr 1fr; }
  .hw-overview, .hw-phase, .hw-cta, .hw-free { padding: 64px 0; }
  .hw-hero { padding: 64px 0 52px; }
  .hw-phase-img-wrap img { height: 260px; }
}
</style>

{# ══ 1. HERO ═══════════════════════════════════════════════════════════════ #}
