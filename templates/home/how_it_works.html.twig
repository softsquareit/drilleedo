<script>
document.addEventListener('DOMContentLoaded', () => {
    const obs = new IntersectionObserver(entries => {
        entries.forEach(e => {
            if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
        });
    }, { threshold: 0.07 });
    document.querySelectorAll('.hw-anim').forEach(el => obs.observe(el));
});
function hwFaq(btn) {
    const body = btn.nextElementSibling;
    const isOpen = btn.classList.contains('open');
    btn.closest('.hw-faq-list').querySelectorAll('.hw-faq-btn.open').forEach(b => {
        b.classList.remove('open'); b.nextElementSibling.classList.remove('open'); b.setAttribute('aria-expanded','false');
    });
    if (!isOpen) { btn.classList.add('open'); body.classList.add('open'); btn.setAttribute('aria-expanded','true'); }
}
</script>
