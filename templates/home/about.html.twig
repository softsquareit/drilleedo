{% extends 'base.html.twig' %}

{% block title %}{{ 'about.meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'about.meta_desc'|trans }}{% endblock %}

{% block body %}
<main id="main-content">
<script src="https://unpkg.com/@phosphor-icons/web"></script>
<style>
/* ══ ABOUT PAGE ════════════════════════════════════════════════════════════
   Charte : #00497F · #3FA9F5 · #FF8A3D · #0C1825 · #4A6073
   ══════════════════════════════════════════════════════════════════════════ */
:root {
    --B:#00497F; --S:#3FA9F5; --O:#FF8A3D; --D:#0C1825; --M:#4A6073;
    --L:#E4EBF2; --W:#fff;
    --sh: 0 4px 24px rgba(0,73,127,.10);
    --sh-md: 0 10px 40px rgba(0,73,127,.14);
}
.ab-wrap { max-width:1140px; margin:0 auto; padding:0 24px; }
.ab-fade { opacity:0; transform:translateY(26px); transition:opacity .55s ease,transform .55s ease; }
.ab-fade.in { opacity:1; transform:none; }

/* ════════ 1. HERO ════════ */
.ab-hero {
    background: linear-gradient(135deg, #0C1825 0%, #003660 55%, #00497F 100%);
    padding: 96px 0 80px;
    position: relative; overflow: hidden; text-align: center;
}
.ab-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 28px 28px; pointer-events: none;
}
.ab-hero::after {
    content: ''; position: absolute;
    left: 50%; top: -120px; transform: translateX(-50%);
    width: 700px; height: 700px; border-radius: 50%;
    background: radial-gradient(circle, rgba(63,169,245,.1) 0%, transparent 65%);
    pointer-events: none;
}
.ab-hero__inner { position: relative; z-index: 2; max-width: 760px; margin: 0 auto; }
.ab-hero-eyebrow {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,255,255,.1); color: rgba(255,255,255,.88);
    border: 1px solid rgba(255,255,255,.18); border-radius: 999px;
    padding: 7px 18px; font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase; margin-bottom: 22px;
}
.ab-hero h1 {
    font-size: clamp(28px, 4.5vw, 54px);
    font-weight: 900; color: #fff; margin: 0 0 6px;
    line-height: 1.08; letter-spacing: -.025em;
}
.ab-hero h1 span { color: #FF8A3D; }
.ab-hero__tagline {
    font-size: 17px; color: rgba(255,255,255,.6);
    max-width: 620px; margin: 18px auto 32px; line-height: 1.75;
}
.ab-hero__tagline strong { color: rgba(255,255,255,.9); }
.ab-hero-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

/* ════════ 2. STATS STRIP ════════ */
.ab-stats {
    background: #fff;
    border-top: 3px solid #FF8A3D;
    border-bottom: 1px solid var(--L);
}
.ab-stats-grid {
    display: grid; grid-template-columns: repeat(4,1fr);
    max-width: 1100px; margin: 0 auto; padding: 0 24px;
}
.ab-stat-cell {
    display: flex; align-items: center; gap: 14px;
    padding: 22px 18px; border-right: 1px solid var(--L);
}
.ab-stat-cell:last-child { border-right: none; }
.ab-stat-ico {
    width: 46px; height: 46px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; flex-shrink: 0;
}
.ab-stat-num { font-size: 21px; font-weight: 900; color: #00497F; line-height: 1; }
.ab-stat-lbl { font-size: 12px; color: var(--M); font-weight: 600; margin-top: 3px; }

/* ════════ PAGE BG ════════ */
.ab-bg { background: linear-gradient(180deg, #eef5fb 0%, #f4f8fc 40%, #f8fbff 100%); padding: 64px 0 80px; }

/* ════════ 3. LE CONSTAT — dark split ════════ */
.ab-constat {
    display: grid; grid-template-columns: 1fr 1fr;
    border-radius: 24px; overflow: hidden;
    box-shadow: 0 12px 50px rgba(0,73,127,.18);
    margin-bottom: 28px;
    min-height: 500px;
}
.ab-constat-img { position: relative; overflow: hidden; }
.ab-constat-img img { width:100%; height:100%; object-fit:cover; display:block; min-height:380px; }
.ab-constat-img::after {
    content:''; position:absolute; inset:0;
    background: linear-gradient(to right, rgba(12,24,37,.2), transparent);
}
.ab-constat-img-badge {
    position: absolute; bottom: 20px; left: 20px; z-index: 2;
    background: rgba(12,24,37,.88); backdrop-filter: blur(10px);
    border-radius: 12px; padding: 12px 18px;
    box-shadow: 0 4px 16px rgba(0,0,0,.25);
}
.ab-constat-img-badge__num { font-size: 22px; font-weight: 900; color: #fff; }
.ab-constat-img-badge__num span { color: #FF8A3D; }
.ab-constat-img-badge__lbl { font-size: 11px; color: rgba(255,255,255,.6); margin-top: 2px; }
.ab-constat-body {
    background: linear-gradient(160deg, #0C1825 0%, #003660 100%);
    padding: 52px 48px;
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; justify-content: center;
}
.ab-constat-body::before {
    content:''; position:absolute; inset:0;
    background-image: radial-gradient(rgba(255,255,255,.025) 1px, transparent 1px);
    background-size: 28px 28px; pointer-events: none;
}
.ab-constat-body::after {
    content:''; position:absolute; bottom:-80px; right:-80px;
    width:280px; height:280px; border-radius:50%;
    background: rgba(255,138,61,.08); pointer-events: none;
}
.ab-constat-inner { position: relative; z-index: 2; }
.ab-constat-tag {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,138,61,.15); border: 1px solid rgba(255,138,61,.3);
    color: #FF8A3D; font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase;
    padding: 5px 14px; border-radius: 50px; margin-bottom: 16px;
}
.ab-constat-title {
    font-size: clamp(20px, 2.5vw, 28px); font-weight: 900; color: #fff;
    margin: 0 0 16px; line-height: 1.2; letter-spacing: -.015em;
}
.ab-constat-title span { color: #FF8A3D; }
.ab-constat-lead {
    font-size: 15px; color: rgba(255,255,255,.7); line-height: 1.8; margin-bottom: 20px;
}
.ab-constat-body-text { font-size: 14px; color: rgba(255,255,255,.6); line-height: 1.8; margin-bottom: 16px; }
.ab-constat-body-text:last-of-type { margin-bottom: 0; }
.ab-constat-body-text strong { color: rgba(255,255,255,.9); }

/* ════════ 4. MISSION & VISION ════════ */
.ab-mv {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 24px; margin-bottom: 28px;
}
.ab-mv-card {
    background: #fff; border-radius: 20px; overflow: hidden;
    box-shadow: var(--sh);
    transition: box-shadow .22s, transform .22s;
    border-top: 4px solid transparent;
}
.ab-mv-card:hover { box-shadow: var(--sh-md); transform: translateY(-3px); }
.ab-mv-card--mission { border-top-color: #FF8A3D; }
.ab-mv-card--vision  { border-top-color: #3FA9F5; }
.ab-mv-card-img { overflow: hidden; height: 220px; }
.ab-mv-card-img img { width:100%; height:100%; object-fit:cover; display:block; transition: transform .5s; }
.ab-mv-card:hover .ab-mv-card-img img { transform: scale(1.04); }
.ab-mv-card-body { padding: 32px 36px; }
.ab-mv-label {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    margin-bottom: 10px;
}
.ab-mv-title { font-size: 20px; font-weight: 900; color: #0C1825; margin: 0 0 12px; line-height: 1.2; }
.ab-mv-text  { font-size: 14px; color: var(--M); line-height: 1.8; margin: 0 0 10px; }
.ab-mv-text:last-of-type { margin: 0; }
.ab-mv-text strong { color: #0C1825; }
/* Vision bullets */
.ab-mv-list { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-direction: column; gap: 10px; }
.ab-mv-list li { display: flex; gap: 10px; align-items: flex-start; font-size: 13px; color: var(--M); line-height: 1.6; }
.ab-mv-list-dot {
    width: 22px; height: 22px; border-radius: 6px; flex-shrink: 0;
    background: rgba(63,169,245,.12); color: #3FA9F5;
    display: flex; align-items: center; justify-content: center; font-size: 11px; margin-top: 1px;
}

/* ════════ 5. VALEURS ════════ */
.ab-values-section {
    background: #fff; border-radius: 24px;
    box-shadow: var(--sh); margin-bottom: 28px; overflow: hidden;
}
.ab-values-hd {
    padding: 44px 48px 36px; border-bottom: 1px solid var(--L);
    text-align: center;
}
.ab-values-pill {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(0,73,127,.07); color: #00497F;
    border: 1px solid rgba(0,73,127,.15); border-radius: 999px;
    padding: 6px 16px; font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase; margin-bottom: 12px;
}
.ab-values-title { font-size: clamp(22px,3vw,30px); font-weight: 900; color: #0C1825; margin: 0 0 8px; letter-spacing: -.015em; }
.ab-values-title span { color: #00497F; }
.ab-values-sub { font-size: 15px; color: var(--M); max-width: 520px; margin: 0 auto; line-height: 1.7; }

.ab-val5-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 0; border-top: 1px solid var(--L);
}
.ab-val5-card {
    padding: 36px 40px;
    border-right: 1px solid var(--L); border-bottom: 1px solid var(--L);
    transition: background .2s;
    position: relative;
}
.ab-val5-card:hover { background: #fafcff; }
.ab-val5-card:nth-child(2n) { border-right: none; }
.ab-val5-card--full { grid-column: 1 / -1; border-right: none; }
.ab-val5-card--full:last-child { border-bottom: none; }
.ab-val5-head {
    display: flex; align-items: center; gap: 14px; margin-bottom: 14px;
}
.ab-val5-ico {
    width: 48px; height: 48px; border-radius: 14px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 20px;
}
.ab-val5-name { font-size: 18px; font-weight: 900; color: #0C1825; margin: 0; }
.ab-val5-lbl {
    display: inline-block; font-size: 10px; font-weight: 800; letter-spacing: .08em;
    text-transform: uppercase; padding: 2px 8px; border-radius: 6px; margin-top: 3px;
}
.ab-val5-text { font-size: 14px; color: var(--M); line-height: 1.8; margin: 0; }
.ab-val5-text strong { color: #0C1825; }

/* ════════ 6. ENGAGEMENT CANADIEN ════════ */
.ab-canada {
    display: grid; grid-template-columns: 1fr 1fr;
    border-radius: 24px; overflow: hidden;
    box-shadow: 0 12px 50px rgba(0,73,127,.18);
    margin-bottom: 28px; min-height: 460px;
}
.ab-canada-img { position: relative; overflow: hidden; }
.ab-canada-img img { width:100%; height:100%; object-fit:cover; display:block; min-height:360px; }
.ab-canada-img::before {
    content:''; position:absolute; inset:0; z-index:1;
    background: linear-gradient(to right, transparent 60%, rgba(22,22,48,.1) 100%);
}
.ab-canada-flag {
    position: absolute; top: 20px; left: 20px; z-index: 2;
    background: rgba(255,255,255,.92); backdrop-filter: blur(6px);
    border-radius: 10px; padding: 9px 16px;
    font-size: 14px; font-weight: 800; color: #0C1825;
    box-shadow: 0 4px 14px rgba(0,0,0,.12);
}
.ab-canada-provinces {
    position: absolute; bottom: 20px; left: 20px; z-index: 2;
    background: rgba(12,24,37,.85); backdrop-filter: blur(10px);
    border-radius: 12px; padding: 12px 18px;
    font-size: 12px; color: rgba(255,255,255,.75); font-weight: 600; line-height: 1.6;
}
.ab-canada-body {
    background: linear-gradient(160deg, #0C1825 0%, #00497F 100%);
    padding: 52px 48px;
    display: flex; flex-direction: column; justify-content: center;
    position: relative; overflow: hidden;
}
.ab-canada-body::before {
    content:''; position:absolute; inset:0;
    background-image: radial-gradient(rgba(255,255,255,.025) 1px, transparent 1px);
    background-size: 28px 28px; pointer-events: none;
}
.ab-canada-inner { position: relative; z-index: 2; }
.ab-canada-tag {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2);
    color: rgba(255,255,255,.9); font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase;
    padding: 5px 14px; border-radius: 50px; margin-bottom: 16px;
}
.ab-canada-title {
    font-size: clamp(20px,2.5vw,28px); font-weight: 900; color: #fff;
    margin: 0 0 14px; line-height: 1.2; letter-spacing: -.015em;
}
.ab-canada-title span { color: #3FA9F5; }
.ab-canada-text { font-size: 14px; color: rgba(255,255,255,.7); line-height: 1.8; margin: 0 0 14px; }
.ab-canada-text:last-of-type { margin: 0; }
.ab-canada-text strong { color: #FF8A3D; }
.ab-canada-provinces-list {
    display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px;
}
.ab-canada-prov {
    background: rgba(255,255,255,.1); color: rgba(255,255,255,.8);
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 999px; padding: 5px 14px;
    font-size: 12px; font-weight: 700;
}

/* ════════ 7. TÉMOIGNAGES ════════ */
.ab-testi-section {
    background: #fff; border-radius: 24px;
    box-shadow: var(--sh); margin-bottom: 28px;
    overflow: hidden;
}
.ab-testi-hd {
    padding: 44px 48px 36px; border-bottom: 1px solid var(--L);
    text-align: center;
}
.ab-testi-hd__pill {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,138,61,.1); color: #FF8A3D;
    border: 1px solid rgba(255,138,61,.2); border-radius: 999px;
    padding: 6px 16px; font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase; margin-bottom: 12px;
}
.ab-testi-hd__title { font-size: clamp(20px,2.8vw,28px); font-weight: 900; color: #0C1825; margin: 0 0 8px; letter-spacing: -.015em; }
.ab-testi-hd__sub { font-size: 15px; color: var(--M); max-width: 480px; margin: 0 auto; }

.ab-testi-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 0;
}
.ab-testi-col {
    padding: 36px 40px; border-right: 1px solid var(--L);
}
.ab-testi-col:last-child { border-right: none; }
.ab-testi-col-label {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
    margin-bottom: 24px; padding: 4px 12px; border-radius: 6px;
}
.ab-testi-card {
    background: #f8fafc; border: 1px solid var(--L);
    border-radius: 16px; padding: 22px 24px;
    margin-bottom: 16px; transition: box-shadow .2s, transform .2s;
    position: relative;
}
.ab-testi-card:hover { box-shadow: 0 6px 24px rgba(0,73,127,.09); transform: translateY(-2px); }
.ab-testi-card:last-child { margin-bottom: 0; }
.ab-testi-quote {
    font-size: 28px; font-weight: 900; color: #FF8A3D;
    line-height: 1; margin-bottom: 8px; opacity: .7;
}
.ab-testi-text { font-size: 13px; color: var(--M); line-height: 1.75; margin: 0 0 14px; font-style: italic; }
.ab-testi-author {
    display: flex; align-items: center; gap: 10px;
}
.ab-testi-avatar {
    width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; font-weight: 900; color: #fff;
}
.ab-testi-name { font-size: 13px; font-weight: 800; color: #0C1825; }
.ab-testi-role { font-size: 11px; color: var(--M); }
.ab-testi-badge {
    position: absolute; top: 16px; right: 16px;
    font-size: 10px; font-weight: 700; padding: 3px 10px; border-radius: 6px;
    letter-spacing: .04em;
}

/* ════════ 8. CTA FINAL ════════ */
.ab-final-cta {
    background: linear-gradient(135deg, #0C1825 0%, #003660 100%);
    border-radius: 24px; padding: 64px 48px;
    text-align: center; box-shadow: 0 12px 50px rgba(0,73,127,.22);
    position: relative; overflow: hidden;
}
.ab-final-cta::before {
    content:''; position:absolute; top:-100px; right:-80px;
    width:360px; height:360px; border-radius:50%;
    background: rgba(63,169,245,.08); pointer-events:none;
}
.ab-final-cta::after {
    content:''; position:absolute; bottom:-80px; left:-60px;
    width:280px; height:280px; border-radius:50%;
    background: rgba(255,138,61,.07); pointer-events:none;
}
.ab-final-cta__inner { position: relative; z-index: 2; }
.ab-final-cta__tag {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,138,61,.15); border: 1px solid rgba(255,138,61,.3);
    color: #FF8A3D; font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase;
    padding: 5px 14px; border-radius: 50px; margin-bottom: 18px;
}
.ab-final-cta h2 {
    font-size: clamp(22px,3.5vw,36px); font-weight: 900; color: #fff;
    margin: 0 0 10px; line-height: 1.2; letter-spacing: -.02em;
}
.ab-final-cta h2 span { color: #FF8A3D; }
.ab-final-cta__sub {
    font-size: 16px; color: rgba(255,255,255,.65);
    max-width: 520px; margin: 0 auto 36px; line-height: 1.7;
}
.ab-final-cta-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

/* ── Shared Buttons ── */
.ab-btn-o {
    display: inline-flex; align-items: center; gap: 8px;
    background: #FF8A3D; color: #fff; font-size: 15px; font-weight: 800;
    padding: 14px 28px; border-radius: 8px; text-decoration: none;
    box-shadow: 0 4px 18px rgba(255,138,61,.38); transition: all .2s;
}
.ab-btn-o:hover { background: #e87830; transform: translateY(-2px); color: #fff; }
.ab-btn-b {
    display: inline-flex; align-items: center; gap: 8px;
    background: #00497F; color: #fff; font-size: 15px; font-weight: 800;
    padding: 13px 26px; border-radius: 8px; text-decoration: none;
    box-shadow: 0 4px 16px rgba(0,73,127,.28); transition: all .18s;
}
.ab-btn-b:hover { background: #003a66; transform: translateY(-2px); color: #fff; }
.ab-btn-w {
    display: inline-flex; align-items: center; gap: 8px;
    background: transparent; color: #fff; font-size: 15px; font-weight: 700;
    padding: 13px 24px; border-radius: 8px; text-decoration: none;
    border: 2px solid rgba(255,255,255,.28); transition: all .18s;
}
.ab-btn-w:hover { background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.55); color: #fff; }
.ab-btn-s {
    display: inline-flex; align-items: center; gap: 8px;
    background: #3FA9F5; color: #fff; font-size: 15px; font-weight: 800;
    padding: 13px 26px; border-radius: 8px; text-decoration: none;
    box-shadow: 0 4px 16px rgba(63,169,245,.35); transition: all .18s;
}
.ab-btn-s:hover { background: #2a95e0; transform: translateY(-2px); color: #fff; }

/* ── Responsive ── */
@media (max-width:900px) {
    .ab-constat, .ab-canada { grid-template-columns: 1fr; min-height: auto; }
    .ab-constat-body, .ab-canada-body { padding: 36px 28px; }
    .ab-mv { grid-template-columns: 1fr; }
    .ab-val5-grid { grid-template-columns: 1fr; }
    .ab-val5-card:nth-child(2n) { border-right: none; }
    .ab-testi-grid { grid-template-columns: 1fr; }
    .ab-testi-col { border-right: none; border-bottom: 1px solid var(--L); }
    .ab-testi-col:last-child { border-bottom: none; }
    .ab-stats-grid { grid-template-columns: repeat(2,1fr); }
    .ab-stat-cell:nth-child(2) { border-right: none; }
    .ab-stat-cell:nth-child(3) { border-top: 1px solid var(--L); }
}
@media (max-width:600px) {
    .ab-hero { padding: 72px 0 60px; }
    .ab-values-hd, .ab-testi-hd, .ab-val5-card, .ab-testi-col { padding-left: 24px; padding-right: 24px; }
    .ab-final-cta { padding: 48px 24px; }
    .ab-final-cta-btns { flex-direction: column; align-items: center; }
}
</style>

{# ══ 1. HERO ═══════════════════════════════════════════════════════════════ #}
<section class="ab-hero">
    <div class="ab-wrap">
        <div class="ab-hero__inner">
            <div class="ab-hero-eyebrow">
                <i class="ph-bold ph-info"></i> {{ 'about.hero_eyebrow'|trans }}
            </div>
            <h1>{{ 'about.hero_title_1'|trans }} <span>{{ 'about.hero_title_2'|trans }}</span></h1>
            <p class="ab-hero__tagline">
                {{ 'about.hero_sub'|trans }}
            </p>
            <div class="ab-hero-btns">
                <a href="{{ path('professionals_list') }}" class="ab-btn-o">
                    <i class="ph-bold ph-magnifying-glass"></i> {{ 'about.why_btn_find'|trans }}
                </a>
                <a href="{{ path('app_register_pro') }}" class="ab-btn-w">
                    <i class="ph-bold ph-user-plus"></i> {{ 'about.why_btn_join'|trans }}
                </a>
            </div>
        </div>
    </div>
</section>

{# ══ 2. STATS STRIP ════════════════════════════════════════════════════════ #}
