{% extends 'base.html.twig' %}

{% block title %}{{ 'about.meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'about.meta_desc'|trans }}{% endblock %}

{% block body %}
<main id="main-content">
<style>
/* ══ ABOUT PAGE v2 — Senior UI/UX ═══════════════════════════════════════
   #1A3D6E blue · #F5821F orange · #3FA9F5 sky · Instrument Sans
   ════════════════════════════════════════════════════════════════════════ */
:root {
  --ab:  #1A3D6E;
  --ao:  #F5821F;
  --as:  #3FA9F5;
  --ad:  #0C1825;
  --am:  #475569;
  --al:  #E4EBF2;
  --aw:  #fff;
  --at:  all .22s ease;
  --ar:  16px;
  --arx: 22px;
  --ash: 0 4px 28px rgba(26,61,110,.10);
}

/* ── HERO ── */
.ab-hero {
  min-height: 420px;
  background: linear-gradient(135deg, #1A3D6E 0%, #2e6db4 50%, #3FA9F5 100%);
  position: relative; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  text-align: center; padding: 80px 24px;
}
.ab-hero::before {
  content: '';
  position: absolute; inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}
.ab-hero::after {
  content: '';
  position: absolute; left: 50%; top: -120px; transform: translateX(-50%);
  width: 600px; height: 600px; border-radius: 50%;
  background: radial-gradient(circle, rgba(245,130,31,.15) 0%, transparent 65%);
  pointer-events: none;
}
.ab-hero-inner { position: relative; z-index: 2; max-width: 700px; }
.ab-breadcrumb {
  font-size: 12px; color: rgba(255,255,255,.5);
  margin-bottom: 20px; display: flex; align-items: center; justify-content: center; gap: 6px;
}
.ab-breadcrumb a { color: rgba(255,255,255,.65); text-decoration: none; }
.ab-breadcrumb a:hover { color: #fff; }
.ab-eyebrow {
  display: inline-flex; align-items: center; gap: 7px;
  background: rgba(255,255,255,.12); color: rgba(255,255,255,.9);
  border: 1px solid rgba(255,255,255,.2); border-radius: 999px;
  padding: 7px 18px; font-size: 11px; font-weight: 700;
  letter-spacing: .1em; text-transform: uppercase; margin-bottom: 20px;
}
.ab-eyebrow i { color: var(--ao); }
.ab-hero-title {
  font-size: clamp(32px, 5vw, 54px); font-weight: 900; color: #fff;
  margin: 0 0 16px; line-height: 1.08; letter-spacing: -.03em;
}
.ab-hero-title span { color: var(--ao); }
.ab-hero-sub {
  font-size: 17px; color: rgba(255,255,255,.72);
  max-width: 520px; margin: 0 auto 32px; line-height: 1.7;
}
.ab-hero-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.ab-btn-o {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--ao); color: #fff; font-weight: 700; font-size: 15px;
  padding: 13px 26px; border-radius: var(--ar); text-decoration: none;
  box-shadow: 0 4px 18px rgba(245,130,31,.35); transition: var(--at);
}
.ab-btn-o:hover { background: #d96e10; transform: translateY(-2px); color: #fff; }
.ab-btn-w {
  display: inline-flex; align-items: center; gap: 8px;
  background: transparent; color: #fff; font-weight: 700; font-size: 15px;
  padding: 12px 24px; border-radius: var(--ar); text-decoration: none;
  border: 2px solid rgba(255,255,255,.3); transition: var(--at);
}
.ab-btn-w:hover { background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.6); color: #fff; }

/* ── STATS STRIP ── */
.ab-stats {
  background: #fff;
  border-bottom: 1px solid var(--al);
  border-top: 3px solid var(--ao);
}
.ab-stats-grid {
  display: grid; grid-template-columns: repeat(4,1fr);
  max-width: 1100px; margin: 0 auto; padding: 0 28px;
}
.ab-stat-cell {
  display: flex; align-items: center; gap: 14px;
  padding: 24px 20px; border-right: 1px solid var(--al);
}
.ab-stat-cell:last-child { border-right: none; }
.ab-stat-ico {
  width: 48px; height: 48px; border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; flex-shrink: 0;
}
.ab-ico-b { background: linear-gradient(135deg,#1A3D6E,#2e6db4); color: #fff; }
.ab-ico-s { background: linear-gradient(135deg,#2196f3,#3FA9F5); color: #fff; }
.ab-ico-g { background: linear-gradient(135deg,#16a34a,#22c55e); color: #fff; }
.ab-ico-o { background: linear-gradient(135deg,#c95a08,#F5821F); color: #fff; }
.ab-stat-num { font-size: 22px; font-weight: 900; color: var(--ab); line-height: 1; }
.ab-stat-lbl { font-size: 12px; color: var(--am); font-weight: 600; margin-top: 3px; }

/* ── PAGE BG ── */
.ab-page-bg {
  background: linear-gradient(180deg, #cde0f5 0%, #daeaf9 25%, #e8f2fb 55%, #f2f7fd 100%);
  padding: 56px 0 80px;
}

/* ── SECTION CARDS ── */
.ab-section {
  background: var(--aw);
  border-radius: var(--arx);
  box-shadow: var(--ash);
  overflow: hidden;
  margin-bottom: 24px;
  transition: box-shadow .22s, transform .22s;
  border-left: 5px solid transparent;
}
.ab-section:hover { box-shadow: 0 10px 44px rgba(26,61,110,.14); transform: translateY(-2px); }
.ab-section--story   { border-left-color: var(--ab); }
.ab-section--mission { border-left-color: var(--ao); }
.ab-section--vision  { border-left-color: var(--as); }
.ab-section--canada  { border-left-color: #16a34a; }

.ab-row {
  display: grid; grid-template-columns: 1fr 1.4fr;
  min-height: 300px;
}
.ab-row--rev { grid-template-columns: 1.4fr 1fr; }

/* Photo side */
.ab-photo { overflow: hidden; position: relative; }
.ab-photo img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  min-height: 300px; transition: transform .5s ease;
}
.ab-section:hover .ab-photo img { transform: scale(1.04); }
.ab-photo-tag {
  position: absolute; bottom: 16px; left: 16px;
  background: rgba(255,255,255,.94); backdrop-filter: blur(6px);
  border-radius: 10px; padding: 8px 14px;
  display: flex; align-items: center; gap: 8px;
  font-size: 12px; font-weight: 700; color: var(--ab);
  box-shadow: 0 3px 12px rgba(0,0,0,.12);
}
.ab-photo-tag i { color: var(--ao); font-size: 14px; }

/* Text side */
.ab-body { padding: 44px 48px; display: flex; flex-direction: column; justify-content: center; }
.ab-eyebrow2 {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 11px; font-weight: 800; letter-spacing: .12em;
  text-transform: uppercase; color: var(--ao);
  margin-bottom: 10px;
}
.ab-title {
  font-size: 22px; font-weight: 900; color: var(--ab);
  margin: 0 0 6px; line-height: 1.2; letter-spacing: -.02em;
}
.ab-subtitle {
  font-size: 14px; font-weight: 600; color: var(--am);
  margin: 0 0 18px; font-style: italic;
}
.ab-p { font-size: 15px; color: var(--am); line-height: 1.78; margin: 0 0 10px; }
.ab-p:last-of-type { margin-bottom: 0; }
.ab-p strong { color: var(--ab); }

/* Bullet list */
.ab-list { list-style: none; padding: 0; margin: 18px 0 0; display: flex; flex-direction: column; gap: 10px; }
.ab-list li {
  display: flex; align-items: flex-start; gap: 10px;
  font-size: 14px; color: #334155; line-height: 1.6;
}
.ab-list-ico {
  width: 26px; height: 26px; border-radius: 8px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; color: #fff; margin-top: 1px;
}

/* Mission pillars */
.ab-pillars { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin-top: 20px; }
.ab-pillar {
  background: #F8FAFC; border: 1.5px solid var(--al);
  border-radius: 14px; padding: 16px 14px; text-align: center;
  transition: var(--at);
}
.ab-pillar:hover { border-color: var(--as); background: #EEF4FF; }
.ab-pillar-ico { font-size: 22px; color: var(--ao); margin-bottom: 8px; }
.ab-pillar-lbl { font-size: 12px; font-weight: 700; color: var(--ab); }

/* Stats grid inside card */
.ab-kpis { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 22px; }
.ab-kpi {
  background: #EEF4FF; border-radius: 14px; padding: 16px 18px;
  border: 1.5px solid #d5e4f5; transition: var(--at);
}
.ab-kpi:hover { background: #dbeafe; border-color: var(--as); }
.ab-kpi-num { font-size: 26px; font-weight: 900; color: var(--ab); line-height: 1; margin-bottom: 4px; }
.ab-kpi-num span { color: var(--ao); }
.ab-kpi-lbl { font-size: 12px; color: var(--am); font-weight: 600; }

/* Values strip — 3 icônes sous Story */
.ab-values { display: grid; grid-template-columns: repeat(3,1fr); gap: 0; border-top: 1px solid var(--al); }
.ab-val {
  padding: 22px 24px; display: flex; align-items: center; gap: 14px;
  border-right: 1px solid var(--al); transition: background .18s;
}
.ab-val:last-child { border-right: none; }
.ab-val:hover { background: #F8FAFC; }
.ab-val-ico {
  width: 42px; height: 42px; border-radius: 10px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; font-size: 18px;
}
.ab-val-name { font-size: 13px; font-weight: 800; color: var(--ab); margin-bottom: 2px; }
.ab-val-desc { font-size: 12px; color: var(--am); line-height: 1.5; }

/* CTA final */
.ab-cta {
  background: linear-gradient(135deg, #1A3D6E 0%, #2662ab 60%, #3FA9F5 100%);
  border-radius: var(--arx); padding: 64px 48px; text-align: center;
  box-shadow: 0 12px 48px rgba(26,61,110,.22);
  position: relative; overflow: hidden; margin-top: 8px;
}
.ab-cta::before {
  content:''; position:absolute; top:-100px; right:-80px;
  width:320px; height:320px; border-radius:50%;
  background: rgba(255,255,255,.05); pointer-events:none;
}
.ab-cta::after {
  content:''; position:absolute; bottom:-80px; left:-60px;
  width:260px; height:260px; border-radius:50%;
  background: rgba(245,130,31,.08); pointer-events:none;
}
.ab-cta-inner { position: relative; z-index: 2; }
.ab-cta-tag {
  display: inline-flex; align-items: center; gap: 7px;
  background: rgba(255,255,255,.12); color: rgba(255,255,255,.9);
  border: 1px solid rgba(255,255,255,.2); border-radius: 999px;
  padding: 7px 18px; font-size: 11px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .1em; margin-bottom: 20px;
}
.ab-cta h2 { font-size: clamp(24px,3.5vw,36px); font-weight: 900; color: #fff; margin: 0 0 12px; }
.ab-cta p  { font-size: 16px; color: rgba(255,255,255,.72); margin: 0 0 32px; max-width:480px; margin-left:auto; margin-right:auto; }
.ab-cta-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

/* ── WHY DRILLEEDO MATTERS ── */
.ab-matters {
  border-radius: var(--arx);
  overflow: hidden; margin-bottom: 24px;
  box-shadow: 0 8px 40px rgba(26,61,110,.18);
  display: grid; grid-template-columns: 1fr 1fr;
  min-height: 520px;
}

/* Photo half */
.ab-matters-photo {
  position: relative; overflow: hidden;
}
.ab-matters-photo img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transition: transform .6s ease;
}
.ab-matters:hover .ab-matters-photo img { transform: scale(1.04); }
.ab-matters-photo::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(26,61,110,.45) 0%, rgba(26,61,110,.1) 60%, transparent 100%);
}
.ab-matters-photo-flag {
  position: absolute; top: 20px; left: 20px; z-index: 2;
  background: rgba(255,255,255,.92); backdrop-filter: blur(8px);
  border-radius: 10px; padding: 10px 16px;
  display: flex; align-items: center; gap: 8px;
  font-size: 13px; font-weight: 800; color: var(--ab);
  box-shadow: 0 4px 16px rgba(0,0,0,.15);
}
.ab-matters-photo-badge {
  position: absolute; bottom: 20px; left: 20px; z-index: 2;
  background: rgba(26,61,110,.88); backdrop-filter: blur(8px);
  border-radius: 12px; padding: 12px 18px;
  box-shadow: 0 4px 16px rgba(0,0,0,.2);
}
.ab-matters-photo-badge-num {
  font-size: 22px; font-weight: 900; color: #fff; line-height: 1;
}
.ab-matters-photo-badge-num span { color: var(--ao); }
.ab-matters-photo-badge-lbl {
  font-size: 11px; color: rgba(255,255,255,.65); font-weight: 600; margin-top: 3px;
}

/* Content half */
.ab-matters-content {
  background: linear-gradient(160deg, #0C1825 0%, #1A3D6E 60%, #1e4f8a 100%);
  padding: 52px 48px;
  position: relative; overflow: hidden;
  display: flex; flex-direction: column; justify-content: center;
}
.ab-matters-content::before {
  content: ''; position: absolute; inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M0 0h20v20H0zM20 20h20v20H20z'/%3E%3C/g%3E%3C/svg%3E");
  pointer-events: none;
}
.ab-matters-content::after {
  content: ''; position: absolute; bottom: -80px; right: -80px;
  width: 280px; height: 280px; border-radius: 50%;
  background: radial-gradient(circle, rgba(245,130,31,.12) 0%, transparent 70%);
  pointer-events: none;
}
.ab-matters-inner { position: relative; z-index: 2; }

.ab-matters-flag {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.15);
  border-radius: 999px; padding: 7px 18px;
  font-size: 11px; font-weight: 800; letter-spacing: .12em;
  text-transform: uppercase; color: rgba(255,255,255,.8);
  margin-bottom: 20px;
}
.ab-matters-flag span { color: #F5821F; }
.ab-matters-title {
  font-size: clamp(22px, 2.8vw, 34px); font-weight: 900; color: #fff;
  line-height: 1.15; letter-spacing: -.02em; margin: 0 0 18px;
}
.ab-matters-title em { color: var(--ao); font-style: normal; }
.ab-matters-lead {
  font-size: 15px; color: rgba(255,255,255,.65);
  line-height: 1.78; margin-bottom: 32px;
}
.ab-matters-lead strong { color: rgba(255,255,255,.9); }

/* Problem → Solution items */
.ab-matters-items { display: flex; flex-direction: column; gap: 14px; margin-bottom: 36px; }
.ab-matters-item {
  display: flex; align-items: flex-start; gap: 14px;
  background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.09);
  border-radius: 14px; padding: 16px 18px;
  transition: background .2s, border-color .2s;
}
.ab-matters-item:hover { background: rgba(255,255,255,.1); border-color: rgba(245,130,31,.35); }
.ab-matters-item-ico {
  width: 42px; height: 42px; border-radius: 11px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; font-size: 18px;
}
.ab-matters-item-title { font-size: 13px; font-weight: 800; color: #fff; margin-bottom: 4px; }
.ab-matters-item-body { font-size: 12px; color: rgba(255,255,255,.55); line-height: 1.6; }
.ab-matters-item-badge {
  display: inline-block; margin-top: 6px;
  background: rgba(245,130,31,.18); color: #F5821F;
  border: 1px solid rgba(245,130,31,.3);
  border-radius: 999px; padding: 3px 10px;
  font-size: 10px; font-weight: 700;
}

/* Market stats row */
.ab-matters-stats {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
.ab-matters-stat {
  background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.09);
  border-radius: 12px; padding: 16px 14px; text-align: center;
  transition: background .2s;
}
.ab-matters-stat:hover { background: rgba(255,255,255,.1); }
.ab-matters-stat-num {
  font-size: 22px; font-weight: 900; color: #fff;
  line-height: 1; margin-bottom: 5px;
}
.ab-matters-stat-num sup { color: var(--ao); font-size: 14px; }
.ab-matters-stat-lbl { font-size: 11px; color: rgba(255,255,255,.5); font-weight: 600; }

/* Scroll animation */
.ab-fade { opacity: 0; transform: translateY(28px); transition: opacity .55s ease, transform .55s ease; }
.ab-fade.in { opacity: 1; transform: none; }

/* Responsive */
@media(max-width:900px){
  .ab-row,.ab-row--rev { grid-template-columns: 1fr; }
  .ab-photo img { min-height: 220px; height: 240px; }
  .ab-body { padding: 28px 28px; }
  .ab-pillars { grid-template-columns: 1fr 1fr; }
  .ab-values { grid-template-columns: 1fr; }
  .ab-val { border-right: none; border-bottom: 1px solid var(--al); }
  .ab-val:last-child { border-bottom: none; }
  .ab-matters { grid-template-columns: 1fr; min-height: auto; }
  .ab-matters-photo { min-height: 280px; }
  .ab-matters-content { padding: 36px 28px; }
  .ab-matters-stats { grid-template-columns: repeat(3, 1fr); }
}
@media(max-width:600px){
  .ab-stats-grid { grid-template-columns: 1fr 1fr; }
  .ab-stat-cell { border-right: none; border-bottom: 1px solid var(--al); }
  .ab-stat-cell:nth-child(2n) { padding-left: 20px; }
  .ab-pillars { grid-template-columns: 1fr; }
  .ab-kpis { grid-template-columns: 1fr 1fr; }
  .ab-hero-title { font-size: 28px; }
  .ab-cta { padding: 40px 24px; }
  .ab-matters-grid { grid-template-columns: 1fr; }
  .ab-matters-stats { grid-template-columns: 1fr 1fr; }
  .ab-matters { padding: 32px 20px; }
}
</style>

{# ══ HERO ══ #}
<section class="ab-hero" aria-labelledby="ab-hero-title">
  <div class="ab-hero-inner">
    <nav class="ab-breadcrumb" aria-label="breadcrumb">
      <a href="{{ path('app_home') }}">Accueil</a>
      <span aria-hidden="true">›</span>
      <span>À propos</span>
    </nav>
    <div class="ab-eyebrow">
      <i class="feather-info"></i>
      Notre histoire &amp; nos valeurs
    </div>
    <h1 class="ab-hero-title" id="ab-hero-title">
      {{ 'about.hero_title_1'|trans }} <span>{{ 'about.hero_title_2'|trans }}</span>
    </h1>
    <p class="ab-hero-sub">{{ 'about.hero_sub'|trans }}</p>
    <div class="ab-hero-btns">
      <a href="{{ path('professionals_list') }}" class="ab-btn-o">
        <i class="feather-search"></i> Trouver un professionnel
      </a>
      <a href="{{ path('app_register_pro') }}" class="ab-btn-w">
        <i class="feather-user-plus"></i> Inscrire mon entreprise
      </a>
    </div>
  </div>
</section>


{# ══ CONTENT ══ #}
<div class="ab-page-bg">
  <div class="container">

    {# ── 1. Notre histoire ── #}
    <div class="ab-section ab-section--story ab-fade">
      <div class="ab-row">
        <div class="ab-body">
          <div class="ab-eyebrow2"><i class="feather-clock"></i> Notre histoire</div>
          <h2 class="ab-title">Pourquoi Drilleedo a été créé</h2>
          <p class="ab-subtitle">Un constat simple, une solution puissante.</p>
          <p class="ab-p">Drilleedo est né d'un constat simple : les propriétaires peinent à trouver des professionnels fiables, tandis que les artisans qualifiés manquent de visibilité pour atteindre les bons clients.</p>
          <p class="ab-p">Nous avons créé Drilleedo pour combler ce fossé — une plateforme qui réunit <strong>confiance, expertise et efficacité</strong> en un seul endroit.</p>
          <ul class="ab-list">
            <li>
              <span class="ab-list-ico" style="background:linear-gradient(135deg,#1A3D6E,#2e6db4)"><i class="feather-shield" style="font-size:11px;"></i></span>
              Professionnels vérifiés avec licences et assurances
            </li>
            <li>
              <span class="ab-list-ico" style="background:linear-gradient(135deg,#F5821F,#d96e10)"><i class="feather-zap" style="font-size:11px;"></i></span>
              Devis reçus en 24 à 48 h, sans engagement
            </li>
            <li>
              <span class="ab-list-ico" style="background:linear-gradient(135deg,#16a34a,#22c55e)"><i class="feather-trending-up" style="font-size:11px;"></i></span>
              +40% de visibilité pour les professionnels inscrits
            </li>
          </ul>
        </div>
        <div class="ab-photo">
          <img src="{{ asset('assets/drilleedo/images/stock/about_story.jpg') }}"
               alt="Entrepreneurs Drilleedo au travail" loading="lazy">
          <div class="ab-photo-tag">
            <i class="feather-award"></i> Fondé pour simplifier vos projets
          </div>
        </div>
      </div>
      {# Valeurs sous Story #}
