{% extends 'base.html.twig' %}

{% block title %}{{ 'about.meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'about.meta_desc'|trans }}{% endblock %}

{% block body %}
<main id="main-content">
<style>
/* ══ ABOUT PAGE — design charter matches index.html.twig ════════════════
   Colours: #00509e (blue), #e8501a (orange), #0d2151 (navy), #1e293b (dark)
   Patterns: discovery-pill, discovery-title, about-stat-card style, hero-btn
   ═══════════════════════════════════════════════════════════════════════ */

/* ── 1. Hero Banner ── */
.au-hero {
  height: 280px;
  background: linear-gradient(120deg, #0d2151 0%, #1a3a6b 50%, #00509e 100%);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.au-hero__bg {
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}

.au-hero__content {
  position: relative;
  z-index: 2;
  padding: 0 24px;
}

.au-hero__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.9);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 999px;
  padding: 6px 16px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  margin-bottom: 16px;
}

.au-hero__title {
  font-size: clamp(28px, 5vw, 50px);
  font-weight: 900;
  color: #fff;
  margin: 0 0 14px;
  line-height: 1.1;
  letter-spacing: -0.02em;
  text-shadow: 0 4px 24px rgba(0,0,0,0.3);
}

.au-hero__title span { color: #f97316; }

.au-hero__sub {
  font-size: 17px;
  color: rgba(255,255,255,0.75);
  max-width: 560px;
  margin: 0 auto;
  line-height: 1.7;
}

/* Breadcrumb */
.au-breadcrumb {
  font-size: 13px;
  color: rgba(255,255,255,0.55);
  margin-bottom: 16px;
}

.au-breadcrumb a { color: rgba(255,255,255,0.7); text-decoration: none; }
.au-breadcrumb a:hover { color: #fff; }
.au-breadcrumb span { margin: 0 8px; }

/* ── 2. Stats Strip ── */
.au-stats-strip {
  background: #fff;
  border-bottom: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(13,33,81,0.06);
}

.au-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 28px;
}

.au-stat-cell {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 24px 20px;
  border-right: 1px solid #f1f5f9;
}

.au-stat-cell:last-child { border-right: none; }

.au-stat-ico {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
}

.au-stat-ico.bg-navy  { background: linear-gradient(135deg, #0d2151, #1a3a6b); color: #fff; }
.au-stat-ico.bg-blue  { background: linear-gradient(135deg, #00509e, #2196f3); color: #fff; }
.au-stat-ico.bg-green { background: linear-gradient(135deg, #16a34a, #22c55e); color: #fff; }
.au-stat-ico.bg-orng  { background: linear-gradient(135deg, #c73d0d, #e8501a); color: #fff; }

.au-stat-num {
  font-size: 24px;
  font-weight: 900;
  color: #0d2151;
  line-height: 1;
}

.au-stat-lbl {
  font-size: 12px;
  color: #64748b;
  font-weight: 600;
  margin-top: 2px;
}

/* ── 3. Section utility ── */
.au-section { padding: 80px 0; }
.au-section--gray { background: #f8fafc; }
.au-section--navy { background: linear-gradient(135deg, #0d2151 0%, #1a3a6b 100%); }
.au-section--blue { background: linear-gradient(170deg, #f0f6ff 0%, #e8eeff 100%); }

.au-section-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: #e8f4fd;
  color: #00509e;
  border: 1px solid rgba(0,80,158,0.18);
  border-radius: 999px;
  padding: 6px 16px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  margin-bottom: 14px;
}

.au-section-title {
  font-size: clamp(24px, 3.5vw, 36px);
  font-weight: 900;
  color: #1e293b;
  margin: 0 0 14px;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.au-section-title span { color: #00509e; }
.au-section-sub {
  font-size: 16px;
  color: #64748b;
  line-height: 1.7;
  max-width: 600px;
}

/* ── 4. Story section ── */
.au-story-img {
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 8px 40px rgba(13,33,81,0.14);
  height: 100%;
  min-height: 400px;
}

.au-story-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.au-story-content { padding: 0 48px 0 0; }

.au-feature-list {
  list-style: none;
  padding: 0;
  margin: 24px 0 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.au-feature-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-size: 15px;
  color: #334155;
  line-height: 1.6;
}

.au-feature-ico {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: linear-gradient(135deg, #00509e, #2196f3);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  flex-shrink: 0;
  margin-top: 1px;
}

/* ── 5. Values 3-col grid ── */
.au-values-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 48px;
}

.au-val-card {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  padding: 28px 22px;
  transition: transform 0.22s, box-shadow 0.22s;
}

.au-val-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 32px rgba(13,33,81,0.1);
}

.au-val-icon {
  width: 58px;
  height: 58px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  margin-bottom: 18px;
}

.au-val-title {
  font-size: 17px;
  font-weight: 800;
  color: #0d2151;
  margin: 0 0 10px;
}

.au-val-desc {
  font-size: 14px;
  color: #64748b;
  line-height: 1.7;
  margin: 0;
}

/* ── 6. Mission / Vision split ── */
.au-mv-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-top: 48px;
}

.au-mv-card {
  border-radius: 16px;
  padding: 36px 30px;
  position: relative;
  overflow: hidden;
}

.au-mv-card--mission {
  background: linear-gradient(135deg, #0d2151 0%, #1a3a6b 100%);
  color: #fff;
}

.au-mv-card--vision {
  background: linear-gradient(135deg, #e8501a 0%, #f06030 100%);
  color: #fff;
}

.au-mv-card__icon {
  font-size: 40px;
  opacity: 0.25;
  position: absolute;
  top: 20px;
  right: 24px;
}

.au-mv-card__label {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0.7;
  margin-bottom: 10px;
}

.au-mv-card__title {
  font-size: 22px;
  font-weight: 900;
  margin: 0 0 14px;
  line-height: 1.2;
  color:white;
}

.au-mv-card__text {
  font-size: 14px;
  opacity: 0.85;
  line-height: 1.75;
  margin: 0;
}

/* ── 7. Team ── */
.au-team-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-top: 48px;
}

.au-team-card {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  overflow: hidden;
  text-align: center;
  transition: transform 0.22s, box-shadow 0.22s;
}

.au-team-card:hover { transform: translateY(-5px); box-shadow: 0 12px 32px rgba(13,33,81,0.1); }

.au-team-img {
  height: 200px;
  overflow: hidden;
  position: relative;
}

.au-team-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top;
  transition: transform 0.38s;
}

.au-team-card:hover .au-team-img img { transform: scale(1.06); }

.au-team-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60px;
  background: linear-gradient(transparent, rgba(13,33,81,0.6));
}

.au-team-body { padding: 20px 18px 22px; }

.au-team-avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: linear-gradient(135deg, #0d2151, #00509e);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  font-weight: 900;
  margin: -50px auto 12px;
  border: 4px solid #fff;
  box-shadow: 0 4px 12px rgba(13,33,81,0.2);
  position: relative;
  z-index: 2;
}

.au-team-name {
  font-size: 17px;
  font-weight: 800;
  color: #0d2151;
  margin: 0 0 4px;
}

.au-team-role {
  font-size: 13px;
  font-weight: 700;
  color: #00509e;
  margin: 0 0 10px;
}

.au-team-bio {
  font-size: 13px;
  color: #64748b;
  line-height: 1.65;
  margin: 0;
}

/* ── 8. Why Choose Us ── */
.au-why-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  margin-top: 40px;
}

.au-why-item {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 12px;
  padding: 20px 18px;
}

.au-why-ico {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  color: #fff;
  flex-shrink: 0;
}

.au-why-name {
  font-size: 15px;
  font-weight: 800;
  color: #fff;
  margin: 0 0 5px;
}

.au-why-desc {
  font-size: 13px;
  color: rgba(255,255,255,0.75);
  margin: 0;
  line-height: 1.6;
}

/* ── 9. FAQ ── */
.au-faq-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 40px;
  max-width: 780px;
  margin-left: auto;
  margin-right: auto;
}

.au-faq-item {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  overflow: hidden;
}

.au-faq-trigger {
  width: 100%;
  text-align: left;
  padding: 18px 22px;
  background: none;
  border: none;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 15px;
  font-weight: 700;
  color: #0d2151;
  transition: background 0.15s;
}

.au-faq-trigger:hover { background: #f8fafc; }
.au-faq-trigger.open { color: #00509e; }
.au-faq-trigger.open .au-faq-arrow { transform: rotate(45deg); }

.au-faq-arrow {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  flex-shrink: 0;
  transition: transform 0.2s, background 0.15s;
  line-height: 1;
}

.au-faq-trigger.open .au-faq-arrow { background: #00509e; color: #fff; }

.au-faq-body {
  display: none;
  padding: 0 22px 18px;
  font-size: 14px;
  color: #64748b;
  line-height: 1.75;
}

.au-faq-body.open { display: block; }

/* ── 10. CTA section ── */
.au-cta {
  background: linear-gradient(120deg, #0d2151 0%, #1a3a6b 50%, #00509e 100%);
  padding: 80px 0;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.au-cta::before {
  content: '';
  position: absolute;
  right: -100px;
  top: -100px;
  width: 400px;
  height: 400px;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
}

.au-cta__title {
  font-size: clamp(24px, 3.5vw, 38px);
  font-weight: 900;
  color: #fff;
  margin: 0 0 14px;
  line-height: 1.2;
}

.au-cta__sub {
  font-size: 16px;
  color: rgba(255,255,255,0.75);
  max-width: 520px;
  margin: 0 auto 32px;
  line-height: 1.7;
}

.au-btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #e8501a;
  color: #fff;
  font-size: 15px;
  font-weight: 700;
  padding: 14px 30px;
  border-radius: 8px;
  text-decoration: none;
  transition: opacity 0.18s, transform 0.15s;
  box-shadow: 0 4px 18px rgba(232,80,26,0.35);
  margin-right: 10px;
}

.au-btn-primary:hover { opacity: 0.9; transform: translateY(-2px); color: #fff; }

.au-btn-outline {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  color: #fff;
  font-size: 15px;
  font-weight: 700;
  padding: 13px 28px;
  border-radius: 8px;
  text-decoration: none;
  border: 2px solid rgba(255,255,255,0.3);
  transition: background 0.15s, border-color 0.15s;
}

.au-btn-outline:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.6); color: #fff; }

/* ── Responsive ── */
@media (max-width: 1024px) {
  .au-values-grid { grid-template-columns: repeat(2, 1fr); }
  .au-team-grid   { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
  .au-stats-grid  { grid-template-columns: repeat(2, 1fr); }
  .au-mv-grid     { grid-template-columns: 1fr; }
  .au-why-grid    { grid-template-columns: 1fr; }
  .au-story-content { padding: 0; margin-bottom: 32px; }
  .au-section     { padding: 54px 0; }
  .au-hero        { height: 220px; }
}

@media (max-width: 540px) {
  .au-stats-grid  { grid-template-columns: 1fr 1fr; }
  .au-values-grid { grid-template-columns: 1fr; }
  .au-team-grid   { grid-template-columns: 1fr; }
  .au-btn-outline { display: none; }
}

.au-scroll { opacity: 0; transform: translateY(24px); transition: opacity 0.55s ease, transform 0.55s ease; }
.au-scroll.visible { opacity: 1; transform: none; }
</style>


{# ══════════════════════════════════════════════════════════════════════════
   1. HERO BANNER
══════════════════════════════════════════════════════════════════════════ #}
<section class="au-hero" aria-labelledby="au-hero-title">
  <div class="au-hero__bg"></div>
  <div class="au-hero__content">
    <div class="au-breadcrumb">
      <a href="{{ path('app_home') }}">{{ 'about.breadcrumb_home'|trans }}</a>
      <span>›</span>
      <span>{{ 'about.breadcrumb_about'|trans }}</span>
    </div>
    <div class="au-hero__eyebrow">
      <i class="ph-bold ph-info" aria-hidden="true"></i>
      {{ 'about.hero_eyebrow'|trans }}
    </div>
    <h1 class="au-hero__title" id="au-hero-title">
      {{ 'about.hero_title_1'|trans }} <span>{{ 'about.hero_title_2'|trans }}</span>
    </h1>
    <p class="au-hero__sub">
      {{ 'about.hero_sub'|trans }}
    </p>
  </div>
</section>

{# ══════════════════════════════════════════════════════════════════════════
   2. STATS STRIP
══════════════════════════════════════════════════════════════════════════ #}
<div class="au-stats-strip">
  <div class="au-stats-grid">
    <div class="au-stat-cell">
      <div class="au-stat-ico bg-navy"><i class="ph-bold ph-users" aria-hidden="true"></i></div>
      <div>
        <div class="au-stat-num">10,000+</div>
        <div class="au-stat-lbl">{{ 'about.stat_homeowners'|trans }}</div>
      </div>
    </div>
    <div class="au-stat-cell">
      <div class="au-stat-ico bg-blue"><i class="ph-bold ph-hard-hat" aria-hidden="true"></i></div>
      <div>
        <div class="au-stat-num">1,500+</div>
        <div class="au-stat-lbl">{{ 'about.stat_pros'|trans }}</div>
      </div>
    </div>
    <div class="au-stat-cell">
      <div class="au-stat-ico bg-green"><i class="ph-bold ph-check-circle" aria-hidden="true"></i></div>
      <div>
        <div class="au-stat-num">35,000+</div>
        <div class="au-stat-lbl">{{ 'about.stat_projects'|trans }}</div>
      </div>
    </div>
    <div class="au-stat-cell">
      <div class="au-stat-ico bg-orng"><i class="ph-bold ph-star" aria-hidden="true"></i></div>
      <div>
        <div class="au-stat-num">4.8 / 5</div>
        <div class="au-stat-lbl">{{ 'about.stat_rating'|trans }}</div>
      </div>
    </div>
  </div>
</div>

{# ══════════════════════════════════════════════════════════════════════════
   3. OUR STORY
══════════════════════════════════════════════════════════════════════════ #}
<section class="au-section au-scroll" aria-labelledby="story-heading">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6 order-lg-2">
        <div class="au-story-img">
          <img src="{{ asset('assets/drilleedo/images/team/man_woman.png') }}"
               alt="Drilleedo team — verified renovation professionals working together"
               loading="lazy">
        </div>
      </div>
      <div class="col-lg-6 order-lg-1">
        <div class="au-story-content">
          <div class="au-section-eyebrow">
            <i class="ph-bold ph-clock-counter-clockwise" aria-hidden="true"></i>
            {{ 'about.story_eyebrow'|trans }}
          </div>
          <h2 class="au-section-title" id="story-heading">
            {{ 'about.story_title_1'|trans }} <span>Drilleedo</span> {{ 'about.story_title_2'|trans }}
          </h2>
          <p class="au-section-sub">
            {{ 'about.story_sub_1'|trans|raw }}
          </p>
          <p class="au-section-sub mt-3">
            {{ 'about.story_sub_2'|trans|raw }}
          </p>
          <ul class="au-feature-list">
            <li class="au-feature-item">
              <span class="au-feature-ico"><i class="ph-bold ph-check" aria-hidden="true"></i></span>
              {{ 'about.story_feat_1'|trans }}
            </li>
            <li class="au-feature-item">
              <span class="au-feature-ico"><i class="ph-bold ph-check" aria-hidden="true"></i></span>
              {{ 'about.story_feat_2'|trans }}
            </li>
            <li class="au-feature-item">
              <span class="au-feature-ico"><i class="ph-bold ph-check" aria-hidden="true"></i></span>
              {{ 'about.story_feat_3'|trans }}
            </li>
            <li class="au-feature-item">
              <span class="au-feature-ico"><i class="ph-bold ph-check" aria-hidden="true"></i></span>
              {{ 'about.story_feat_4'|trans }}
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

{# ══════════════════════════════════════════════════════════════════════════
   4. CORE VALUES
══════════════════════════════════════════════════════════════════════════ #}
<section class="au-section au-section--gray au-scroll" aria-labelledby="values-heading">
  <div class="container">
    <div class="text-center">
      <div class="au-section-eyebrow">
        <i class="ph-bold ph-diamond" aria-hidden="true"></i>
        {{ 'about.val_eyebrow'|trans }}
      </div>
      <h2 class="au-section-title" id="values-heading">{{ 'about.val_title'|trans }}</h2>
      <p class="au-section-sub mx-auto">
        {{ 'about.val_sub'|trans }}
      </p>
    </div>

    <div class="au-values-grid">
      <div class="au-val-card">
        <div class="au-val-icon" style="background: linear-gradient(135deg,#0d2151,#1a3a6b);">
          <i class="ph-bold ph-shield-check" aria-hidden="true" style="font-size:24px;color:#fff;"></i>
        </div>
        <h3 class="au-val-title">{{ 'about.val_1_title'|trans }}</h3>
        <p class="au-val-desc">{{ 'about.val_1_desc'|trans }}</p>
