{% extends 'base.html.twig' %}

{% block title %}About Drilleedo – Connecting Homeowners with Trusted Professionals{% endblock %}

{% block body %}
<main class="about-page">
    {# 1. Header Hero #}
    <section class="about-hero animate-on-scroll">
        <div class="container d-flex align-items-center justify-content-center">
            <div class="hero-content text-center">
                <h1 class="hero-title">About Drilleedo</h1>
                <p class="hero-subtitle">Connecting Homeowners with Trusted Professionals for every renovation need.</p>
            </div>
            <div class="hero-icon d-none d-lg-block ms-5">
                <i class="fas fa-home-alt fa-5x text-primary-opacity" aria-hidden="true" style="opacity: 0.2;"></i>
            </div>
        </div>
    </section>

    <div class="container">
        {# 2. Section Our Story #}
        <section class="about-section our-story animate-on-scroll">
            <div class="about-card row g-0 align-items-center">
                <div class="col-lg-6 p-5">
                    <div class="text-content-wrapper">
                        <h2 class="section-title">Why Drilleedo Was Created</h2>
                        <p class="section-text">
                            <strong>Finding a reliable renovation professional shouldn't be a gamble.</strong> We witnessed firsthand the challenges homeowners face: the uncertainty of quality, the lack of transparent pricing, and the difficulty of finding verified experts who truly care.
                        </p>
                        <p class="section-text">
                            Drilleedo was born out of a desire to <strong>simplify this journey</strong>. We've built a platform that bridges the gap between ambitious home projects and the skilled hands that bring them to life. Our mission is to provide <strong>peace of mind through transparency and trust</strong>.
                        </p>
                    </div>
                </div>
                <div class="col-lg-6 px-lg-5 pb-5 pb-lg-0">
                    <div class="card-image-wrapper expert-shadow">
                        <img src="{{ asset('assets/drilleedo/images/team/man_woman.png') }}" alt="Drilleedo professional team at work" class="img-fluid h-100 object-fit-cover rounded-3">
                    </div>
                </div>
            </div>
        </section>

        {# 3. Section Mission #}
        <section class="about-section mission bg-light-blue animate-on-scroll">
            <div class="about-card row g-0 align-items-center">
                <div class="col-lg-6 order-lg-2 p-5 border-start-lg">
                    <div class="text-content-wrapper">
                        <div class="d-flex align-items-center mb-4">
                            <div class="icon-badge me-3"><i class="fas fa-bullseye" aria-hidden="true"></i></div>
                            <h2 class="section-title mb-0">Our Mission</h2>
                        </div>
                        <p class="section-text">
                            <strong>Making Home Services Easier, Smarter & Reliable.</strong>
                        </p>
                        <p class="section-text">
                            We are dedicated to providing a <strong>seamless experience</strong> for both homeowners and professionals, ensuring that every renovation project starts with confidence and ends with excellence.
                        </p>
                    </div>
                </div>
                <div class="col-lg-6 order-lg-1">
                    <div class="card-image-wrapper expert-shadow">
                        <img src="{{ asset('assets/drilleedo/images/bg/bg-ideas.jpg') }}" alt="Drilleedo Mission" class="img-fluid h-100 object-fit-cover">
                    </div>
                </div>
            </div>
        </section>

        {# 4. Section Vision #}
        <section class="about-section vision animate-on-scroll">
            <div class="about-card row g-0 align-items-center">
                <div class="col-lg-6 p-5">
                    <div class="text-content-wrapper">
                        <div class="d-flex align-items-center mb-4">
                            <div class="icon-badge me-3 accent-icon"><i class="fas fa-eye" aria-hidden="true"></i></div>
                            <h2 class="section-title mb-0">Our Vision</h2>
                        </div>
                        <p class="section-text">
                            <strong>Shaping the Future of Home Services.</strong>
                        </p>
                        <p class="section-text">
                            To be the <strong>leading marketplace for home services in Canada</strong>, powered by innovative technology and driven by a community of trusted professionals and satisfied homeowners.
                        </p>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card-image-wrapper expert-shadow">
                        <img src="{{ asset('assets/drilleedo/images/bg/bg-professionals.jpg') }}" alt="Drilleedo Vision" class="img-fluid h-100 object-fit-cover">
                    </div>
                </div>
            </div>
        </section>

        {# 6. Statistics (placed between Vision and Team as per instruction 6) #}
        <section class="stats-section mb-5 animate-on-scroll">
            <div class="row g-4 text-center">
                <div class="col-md-4">
                    <div class="stat-item">
                        <i class="fas fa-lightbulb stat-icon mb-3 stat-blue" aria-hidden="true"></i>
                        <h3 class="stat-number">30k+</h3>
                        <p class="stat-label">Inspirations</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-item border-start border-end border-light">
                        <i class="fas fa-hard-hat stat-icon mb-3 stat-green" aria-hidden="true"></i>
                        <h3 class="stat-number">1.5k+</h3>
                        <p class="stat-label">Professionals</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-item">
                        <i class="fas fa-building stat-icon mb-3 stat-yellow" aria-hidden="true"></i>
                        <h3 class="stat-number">800+</h3>
                        <p class="stat-label">Companies</p>
                    </div>
                </div>
            </div>
        </section>

        {# 5. Section Team #}
        <section class="team-section mb-5 mt-5">
            <div class="text-center mb-5">
                <h2 class="section-title">Driven by Expertise and Innovation</h2>
                <p class="section-subtitle">Meet the visionaries behind Drilleedo</p>
            </div>
            <div class="row g-4">
                {# Profile 1 #}
                <div class="col-lg-4 col-md-6">
                    <div class="team-card text-center">
                        <div class="team-image-box">
                            <img src="{{ asset('assets/drilleedo/images/team/avatar.jpg') }}" alt="Gacem Laghouan" class="img-fluid">
                        </div>
                        <div class="team-info p-4">
                            <h3 class="team-name">Gacem Laghouan</h3>
                            <p class="team-role">Chief Operating Officer</p>
                            <p class="team-bio">Leading our operations and ensuring excellence in every project we support.</p>
                        </div>
                    </div>
                </div>
                {# Profile 2 #}
                <div class="col-lg-4 col-md-6">
                    <div class="team-card text-center">
                        <div class="team-image-box">
                            <img src="{{ asset('assets/drilleedo/images/team/avatar.jpg') }}" alt="Rafaa Somai" class="img-fluid">
                        </div>
                        <div class="team-info p-4">
                            <h3 class="team-name">Rafaa Somai</h3>
                            <p class="team-role">Chief Business Officer</p>
                            <p class="team-bio">Driving growth and building strategic partnerships across the industry.</p>
                        </div>
                    </div>
                </div>
                {# Profile 3 #}
                <div class="col-lg-4 col-md-6">
                    <div class="team-card text-center">
                        <div class="team-image-box">
                            <img src="{{ asset('assets/drilleedo/images/team/avatar.jpg') }}" alt="Oussama Ben Krima" class="img-fluid">
                        </div>
                        <div class="team-info p-4">
                            <h3 class="team-name">Oussama Ben Krima</h3>
                            <p class="team-role">Chief Technology Officer</p>
                            <p class="team-bio">The architect of our platform, pushing the boundaries of technology in home services.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    {# 7. Call-To-Action (CTA) #}
    <section class="about-cta animate-on-scroll bg-light-blue">
        <div class="container text-center">
            <div class="text-content-wrapper m-auto">
                <h2 class="cta-title">Ready to Start Your Next Home Project?</h2>
                <p class="cta-subtitle mb-4">Connect with verified professionals and brands to bring your vision to life today.</p>
                <div class="mt-4">
                    <a href="{{ path('professionals_list') }}" class="rbt-btn btn-cta radius-round py-3 px-5 expert-btn">Explore Services</a>
                </div>
            </div>
        </div>
    </section>
</main>

<script>
    // Simple intersection observer for fade-in animations on scroll
    document.addEventListener('DOMContentLoaded', function() {
        const observerOptions = {
            threshold: 0.1
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('fade-in-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.animate-on-scroll').forEach(el => {
            observer.observe(el);
        });
    });
</script>
{% endblock %}
