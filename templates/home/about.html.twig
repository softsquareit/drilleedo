{% extends 'base.html.twig' %}

{% block title %}{{ 'about.meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'about.meta_desc'|trans }}{% endblock %}

{% block body %}
<main id="main-content">
<script src="https://unpkg.com/@phosphor-icons/web"></script>
<style>
/* ══ ABOUT PAGE ════════════════════════════════════════════════════════════
   Charte : --B:#00497F · --S:#3FA9F5 · --O:#FF8A3D · --D:#0C1825 · --M:#4A6073
   ══════════════════════════════════════════════════════════════════════════ */
:root {
    --B:#00497F; --S:#3FA9F5; --O:#FF8A3D; --D:#0C1825; --M:#4A6073;
    --L:#E4EBF2; --W:#fff;
    --sh: 0 4px 24px rgba(0,73,127,.10);
    --sh-md: 0 10px 40px rgba(0,73,127,.16);
    --r: 22px;
}
.ab-wrap { max-width:1140px; margin:0 auto; padding:0 24px; }
.ab-fade { opacity:0; transform:translateY(28px); transition:opacity .55s ease, transform .55s ease; }
.ab-fade.in { opacity:1; transform:none; }

/* ════════ 1. HERO ════════ */
.ab-hero {
    background: var(--B);
    padding: 100px 0 88px;
    position: relative; overflow: hidden; text-align: center;
}
.ab-hero::before {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,.035) 1px, transparent 1px);
    background-size: 26px 26px; pointer-events: none;
}
/* sky blue glow top-center */
.ab-hero::after {
    content: ''; position: absolute;
    left: 50%; top: -160px; transform: translateX(-50%);
    width: 860px; height: 860px; border-radius: 50%;
    background: radial-gradient(circle, rgba(63,169,245,.11) 0%, transparent 62%);
    pointer-events: none;
}
/* sky blue blob bottom-right */
.ab-hero-blob {
    position: absolute; bottom: -100px; right: -80px;
    width: 420px; height: 420px; border-radius: 50%;
    background: rgba(63,169,245,.07); pointer-events: none;
}
.ab-hero__inner { position: relative; z-index: 2; max-width: 780px; margin: 0 auto; padding: 0 20px; }

.ab-hero-eyebrow {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(63,169,245,.18); color: var(--S);
    border: 1px solid rgba(63,169,245,.38); border-radius: 999px;
    padding: 7px 20px; font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase; margin-bottom: 24px;
}
.ab-hero h1 {
    font-size: clamp(30px, 4.8vw, 56px);
    font-weight: 900; color: #fff; margin: 0 0 8px;
    line-height: 1.06; letter-spacing: -.025em;
}
.ab-hero h1 span { color: var(--S); }
.ab-hero__tagline {
    font-size: 17px; color: rgba(255,255,255,.72);
    max-width: 640px; margin: 18px auto 36px; line-height: 1.78;
}
.ab-hero__tagline strong { color: rgba(255,255,255,.92); }
.ab-hero-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

/* trust pills under hero buttons */
.ab-hero-trust {
    display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;
    margin-top: 28px;
}
.ab-hero-trust-pill {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(63,169,245,.12); color: rgba(255,255,255,.82);
    border: 1px solid rgba(63,169,245,.28); border-radius: 999px;
    padding: 5px 14px; font-size: 12px; font-weight: 700;
}
.ab-hero-trust-pill i { color: var(--S); }

/* ════════ 2. STATS STRIP ════════ */
.ab-stats {
    background: #fff;
    border-top: 4px solid var(--O);
    border-bottom: 1px solid var(--L);
    position: relative; z-index: 2;
    box-shadow: 0 4px 20px rgba(0,73,127,.08);
}
.ab-stats-grid {
    display: grid; grid-template-columns: repeat(4,1fr);
    max-width: 1100px; margin: 0 auto; padding: 0 24px;
}
.ab-stat-cell {
    display: flex; align-items: center; gap: 16px;
    padding: 26px 20px; border-right: 1px solid var(--L);
    transition: background .2s;
}
.ab-stat-cell:last-child { border-right: none; }
.ab-stat-cell:hover { background: #fafcff; }
.ab-stat-ico {
    width: 52px; height: 52px; border-radius: 14px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 22px;
}
.ab-stat-num { font-size: 24px; font-weight: 900; color: var(--B); line-height: 1; }
.ab-stat-lbl { font-size: 12px; color: var(--M); font-weight: 600; margin-top: 4px; }

/* ════════ PAGE BG ════════ */
.ab-bg { background: #f4f8fc; padding: 68px 0 84px; }

/* ════════ 3. STORY — blue split ════════ */
.ab-constat {
    display: grid; grid-template-columns: 1fr 1fr;
    border-radius: var(--r); overflow: hidden;
    box-shadow: 0 14px 56px rgba(0,73,127,.18);
    margin-bottom: 28px; min-height: 500px;
}
.ab-constat-img { position: relative; overflow: hidden; }
.ab-constat-img img { width:100%; height:100%; object-fit:cover; display:block; min-height:380px; }
.ab-constat-img::after {
    content:''; position:absolute; inset:0;
    background: linear-gradient(to right, rgba(0,73,127,.15), transparent);
}
.ab-constat-img-badge {
    position: absolute; bottom: 20px; left: 20px; z-index: 2;
    background: rgba(0,73,127,.92); backdrop-filter: blur(10px);
    border-radius: 14px; padding: 14px 20px;
    box-shadow: 0 4px 20px rgba(0,0,0,.22);
    border-left: 3px solid var(--O);
}
.ab-constat-img-badge__num { font-size: 24px; font-weight: 900; color: #fff; }
.ab-constat-img-badge__num span { color: var(--O); }
.ab-constat-img-badge__lbl { font-size: 11px; color: rgba(255,255,255,.65); margin-top: 3px; }

/* TEXT PANEL — now primary blue instead of near-black */
.ab-constat-body {
    background: var(--B);
    padding: 56px 52px;
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; justify-content: center;
}
.ab-constat-body::before {
    content:''; position:absolute; inset:0;
    background-image: radial-gradient(rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 26px 26px; pointer-events: none;
}
/* orange glow bottom-right */
.ab-constat-body::after {
    content:''; position:absolute; bottom:-100px; right:-60px;
    width:320px; height:320px; border-radius:50%;
    background: rgba(255,138,61,.10); pointer-events: none;
}
/* sky blue glow top-left */
.ab-constat-body-glow {
    position: absolute; top:-80px; left:-60px;
    width:280px; height:280px; border-radius:50%;
    background: rgba(63,169,245,.08); pointer-events: none;
}
.ab-constat-inner { position: relative; z-index: 2; }
.ab-constat-tag {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,138,61,.18); border: 1px solid rgba(255,138,61,.35);
    color: var(--O); font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase;
    padding: 5px 14px; border-radius: 50px; margin-bottom: 18px;
}
.ab-constat-title {
    font-size: clamp(21px, 2.6vw, 30px); font-weight: 900; color: #fff;
    margin: 0 0 18px; line-height: 1.2; letter-spacing: -.015em;
}
.ab-constat-title span { color: var(--O); }
.ab-constat-lead { font-size: 15px; color: rgba(255,255,255,.78); line-height: 1.8; margin-bottom: 20px; }
.ab-constat-body-text { font-size: 14px; color: rgba(255,255,255,.65); line-height: 1.82; margin-bottom: 16px; }
.ab-constat-body-text:last-of-type { margin-bottom: 0; }
.ab-constat-body-text strong { color: rgba(255,255,255,.92); }

/* ════════ 4. MISSION & VISION ════════ */
.ab-mv { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 28px; }
.ab-mv-card {
    background: #fff; border-radius: var(--r); overflow: hidden;
    box-shadow: var(--sh); transition: box-shadow .22s, transform .22s;
    border-top: 4px solid transparent;
}
.ab-mv-card:hover { box-shadow: var(--sh-md); transform: translateY(-4px); }
.ab-mv-card--mission { border-top-color: var(--O); }
.ab-mv-card--vision  { border-top-color: var(--S); }
.ab-mv-card-img { overflow: hidden; height: 230px; }
.ab-mv-card-img img { width:100%; height:100%; object-fit:cover; display:block; transition: transform .5s; }
.ab-mv-card:hover .ab-mv-card-img img { transform: scale(1.05); }
.ab-mv-card-body { padding: 32px 36px 36px; }
.ab-mv-label {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    margin-bottom: 10px; padding: 4px 12px; border-radius: 6px;
}
.ab-mv-label--mission { background: rgba(255,138,61,.1); color: var(--O); }
.ab-mv-label--vision  { background: rgba(63,169,245,.1); color: var(--S); }
.ab-mv-title { font-size: 20px; font-weight: 900; color: var(--B) !important; margin: 0 0 12px; line-height: 1.2; }
.ab-mv-text  { font-size: 14px; color: var(--M); line-height: 1.82; margin: 0 0 10px; }
.ab-mv-text:last-of-type { margin: 0; }
.ab-mv-text strong { color: var(--D); }
.ab-mv-list { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-direction: column; gap: 10px; }
.ab-mv-list li { display: flex; gap: 10px; align-items: flex-start; font-size: 13px; color: var(--M); line-height: 1.6; }
.ab-mv-list-dot {
    width: 22px; height: 22px; border-radius: 6px; flex-shrink: 0;
    background: rgba(63,169,245,.12); color: var(--S);
    display: flex; align-items: center; justify-content: center; font-size: 11px; margin-top: 1px;
}

/* ════════ 5. VALEURS ════════ */
.ab-values-section {
    background: #fff; border-radius: var(--r);
    box-shadow: var(--sh); margin-bottom: 28px; overflow: hidden;
}
.ab-values-hd {
    padding: 48px 52px 38px; border-bottom: 1px solid var(--L); text-align: center;
    background: #fff; position: relative; overflow: hidden;
}
/* subtle orange accent top-right */
.ab-values-hd::after {
    content:''; position:absolute; top:-40px; right:-40px;
    width:200px; height:200px; border-radius:50%;
    background: rgba(255,138,61,.05); pointer-events:none;
}
.ab-values-pill {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,138,61,.1); color: var(--O);
    border: 1px solid rgba(255,138,61,.25); border-radius: 999px;
    padding: 6px 18px; font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase; margin-bottom: 14px;
}
.ab-values-title { font-size: clamp(22px,3vw,30px); font-weight: 900; color: var(--B) !important; margin: 0 0 10px; letter-spacing: -.015em; }
.ab-values-title span { color: var(--O); }
.ab-values-sub { font-size: 15px; color: var(--M); max-width: 520px; margin: 0 auto; line-height: 1.75; }

.ab-val5-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
.ab-val5-card {
    padding: 36px 40px;
    border-right: 1px solid var(--L); border-bottom: 1px solid var(--L);
    transition: background .2s; position: relative;
    border-left: 3px solid transparent;
}
.ab-val5-card:hover { background: #fafcff; }
.ab-val5-card:nth-child(2n) { border-right: none; }
.ab-val5-card--full { grid-column: 1 / -1; border-right: none; border-left: none; border-bottom: none; }
/* colored left accent per card */
.ab-val5-card:nth-child(1) { border-left-color: var(--B); }
.ab-val5-card:nth-child(2) { border-left-color: var(--O); }
.ab-val5-card:nth-child(3) { border-left-color: var(--S); }
.ab-val5-card:nth-child(4) { border-left-color: var(--S); }
.ab-val5-card--full { border-top: 1px solid var(--L); background: #f4f8fc; }
.ab-val5-card--full:hover { background: #edf3fa; }
.ab-val5-head { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
.ab-val5-ico {
    width: 50px; height: 50px; border-radius: 14px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 22px;
}
.ab-val5-name { font-size: 17px; font-weight: 900; color: var(--B) !important; margin: 0 0 3px; }
.ab-val5-lbl {
    display: inline-block; font-size: 10px; font-weight: 800; letter-spacing: .08em;
    text-transform: uppercase; padding: 2px 8px; border-radius: 6px;
}
.ab-val5-text { font-size: 14px; color: var(--M); line-height: 1.82; margin: 0; }
.ab-val5-text strong { color: var(--D); }

/* ════════ 6. ENGAGEMENT CANADIEN ════════ */
.ab-canada {
    display: grid; grid-template-columns: 1fr 1fr;
    border-radius: var(--r); overflow: hidden;
    box-shadow: 0 14px 56px rgba(0,73,127,.18);
    margin-bottom: 28px; min-height: 460px;
}
.ab-canada-img { position: relative; overflow: hidden; }
.ab-canada-img img { width:100%; height:100%; object-fit:cover; display:block; min-height:360px; }
.ab-canada-img::before {
    content:''; position:absolute; inset:0; z-index:1;
    background: linear-gradient(to right, transparent 55%, rgba(0,73,127,.08) 100%);
}
.ab-canada-flag {
    position: absolute; top: 20px; left: 20px; z-index: 2;
    background: rgba(255,255,255,.95); backdrop-filter: blur(8px);
    border-radius: 10px; padding: 9px 16px;
    font-size: 14px; font-weight: 800; color: var(--D);
    box-shadow: 0 4px 14px rgba(0,0,0,.12);
}
.ab-canada-provinces {
    position: absolute; bottom: 20px; left: 20px; z-index: 2;
    background: rgba(0,73,127,.88); backdrop-filter: blur(10px);
    border-radius: 12px; padding: 12px 18px;
    font-size: 12px; color: rgba(255,255,255,.78); font-weight: 600; line-height: 1.6;
    border-left: 3px solid var(--S);
}

/* TEXT PANEL — primary blue */
.ab-canada-body {
    background: var(--B);
    padding: 56px 52px;
    display: flex; flex-direction: column; justify-content: center;
    position: relative; overflow: hidden;
}
.ab-canada-body::before {
    content:''; position:absolute; inset:0;
    background-image: radial-gradient(rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 26px 26px; pointer-events: none;
}
.ab-canada-body::after {
    content:''; position:absolute; bottom:-80px; right:-60px;
    width:300px; height:300px; border-radius:50%;
    background: rgba(63,169,245,.08); pointer-events:none;
}
.ab-canada-inner { position: relative; z-index: 2; }
.ab-canada-tag {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,138,61,.18); border: 1px solid rgba(255,138,61,.35);
    color: var(--O); font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase;
    padding: 5px 14px; border-radius: 50px; margin-bottom: 16px;
}
.ab-canada-title {
    font-size: clamp(20px,2.6vw,30px); font-weight: 900; color: #fff;
    margin: 0 0 14px; line-height: 1.2; letter-spacing: -.015em;
}
.ab-canada-title span { color: var(--S); }
.ab-canada-text { font-size: 14px; color: rgba(255,255,255,.72); line-height: 1.82; margin: 0 0 14px; }
.ab-canada-text:last-of-type { margin: 0; }
.ab-canada-text strong { color: var(--O); }
.ab-canada-provinces-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
.ab-canada-prov {
    background: rgba(255,255,255,.12); color: rgba(255,255,255,.85);
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 999px; padding: 5px 14px;
    font-size: 12px; font-weight: 700; transition: background .18s;
}
.ab-canada-prov:hover { background: rgba(255,255,255,.2); }

/* ════════ 7. TÉMOIGNAGES ════════ */
.ab-testi-section {
    background: #fff; border-radius: var(--r);
    box-shadow: var(--sh); margin-bottom: 28px; overflow: hidden;
}
.ab-testi-hd {
    padding: 48px 52px 38px; border-bottom: 1px solid var(--L); text-align: center;
}
.ab-testi-hd__pill {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,138,61,.1); color: var(--O);
    border: 1px solid rgba(255,138,61,.22); border-radius: 999px;
    padding: 6px 18px; font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase; margin-bottom: 12px;
}
.ab-testi-hd__title { font-size: clamp(20px,2.8vw,28px); font-weight: 900; color: var(--B) !important; margin: 0 0 8px; letter-spacing: -.015em; }
.ab-testi-hd__sub { font-size: 15px; color: var(--M); max-width: 480px; margin: 0 auto; }

.ab-testi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
.ab-testi-col { padding: 36px 40px; border-right: 1px solid var(--L); }
.ab-testi-col:last-child { border-right: none; }
.ab-testi-col-label {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
    margin-bottom: 24px; padding: 5px 14px; border-radius: 8px;
}
.ab-testi-card {
    background: #f8fafc; border: 1px solid var(--L);
    border-radius: 16px; padding: 22px 24px 20px;
    margin-bottom: 16px; transition: box-shadow .2s, transform .2s;
    position: relative;
}
.ab-testi-card:hover { box-shadow: 0 6px 24px rgba(0,73,127,.1); transform: translateY(-2px); }
.ab-testi-card:last-child { margin-bottom: 0; }
.ab-testi-quote {
    font-size: 36px; font-weight: 900; line-height: .9; margin-bottom: 10px; opacity: .55;
}
/* alternating quote colors */
.ab-testi-col:first-child .ab-testi-card:nth-child(odd) .ab-testi-quote   { color: var(--B); }
.ab-testi-col:first-child .ab-testi-card:nth-child(even) .ab-testi-quote  { color: var(--O); }
.ab-testi-col:last-child .ab-testi-card:nth-child(odd) .ab-testi-quote    { color: var(--O); }
.ab-testi-col:last-child .ab-testi-card:nth-child(even) .ab-testi-quote   { color: var(--S); }
.ab-testi-text { font-size: 13px; color: var(--M); line-height: 1.78; margin: 0 0 14px; font-style: italic; }
.ab-testi-author { display: flex; align-items: center; gap: 10px; }
.ab-testi-avatar {
    width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 15px; font-weight: 900; color: #fff;
}
.ab-testi-name { font-size: 13px; font-weight: 800; color: var(--D); }
.ab-testi-role { font-size: 11px; color: var(--M); }
.ab-testi-badge {
    position: absolute; top: 16px; right: 16px;
    font-size: 10px; font-weight: 700; padding: 3px 10px; border-radius: 6px;
    letter-spacing: .04em;
}
/* star rating */
.ab-testi-stars { color: #F59E0B; font-size: 11px; letter-spacing: 1px; margin-bottom: 6px; }

/* ════════ 8. CTA FINAL ════════ */
.ab-final-cta {
    background: var(--B);
    border-radius: var(--r); padding: 68px 52px;
    text-align: center; box-shadow: 0 14px 56px rgba(0,73,127,.24);
    position: relative; overflow: hidden;
}
.ab-final-cta::before {
    content:''; position:absolute; inset:0;
    background-image: radial-gradient(rgba(255,255,255,.035) 1px, transparent 1px);
    background-size: 26px 26px; pointer-events:none;
}
/* orange glow right */
.ab-final-cta::after {
    content:''; position:absolute; top:-100px; right:-80px;
    width:400px; height:400px; border-radius:50%;
    background: rgba(255,138,61,.09); pointer-events:none;
}
/* sky blue glow left */
.ab-final-glow-l {
    position:absolute; bottom:-80px; left:-60px;
    width:320px; height:320px; border-radius:50%;
    background: rgba(63,169,245,.07); pointer-events:none;
}
.ab-final-cta__inner { position: relative; z-index: 2; max-width: 680px; margin: 0 auto; }
.ab-final-cta__tag {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,138,61,.18); border: 1px solid rgba(255,138,61,.35);
    color: var(--O); font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase;
    padding: 5px 14px; border-radius: 50px; margin-bottom: 20px;
}
.ab-final-cta h2 {
    font-size: clamp(24px,3.6vw,38px); font-weight: 900; color: #fff;
    margin: 0 0 12px; line-height: 1.15; letter-spacing: -.02em;
}
.ab-final-cta h2 span { color: var(--O); }
.ab-final-cta__sub {
    font-size: 16px; color: rgba(255,255,255,.65);
    max-width: 520px; margin: 0 auto 38px; line-height: 1.75;
}
.ab-final-cta-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

/* ── Shared Buttons ── */
.ab-btn-o {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--O); color: #fff; font-size: 15px; font-weight: 800;
    padding: 14px 30px; border-radius: 50px; text-decoration: none;
    box-shadow: 0 4px 18px rgba(255,138,61,.40); transition: all .22s;
}
.ab-btn-o:hover { background: #e87830; transform: translateY(-2px); color: #fff; box-shadow: 0 8px 28px rgba(255,138,61,.50); }
.ab-btn-s {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--S); color: #fff; font-size: 15px; font-weight: 800;
    padding: 14px 28px; border-radius: 50px; text-decoration: none;
    box-shadow: 0 4px 16px rgba(63,169,245,.36); transition: all .22s;
}
