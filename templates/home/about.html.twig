{# ══════════════════════════════════════════════════════════════════════════
   4. CORE VALUES
══════════════════════════════════════════════════════════════════════════ #}
<section class="au-section au-section--gray au-scroll" aria-labelledby="values-heading">
  <div class="container">
    <div class="text-center">
      <div class="au-section-eyebrow">
        <i class="fas fa-gem" aria-hidden="true"></i>
        What We Stand For
      </div>
      <h2 class="au-section-title" id="values-heading">Our Core Values</h2>
      <p class="au-section-sub mx-auto">
        Every decision we make is guided by these principles that define who we are.
      </p>
    </div>

    <div class="au-values-grid">
      <div class="au-val-card">
        <div class="au-val-icon" style="background: linear-gradient(135deg,#0d2151,#1a3a6b);">
          <i class="feather-shield" aria-hidden="true" style="font-size:24px;color:#fff;"></i>
        </div>
        <h3 class="au-val-title">Trust & Safety</h3>
        <p class="au-val-desc">Every professional on our platform is manually verified and reviewed. Homeowners can hire with complete confidence.</p>
      </div>
      <div class="au-val-card">
        <div class="au-val-icon" style="background: linear-gradient(135deg,#00509e,#2196f3);">
          <i class="feather-eye" aria-hidden="true" style="font-size:24px;color:#fff;"></i>
