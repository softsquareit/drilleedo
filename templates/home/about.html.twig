<script>
// FAQ accordion
function auFaq(btn) {
  const body  = btn.nextElementSibling;
  const arrow = btn.querySelector('.au-faq-arrow');
  const isOpen = body.classList.contains('open');

  // Close all
  document.querySelectorAll('.au-faq-body.open').forEach(b => b.classList.remove('open'));
  document.querySelectorAll('.au-faq-trigger.open').forEach(b => {
    b.classList.remove('open');
    b.setAttribute('aria-expanded', 'false');
  });

  if (!isOpen) {
    body.classList.add('open');
    btn.classList.add('open');
    btn.setAttribute('aria-expanded', 'true');
  }
}

// Scroll animations
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.08 });

document.querySelectorAll('.au-scroll').forEach(el => obs.observe(el));
</script>

