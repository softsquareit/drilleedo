{% extends 'base.html.twig' %}

{% block title %}{{ 'pro_landing.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'pro_landing.meta_desc'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ═══════════════════════════════════════════
   BRAND TOKENS (page-scoped)
═══════════════════════════════════════════ */
:root {
    --B: #00497F;   /* Helper Blue */
    --S: #3FA9F5;   /* Action Sky  */
    --O: #FF8A3D;   /* Toolbox Orange */
    --D: #0C1825;   /* Dark navy */
    --M: #4A6073;   /* Medium body */
}

/* ═══════════════════════════════════════════
   GLOBAL
═══════════════════════════════════════════ */
.pro-page { font-family: 'Instrument Sans', system-ui, sans-serif; }

/* ═══════════════════════════════════════════
   BREADCRUMB
═══════════════════════════════════════════ */
.pro-breadcrumb {
    background: var(--D);
    padding: 10px 0;
}
.pro-breadcrumb a { color: rgba(255,255,255,.55); font-size: 12px; text-decoration: none; transition: color .15s; }
.pro-breadcrumb a:hover { color: #fff; }
.pro-breadcrumb .sep { color: rgba(255,255,255,.3); margin: 0 7px; font-size: 12px; }
.pro-breadcrumb strong { color: rgba(255,255,255,.9); font-size: 12px; }

/* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ */
.pro-hero {
    background: linear-gradient(135deg, var(--D) 0%, #0a3660 60%, var(--B) 100%);
    padding: 70px 0 0;
    overflow: hidden;
    position: relative;
}
/* dot texture */
.pro-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(63,169,245,.1) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
    z-index: 0;
}
.pro-hero::after {
    content: '';
    position: absolute; bottom: 0; left: 0; right: 0;
    height: 80px;
    background: linear-gradient(to top, #f0f6ff, transparent);
    pointer-events: none;
    z-index: 1;
}
.pro-hero-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(63,169,245,.15); border: 1px solid rgba(63,169,245,.4);
    color: var(--S); font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase;
    padding: 6px 16px; border-radius: 50px; margin-bottom: 22px;
}
.pro-hero h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 900; color: #fff; line-height: 1.1;
    margin-bottom: 22px; letter-spacing: -.02em;
}
.pro-hero h1 .hl { color: var(--S); }
.pro-hero-lead {
    font-size: 1.1rem; color: rgba(255,255,255,.75);
    line-height: 1.75; margin-bottom: 36px; max-width: 540px;
}
.pro-hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 44px; }
.btn-cta-primary {
    display: inline-flex; align-items: center; gap: 9px;
    background: var(--O); color: #fff;
    font-size: 15px; font-weight: 700;
    padding: 15px 32px; border-radius: 12px;
    text-decoration: none; transition: all .2s;
    box-shadow: 0 4px 18px rgba(255,138,61,.4);
}
.btn-cta-primary:hover { background: #e07830; color: #fff; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(255,138,61,.45); }
.btn-cta-outline {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,.1); color: #fff;
    font-size: 15px; font-weight: 600;
    padding: 14px 28px; border-radius: 12px;
    text-decoration: none; border: 1.5px solid rgba(255,255,255,.3);
    transition: all .2s;
}
.btn-cta-outline:hover { background: rgba(255,255,255,.18); color: #fff; }
.pro-hero-trust { display: flex; align-items: center; gap: 16px; }
.pro-hero-trust-faces { display: flex; }
.pro-hero-trust-faces img {
    width: 34px; height: 34px; border-radius: 50%;
    border: 2px solid rgba(255,255,255,.4); object-fit: cover;
    margin-left: -8px;
}
.pro-hero-trust-faces img:first-child { margin-left: 0; }
.pro-hero-trust-text { font-size: 13px; color: rgba(255,255,255,.75); }
.pro-hero-trust-text strong { color: #fff; }

/* Hero image col */
.pro-hero-img-col { position: relative; display: flex; align-items: flex-end; justify-content: center; z-index: 2; }
.pro-hero-img {
    width: 100%; max-width: 460px;
    border-radius: 20px 20px 0 0;
    object-fit: cover; object-position: top;
    height: 460px;
    display: block;
    box-shadow: -20px 0 60px rgba(0,0,0,.3);
}

/* Floating stat cards */
.pro-stat-float {
    position: absolute;
    background: #fff; border-radius: 14px;
    padding: 14px 18px;
    box-shadow: 0 8px 32px rgba(0,0,0,.15);
    display: flex; align-items: center; gap: 12px;
    white-space: nowrap;
}
.pro-stat-float-1 { left: -10px; top: 60px; }
.pro-stat-float-2 { right: 10px; top: 180px; }
.pro-stat-float-3 { left: 0px; bottom: 80px; }
.pro-stat-float-icon {
    width: 38px; height: 38px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; flex-shrink: 0;
}
.pro-stat-float-icon.blue  { background: #dde9ff; color: var(--B); }
.pro-stat-float-icon.green { background: #d1fae5; color: #059669; }
.pro-stat-float-icon.orange { background: #fff0e0; color: var(--O); }
.pro-stat-float-val { font-size: 18px; font-weight: 900; color: var(--D); line-height: 1; }
.pro-stat-float-lbl { font-size: 11px; color: var(--M); font-weight: 500; margin-top: 2px; }

/* Image badge overlay */
.pro-img-wrap { position: relative; display: inline-block; width: 100%; }
.pro-img-badge {
    position: absolute; bottom: 20px; right: 20px;
    background: #fff; border-radius: 12px;
    padding: 10px 16px; box-shadow: 0 6px 20px rgba(0,0,0,.15);
    display: flex; align-items: center; gap: 10px;
}
.pro-img-badge-icon { width: 32px; height: 32px; border-radius: 8px; background: #fff0e0; color: var(--O); display: flex; align-items: center; justify-content: center; font-size: 14px; }
.pro-img-badge-val { font-size: 16px; font-weight: 900; color: var(--D); line-height: 1; }
.pro-img-badge-lbl { font-size: 11px; color: var(--M); }
.pro-mission-img-wrap { position: relative; }
.pro-mission-img-tag {
    position: absolute; bottom: 24px; right: 24px;
    background: rgba(255,255,255,.12); backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,.25); border-radius: 12px;
    padding: 10px 16px; color: #fff;
}
.pro-mission-img-tag-num { font-size: 20px; font-weight: 900; line-height: 1; color: var(--S); }
.pro-mission-img-tag-lbl { font-size: 11px; opacity: .75; margin-top: 2px; }

/* ═══════════════════════════════════════════
   OBJECTIF / STATS BAND
═══════════════════════════════════════════ */
.pro-stats-band {
    background: #f0f6ff;
    padding: 48px 0;
    border-bottom: 1px solid #dde9ff;
}
.pro-stats-band-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0;
}
.pro-stat-item {
    text-align: center;
    padding: 20px 24px;
    border-right: 1px solid #dde9ff;
}
.pro-stat-item:last-child { border-right: none; }
.pro-stat-val {
    font-size: 2.4rem; font-weight: 900; color: var(--B);
    line-height: 1; margin-bottom: 6px;
    letter-spacing: -.03em;
}
.pro-stat-val span { color: var(--O); }
.pro-stat-lbl { font-size: 13px; color: var(--M); font-weight: 500; }

/* ═══════════════════════════════════════════
   OBJECTIF SECTION
═══════════════════════════════════════════ */
.pro-objective {
    background: #fff;
    padding: 80px 0;
}
.pro-objective-tag {
    display: inline-flex; align-items: center; gap: 7px;
    background: #fff0e0; color: var(--O);
    font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    padding: 6px 14px; border-radius: 50px;
    margin-bottom: 16px;
}
.pro-section-title {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 900; color: var(--D); line-height: 1.2;
    letter-spacing: -.02em; margin-bottom: 16px;
}
.pro-section-title .hl { color: var(--B); }
.pro-section-sub { font-size: 15px; color: var(--M); line-height: 1.8; margin-bottom: 32px; }

.pro-objective-img {
    width: 100%; border-radius: 20px;
    object-fit: cover; height: 380px;
    box-shadow: 0 16px 48px rgba(0,73,127,.12);
}

.pro-check-list { list-style: none; padding: 0; margin: 0 0 32px; }
.pro-check-list li {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 10px 0; border-bottom: 1px solid #f1f5f9;
    font-size: 14px; color: var(--D); line-height: 1.5;
}
.pro-check-list li:last-child { border-bottom: none; }
.pro-check-list li .check-icon {
    width: 22px; height: 22px; border-radius: 50%;
    background: var(--B); color: #fff;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; font-size: 11px; margin-top: 1px;
}

/* ═══════════════════════════════════════════
   BUT / MISSION SPLIT SECTION
═══════════════════════════════════════════ */
.pro-mission {
    background: linear-gradient(135deg, var(--D), #0f3d6b);
    padding: 80px 0;
    position: relative; overflow: hidden;
}
.pro-mission::before {
    content: '';
    position: absolute; top: -60px; right: -60px;
    width: 340px; height: 340px;
    border-radius: 50%;
    background: rgba(63,169,245,.08);
    pointer-events: none;
}
.pro-mission-tag {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(63,169,245,.15); border: 1px solid rgba(63,169,245,.3);
    color: var(--S); font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    padding: 6px 14px; border-radius: 50px; margin-bottom: 18px;
}
.pro-mission h2 {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 900; color: #fff; line-height: 1.2;
    letter-spacing: -.02em; margin-bottom: 18px;
}
.pro-mission h2 span { color: var(--S); }
.pro-mission-lead {
    font-size: 15px; color: rgba(255,255,255,.75); line-height: 1.8; margin-bottom: 32px;
}
.pro-mission-points { display: flex; flex-direction: column; gap: 16px; }
.pro-mission-point {
    display: flex; align-items: flex-start; gap: 14px;
    background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1);
    border-radius: 12px; padding: 16px 18px;
}
.pro-mission-point-icon {
    width: 40px; height: 40px; border-radius: 10px;
    background: rgba(63,169,245,.2); color: var(--S);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; font-size: 16px;
}
.pro-mission-point-title { font-size: 14px; font-weight: 700; color: #fff; margin-bottom: 3px; }
.pro-mission-point-text { font-size: 13px; color: rgba(255,255,255,.65); line-height: 1.5; }
.pro-mission-img {
    width: 100%; border-radius: 20px;
    object-fit: cover; height: 440px;
    box-shadow: 0 20px 50px rgba(0,0,0,.35);
}

/* ═══════════════════════════════════════════
   STEPS SECTION
═══════════════════════════════════════════ */
.pro-steps {
    background: #f4f8ff;
    padding: 80px 0;
}
.pro-steps-header { text-align: center; margin-bottom: 60px; }
.pro-section-label {
    display: inline-block;
    font-size: 11px; font-weight: 800; letter-spacing: .1em;
    text-transform: uppercase; color: var(--S);
    margin-bottom: 10px;
}
.pro-steps-timeline { display: flex; flex-direction: column; gap: 0; }
.pro-step-row {
    display: grid; grid-template-columns: 1fr 60px 1fr;
    gap: 0; align-items: center;
    margin-bottom: 8px;
}
.pro-step-row.reverse .pro-step-content { order: 3; text-align: right; }
.pro-step-row.reverse .pro-step-center { order: 2; }
.pro-step-row.reverse .pro-step-img-col { order: 1; }
.pro-step-center {
    display: flex; flex-direction: column; align-items: center;
}
.pro-step-circle {
    width: 52px; height: 52px; border-radius: 50%;
    background: var(--B); color: #fff;
    font-size: 18px; font-weight: 900;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 0 6px rgba(0,73,127,.12);
    position: relative; z-index: 2;
    flex-shrink: 0;
}
.pro-step-line {
    width: 2px; height: 60px;
    background: linear-gradient(to bottom, var(--B), rgba(0,73,127,.1));
}
.pro-step-row:last-child .pro-step-line { display: none; }
.pro-step-content {
    background: #fff; border: 1px solid #e2e8f0;
    border-radius: 16px; padding: 24px 26px;
    transition: box-shadow .2s;
}
.pro-step-content:hover { box-shadow: 0 6px 24px rgba(0,73,127,.1); }
.pro-step-tag {
    font-size: 10px; font-weight: 800; letter-spacing: .1em;
    text-transform: uppercase; color: var(--S); margin-bottom: 6px;
}
.pro-step-title { font-size: 16px; font-weight: 800; color: var(--D); margin-bottom: 8px; }
.pro-step-text { font-size: 13px; color: var(--M); line-height: 1.7; margin: 0; }
.pro-step-img-col img {
    width: 100%; height: 180px; object-fit: cover;
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(0,0,0,.1);
}

/* ═══════════════════════════════════════════
   ADVANTAGES SECTION
═══════════════════════════════════════════ */
.pro-adv {
    background: #fff;
    padding: 80px 0;
}
.pro-adv-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 50px;
}
.pro-adv-card {
    background: #f4f8ff;
    border: 1px solid #dde9ff;
    border-radius: 18px;
    padding: 30px 26px;
    transition: box-shadow .2s, transform .2s;
    position: relative; overflow: hidden;
}
.pro-adv-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--B), var(--S));
    border-radius: 18px 18px 0 0;
}
.pro-adv-card:hover { box-shadow: 0 12px 32px rgba(0,73,127,.1); transform: translateY(-4px); }
.pro-adv-card-icon {
    width: 52px; height: 52px; border-radius: 14px;
    background: linear-gradient(135deg, var(--B), #0066b3);
    color: #fff; font-size: 20px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 18px;
    box-shadow: 0 6px 16px rgba(0,73,127,.25);
}
.pro-adv-card-title { font-size: 16px; font-weight: 800; color: var(--D); margin-bottom: 10px; }
.pro-adv-card-text { font-size: 13px; color: var(--M); line-height: 1.7; margin: 0; }

/* ═══════════════════════════════════════════
   SOCIAL PROOF
═══════════════════════════════════════════ */
.pro-social {
    background: linear-gradient(135deg, #f0f6ff, #e8f0fb);
    padding: 70px 0;
    border-top: 1px solid #dde9ff;
}
.pro-social-faces-grid {
    display: flex; flex-wrap: wrap; gap: 10px;
    margin-bottom: 20px;
}
.pro-social-face {
    width: 54px; height: 54px; border-radius: 50%;
    object-fit: cover; border: 3px solid #fff;
    box-shadow: 0 4px 12px rgba(0,0,0,.1);
    transition: transform .2s;
}
.pro-social-face:hover { transform: scale(1.1) translateY(-3px); }
.pro-social-stats { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
.pro-social-stat-num { font-size: 1.7rem; font-weight: 900; color: var(--B); line-height: 1; }
.pro-social-stat-lbl { font-size: 12px; color: var(--M); margin-top: 3px; }
.pro-social-divider { width: 1px; height: 38px; background: #dde9ff; }
.pro-testimonial {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 16px;
    padding: 26px 28px; position: relative; margin-top: 4px;
}
.pro-testimonial::before {
    content: '"'; position: absolute; top: 8px; left: 20px;
    font-size: 72px; font-weight: 900; color: #dde9ff; line-height: 1;
    font-family: Georgia, serif;
}
.pro-testimonial-text { font-size: 14px; color: var(--M); line-height: 1.7; margin: 0 0 14px; padding-top: 20px; }
.pro-testimonial-author { font-size: 13px; font-weight: 700; color: var(--B); }
.pro-stars { color: var(--O); font-size: 13px; margin-bottom: 8px; }

/* ═══════════════════════════════════════════
   CTA FINALE
═══════════════════════════════════════════ */
.pro-cta {
    background: linear-gradient(135deg, var(--D), var(--B));
    padding: 90px 0;
    text-align: center;
    position: relative; overflow: hidden;
}
.pro-cta::before {
    content: '';
    position: absolute; top: -100px; left: 50%;
    transform: translateX(-50%);
    width: 600px; height: 600px; border-radius: 50%;
    background: rgba(63,169,245,.06);
    pointer-events: none;
}
.pro-cta h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 900; color: #fff; line-height: 1.2;
    letter-spacing: -.02em; margin-bottom: 16px;
}
.pro-cta h2 span { color: var(--S); }
.pro-cta p { font-size: 1.05rem; color: rgba(255,255,255,.75); margin-bottom: 38px; }
.pro-cta-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 16px; }
.pro-cta-note { font-size: 12px; color: rgba(255,255,255,.5); margin-top: 20px; }
.pro-cta-note i { margin-right: 4px; }

/* ═══════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════ */
@media (max-width: 991px) {
    .pro-hero { padding: 50px 0 0; }
    .pro-hero-img { height: 320px; }
    .pro-stat-float { display: none; }
    .pro-step-row { grid-template-columns: 1fr; gap: 12px; }
    .pro-step-row.reverse .pro-step-content { order: 0; text-align: left; }
    .pro-step-row.reverse .pro-step-center { order: 0; }
    .pro-step-row.reverse .pro-step-img-col { order: 0; }
    .pro-step-center { flex-direction: row; gap: 12px; }
    .pro-step-line { width: 40px; height: 2px; }
    .pro-step-img-col { display: none; }
    .pro-stat-item { border-right: none; border-bottom: 1px solid #dde9ff; }
    .pro-stat-item:last-child { border-bottom: none; }
}
@media (max-width: 767px) {
    .pro-hero h1 { font-size: 1.9rem; }
    .pro-cta h2 { font-size: 1.7rem; }
    .btn-cta-outline { margin-top: 0; }
}
</style>
{% endblock %}

{% block body %}
<div class="pro-page">

{# ── Breadcrumb ── #}
<div class="pro-breadcrumb">
    <div class="container">
        <a href="{{ path('app_home') }}">{{ 'pro_landing.bc_home'|trans }}</a>
        <span class="sep">/</span>
        <a href="{{ path('app_how_it_works') }}">{{ 'pro_landing.bc_how'|trans }}</a>
        <span class="sep">/</span>
        <strong>{{ 'pro_landing.bc_current'|trans }}</strong>
    </div>
</div>

{# ══════════════════════════════════════════
   HERO
══════════════════════════════════════════ #}
<section class="pro-hero">
    <div class="container">
        <div class="row align-items-end g-4">
            <div class="col-lg-6 pb-5" style="position:relative;z-index:2;">
                <div class="pro-hero-eyebrow">
                    <i class="feather-briefcase"></i> {{ 'pro_landing.hero_eyebrow'|trans }}
                </div>
                <h1>{{ 'pro_landing.hero_h1'|trans|raw }}</h1>
                <p class="pro-hero-lead">{{ 'pro_landing.hero_lead'|trans }}</p>
                <div class="pro-hero-actions">
                    <a href="{{ path('app_register') }}" class="btn-cta-primary">
                        <i class="feather-user-plus"></i> {{ 'pro_landing.hero_btn_register'|trans }}
                    </a>
                    <a href="#how-it-works" class="btn-cta-outline">
                        <i class="feather-play-circle"></i> {{ 'pro_landing.hero_btn_how'|trans }}
                    </a>
                </div>
                <div class="pro-hero-trust">
                    <div class="pro-hero-trust-faces">
                        <img src="{{ asset('assets/drilleedo/images/team/team-01.jpg') }}" alt="{{ 'pro_landing.hero_img_alt'|trans }}">
                        <img src="{{ asset('assets/drilleedo/images/team/team-02.jpg') }}" alt="{{ 'pro_landing.hero_img_alt'|trans }}">
                        <img src="{{ asset('assets/drilleedo/images/team/team-03.jpg') }}" alt="{{ 'pro_landing.hero_img_alt'|trans }}">
                        <img src="{{ asset('assets/drilleedo/images/team/team-04.jpg') }}" alt="{{ 'pro_landing.hero_img_alt'|trans }}">
                    </div>
                    <div class="pro-hero-trust-text">
                        {{ 'pro_landing.hero_trust_text'|trans|raw }}
                    </div>
                </div>
            </div>
            <div class="col-lg-6 pro-hero-img-col">
                <img src="{{ asset('assets/drilleedo/images/stock/pro_portrait.jpg') }}"
                     alt="{{ 'pro_landing.hero_main_img_alt'|trans }}"
                     class="pro-hero-img">
                <div class="pro-stat-float pro-stat-float-1">
                    <div class="pro-stat-float-icon blue"><i class="feather-briefcase"></i></div>
                    <div>
                        <div class="pro-stat-float-val">+1 500</div>
                        <div class="pro-stat-float-lbl">{{ 'pro_landing.float_pros_lbl'|trans }}</div>
                    </div>
                </div>
                <div class="pro-stat-float pro-stat-float-2">
