{% extends 'base.html.twig' %}

{% block title %}{{ 'ideas.meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'ideas.meta_desc'|trans }}{% endblock %}
{% block meta_keywords %}home renovation ideas, renovation inspiration, kitchen remodel ideas, bathroom renovation, home improvement tips Canada{% endblock %}
{% block og_title %}Home Renovation Ideas & Inspiration | Drilleedo{% endblock %}
{% block og_description %}Browse renovation and decoration ideas to inspire your next project. Smart ideas for better living.{% endblock %}

{% block body %}
<main id="main-content">
<style>
/* ══ SMART IDEAS PAGE — design charter: index.html.twig ══════════════════
   navy #0d2151 · blue #00509e · orange #e8501a
   Patterns: discovery-pill, gradient circles, card hover, fp- clean cards
   ═════════════════════════════════════════════════════════════════════════ */

/* ── 1. Hero ── */
.si-hero {
  min-height: 280px;
  background: linear-gradient(120deg, #0d2151 0%, #1a3a6b 50%, #00509e 100%);
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.si-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  /* photo overlay */
  background: var(--si-bg-img) center / cover no-repeat;
  opacity: 0.08;
}

.si-hero::after {
  content: '';
  position: absolute;
  right: -120px;
  bottom: -120px;
  width: 400px;
  height: 400px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232,80,26,0.18) 0%, transparent 70%);
  pointer-events: none;
}

.si-hero__inner {
  position: relative;
  z-index: 2;
  padding: 60px 0;
}

.si-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.9);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 999px;
  padding: 6px 16px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  margin-bottom: 16px;
}

.si-hero__title {
  font-size: clamp(28px, 4.5vw, 50px);
  font-weight: 900;
  color: #fff;
  margin: 0 0 14px;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.si-hero__title span { color: #f97316; }

.si-hero__sub {
  font-size: 17px;
  color: rgba(255,255,255,0.75);
  max-width: 540px;
  line-height: 1.7;
  margin-bottom: 26px;
}

.si-hero__count {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.12);
  color: #fff;
  border: 1px solid rgba(255,255,255,0.22);
  border-radius: 8px;
  padding: 9px 18px;
  font-size: 14px;
  font-weight: 700;
}

.si-hero__count span { color: #f97316; font-size: 18px; font-weight: 900; }

/* ── 2. Category chips strip ── */
.si-cats {
  background: #fff;
  border-bottom: 1px solid #e2e8f0;
  box-shadow: 0 2px 8px rgba(13,33,81,0.05);
  position: sticky;
  top: 0;
  z-index: 40;
  overflow-x: auto;
}

.si-cats::-webkit-scrollbar { height: 0; }

.si-cats__inner {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 28px;
  max-width: 1200px;
  margin: 0 auto;
  min-width: max-content;
}

.si-cat-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 16px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
  cursor: pointer;
  border: 1.5px solid #e2e8f0;
  background: #fff;
  color: #334155;
  transition: all 0.15s;
  text-decoration: none;
}

.si-cat-chip:hover,
.si-cat-chip.active {
  background: #0d2151;
  color: #fff;
  border-color: #0d2151;
}

/* ── 3. Main layout wrapper ── */
.si-page { max-width: 1200px; margin: 0 auto; padding: 0 28px; }
.si-wrap  { padding: 52px 0 80px; }

/* ── 4. Featured block (hero card + 3 side) ── */
.si-featured {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 40px;
}

/* Main featured card */
.si-card-main {
  border-radius: 16px;
  overflow: hidden;
  background: #fff;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(13,33,81,0.06);
  display: flex;
  flex-direction: column;
  transition: transform 0.22s, box-shadow 0.22s;
}

.si-card-main:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 36px rgba(13,33,81,0.13);
}

.si-card-main__img {
  height: 260px;
  overflow: hidden;
}

.si-card-main__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.38s;
}

.si-card-main:hover .si-card-main__img img { transform: scale(1.05); }

.si-card-main__body {
  padding: 22px 22px 20px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.si-card-cat {
  display: inline-block;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: #00509e;
  background: #e8f4fd;
  border-radius: 999px;
  padding: 3px 10px;
  margin-bottom: 10px;
}

.si-card-main__title {
  font-size: 20px;
  font-weight: 900;
  color: #0d2151;
  margin: 0 0 10px;
  line-height: 1.25;
}

.si-card-main__title a { color: inherit; text-decoration: none; }
.si-card-main__title a:hover { color: #00509e; }

.si-card-main__desc {
  font-size: 14px;
  color: #64748b;
  line-height: 1.7;
  flex: 1;
  margin-bottom: 16px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.si-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
  font-weight: 700;
  color: #e8501a;
  text-decoration: none;
  transition: gap 0.15s;
}

.si-link:hover { gap: 10px; color: #c43d10; }

/* Side cards column */
.si-side-col { display: flex; flex-direction: column; gap: 14px; }

.si-card-side {
  display: flex;
  gap: 14px;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s;
  flex: 1;
}

.si-card-side:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(13,33,81,0.1);
}

.si-card-side__img {
  width: 120px;
  flex-shrink: 0;
  overflow: hidden;
}

.si-card-side__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.35s;
}

.si-card-side:hover .si-card-side__img img { transform: scale(1.07); }

.si-card-side__body {
  padding: 14px 14px 14px 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
}

.si-card-side__title {
  font-size: 15px;
  font-weight: 800;
  color: #0d2151;
  margin: 0 0 8px;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.si-card-side__title a { color: inherit; text-decoration: none; }
.si-card-side__title a:hover { color: #00509e; }

/* ── 5. Separator ── */
.si-sep {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 28px;
}

.si-sep__line { flex: 1; height: 1px; background: #e2e8f0; }

.si-sep__label {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: #e8f4fd;
  color: #00509e;
  border: 1px solid rgba(0,80,158,0.18);
  border-radius: 999px;
  padding: 6px 16px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  white-space: nowrap;
}

/* ── 6. Ideas grid ── */
.si-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 52px;
}

.si-card-grid {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.22s, box-shadow 0.22s;
}

.si-card-grid:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 32px rgba(13,33,81,0.11);
}

.si-card-grid__img {
  height: 180px;
  overflow: hidden;
}

.si-card-grid__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.38s;
}

.si-card-grid:hover .si-card-grid__img img { transform: scale(1.06); }

.si-card-grid__body {
  padding: 16px 18px 18px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.si-card-grid__title {
  font-size: 16px;
  font-weight: 800;
  color: #0d2151;
  margin: 0 0 8px;
  line-height: 1.3;
  flex: 1;
}

.si-card-grid__title a { color: inherit; text-decoration: none; }
.si-card-grid__title a:hover { color: #00509e; }

.si-card-grid__desc {
  font-size: 13px;
  color: #64748b;
  line-height: 1.65;
  margin-bottom: 14px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── 7. Pagination ── */
.si-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-top: 8px;
}

.si-pagination a,
.si-pagination span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  border: 1.5px solid #e2e8f0;
  color: #0d2151;
  background: #fff;
  transition: all 0.15s;
}

.si-pagination a:hover { background: #0d2151; color: #fff; border-color: #0d2151; }
.si-pagination span.active { background: #00509e; color: #fff; border-color: #00509e; }

/* ── 8. Empty state ── */
.si-empty {
  text-align: center;
  padding: 80px 20px;
  grid-column: 1 / -1;
}

.si-empty__icon { font-size: 48px; margin-bottom: 16px; }
.si-empty h4 { font-size: 20px; font-weight: 800; color: #0d2151; margin-bottom: 8px; }
.si-empty p  { font-size: 14px; color: #64748b; }

/* ── CTA inline banner ── */
.si-cta-banner {
  background: linear-gradient(120deg, #0d2151 0%, #1a3a6b 60%, #00509e 100%);
  border-radius: 16px;
  padding: 40px 36px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 40px;
  flex-wrap: wrap;
}

.si-cta-banner__text h3 {
  font-size: 22px;
  font-weight: 900;
  color: #fff;
  margin: 0 0 6px;
}

.si-cta-banner__text p {
  font-size: 14px;
  color: rgba(255,255,255,0.7);
  margin: 0;
}

.si-cta-banner__btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #e8501a;
  color: #fff;
  font-size: 14px;
  font-weight: 800;
  padding: 12px 24px;
  border-radius: 8px;
  text-decoration: none;
  white-space: nowrap;
  box-shadow: 0 4px 16px rgba(232,80,26,0.3);
  transition: background 0.15s, transform 0.15s;
}

.si-cta-banner__btn:hover { background: #c43d10; color: #fff; transform: translateY(-2px); }

/* ── Responsive ── */
@media (max-width: 1024px) {
  .si-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
  .si-featured { grid-template-columns: 1fr; }
  .si-card-side { flex-direction: column; }
  .si-card-side__img { width: 100%; height: 140px; }
}

@media (max-width: 540px) {
  .si-grid { grid-template-columns: 1fr; }
  .si-page { padding: 0 16px; }
  .si-hero { min-height: 220px; }
}
</style>


{# ══════════════════════════════════════════════════════════════════════════
   1. HERO
══════════════════════════════════════════════════════════════════════════ #}
<section class="si-hero" aria-labelledby="si-hero-title"
         style="--si-bg-img: url('{{ asset('uploads/banners/smartideas.png') }}');">
  <div class="container">
    <div class="si-hero__inner">
      <div class="si-eyebrow">
        <i class="fas fa-lightbulb" aria-hidden="true"></i>
        <span>{{ 'ideas.hero_eyebrow'|trans }}</span>
      </div>
      <h1 class="si-hero__title" id="si-hero-title">
        {{ 'ideas.hero_title_1'|trans }} <span>{{ 'ideas.hero_title_2'|trans }}</span>
      </h1>
      <p class="si-hero__sub">
        {{ 'ideas.hero_sub'|trans }}
      </p>
      <div class="d-flex gap-3 flex-wrap align-items-center">
        <div class="si-hero__count">
          <i class="fas fa-images" aria-hidden="true"></i>
          <span>{{ totalIdeas is defined ? totalIdeas : ideas|length }}+</span> {{ 'ideas.hero_count_suffix'|trans }}
        </div>
        <a href="{{ path('app_register') }}"
           class="si-eyebrow"
           style="background:rgba(232,80,26,0.9);border-color:rgba(232,80,26,0.6);text-decoration:none;">
          <i class="feather-edit" aria-hidden="true"></i>
          {{ 'ideas.hero_btn_share'|trans }}
        </a>
      </div>
    </div>
  </div>
</section>

{# ══════════════════════════════════════════════════════════════════════════
   2. CATEGORY CHIPS
══════════════════════════════════════════════════════════════════════════ #}
<div class="si-cats" role="navigation" aria-label="Filter by category">
  <div class="si-cats__inner">
    <a href="#" class="si-cat-chip active">
      <i class="feather-grid" aria-hidden="true"></i> {{ 'ideas.cat_all'|trans }}
    </a>
    <a href="#" class="si-cat-chip">{{ 'ideas.cat_interior'|trans }}</a>
    <a href="#" class="si-cat-chip">{{ 'ideas.cat_kitchen'|trans }}</a>
    <a href="#" class="si-cat-chip">{{ 'ideas.cat_bathroom'|trans }}</a>
    <a href="#" class="si-cat-chip">{{ 'ideas.cat_landscaping'|trans }}</a>
    <a href="#" class="si-cat-chip">{{ 'ideas.cat_windows'|trans }}</a>
    <a href="#" class="si-cat-chip">{{ 'ideas.cat_electrical'|trans }}</a>
    <a href="#" class="si-cat-chip">{{ 'ideas.cat_structural'|trans }}</a>
    <a href="#" class="si-cat-chip">{{ 'ideas.cat_painting'|trans }}</a>
    <a href="#" class="si-cat-chip">{{ 'ideas.cat_furniture'|trans }}</a>
  </div>
</div>

{# ══════════════════════════════════════════════════════════════════════════
   3. CONTENT
══════════════════════════════════════════════════════════════════════════ #}
<div class="si-wrap">
  <div class="si-page">

    {% if ideas|length > 0 %}

      {# ── FEATURED: 1 main + 3 side ── #}
      <div class="si-featured">

        {# Main card #}
        {% set mainIdea = ideas[0] %}
        <div class="si-card-main">
          <div class="si-card-main__img">
            <a href="{{ path('ideas_details', {slug: mainIdea.slug}) }}" tabindex="-1" aria-hidden="true">
              <img src="{{ mainIdea.mainImg
                ? (mainIdea.mainImg starts with 'http' ? mainIdea.mainImg : asset('uploads/blog/' ~ mainIdea.mainImg))
                : asset('assets/images/blog/blog-card-01.jpg') }}"
                   alt="{{ mainIdea.Title }} — Inspiration on Drilleedo"
                   loading="eager">
            </a>
          </div>
          <div class="si-card-main__body">
            <span class="si-card-cat">{{ 'ideas.lbl_featured'|trans }}</span>
            <h2 class="si-card-main__title">
              <a href="{{ path('ideas_details', {slug: mainIdea.slug}) }}">{{ mainIdea.Title }}</a>
            </h2>
            {% if mainIdea.shortDesc %}
              <p class="si-card-main__desc">{{ mainIdea.shortDesc }}</p>
            {% endif %}
            <a href="{{ path('ideas_details', {slug: mainIdea.slug}) }}" class="si-link">
              {{ 'ideas.btn_read_more'|trans }} <i class="feather-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>

        {# Side cards #}
        <div class="si-side-col">
          {% for sideIdea in ideas|slice(1, 3) %}
            <div class="si-card-side">
              <div class="si-card-side__img">
                <a href="{{ path('ideas_details', {slug: sideIdea.slug}) }}" tabindex="-1" aria-hidden="true">
                  <img src="{{ sideIdea.mainImg
                    ? (sideIdea.mainImg starts with 'http' ? sideIdea.mainImg : asset('uploads/blog/' ~ sideIdea.mainImg))
                    : asset('assets/images/blog/blog-card-02.jpg') }}"
                       alt="{{ sideIdea.Title }} — Renovation idea"
                       loading="lazy">
                </a>
              </div>
              <div class="si-card-side__body">
                <h3 class="si-card-side__title">
                  <a href="{{ path('ideas_details', {slug: sideIdea.slug}) }}">{{ sideIdea.Title }}</a>
                </h3>
                <a href="{{ path('ideas_details', {slug: sideIdea.slug}) }}" class="si-link" style="font-size:13px;">
                  {{ 'ideas.btn_view'|trans }} <i class="feather-arrow-right" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          {% endfor %}
        </div>

      </div>{# /si-featured #}

      {# ── CTA Banner ── #}
      <div class="si-cta-banner" role="complementary">
        <div class="si-cta-banner__text">
          <h3>{{ 'ideas.cta_title'|trans }}</h3>
          <p>{{ 'ideas.cta_sub'|trans }}</p>
        </div>
        <a href="{{ path('professionals_list') }}" class="si-cta-banner__btn">
          {{ 'ideas.cta_btn'|trans }} <i class="feather-arrow-right" aria-hidden="true"></i>
        </a>
      </div>

      {# ── Grid separator ── #}
      <div class="si-sep">
        <span class="si-sep__line"></span>
        <span class="si-sep__label">
          <i class="fas fa-th" aria-hidden="true"></i>
          {{ 'ideas.lbl_more_ideas'|trans }}
        </span>
        <span class="si-sep__line"></span>
      </div>

      {# ── Ideas grid (from idea 4 onward) ── #}
      <div class="si-grid">
        {% for gridIdea in ideas|slice(4) %}
          <div class="si-card-grid">
            <div class="si-card-grid__img">
              <a href="{{ path('ideas_details', {slug: gridIdea.slug}) }}" tabindex="-1" aria-hidden="true">
                <img src="{{ gridIdea.mainImg
                  ? (gridIdea.mainImg starts with 'http' ? gridIdea.mainImg : asset('uploads/blog/' ~ gridIdea.mainImg))
                  : asset('assets/images/blog/blog-grid-01.jpg') }}"
                     alt="{{ gridIdea.Title }} — Contractor project photo"
                     loading="lazy">
              </a>
            </div>
            <div class="si-card-grid__body">
              <h3 class="si-card-grid__title">
                <a href="{{ path('ideas_details', {slug: gridIdea.slug}) }}">{{ gridIdea.Title }}</a>
              </h3>
              {% if gridIdea.shortDesc %}
                <p class="si-card-grid__desc">{{ gridIdea.shortDesc }}</p>
              {% endif %}
              <a href="{{ path('ideas_details', {slug: gridIdea.slug}) }}" class="si-link" style="font-size:13px;">
                {{ 'ideas.btn_read_more'|trans }} <i class="feather-arrow-right" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        {% else %}
          {# No ideas in grid positions 4+ — that's fine, covered by featured #}
        {% endfor %}
      </div>

    {% else %}
      {# ── Empty state ── #}
      <div class="si-empty">
        <div class="si-empty__icon">💡</div>
        <h4>{{ 'ideas.empty_title'|trans }}</h4>
        <p>{{ 'ideas.empty_sub'|trans }}</p>
      </div>
    {% endif %}

    {# ══ PAGINATION ══ #}
    {% if totalPages > 1 %}
      <nav class="si-pagination" aria-label="Ideas page navigation">
        {% if currentPage > 1 %}
          <a href="{{ path('smartideas', {page: currentPage - 1}) }}" aria-label="Previous page">
            <i class="feather-chevron-left" aria-hidden="true"></i>
          </a>
        {% endif %}

        {% for p in 1..totalPages %}
          {% if p == currentPage %}
            <span class="active" aria-current="page">{{ p }}</span>
          {% else %}
            <a href="{{ path('smartideas', {page: p}) }}">{{ p }}</a>
          {% endif %}
        {% endfor %}

        {% if currentPage < totalPages %}
          <a href="{{ path('smartideas', {page: currentPage + 1}) }}" aria-label="Next page">
            <i class="feather-chevron-right" aria-hidden="true"></i>
          </a>
        {% endif %}
      </nav>
    {% endif %}

  </div>{# /si-page #}
</div>{# /si-wrap #}

</main>
{% endblock %}
