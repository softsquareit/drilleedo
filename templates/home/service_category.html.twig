{% extends 'base.html.twig' %}

{% block title %}{{ category.localizedTitle(app.request.locale) }} Services | Hire Verified Professionals in Canada | Drilleedo{% endblock %}
{% block meta_description %}Find verified {{ category.localizedTitle(app.request.locale) }} professionals across Canada on Drilleedo. Compare quotes, read reviews, and hire the best specialist for your home renovation project.{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/drilleedo/css/custom/professionals_list.css') }}">
<style>
/* ── Charte Drilleedo — service_category overrides ── */
:root { --B:#00497F;--S:#3FA9F5;--O:#FF8A3D;--D:#0C1825;--M:#4A6073;--L:#E4EBF2; }

/* Hero */
.fp-hero { min-height: 380px; background: linear-gradient(135deg,#002d50 0%,#00497F 60%,#0a6eab 100%) !important; }
.fp-hero__title { font-size: clamp(24px,4vw,44px) !important; font-weight: 900 !important; letter-spacing: -1.5px !important; }
.fp-hero__sub { font-size: 17px !important; color: rgba(255,255,255,.75) !important; line-height: 1.75 !important; }

/* Breadcrumb */
.svc-breadcrumb { margin-bottom: 20px; }
.svc-breadcrumb .breadcrumb { background: transparent; padding: 0; }
.svc-breadcrumb .breadcrumb-item,
.svc-breadcrumb .breadcrumb-item a { color: rgba(255,255,255,.8); font-size: 14px; text-decoration: none; transition: color .15s; }
.svc-breadcrumb .breadcrumb-item a:hover { color: #fff; }
.svc-breadcrumb .breadcrumb-item.active { color: #fff; font-weight: 600; }
.svc-breadcrumb .breadcrumb-item + .breadcrumb-item::before { color: rgba(255,255,255,.4); }

/* Search bar */
.fp-search-bar { border-radius: 12px !important; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,.2) !important; }
.fp-search-bar__btn {
    background: #FF8A3D !important; font-weight: 700 !important;
    transition: background .18s !important;
}
.fp-search-bar__btn:hover { background: #e87830 !important; }

/* Category pill bar */
.fp-cat-bar { background: #fff; border-bottom: 1px solid var(--L); box-shadow: 0 2px 8px rgba(0,73,127,.06); }
.fp-cat-pill {
    border-radius: 50px !important; font-weight: 700 !important;
    transition: all .18s !important;
    border: 1.5px solid var(--L) !important;
}
.fp-cat-pill.active,
.fp-cat-pill:hover {
    background: var(--B) !important; color: #fff !important;
    border-color: var(--B) !important;
    box-shadow: 0 4px 14px rgba(0,73,127,.22) !important;
}
.fp-cat-pill__count {
    background: rgba(0,73,127,.1) !important; color: var(--B) !important;
    font-weight: 800 !important; border-radius: 50px !important;
}
.fp-cat-pill.active .fp-cat-pill__count,
.fp-cat-pill:hover .fp-cat-pill__count {
    background: rgba(255,255,255,.25) !important; color: #fff !important;
}

/* Sort select */
.fp-sort-select {
    border: 1.5px solid var(--L) !important; border-radius: 10px !important;
    padding: 8px 14px !important; font-weight: 500 !important; font-size: 14px !important;
    background: #f8fafc !important; color: var(--D) !important;
    outline: none !important; cursor: pointer !important;
}
.fp-sort-select:focus { border-color: var(--S) !important; }

/* Pro cards */
.fp-pro-card {
    border: 1.5px solid var(--L) !important; border-radius: 20px !important;
    overflow: hidden !important;
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease !important;
    box-shadow: 0 2px 10px rgba(0,73,127,.06) !important;
}
.fp-pro-card:hover {
    transform: translateY(-6px) !important;
    box-shadow: 0 14px 40px rgba(0,73,127,.14) !important;
    border-color: var(--S) !important;
}
.fp-card-name a { color: var(--D) !important; text-decoration: none !important; font-weight: 800 !important; }
.fp-card-name a:hover { color: var(--B) !important; }
.fp-card-verified { color: #16a34a !important; font-size: 11px !important; font-weight: 700 !important; }
.fp-card-rating svg { fill: #F59E0B !important; width: 15px !important; height: 15px !important; }

/* Action buttons */
.fp-btn-outline {
    border: 1.5px solid rgba(0,73,127,.22) !important; border-radius: 8px !important;
    color: var(--B) !important; font-weight: 700 !important; font-size: 13px !important;
    transition: all .18s !important;
}
.fp-btn-outline:hover { background: var(--B) !important; color: #fff !important; border-color: var(--B) !important; }
.fp-btn-solid {
    background: var(--O) !important; border-radius: 8px !important;
    font-weight: 700 !important; font-size: 13px !important; color: #fff !important;
    box-shadow: 0 3px 12px rgba(255,138,61,.28) !important; transition: all .18s !important;
}
.fp-btn-solid:hover { background: #e87830 !important; transform: translateY(-1px) !important; }

/* Sidebar */
.fp-sidebar-card { border: 1.5px solid var(--L) !important; border-radius: 16px !important; }
.fp-sidebar-card__header { font-weight: 800 !important; color: var(--D) !important; font-size: 14px !important; }
.fp-btn-apply {
    background: var(--B) !important; border-radius: 10px !important;
    font-weight: 700 !important; color: #fff !important;
    transition: background .18s !important;
}
.fp-btn-apply:hover { background: #003a66 !important; }
.fp-btn-clear { color: var(--M) !important; font-size: 13px !important; font-weight: 600 !important; }
.fp-btn-clear:hover { color: #c0392b !important; }

/* Meta count */
.fp-meta-count span { color: var(--B) !important; font-weight: 900 !important; }

/* Pagination */
.fp-pagination a, .fp-pagination span {
    border: 1.5px solid var(--L) !important; border-radius: 8px !important;
    font-weight: 700 !important; transition: all .18s !important;
}
.fp-pagination a:hover { background: var(--B) !important; color: #fff !important; border-color: var(--B) !important; }
.fp-pagination .active { background: var(--B) !important; color: #fff !important; border-color: var(--B) !important; }
</style>
{% endblock %}

{% block body %}
<div class="fp-page" id="main-content">

{# ══════════════════════════════════════════════════════════════════════════
   1. HERO BANNER
   Focus on the specific category but with search capabilities.
══════════════════════════════════════════════════════════════════════════ #}
<div class="fp-hero">
    <img src="{{ asset('uploads/banners/professionels.png') }}"
         alt="{{ category.localizedTitle(app.request.locale) }}"
         class="fp-hero__img">
    <div class="fp-hero__content">
        <nav aria-label="Breadcrumb" class="svc-breadcrumb">
            <ol class="breadcrumb mb-0" itemscope itemtype="https://schema.org/BreadcrumbList">
                <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb-item">
                    <a href="{{ path('app_home') }}" itemprop="item"><span itemprop="name">Accueil</span></a>
                    <meta itemprop="position" content="1">
                </li>
                <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb-item">
                    <a href="{{ path('professionals_list') }}" itemprop="item"><span itemprop="name">Professionnels</span></a>
                    <meta itemprop="position" content="2">
                </li>
                <li class="breadcrumb-item active" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page">
                    <span itemprop="name">{{ category.localizedTitle(app.request.locale) }}</span>
                    <meta itemprop="position" content="3">
                </li>
            </ol>
        </nav>

        <h1 class="fp-hero__title">
            {% if category.icon %}
                <img src="{{ asset('uploads/categories/' ~ category.icon) }}" alt="" style="width: 45px; height: 45px; vertical-align: middle; margin-right: 15px;">
            {% endif %}
            {{ category.localizedTitle(app.request.locale) }} {{ 'public_list.professionals_suffix'|trans }}
        </h1>
        <p class="fp-hero__sub">
            {{ totalResults }} {{ 'public_list.specialists_available_in'|trans }} {{ category.localizedTitle(app.request.locale)|lower }} au Canada.
        </p>

        <div class="fp-hero__search">
            <form action="{{ path('service_category_landing', {'categorySlug': categorySlug}) }}" method="GET" class="fp-search-bar">
                <span class="fp-search-bar__icon">
                    <i class="feather-search"></i>
                </span>
                <input type="text"
                       name="keyword"
                       class="fp-search-bar__input"
                       placeholder="{{ 'public_list.search_within'|trans }} {{ category.localizedTitle(app.request.locale) }}…"
                       value="{{ activeFilters.keyword ?? '' }}"
                       aria-label="Search within {{ category.localizedTitle(app.request.locale) }}">
                <button type="submit" class="fp-search-bar__btn">{{ 'public_list.search_btn'|trans }}</button>
            </form>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════════════════════════════════
   2. CATEGORY PILLS (Focusing on sub-categories or related categories)
══════════════════════════════════════════════════════════════════════════ #}
<div class="fp-cat-bar" role="navigation" aria-label="Filter by category">
    <div class="fp-cat-bar__inner">
        {# "Tous Cuisine" pill #}
        <a href="{{ path('service_category_landing', {'categorySlug': categorySlug}) }}" 
           class="fp-cat-pill {{ activeFilters.keyword is empty ? 'active' : '' }}" 
           aria-pressed="{{ activeFilters.keyword is empty ? 'true' : 'false' }}">
            <i class="feather-grid"></i>
            {{ 'public_list.all'|trans }} {{ category.localizedTitle(app.request.locale) }}
            <span class="fp-cat-pill__count">{{ totalResults }}</span>
        </a>

        {# Show children of current category if any #}
        {% if category.childs|length > 0 %}
            {% for sub in category.childs %}
                <a href="{{ path('service_category_landing', {'categorySlug': sub.slug }) }}"
                   class="fp-cat-pill"
                   aria-pressed="false">
                    {% if sub.icon %}
                        <img src="{{ asset('uploads/categories/' ~ sub.icon) }}" alt="" class="fp-cat-pill__icon">
                    {% else %}
                        <i class="feather-briefcase"></i>
                    {% endif %}
                    {{ sub.name }}
                    <span class="fp-cat-pill__count">{{ categoryCounts[sub.id] ?? 0 }}</span>
                </a>
            {% endfor %}
        {% else %}
            {# If no children, show parent category or siblings? 
               For now, let's show other parent categories to match the search feel #}
            {% for cat in allCategories %}
                {% if cat.parent is null and cat.id != category.id %}
                    <a href="{{ path('service_category_landing', {'categorySlug': cat.slug }) }}"
                       class="fp-cat-pill"
                       aria-pressed="false">
                        {% if cat.icon %}
                            <img src="{{ asset('uploads/categories/' ~ cat.icon) }}" alt="" class="fp-cat-pill__icon">
                        {% else %}
                            <i class="feather-briefcase"></i>
                        {% endif %}
                        {{ cat.name }}
                        <span class="fp-cat-pill__count">{{ categoryCounts[cat.id] ?? 0 }}</span>
                    </a>
                {% endif %}
            {% endfor %}
        {% endif %}
    </div>
</div>

{# ══════════════════════════════════════════════════════════════════════════
   3. MAIN LAYOUT
══════════════════════════════════════════════════════════════════════════ #}
<div class="fp-wrap">
    <div class="fp-layout">

        {# ── LEFT SIDEBAR ── #}
        <aside class="fp-sidebar" aria-label="Filters">
            <form action="{{ path('service_category_landing', {'categorySlug': categorySlug}) }}" method="GET" id="filters-form">
                {% if activeFilters.keyword %}
                    <input type="hidden" name="keyword" value="{{ activeFilters.keyword }}">
                {% endif %}
                {% if activeFilters.sort %}
                    <input type="hidden" name="sort" value="{{ activeFilters.sort }}">
                {% endif %}

                <div class="fp-sidebar-card">
                    <div class="fp-sidebar-card__header">
                        <i class="feather-map-pin"></i>
                        {{ 'public_list.city_region'|trans }}
                    </div>
                    <div class="fp-sidebar-card__body">
                        <ul class="fp-city-list" role="list">
                            {% for city in allCities %}
                                <li class="fp-city-row {{ city in activeFilters.cities ? 'active' : '' }}">
                                    <label for="city-{{ loop.index }}">
                                        <input id="city-{{ loop.index }}"
                                               type="checkbox"
                                               name="cities[]"
                                               value="{{ city }}"
                                               {{ city in activeFilters.cities ? 'checked' : '' }}
                                               onchange="this.form.submit()">
                                        {{ city }}
                                    </label>
                                    <span class="fp-city-count">{{ cityCounts[city] ?? 0 }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>

                <button type="submit" class="fp-btn-apply">{{ 'public_list.apply_filters'|trans }}</button>
                {% if activeFilters.cities is not empty %}
                    <a href="{{ path('service_category_landing', {'categorySlug': categorySlug}) }}" class="fp-btn-clear">
                        {{ 'public_list.clear_filters'|trans }}
                    </a>
                {% endif %}
            </form>
        </aside>

        {# ── MAIN CONTENT ── #}
        <div class="fp-content">
            <div class="fp-meta-row">
                <p class="fp-meta-count">
                    <span>{{ professionals|length }}</span> {{ 'public_list.specialists_available_in'|trans }} {{ category.localizedTitle(app.request.locale) }}
                </p>
                <form action="{{ path('service_category_landing', {'categorySlug': categorySlug}) }}" method="GET">
                    {% if activeFilters.keyword %}<input type="hidden" name="keyword" value="{{ activeFilters.keyword }}">{% endif %}
                    {% for city in activeFilters.cities %}<input type="hidden" name="cities[]" value="{{ city }}">{% endfor %}
                    <select name="sort" class="fp-sort-select" onchange="this.form.submit()">
                        <option value="newest"     {{ activeFilters.sort == 'newest'     ? 'selected' : '' }}>{{ 'public_list.sort_newest'|trans }}</option>
                        <option value="rating"     {{ activeFilters.sort == 'rating'     ? 'selected' : '' }}>{{ 'public_list.sort_rating'|trans }}</option>
                        <option value="experience" {{ activeFilters.sort == 'experience' ? 'selected' : '' }}>{{ 'public_list.sort_exp'|trans }}</option>
                    </select>
                </form>
            </div>

            <div class="fp-pro-grid">
                {% set starPath = 'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z' %}

                {% for pro in professionals %}
                    {% set rating = pro.stats ? pro.stats.averageRating : 5.0 %}
                    {% set fullStars = rating|round(0, 'floor') %}
                    {% set initials = pro.companyName 
                        ? (pro.companyName|split(' ')|map(w => w|slice(0,1))|join('')|upper|slice(0,2)) 
                        : (pro.personalInfos ? pro.personalInfos.firstName|slice(0,1) ~ pro.personalInfos.lastName|slice(0,1) : 'PR') %}
                    {% set profileUrl = path('professional_details', {'id': pro.id, 'slug': pro.companyName|default(pro.email)|trim|lower|replace({' ': '-'}) }) %}

                    <div class="fp-pro-card">
                        {% if pro.isTopRated %}
                            <div class="fp-badge-top">⭐ {{ 'home_card.top_rated'|trans }}</div>
                        {% endif %}

                        <div class="fp-card-img-wrap">
                            <a href="{{ profileUrl }}"><img src="{{ pro.banner ? asset('uploads/banners/' ~ pro.banner) : asset('assets/drilleedo/images/team/plumber.png') }}" alt="{{ pro.companyName }}"></a>
                            <div class="fp-card-avatar">
                                {% if pro.logo %}<img src="{{ asset('uploads/logos/' ~ pro.logo) }}" alt="">{% else %}{{ initials }}{% endif %}
                            </div>
                        </div>

                        <div class="fp-card-body">
                            {% if pro.isVerified %}<div class="fp-card-verified">✔ {{ 'home_card.verified_by'|trans|striptags }}</div>{% endif %}
                            <h3 class="fp-card-name"><a href="{{ profileUrl }}">{{ pro.companyName ?? (pro.personalInfos ? pro.personalInfos.firstName ~ ' ' ~ pro.personalInfos.lastName : pro.email) }}</a></h3>
                            
                            <div class="fp-card-meta">
                                <span><i class="feather-briefcase"></i> {{ pro.category ? pro.category.localizedTitle(app.request.locale) : category.localizedTitle(app.request.locale) }}</span>
                                <span><i class="feather-map-pin"></i> {{ pro.city ?? 'Canada' }}</span>
                            </div>

                            <div class="fp-card-rating">
                                <div class="fp-stars">
                                    {% for i in range(1, 5) %}
                                        <svg viewBox="0 0 20 20" {{ i > fullStars ? 'style="fill: #e2e8f0"' : '' }}><path d="{{ starPath }}"/></svg>
                                    {% endfor %}
                                </div>
                                <span class="fp-card-rating__cnt">({{ pro.stats ? pro.stats.reviewCount : 0 }} {{ 'home_card.reviews'|trans }})</span>
                            </div>

                            <div class="fp-card-actions">
                                <a href="{{ profileUrl }}" class="fp-btn-outline">{{ 'home_card.view_profile'|trans }}</a>
                                <a href="{{ path('individual_direct_request_new', {'type': 'professional', 'id': pro.id}) }}" class="fp-btn-solid">{{ 'home_card.get_quote'|trans }}</a>
                            </div>
                        </div>
                    </div>
                {% else %}
