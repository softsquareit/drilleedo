{% extends 'base.html.twig' %}

{% block title %}Drilleedo – Trouvez un Pro Vérifié au Canada | Devis Gratuits Sans Engagement{% endblock %}
{% block meta_description %}Besoin d'un plombier, électricien ou rénovateur fiable au Canada ? Drilleedo vous connecte à 1 500+ pros vérifiés. Devis gratuits, 35 000+ projets réalisés, avis certifiés. Essayez maintenant.{% endblock %}
{% block meta_keywords %}professionnels vérifiés Canada, devis gratuits rénovation, plombier Québec, électricien Ontario, peintre rénovation, service à domicile Canada, Drilleedo, trouver artisan fiable{% endblock %}
{% block og_title %}Drilleedo — Trouvez le Bon Pro, Rapidement.{% endblock %}
{% block og_description %}Marketplace #1 au Canada pour services résidentiels : 1 500+ artisans vérifiés, devis gratuits, 35 000+ projets réalisés. Publiez votre projet en 2 minutes.{% endblock %}

{% block structured_data %}
{{ parent() }}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"LocalBusiness","name":"Drilleedo","url":"{{ url('app_home') }}","description":"Drilleedo est la marketplace canadienne de référence pour les services résidentiels : plomberie, électricité, rénovation, jardinage. 1 500+ pros vérifiés, devis gratuits, 35 000+ projets réalisés.","areaServed":{"@type":"Country","name":"Canada"},"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.9","reviewCount":"2500","bestRating":"5"}}
</script>
{% endblock %}

{% block stylesheets %}
<style>
/* ═══════════════════════════════════════════════════════════
   DRILLEEDO HOMEPAGE v3 — Inspired by brand guidelines
   Helper Blue #00497F · Action Sky #3FA9F5 · Toolbox Orange #FF8A3D · Wall White #FFFBEB
   ═══════════════════════════════════════════════════════════ */
:root {
  --B:   #00497F;
  --S:   #3FA9F5;
  --O:   #FF8A3D;
  --C:   #FFFBEB;
  --D:   #0C1825;
  --M:   #4A6073;
  --L:   #E4EBF2;
  --W:   #FFFFFF;
  --F:   'Instrument Sans', system-ui, sans-serif;
  --r:   14px;
  --rl:  22px;
  --rx:  28px;
  --sh:  0 4px 24px rgba(0,73,127,.12);
  --sh-md: 0 8px 40px rgba(0,73,127,.15);
  --sh-lg: 0 16px 60px rgba(0,73,127,.18);
  --t:   all .22s ease;
}
.hp { font-family: var(--F); color: var(--D); line-height: 1.6; }
.hp * { box-sizing: border-box; }
.hp h1,.hp h2,.hp h3,.hp h4 { font-family: var(--F); font-weight: 900; letter-spacing: -.8px; line-height: 1.13; }
.hp a { text-decoration: none; }
.hw { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
.hs  { padding: 96px 0; }
.hss { padding: 64px 0; }
.hc  { text-align: center; }
.sr-only { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0); }

/* ── Pill labels ── */
.hpill {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 18px; border-radius: 50px;
  font-size: 12px; font-weight: 700; letter-spacing: .6px;
  text-transform: uppercase; margin-bottom: 20px;
}
.hpill-s { background: rgba(63,169,245,.10); color: var(--S); border: 1px solid rgba(63,169,245,.2); }
.hpill-o { background: rgba(255,138,61,.10);  color: var(--O); border: 1px solid rgba(255,138,61,.2); }
.hpill-w { background: rgba(255,255,255,.15); color: #fff; border: 1px solid rgba(255,255,255,.3); }

/* ── Headings ── */
.hh2 { font-size: clamp(28px,3.5vw,40px); font-weight: 900; color: var(--D); margin-bottom: 16px; letter-spacing: -1.5px; }
.hh2-w { color: #fff; }
.hl  { font-size: 17px; color: var(--M); line-height: 1.75; max-width: 560px; }
.hlc { margin-left: auto; margin-right: auto; text-align: center; }

/* ── Buttons ── */
.hbtn {
  display: inline-flex; align-items: center; gap: 9px;
  font-family: var(--F); font-weight: 700; font-size: 15px;
  border-radius: 50px; border: none; cursor: pointer;
  transition: var(--t); padding: 13px 28px; line-height: 1;
  letter-spacing: .2px;
}
.hbtn-o { background: var(--B); color: #fff;}
.hbtn-o:hover { background: #e87830; transform: translateY(-2px); box-shadow: 0 8px 28px rgba(255,138,61,.45); color: #fff; }
.hbtn-b { background: var(--B); color: #fff; box-shadow: 0 4px 16px rgba(0,73,127,.25); }
.hbtn-b:hover { background: #003a66; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,73,127,.3); color: #fff; }
.hbtn-g { background: transparent; border: 2px solid rgba(0,73,127,.22); color: var(--B); }
.hbtn-g:hover { background: var(--B); color: #fff; border-color: var(--B); }
.hbtn-w { background: var(--W); color: var(--B); font-weight: 700; box-shadow: 0 2px 12px rgba(0,0,0,.1); }
.hbtn-w:hover { background: var(--C); color: var(--B); }
.hbtn-ow { background: transparent; border: 2px solid rgba(255,255,255,.35); color: #fff; }
.hbtn-ow:hover { border-color: #fff; background: rgba(255,255,255,.12); color: #fff; }
.hbtn-lg { font-size: 16px; padding: 16px 36px; }
.hbtn i  { font-size: 15px; }

/* ════════════════════════════════════════
   HERO — Photo left + blue right
   ════════════════════════════════════════ */
.hp-hero {
  display: grid; grid-template-columns: 2fr 1fr;
  min-height: 720px; overflow: hidden; position: relative;
}
/* Left: full photo background */
.hp-hero-photo {
  position: relative; overflow: hidden;
  background: #eef4fa;
}
.hp-hero-photo img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center;
  mix-blend-mode: multiply;
}
/* Floating card over photo */
.hp-hero-card {
    position: absolute;
    top: 50%;
    left: 20%;
    transform: translateY(-50%);
    background: #fff;
    border-radius: var(--r);
    padding: 44px 40px;
    max-width: 70%;
    width: 70%;
    box-shadow: 0 12px 48px rgba(0,73,127,.14), 0 2px 8px rgba(0,0,0,.04);
}
.hp-eyebrow {
  font-size: 11px; font-weight: 700; color: var(--O);
  text-transform: uppercase; letter-spacing: 1.8px;
  margin-bottom: 16px; display: flex; align-items: center; gap: 6px;
}
.hp-h1 {
  font-size: clamp(40px,4.2vw,54px); font-weight: 900; color: var(--D);
  margin-bottom: 8px; letter-spacing: -2px; line-height: 1.08;
}
.hp-h1 span { color: var(--B); display: block; line-height: 1.05; }
.hp-tagline {
  font-size: 13px; color: var(--O); font-weight: 700;
  letter-spacing: .4px; margin-bottom: 24px;
  display: flex; align-items: center; gap: 8px;
}
.hp-tagline::before {
  content: '';
  display: inline-block; width: 6px; height: 6px;
  border-radius: 50%; background: var(--O); flex-shrink: 0;
}
/* Search bar */
.hp-search {
  display: flex; align-items: center;
  background: #F8FAFC; border: 2px solid #d8e6f0;
  border-radius: 50px; padding: 6px 6px 6px 20px;
  margin-bottom: 16px; transition: var(--t);
  box-shadow: 0 2px 8px rgba(0,73,127,.06);
}
.hp-search:focus-within { border-color: var(--S); box-shadow: 0 0 0 4px rgba(63,169,245,.12); }
.hp-search i { color: #ffffff; font-size: 17px;  flex-shrink: 0; }
.hp-search input {
  flex: 1; border: none; background: transparent;
  font-family: var(--F); font-size: 15px; color: var(--D);
  outline: none;
}
.hp-search input::placeholder { color: #b0bec5; }
.hp-search button {
  background: var(--O); color: #fff; border: none;
  border-radius: 50%; width: 44px; height: 44px;
  font-family: var(--F); font-weight: 700;
  cursor: pointer; transition: var(--t);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; box-shadow: 0 2px 8px rgba(255,138,61,.3);
}
.hp-search button:hover { background: #d96e10; transform: scale(1.06); }
/* Quick category chips */
.hp-qchips {
  display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 20px;
}
.hp-qchip {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 6px 13px; border-radius: 50px;
  font-size: 12px; font-weight: 600; color: var(--M);
  background: #F0F4F8; border: 1.5px solid var(--L);
  transition: var(--t); text-decoration: none; cursor: pointer;
}
.hp-qchip:hover { background: var(--B); color: #fff; border-color: var(--B); }
/* Social proof row */
.hp-social-proof {
  display: flex; align-items: center; gap: 12px;
  padding-top: 16px; border-top: 1px solid #F0F4F8;
}
.hp-avatars { display: flex; }
.hp-av {
  width: 32px; height: 32px; border-radius: 50%;
  border: 2px solid #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 700; color: #fff;
  margin-left: -8px; flex-shrink: 0;
}
.hp-avatars .hp-av:first-child { margin-left: 0; }
.hp-proof-stars { color: #F59E0B; font-size: 13px; line-height: 1; margin-bottom: 2px; }
.hp-proof-text { font-size: 11.5px; color: var(--M); font-weight: 500; }

/* Right: panel pro — style référence exacte */
/* ── Panel pro — style exact référence ── */
.hp-hero-pro {
  background: #0f52a0;
  position: relative;
  display: flex; flex-direction: column; justify-content: center;
  overflow: hidden;
}
.hp-hero-pro-bg      { display: none; }
.hp-hero-pro-overlay { display: none; }
.hp-hero-pro-art     { display: none; }
.hp-hero-pro-illus   { display: none; }

.hp-hero-pro-inner {
  position: relative; z-index: 2;
  padding: 36px 30px;
}

/* Badge : carte portrait sky-blue à gauche + texte à droite */
.hp-pro-photo-badge {
  display: flex; align-items: flex-end; gap: 16px;
  margin-bottom: 22px;
  background: none; border: none; padding: 0; backdrop-filter: none;
}
.hp-pro-photo-badge-img {
  width: 108px; height: 130px;
  border-radius: 4px;
  overflow: hidden; flex-shrink: 0;
  display: flex; align-items: flex-end; justify-content: center;
}
.hp-pro-photo-badge-img img {
  width: 105px; height: auto; display: block;
  object-fit: contain; object-position: bottom center;
}
.hp-pro-photo-badge-text {
  padding-bottom: 6px;
  font-size: 13px; color: rgba(255,255,255,.8); line-height: 1.5;
}
.hp-pro-photo-badge-name {
  font-size: 22px; font-weight: 800; color: var(--S) !important;
  letter-spacing: -.3px; line-height: 1.1;
}

/* H2 et sous-titre */
.hp-hero-pro-inner h2 {
  font-size: 30px; font-weight: 800; color: #fff;
  margin-bottom: 8px; letter-spacing: -.6px; line-height: 1.15;
}
.hp-hero-pro-sub {
  font-size: 14px; color: rgba(255,255,255,.7);
  margin-bottom: 20px; line-height: 1.6;
}

/* Form — sans container glass, direct */
.hp-pro-form {
  background: none; border: none;
  padding: 0; margin-bottom: 16px;
}
.hp-pro-form label {
  display: block; font-size: 11px; font-weight: 700;
  color: rgba(255,255,255,.55); text-transform: uppercase;
  letter-spacing: .6px; margin-bottom: 7px;
}
.hp-pro-input {
  width: 100%; padding: 13px 16px;
  background: #fff; border: 1.5px solid #3FA9F5;
  border-radius: var(--r); font-family: var(--F); font-size: 14px;
  outline: none; transition: var(--t); margin-bottom: 10px; color: var(--D);
}
.hp-pro-input:focus { border-color: #fff; box-shadow: 0 0 0 3px rgba(255,255,255,.25); }
/* Bouton pleine largeur bleu ciel — comme référence */
.hp-pro-form .hbtn-o {
  background: var(--S) !important; color: #fff !important;
  box-shadow: 0 4px 16px rgba(63,169,245,.4) !important;
}
.hp-pro-form .hbtn-o:hover { background: #2a95e0 !important; }

.hp-pro-badges { display: flex; flex-direction: column; gap: 6px; margin-top: 16px; }
.hp-pro-badge { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: rgba(255,255,255,.7); }
.hp-pro-badge i { color: var(--S); font-size: 14px; }
/* Hero search card */
.hp-hero-card { background: #fff; }
.hp-mini-trust { gap: 16px; margin-top: 8px; }
.hp-mini-trust-item { font-size: 12.5px; }
.hp-stars { color: var(--O); font-size: 13px; letter-spacing: 1px; }

/* ════════════════════════════════════════
   TRUST BAR
   ════════════════════════════════════════ */
.hp-tbar {
  background: var(--W);
  border-top: 3px solid var(--O);
  border-bottom: 1px solid var(--L);
  padding: 20px 0;
}
.hp-tbar-inner {
  display: flex; align-items: center; justify-content: center;
  flex-wrap: wrap; gap: 0;
}
.hp-tb {
  display: flex; align-items: center; gap: 12px;
  padding: 0 40px; border-right: 1px solid var(--L);
  font-size: 13px; font-weight: 500; color: var(--M); white-space: nowrap;
}
.hp-tb:last-child { border-right: none; }
.hp-tb i {
  color: var(--O); font-size: 22px;
  background: rgba(255,138,61,.1); padding: 8px; border-radius: 10px;
  flex-shrink: 0;
}
.hp-tb strong { color: var(--B); font-size: 22px; font-weight: 900; letter-spacing: -.5px; }

/* ════════════════════════════════════════
   VALUE PROPS
   ════════════════════════════════════════ */
.hp-val { background: var(--C); }
.hp-val-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 24px; }
.hp-vc {
  background: var(--W); border: 1.5px solid var(--L);
  border-radius: var(--rx); padding: 32px 26px; transition: var(--t);
  box-shadow: 0 2px 12px rgba(0,73,127,.05);
}
.hp-vc:hover {
  border-color: var(--S); transform: translateY(-5px);
  box-shadow: var(--sh-md); border-bottom: 3px solid var(--S);
}
.hp-vc-ico {
  width: 54px; height: 54px; border-radius: var(--rl);
  background: linear-gradient(135deg,#00497F,#3FA9F5);
  display: flex; align-items: center; justify-content: center; margin-bottom: 20px;
}
.hp-vc-ico i { font-size: 22px; color: #fff; }
.hp-vc h3 { font-size: 17px; font-weight: 800; color: var(--D); margin-bottom: 10px; }
.hp-vc p  { font-size: 14px; color: var(--M); line-height: 1.7; margin: 0; }

/* ════════════════════════════════════════
   HOW IT WORKS
   ════════════════════════════════════════ */
.hp-hiw {
  background: linear-gradient(160deg, #002d50 0%, var(--B) 55%, #0a5490 100%);
  overflow: hidden; position: relative; padding-bottom: 80px;
}
.hp-hiw::before {
  content: ''; position: absolute; top: -120px; right: -120px;
  width: 450px; height: 450px; border-radius: 50%;
  background: radial-gradient(circle, rgba(63,169,245,.12) 0%, transparent 70%);
  pointer-events: none;
}
.hp-hiw::after {
  content: ''; position: absolute; bottom: -80px; left: -60px;
  width: 320px; height: 320px; border-radius: 50%;
  background: radial-gradient(circle, rgba(255,138,61,.07) 0%, transparent 70%);
  pointer-events: none;
}

/* ── Tabs principaux ── */
.hp-hiw-tabs {
  display: flex; background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 50px; padding: 5px;
  width: fit-content; margin: 0 auto 32px;
  backdrop-filter: blur(8px);
}
.hp-hiw-tab {
  padding: 11px 28px; border-radius: 50px;
  font-family: var(--F); font-size: 14px; font-weight: 600;
  color: rgba(255,255,255,.55); background: none; border: none;
  cursor: pointer; transition: var(--t); white-space: nowrap;
  display: inline-flex; align-items: center; gap: 8px;
}
.hp-hiw-tab i { font-size: 14px; }
.hp-hiw-tab.active {
  background: #fff; color: var(--B);
  box-shadow: 0 2px 12px rgba(0,0,0,.15);
  font-weight: 700;
}
.hp-hiw-tab:not(.active):hover { color: rgba(255,255,255,.85); background: rgba(255,255,255,.06); }

/* ── Sous-tabs scénarios ── */
.hp-hiw-subtabs {
  display: flex; gap: 10px; justify-content: center;
  margin-bottom: 48px; flex-wrap: wrap;
}
.hp-hiw-subtab {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 10px 22px; border-radius: 50px;
  font-family: var(--F); font-size: 13px; font-weight: 600;
  color: rgba(255,255,255,.6);
  background: rgba(255,255,255,.06);
  border: 1.5px solid rgba(255,255,255,.15);
  cursor: pointer; transition: var(--t);
}
.hp-hiw-subtab i { font-size: 14px; }
.hp-hiw-subtab.active {
  background: var(--O); color: #fff;
  border-color: var(--O);
  box-shadow: 0 4px 16px rgba(255,138,61,.4);
  font-weight: 700;
}
.hp-hiw-subtab:not(.active):hover {
  background: rgba(255,255,255,.1);
  border-color: rgba(255,255,255,.3);
  color: #fff;
}

/* ── Grille de steps ── */
.hp-hiw-steps {
  display: grid; grid-template-columns: repeat(4,1fr);
  gap: 16px; position: relative;
}
.hp-hiw-steps::before {
  content: ''; position: absolute;
  top: 50px; left: calc(12.5% + 26px); right: calc(12.5% + 26px);
  height: 2px;
  background: linear-gradient(90deg, rgba(255,138,61,.6), rgba(63,169,245,.6));
  z-index: 0;
}

/* ── Card step ── */
.hp-step {
  padding: 28px 20px 24px;
  background: rgba(255,255,255,.07);
  border: 1px solid rgba(255,255,255,.12);
  border-radius: var(--rx);
  text-align: center;
  backdrop-filter: blur(6px);
  transition: var(--t);
  position: relative;
}
.hp-step:hover {
  background: rgba(255,255,255,.12);
  border-color: rgba(255,255,255,.25);
  transform: translateY(-4px);
}
/* Flèche entre steps */
.hp-step:not(:last-child)::after {
  content: '';
  position: absolute; right: -8px; top: 46px;
  width: 16px; height: 16px;
  border-top: 2px solid rgba(255,138,61,.6);
  border-right: 2px solid rgba(255,138,61,.6);
  transform: rotate(45deg);
  z-index: 2;
}
.hp-step-n {
  width: 52px; height: 52px; background: var(--O);
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 19px; font-weight: 900; color: #fff;
  margin: 0 auto 18px; position: relative; z-index: 1;
  box-shadow: 0 4px 18px rgba(255,138,61,.5);
  border: 3px solid rgba(255,255,255,.25);
}
.hp-step h3 { font-size: 15px; font-weight: 800; color: #fff; margin-bottom: 8px; letter-spacing: -.3px; }
.hp-step p  { font-size: 13px; color: rgba(255,255,255,.62); line-height: 1.65; margin: 0; }

/* ════════════════════════════════════════
   SHOWCASE — Designer match (photo cards + stat pills)
   ════════════════════════════════════════ */
.hp-showcase {
  background: linear-gradient(160deg, #eef6ff 0%, #e3f0fd 50%, #d9ecfb 100%);
  padding: 40px;
  overflow: hidden;
}
.hp-showcase-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  min-height: 500px;
  max-width: 1300px; margin: 0 auto;
}

/* ── LEFT : Photo composition (man_woman.png — PNG transparent) ── */
.hp-showcase-photos {
  display: flex; align-items: flex-end; justify-content: center;
  overflow: hidden; position: relative;
}
.hp-sc-collage {
  width: 100%; height: 100%;
  display: flex; align-items: flex-end; justify-content: center;
  padding-top: 20px;
}
.hp-sc-collage img {
  width: 100%; max-height: 460px;
  object-fit: contain; object-position: bottom center;
  display: block;
}

/* ── RIGHT : Text content ── */
.hp-showcase-text {
  padding: 64px 56px 64px 64px;
  display: flex; flex-direction: column; justify-content: center;
}
.hp-sc-eyebrow {
  font-size: 13px; font-weight: 700; color: var(--S);
  margin-bottom: 14px; letter-spacing: .3px;
}
.hp-sc-h2 {
  font-size: clamp(28px, 3.5vw, 44px); font-weight: 900;
  color: var(--D); line-height: 1.1; letter-spacing: -1.5px;
  margin: 0 0 24px;
}
/* 3 action buttons */
.hp-sc-btns {
  display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 20px;
}
.hp-sc-btn-filled {
  display: inline-flex; align-items: center; gap: 7px;
  background: var(--B); color: #fff;
  font-family: var(--F); font-weight: 700; font-size: 14px;
  padding: 10px 20px; border-radius: 999px;
  border: 2px solid var(--B); text-decoration: none; transition: var(--t);
}
.hp-sc-btn-filled:hover { background: #003865; border-color: #003865; color: #fff; }
.hp-sc-btn-outline {
  display: inline-flex; align-items: center; gap: 7px;
  background: transparent; color: var(--B);
  font-family: var(--F); font-weight: 700; font-size: 14px;
  padding: 10px 20px; border-radius: 999px;
  border: 2px solid rgba(0,73,127,.25); text-decoration: none; transition: var(--t);
}
.hp-sc-btn-outline:hover { background: var(--B); color: #fff; border-color: var(--B); }
/* Body text */
.hp-sc-p {
  font-size: 15px; color: var(--M); line-height: 1.72; margin: 0 0 28px;
}
/* Stat pills row */
.hp-sc-stats {
  display: flex; flex-wrap: wrap; gap: 10px;
}
.hp-sc-stat {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,.75); backdrop-filter: blur(6px);
  border: 1px solid rgba(255,255,255,.9);
  border-radius: 999px; padding: 7px 14px;
  font-size: 12px; font-weight: 700; color: var(--D);
  box-shadow: 0 2px 8px rgba(0,73,127,.08);
}
.hp-sc-stat-ico {
  width: 22px; height: 22px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; flex-shrink: 0;
}
.hp-sc-stat-ico--green  { background: #22c55e; color: #fff; }
.hp-sc-stat-ico--blue   { background: var(--S); color: #fff; }
.hp-sc-stat-ico--purple { background: #a855f7; color: #fff; }
.hp-sc-stat-lbl { font-size: 11px; color: var(--M); font-weight: 600; }

/* ════════════════════════════════════════
   CATEGORIES
   ════════════════════════════════════════ */
.hp-cats { background: var(--W); }
.hp-cats-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
.hp-cc {
  background: var(--W); border: 1.5px solid var(--L);
  border-radius: var(--rx); padding: 0; overflow: hidden;
  transition: var(--t); text-decoration: none; display: block;
  box-shadow: 0 2px 10px rgba(0,73,127,.05);
}
.hp-cc:hover {
  border-color: var(--S); transform: translateY(-5px);
  box-shadow: var(--sh-md);
}
.hp-cc-img { width: 100%; height: 180px; overflow: hidden; position: relative; }
.hp-cc-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
.hp-cc:hover .hp-cc-img img { transform: scale(1.07); }
.hp-cc-img-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(0deg, rgba(0,73,127,.7) 0%, transparent 65%);
}
.hp-cc-body { padding: 20px 22px; }
.hp-cc-ico {
  width: 44px; height: 44px; border-radius: var(--r);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 12px; margin-top: -32px; position: relative; z-index: 1;
  border: 2px solid var(--W);
}
.hp-cc-body h3 { font-size: 16px; font-weight: 700; color: var(--D); margin-bottom: 5px; }
.hp-cc-body p  { font-size: 13px; color: var(--M); margin: 0 0 12px; line-height: 1.5; }
.hp-cc-link { font-size: 13px; font-weight: 700; color: var(--S); display: inline-flex; align-items: center; gap: 4px; }
.hp-cc:hover .hp-cc-link { color: var(--O); }

/* ════════════════════════════════════════
   STATS — dark blue band
   ════════════════════════════════════════ */
.hp-stats {
  background: linear-gradient(135deg, #002d50 0%, var(--B) 55%, #0d5c99 100%);
  padding: 80px 0; position: relative; overflow: hidden;
}
.hp-stats::before {
  content: ''; position: absolute; top: -100px; right: -80px;
  width: 350px; height: 350px; border-radius: 50%;
  background: rgba(63,169,245,.06); pointer-events: none;
}
.hp-stats::after {
  content: ''; position: absolute; bottom: -80px; left: -80px;
  width: 300px; height: 300px; border-radius: 50%;
  background: rgba(255,138,61,.05);
}
.hp-sg {
  display: grid; grid-template-columns: repeat(4,1fr);
  gap: 0; text-align: center;
}
.hp-sg > * {
  padding: 0 32px;
  border-right: 1px solid rgba(255,255,255,.1);
}
.hp-sg > *:last-child { border-right: none; }
.hp-sn { font-size: 54px; font-weight: 900; color: #fff; line-height: 1; margin-bottom: 8px; letter-spacing: -2px; }
.hp-sn span { color: var(--S); }
.hp-sl { font-size: 14px; color: rgba(255,255,255,.6); font-weight: 500; letter-spacing: .2px; }
.hp-si {
  font-size: 22px; color: var(--O); margin-bottom: 14px;
  background: rgba(255,138,61,.12); display: inline-flex;
  align-items: center; justify-content: center;
  width: 48px; height: 48px; border-radius: 12px;
}

/* ════════════════════════════════════════
   DUAL CTA — avec images artisans
   ════════════════════════════════════════ */
.hp-dual { background: var(--C); }
.hp-dual-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
.hp-db {
  border-radius: var(--rx); overflow: hidden;
  border: 1.5px solid var(--L); transition: var(--t);
  position: relative;
}
.hp-db:hover { box-shadow: 0 12px 40px rgba(0,73,127,.18); transform: translateY(-3px); }
.hp-db-photo {
  width: 100%; height: 220px; overflow: hidden; position: relative;
}
.hp-db-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
.hp-db-photo-overlay {
  position: absolute; inset: 0;
}
.hp-db--blue .hp-db-photo-overlay { background: linear-gradient(0deg, var(--B) 0%, rgba(0,73,127,.3) 100%); }
.hp-db--cream .hp-db-photo-overlay { background: linear-gradient(0deg, var(--C) 0%, rgba(255,251,235,.2) 100%); }
.hp-db-body { padding: 32px 36px 40px; }
.hp-db--blue  { background: var(--B); border-color: var(--B); }
.hp-db--cream { background: var(--W); }
.hp-db--blue  h2 { font-size: 24px; font-weight: 800; color: #fff; margin-bottom: 12px; }
.hp-db--cream h2 { font-size: 24px; font-weight: 800; color: var(--D); margin-bottom: 12px; }
.hp-db--blue  p  { font-size: 15px; color: rgba(255,255,255,.72); margin-bottom: 24px; line-height: 1.65; }
.hp-db--cream p  { font-size: 15px; color: var(--M); margin-bottom: 24px; line-height: 1.65; }
.hp-db-r { margin-top: 14px; font-size: 12px; }
.hp-db--blue  .hp-db-r { color: rgba(255,255,255,.5); }
.hp-db--cream .hp-db-r { color: var(--M); }
.hp-db-r span { display: inline-flex; align-items: center; gap: 4px; margin-right: 12px; }
.hp-db-r i { color: var(--S); font-size: 11px; }

/* ════════════════════════════════════════
   TESTIMONIALS
   ════════════════════════════════════════ */
.hp-testi { background: var(--W); }
.hp-tg { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }
.hp-tc {
  background: var(--C); border: 1.5px solid #EDE9D4;
  border-radius: var(--rx); padding: 28px; transition: var(--t);
  display: flex; flex-direction: column;
}
.hp-tc:hover { border-color: var(--S); box-shadow: 0 4px 20px rgba(0,73,127,.1); transform: translateY(-3px); }
.hp-tc-pill {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 4px 12px; border-radius: 50px;
  font-size: 11px; font-weight: 700; margin-bottom: 14px; width: fit-content;
}
.hp-tc-pill-o { background: rgba(255,138,61,.1);  color: var(--O); }
.hp-tc-pill-s { background: rgba(63,169,245,.1);  color: var(--S); }
.hp-tc-stars  { display: flex; gap: 3px; margin-bottom: 14px; }
.hp-tc-stars i { color: #F59E0B; font-size: 14px; }
.hp-tc-q { font-size: 14px; color: var(--D); line-height: 1.75; font-style: italic; margin: 0 0 20px; flex: 1; }
.hp-tc-q::before { content: '\201C'; color: var(--S); font-size: 22px; font-style: normal; margin-right: 2px; }
.hp-tc-foot { display: flex; align-items: center; gap: 12px; }
.hp-tc-ava {
  width: 42px; height: 42px; border-radius: 50%;
  background: linear-gradient(135deg, var(--B), var(--S));
  color: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 13px; font-weight: 700; flex-shrink: 0;
}
.hp-tc-name { font-size: 14px; font-weight: 700; color: var(--D); margin-bottom: 2px; }
.hp-tc-role { font-size: 12px; color: var(--M); }

/* ════════════════════════════════════════
   FEATURED PROS
   ════════════════════════════════════════ */
.hp-pros { background: var(--C); }
.hp-pg { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px; }

/* Nouvelle carte Pro "Zen" d'après les guidelines 2025 */
.hp-pro-card {
  background: white; border-radius: 20px; padding: 12px;
  transition: var(--t); box-shadow: 0 4px 20px rgba(0,73,127,.06);
  position: relative; display: flex; flex-direction: column;
}
.hp-pro-card:hover { transform: translateY(-4px); box-shadow: var(--sh); }
.hp-pro-card-badge {
  position: absolute; top: 22px; left: 22px; z-index: 2;
  background: #fff; color: var(--B); font-size: 12px; font-weight: 800;
  padding: 6px 12px; border-radius: 50px; box-shadow: 0 4px 12px rgba(0,0,0,.15);
  display: flex; align-items: center; gap: 5px;
}
.hp-pro-card-badge i { color: var(--O); font-size: 14px; }
.hp-pro-card-img {
  width: 100%; height: 210px; overflow: hidden; border-radius: 12px;
  background: var(--L);
}
.hp-pro-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
.hp-pro-card:hover .hp-pro-card-img img { transform: scale(1.05); }

.hp-pro-card-body { padding: 16px 4px 4px; display: flex; flex-direction: column; flex: 1; }
.hp-pro-card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2px; }
.hp-pro-card-title { font-size: 16px; font-weight: 800; color: var(--B); margin: 0; line-height: 1.2; }
.hp-pro-card-title a { color: inherit; text-decoration: none; }
.hp-pro-card-rating { font-size: 13px; font-weight: 700; color: var(--D); display: flex; align-items: center; gap: 4px; }
.hp-pro-card-rating i { color: #F59E0B; font-size: 15px; }

.hp-pro-card-sub { font-size: 13px; color: var(--M); margin-bottom: 14px; }

.hp-pro-card-foot { display: flex; align-items: center; justify-content: flex-start; gap: 8px; margin-top: auto; }
.hp-pro-btn-contact {
  background: var(--S); color: #fff; border-radius: 50px;
  padding: 8px 16px; font-size: 13px; font-weight: 700;
  display: inline-flex; align-items: center; gap: 6px;
  text-decoration: none; transition: var(--t);
}
.hp-pro-btn-contact:hover { background: #003865; color: #fff; }
.hp-pro-tag {
  background: var(--O); color: #fff; border-radius: 50px;
  padding: 8px 14px; font-size: 13px; font-weight: 800;
  display: inline-flex; align-items: center; gap: 5px;
}
.hp-pro-btn-view {
  margin-left: auto; color: var(--B); font-size: 18px;
  display: flex; align-items: center; justify-content: center;
  transition: var(--t); text-decoration: none;
}
.hp-pro-btn-view:hover { color: var(--S); }

/* ════════════════════════════════════════
   NEWSLETTER
   ════════════════════════════════════════ */
.hp-nl { background: var(--B); position: relative; overflow: hidden; }
.hp-nl::before { content: ''; position: absolute; top: -80px; right: -80px; width: 300px; height: 300px; border-radius: 50%; background: rgba(63,169,245,.1); }
.hp-nl-inner { max-width: 580px; margin: 0 auto; text-align: center; position: relative; z-index: 1; }
.hp-nl-form { display: flex; border-radius: 50px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,.22); max-width: 480px; margin: 0 auto 14px; }
.hp-nl-in { flex: 1; padding: 16px 22px; border: none; background: var(--W); font-family: var(--F); font-size: 15px; outline: none; border-radius: 50px 0 0 50px; }
.hp-nl-btn { background: var(--O); color: #fff; border: none; padding: 16px 28px; font-family: var(--F); font-size: 15px; font-weight: 700; cursor: pointer; transition: var(--t); border-radius: 0 50px 50px 0; white-space: nowrap; }
.hp-nl-btn:hover { background: #d96e10; }
.hp-nl-hint { font-size: 12px; color: rgba(255,255,255,.55); }

/* ════════════════════════════════════════
   APP BANNER — fond Helper Blue, split
   ════════════════════════════════════════ */
.hp-app-banner {
  background: linear-gradient(135deg, #002d50 0%, var(--B) 55%, #0d5c99 100%);
  padding: 88px 0; overflow: hidden; position: relative;
}
.hp-app-banner::before {
  content: ''; position: absolute; top: -100px; right: -100px;
  width: 400px; height: 400px; border-radius: 50%;
  background: rgba(63,169,245,.08); pointer-events: none;
}
.hp-app-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 60px; align-items: center; position: relative; z-index: 1;
}
.hp-app-text {}
.hp-app-img img {
  width: 100%; border-radius: var(--rx);
  box-shadow: 0 20px 60px rgba(0,0,0,.3);
  display: block;
}
@media (max-width: 900px) {
  .hp-app-grid { grid-template-columns: 1fr; gap: 32px; }
  .hp-app-img { order: -1; max-width: 480px; margin: 0 auto; }
}

/* ════════════════════════════════════════
   ANIMATIONS
   ════════════════════════════════════════ */
@media (prefers-reduced-motion: no-preference) {
  .hf { opacity: 0; transform: translateY(28px); transition: opacity .6s cubic-bezier(.4,0,.2,1), transform .6s cubic-bezier(.4,0,.2,1); }
  .hf.in { opacity: 1; transform: none; }
}

/* ════════════════════════════════════════
   RESPONSIVE
   ════════════════════════════════════════ */
@media (max-width: 1024px) {
  .hp-val-grid { grid-template-columns: repeat(2,1fr); }
  .hp-cats-grid { grid-template-columns: repeat(2,1fr); }
  .hp-pg { grid-template-columns: repeat(2,1fr); }
}
@media (max-width: 900px) {
  .hp-hero { grid-template-columns: 1fr; }
  .hp-hero-photo { min-height: 420px; }
  .hp-hero-card { left: 20px; right: 20px; max-width: none; width: auto; border-left-width: 4px; }
  .hp-hero-pro-inner { padding: 40px 24px; }
  .hp-hiw-steps { grid-template-columns: repeat(2,1fr); }
  .hp-hiw-steps::before { display: none; }
  /* Showcase */
  .hp-showcase-grid { grid-template-columns: 1fr; }
  .hp-showcase-photos { padding: 36px 36px 0; }
  .hp-sc-collage { height: 280px; }
  .hp-showcase-text { padding: 32px 36px 48px; }
  .hp-sc-h2 { font-size: 30px; }
  .hp-cats-grid { grid-template-columns: repeat(2,1fr); }
  .hp-sg { grid-template-columns: repeat(2,1fr); }
  .hp-dual-grid { grid-template-columns: 1fr; }
  .hp-tg { grid-template-columns: 1fr; }
}
@media (max-width: 600px) {
  .hp-h1 { font-size: 30px; }
  .hh2 { font-size: 28px; }
  .hp-sc-stats { flex-direction: column; gap: 8px; }
  .hp-sc-btns { flex-direction: column; }
  .hp-sc-btn-filled,.hp-sc-btn-outline { justify-content: center; }
  .hp-hiw-tabs { width: 100%; flex-direction: column; }
  .hp-hiw-tab { flex: 1; text-align: center; justify-content: center; }
  .hp-hiw-subtabs { flex-direction: column; align-items: center; }
  .hp-hiw-steps { grid-template-columns: 1fr; }
  .hp-step:not(:last-child)::after { display: none; }
  .hp-cats-grid { grid-template-columns: 1fr; }
  .hp-val-grid { grid-template-columns: 1fr; }
  .hp-pg { grid-template-columns: 1fr; }
  .hs { padding: 64px 0; }
  .hp-tb { padding: 0 16px; }
  .hp-nl-form { flex-direction: column; }
  .hp-nl-in { border-radius: var(--r) var(--r) 0 0; }
  .hp-nl-btn { border-radius: 0 0 var(--r) var(--r); }
}
@media (max-width: 480px) {
  .hp-tbar-inner { flex-direction: column; gap: 0; }
  .hp-tb { border-right: none; border-bottom: 1px solid var(--L); padding: 12px 0; width: 100%; justify-content: center; }
  .hp-tb:last-child { border-bottom: none; }
}
</style>
{% endblock %}

{% block body %}
<div class="hp">

{# ═══════════════════════════════════════════════════
   HERO — Photo left + Blue pro panel right
   ═══════════════════════════════════════════════════ #}
<section class="hp-hero" aria-labelledby="hp-h1">

  {# Left — background photo with floating card #}
  <div class="hp-hero-photo">
    <img src="{{ asset('assets/drilleedo/images/stock/bg_home.png') }}"
         alt="Artisan en rénovation résidentielle au Canada — service professionnel vérifié"
         loading="eager">

    <div class="hp-hero-card">
      <p class="hp-eyebrow">
        <i class="feather-map-pin"></i>
        Canada · Québec · Ontario · Alberta · C.-B.
      </p>
      <h1 class="hp-h1" id="hp-h1">
        <span>Vos travaux,</span>
        <span>le bon pro.</span>
      </h1>
      <p class="hp-tagline">Drilleedo · Easy help, Fast solutions.</p>

      {# Search bar #}
      <form class="hp-search" action="{{ path('professionals_list') }}" method="get" role="search">
        <i class="feather-search"></i>
        <input type="text" name="keyword" placeholder="Plombier, électricien, peintre, déménageur…" aria-label="Rechercher un professionnel">
        <button type="submit" class="hbtn hbtn-o" style="padding:0;width:44px;height:44px;border-radius:50%;justify-content:center;flex-shrink:0;">
          <i class="feather-arrow-right" style="font-size:18px;"></i>
        </button>
        
      </form>

      {# Quick category chips #}
      <div class="hp-qchips">
        <a href="{{ path('professionals_list', {keyword:'plomberie'}) }}" class="hp-qchip"><i class="feather-droplet"></i> Plomberie</a>
        <a href="{{ path('professionals_list', {keyword:'électricité'}) }}" class="hp-qchip"><i class="feather-zap"></i> Électricité</a>
        <a href="{{ path('professionals_list', {keyword:'peinture'}) }}" class="hp-qchip"><i class="feather-edit-2"></i> Peinture</a>
        <a href="{{ path('professionals_list', {keyword:'jardinage'}) }}" class="hp-qchip"><i class="feather-sun"></i> Jardinage</a>
        <a href="{{ path('professionals_list') }}" class="hp-qchip" style="color:var(--B);border-color:rgba(0,73,127,.25);">+ Voir tout</a>
      </div>

      {# Social proof — avatars + étoiles (avant CTA = build trust first) #}
      <div class="hp-social-proof">
        <div class="hp-avatars">
          <div class="hp-av" style="background:linear-gradient(135deg,#00497F,#3FA9F5);">M</div>
          <div class="hp-av" style="background:linear-gradient(135deg,#FF8A3D,#c95a08);">I</div>
          <div class="hp-av" style="background:linear-gradient(135deg,#16a34a,#22c55e);">L</div>
          <div class="hp-av" style="background:linear-gradient(135deg,#7c3aed,#a78bfa);">S</div>
        </div>
        <div>
          <div class="hp-proof-stars">★★★★★</div>
          <div class="hp-proof-text">2 500+ propriétaires satisfaits</div>
        </div>
      </div>

      {# CTAs — orange primaire, outline secondaire #}
      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:20px;">
        <a href="{{ path('professionals_list') }}" class="hbtn hbtn-o" style="flex:1;justify-content:center;">
          <i class="feather-send"></i> Publier mon projet — c'est gratuit
        </a>
        <a href="{{ path('professionals_list') }}" class="hbtn hbtn-g">
          <i class="feather-search"></i> Explorer les pros
        </a>
      </div>
    </div>
  </div>

  {# Right — panel pro — style exact référence #}
  <div class="hp-hero-pro">
    <div class="hp-hero-pro-inner">

      {# Badge : carte sky-blue avec Banner Man + texte Drilleedo #}
      <div class="hp-pro-photo-badge">
        <div class="hp-pro-photo-badge-img">
          <img src="{{ asset('assets/drilleedo/images/stock/banner_man.svg') }}"
               alt="Professionnel Drilleedo" loading="eager">
        </div>
        <div class="hp-pro-photo-badge-text">
          <div class="hp-pro-photo-badge-name">Drilleedo</div>
          <span>| For the professionals</span>
        </div>
      </div>

      <h2>Développez<br>votre activité.</h2>
      <p class="hp-hero-pro-sub">Rejoignez 1 500+ artisans vérifiés au Canada. Recevez des demandes qualifiées près de chez vous, construisez votre réputation en ligne — sans abonnement, sans commission.</p>

      <div class="hp-pro-form">
        <form action="{{ path('app_register') }}" method="post" novalidate>
          <label for="hero-email">Adresse courriel professionnelle</label>
          <input id="hero-email" type="email" name="email" class="hp-pro-input" placeholder="mon@entreprise.ca" required autocomplete="email" style="background: white;">
          <a href="{{ path('app_register_pro') }}" class="hbtn hbtn-o" style="width:100%;justify-content:center;text-decoration:none;font-size:15px;">
            <i class="feather-user-plus"></i> Rejoindre maintenant
          </a>
        </form>
      </div>

      <div class="hp-pro-badges">
        <span class="hp-pro-badge"><i class="feather-zap"></i> Profil en ligne en moins de 24 h</span>
        <span class="hp-pro-badge"><i class="feather-shield"></i> Sans commission</span>
        <span class="hp-pro-badge"><i class="feather-trending-up"></i> +40% de demandes dès le 1er mois</span>
      </div>
    </div>

  </div>

</section>




{# ═══════════════════════════════════════════════════
   WELCOME / SHOWCASE — Designer match
   ═══════════════════════════════════════════════════ #}
<section class="hp-showcase" aria-labelledby="hp-sc-h2">
  <div class="hp-showcase-grid">

    {# LEFT — Image composition complète (man_woman.png) #}
    <div class="hp-showcase-photos hf">
      <div class="hp-sc-collage">
        <img src="{{ asset('assets/drilleedo/images/team/man_woman.png') }}"
             alt="Professionnels Drilleedo — plombier et jardinière vérifiés au Canada" loading="lazy">
      </div>
    </div>

    {# RIGHT — Texte + boutons + stats #}
    <div class="hp-showcase-text hf" style="transition-delay:.15s">

      <p class="hp-sc-eyebrow">Bienvenue sur Drilleedo</p>
      <h2 class="hp-sc-h2" id="hp-sc-h2">
        Des pros fiables,<br>partout au Canada.
      </h2>

      {# 3 boutons pills : 1 filled + 2 outline #}
      <div class="hp-sc-btns">
        <a href="{{ path('app_about') }}" class="hp-sc-btn-filled">
          À propos de Drilleedo
        </a>
        <a href="{{ path('app_about') }}" class="hp-sc-btn-outline">
          Notre mission
        </a>
        <a href="{{ path('contact') }}" class="hp-sc-btn-outline">
          Nous contacter
        </a>
      </div>

      <p class="hp-sc-p">
        Drilleedo est la plateforme canadienne qui met en relation les propriétaires avec des artisans qualifiés et vérifiés.
        Rénovation, plomberie, électricité, jardinage — trouvez le bon expert pour chaque besoin.
      </p>

      {# Stat pills — 3 badges colorés #}
