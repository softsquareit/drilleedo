      <div class="hp-pro-badges">
        <span class="hp-pro-badge"><i class="feather-zap"></i> Profil actif en moins de 24 h</span>
        <span class="hp-pro-badge"><i class="feather-shield"></i> Zéro abonnement requis</span>
        <span class="hp-pro-badge"><i class="feather-trending-up"></i> +40% de demandes en moyenne</span>
      </div>
    </div>

  </div>

</section>




{# ═══════════════════════════════════════════════════
   WELCOME / SHOWCASE — Designer match
   ═══════════════════════════════════════════════════ #}
<section class="hp-showcase" aria-labelledby="hp-sc-h2">
  <div class="hp-showcase-grid">

    {# LEFT — Image composition complète (man_woman.png) #}
    <div class="hp-showcase-photos hf">
      <div class="hp-sc-collage">
        <img src="{{ asset('assets/drilleedo/images/team/man_woman.png') }}"
             alt="Professionnels Drilleedo" loading="lazy">
      </div>
