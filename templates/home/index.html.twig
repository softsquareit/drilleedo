{# ── Testimonials ── #}
    {% if testimonials|length > 0 %}
    <section class="rbt-testimonial-area rbt-section-gapBottom overflow-hidden mt_dec--120 mt_lp_dec--30 mt_lg_dec--30 mt_md_dec--30 mt_sm_dec--30"
             aria-label="Customer reviews and testimonials">
        
        <div class="scroll-animation-wrapper mt--50">
            <div class="scroll-animation scroll-right-left">
                {% for i in 1..3 %}
                    {% for testimonial in testimonials %}
                    <!-- Start Single Testimonial  -->
                    <div class="single-column-20">
                        <div class="rbt-testimonial-box">
                            <div class="inner">
                                <div class="clint-info-wrapper">
                                    <div class="thumb">
                                        {% if testimonial.image %}
                                            <img src="{{ asset('uploads/testimonials/' ~ testimonial.image) }}"
                                                 alt="{{ testimonial.clientName }} — verified Drilleedo customer"
                                                 loading="lazy"
                                                 width="60" height="60"
                                                 style="width: 60px; height: 60px; object-fit: cover; border-radius: 50%;">
                                        {% else %}
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                <i class="feather-user fs-3"></i>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="client-info">
                                        <h5 class="title">{{ testimonial.clientName }}</h5>
                                        {% if testimonial.clientRole %}<span>{{ testimonial.clientRole|raw }}</span>{% endif %}
                                    </div>
                                </div>
                                <div class="description mt-3">
                                    <p class="subtitle-3">{{ testimonial.content }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- End Single Testimonial  -->
                    {% endfor %}
                {% endfor %}
            </div>
        </div>

        {% if testimonials|length > 1 %}
        <div class="scroll-animation-wrapper mt--30">
            <div class="scroll-animation scroll-left-right">
                {% for i in 1..3 %}
                    {% for testimonial in testimonials|reverse %}
                    <!-- Start Single Testimonial  -->
                    <div class="single-column-20">
                        <div class="rbt-testimonial-box">
                            <div class="inner">
                                <div class="clint-info-wrapper">
                                    <div class="thumb">
                                        {% if testimonial.image %}
                                            <img src="{{ asset('uploads/testimonials/' ~ testimonial.image) }}"
                                                 alt="{{ testimonial.clientName }} — verified Drilleedo customer review"
                                                 loading="lazy" width="60" height="60">
                                        {% else %}
                                            <img src="{{ asset('assets/drilleedo/images/testimonial/client-01.png') }}"
                                                 alt="Drilleedo customer avatar"
                                                 loading="lazy" width="60" height="60">
                                        {% endif %}
                                    </div>
                                    <div class="client-info">
                                        <h5 class="title">{{ testimonial.clientName }}</h5>
                                        {% if testimonial.clientRole %}<span>{{ testimonial.clientRole|raw }}</span>{% endif %}
                                    </div>
                                </div>
                                <div class="description mt-3">
                                    <p class="subtitle-3">{{ testimonial.content }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- End Single Testimonial  -->
                    {% endfor %}
                {% endfor %}
            </div>
        </div>
        {% endif %}

    </section>
    {% endif %}
    {# ── /Testimonials ── #}


{# ── Featured Professionals ── #}
