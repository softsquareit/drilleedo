{# ═══════════════════════════════════════════════════
   HOW IT WORKS
   ═══════════════════════════════════════════════════ #}
<section class="hs hp-hiw" aria-labelledby="hp-hiw-h2">
  <div class="hw">

    {# Titre de section #}
    <div class="hc" style="margin-bottom:40px;">
      <span class="hpill hpill-o"><i class="feather-zap"></i> Rapide &amp; facile</span>
      <h2 class="hh2 hh2-w" id="hp-hiw-h2">Comment ça marche</h2>
      <p class="hl hlc" style="color:rgba(255,255,255,.65);">Deux façons de trouver votre artisan idéal — publiez un projet ou cherchez directement par vous-même.</p>
    </div>

    {# Tabs principaux : Propriétaire vs Pro #}
    <div class="hc" style="margin-bottom:28px;">
      <div class="hp-hiw-tabs" role="tablist">
        <button class="hp-hiw-tab active" role="tab" aria-selected="true"
                id="tab-o" aria-controls="panel-o"
                onclick="hiwSwitch('o',this)">
          <i class="feather-home"></i> Je cherche un Professionnel
        </button>
        <button class="hp-hiw-tab" role="tab" aria-selected="false"
                id="tab-p" aria-controls="panel-p"
                onclick="hiwSwitch('p',this)">
          <i class="feather-tool"></i> Je suis professionnel
        </button>
      </div>
    </div>

    {# ── Panneau Propriétaire (2 scénarios) ── #}
    <div id="panel-o" role="tabpanel" aria-labelledby="tab-o">

      {# Sous-tabs scénarios #}
      <div class="hc">
        <div class="hp-hiw-subtabs">
          <button class="hp-hiw-subtab active"
                  id="stab-o1" onclick="hiwSubSwitch('o1', this)">
            <i class="feather-file-text"></i> Publier mon projet
          </button>
          <button class="hp-hiw-subtab"
                  id="stab-o2" onclick="hiwSubSwitch('o2', this)">
            <i class="feather-search"></i> Je cherche moi-même
          </button>
        </div>
      </div>

      {# Scénario 1 — Publier un projet #}
      <div class="hp-hiw-steps" id="steps-o1">
        <div class="hp-step hf">
          <div class="hp-step-n">1</div>
          <h3>Publiez votre projet</h3>
          <p>Décrivez vos besoins, localisation, budget. Gratuit et sans engagement.</p>
        </div>
        <div class="hp-step hf" style="transition-delay:.08s">
          <div class="hp-step-n">2</div>
          <h3>Comparez les pros</h3>
          <p>Profils vérifiés, portfolios, avis certifiés de vrais clients.</p>
        </div>
        <div class="hp-step hf" style="transition-delay:.16s">
          <div class="hp-step-n">3</div>
          <h3>Recevez vos devis</h3>
          <p>Jusqu'à 5 devis compétitifs de spécialistes qualifiés, en moins de 24 h.</p>
        </div>
        <div class="hp-step hf" style="transition-delay:.24s">
          <div class="hp-step-n">4</div>
          <h3>Démarrez sereinement</h3>
          <p>Comparez, choisissez le meilleur rapport qualité-prix et lancez votre projet.</p>
        </div>
      </div>

      {# Scénario 2 — Je cherche moi-même #}
      <div class="hp-hiw-steps" id="steps-o2" style="display:none">
        <div class="hp-step">
          <div class="hp-step-n">1</div>
          <h3>Recherchez un professionnel</h3>
          <p>Parcourez les profils selon votre besoin et votre localisation.</p>
        </div>
        <div class="hp-step">
          <div class="hp-step-n">2</div>
          <h3>Comparez les meilleurs profils</h3>
          <p>Consultez avis, réalisations et expériences en détail.</p>
        </div>
        <div class="hp-step">
          <div class="hp-step-n">3</div>
          <h3>Envoyez une demande</h3>
          <p>Contactez directement les professionnels qui vous intéressent.</p>
        </div>
        <div class="hp-step">
          <div class="hp-step-n">4</div>
          <h3>Lancez en toute confiance</h3>
          <p>Échangez, choisissez et démarrez votre projet.</p>
        </div>
      </div>

    </div>{# /panel-o #}

    {# ── Panneau Professionnel ── #}
    <div id="panel-p" role="tabpanel" aria-labelledby="tab-p" style="display:none">
      <div class="hp-hiw-steps" id="steps-p">
        <div class="hp-step">
          <div class="hp-step-n">1</div>
          <h3>Créez votre profil</h3>
          <p>Inscrivez-vous gratuitement, ajoutez vos certifications, licences et portfolio de réalisations.</p>
        </div>
        <div class="hp-step">
          <div class="hp-step-n">2</div>
          <h3>Recevez des demandes</h3>
          <p>Recevez des projets qualifiés dans votre secteur — clients sérieux, besoins précis, localisation ciblée.</p>
        </div>
        <div class="hp-step">
          <div class="hp-step-n">3</div>
          <h3>Envoyez vos devis</h3>
          <p>Soumettez vos devis directement aux propriétaires intéressés — sans intermédiaire, sans commission.</p>
        </div>
        <div class="hp-step">
          <div class="hp-step-n">4</div>
          <h3>Développez votre réputation</h3>
          <p>Accumulez des avis certifiés, renforcez votre crédibilité en ligne et attirez toujours plus de clients.</p>
        </div>
      </div>
    </div>{# /panel-p #}

    <div class="hc" style="margin-top:52px;">
      <a href="{{ path('professionals_list') }}" class="hbtn hbtn-o hbtn-lg">
        <i class="feather-arrow-right"></i> Trouver mon pro maintenant
      </a>
    </div>

  </div>
</section>



{# ── App Banner — Drilleedo brand style ── #}
