{% extends 'base.html.twig' %}

{% block title %}Drilleedo – Find Trusted Home Renovation Professionals in Canada{% endblock %}
{% block meta_description %}Connect with verified contractors, plumbers, electricians and renovators near you. Get free quotes and compare professionals on Drilleedo, Canada's home improvement marketplace.{% endblock %}
{% block meta_keywords %}home renovation Canada, find contractors Canada, renovation quotes, hire professional, home improvement marketplace, renovation services Toronto, Montreal contractors{% endblock %}
{% block og_title %}Drilleedo – Find Trusted Home Renovation Professionals in Canada{% endblock %}
{% block og_description %}Connect with verified contractors near you. Get free quotes and compare professionals on Canada's #1 home improvement marketplace.{% endblock %}

{% block structured_data %}
{{ parent() }}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Drilleedo",
    "description": "Canadian home improvement marketplace connecting homeowners with trusted renovation professionals.",
    "url": "{{ url('app_home') }}",
    "telephone": "+14065550120",
    "address": {
        "@type": "PostalAddress",
        "addressLocality": "Toronto",
        "addressRegion": "ON",
        "addressCountry": "CA"
    },
    "areaServed": {
        "@type": "Country",
        "name": "Canada"
    },
    "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "reviewCount": "10000",
        "bestRating": "5",
        "worstRating": "1"
    },
    "sameAs": []
}
</script>
{% endblock %}

{% block body %}
<main id="main-content">

{# ── Hero Section ── #}
<section class="hero-main-container" aria-labelledby="hero-heading">
    <!-- Left Side - Glassmorphism Content -->
    <div class="hero-left-side">
        <div class="hero-content-card">
            <h1 class="hero-main-title" id="hero-heading">Find Trusted Renovation Professionals<br>for Every Project in Canada.</h1>
            
            <p class="hero-subtitle-text">
                Join thousands of Canadians who have successfully renovated their homes. Get free quotes from verified contractors, plumbers, and electricians near you.
            </p>
            
            <div class="hero-trust-badges" role="list" aria-label="Platform guarantees">
                <div class="hero-trust-badge" role="listitem">
                    <i class="feather-check-circle" aria-hidden="true"></i> Verified Professionals
                </div>
                <div class="hero-trust-badge" role="listitem">
                    <i class="feather-shield" aria-hidden="true"></i> 100% Free Quotes
                </div>
            </div>

            <div class="hero-actions">
                <a href="{{ path('professionals_list') }}"
                   class="hero-btn btn-primary-hero"
                   aria-label="Find and hire a renovation professional near you">
                    Hire a Pro <i class="feather-arrow-right" aria-hidden="true"></i>
                </a>
                <a href="{{ path('companies_list') }}"
                   class="hero-btn btn-secondary-hero"
                   aria-label="Browse specialized renovation companies">
                    Browse Companies
                </a>
            </div>
            
            <div class="hero-reviews-section" aria-label="Customer ratings">
                <div class="hero-reviews-avatars" aria-hidden="true">
                    {# Local SVG avatar placeholders — no external CDN dependency #}
                    <img src="{{ asset('assets/drilleedo/images/team/avatar.jpg') }}" alt="" loading="lazy" width="40" height="40">
                    <img src="{{ asset('assets/drilleedo/images/team/avatar.jpg') }}" alt="" loading="lazy" width="40" height="40" style="margin-left:-12px">
                    <img src="{{ asset('assets/drilleedo/images/team/avatar.jpg') }}" alt="" loading="lazy" width="40" height="40" style="margin-left:-12px">
                    <img src="{{ asset('assets/drilleedo/images/team/avatar.jpg') }}" alt="" loading="lazy" width="40" height="40" style="margin-left:-12px">
                </div>
                <div class="hero-reviews-text">
                    <div class="hero-star-rating" aria-label="4.8 out of 5 stars">★★★★★</div>
                    Trusted by <strong>10,000+</strong> Canadian homeowners
                </div>
            </div>
        </div>
    </div>
    
    <!-- Right Side - Professional Blue Section -->
    <div class="hero-right-side">
        <div class="pro-header-section">
            <div class="pro-worker-image">
                <img src="{{ asset('assets/drilleedo/images/team/banner_man .svg') }}"
                     alt="Professional renovation contractor ready to take on your project"
                     width="400" height="400"
                     style="object-fit:cover; width:100%; height:100%; border-radius: 8px;">
            </div>
            <div class="pro-label-wrapper">
                <div class="pro-logo-text">Drilleedo</div>
                <div class="pro-small-label">| For the professionals</div>
            </div>
        </div>
        
        <h2 class="pro-main-heading">Are you a<br>professional?</h2>
        
        <p class="pro-description-text">
            Are you a renovation professional looking to grow your business?
        </p>

        <p class="pro-description-text" style="margin-top: -15px; font-size: 13px; opacity: 0.7;">
            Join Drilleedo and connect with thousands of clients seeking skilled experts across the building industry.
        </p>
        
        <form class="pro-signup-form" action="{{ path('app_register') }}" method="post"
              novalidate aria-label="Quick professional registration">
            <label for="hero-pro-email" class="sr-only">Your professional email address</label>
            <input type="email" id="hero-pro-email" name="email"
                   class="pro-email-input"
                   placeholder="E-mail address"
                   required autocomplete="email"
                   style="background: white;"
                   aria-required="true">
            <button type="submit" class="pro-submit-button">Get Started Free</button>
        </form>
    </div>
</section>
{# ── /Hero ── #}

{# ── How It Works ── #}
<section id="how-it-works" class="how-it-works-section" aria-labelledby="how-it-works-heading">
    <div class="how-it-works-header">
        <h2 class="how-it-works-title" id="how-it-works-heading">How Drilleedo Works</h2>
        <p class="how-it-works-subtitle">
            Finding the right professional for your home improvement project has never been easier. Just 3 simple steps to get started.
        </p>
    </div>

    <ol class="how-it-works-steps" aria-label="Steps to find a professional on Drilleedo">
        <li class="how-it-works-step">
            <div class="step-number" aria-hidden="true">1</div>
            <i class="feather-edit-3 step-icon" aria-hidden="true"></i>
            <h3 class="step-title">Tell Us What You Need</h3>
            <p class="step-desc">
                Describe your renovation project, location, and budget. It only takes a few minutes to submit your request.
            </p>
        </li>
        <li class="how-it-works-step">
            <div class="step-number" aria-hidden="true">2</div>
            <i class="feather-users step-icon" aria-hidden="true"></i>
            <h3 class="step-title">Receive Free Quotes</h3>
            <p class="step-desc">
                Verified renovation professionals in your area will review your project and send competitive, no-obligation quotes.
            </p>
        </li>
        <li class="how-it-works-step">
            <div class="step-number" aria-hidden="true">3</div>
            <i class="feather-check-circle step-icon" aria-hidden="true"></i>
            <h3 class="step-title">Hire the Best Pro</h3>
            <p class="step-desc">
                Compare profiles, read verified reviews, and choose the most qualified certified professional for your renovation.
            </p>
        </li>
    </ol>
</section>
{# ── /How It Works ── #}

{# ── About Section ── #}
<section class="about-new-section" aria-labelledby="about-heading">
    <div class="about-images-wrapper">
        <div class="about-img-group-1">
            <div class="about-purple-bg" aria-hidden="true"></div>
            <img src="{{ asset('assets/drilleedo/images/team/man_woman.png') }}"
                 alt="Drilleedo certified renovation professionals — a man and woman contractor team in Canada"
                 class="about-img-1"
                 loading="lazy"
                 width="680" height="500">
        </div>
    </div>

    <!-- Right Content -->
    <div class="about-content-wrapper">
        <p class="about-subtitle">Welcome to Drilleedo</p>
        <h2 class="about-title" id="about-heading">Find Trusted<br>Renovation Professionals Easily.</h2>

        <div class="about-buttons-row" role="tablist" aria-label="Learn more about Drilleedo">
            <button class="about-pill-btn btn-solid-blue"
                    role="tab" id="tab-about"
                    aria-selected="true" aria-controls="about-content-about"
                    onclick="switchAboutTab('about', this)">About Drilleedo</button>
            <button class="about-pill-btn btn-outline-blue"
                    role="tab" id="tab-mission"
                    aria-selected="false" aria-controls="about-content-mission"
                    onclick="switchAboutTab('mission', this)">Our Mission</button>
            <button class="about-pill-btn btn-outline-blue"
                    role="tab" id="tab-contact"
                    aria-selected="false" aria-controls="about-content-contact"
                    onclick="switchAboutTab('contact', this)">Contact Us</button>
        </div>

        <div id="about-content-about" class="about-text-content"
             role="tabpanel" aria-labelledby="tab-about">
            <p class="about-desc">
                Drilleedo connects Canadian homeowners with reliable, verified professionals across all trades — renovation, plumbing, electrical, and more. Quality, trust, and transparency are at the core of our platform.
            </p>
        </div>

        <div id="about-content-mission" class="about-text-content"
             role="tabpanel" aria-labelledby="tab-mission" hidden>
            <p class="about-desc">
                Our mission is to simplify home improvement by creating a safe, transparent marketplace where homeowners can find certified renovation experts they can rely on across Canada.
            </p>
        </div>

        <div id="about-content-contact" class="about-text-content"
             role="tabpanel" aria-labelledby="tab-contact" hidden>
            <p class="about-desc">
                Need help? Reach our support team at <a href="mailto:support@drilleedo.com" style="color:#00509e; font-weight:bold;">support@drilleedo.com</a>. We're here to assist you 24/7.
            </p>
        </div>

        <script>
        // Accessible tab switcher — uses `hidden` attribute & aria-selected
        function switchAboutTab(tabName, btn) {
            document.querySelectorAll('.about-text-content').forEach(el => {
                el.hidden = true;
            });
            document.querySelectorAll('.about-buttons-row [role="tab"]').forEach(b => {
                b.setAttribute('aria-selected', 'false');
                b.classList.replace('btn-solid-blue', 'btn-outline-blue');
            });
            document.getElementById('about-content-' + tabName).hidden = false;
            btn.setAttribute('aria-selected', 'true');
            btn.classList.replace('btn-outline-blue', 'btn-solid-blue');
        }
        </script>

        <dl class="about-stats-row" aria-label="Drilleedo platform statistics">
            <div class="about-stat-card">
                <div class="stat-icon-circle bg-green-grad" aria-hidden="true"><i class="fas fa-check"></i></div>
                <div class="stat-info">
                    <dt><strong>+35,000</strong></dt>
                    <dd>Projects Completed</dd>
                </div>
            </div>
            <div class="about-stat-card">
                <div class="stat-icon-circle bg-blue-grad" aria-hidden="true"><i class="fas fa-star"></i></div>
                <div class="stat-info">
                    <dt><strong>100%</strong></dt>
                    <dd>Verified Pros</dd>
                </div>
            </div>
            <div class="about-stat-card">
                <div class="stat-icon-circle bg-purple-grad" aria-hidden="true"><i class="fas fa-heart"></i></div>
                <div class="stat-info">
                    <dt><strong>+85%</strong></dt>
                    <dd>Customer Satisfaction</dd>
                </div>
            </div>
        </dl>
    </div>
</section>
{# ── /About ── #}


