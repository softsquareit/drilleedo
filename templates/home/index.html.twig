            <div class="hp-sc-stat-lbl">Professionnels seulement</div>
          </div>
        </div>
        <div class="hp-sc-stat">
          <div class="hp-sc-stat-ico hp-sc-stat-ico--purple">
            <i class="feather-heart"></i>
          </div>
          <div>
            <div style="font-weight:800;font-size:13px;color:var(--D);">98%</div>
            <div class="hp-sc-stat-lbl">Satisfaction client</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>



{# ═══════════════════════════════════════════════════
   HOW IT WORKS
   ═══════════════════════════════════════════════════ #}
<section class="hs hp-hiw" aria-labelledby="hp-hiw-h2">
  <div class="hw">
    <div class="hc" style="margin-bottom:44px;">
      <span class="hpill hpill-o"><i class="feather-zap"></i> Simple et rapide</span>
      <h2 class="hh2 hh2-w" id="hp-hiw-h2">Comment ça marche</h2>
    </div>
    <div class="hc" style="margin-bottom:52px;">
      <div class="hp-hiw-tabs" role="tablist">
        <button class="hp-hiw-tab active" role="tab" aria-selected="true" id="tab-o" aria-controls="steps-o" onclick="hiwSwitch('o',this)">Je cherche un Professionel</button>
        <button class="hp-hiw-tab" role="tab" aria-selected="false" id="tab-p" aria-controls="steps-p" onclick="hiwSwitch('p',this)">Je suis professionnel</button>
      </div>
    </div>

    <div class="hp-hiw-steps" id="steps-o" role="tabpanel" aria-labelledby="tab-o">
      <div class="hp-step hf"><div class="hp-step-n">1</div><h3>Publiez votre projet</h3><p>Décrivez vos besoins, localisation, budget. Gratuit et sans engagement.</p></div>
      <div class="hp-step hf" style="transition-delay:.08s"><div class="hp-step-n">2</div><h3>Comparez les pros</h3><p>Profils vérifiés, portfolios, avis certifiés de vrais clients.</p></div>
      <div class="hp-step hf" style="transition-delay:.16s"><div class="hp-step-n">3</div><h3>Recevez des devis</h3><p>Plusieurs devis compétitifs de spécialistes qualifiés.</p></div>
      <div class="hp-step hf" style="transition-delay:.24s"><div class="hp-step-n">4</div><h3>Démarrez en confiance</h3><p>Choisissez le meilleur pro et lancez votre projet.</p></div>
    </div>

    <div class="hp-hiw-steps" id="steps-p" role="tabpanel" aria-labelledby="tab-p" style="display:none">
      <div class="hp-step"><div class="hp-step-n">1</div><h3>Créez votre profil</h3><p>Inscrivez-vous, ajoutez certifications et portfolio.</p></div>
      <div class="hp-step"><div class="hp-step-n">2</div><h3>Recevez des demandes</h3><p>Projets qualifiés dans votre secteur géographique.</p></div>
      <div class="hp-step"><div class="hp-step-n">3</div><h3>Envoyez vos devis</h3><p>Répondez directement aux clients sans intermédiaire.</p></div>
      <div class="hp-step"><div class="hp-step-n">4</div><h3>Développez votre réputation</h3><p>Collectez des avis vérifiés et attirez plus de clients.</p></div>
    </div>

    <div class="hc" style="margin-top:48px;">
      <a href="{{ path('professionals_list') }}" class="hbtn hbtn-o hbtn-lg">
