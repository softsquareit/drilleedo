{% extends 'base.html.twig' %}

{% block title %}Create a Professional Account | Drilleedo{% endblock %}
{% block meta_description %}Join Drilleedo as a renovation professional. Get verified, receive direct leads without bidding wars, and manage your projects from one powerful dashboard.{% endblock %}

{% block body %}
<main id="main-content">
<style>
/* ══ REGISTER PRO LANDING PAGE ════════════════════════════════════════════
   Follows the Drilleedo brand charter: navy #0d2151, blue #00509e, orange #e8501a
   Reuses the .gyb- prefix structural system.
   ═════════════════════════════════════════════════════════════════════════ */

/* ── 1. Hero ── */
.gyb-hero {
  min-height: 500px;
  background: linear-gradient(135deg, #0d2151 0%, #00509e 100%);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.gyb-hero__pattern {
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}

.gyb-hero__inner {
  position: relative;
  z-index: 2;
  padding: 100px 0;
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
}

.gyb-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.1);
  color: #fff;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 999px;
  padding: 6px 18px;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 24px;
}

.gyb-eyebrow i { color: #f97316; }

.gyb-hero__title {
  font-size: clamp(38px, 5vw, 68px);
  font-weight: 900;
  color: #fff;
  margin: 0 0 24px;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.gyb-hero__title span {
  color: #e8501a;
  position: relative;
  display: inline-block;
}

.gyb-hero__title span::after {
  content: '';
  position: absolute;
  bottom: 8px;
  left: 0;
  width: 100%;
  height: 8px;
  background: rgba(232,80,26,0.3);
  z-index: -1;
  border-radius: 4px;
}

.gyb-hero__sub {
  font-size: 19px;
  color: rgba(255,255,255,0.85);
  line-height: 1.7;
  margin-bottom: 40px;
  max-width: 700px;
  margin-left: auto;
  margin-right: auto;
}

/* ── Call to Action Buttons ── */
.gyb-btn-orange {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  background: #e8501a;
  color: #fff;
  font-size: 18px;
  font-weight: 800;
  padding: 20px 48px;
  border-radius: 12px;
  text-decoration: none;
  border: none;
  box-shadow: 0 8px 32px rgba(232,80,26,0.4);
  transition: all 0.3s ease;
}
.gyb-btn-orange:hover { background: #c43d10; transform: translateY(-4px); color: #fff; box-shadow: 0 12px 40px rgba(232,80,26,0.5); }

/* ── 2. Benefits Grid ── */
.gyb-section { padding: 90px 0; background: #f8fafc; }

.gyb-benefits-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
  margin-top: -60px; /* Pull up into hero slightly */
  position: relative;
  z-index: 10;
}

.gyb-benefit-card {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 24px;
  padding: 40px 32px;
  text-align: center;
  box-shadow: 0 20px 48px rgba(13,33,81,0.08);
  transition: transform 0.3s;
}

.gyb-benefit-card:hover {
  transform: translateY(-8px);
  border-color: #bfdbfe;
}

.gyb-benefit-ico {
  width: 80px;
  height: 80px;
  border-radius: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24px;
  font-size: 36px;
  color: #fff;
}

.gyb-benefit-ico--blue { background: linear-gradient(135deg, #00509e, #3b82f6); }
.gyb-benefit-ico--orng { background: linear-gradient(135deg, #e8501a, #f97316); }
.gyb-benefit-ico--navy { background: linear-gradient(135deg, #0d2151, #1a3a6b); }

.gyb-benefit-card h3 {
  font-size: 22px;
  font-weight: 800;
  color: #0d2151;
  margin: 0 0 12px;
}

.gyb-benefit-card p {
  font-size: 15px;
  color: #64748b;
  line-height: 1.6;
  margin: 0;
}

/* ── 3. Profile Preview Strip ── */
.gyb-preview-strip {
  background: #fff;
  padding: 80px 0;
  border-top: 1px solid #e2e8f0;
  border-bottom: 1px solid #e2e8f0;
}

.gyb-preview-content {
  display: flex;
  align-items: center;
  gap: 60px;
}

.gyb-preview-text { flex: 1; }
.gyb-preview-visual { flex: 1; text-align: right; position: relative; }

.gyb-preview-visual img {
  max-width: 100%;
  border-radius: 20px;
  box-shadow: 0 24px 64px rgba(13,33,81,0.12);
}

.gyb-preview-title {
  font-size: 32px;
  font-weight: 900;
  color: #0d2151;
  margin-bottom: 20px;
  line-height: 1.2;
}

.gyb-preview-title span { color: #00509e; }

.gyb-checklist {
  list-style: none; padding: 0; margin: 30px 0 0;
  display: flex; flex-direction: column; gap: 16px;
}
.gyb-checklist li {
  display: flex; align-items: flex-start; gap: 16px;
  font-size: 16px; color: #475569; font-weight: 600;
}
.gyb-checklist li i {
  color: #16a34a; font-size: 20px; margin-top: 2px;
}

/* ── Responsive ── */
@media (max-width: 991px) {
  .gyb-benefits-grid { grid-template-columns: 1fr; margin-top: 40px; }
  .gyb-preview-content { flex-direction: column; gap: 40px; }
  .gyb-preview-visual { text-align: center; }
}

@media (max-width: 767px) {
  .gyb-hero { min-height: 400px; }
  .gyb-hero__inner { padding: 60px 20px; }
}

/* Scroll Animations */
.gyb-scroll { opacity: 0; transform: translateY(24px); transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
.gyb-scroll.visible { opacity: 1; transform: none; }
</style>

{# ══════════════════════════════════════════════════════════════════════════
   1. HERO
══════════════════════════════════════════════════════════════════════════ #}
<section class="gyb-hero" aria-labelledby="hero-title">
  <div class="gyb-hero__pattern"></div>
  <div class="container">
    <div class="gyb-hero__inner gyb-scroll">
      <div class="gyb-eyebrow">
        <i class="feather-star"></i> {{ 'pro_landing.register_eyebrow'|trans }}
      </div>
      <h1 class="gyb-hero__title" id="hero-title">
        {{ 'pro_landing.register_title'|trans }} <span>{{ 'pro_landing.register_title_span'|trans }}</span><br>
        {{ 'pro_landing.register_title_after'|trans }}
      </h1>
      <p class="gyb-hero__sub">
        {{ 'pro_landing.register_sub'|trans }}
      </p>
      
      <div class="mt--40">
        <a href="{{ path('app_register') }}" class="gyb-btn-orange">
          {{ 'pro_landing.register_cta'|trans }} <i class="feather-arrow-right"></i>
        </a>
      </div>
      <p style="color: rgba(255,255,255,0.6); font-size: 13px; margin-top: 16px;">
        {{ 'pro_landing.register_note'|trans }}
      </p>
    </div>
  </div>
</section>

{# ══════════════════════════════════════════════════════════════════════════
   2. BENEFITS GRID
══════════════════════════════════════════════════════════════════════════ #}
<section class="gyb-section pt-0">
  <div class="container">
    <div class="gyb-benefits-grid">
      
      {# Card 1 #}
      <div class="gyb-benefit-card gyb-scroll">
        <div class="gyb-benefit-ico gyb-benefit-ico--blue">
          <i class="feather-target"></i>
        </div>
        <h3>{{ 'pro_landing.bene_title1'|trans }}</h3>
        <p>{{ 'pro_landing.bene_desc1'|trans }}</p>
      </div>

      {# Card 2 #}
      <div class="gyb-benefit-card gyb-scroll">
        <div class="gyb-benefit-ico gyb-benefit-ico--orng">
          <i class="feather-shield"></i>
        </div>
        <h3>{{ 'pro_landing.bene_title2'|trans }}</h3>
        <p>{{ 'pro_landing.bene_desc2'|trans }}</p>
      </div>

      {# Card 3 #}
      <div class="gyb-benefit-card gyb-scroll">
        <div class="gyb-benefit-ico gyb-benefit-ico--navy">
          <i class="feather-percent"></i>
        </div>
        <h3>{{ 'pro_landing.bene_title3'|trans }}</h3>
        <p>{{ 'pro_landing.bene_desc3'|trans }}</p>
      </div>

    </div>
  </div>
</section>

{# ══════════════════════════════════════════════════════════════════════════
   3. PROFILE PREVIEW STRIP
══════════════════════════════════════════════════════════════════════════ #}
<section class="gyb-preview-strip">
  <div class="container">
    <div class="gyb-preview-content">
      
      <div class="gyb-preview-text gyb-scroll">
        <h2 class="gyb-preview-title">{{ 'pro_landing.preview_title'|trans }} <span>{{ 'pro_landing.preview_title_span'|trans }}</span></h2>
        <p style="font-size: 18px; color: #64748b; line-height: 1.6; margin-bottom: 0;">
          {{ 'pro_landing.preview_desc'|trans }}
        </p>
        
        <ul class="gyb-checklist">
          <li><i class="feather-check-circle"></i> {{ 'pro_landing.preview_check1'|trans }}</li>
          <li><i class="feather-check-circle"></i> {{ 'pro_landing.preview_check2'|trans }}</li>
          <li><i class="feather-check-circle"></i> {{ 'pro_landing.preview_check3'|trans }}</li>
          <li><i class="feather-check-circle"></i> {{ 'pro_landing.preview_check4'|trans }}</li>
        </ul>
        
        <div class="mt--40">
           <a href="{{ path('app_register') }}" class="rbt-btn btn-md btn-border">{{ 'pro_landing.preview_cta'|trans }}</a>
        </div>
      </div>
      
      <div class="gyb-preview-visual gyb-scroll">
        {# Using a mockup of a profile card #}
        <div style="background: white; padding: 40px; border-radius: 20px; text-align: left; box-shadow: 0 40px 80px rgba(13,33,81,0.1); border: 1px solid #e2e8f0; position: relative;">
          
          <div style="position: absolute; top: -15px; right: -15px; background: #e8501a; color: white; width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 20px rgba(232,80,26,0.3);">
            <i class="feather-bell" style="font-size: 24px;"></i>
          </div>
          
          <div style="display: flex; gap: 20px; align-items: center; margin-bottom: 30px;">
            <div style="width: 80px; height: 80px; background: #f1f5f9; border-radius: 16px; display: flex; align-items: center; justify-content: center;">
              <i class="feather-image" style="font-size: 32px; color: #cbd5e1;"></i>
            </div>
            <div>
              <div style="font-size: 20px; font-weight: 800; color: #0d2151; margin-bottom: 4px;">Your Company Name</div>
              <div style="display: flex; gap: 8px; align-items: center; font-size: 14px; font-weight: 700;">
                <span style="color: #f59e0b;"><i class="fas fa-star"></i> 5.0 (24 reviews)</span>
                <span style="color: #cbd5e1;">|</span>
                <span style="color: #00509e;"><i class="feather-shield"></i> Verified Pro</span>
              </div>
            </div>
          </div>
          
          <div style="background: #f8fafc; padding: 20px; border-radius: 12px; margin-bottom: 20px;">
            <div style="font-size: 12px; text-transform: uppercase; font-weight: 800; color: #94a3b8; margin-bottom: 8px;">New Quote Request</div>
            <div style="font-size: 16px; font-weight: 700; color: #0d2151;">Full Kitchen Renovation</div>
            <div style="font-size: 14px; color: #64748b; margin-top: 4px;"><i class="feather-map-pin"></i> Downtown Montréal, QC</div>
          </div>
          
          <div style="background: #00509e; color: white; text-align: center; padding: 14px; border-radius: 8px; font-weight: 700;">
            Reply to Homeowner
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

</main>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { 
      if (e.isIntersecting) { 
        e.target.classList.add('visible'); 
        obs.unobserve(e.target); 
      } 
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.gyb-scroll').forEach(el => obs.observe(el));
});
</script>
{% endblock %}
