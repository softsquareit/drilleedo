{% extends 'base.html.twig' %}

{% block title %}Trouver des professionnels | Drilleedo Canada{% endblock %}
{% block meta_description %}Parcourez et comparez des professionnels vérifiés en rénovation résidentielle. Filtrez par catégorie et localisation. Obtenez des devis gratuits sur Drilleedo.{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/drilleedo/css/custom/professionals_list.css') }}">
{% endblock %}

{% block body %}
<div class="fp-page">

{# ══════════════════════════════════════════════════════════════════════════
   1. HERO BANNER
══════════════════════════════════════════════════════════════════════════ #}
<div class="fp-hero">
  <img src="{{ asset('uploads/banners/professionels.png') }}"
       alt="Professionnels Drilleedo"
       class="fp-hero__img">
  <div class="fp-hero__content">
    <h1 class="fp-hero__title">Trouvez un professionnel près de chez vous</h1>
    <p class="fp-hero__sub">
      Comparez des entrepreneurs vérifiés en rénovation, plomberie, électricité et bien plus au Canada.
    </p>
    <div class="fp-hero__search">
      <form action="{{ path('professionals_list') }}" method="GET" class="fp-search-bar">
        <span class="fp-search-bar__icon">
          <i class="feather-search"></i>
        </span>
        <input type="text"
               name="keyword"
               class="fp-search-bar__input"
               placeholder="Nom, service, ville…"
               value="{{ activeFilters.keyword ?? '' }}"
               aria-label="Recherche de professionnels">
        <button type="submit" class="fp-search-bar__btn">Rechercher</button>
      </form>
    </div>
    <div class="fp-hero__stats">
      <span>✅ {{ professionals|length }}+ professionnels vérifiés</span>
      <span class="fp-hero__stat-dot">·</span>
      <span>⭐ Notes clients certifiées</span>
      <span class="fp-hero__stat-dot">·</span>
      <span>📋 Devis gratuits</span>
    </div>
  </div>
</div>

{# ══════════════════════════════════════════════════════════════════════════
   2. HORIZONTAL CATEGORY PILLS (parent categories only)
══════════════════════════════════════════════════════════════════════════ #}
<div class="fp-cat-bar" role="navigation" aria-label="Filtrer par catégorie">
  <div class="fp-cat-bar__inner">

    {# "Tous" pill #}
    <button class="fp-cat-pill active" data-category="all" aria-pressed="true">
      <i class="feather-grid"></i>
      Toutes
      <span class="fp-cat-pill__count">{{ professionals|length }}</span>
    </button>

    {# Only parent categories (parent == null) #}
    {% for cat in allCategories %}
      {% if cat.parent is null %}
        <button class="fp-cat-pill"
                data-category="{{ cat.id }}"
                aria-pressed="false">
          {% if cat.icon %}
            <img src="{{ asset('uploads/categories/' ~ cat.icon) }}"
                 alt=""
                 class="fp-cat-pill__icon">
          {% else %}
            <i class="feather-briefcase"></i>
          {% endif %}
          {{ cat.name }}
          <span class="fp-cat-pill__count">{{ categoryCounts[cat.id] ?? 0 }}</span>
        </button>
      {% endif %}
    {% endfor %}

  </div>
</div>

{# ══════════════════════════════════════════════════════════════════════════
   3. MAIN LAYOUT (sidebar + cards)
══════════════════════════════════════════════════════════════════════════ #}
<div class="fp-wrap">
  <div class="fp-layout">

    {# ── LEFT SIDEBAR ── #}
    <aside class="fp-sidebar" aria-label="Filtres">
      <form action="{{ path('professionals_list') }}" method="GET" id="filters-form">

        {# Keep keyword + sort through sidebar form #}
        {% if activeFilters.keyword %}
          <input type="hidden" name="keyword" value="{{ activeFilters.keyword }}">
        {% endif %}
        {% if activeFilters.sort %}
          <input type="hidden" name="sort" value="{{ activeFilters.sort }}">
        {% endif %}

        {# Location filter #}
        <div class="fp-sidebar-card">
          <div class="fp-sidebar-card__header">
            <i class="feather-map-pin"></i>
            Ville / Région
          </div>
          <div class="fp-sidebar-card__body">
            <ul class="fp-city-list" role="list">
              {% for city in allCities %}
                <li class="fp-city-row {{ city in activeFilters.cities ? 'active' : '' }}">
                  <label for="city-{{ loop.index }}">
                    <input id="city-{{ loop.index }}"
                           type="checkbox"
                           name="cities[]"
                           value="{{ city }}"
                           {{ city in activeFilters.cities ? 'checked' : '' }}
                           onchange="this.form.submit()">
                    {{ city }}
                  </label>
                  <span class="fp-city-count">{{ cityCounts[city] ?? 0 }}</span>
                </li>
              {% else %}
                <li style="font-size:13px;color:#94a3b8;padding:8px 0;">Aucune ville disponible</li>
              {% endfor %}
            </ul>
          </div>
        </div>

        {# Actions #}
        <button type="submit" class="fp-btn-apply" aria-label="Appliquer les filtres">
          Appliquer les filtres
        </button>
        {% if activeFilters.cities is not empty or activeFilters.categories is defined and activeFilters.categories is not empty %}
          <a href="{{ path('professionals_list') }}" class="fp-btn-clear" aria-label="Effacer tous les filtres">
            Effacer les filtres
          </a>
        {% endif %}

      </form>
    </aside>

    {# ── MAIN CONTENT ── #}
    <div class="fp-content">

      {# Meta row: count + sort #}
      <div class="fp-meta-row">
        <p class="fp-meta-count">
          <span id="filtered-count">{{ professionals|length }}</span> professionnel{{ professionals|length > 1 ? 's' : '' }} disponible{{ professionals|length > 1 ? 's' : '' }}
        </p>
        <form action="{{ path('professionals_list') }}" method="GET" id="sort-form">
          {% if activeFilters.keyword %}<input type="hidden" name="keyword" value="{{ activeFilters.keyword }}">{% endif %}
          {% for city in activeFilters.cities %}<input type="hidden" name="cities[]" value="{{ city }}">{% endfor %}
          <select name="sort"
                  class="fp-sort-select"
                  onchange="this.form.submit()"
                  aria-label="Trier les résultats">
            <option value="newest"     {{ activeFilters.sort == 'newest'     ? 'selected' : '' }}>Trier : Récents</option>
            <option value="rating"     {{ activeFilters.sort == 'rating'     ? 'selected' : '' }}>Trier : Mieux notés</option>
            <option value="experience" {{ activeFilters.sort == 'experience' ? 'selected' : '' }}>Trier : Expérience</option>
          </select>
        </form>
      </div>

      {# Professional cards grid #}
      <div class="fp-pro-grid" id="pro-grid">

        {% set starPath = 'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z' %}

        {% for pro in professionals %}
          {% set rating    = pro.stats ? pro.stats.averageRating : 5.0 %}
          {% set fullStars = rating|round(0, 'floor') %}
          {% set initials  = pro.companyName
              ? (pro.companyName|split(' ')|map(w => w|slice(0,1))|join('')|upper|slice(0,2))
              : (pro.personalInfos ? (pro.personalInfos.firstName|slice(0,1) ~ pro.personalInfos.lastName|slice(0,1))|upper : 'PR') %}
          {% set profileUrl = path('professional_details', {
              'id': pro.id,
              'slug': pro.companyName
                  |default(pro.personalInfos ? pro.personalInfos.firstName ~ '-' ~ pro.personalInfos.lastName : pro.email)
                  |trim|lower|replace({' ': '-'})
          }) %}

          <div class="fp-pro-card pro-card-item" data-category="{{ pro.category ? pro.category.id : '' }}">

            {# Top-rated badge #}
            {% if pro.isTopRated or (pro.stats and pro.stats.averageRating >= 4.5) %}
              <div class="fp-badge-top" aria-label="Professionnel top noté">
                ⭐ Top Rated
              </div>
            {% endif %}

            {# Card image #}
            <div class="fp-card-img-wrap">
              <a href="{{ profileUrl }}" tabindex="-1" aria-hidden="true">
                <img src="{{ pro.banner ? asset('uploads/banners/' ~ pro.banner) : asset('assets/drilleedo/images/team/plumber.png') }}"
                     alt="{{ pro.companyName ?? 'Professionnel' }}"
                     loading="lazy">
              </a>
              <div class="fp-card-avatar" aria-hidden="true">
                {% if pro.logo %}
                  <img src="{{ asset('uploads/logos/' ~ pro.logo) }}" alt="">
                {% else %}
                  {{ initials }}
                {% endif %}
              </div>
            </div>

            {# Card body #}
            <div class="fp-card-body">

              {% if pro.isVerified %}
                <div class="fp-card-verified">✔ Vérifié Drilleedo</div>
              {% endif %}

              <h3 class="fp-card-name">
                <a href="{{ profileUrl }}">
                  {% if pro.companyName %}
                    {{ pro.companyName }}
                  {% elseif pro.personalInfos %}
                    {{ pro.personalInfos.firstName }} {{ pro.personalInfos.lastName }}
                  {% else %}
                    {{ pro.email|split('@')[0] }}
                  {% endif %}
                </a>
              </h3>

              <div class="fp-card-meta">
                {% if pro.category %}
                  <span>
                    <i class="feather-briefcase"></i>
                    {{ pro.category.name }}
                  </span>
                {% endif %}
                <span>
                  <i class="feather-map-pin"></i>
                  {{ pro.city ?? 'Canada' }}
                </span>
                <span>
                  <i class="feather-clock"></i>
                  {{ pro.expYears ?? '5' }}+ ans d'exp.
                </span>
              </div>

              <div class="fp-card-rating">
                <div class="fp-stars" aria-label="Note {{ rating|number_format(1) }} sur 5">
                  {% for i in range(1, 5) %}
                    <svg viewBox="0 0 20 20" {{ i > fullStars ? 'style="fill: #e2e8f0"' : '' }}>
                      <path d="{{ starPath }}"/>
                    </svg>
                  {% endfor %}
                </div>
                <span class="fp-card-rating__num">{{ rating|number_format(1) }}</span>
                <span class="fp-card-rating__cnt">({{ pro.stats ? pro.stats.reviewCount : 0 }} avis)</span>
              </div>

              <div class="fp-card-actions">
                <a href="{{ profileUrl }}" class="fp-btn-outline">
                  Voir le profil
                </a>
                <a href="{{ path('individual_direct_request_new', {'type': 'professional', 'id': pro.id}) }}"
                   class="fp-btn-solid">
                  Devis gratuit
                </a>
              </div>

            </div>
          </div>
        {% else %}
          <div class="fp-empty">
            <div class="fp-empty__icon">🔍</div>
            <h4>Aucun professionnel trouvé</h4>
            <p>Essayez d'ajuster vos filtres ou parcourez tous nos professionnels au Canada.</p>
            <a href="{{ path('professionals_list') }}" class="fp-btn-browse">
              Voir tous les professionnels
            </a>
          </div>
        {% endfor %}

      </div>{# /fp-pro-grid #}

      {# Pagination #}
      {% if totalPages > 1 %}
        <nav class="fp-pagination" aria-label="Navigation des pages">
          {% if currentPage > 1 %}
            <a href="{{ path('professionals_list', app.request.query.all|merge({'page': currentPage - 1})) }}" aria-label="Page précédente">
              <i class="feather-chevron-left"></i>
            </a>
          {% endif %}
          {% for i in 1..totalPages %}
            {% if i == currentPage %}
              <span class="active" aria-current="page">{{ i }}</span>
            {% else %}
              <a href="{{ path('professionals_list', app.request.query.all|merge({'page': i})) }}">{{ i }}</a>
            {% endif %}
          {% endfor %}
          {% if currentPage < totalPages %}
            <a href="{{ path('professionals_list', app.request.query.all|merge({'page': currentPage + 1})) }}" aria-label="Page suivante">
              <i class="feather-chevron-right"></i>
            </a>
          {% endif %}
        </nav>
      {% endif %}

    </div>{# /fp-content #}

  </div>{# /fp-layout #}
</div>{# /fp-wrap #}

</div>{# /fp-page #}
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
  const pills  = document.querySelectorAll('.fp-cat-pill');
  const cards  = document.querySelectorAll('.pro-card-item');
  const count  = document.getElementById('filtered-count');

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      const cat = pill.dataset.category;

      // Update active pill
      pills.forEach(p => { p.classList.remove('active'); p.setAttribute('aria-pressed', 'false'); });
      pill.classList.add('active');
      pill.setAttribute('aria-pressed', 'true');

      // Filter cards
      let visible = 0;
      cards.forEach(card => {
        const show = cat === 'all' || card.dataset.category === cat;
        if (show) {
          card.style.display = 'flex';
          void card.offsetWidth;
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
          visible++;
        } else {
          card.style.opacity = '0';
          card.style.transform = 'translateY(12px)';
          setTimeout(() => { if (card.style.opacity === '0') card.style.display = 'none'; }, 280);
        }
      });

      // Update count
      if (count) {
        count.style.transform = 'scale(1.15)';
        setTimeout(() => { count.textContent = visible; count.style.transform = 'scale(1)'; }, 140);
      }
    });
  });
});
</script>
{% endblock %}
