{% extends 'base.html.twig' %}

{% block title %}{{ 'careers.meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'careers.meta_desc'|trans }}{% endblock %}

{% block og_title %}{{ 'careers.meta_title'|trans }}{% endblock %}
{% block og_description %}{{ 'careers.meta_desc'|trans }}{% endblock %}

{% block body %}
    <!-- Breadcrumb Area -->
    <div class="rbt-breadcrumb-default ptb--100 ptb_md--50 ptb_sm--30 bg-color-white">
        <div class="container">
            <div class="row">
                <div class="col-12 text-center">
                    <h1 class="title">{{ 'careers.page_title'|trans }}</h1>
                    <ul class="page-list" aria-label="Breadcrumbs">
                        <li class="rbt-breadcrumb-item"><a href="{{ path('app_home') }}">{{ 'careers.breadcrumb_home'|trans }}</a></li>
                        <li>
                            <div class="icon-right"><i class="feather-chevron-right" aria-hidden="true"></i></div>
                        </li>
                        <li class="rbt-breadcrumb-item active" aria-current="page">{{ 'careers.breadcrumb_current'|trans }}</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Area -->
    <div class="rbt-accordion-area accordion-style-1 bg-color-white pb--100 pb_md--50 pb_sm--30">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-6">
                    <div class="rbt-accordion-style accordion">
                        <div class="section-title text-start mb--40">
                            <span class="subtitle bg-primary-opacity">{{ 'careers.eyebrow'|trans }}</span>
                            <h2 class="title">{{ 'careers.h2'|trans }}</h2>
                            <p class="description mt--20">
                                {{ 'careers.p1'|trans }}
                            </p>
                            <p class="description mt--15">
                                {{ 'careers.p2'|trans }}
                            </p>
                        </div>

                        <div class="contact-action mt--30">
                            <a href="mailto:careers@drilleedo.com" class="rbt-btn btn-gradient hover-icon-reverse radius-round">
                                <span class="icon-reverse-wrapper">
                                    <span class="btn-text">{{ 'careers.cta'|trans }}</span>
                                    <span class="btn-icon"><i class="feather-mail"></i></span>
                                    <span class="btn-icon"><i class="feather-mail"></i></span>
                                </span>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="thumbnail">
                        <img class="w-100 radius-10 shadow-sm" src="{{ asset('assets/drilleedo/images/team/man.png') }}" alt="{{ 'careers.img_alt'|trans }}">
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
