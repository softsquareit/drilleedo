{% extends 'base.html.twig' %}

{% block title %}Grow Your Renovation Business in Canada | Drilleedo{% endblock %}
{% block meta_description %}Discover how Drilleedo helps Canadian renovation professionals scale their business, get more qualified leads, and build a lasting online reputation.{% endblock %}

{% block body %}
<main id="main-content">
<style>
/* ══ GROW YOUR BUSINESS PAGE ══════════════════════════════════════════════
   Follows the Drilleedo brand charter: navy #0d2151, blue #00509e, orange #e8501a
   Reuses the .gyb- prefix structural system from the For Professionals page.
   ═════════════════════════════════════════════════════════════════════════ */

/* ── 1. Hero ── */
.gyb-hero {
  min-height: 480px;
  background: linear-gradient(135deg, #0d2151 0%, #00509e 100%);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.gyb-hero__pattern {
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}

.gyb-hero::before {
  content: '';
  position: absolute;
  left: -100px;
  bottom: -100px;
  width: 400px;
  height: 400px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232,80,26,0.15) 0%, transparent 70%);
  pointer-events: none;
}

.gyb-hero__inner {
  position: relative;
  z-index: 2;
  padding: 80px 0;
  text-align: center;
  max-width: 800px;
  margin: 0 auto;
}

.gyb-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.1);
  color: #fff;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 999px;
  padding: 6px 18px;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 24px;
  backdrop-filter: blur(4px);
}

.gyb-eyebrow i { color: #f97316; }

.gyb-hero__title {
  font-size: clamp(36px, 5vw, 64px);
  font-weight: 900;
  color: #fff;
  margin: 0 0 20px;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.gyb-hero__title span {
  color: #e8501a;
  position: relative;
  display: inline-block;
}

.gyb-hero__title span::after {
  content: '';
  position: absolute;
  bottom: 8px;
  left: 0;
  width: 100%;
  height: 8px;
  background: rgba(232,80,26,0.3);
  z-index: -1;
  border-radius: 4px;
}

.gyb-hero__sub {
  font-size: 18px;
  color: rgba(255,255,255,0.85);
  line-height: 1.7;
  margin-bottom: 36px;
}

.gyb-hero__actions {
  display: flex;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
}

.gyb-btn-orange {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #e8501a;
  color: #fff;
  font-size: 16px;
  font-weight: 800;
  padding: 16px 36px;
  border-radius: 8px;
  text-decoration: none;
  border: none;
  box-shadow: 0 6px 24px rgba(232,80,26,0.35);
  transition: all 0.2s ease;
}
.gyb-btn-orange:hover { background: #c43d10; transform: translateY(-3px); color: #fff; box-shadow: 0 8px 32px rgba(232,80,26,0.45); }

.gyb-btn-white {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.1);
  color: #fff;
  font-size: 16px;
  font-weight: 800;
  padding: 14px 32px;
  border-radius: 8px;
  text-decoration: none;
  border: 2px solid rgba(255,255,255,0.4);
  transition: all 0.2s ease;
  backdrop-filter: blur(4px);
}
.gyb-btn-white:hover { background: #fff; color: #0d2151; border-color: #fff; }

/* ── 2. Sections ── */
.gyb-section { padding: 100px 0; }
.gyb-section--gray { background: #f8fafc; }
.gyb-section--blue { background: linear-gradient(170deg, #f0f6ff 0%, #e8eeff 100%); }

.gyb-section-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #e8f4fd;
  color: #00509e;
  border: 1px solid rgba(0,80,158,0.15);
  border-radius: 999px;
  padding: 6px 16px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 16px;
}

.gyb-section-title {
  font-size: clamp(28px, 4vw, 42px);
  font-weight: 900;
  color: #0d2151;
  margin: 0 0 16px;
  line-height: 1.15;
  letter-spacing: -0.02em;
}

.gyb-section-title span { color: #e8501a; }

.gyb-section-sub {
  font-size: 17px;
  color: #64748b;
  line-height: 1.75;
  max-width: 650px;
}

/* ── 3. Growth Grid (Features) ── */
.gyb-growth-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32px;
  margin-top: 60px;
}

.gyb-growth-card {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 24px;
  padding: 40px;
  display: flex;
  gap: 24px;
  transition: transform 0.3s, box-shadow 0.3s;
}

.gyb-growth-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 48px rgba(13,33,81,0.08);
  border-color: #bfdbfe;
}

.gyb-growth-ico {
  width: 72px;
  height: 72px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  flex-shrink: 0;
}

.gyb-growth-ico--navy  { background: linear-gradient(135deg, #0d2151, #1a3a6b); color: #fff; }
.gyb-growth-ico--orng  { background: linear-gradient(135deg, #e8501a, #f97316); color: #fff; }
.gyb-growth-ico--blue  { background: linear-gradient(135deg, #00509e, #3b82f6); color: #fff; }
.gyb-growth-ico--green { background: linear-gradient(135deg, #16a34a, #22c55e); color: #fff; }

.gyb-growth-content h3 {
  font-size: 20px;
  font-weight: 800;
  color: #0d2151;
  margin: 0 0 12px;
}

.gyb-growth-content p {
  font-size: 15px;
  color: #64748b;
  line-height: 1.7;
  margin: 0;
}

/* ── 4. Impact Numbers ── */
.gyb-impact {
  background: linear-gradient(135deg, #e8501a 0%, #c43d10 100%);
  border-radius: 24px;
  padding: 60px 40px;
  color: #fff;
  position: relative;
  overflow: hidden;
  margin-top: 80px;
}

.gyb-impact::after {
  content: '';
  position: absolute;
  top: 0; right: 0;
  width: 50%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1));
  pointer-events: none;
}

.gyb-impact-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  position: relative;
  z-index: 2;
  text-align: center;
}

.gyb-impact-item__num {
  font-size: 48px;
  font-weight: 900;
  line-height: 1;
  margin-bottom: 8px;
}

.gyb-impact-item__lbl {
  font-size: 14px;
  font-weight: 700;
  color: rgba(255,255,255,0.85);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* ── 5. Marketing Toolkit (Checklist) ── */
.gyb-toolkit {
  display: flex;
  align-items: center;
  gap: 60px;
}

.gyb-toolkit-img {
  flex: 1;
  position: relative;
}

.gyb-toolkit-img img {
  width: 100%;
  border-radius: 24px;
  box-shadow: 0 24px 64px rgba(13,33,81,0.15);
}

.gyb-toolkit-content {
  flex: 1;
}

.gyb-checklist {
  list-style: none;
  padding: 0;
  margin: 32px 0 0;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.gyb-checklist li {
  display: flex;
  align-items: flex-start;
  gap: 16px;
}

.gyb-checklist-ico {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #e8f4fd;
  color: #00509e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  flex-shrink: 0;
  margin-top: 3px;
}

.gyb-checklist-text h4 {
  font-size: 16px;
  font-weight: 800;
  color: #0d2151;
  margin: 0 0 4px;
}

.gyb-checklist-text p {
  font-size: 14px;
  color: #64748b;
  margin: 0;
  line-height: 1.6;
}

/* ── 6. Final CTA ── */
.gyb-final {
  background: #0d2151;
  padding: 100px 0;
  text-align: center;
  position: relative;
}

.gyb-final__title {
  font-size: clamp(32px, 4vw, 48px);
  font-weight: 900;
  color: #fff;
  margin: 0 0 24px;
}

/* ── Responsive ── */
@media (max-width: 991px) {
  .gyb-growth-grid { grid-template-columns: 1fr; }
  .gyb-impact-grid { grid-template-columns: repeat(2, 1fr); gap: 40px; }
  .gyb-toolkit { flex-direction: column; }
}

@media (max-width: 767px) {
  .gyb-growth-card { flex-direction: column; padding: 32px 24px; }
  .gyb-impact-grid { grid-template-columns: 1fr; }
  .gyb-section { padding: 70px 0; }
}

/* Scroll Animations */
.gyb-scroll { opacity: 0; transform: translateY(24px); transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
.gyb-scroll.visible { opacity: 1; transform: none; }
</style>

