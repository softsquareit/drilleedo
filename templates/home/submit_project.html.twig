{% extends 'base.html.twig' %}

{% block title %}{{ 'submit_pg.page_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'submit_pg.meta_description'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ══════════════════════════════════════
   BRAND TOKENS (page-scoped)
══════════════════════════════════════ */
:root {
    --B: #00497F;
    --S: #3FA9F5;
    --O: #FF8A3D;
    --D: #0C1825;
    --M: #4A6073;
}

/* ══════════════════════════════════════
   SUBMIT PAGE — GLOBAL
══════════════════════════════════════ */
.prj-page { font-family:'Instrument Sans',system-ui,sans-serif; }

/* ══════════════════════════════════════
   BREADCRUMB
══════════════════════════════════════ */
.prj-breadcrumb { background:var(--D); padding:11px 0; }
.prj-breadcrumb a { color:rgba(255,255,255,.5); font-size:12px; text-decoration:none; transition:color .15s; }
.prj-breadcrumb a:hover { color:#fff; }
.prj-breadcrumb .sep { color:rgba(255,255,255,.25); margin:0 7px; font-size:12px; }
.prj-breadcrumb strong { color:rgba(255,255,255,.9); font-size:12px; }

/* ══════════════════════════════════════
   HERO
══════════════════════════════════════ */
.prj-hero {
    background: linear-gradient(135deg, var(--D) 0%, #3a1f00 55%, #7a3a00 100%);
    padding: 70px 0 0; overflow: hidden; position: relative;
}
/* dot texture */
.prj-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,138,61,.1) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
}
.prj-hero::after {
    content: '';
    position: absolute; bottom: 0; left: 0; right: 0; height: 80px;
    background: linear-gradient(to top, #fff8f2, transparent);
    pointer-events: none;
}
.prj-hero-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,138,61,.18); border: 1px solid rgba(255,138,61,.4);
    color: var(--O); font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase;
    padding: 6px 16px; border-radius: 50px; margin-bottom: 22px;
}
.prj-hero h1 {
    font-size: clamp(2.1rem, 4.2vw, 3rem);
    font-weight: 900; color: #fff; line-height: 1.1;
    margin-bottom: 20px; letter-spacing: -.02em;
}
.prj-hero h1 .hl { color: var(--O); }
.prj-hero-lead {
    font-size: 1.05rem; color: rgba(255,255,255,.75);
    line-height: 1.75; margin-bottom: 34px; max-width: 520px;
}
.prj-hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 44px; }
.btn-prj-primary {
    display: inline-flex; align-items: center; gap: 9px;
    background: var(--O); color: #fff; font-size: 15px; font-weight: 700;
    padding: 14px 30px; border-radius: 12px; text-decoration: none;
    box-shadow: 0 4px 18px rgba(255,138,61,.45); transition: all .2s;
}
.btn-prj-primary:hover { background: #e07830; color: #fff; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(255,138,61,.5); }
.btn-prj-outline {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,.1); color: #fff; font-size: 15px; font-weight: 600;
    padding: 13px 26px; border-radius: 12px; text-decoration: none;
    border: 1.5px solid rgba(255,255,255,.3); transition: all .2s;
}
.btn-prj-outline:hover { background: rgba(255,255,255,.18); color: #fff; }
.prj-hero-trust { display: flex; align-items: center; gap: 14px; }
.prj-trust-faces { display: flex; }
.prj-trust-faces img {
    width: 34px; height: 34px; border-radius: 50%;
    border: 2px solid rgba(255,255,255,.4); object-fit: cover; margin-left: -8px;
}
.prj-trust-faces img:first-child { margin-left: 0; }
.prj-trust-text { font-size: 13px; color: rgba(255,255,255,.75); }
.prj-trust-text strong { color: #fff; }

/* Hero image */
.prj-hero-img-col { position: relative; display: flex; align-items: flex-end; justify-content: center; }
.prj-hero-img {
    width: 100%; max-width: 460px;
    border-radius: 20px 20px 0 0;
    object-fit: cover; object-position: center;
    height: 460px; display: block;
    box-shadow: -20px 0 60px rgba(0,0,0,.3);
}
.prj-float {
    position: absolute; background: #fff; border-radius: 14px;
    padding: 13px 18px; box-shadow: 0 8px 32px rgba(0,0,0,.15);
    display: flex; align-items: center; gap: 12px; white-space: nowrap;
}
.prj-float-1 { left: -10px; top: 60px; }
.prj-float-2 { right: 8px; top: 190px; }
.prj-float-3 { left: 0; bottom: 90px; }
.prj-float-icon {
    width: 38px; height: 38px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; flex-shrink: 0;
}
.prj-float-icon.orange { background: #fff0e0; color: var(--O); }
.prj-float-icon.blue   { background: #dde9ff; color: var(--B); }
.prj-float-icon.green  { background: #d1fae5; color: #059669; }
.prj-float-val { font-size: 18px; font-weight: 900; color: var(--D); line-height: 1; }
.prj-float-lbl { font-size: 11px; color: var(--M); margin-top: 2px; }

/* ══════════════════════════════════════
   STATS BAND
══════════════════════════════════════ */
.prj-stats-band { background: #fff8f2; padding: 44px 0; border-bottom: 1px solid #fdd0a2; }
.prj-stats-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px,1fr)); gap: 0;
}
.prj-stat-item { text-align: center; padding: 18px 20px; border-right: 1px solid #fdd0a2; }
.prj-stat-item:last-child { border-right: none; }
.prj-stat-val {
    font-size: 2.3rem; font-weight: 900; color: var(--O); line-height: 1;
    margin-bottom: 5px; letter-spacing: -.03em;
}
.prj-stat-val span { color: var(--D); font-size: 1.6rem; }
.prj-stat-lbl { font-size: 13px; color: var(--M); font-weight: 500; }

/* ══════════════════════════════════════
   SHARED LABELS
══════════════════════════════════════ */
.prj-section-title {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 900; color: var(--D); line-height: 1.2;
    letter-spacing: -.02em; margin-bottom: 14px;
}
.prj-section-title .hl { color: var(--O); }
.prj-section-sub { font-size: 15px; color: var(--M); line-height: 1.8; margin-bottom: 30px; }

/* ══════════════════════════════════════
   OBJECTIF
══════════════════════════════════════ */
.prj-objectif { background: #fff; padding: 80px 0; }
.prj-objectif-tag {
    display: inline-flex; align-items: center; gap: 7px;
    background: #fff0e0; color: var(--O);
    font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    padding: 6px 14px; border-radius: 50px; margin-bottom: 16px;
}
.prj-objectif-img {
    width: 100%; border-radius: 20px; object-fit: cover; height: 400px;
    box-shadow: 0 16px 48px rgba(255,138,61,.12);
}
.prj-img-wrap { position: relative; display: inline-block; width: 100%; }
.prj-img-badge {
    position: absolute; top: 20px; right: 20px;
    background: #fff; border-radius: 12px;
    padding: 10px 16px; box-shadow: 0 6px 20px rgba(0,0,0,.15);
    display: flex; align-items: center; gap: 10px;
}
.prj-img-badge-icon { width: 32px; height: 32px; border-radius: 8px; background: #fff0e0; color: var(--O); display: flex; align-items: center; justify-content: center; font-size: 14px; }
.prj-img-badge-val { font-size: 16px; font-weight: 900; color: var(--D); line-height: 1; }
.prj-img-badge-lbl { font-size: 11px; color: var(--M); }

.prj-check-list { list-style: none; padding: 0; margin: 0 0 32px; }
.prj-check-list li {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 10px 0; border-bottom: 1px solid #f1f5f9;
    font-size: 14px; color: var(--D); line-height: 1.5;
}
.prj-check-list li:last-child { border-bottom: none; }
.prj-check-icon {
    width: 22px; height: 22px; border-radius: 50%;
    background: var(--O); color: #fff;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; font-size: 11px; margin-top: 1px;
}

/* ══════════════════════════════════════
   COMMENT ÇA MARCHE
══════════════════════════════════════ */
.prj-how { background: #fff8f2; padding: 80px 0; }
.prj-how-header { text-align: center; margin-bottom: 56px; }
.prj-steps-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(230px,1fr)); gap: 24px;
}
.prj-step-card {
    background: #fff; border: 1px solid #fdd0a2; border-radius: 18px;
    padding: 30px 24px; position: relative; overflow: hidden;
    transition: box-shadow .2s, transform .2s;
}
.prj-step-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
    background: linear-gradient(90deg, var(--O), #ffb37d);
    border-radius: 18px 18px 0 0;
}
.prj-step-card:hover { box-shadow: 0 12px 32px rgba(255,138,61,.12); transform: translateY(-4px); }
.prj-step-num {
    width: 48px; height: 48px; border-radius: 14px;
    background: linear-gradient(135deg, var(--O), #ffb37d); color: #fff;
    font-size: 18px; font-weight: 900;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 18px; box-shadow: 0 6px 16px rgba(255,138,61,.3);
}
.prj-step-title { font-size: 15px; font-weight: 800; color: var(--D); margin-bottom: 10px; }
.prj-step-text { font-size: 13px; color: var(--M); line-height: 1.7; margin: 0; }

/* ══════════════════════════════════════
   MISSION (dark section)
══════════════════════════════════════ */
.prj-mission {
    background: linear-gradient(135deg, var(--D), #0f3d6b);
    padding: 80px 0; position: relative; overflow: hidden;
}
.prj-mission::before {
    content: ''; position: absolute; top: -80px; left: -80px;
    width: 400px; height: 400px; border-radius: 50%;
    background: rgba(255,138,61,.06); pointer-events: none;
}
.prj-mission::after {
    content: ''; position: absolute; bottom: -60px; right: -60px;
    width: 300px; height: 300px; border-radius: 50%;
    background: rgba(63,169,245,.05); pointer-events: none;
}
.prj-mission-tag {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,138,61,.18); border: 1px solid rgba(255,138,61,.35);
    color: var(--O); font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    padding: 6px 14px; border-radius: 50px; margin-bottom: 18px;
}
.prj-mission h2 {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 900; color: #fff; line-height: 1.2;
    letter-spacing: -.02em; margin-bottom: 18px;
}
.prj-mission h2 span { color: var(--O); }
.prj-mission-lead { font-size: 15px; color: rgba(255,255,255,.72); line-height: 1.8; margin-bottom: 28px; }
.prj-mission-points { display: flex; flex-direction: column; gap: 14px; }
.prj-mission-point {
    display: flex; align-items: flex-start; gap: 14px;
    background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.09);
    border-radius: 12px; padding: 16px 18px;
}
.prj-mission-icon {
    width: 40px; height: 40px; border-radius: 10px;
    background: rgba(255,138,61,.18); color: var(--O);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; font-size: 16px;
}
.prj-mission-pt-title { font-size: 14px; font-weight: 700; color: #fff; margin-bottom: 3px; }
.prj-mission-pt-text { font-size: 13px; color: rgba(255,255,255,.62); line-height: 1.5; }
.prj-mission-img-wrap { position: relative; }
.prj-mission-img {
    width: 100%; border-radius: 20px; object-fit: cover; height: 440px;
    box-shadow: 0 20px 50px rgba(0,0,0,.35);
}
.prj-mission-img-tag {
    position: absolute; bottom: 24px; left: 24px;
    background: rgba(0,0,0,.45); backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,.2); border-radius: 12px;
    padding: 10px 16px; color: #fff;
}
.prj-mission-img-tag-num { font-size: 20px; font-weight: 900; line-height: 1; color: var(--O); }
.prj-mission-img-tag-lbl { font-size: 11px; opacity: .8; margin-top: 2px; }

/* ══════════════════════════════════════
   AVANTAGES
══════════════════════════════════════ */
.prj-adv { background: #fff; padding: 80px 0; }
.prj-adv-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px,1fr));
    gap: 22px; margin-top: 48px;
}
.prj-adv-card {
    background: #fff8f2; border: 1px solid #fdd0a2;
    border-radius: 18px; padding: 28px 24px;
    position: relative; overflow: hidden;
    transition: box-shadow .2s, transform .2s;
}
.prj-adv-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
    background: linear-gradient(90deg, var(--O), #ffb37d);
    border-radius: 18px 18px 0 0;
}
.prj-adv-card:hover { box-shadow: 0 12px 32px rgba(255,138,61,.1); transform: translateY(-4px); }
.prj-adv-icon {
    width: 50px; height: 50px; border-radius: 14px;
    background: linear-gradient(135deg, var(--O), #ffb37d); color: #fff;
    font-size: 20px; display: flex; align-items: center; justify-content: center;
    margin-bottom: 18px; box-shadow: 0 6px 16px rgba(255,138,61,.3);
}
.prj-adv-title { font-size: 16px; font-weight: 800; color: var(--D); margin-bottom: 10px; }
.prj-adv-text { font-size: 13px; color: var(--M); line-height: 1.7; margin: 0; }

/* ══════════════════════════════════════
   SOCIAL PROOF
══════════════════════════════════════ */
.prj-proof {
    background: linear-gradient(135deg, #fff8f2, #fff3e8);
    padding: 70px 0; border-top: 1px solid #fdd0a2;
}
.prj-proof-faces { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 24px; }
.prj-proof-face {
    width: 54px; height: 54px; border-radius: 50%;
    object-fit: cover; border: 3px solid #fff;
    box-shadow: 0 4px 12px rgba(0,0,0,.1); transition: transform .2s;
}
.prj-proof-face:hover { transform: scale(1.1) translateY(-3px); }
.prj-proof-stats { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
.prj-proof-stat-num { font-size: 1.7rem; font-weight: 900; color: var(--O); line-height: 1; }
.prj-proof-stat-lbl { font-size: 12px; color: var(--M); margin-top: 3px; }
.prj-proof-divider { width: 1px; height: 38px; background: #fdd0a2; }
.prj-testimonial {
    background: #fff; border: 1px solid #fdd0a2; border-radius: 16px;
    padding: 26px 28px; position: relative;
}
.prj-testimonial::before {
    content: '"'; position: absolute; top: 8px; left: 20px;
    font-size: 72px; font-weight: 900; color: #ffe8d1; line-height: 1;
    font-family: Georgia, serif;
}
.prj-testimonial-text { font-size: 14px; color: var(--M); line-height: 1.7; margin: 0 0 14px; padding-top: 20px; }
.prj-testimonial-author { font-size: 13px; font-weight: 700; color: var(--O); }
.prj-stars { color: var(--O); font-size: 13px; margin-bottom: 8px; }

/* ══════════════════════════════════════
   CTA FINALE
══════════════════════════════════════ */
.prj-cta {
    background: linear-gradient(135deg, #7a3400, var(--O));
    padding: 90px 0; text-align: center; position: relative; overflow: hidden;
}
.prj-cta::before {
    content: ''; position: absolute; top: -100px; left: 50%; transform: translateX(-50%);
    width: 600px; height: 600px; border-radius: 50%;
    background: rgba(255,255,255,.06); pointer-events: none;
}
.prj-cta h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 900; color: #fff; line-height: 1.2;
    letter-spacing: -.02em; margin-bottom: 16px;
}
.prj-cta p { font-size: 1.05rem; color: rgba(255,255,255,.85); margin-bottom: 38px; }
.prj-cta-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 16px; }
.btn-prj-cta-white {
    display: inline-flex; align-items: center; gap: 9px;
    background: #fff; color: var(--O); font-size: 15px; font-weight: 700;
    padding: 14px 30px; border-radius: 12px; text-decoration: none;
    box-shadow: 0 4px 18px rgba(0,0,0,.15); transition: all .2s;
}
.btn-prj-cta-white:hover { background: #fff8f2; color: var(--O); transform: translateY(-2px); }
.btn-prj-cta-outline {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,.12); color: #fff; font-size: 15px; font-weight: 600;
    padding: 13px 26px; border-radius: 12px; text-decoration: none;
    border: 1.5px solid rgba(255,255,255,.4); transition: all .2s;
}
.btn-prj-cta-outline:hover { background: rgba(255,255,255,.2); color: #fff; }
.prj-cta-note { font-size: 12px; color: rgba(255,255,255,.5); margin-top: 22px; }

/* ══════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════ */
@media (max-width: 991px) {
    .prj-hero { padding: 50px 0 0; }
    .prj-hero-img { height: 320px; }
    .prj-float { display: none; }
    .prj-stat-item { border-right: none; border-bottom: 1px solid #fdd0a2; }
    .prj-stat-item:last-child { border-bottom: none; }
}
@media (max-width: 767px) {
    .prj-hero h1 { font-size: 1.9rem; }
    .prj-cta h2 { font-size: 1.7rem; }
    .prj-steps-grid { grid-template-columns: 1fr; }
}
</style>
{% endblock %}

{% block body %}
<div class="prj-page">

{# ── Breadcrumb ── #}
<div class="prj-breadcrumb">
    <div class="container">
        <a href="{{ path('app_home') }}">{{ 'submit_pg.bc_home'|trans }}</a>
        <span class="sep">/</span>
        <a href="{{ path('app_how_it_works') }}">{{ 'submit_pg.bc_how_it_works'|trans }}</a>
        <span class="sep">/</span>
        <strong>{{ 'submit_pg.bc_current'|trans }}</strong>
    </div>
</div>

{# ══════════════════════
   HERO
══════════════════════ #}
<section class="prj-hero">
    <div class="container">
        <div class="row align-items-end g-4">
            <div class="col-lg-6 pb-5">
                <div class="prj-hero-eyebrow">
                    <i class="feather-send"></i> {{ 'submit_pg.hero_eyebrow'|trans }}
                </div>
                <h1>{{ 'submit_pg.hero_title'|trans|raw }}</h1>
                <p class="prj-hero-lead">{{ 'submit_pg.hero_lead'|trans }}</p>
                <div class="prj-hero-actions">
                    <a href="{{ path('app_register') }}" class="btn-prj-primary">
                        <i class="feather-send"></i> {{ 'submit_pg.hero_btn_submit'|trans }}
                    </a>
                    <a href="#how-it-works" class="btn-prj-outline">
                        <i class="feather-play-circle"></i> {{ 'submit_pg.hero_btn_how'|trans }}
                    </a>
                </div>
                <div class="prj-hero-trust">
                    <div class="prj-trust-faces">
                        <img src="{{ asset('assets/drilleedo/images/team/team-01.jpg') }}" alt="">
                        <img src="{{ asset('assets/drilleedo/images/team/team-02.jpg') }}" alt="">
                        <img src="{{ asset('assets/drilleedo/images/team/team-03.jpg') }}" alt="">
                        <img src="{{ asset('assets/drilleedo/images/team/team-04.jpg') }}" alt="">
                    </div>
                    <div class="prj-trust-text">{{ 'submit_pg.hero_trust_text'|trans|raw }}</div>
                </div>
            </div>
            <div class="col-lg-6 prj-hero-img-col">
                <img src="{{ asset('assets/drilleedo/images/stock/hero_handyman.jpg') }}"
                     alt="{{ 'submit_pg.hero_img_alt'|trans }}" class="prj-hero-img">
                <div class="prj-float prj-float-1">
                    <div class="prj-float-icon orange"><i class="feather-file-text"></i></div>
                    <div>
                        <div class="prj-float-val">{{ 'submit_pg.float1_val'|trans }}</div>
                        <div class="prj-float-lbl">{{ 'submit_pg.float1_lbl'|trans }}</div>
                    </div>
                </div>
                <div class="prj-float prj-float-2">
                    <div class="prj-float-icon green"><i class="feather-clock"></i></div>
                    <div>
                        <div class="prj-float-val">{{ 'submit_pg.float2_val'|trans }}</div>
                        <div class="prj-float-lbl">{{ 'submit_pg.float2_lbl'|trans }}</div>
                    </div>
                </div>
                <div class="prj-float prj-float-3">
                    <div class="prj-float-icon blue"><i class="feather-percent"></i></div>
                    <div>
                        <div class="prj-float-val">{{ 'submit_pg.float3_val'|trans }}</div>
                        <div class="prj-float-lbl">{{ 'submit_pg.float3_lbl'|trans }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{# ══════════════════════
   STATS BAND
══════════════════════ #}
<section class="prj-stats-band">
    <div class="container">
        <div class="prj-stats-grid">
            <div class="prj-stat-item">
                <div class="prj-stat-val">{{ 'submit_pg.stat1_val'|trans }}</div>
                <div class="prj-stat-lbl">{{ 'submit_pg.stat1_lbl'|trans }}</div>
            </div>
