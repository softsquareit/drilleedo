   {% extends 'base.html.twig' %}

{% block title %}{{ idea.title|default('Renovation Idea') }} | Home Improvement Ideas | Drilleedo{% endblock %}
{% block meta_description %}{{ idea.shortDesc|default('Discover home renovation and decoration ideas on Drilleedo.')|slice(0, 160) }}{% endblock %}
{% block meta_keywords %}{{ idea.title|default('renovation') }}, home improvement ideas, renovation inspiration Canada{% endblock %}
{% block og_title %}{{ idea.title|default('Renovation Idea') }} | Drilleedo{% endblock %}
{% block og_description %}{{ idea.shortDesc|default('Discover home renovation ideas on Drilleedo.')|slice(0, 200) }}{% endblock %}
{% block og_type %}article{% endblock %}
{% block og_image %}
    {% if idea.mainImg %}
        {{ absolute_url(idea.mainImg starts with 'http' ? idea.mainImg : asset('uploads/blog/' ~ idea.mainImg)) }}
    {% endif %}
{% endblock %}

{% block structured_data %}
{{ parent() }}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "{{ idea.title|default('')|e('js') }}",
    "description": "{{ idea.shortDesc|default('')|e('js') }}",
    "datePublished": "{{ idea.createdAt|date('c') }}",
    "publisher": {
        "@type": "Organization",
        "name": "Drilleedo"
    }
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": "{{ url('app_home') }}"},
        {"@type": "ListItem", "position": 2, "name": "Ideas", "item": "{{ url('smartideas') }}"},
        {"@type": "ListItem", "position": 3, "name": "{{ idea.title|default('Idea')|e('js') }}"}
    ]
}
</script>
{% endblock %}

{% block body %}

<div class="rbt-page-banner-wrapper">
    <!-- Banner BG Image -->
        <div class="rbt-banner-image" style="background-image: url('{{ asset('uploads/banners/smartideas.png') }}');"></div>

    <div class="rbt-banner-content">
        <div class="rbt-banner-content-top">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">

                        <!-- Breadcrumb -->
                        <ul class="page-list">
                            <li class="rbt-breadcrumb-item">
                                <a href="{{ path('app_home') }}">Home</a>
                            </li>
                            <li>
                                <div class="icon-right">
                                    <i class="feather-chevron-right"></i>
                                </div>
                            </li>
                            <li class="rbt-breadcrumb-item active">
                                Inspiration & Ideas
                            </li>
                        </ul>

                        <div class="title-wrapper">
                            <h1 class="hero-main-title" style="font-size: var(--h1);">{{ idea.title }}</h1>
                        </div>
                        <span class="hero-tagline-orange">{{ idea.shortDesc|slice(0,120) }}</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="rbt-overlay-page-wrapper">
        <div class="breadcrumb-image-container breadcrumb-style-max-width">

            <div class="breadcrumb-content-top text-center">
                <ul class="meta-list justify-content-center mb--10">
                    <li class="list-item">
                        <div class="author-thumbnail">
                            {% set authorImg = 'assets/images/testimonial/client-06.png' %}
                            {% if idea.author %}
                                {% if idea.author.type == 'Professional' or idea.author.type == 'Company' %}
                                    {% if idea.author.logo %}
                                        {% set authorImg = asset('uploads/logos/' ~ idea.author.logo) %}
                                    {% endif %}
                                {% endif %}
                            {% endif %}
                            <img src="{{ authorImg }}" alt="blog-image">
                        </div>
                        <div class="author-info">
                            {% if idea.author %}
                                <strong>{{ idea.author.companyName ?: idea.author.email }}</strong>
                            {% else %}
                                <strong>Admin</strong>
                            {% endif %}
                            in <strong>{{ idea.category ? idea.category.name : 'General' }}</strong>
                        </div>
                    </li>
                    <li class="list-item">
                        <i class="feather-clock"></i>
                        <span>{{ idea.createdAt|date('d M Y') }}</span>
                    </li>
                </ul>
                <h1 class="title">{{ idea.title }}</h1>
                <p>{{ idea.shortDesc }}</p>
            </div>
        </div>

        <div class="rbt-blog-details-area rbt-section-gapBottom breadcrumb-style-max-width">
            <div class="blog-content-wrapper rbt-article-content-wrapper">
                <div class="content">
                    <div class="post-thumbnail mb--30 position-relative wp-block-image alignwide">
                        <figure>
                            <img src="{{ idea.mainImg ? (idea.mainImg starts with 'http' ? idea.mainImg : asset('uploads/blog/' ~ idea.mainImg)) : asset('assets/images/blog/blog-single-03.png') }}" alt="{{ idea.title }}">
                        </figure>
                    </div>
                    
                    {{ idea.description|raw }}

                    {% if idea.multipleImgs %}
                    <div class="wp-block-gallery columns-3 is-cropped">
                        <ul class="blocks-gallery-grid">
                            {% for img in idea.multipleImgs %}
                            <li class="blocks-gallery-item">
                                <figure>
                                    <img class="radius-4" src="{{ asset('uploads/blog/' ~ img) }}" alt="Blog Gallery Image">
                                </figure>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}

                    <!-- Idea Tags -->
                    {% if idea.category %}
                    <div class="tagcloud">
                        <a href="{{ path('professionals_list') }}?categories[]={{ idea.category.id }}">{{ idea.category.name }}</a>
                    </div>
                    {% endif %}

           


                    <!-- Blog Author  -->
                    <div class="about-author">
                        <div class="media">
                            <div class="thumbnail">
                                {% if idea.author and (idea.author.type == 'Professional' or idea.author.type == 'Company') %}
                                    {% set authorLink = idea.author.type == 'Professional' ? path('professional_details', {id: idea.author.id}) : path('company_details', {id: idea.author.id}) %}
                                    <a href="{{ authorLink }}">
                                        <img src="{{ idea.author.logo ? asset('uploads/logos/' ~ idea.author.logo) : asset('assets/images/testimonial/testimonial-4.jpg') }}" alt="Author Images">
                                    </a>
                                {% else %}
                                    <img src="{{ asset('assets/images/testimonial/testimonial-4.jpg') }}" alt="Author Images">
                                {% endif %}
                            </div>
                            <div class="media-body">
                                <div class="author-info">
                                    <h5 class="title">
                                        {% if idea.author and (idea.author.type == 'Professional' or idea.author.type == 'Company') %}
                                            <a class="hover-flip-item-wrapper" href="{{ authorLink }}">
                                                {{ idea.author.companyName ?: idea.author.email }}
                                            </a>
                                        {% else %}
                                            <span class="hover-flip-item-wrapper">
                                                Admin
                                            </span>
                                        {% endif %}
                                    </h5>
                                    <span class="b3 subtitle">
                                        {% if idea.author %}
                                            {% if idea.author.type == 'Professional' %}
                                                {{ idea.author.category ? idea.author.category.name : 'Professional' }}
                                            {% elseif idea.author.type == 'Company' %}
                                                Company
                                            {% else %}
                                                Administrator
                                            {% endif %}
                                        {% else %}
                                            Administrator
                                        {% endif %}
                                    </span>
                                </div>
                                <div class="content">
                                    <p class="description">
                                        {% if idea.author and idea.author.type in ['Professional', 'Company'] %}
                                            {{ idea.author.about|default('Discover my projects and expertise in home improvement.')|slice(0, 200) }}{{ (idea.author.about|default('')|length > 200) ? '...' : '' }}
                                        {% else %}
                                            Drilleedo Team expert content.
                                        {% endif %}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>


                </div>
                <div class="related-post pt--60">
                    <div class="section-title text-start mb--40">
                        <span class="subtitle bg-primary-opacity">Related Post</span>
                        <h4 class="title">Similar Post</h4>
                    </div>

                    {% for simIdea in similarIdeas %}
                        <!-- Start Single Card  -->
                        <div class="rbt-card card-list variation-02 rbt-hover mt--30">
                            <div class="rbt-card-img">
                                <a href="{{ path('ideas_details', {slug: simIdea.slug}) }}">
                                    <img src="{{ simIdea.mainImg ? (simIdea.mainImg starts with 'http' ? simIdea.mainImg : asset('uploads/blog/' ~ simIdea.mainImg)) : asset('assets/images/blog/blog-card-02.jpg') }}" alt="{{ simIdea.title }}"> </a>
                            </div>
                            <div class="rbt-card-body">
                                <h5 class="rbt-card-title"><a href="{{ path('ideas_details', {slug: simIdea.slug}) }}">{{ simIdea.title }}</a>
                                </h5>
                                <div class="rbt-card-bottom">
                                    <a class="transparent-button" href="{{ path('ideas_details', {slug: simIdea.slug}) }}">Read
                                        Article<i><svg width="17" height="12" xmlns="http://www.w3.org/2000/svg"><g stroke="#27374D" fill="none" fill-rule="evenodd"><path d="M10.614 0l5.629 5.629-5.63 5.629"/><path stroke-linecap="square" d="M.663 5.572h14.594"/></g></svg></i></a>
                                </div>
                            </div>
                        </div>
                        <!-- End Single Card  -->
                    {% endfor %}

                </div>
            </div>
        </div>
    </div>


</div>

{% endblock %}