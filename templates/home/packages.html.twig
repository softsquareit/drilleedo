           <span class="gyb-plan-currency">$</span>
           <span class="gyb-price-val" data-monthly="9.99" data-yearly="99">9.99</span>
           <span class="gyb-plan-period">{{ 'packages.plan_period'|trans }}</span>
        </div>
        <a href="{{ path('app_register') }}" class="gyb-btn-outline">{{ 'packages.starter_cta'|trans }}</a>
        <ul class="gyb-plan-features">
          <li><i class="feather-check"></i> {{ 'packages.starter_f1'|trans }}</li>
          <li><i class="feather-check"></i> {{ 'packages.starter_f2'|trans }}</li>
          <li><i class="feather-check"></i> {{ 'packages.starter_f3'|trans }}</li>
          <li class="off"><i class="feather-x"></i> {{ 'packages.starter_no1'|trans }}</li>
          <li class="off"><i class="feather-x"></i> {{ 'packages.starter_no2'|trans }}</li>
          <li class="off"><i class="feather-x"></i> {{ 'packages.starter_no3'|trans }}</li>
        </ul>
      </div>

      {# Growth (Featured) #}
      <div class="gyb-pricing-card gyb-pricing-card--featured">
        <div class="gyb-popular-badge">{{ 'packages.popular_badge'|trans }}</div>
