{% extends 'base.html.twig' %}

{% block title %}Drilleedo – Canadian Home Improvement Marketplace{% endblock %}

{% block body %}

    <a class="close_side_menu" href="javascript:void(0);"></a>

 <div class="rbt-pricing-area bg-color-white rbt-section-gap">
    <div class="container">

        <!-- Billing Switch -->
        <div class="row g-5 mb--60">
            <div class="col-12">
                <div class="pricing-billing-duration text-center">
                    <ul>
                        <li class="nav-item">
                            <button class="nav-link yearly-plan-btn" type="button">Yearly</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link monthly-plan-btn active" type="button">Monthly</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="row g-5">

            <!-- Starter -->
            <div class="col-xl-4 col-lg-6 col-md-6 col-12">
                <div class="pricing-table style-2">
                    <div class="pricing-header">
                        <h3 class="title color-primary">Starter</h3>
                        <span class="rbt-badge mb--35">Free Trial Included</span>

                        <div class="price-wrap">
                            <div class="yearly-pricing" style="display: none;">
                                <span class="amount color-primary">$99</span>
                                <span class="duration">/year</span>
                            </div>
                            <div class="monthly-pricing" style="display: block;">
                                <span class="amount color-primary">$9.99</span>
                                <span class="duration">/month</span>
                            </div>
                        </div>
                    </div>

                    <div class="pricing-btn">
                        <a class="rbt-btn bg-primary-opacity hover-icon-reverse w-100" href="#">
                            <span class="icon-reverse-wrapper">
                                <span class="btn-text">Get Started</span>
                                <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                            </span>
                        </a>
                    </div>

                    <div class="pricing-body">
                        <ul class="list-item">
                            <li><i class="feather-check"></i> Access to local service listings</li>
                            <li><i class="feather-check"></i> Post renovation projects</li>
                            <li class="off"><i class="feather-x"></i> Priority visibility</li>
                            <li class="off"><i class="feather-x"></i> Dedicated support</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Growth -->
            <div class="col-xl-4 col-lg-6 col-md-6 col-12">
                <div class="pricing-table style-2 active">
                    <div class="pricing-header">
                        <div class="pricing-badge"><span>Most Popular</span></div>
                        <h3 class="title color-secondary">Growth</h3>
                        <span class="rbt-badge mb--35">Best Value</span>

                        <div class="price-wrap">
                            <div class="yearly-pricing" style="display: none;">
                                <span class="amount color-secondary">$199</span>
                                <span class="duration">/year</span>
                            </div>
                            <div class="monthly-pricing" style="display: block;">
                                <span class="amount color-secondary">$19.99</span>
                                <span class="duration">/month</span>
                            </div>
                        </div>
                    </div>

                    <div class="pricing-btn">
                        <a class="rbt-btn bg-secondary-opacity hover-icon-reverse w-100" href="#">
                            <span class="icon-reverse-wrapper">
                                <span class="btn-text">Upgrade Plan</span>
                                <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                            </span>
                        </a>
                    </div>

                    <div class="pricing-body">
                        <ul class="list-item">
                            <li><i class="feather-check"></i> Increased project visibility</li>
                            <li><i class="feather-check"></i> Faster connections</li>
                            <li><i class="feather-check"></i> Featured placement</li>
                            <li><i class="feather-check"></i> Priority support</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Premium -->
            <div class="col-xl-4 col-lg-6 col-md-6 col-12">
                <div class="pricing-table style-2">
                    <div class="pricing-header">
                        <h3 class="title color-pink">Premium</h3>
                        <span class="rbt-badge mb--35">Maximum Exposure</span>

                        <div class="price-wrap">
                            <div class="yearly-pricing" style="display: none;">
                                <span class="amount color-pink">$349</span>
                                <span class="duration">/year</span>
                            </div>
                            <div class="monthly-pricing" style="display: block;">
                                <span class="amount color-pink">$39.99</span>
                                <span class="duration">/month</span>
                            </div>
                        </div>
                    </div>

                    <div class="pricing-btn">
                        <a class="rbt-btn bg-pink-opacity hover-icon-reverse w-100" href="#">
                            <span class="icon-reverse-wrapper">
                                <span class="btn-text">Go Premium</span>
                                <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                            </span>
                        </a>
                    </div>

                    <div class="pricing-body">
                        <ul class="list-item">
                            <li><i class="feather-check"></i> Top placement on Drilleedo</li>
                            <li><i class="feather-check"></i> Advanced project insights</li>
                            <li><i class="feather-check"></i> Premium visibility</li>
                            <li><i class="feather-check"></i> Dedicated assistance</li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<!-- Start Accordion Area -->
<div class="rbt-accordion-area accordion-style-1 bg-color-extra2 rbt-section-gap">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-10 offset-lg-1">
                <div class="rbt-accordion-style accordion">

                    <!-- Section Title -->
                    <div class="section-title text-center mb--60">
                        <span class="subtitle bg-pink-opacity">Frequently Asked Questions</span>
                        <h2 class="title">
                            Questions About <br />Drilleedo?
                        </h2>
                        <p class="description has-medium-font-size mt--20">
                            Everything you need to know about using Drilleedo for your renovation projects.
                        </p>
                    </div>

                    <!-- Accordion -->
                    <div class="rbt-accordion-style rbt-accordion-04 accordion">
                        <div class="accordion" id="accordionDrilleedo">

                            <!-- Q1 -->
                            <div class="accordion-item card">
                                <h2 class="accordion-header card-header" id="headingOne">
                                    <button class="accordion-button" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapseOne"
                                            aria-expanded="true">
                                        What is Drilleedo and how does it work?
                                    </button>
                                </h2>
                                <div id="collapseOne" class="accordion-collapse collapse show"
                                     data-bs-parent="#accordionDrilleedo">
                                    <div class="accordion-body card-body">
                                        Drilleedo is a renovation platform that helps users connect with trusted local
                                        service providers. You can browse services, post projects, and connect easily
                                        in one place.
                                    </div>
                                </div>
                            </div>

                            <!-- Q2 -->
                            <div class="accordion-item card">
                                <h2 class="accordion-header card-header" id="headingTwo">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapseTwo">
                                        Is Drilleedo free to use?
                                    </button>
                                </h2>
                                <div id="collapseTwo" class="accordion-collapse collapse"
                                     data-bs-parent="#accordionDrilleedo">
                                    <div class="accordion-body card-body">
                                        Yes, Drilleedo offers free access to explore services and post projects.
                                        Optional paid plans provide additional visibility and advanced features.
                                    </div>
                                </div>
                            </div>

                            <!-- Q3 -->
                            <div class="accordion-item card">
                                <h2 class="accordion-header card-header" id="headingThree">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapseThree">
                                        How can I contact support?
                                    </button>
                                </h2>
                                <div id="collapseThree" class="accordion-collapse collapse"
                                     data-bs-parent="#accordionDrilleedo">
                                    <div class="accordion-body card-body">
                                        You can reach our support team through the contact page at any time.
                                        Priority assistance is available with selected plans.
                                    </div>
                                </div>
                            </div>

                            <!-- Q4 -->
                            <div class="accordion-item card">
                                <h2 class="accordion-header card-header" id="headingFour">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapseFour">
                                        Can I change or cancel my plan at any time?
                                    </button>
                                </h2>
                                <div id="collapseFour" class="accordion-collapse collapse"
                                     data-bs-parent="#accordionDrilleedo">
                                    <div class="accordion-body card-body">
                                        Yes, you can upgrade, downgrade, or cancel your plan anytime directly
                                        from your account settings.
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <!-- End Accordion -->

                </div>
            </div>
        </div>
    </div>
</div>
<!-- End Accordion Area -->



{% endblock %}
