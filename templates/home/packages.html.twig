        <button class="gyb-billing-btn" id="btn-yearly">Yearly <span class="gyb-save-badge">Save 20%</span></button>
      </div>
    </div>
  </div>
</section>

{# ══════════════════════════════════════════════════════════════════════════
   2. PRICING GRID
══════════════════════════════════════════════════════════════════════════ #}
