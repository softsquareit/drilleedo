           <span class="gyb-plan-currency">$</span>
           <span class="gyb-price-val" data-monthly="19.99" data-yearly="199">19.99</span>
           <span class="gyb-plan-period">{{ 'packages.plan_period'|trans }}</span>
        </div>
        <a href="{{ path('app_register') }}" class="gyb-btn-outline">{{ 'packages.growth_cta'|trans }}</a>
        <ul class="gyb-plan-features">
