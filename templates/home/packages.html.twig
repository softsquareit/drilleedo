           Drilleedo is a renovation platform that connects trusted Canadian service providers with homeowners. As a pro, you build a profile, select your service areas, and receive direct quote requests from clients looking precisely for your expertise. No commission fees on your jobs.
        </div>
      </div>

       {# Q2 #}
       <div class="gyb-accordion-item">
        <h3 class="gyb-accordion-header">
           <button class="gyb-accordion-btn collapsed" type="button" aria-expanded="false">
             Is Drilleedo free to use?
           </button>
        </h3>
        <div class="gyb-accordion-body">
           Yes! Registration and basic profile creation are completely free. You can browse the leads board right away. Our paid "Growth" and "Premium" plans are optional and designed to accelerate your visibility and guarantee exclusive access to leads.
        </div>
      </div>

       {# Q3 #}
       <div class="gyb-accordion-item">
        <h3 class="gyb-accordion-header">
           <button class="gyb-accordion-btn collapsed" type="button" aria-expanded="false">
             Can I change or cancel my plan at any time?
           </button>
        </h3>
        <div class="gyb-accordion-body">
           Absolutely. There are no locking contracts. You can upgrade, downgrade, or cancel your subscription at any point directly from your billing dashboard. Cancellations take effect at the end of your current billing cycle.
        </div>
      </div>

       {# Q4 #}
       <div class="gyb-accordion-item">
        <h3 class="gyb-accordion-header">
           <button class="gyb-accordion-btn collapsed" type="button" aria-expanded="false">
             How do I get the "Verified" badge?
           </button>
        </h3>
        <div class="gyb-accordion-body">
           The Drilleedo Verified Badge requires a manual check by our team. Once you're on a Growth or Premium plan, you will upload proof of identity, liability insurance, and your RBQ license (or local equivalent). Once approved, the badge boosts your conversion rate significantly.
        </div>
      </div>

    </div>
  </div>
</section>

</main>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // Scroll reveal animation
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { 
      if (e.isIntersecting) { 
        e.target.classList.add('visible'); 
        obs.unobserve(e.target); 
      } 
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.gyb-scroll').forEach(el => obs.observe(el));

  // Pricing Toggle Logic
  const btnMonthly = document.getElementById('btn-monthly');
  const btnYearly = document.getElementById('btn-yearly');
  const priceVals = document.querySelectorAll('.gyb-price-val');
  const periods = document.querySelectorAll('.gyb-plan-period');

  if(btnMonthly && btnYearly) {
    btnMonthly.addEventListener('click', () => {
      btnMonthly.classList.add('active');
      btnYearly.classList.remove('active');
      priceVals.forEach(el => el.textContent = el.getAttribute('data-monthly'));
      periods.forEach(el => el.textContent = '/mo');
    });

    btnYearly.addEventListener('click', () => {
      btnYearly.classList.add('active');
      btnMonthly.classList.remove('active');
      priceVals.forEach(el => el.textContent = el.getAttribute('data-yearly'));
      periods.forEach(el => el.textContent = '/yr');
    });
  }

  // Custom Accordion Logic (no Bootstrap required)
  const accBtns = document.querySelectorAll('.gyb-accordion-btn');
  accBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Toggle
      const isCollapsed = btn.classList.contains('collapsed');
      
      // Close all others
      accBtns.forEach(b => {
        b.classList.add('collapsed');
        b.setAttribute('aria-expanded', 'false');
      });
      
      if(isCollapsed) {
        btn.classList.remove('collapsed');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
  
  // Open the first one by default
  if(accBtns.length > 0) {
     accBtns[0].click();
  }
});
</script>
{% endblock %}
