</section>

{# ══════════════════════════════════════════════════════════════════════════
   3. FAQ SECTION
══════════════════════════════════════════════════════════════════════════ #}
<section class="gyb-section gyb-section--blue">
  <div class="container">
    <div class="text-center gyb-scroll">
      <div class="gyb-section-eyebrow">
        <i class="feather-help-circle"></i> {{ 'packages.faq_eyebrow'|trans }}
      </div>
      <h2 class="gyb-section-title">{{ 'packages.faq_title'|trans }} <span>{{ 'packages.faq_title_span'|trans }}</span></h2>
      <p class="gyb-section-sub mx-auto">
        {{ 'packages.faq_sub'|trans }}
      </p>
    </div>

    <div class="gyb-faq-wrapper gyb-scroll">

      {# Q1 #}
      <div class="gyb-accordion-item">
        <h3 class="gyb-accordion-header">
           <button class="gyb-accordion-btn collapsed" type="button" aria-expanded="false">
             {{ 'packages.faq_q1'|trans }}
           </button>
        </h3>
        <div class="gyb-accordion-body">
           {{ 'packages.faq_a1'|trans }}
        </div>
      </div>

       {# Q2 #}
       <div class="gyb-accordion-item">
        <h3 class="gyb-accordion-header">
           <button class="gyb-accordion-btn collapsed" type="button" aria-expanded="false">
             {{ 'packages.faq_q2'|trans }}
           </button>
        </h3>
        <div class="gyb-accordion-body">
           {{ 'packages.faq_a2'|trans|raw }}
        </div>
      </div>

       {# Q3 #}
       <div class="gyb-accordion-item">
        <h3 class="gyb-accordion-header">
           <button class="gyb-accordion-btn collapsed" type="button" aria-expanded="false">
             {{ 'packages.faq_q3'|trans }}
           </button>
        </h3>
        <div class="gyb-accordion-body">
           {{ 'packages.faq_a3'|trans }}
        </div>
      </div>

       {# Q4 #}
       <div class="gyb-accordion-item">
        <h3 class="gyb-accordion-header">
           <button class="gyb-accordion-btn collapsed" type="button" aria-expanded="false">
             {{ 'packages.faq_q4'|trans }}
           </button>
        </h3>
        <div class="gyb-accordion-body">
           {{ 'packages.faq_a4'|trans }}
        </div>
      </div>

    </div>
  </div>
</section>

</main>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // Scroll reveal animation
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.gyb-scroll').forEach(el => obs.observe(el));

  // Pricing Toggle Logic
  const btnMonthly = document.getElementById('btn-monthly');
  const btnYearly = document.getElementById('btn-yearly');
  const priceVals = document.querySelectorAll('.gyb-price-val');
  const periods = document.querySelectorAll('.gyb-plan-period');

  if(btnMonthly && btnYearly) {
    btnMonthly.addEventListener('click', () => {
      btnMonthly.classList.add('active');
      btnYearly.classList.remove('active');
      priceVals.forEach(el => el.textContent = el.getAttribute('data-monthly'));
      periods.forEach(el => el.textContent = '/mo');
    });

    btnYearly.addEventListener('click', () => {
      btnYearly.classList.add('active');
      btnMonthly.classList.remove('active');
      priceVals.forEach(el => el.textContent = el.getAttribute('data-yearly'));
      periods.forEach(el => el.textContent = '/yr');
    });
  }

  // Custom Accordion Logic (no Bootstrap required)
  const accBtns = document.querySelectorAll('.gyb-accordion-btn');
  accBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Toggle
      const isCollapsed = btn.classList.contains('collapsed');

      // Close all others
      accBtns.forEach(b => {
        b.classList.add('collapsed');
        b.setAttribute('aria-expanded', 'false');
      });

      if(isCollapsed) {
        btn.classList.remove('collapsed');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Open the first one by default
  if(accBtns.length > 0) {
     accBtns[0].click();
  }
});
</script>
{% endblock %}
