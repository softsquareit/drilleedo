{% extends 'base.html.twig' %}

{% block title %}{{ 'packages.meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'packages.meta_desc'|trans }}{% endblock %}
{% block og_title %}{{ 'packages.meta_title'|trans }}{% endblock %}
{% block og_description %}{{ 'packages.meta_desc'|trans }}{% endblock %}

{% block body %}
<main id="main-content">
<style>
/* ══ PACKAGES PAGE ════════════════════════════════════════════════════════
   Follows the Drilleedo brand charter: navy #0d2151, blue #00509e, orange #e8501a
   Reuses the .gyb- prefix structural system.
   ═════════════════════════════════════════════════════════════════════════ */

/* ── 1. Hero ── */
.gyb-hero {
  min-height: 480px;
  background: linear-gradient(135deg, #0d2151 0%, #00509e 100%);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.gyb-hero__pattern {
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M20 20.5V18H0v5h5v5H0v5h20v-4.5h5V30H15v-4h5v-5.5zm0 0V30H20v-4.5h5V30H15v-4h5v-5.5zM0 5h5v5H0V5zm15 0h5v5h-5V5z' fill='%23ffffff' fill-opacity='0.03' fill-rule='evenodd'/%3E%3C/svg%3E");
}

.gyb-hero__inner {
  position: relative;
  z-index: 2;
  padding: 80px 0;
  text-align: center;
  max-width: 800px;
  margin: 0 auto;
}

.gyb-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.1);
  color: #fff;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 999px;
  padding: 6px 18px;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 24px;
}

.gyb-eyebrow i { color: #f97316; }

.gyb-hero__title {
  font-size: clamp(36px, 5vw, 64px);
  font-weight: 900;
  color: #fff;
  margin: 0 0 20px;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.gyb-hero__title span {
  color: #e8501a;
  position: relative;
  display: inline-block;
}

.gyb-hero__title span::after {
  content: '';
  position: absolute;
  bottom: 8px;
  left: 0;
  width: 100%;
  height: 8px;
  background: rgba(232,80,26,0.3);
  z-index: -1;
  border-radius: 4px;
}

.gyb-hero__sub {
  font-size: 18px;
  color: rgba(255,255,255,0.85);
  line-height: 1.7;
  margin-bottom: 36px;
}

/* ── 2. Sections ── */
.gyb-section { padding: 100px 0; }
.gyb-section--gray { background: #f8fafc; }
.gyb-section--blue { background: linear-gradient(170deg, #f0f6ff 0%, #e8eeff 100%); }

.gyb-section-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #e8f4fd;
  color: #00509e;
  border: 1px solid rgba(0,80,158,0.15);
  border-radius: 999px;
  padding: 6px 16px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 16px;
}

.gyb-section-title {
  font-size: clamp(28px, 4vw, 42px);
  font-weight: 900;
  color: #0d2151;
  margin: 0 0 16px;
  line-height: 1.15;
  letter-spacing: -0.02em;
}

.gyb-section-title span { color: #e8501a; }

.gyb-section-sub {
  font-size: 17px;
  color: #64748b;
  line-height: 1.75;
  max-width: 650px;
}

/* ── 3. Billing Toggle ── */
.gyb-billing-toggle {
  display: inline-flex;
  background: #f1f5f9;
  padding: 6px;
  border-radius: 999px;
  margin: 40px auto 0;
  border: 1px solid #e2e8f0;
}

.gyb-billing-btn {
  background: transparent;
  color: #64748b;
  border: none;
  padding: 10px 24px;
  border-radius: 999px;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s;
}

.gyb-billing-btn.active {
  background: #fff;
  color: #0d2151;
  box-shadow: 0 4px 12px rgba(13,33,81,0.1);
}

.gyb-save-badge {
  background: #dcfce7;
  color: #16a34a;
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 10px;
  margin-left: 6px;
  vertical-align: middle;
}

/* ── 4. Pricing Grid ── */
.gyb-pricing-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
  margin-top: 60px;
  align-items: center; /* helps pop the middle card out */
}

.gyb-pricing-card {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 24px;
  padding: 40px;
  transition: transform 0.3s, box-shadow 0.3s;
  position: relative;
  display: flex;
  flex-direction: column;
}

.gyb-pricing-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 24px 48px rgba(13,33,81,0.1);
  border-color: #bfdbfe;
}

/* The featured (middle) card */
.gyb-pricing-card--featured {
  background: #0d2151;
  color: #fff;
  border-color: #0d2151;
  transform: scale(1.05); /* slightly bigger */
  box-shadow: 0 24px 48px rgba(13,33,81,0.2);
}

.gyb-pricing-card--featured:hover {
  transform: scale(1.05) translateY(-8px);
}

.gyb-popular-badge {
  position: absolute;
  top: -15px;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #e8501a, #f97316);
  color: #fff;
  padding: 6px 16px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  z-index: 10;
}

/* Plan Title & Price */
.gyb-plan-name { font-size: 20px; font-weight: 800; color: #00509e; margin: 0 0 10px; }
.gyb-pricing-card--featured .gyb-plan-name { color: #60a5fa; }

.gyb-pricing-card--premium .gyb-plan-name { color: #d946ef; }

.gyb-plan-desc { font-size: 14px; color: #64748b; line-height: 1.6; margin: 0 0 24px; }
.gyb-pricing-card--featured .gyb-plan-desc { color: #94a3b8; }

.gyb-plan-price { font-size: 48px; font-weight: 900; color: #0d2151; line-height: 1; display: flex; align-items: baseline; gap: 4px; margin-bottom: 24px; }
.gyb-pricing-card--featured .gyb-plan-price { color: #fff; }

.gyb-plan-currency { font-size: 24px; font-weight: 700; color: #94a3b8; }
.gyb-plan-period { font-size: 15px; font-weight: 600; color: #94a3b8; }

.gyb-pricing-card--featured .gyb-plan-currency,
.gyb-pricing-card--featured .gyb-plan-period { color: #94a3b8; }

/* Plan Button */
.gyb-btn-outline {
  display: block; width: 100%; text-align: center;
  background: transparent; color: #0d2151;
  border: 2px solid #e2e8f0; border-radius: 8px;
  padding: 14px 0; font-size: 16px; font-weight: 800;
  transition: all 0.2s; text-decoration: none; margin-bottom: 30px;
}
.gyb-btn-outline:hover { background: #f8fafc; border-color: #cbd5e1; color: #0d2151; }

.gyb-pricing-card--featured .gyb-btn-outline {
  background: #e8501a; color: #fff; border: none; box-shadow: 0 6px 16px rgba(232,80,26,0.3);
}
.gyb-pricing-card--featured .gyb-btn-outline:hover {
  background: #c43d10; color: #fff; transform: translateY(-2px);
}

/* Plan Features List */
.gyb-plan-features { list-style: none; padding: 0; margin: 0; flex: 1; display: flex; flex-direction: column; gap: 16px; }
.gyb-plan-features li { display: flex; align-items: flex-start; gap: 12px; font-size: 15px; color: #334155; line-height: 1.5; }
.gyb-pricing-card--featured .gyb-plan-features li { color: #f1f5f9; }

.gyb-plan-features li i { font-size: 18px; margin-top: 2px; }
.gyb-plan-features li i.feather-check { color: #16a34a; }
.gyb-plan-features li i.feather-x { color: #cbd5e1; }
.gyb-pricing-card--featured .gyb-plan-features li i.feather-x { color: #475569; }

.gyb-plan-features li.off { opacity: 0.6; }


/* ── 5. FAQ Section ── */
.gyb-faq-wrapper { max-width: 800px; margin: 60px auto 0; }
.gyb-accordion-item {
  background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; margin-bottom: 16px; overflow: hidden;
}
.gyb-accordion-header { margin: 0; padding: 0; }
.gyb-accordion-btn {
  width: 100%; text-align: left; background: none; border: none; padding: 20px 24px;
  font-size: 18px; font-weight: 800; color: #0d2151; display: flex; justify-content: space-between; align-items: center; cursor: pointer;
}
.gyb-accordion-btn:focus { outline: none; background: #f8fafc; }
.gyb-accordion-btn::after {
  content: '\e931'; /* feather-chevron-down */
  font-family: 'feather'; font-size: 20px; transition: transform 0.3s; color: #00509e;
}
.gyb-accordion-btn:not(.collapsed)::after { transform: rotate(180deg); }

.gyb-accordion-body { padding: 0 24px 24px; font-size: 15px; color: #64748b; line-height: 1.7; display: none; }
.gyb-accordion-btn:not(.collapsed) + .gyb-accordion-body { display: block; }

/* ── Responsive ── */
@media (max-width: 1024px) {
  .gyb-pricing-grid { grid-template-columns: repeat(2, 1fr); }
  .gyb-pricing-card--featured { transform: none; }
  .gyb-pricing-card--featured:hover { transform: translateY(-8px); }
}

@media (max-width: 767px) {
  .gyb-pricing-grid { grid-template-columns: 1fr; gap: 40px; }
  .gyb-section { padding: 70px 0; }
}

/* Scroll Animations */
.gyb-scroll { opacity: 0; transform: translateY(24px); transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
.gyb-scroll.visible { opacity: 1; transform: none; }
</style>

{# ══════════════════════════════════════════════════════════════════════════
   1. HERO
══════════════════════════════════════════════════════════════════════════ #}
<section class="gyb-hero" aria-labelledby="hero-title">
  <div class="gyb-hero__pattern"></div>
  <div class="container">
    <div class="gyb-hero__inner gyb-scroll">
      <div class="gyb-eyebrow">
        <i class="feather-award"></i> {{ 'packages.hero_eyebrow'|trans }}
      </div>
      <h1 class="gyb-hero__title" id="hero-title">
        {{ 'packages.hero_title'|trans }} <span>{{ 'packages.hero_title_span'|trans }}</span>
      </h1>
      <p class="gyb-hero__sub">
        {{ 'packages.hero_sub'|trans }}
      </p>

      <div class="gyb-billing-toggle">
        <button class="gyb-billing-btn active" id="btn-monthly">{{ 'packages.billing_monthly'|trans }}</button>
        <button class="gyb-billing-btn" id="btn-yearly">{{ 'packages.billing_yearly'|trans }} <span class="gyb-save-badge">{{ 'packages.billing_save'|trans }}</span></button>
      </div>
    </div>
  </div>
</section>

{# ══════════════════════════════════════════════════════════════════════════
   2. PRICING GRID
══════════════════════════════════════════════════════════════════════════ #}
<section class="gyb-section bg-color-white" style="position: relative; margin-top: -60px; padding-top: 0; background: transparent;">
