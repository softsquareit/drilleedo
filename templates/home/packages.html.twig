          <li><i class="feather-check"></i> {{ 'packages.growth_f2'|trans }}</li>
          <li><i class="feather-check"></i> {{ 'packages.growth_f3'|trans|raw }}</li>
          <li><i class="feather-check"></i> {{ 'packages.growth_f4'|trans|raw }}</li>
          <li><i class="feather-check"></i> {{ 'packages.growth_f5'|trans }}</li>
          <li class="off"><i class="feather-x"></i> {{ 'packages.growth_no1'|trans }}</li>
        </ul>
      </div>

      {# Premium #}
      <div class="gyb-pricing-card gyb-pricing-card--premium">
        <h3 class="gyb-plan-name">{{ 'packages.premium_name'|trans }}</h3>
        <p class="gyb-plan-desc">{{ 'packages.premium_desc'|trans }}</p>
        <div class="gyb-plan-price">
           <span class="gyb-plan-currency">$</span>
           <span class="gyb-price-val" data-monthly="39.99" data-yearly="349">39.99</span>
           <span class="gyb-plan-period">{{ 'packages.plan_period'|trans }}</span>
        </div>
        <a href="{{ path('app_register') }}" class="gyb-btn-outline" style="border-color: #fbcfe8;">{{ 'packages.premium_cta'|trans }}</a>
        <ul class="gyb-plan-features">
          <li><i class="feather-check"></i> {{ 'packages.premium_f1'|trans }}</li>
          <li><i class="feather-check"></i> {{ 'packages.premium_f2'|trans }}</li>
          <li><i class="feather-check"></i> {{ 'packages.premium_f3'|trans }}</li>
          <li><i class="feather-check"></i> {{ 'packages.premium_f4'|trans }}</li>
          <li><i class="feather-check"></i> {{ 'packages.premium_f5'|trans }}</li>
          <li><i class="feather-check"></i> {{ 'packages.premium_f6'|trans }}</li>
        </ul>
