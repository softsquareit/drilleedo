{% extends 'base.html.twig' %}

{% block title %}Contact Drilleedo – Get Help With Your Renovation Project | Canada{% endblock %}
{% block meta_description %}Have a question about your renovation project? Contact Drilleedo's team. We connect Canadian homeowners with trusted professionals. Call, email, or fill out our form.{% endblock %}
{% block meta_keywords %}contact Drilleedo, renovation help Canada, home improvement support{% endblock %}
{% block og_title %}Contact Drilleedo | Get Help With Your Renovation Project{% endblock %}
{% block og_description %}Have a question? Contact our team for help finding the right renovation professional in Canada.{% endblock %}

{% block body %}


    <div class="rbt-conatct-area bg-gradient-11 rbt-section-gap" style="padding: 20px 0;">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="section-title text-center mb--60">
                        <span class="subtitle bg-secondary-opacity">Contact Drilleedo</span>
                        <h2 class="title">
                            Let’s Talk About <br>Your Renovation Project
                        </h2>
                    </div>
                </div>
            </div>

            <div class="row g-5">

                <!-- Phone -->
                <div class="col-lg-4 col-md-6 col-sm-6 col-12 sal-animate" data-sal="slide-up" data-sal-delay="150"
                    data-sal-duration="800">
                    <div class="rbt-address">
                        <div class="icon">
                            <i class="feather-headphones"></i>
                        </div>
                        <div class="inner">
                            <h4 class="title">Call Us</h4>
                            <p><a href="tel:+1444555666777">+1 444 555 666 777</a></p>
                            <p><a href="tel:+12222222333">+1 222 222 222 333</a></p>
                        </div>
                    </div>
                </div>

                <!-- Email -->
                <div class="col-lg-4 col-md-6 col-sm-6 col-12 sal-animate" data-sal="slide-up" data-sal-delay="200"
                    data-sal-duration="800">
                    <div class="rbt-address">
                        <div class="icon">
                            <i class="feather-mail"></i>
                        </div>
                        <div class="inner">
                            <h4 class="title">Email Drilleedo</h4>
                            <p><a href="mailto:support@drilleedo.com">support@drilleedo.com</a></p>
                            <p><a href="mailto:contact@drilleedo.com">contact@drilleedo.com</a></p>
                        </div>
                    </div>
                </div>

                <!-- Location -->
                <div class="col-lg-4 col-md-6 col-sm-6 col-12 sal-animate" data-sal="slide-up" data-sal-delay="250"
                    data-sal-duration="800">
                    <div class="rbt-address">
                        <div class="icon">
                            <i class="feather-map-pin"></i>
                        </div>
                        <div class="inner">
                            <h4 class="title">Head Office</h4>
                            <p>
                                Toronto, Ontario <br>
                                Canada
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Contact Form -->
    <div class="rbt-contact-address">
        <div class="container">
            <div class="row g-5">

                <!-- Image -->
                <div class="col-lg-6">
                    <div class="thumbnail">
                        <img class="w-100 radius-6" src="{{ asset('assets/drilleedo/images/team/man_woman.png') }}"
                            alt="Drilleedo renovation professionals">
                    </div>
                </div>

                <!-- Form -->
                <div class="col-lg-6">
                    <div class="rbt-contact-form contact-form-style-1 max-width-auto">

                        {# Flash messages #}
                        {% for label, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="alert alert-{{ label == 'danger' ? 'danger' : 'success' }} alert-dismissible fade show mb-4" role="alert">
                                    <i class="feather-{{ label == 'danger' ? 'alert-circle' : 'check-circle' }} me-2"></i>{{ message }}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            {% endfor %}
                        {% endfor %}

                        <div class="section-title text-start">
                            <span class="subtitle bg-primary-opacity">
                                DRILLEEDO CONNECTS YOU WITH TRUSTED EXPERTS
                            </span>
                        </div>

                        <h3 class="title">
                            Tell Us About Your Project
                        </h3>

                        <form id="contact-form" method="POST" action="{{ path('app_contact_send') }}"
                            class="rainbow-dynamic-form max-width-auto">

                            <div class="form-group">
                                <input name="contact-name" id="contact-name" type="text" required>
                                <label>Full Name</label>
                                <span class="focus-border"></span>
                            </div>

                            <div class="form-group">
                                <input name="contact-email" type="email" required>
                                <label>Email Address</label>
                                <span class="focus-border"></span>
                            </div>

                            <div class="form-group">
                                <input type="text" id="subject" name="subject">
                                <label>Project Type (optional)</label>
                                <span class="focus-border"></span>
                            </div>

                            <div class="form-group">
                                <textarea name="contact-message" id="contact-message" required></textarea>
                                <label>Your Message</label>
                                <span class="focus-border"></span>
                            </div>

                            <div class="form-submit-group">
                                <button name="submit" type="submit" id="submit"
                                    class="rbt-btn btn-md btn-gradient hover-icon-reverse w-100">
                                    <span class="icon-reverse-wrapper">
                                        <span class="btn-text">Send to Drilleedo</span>
                                        <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                        <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                    </span>
                                </button>
                            </div>

                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>


    <div class="rbt-google-map bg-color-white rbt-section-gapTop">
        <iframe class="w-100"
            src="https://www.google.com/maps/embed?pb=!1m16!1m12!1m3!1d2965.0824050173574!2d-93.63905729999999!3d41.998507000000004!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!2m1!1sWebFilings%2C+University+Boulevard%2C+Ames%2C+IA!5e0!3m2!1sen!2sus!4v1390839289319"
            height="600" style="border:0"></iframe>
    </div>
{% endblock %}
