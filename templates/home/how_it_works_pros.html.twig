  <div class="hw">
    <div class="hiw-faq-inner">

      {# Left: FAQ #}
      <div class="hiw-faq-left hiw-scroll">
        <div class="hiw-faq-pill"><i class="feather-help-circle"></i> {{ 'hitwp.faq_eyebrow'|trans }}</div>
        <h2 class="hiw-faq-title">{{ 'hitwp.faq_title'|trans }}</h2>

        <div class="hiw-faq-item">
          <div class="hiw-faq-q">
