        <span class="hiw-hero-badge"><i class="feather-shield"></i> {{ 'hitwp.badge_verified_leads'|trans }}</span>
        <span class="hiw-hero-badge"><i class="feather-users"></i> {{ 'hitwp.badge_direct_clients'|trans }}</span>
      </div>
    </div>
  </div>
</section>

