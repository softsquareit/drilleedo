          </div>
          <p class="hiw-faq-p">{{ 'hitwp.faq_q1_desc'|trans }}</p>
          <ul class="hiw-faq-checks">
            <li><i class="feather-check-circle"></i> {{ 'hitwp.faq_q1_li1'|trans }}</li>
            <li><i class="feather-check-circle"></i> {{ 'hitwp.faq_q1_li2'|trans }}</li>
