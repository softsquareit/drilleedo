          </div>
          <ul class="hiw-faq-checks">
            <li><i class="feather-check-circle"></i> {{ 'hitwp.faq_q2_li1'|trans }}</li>
            <li><i class="feather-check-circle"></i> {{ 'hitwp.faq_q2_li2'|trans }}</li>
            <li><i class="feather-check-circle"></i> {{ 'hitwp.faq_q2_li3'|trans }}</li>
          </ul>
        </div>

        <div class="hiw-faq-item">
          <div class="hiw-faq-q">
            <span class="hiw-faq-q-icon">$</span>
            {{ 'hitwp.faq_q3'|trans }}
          </div>
          <ul class="hiw-faq-checks">
            <li><i class="feather-check-circle"></i> {{ 'hitwp.faq_q3_li1'|trans }}</li>
            <li><i class="feather-check-circle"></i> {{ 'hitwp.faq_q3_li2'|trans }}</li>
            <li><i class="feather-check-circle"></i> {{ 'hitwp.faq_q3_li3'|trans }}</li>
          </ul>
