        <div class="hiw-faq-item">
          <div class="hiw-faq-q">
            <span class="hiw-faq-q-icon">?</span>
            {{ 'hitwp.faq_q4'|trans }}
          </div>
          <ul class="hiw-faq-checks">
            <li><i class="feather-check-circle"></i> {{ 'hitwp.faq_q4_li1'|trans }}</li>
            <li><i class="feather-check-circle"></i> {{ 'hitwp.faq_q4_li2'|trans }}</li>
