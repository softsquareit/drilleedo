{# ══ 4. FINAL CTA ══════════════════════════════════════════════════════════ #}
<section class="hiw-cta hiw-scroll">
  <div class="hw">
    <h2 class="hiw-cta-title">{{ 'hitwp.cta_title'|trans }}</h2>
    <p class="hiw-cta-sub">{{ 'hitwp.cta_sub'|trans }}</p>
    <div class="hiw-cta-btns">
      <a href="{{ path('app_register_pro') }}" class="hiw-btn-o">
        <i class="feather-user-plus"></i> {{ 'hitwp.cta_btn_create'|trans }}
      </a>
      <a href="{{ path('packages') }}" class="hiw-btn-w">
        <i class="feather-package"></i> {{ 'hitwp.cta_btn_explore'|trans }}
      </a>
    </div>
  </div>
</section>

</main>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
    });
  }, { threshold: 0.08 });
  document.querySelectorAll('.hiw-scroll').forEach(el => obs.observe(el));
});
</script>
{% endblock %}
