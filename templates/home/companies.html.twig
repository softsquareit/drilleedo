{% extends 'base.html.twig' %}

{% block title %}{{ 'public_list.companies_meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ metaDescription }}{% endblock %}
{% block meta_keywords %}renovation companies Canada, construction companies Toronto, home renovation firms, building contractors{% endblock %}
{% block og_title %}{{ 'public_list.companies_meta_title'|trans }}{% endblock %}
{% block og_description %}{{ metaDescription }}{% endblock %}
{% block canonical %}{{ canonicalUrl }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/drilleedo/css/custom/professionals_list.css') }}">
{% endblock %}

{% block body %}
<div class="fp-page">

{# ── HERO BANNER ── #}
<div class="fp-hero">
    <img src="{{ asset('uploads/banners/companies.png') }}"
         alt="{{ 'public_list.hero_companies_img_alt'|trans }}"
         class="fp-hero__img">
    <div class="fp-hero__content">
        <h1 class="fp-hero__title">{{ 'public_list.hero_companies_title'|trans }}</h1>
        <p class="fp-hero__sub">
            {{ 'public_list.hero_companies_sub'|trans }}
        </p>
        <div class="fp-hero__search">
            <form action="{{ path('companies_list') }}" method="GET" class="fp-search-bar">
                <span class="fp-search-bar__icon">
                    <i class="feather-search"></i>
                </span>
                <input type="text"
                       name="keyword"
                       class="fp-search-bar__input"
                       placeholder="{{ 'public_list.search_companies_placeholder'|trans }}"
                       value="{{ app.request.query.get('keyword') }}"
                       aria-label="Search companies">
                <button type="submit" class="fp-search-bar__btn">{{ 'public_list.search_btn'|trans }}</button>
            </form>
        </div>
        <div class="fp-hero__stats">
            <span>✅ {{ totalCompanies }}+ {{ 'public_stats.verified_comps'|trans }}</span>
            <span class="fp-hero__stat-dot">·</span>
            <span>⭐ {{ 'public_stats.local_expertise'|trans }}</span>
            <span class="fp-hero__stat-dot">·</span>
            <span>📋 {{ 'public_stats.free_quotes'|trans }}</span>
        </div>
    </div>
</div>

{# ── CATEGORY PILLS (horizontal scroll) ── #}
<div class="fp-cat-bar" role="navigation" aria-label="Filter by category">
    <div class="fp-cat-bar__inner">
        <button class="fp-cat-pill active" data-category="all" aria-pressed="true">
            <i class="feather-grid"></i>
            {{ 'public_list.all'|trans }}
            <span class="fp-cat-pill__count">{{ totalCompanies }}</span>
        </button>

        {% for cat in allCategories %}
            {% if cat.parent is null %}
            <button class="fp-cat-pill" data-category="{{ cat.id }}" aria-pressed="false">
                {% if cat.icon %}
                    <img src="{{ asset('uploads/categories/' ~ cat.icon) }}"
                         alt="{{ cat.name }} icon"
                         class="fp-cat-pill__icon"
                         loading="lazy"
                         width="20" height="20">
                {% else %}
                    <i class="feather-briefcase"></i>
                {% endif %}
                {{ cat.name }}
                <span class="fp-cat-pill__count">{{ categoryCounts[cat.id] ?? 0 }}</span>
            </button>
            {% endif %}
        {% endfor %}
    </div>
</div>

{# ── MAIN LAYOUT (sidebar + cards) ── #}
<div class="fp-wrap">
    <div class="fp-layout">

        {# ── SIDEBAR ── #}
        <aside class="fp-sidebar" aria-label="Filters">
            <form action="{{ path('companies_list') }}" method="GET" id="filters-form">
                
                <div class="fp-sidebar-card">
                    <div class="fp-sidebar-card__header">
                        <i class="feather-map-pin"></i>
                        {{ 'public_list.city_region'|trans }}
                    </div>
                    <div class="fp-sidebar-card__body">
                        <ul class="fp-city-list" role="list">
                            {% for city in allCities %}
                            <li class="fp-city-row {{ city in activeFilters.cities ? 'active' : '' }}">
                                <label for="city-{{ loop.index }}">
                                    <input id="city-{{ loop.index }}" type="checkbox" name="cities[]" value="{{ city }}"
                                           {{ city in activeFilters.cities ? 'checked' : '' }}
                                           onchange="this.form.submit()">
                                    {{ city }}
                                </label>
                                <span class="fp-city-count">{{ cityCounts[city] ?? 0 }}</span>
                            </li>
                            {% else %}
                            <li style="font-size:13px;color:#94a3b8;padding:8px 0;">{{ 'public_list.no_city'|trans }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>

                <button type="submit" class="fp-btn-apply">{{ 'public_list.apply_filters'|trans }}</button>
                {% if activeFilters.cities is not empty or activeFilters.categories is not empty %}
                    <a href="{{ path('companies_list') }}" class="fp-btn-clear">{{ 'public_list.clear_filters'|trans }}</a>
                {% endif %}
            </form>

            <div class="mt-4">
                <a href="{{ path('app_register') }}" class="fp-btn-solid w-100" style="text-align:center; display:block;">
                    <i class="feather-plus me-1"></i> {{ 'public_list.companies_btn_post'|trans }}
                </a>
            </div>
        </aside>

        {# ── MAIN CONTENT ── #}
        <div class="fp-content">
            <div class="fp-meta-row">
                <p class="fp-meta-count">
                    <span id="filtered-count">{{ totalCompanies }}</span> {{ 'public_list.companies_found'|trans }}
                </p>
            </div>

            <div class="fp-pro-grid" id="company-grid">
                {% for company in companies %}
                    {% include 'partials/_card_company.html.twig' with {'pro': company} %}
                {% else %}
                    <div class="fp-empty">
                        <div class="fp-empty__icon">🔍</div>
                        <h4>{{ 'public_list.companies_empty_title'|trans }}</h4>
                        <p>{{ 'public_list.companies_empty_sub'|trans }}</p>
                        <a href="{{ path('companies_list') }}" class="fp-btn-browse">{{ 'public_list.companies_browse_all'|trans }}</a>
                    </div>
                {% endfor %}
            </div>

            {% if totalPages > 1 %}
            <nav class="fp-pagination" aria-label="Page navigation">
                {% if currentPage > 1 %}
                <a href="{{ path('companies_list', app.request.query.all|merge({'page': currentPage - 1})) }}">
                    <i class="feather-chevron-left"></i>
                </a>
                {% endif %}
                
                {% for i in 1..totalPages %}
                {% if i == currentPage %}
                    <span class="active">{{ i }}</span>
                {% else %}
                    <a href="{{ path('companies_list', app.request.query.all|merge({'page': i})) }}">{{ i }}</a>
                {% endif %}
                {% endfor %}
                
                {% if currentPage < totalPages %}
                <a href="{{ path('companies_list', app.request.query.all|merge({'page': currentPage + 1})) }}">
                    <i class="feather-chevron-right"></i>
                </a>
                {% endif %}
            </nav>
            {% endif %}
        </div>
    </div>
</div>

</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const pills = document.querySelectorAll('.fp-cat-pill');
    const cards = document.querySelectorAll('.pro-card-item');
    const count = document.getElementById('filtered-count');

    pills.forEach(pill => {
        pill.addEventListener('click', () => {
            const cat = pill.dataset.category;
            pills.forEach(p => { p.classList.remove('active'); p.setAttribute('aria-pressed', 'false'); });
            pill.classList.add('active');
            pill.setAttribute('aria-pressed', 'true');

            let visible = 0;
            cards.forEach(card => {
                const show = cat === 'all' || card.dataset.category === cat;
                if (show) {
                    card.style.display = 'flex';
                    void card.offsetWidth;
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                    visible++;
                } else {
                    card.style.opacity = '0';
                    card.style.transform = 'translateY(12px)';
                    setTimeout(() => { if (card.style.opacity === '0') card.style.display = 'none'; }, 280);
                }
            });
            if (count) {
                count.style.transform = 'scale(1.15)';
                setTimeout(() => { count.textContent = visible; count.style.transform = 'scale(1)'; }, 140);
            }
        });
    });
});
</script>
{% endblock %}
