{% extends 'base.html.twig' %}

{% block title %}Top Renovation Companies in Canada | Drilleedo{% endblock %}
{% block meta_description %}Discover verified construction and renovation companies near you. Filter by specialty and location. Compare profiles and get quotes from leading Canadian companies on Drilleedo.{% endblock %}
{% block meta_keywords %}renovation companies Canada, construction companies Toronto, home renovation firms, building contractors{% endblock %}
{% block og_title %}Top Renovation Companies in Canada | Drilleedo{% endblock %}
{% block og_description %}Discover verified construction and renovation companies. Filter by specialty and location.{% endblock %}

{% block body %}
  <a class="close_side_menu" href="javascript:void(0);"></a>

    <div class="rbt-page-banner-wrapper">
        <!-- Start Banner BG Image  -->
        <div class="rbt-banner-image" style="background-image: url('{{ asset('uploads/banners/companies.png') }}');"></div>
        <!-- End Banner BG Image  -->
        <div class="rbt-banner-content">

            <!-- Start Banner Content Top  -->
            <div class="rbt-banner-content-top">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <!-- Start Breadcrumb Area  -->
                            <ul class="page-list">
                                <li class="rbt-breadcrumb-item"><a href="{{ path('app_home') }}">Home</a></li>
                                <li>
                                    <div class="icon-right"><i class="feather-chevron-right"></i></div>
                                </li>
                                <li class="rbt-breadcrumb-item active">All Companies</li>
                            </ul>
                            <!-- End Breadcrumb Area  -->

                            <div class="title-wrapper">
                                <h1 class="hero-main-title" style="font-size: var(--h1);">Companies Near You</h1>
                                <a href="#" class="rbt-badge-2">
                                    {{ companies|length }} {{ companies|length == 1 ? 'Result' : 'Results' }}
                                </a>
                            </div>


<span class="hero-tagline-orange">Professional companies for every project.</span>
<p class="description"><b>
 Discover verified companies offering renovation, construction, and home improvement services.
</b></p>
<div class="hero-service-icons">
<!-- Using simple SVGs for icons as placeholders for now -->


<div class="about-buttons-row">
<a href="{{ path('app_register') }}" class="about-pill-btn btn-solid-blue"><i class="feather-plus me-1"></i> Post a Project</a>
</div>

</div>

                        </div>
                    </div>
                </div>
            </div>
            <!-- End Banner Content Top  -->
        </div>
    </div>

    <div class="rbt-counterup-area rbt-section-overlayping-top rbt-section-gapBottom">
        <div class="container">
            <div class="row row--30 gy-5">
                <div class="col-lg-4 col-xl-3 order-2 order-lg-1">
                    <aside class="rbt-sidebar-widget-wrapper rbt-gradient-border">
                        <form action="{{ path('companies_list') }}" method="GET">

                        <!-- Start Category Filter -->
                        <div class="rbt-single-widget rbt-widget-categories has-show-more">
                            <fieldset style="border: none; padding: 0; margin: 0;">
                            <legend class="sr-only">Filter companies by service category</legend>
                            <div class="inner">
                                <h4 class="rbt-widget-title" aria-hidden="true">Service Categories</h4>
                                <ul class="rbt-sidebar-list-wrapper categories-list-check has-show-more-inner-content" role="list">
                                    {% for cat in allCategories %}
                                    <li class="rbt-check-group" role="listitem">
                                        <input id="co-cat-{{ cat.id }}" type="checkbox" name="categories[]" value="{{ cat.id }}"
                                            {% if cat.id in activeFilters.categories %}checked{% endif %}
                                            onchange="this.form.submit()"
                                            aria-label="{{ cat.name }} ({{ categoryCounts[cat.id] ?? 0 }} companies)">
                                        <label for="co-cat-{{ cat.id }}">{{ cat.name }} <span class="rbt-lable count" aria-hidden="true">{{ categoryCounts[cat.id] ?? 0 }}</span></label>
                                    </li>
                                    {% endfor %}
                                </ul>
                            </div>
                            <div class="rbt-show-more-btn" role="button" aria-expanded="false" aria-label="Show more service categories">Show More</div>
                            </fieldset>
                        </div>
                        <!-- End Category Filter -->

                        <!-- Start Location Filter -->
                        <div class="rbt-single-widget rbt-widget-categories">
                            <div class="inner">
                                <h4 class="rbt-widget-title">Location</h4>
                                <ul class="rbt-sidebar-list-wrapper categories-list-check">
                                    {% for city in allCities %}
                                    <li class="rbt-check-group">
                                        <input id="city-{{ loop.index }}" type="checkbox" name="cities[]" value="{{ city }}"
                                            {% if city in activeFilters.cities %}checked{% endif %}
                                            onchange="this.form.submit()">
                                        <label for="city-{{ loop.index }}">{{ city }} <span class="rbt-lable count">{{ cityCounts[city] ?? 0 }}</span></label>
                                    </li>
                                    {% else %}
                                    <li>No cities available</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                        <!-- End Location Filter -->

                        <!-- Start Tags -->
                        <div class="rbt-single-widget rbt-widget-tag">
                            <div class="inner">
                                <div class="mt-4">
                                    <button type="submit" class="rbt-btn btn-gradient btn-sm w-100">Apply Filters</button>
                                    {% if activeFilters.categories is not empty or activeFilters.cities is not empty %}
                                        <a href="{{ path('companies_list') }}" class="rbt-btn btn-border btn-sm w-100 mt-2 text-center">Clear Filters</a>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        <!-- End Tags -->

                        </form>
                    </aside>
                </div>

                <div class="col-lg-8 col-xl-9 order-1 order-lg-2">
                    <!-- Trust Bar -->
                    <div class="row g-5">

                        <!-- Start Single Company Loop -->
                        {% for company in companies %}
                        <div class="col-xl-6 col-lg-6 col-md-6 col-12">
                            {% include 'partials/_card_professional.html.twig' with {'pro': company} %}
                        </div>
                        {% else %}
                        <div class="col-12 text-center py-5">
                            <div class="d-flex flex-column align-items-center" style="gap:20px; max-width:520px; margin:0 auto;">
                                <div style="width:72px;height:72px;background:rgba(20,86,140,0.08);border-radius:50%;display:flex;align-items:center;justify-content:center;">
                                    <i class="feather-search" style="font-size:2rem;color:var(--color-primary);"></i>
                                </div>
                                <h4 style="font-weight:700;color:#1e293b;">No companies found</h4>
                                <p class="text-muted" style="font-size:1rem;line-height:1.6;">
                                    Try adjusting your filters, or browse all companies across Canada.
                                </p>
                                <a href="{{ path('companies_list') }}" class="rbt-btn btn-gradient">Browse All Companies</a>
                            </div>
                        </div>
                        {% endfor %}
                        <!-- End Single Company Loop -->

            </div>
                    </div>
                    
                    {% if totalPages > 1 %}
                    <div class="row">
                        <div class="col-lg-12 mt--60">
                            <nav>
                                <ul class="rbt-pagination">
                                    {% if currentPage > 1 %}
                                    <li><a href="{{ path('companies_list', app.request.query.all|merge({'page': currentPage - 1})) }}" aria-label="Previous"><i class="feather-chevron-left"></i></a></li>
                                    {% endif %}
                                    
                                    {% for i in 1..totalPages %}
                                    <li class="{% if i == currentPage %}active{% endif %}">
                                        <a href="{{ path('companies_list', app.request.query.all|merge({'page': i})) }}">{{ i }}</a>
                                    </li>
                                    {% endfor %}
                                    
                                    {% if currentPage < totalPages %}
                                    <li><a href="{{ path('companies_list', app.request.query.all|merge({'page': currentPage + 1})) }}" aria-label="Next"><i class="feather-chevron-right"></i></a></li>
                                    {% endif %}
                                </ul>
                            </nav>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="rbt-separator-mid">
        <div class="container">
            <hr class="rbt-separator m-0">
        </div>
    </div>
    <!-- Start Footer aera -->

{% endblock %}
