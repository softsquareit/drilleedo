  line-height: 1.15;
}

.gyb-why__title span { color: #FF8A3D; }

.gyb-why__sub {
  font-size: 17px;
  color: #64748b;
  max-width: 600px;
  margin: 0 auto;
  line-height: 1.75;
}

/* ── Spotlight feature cards (3 large cards) ── */
.gyb-spotlight-grid {
  display: grid;
  grid-template-columns: 1fr 1.4fr 1fr;
  gap: 20px;
  margin-bottom: 60px;
  align-items: start;
}

.gyb-spotlight-card {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  padding: 36px 28px;
  position: relative;
  overflow: hidden;
  transition: transform 0.28s, box-shadow 0.28s;
}

.gyb-spotlight-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 60px rgba(12,24,37,0.12);
}

/* Center card is featured */
.gyb-spotlight-card--featured {
  border-color: #00497F;
  box-shadow: 0 12px 40px rgba(0,73,127,0.15);
  background: linear-gradient(160deg, #0C1825 0%, #003660 100%);
}

.gyb-spotlight-card--featured:hover {
  box-shadow: 0 24px 64px rgba(12,24,37,0.28);
}

/* Background pattern on featured */
.gyb-spotlight-card--featured::after {
  content: '';
  position: absolute;
  bottom: -60px;
  right: -60px;
  width: 200px;
  height: 200px;
  border-radius: 50%;
  background: rgba(255,138,61,0.12);
}

.gyb-spotlight-badge {
  display: inline-block;
  background: #FF8A3D;
  color: #fff;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 4px 12px;
  border-radius: 999px;
  margin-bottom: 22px;
}

.gyb-spotlight-ico {
  width: 68px;
  height: 68px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  margin-bottom: 20px;
}

.gyb-spotlight-ico--navy  { background: linear-gradient(135deg, #0C1825, #003660); color: #fff; }
.gyb-spotlight-ico--orng  { background: rgba(255,255,255,0.12); color: #FF8A3D; border: 1px solid rgba(255,255,255,0.15); }
.gyb-spotlight-ico--green { background: linear-gradient(135deg, #16a34a, #22c55e); color: #fff; }

.gyb-spotlight-title {
  font-size: 20px;
  font-weight: 900;
  color: #0C1825;
  margin: 0 0 12px;
  line-height: 1.2;
}

.gyb-spotlight-card--featured .gyb-spotlight-title { color: #fff; }

.gyb-spotlight-desc {
  font-size: 14px;
  color: #64748b;
  line-height: 1.75;
  margin: 0 0 24px;
}

.gyb-spotlight-card--featured .gyb-spotlight-desc { color: rgba(255,255,255,0.72); }

.gyb-spotlight-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.gyb-spotlight-list li {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  font-weight: 600;
  color: #334155;
}

.gyb-spotlight-card--featured .gyb-spotlight-list li { color: rgba(255,255,255,0.85); }

.gyb-spotlight-list li i {
  color: #16a34a;
  font-size: 14px;
  flex-shrink: 0;
}

.gyb-spotlight-card--featured .gyb-spotlight-list li i { color: #FF8A3D; }

/* ── Drilleedo vs others comparison strip ── */
.gyb-compare {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  padding: 48px 40px;
  margin-bottom: 60px;
  box-shadow: 0 4px 24px rgba(12,24,37,0.06);
}

.gyb-compare__header {
  display: flex;
