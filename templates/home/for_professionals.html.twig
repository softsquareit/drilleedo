<script>
// FAQ accordion
function gybFaq(btn) {
  const body = btn.nextElementSibling;
  const isOpen = body.classList.contains('open');
  document.querySelectorAll('.gyb-faq-body.open').forEach(b => b.classList.remove('open'));
  document.querySelectorAll('.gyb-faq-btn.open').forEach(b => { b.classList.remove('open'); b.setAttribute('aria-expanded','false'); });
  if (!isOpen) { body.classList.add('open'); btn.classList.add('open'); btn.setAttribute('aria-expanded','true'); }
}

// Scroll reveal
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.07 });
document.querySelectorAll('.gyb-scroll').forEach(el => obs.observe(el));
</script>
