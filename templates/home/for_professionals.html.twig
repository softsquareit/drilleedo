.gyb-check-yes { color: #16a34a; font-size: 18px; font-weight: 900; }
.gyb-check-no  { color: #cbd5e1; font-size: 18px; }

/* ── Quote callout block ── */
.gyb-callout {
  background: linear-gradient(120deg, #FF8A3D 0%, #f06030 100%);
  border-radius: 20px;
  padding: 48px 40px;
  display: flex;
  align-items: center;
  gap: 40px;
  flex-wrap: wrap;
  position: relative;
  overflow: hidden;
  margin-bottom: 60px;
}

.gyb-callout::before {
  content: '"';
  position: absolute;
  top: -10px;
  left: 30px;
  font-size: 200px;
  font-weight: 900;
  color: rgba(255,255,255,0.07);
  line-height: 1;
  pointer-events: none;
  font-family: 'Instrument Sans', system-ui, sans-serif;
}

.gyb-callout__text {
  flex: 1;
  min-width: 260px;
}

.gyb-callout__quote {
  font-size: clamp(18px, 2.5vw, 24px);
  font-weight: 800;
  color: #fff;
  line-height: 1.45;
  margin: 0 0 16px;
  font-style: italic;
}

.gyb-callout__author {
  display: flex;
  align-items: center;
  gap: 12px;
}

.gyb-callout__ava {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  border: 2px solid rgba(255,255,255,0.4);
  color: #fff;
  font-size: 16px;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gyb-callout__name { font-size: 15px; font-weight: 800; color: #fff; }
.gyb-callout__role { font-size: 13px; color: rgba(255,255,255,0.75); }

.gyb-callout__stat {
  text-align: center;
  min-width: 140px;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 16px;
  padding: 24px 20px;
}

.gyb-callout__stat-num {
  font-size: 40px;
  font-weight: 900;
  color: #fff;
  line-height: 1;
  margin-bottom: 6px;
}

.gyb-callout__stat-lbl {
  font-size: 12px;
  font-weight: 700;
  color: rgba(255,255,255,0.75);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

/* ── Responsive ── */
@media (max-width: 1024px) {
  .gyb-spotlight-grid { grid-template-columns: 1fr 1fr; }
