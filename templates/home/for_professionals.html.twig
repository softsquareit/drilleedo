}
.gyb-compare-table th.gyb-th-other { color: #94a3b8; }

.gyb-compare-table td {
  padding: 14px 20px;
  font-size: 14px;
  color: #334155;
  border-bottom: 1px solid #f8fafc;
  text-align: center;
  vertical-align: middle;
}

.gyb-compare-table td.gyb-td-feature { text-align: left; font-weight: 600; color: #0C1825; }
.gyb-compare-table td.gyb-td-drilleedo { background: #f0f6ff; }
.gyb-compare-table tr:last-child td { border-bottom: none; }
