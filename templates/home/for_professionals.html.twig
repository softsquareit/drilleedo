/* ── Section header ── */
.gyb-why__header { text-align: center; margin-bottom: 64px; }

.gyb-why__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: linear-gradient(90deg, #0C1825, #00497F);
  color: #fff;
  border-radius: 999px;
  padding: 7px 20px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 18px;
  box-shadow: 0 4px 18px rgba(12,24,37,0.2);
}

.gyb-why__title {
  font-size: clamp(28px, 4vw, 42px);
  font-weight: 900;
  color: #0C1825;
  margin: 0 0 16px;
