  border-radius: 999px;
  padding: 4px 14px;
}

.gyb-compare__title {
  font-size: 22px;
  font-weight: 900;
  color: #0C1825;
  margin: 0;
}

.gyb-compare-table { width: 100%; border-collapse: collapse; }

.gyb-compare-table th {
  padding: 12px 20px;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  text-align: center;
