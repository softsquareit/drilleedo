            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{# ══════════════════════════════════════════════════════════════════════════
   0b. INTRO — Je suis un professionnel
══════════════════════════════════════════════════════════════════════════ #}
<style>
/* ── Intro section ── */
.gyb-intro {
    background: var(--W); padding: 96px 0 80px;
    position: relative; overflow: hidden;
}
.gyb-intro::before {
    content: ''; position: absolute; top: -120px; right: -120px;
