{% extends 'base.html.twig' %}

{% block title %}Grow Your Business with Drilleedo – List Your Renovation Services in Canada{% endblock %}
{% block meta_description %}Join Canada's leading home renovation marketplace. List your professional services on Drilleedo and connect with thousands of homeowners looking for trusted contractors. Free to get started.{% endblock %}

{% block body %}
<!-- Phosphor Icons -->
<script src="https://unpkg.com/@phosphor-icons/web"></script>

<main id="main-content" class="gyb-page">
<style>
/* ══ FOR PROFESSIONALS — Drilleedo Brand System
   Helper Blue #00497F · Sky #3FA9F5 · Orange #FF8A3D · Cream #FFFBEB · Dark #0C1825
   ══════════════════════════════════════════════════════════════════════════ */
:root {
  --B: #00497F;
  --S: #3FA9F5;
  --O: #FF8A3D;
  --C: #FFFBEB;
  --D: #0C1825;
  --M: #4A6073;
  --L: #E4EBF2;
  --W: #FFFFFF;
  --F: 'Instrument Sans', system-ui, sans-serif;
  --r:  14px;
  --rl: 22px;
  --rx: 28px;
  --sh:    0 4px 24px rgba(0,73,127,.12);
  --sh-md: 0 8px 40px rgba(0,73,127,.15);
  --sh-lg: 0 16px 60px rgba(0,73,127,.18);
  --t: all .22s ease;
}
.gyb-page { font-family: var(--F); color: var(--D); line-height: 1.6; }
.gyb-page * { box-sizing: border-box; }
.gyb-page h1,.gyb-page h2,.gyb-page h3,.gyb-page h4 {
  font-family: var(--F); font-weight: 900; letter-spacing: -.8px; line-height: 1.13;
}

/* ── 1. Hero ── */
.gyb-hero {
  min-height: 360px;
  background: var(--B);
  position: relative; overflow: hidden; display: flex; align-items: center;
}
.gyb-hero__pattern { position: absolute; inset: 0; }
.gyb-hero::before {
  content: ''; position: absolute; right: -100px; top: -100px;
  width: 450px; height: 450px; border-radius: 50%;
  background: radial-gradient(circle, rgba(255,138,61,.13) 0%, transparent 70%);
  pointer-events: none;
}
.gyb-hero::after {
  content: ''; position: absolute; bottom: -80px; left: -60px;
  width: 320px; height: 320px; border-radius: 50%;
  background: radial-gradient(circle, rgba(63,169,245,.07) 0%, transparent 70%);
  pointer-events: none;
}
.gyb-hero__inner { position: relative; z-index: 2; padding: 70px 0; }

.gyb-eyebrow {
  display: inline-flex; align-items: center; gap: 7px;
  background: rgba(255,255,255,.1); color: rgba(255,255,255,.9);
  border: 1px solid rgba(255,255,255,.2); border-radius: 50px;
  padding: 7px 18px; font-size: 12px; font-weight: 700;
  letter-spacing: .6px; text-transform: uppercase; margin-bottom: 18px;
}

.gyb-hero__title {
  font-size: clamp(30px,5vw,54px); font-weight: 900; color: #fff;
  margin: 0 0 16px; line-height: 1.08; letter-spacing: -2px;
}
.gyb-hero__title span { color: var(--S); }

.gyb-hero__sub {
  font-size: 17px; color: rgba(255,255,255,.78);
  max-width: 580px; line-height: 1.7; margin-bottom: 28px;
}
.gyb-hero__actions { display: flex; gap: 12px; flex-wrap: wrap; }

.gyb-btn-orange {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--O); color: #fff; font-family: var(--F);
  font-size: 15px; font-weight: 800; padding: 14px 30px;
  border-radius: 50px; text-decoration: none; border: none; cursor: pointer;
  box-shadow: 0 4px 20px rgba(255,138,61,.4); transition: var(--t);
}
.gyb-btn-orange:hover { background: #e87830; transform: translateY(-2px); color: #fff; box-shadow: 0 8px 28px rgba(255,138,61,.45); }

.gyb-btn-white {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,.12); color: #fff; font-family: var(--F);
  font-size: 15px; font-weight: 700; padding: 13px 26px;
  border-radius: 50px; text-decoration: none; border: 2px solid rgba(255,255,255,.3);
  transition: var(--t);
}
.gyb-btn-white:hover { background: rgba(255,255,255,.2); border-color: rgba(255,255,255,.6); color: #fff; }

.gyb-hero__trust {
  display: flex; gap: 20px; flex-wrap: wrap; margin-top: 24px;
  font-size: 13px; color: rgba(255,255,255,.65); font-weight: 600;
}
.gyb-hero__trust span { display: flex; align-items: center; gap: 6px; }
.gyb-hero__trust i { color: var(--S); }

.gyb-hero__card {
  background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.15);
  border-radius: var(--rx); padding: 32px 28px; backdrop-filter: blur(12px);
}
.gyb-hero__card-title { font-size: 18px; font-weight: 800; color: #fff; margin-bottom: 20px; }

.gyb-prof-stat {
  display: flex; align-items: center; gap: 16px;
  padding: 14px; background: rgba(255,255,255,.07);
  border-radius: var(--rl); margin-bottom: 10px;
}
.gyb-prof-stat__ico {
  width: 44px; height: 44px; border-radius: var(--r);
  background: rgba(255,255,255,.15);
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; flex-shrink: 0;
}
.gyb-prof-stat__num { font-size: 22px; font-weight: 900; color: #fff; line-height: 1; }
.gyb-prof-stat__lbl { font-size: 12px; color: rgba(255,255,255,.6); margin-top: 2px; }

/* ── 2. Stats strip ── */
.gyb-strip {
  background: var(--W);
  border-top: 3px solid var(--S);
  border-bottom: 1px solid var(--L);
  padding: 24px 0;
}
.gyb-strip__grid {
  display: grid; grid-template-columns: repeat(4,1fr);
  max-width: 1200px; margin: 0 auto; padding: 0 24px;
}
.gyb-strip__cell {
  display: flex; align-items: center; gap: 12px;
  padding: 0 40px; border-right: 1px solid var(--L);
}
.gyb-strip__cell:last-child { border-right: none; }
.gyb-strip__ico {
  color: var(--S); font-size: 22px;
  background: rgba(63,169,245,.1); padding: 8px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  width: 44px; height: 44px; flex-shrink: 0;
}
.gyb-strip__num { font-size: 22px; font-weight: 900; color: var(--B); letter-spacing: -.5px; line-height: 1; }
.gyb-strip__lbl { font-size: 13px; font-weight: 500; color: var(--M); margin-top: 2px; }

/* ── 3. Common section utilities ── */
.gyb-section { padding: 96px 0; }
.gyb-section--gray { background: var(--C); }
.gyb-section--blue { background: #f0f6ff; }

.gyb-section-eyebrow {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 18px; border-radius: 50px;
  font-size: 12px; font-weight: 700; letter-spacing: .6px; text-transform: uppercase;
  margin-bottom: 20px;
  background: rgba(63,169,245,.10); color: var(--S); border: 1px solid rgba(63,169,245,.2);
}
.gyb-section-title {
  font-size: clamp(28px,3.5vw,40px); font-weight: 900; color: var(--D);
  margin: 0 0 16px; letter-spacing: -1.5px; line-height: 1.13;
}
.gyb-section-title span { color: var(--B); }
.gyb-section-sub {
  font-size: 17px; color: var(--M); line-height: 1.75; max-width: 560px;
}

/* ── 4. How to Join — Steps ── */
.gyb-steps {
  display: grid; grid-template-columns: repeat(4,1fr);
  gap: 16px; margin-top: 52px; position: relative;
}
.gyb-steps::before {
  content: ''; position: absolute;
  top: 50px; left: calc(12.5% + 26px); right: calc(12.5% + 26px);
  height: 2px;
  background: linear-gradient(90deg, var(--B), var(--S));
}
.gyb-step {
  background: var(--W); border: 1.5px solid var(--L);
  border-radius: var(--rx); padding: 28px 20px 24px;
  text-align: center; position: relative; z-index: 1;
  transition: var(--t); box-shadow: 0 2px 12px rgba(0,73,127,.05);
}
.gyb-step:hover {
  border-color: var(--S); transform: translateY(-5px);
  box-shadow: 0 10px 36px rgba(63,169,245,.14); border-bottom: 3px solid var(--S);
}
.gyb-step__num {
  position: absolute; top: -16px; left: 50%; transform: translateX(-50%);
  width: 32px; height: 32px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; font-weight: 900; color: #fff;
  background: var(--S); border: 3px solid var(--W);
  box-shadow: 0 4px 14px rgba(63,169,245,.45);
}
.gyb-step__ico {
  width: 60px; height: 60px; border-radius: 16px;
  background: var(--S);
  display: flex; align-items: center; justify-content: center;
  font-size: 24px; color: #fff; margin: 0 auto 16px;
  transition: transform .22s;
}
.gyb-step:hover .gyb-step__ico { transform: scale(1.08) rotate(-4deg); }
.gyb-step__chip {
  font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
  color: var(--S); background: rgba(63,169,245,.1); border-radius: 50px;
  padding: 3px 12px; margin-bottom: 10px; display: inline-block;
  border: 1px solid rgba(63,169,245,.2);
}
.gyb-step__title { font-size: 16px; font-weight: 800; color: var(--D); margin: 0 0 8px; }
.gyb-step__desc  { font-size: 13px; color: var(--M); line-height: 1.65; margin: 0; }

/* ── 5. Benefits grid ── */
.gyb-benefits-grid {
  display: grid; grid-template-columns: repeat(3,1fr);
  gap: 24px; margin-top: 48px;
}
.gyb-benefit-card {
  background: var(--W); border: 1.5px solid var(--L);
  border-radius: var(--rx); padding: 32px 26px;
  transition: var(--t); box-shadow: 0 2px 12px rgba(0,73,127,.05);
}
.gyb-benefit-card:hover {
  border-color: var(--S); transform: translateY(-5px);
  box-shadow: var(--sh-md); border-bottom: 3px solid var(--S);
}
.gyb-benefit-ico {
  width: 54px; height: 54px; border-radius: var(--rl);
  display: flex; align-items: center; justify-content: center;
  font-size: 22px; margin-bottom: 20px;
}
.gyb-benefit-title { font-size: 17px; font-weight: 800; color: var(--D); margin: 0 0 10px; }
.gyb-benefit-desc  { font-size: 14px; color: var(--M); line-height: 1.7; margin: 0; }

/* ── 6. Pricing ── */
.gyb-plans {
  display: grid; grid-template-columns: repeat(3,1fr);
  gap: 22px; margin-top: 52px;
}
.gyb-plan {
  background: var(--W); border: 1.5px solid var(--L);
  border-radius: var(--rx); overflow: hidden; position: relative;
  transition: var(--t); box-shadow: 0 2px 12px rgba(0,73,127,.05);
}
.gyb-plan:hover { transform: translateY(-6px); box-shadow: var(--sh-lg); }
.gyb-plan--popular { border-color: var(--B); box-shadow: var(--sh); }
.gyb-plan__popular-badge {
  position: absolute; top: 16px; right: 16px;
  background: var(--O); color: #fff; font-size: 11px; font-weight: 800;
  padding: 3px 12px; border-radius: 50px; letter-spacing: .05em;
}
.gyb-plan__head { padding: 30px 26px 20px; border-bottom: 1px solid var(--L); }
.gyb-plan--popular .gyb-plan__head { background: var(--B); }
.gyb-plan__name {
  font-size: 13px; font-weight: 800; letter-spacing: .08em;
  text-transform: uppercase; color: var(--M); margin-bottom: 10px;
}
.gyb-plan--popular .gyb-plan__name { color: rgba(255,255,255,.65); }
.gyb-plan__price { font-size: 38px; font-weight: 900; color: var(--D); line-height: 1; margin-bottom: 4px; }
.gyb-plan--popular .gyb-plan__price { color: #fff; }
.gyb-plan__price-note { font-size: 13px; color: var(--M); }
.gyb-plan--popular .gyb-plan__price-note { color: rgba(255,255,255,.55); }
.gyb-plan__body { padding: 24px 26px; }
.gyb-plan__features {
  list-style: none; padding: 0; margin: 0 0 24px;
  display: flex; flex-direction: column; gap: 12px;
}
.gyb-plan__feature {
  display: flex; align-items: center; gap: 10px;
  font-size: 14px; color: var(--D); font-weight: 500;
}
.gyb-plan__feature i { color: #16a34a; font-size: 14px; }
.gyb-plan__feature.gyb-no i { color: var(--L); }
.gyb-plan__cta {
  display: block; width: 100%; text-align: center;
  padding: 13px; border-radius: 50px;
  font-size: 14px; font-weight: 800; text-decoration: none;
  transition: var(--t); font-family: var(--F);
}
.gyb-plan--basic .gyb-plan__cta {
  background: var(--L); color: var(--D); border: 1.5px solid var(--L);
}
.gyb-plan--basic .gyb-plan__cta:hover { background: #d0dde8; color: var(--D); }
.gyb-plan--popular .gyb-plan__cta {
  background: var(--S); color: #fff; border: none;
  box-shadow: 0 4px 14px rgba(63,169,245,.3);
}
.gyb-plan--popular .gyb-plan__cta:hover { background: #2a95e0; color: #fff; }
.gyb-plan--enterprise .gyb-plan__cta { background: var(--B); color: #fff; border: none; }
.gyb-plan--enterprise .gyb-plan__cta:hover { background: #003a66; color: #fff; }

/* ── 7. Testimonials ── */
.gyb-testimonials {
  display: grid; grid-template-columns: repeat(3,1fr);
  gap: 20px; margin-top: 48px;
}
.gyb-testimonial {
  background: var(--C); border: 1.5px solid #EDE9D4;
  border-radius: var(--rx); padding: 28px; transition: var(--t);
  display: flex; flex-direction: column;
}
.gyb-testimonial:hover { border-color: var(--S); box-shadow: 0 4px 20px rgba(0,73,127,.1); transform: translateY(-3px); }
.gyb-testimonial__stars { display: flex; gap: 3px; color: #F59E0B; font-size: 14px; margin-bottom: 14px; }
.gyb-testimonial__text {
  font-size: 14px; color: var(--D); line-height: 1.75; font-style: italic;
  margin-bottom: 18px; flex: 1;
}
.gyb-testimonial__text::before { content: '\201C'; color: var(--S); font-size: 22px; font-style: normal; margin-right: 2px; }
.gyb-testimonial__author { display: flex; align-items: center; gap: 12px; }
.gyb-testimonial__ava {
  width: 42px; height: 42px; border-radius: 50%;
  background: linear-gradient(135deg, var(--B), var(--S));
  color: #fff; font-size: 13px; font-weight: 700;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.gyb-testimonial__name { font-size: 14px; font-weight: 700; color: var(--D); margin-bottom: 2px; }
.gyb-testimonial__role { font-size: 12px; color: var(--M); }

/* ── 8. FAQ ── */
.gyb-faq-list {
  max-width: 780px; margin: 40px auto 0;
  display: flex; flex-direction: column; gap: 12px;
}
.gyb-faq-item {
  background: var(--W); border: 1.5px solid var(--L);
  border-radius: var(--r); overflow: hidden;
  transition: var(--t);
}
.gyb-faq-item:hover { border-color: var(--S); box-shadow: 0 4px 16px rgba(0,73,127,.08); }
.gyb-faq-btn {
  width: 100%; text-align: left; padding: 18px 22px;
  background: none; border: none; cursor: pointer;
  display: flex; justify-content: space-between; align-items: center;
  font-family: var(--F); font-size: 15px; font-weight: 700; color: var(--D);
  transition: background .15s;
}
.gyb-faq-btn:hover { background: #f5f8fc; }
.gyb-faq-btn.open { color: var(--S); }
.gyb-faq-arrow {
  width: 26px; height: 26px; border-radius: 50%;
  background: var(--L); color: var(--M);
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; transition: transform .2s, background .15s; line-height: 1; flex-shrink: 0;
}
.gyb-faq-btn.open .gyb-faq-arrow { transform: rotate(45deg); background: var(--S); color: #fff; }
.gyb-faq-body {
  display: none; padding: 0 22px 18px;
  font-size: 14px; color: var(--M); line-height: 1.75;
}
.gyb-faq-body.open { display: block; }

/* ── 9. Final CTA ── */
.gyb-final-cta {
  background: var(--B);
  padding: 90px 0; text-align: center; position: relative; overflow: hidden;
}
.gyb-final-cta::before {
  content: ''; position: absolute; left: -120px; bottom: -120px;
  width: 360px; height: 360px; border-radius: 50%;
  background: radial-gradient(circle, rgba(63,169,245,.08) 0%, transparent 70%);
}
.gyb-final-cta::after {
  content: ''; position: absolute; top: -100px; right: -80px;
  width: 400px; height: 400px; border-radius: 50%;
  background: radial-gradient(circle, rgba(255,138,61,.07) 0%, transparent 70%);
}
.gyb-final-cta__title {
  font-size: clamp(26px,4vw,42px); font-weight: 900; color: #fff;
  margin: 0 0 14px; line-height: 1.13; letter-spacing: -1.5px;
}
.gyb-final-cta__sub {
  font-size: 16px; color: rgba(255,255,255,.73);
  max-width: 550px; margin: 0 auto 32px; line-height: 1.7;
}

/* ── Responsive ── */
@media (max-width: 1024px) {
  .gyb-plans { grid-template-columns: 1fr; max-width: 480px; margin-left: auto; margin-right: auto; }
  .gyb-benefits-grid { grid-template-columns: repeat(2,1fr); }
  .gyb-testimonials { grid-template-columns: 1fr; }
  .gyb-strip__cell { padding: 0 20px; }
}
@media (max-width: 900px) {
  .gyb-steps { grid-template-columns: repeat(2,1fr); gap: 32px; }
  .gyb-steps::before { display: none; }
  .gyb-strip__grid { grid-template-columns: repeat(2,1fr); }
  .gyb-strip__cell { padding: 12px 16px; border-bottom: 1px solid var(--L); border-right: none; }
  .gyb-strip__cell:nth-child(odd) { border-right: 1px solid var(--L); }
}
@media (max-width: 640px) {
  .gyb-steps { grid-template-columns: 1fr; }
  .gyb-benefits-grid { grid-template-columns: 1fr; }
  .gyb-section { padding: 64px 0; }
  .gyb-hero__card { display: none; }
  .gyb-strip__grid { grid-template-columns: 1fr; }
  .gyb-strip__cell { border-right: none; border-bottom: 1px solid var(--L); padding: 14px 24px; }
  .gyb-strip__cell:last-child { border-bottom: none; }
}

/* Scroll animations */
.gyb-scroll { opacity: 0; transform: translateY(22px); transition: opacity .5s ease, transform .5s ease; }
.gyb-scroll.visible { opacity: 1; transform: none; }

/* ══ CHARTE SYNC — overrides finaux pour cohérence totale ══════════ */

/* Hero — dot decoratif sur tagline */
.gyb-eyebrow { letter-spacing: .8px; }

/* Stats strip — plus aéré */
.gyb-strip { padding: 28px 0; }
.gyb-strip__num { font-size: 24px; font-weight: 900; letter-spacing: -1px; }

/* Intro cards — unify hover */
.gyb-intro-feat { border-radius: 16px !important; }
.gyb-intro-feat:hover { border-color: var(--S) !important; }
.gyb-intro-feat__ico { border-radius: 12px !important; }

/* Steps — card elevation */
.gyb-step { border-radius: 20px; box-shadow: 0 2px 10px rgba(0,73,127,.06); }
.gyb-step:hover { box-shadow: 0 10px 36px rgba(63,169,245,.14); }
.gyb-step__title { font-size: 15px; letter-spacing: -.3px; }

/* Spotlight cards — why join */
.gyb-spotlight-card { border-radius: 22px !important; }
.gyb-spotlight-card:hover { border-color: var(--S) !important; }
.gyb-spotlight-ico--navy { background: var(--B) !important; }

/* Pricing cards */
.gyb-plan { border-radius: 20px; }
.gyb-plan--popular { border-color: var(--S) !important; border-width: 2px !important; }
.gyb-plan--popular .gyb-plan__head { background: var(--B) !important; }
.gyb-plan--basic .gyb-plan__cta { background: #f0f4f8 !important; color: var(--B) !important; border-color: var(--L) !important; }
.gyb-plan--basic .gyb-plan__cta:hover { background: var(--S) !important; color: #fff !important; border-color: var(--S) !important; }
.gyb-plan--enterprise .gyb-plan__cta { background: var(--B) !important; color: #fff !important; }
.gyb-plan--enterprise .gyb-plan__cta:hover { background: var(--S) !important; }
.gyb-plan__feature i { color: var(--S) !important; }

/* Testimonials */
.gyb-testimonial { border-radius: 20px !important; background: #fff !important; border-color: var(--L) !important; }
.gyb-testimonial:hover { border-color: var(--S) !important; }
.gyb-testimonial__ava { background: var(--S) !important; }
.gyb-testimonial__text::before { color: var(--S) !important; }
.gyb-testimonial__stars { color: var(--S) !important; }

/* FAQ */
.gyb-faq-item { border-radius: 14px !important; }
.gyb-faq-item:hover { border-color: var(--S) !important; }

/* Section backgrounds — Wall White alternance */
.gyb-section--gray { background: var(--C) !important; }
.gyb-section--blue { background: rgba(63,169,245,.05) !important; }

/* Pro phase sections */
.pro-phase { border-bottom: 1px solid var(--L); }
.pro-phase:last-of-type { border-bottom: none; }
.pro-phase-img-wrap { border-radius: 20px !important; overflow: hidden !important; }

/* Callout orange band → Action Sky */
.gyb-callout {
  background: var(--B) !important;
  border-left: 5px solid var(--S) !important;
}
.gyb-callout::before { display: none !important; }
.gyb-callout__quote { color: rgba(255,255,255,.95) !important; }
.gyb-callout__ava { background: rgba(63,169,245,.2) !important; border-color: rgba(63,169,245,.4) !important; }
.gyb-callout__stat { background: rgba(255,255,255,.08) !important; border-color: rgba(255,255,255,.15) !important; }

/* Final CTA */
.gyb-final-cta { background: var(--B) !important; }
.gyb-final-cta::before, .gyb-final-cta::after { display: none !important; }
</style>


{# ══════════════════════════════════════════════════════════════════════════
   1. HERO
