{% extends 'base.html.twig' %}

{% block title %}{{ professional.companyName }} – {{ professional.category ? professional.category.name : 'Professional' }} | Drilleedo{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/drilleedo/css/custom/professional_profile.css') }}">
{% endblock %}

{% block body %}
<div class="drl-profile-wrapper">
    
    <!-- ───── 1. Banner Improvements (Step 1) ───── -->
    <header class="drl-pro-banner-area">
        <img src="{{ professional.banner ? asset('uploads/banners/' ~ professional.banner) : asset('uploads/banners/professionels.png') }}" 
             alt="Cover Image" class="drl-pro-banner-img">
        
        <div class="drl-banner-content-box">
            <h1 class="drl-banner-name-expert">{{ professional.companyName }}</h1>
        </div>
    </header>

    <!-- ───── 2. Facebook-style Overlap (Photo) ───── -->
    <section class="drl-overlap-section">
        <div class="drl-photo-overlap-card">
            <img src="{{ professional.logo ? asset('uploads/logos/' ~ professional.logo) : asset('assets/drilleedo/images/team/plumber.png') }}" 
                 alt="{{ professional.companyName }}">
        </div>
    </section>

    <!-- ───── 3. Body Container (Main Content + Sidebar) ───── -->
    <div class="drl-pro-body-container">
        
        <!-- Main Column -->
        <main class="drl-pro-main-col">
            
            <!-- About Section (Keep as requested) -->
            <section class="drl-section-card">
                <h2 class="drl-section-title-premium"><i class="feather-user"></i> About the Professional</h2>
                <div class="drl-body-text">
                    {% if professional.about %}
                        {{ professional.about|nl2br }}
                    {% else %}
                        {{ professional.companyName }} is a dedicated professional committed to high-quality service and customer satisfaction. With years of experience and a track record of successful projects, they bring expertise and reliability to every job.
                    {% endif %}
                </div>

                {% if professional.category %}
                <div class="mt-5 pt-4 border-top">
                    <h3 class="mb-4 fw-bold" style="font-size: 1.3rem;">Core Expertise</h3>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-light text-dark px-4 py-3 fs-5 border" style="border-radius:12px;">{{ professional.category.name }}</span>
                    </div>
                </div>
                {% endif %}
            </section>

            {# Other sections kept as requested (not modifying yet) #}
            <!-- Project Portfolio -->
            <section class="drl-section-card">
                <h2 class="drl-section-title-premium"><i class="feather-grid"></i> Project Portfolio</h2>
                <div class="drl-portfolio-grid-premium">
                    {% for project in professional.projets %}
                    <article class="drl-project-card-premium">
                        <div class="drl-project-img-box">
                            <img src="{{ project.mainPhoto ? asset('uploads/images/' ~ project.mainPhoto) : asset('assets/drilleedo/images/event/grid-type-01.jpg') }}" 
                                 alt="{{ project.name }}" loading="lazy">
                        </div>
                        <div class="drl-project-info">
                            <h4 class="drl-project-name">{{ project.name }}</h4>
                            <p class="text-muted small"><i class="feather-map-pin me-1"></i> {{ professional.city }}</p>
                        </div>
                    </article>
                    {% endfor %}
                </div>
            </section>

        </main>

        <!-- ───── 4. Sticky Summary Sidebar (Listing Style) ───── -->
        <aside class="drl-pro-side-col">
            <div class="drl-sidebar-fixed-wrapper">
                <div class="drl-summary-sidebar-card">
                    
                    <div class="mb-4">
                        <div class="badge bg-primary-light text-primary px-3 py-2 fw-bold mb-3" style="border-radius: 8px;">
                            <i class="feather-shield me-1"></i> VERIFIED BY DRILLEEDO
                        </div>
                        <h3 class="drl-summary-title">{{ professional.companyName }}</h3>
                    </div>

                    <ul class="drl-summary-details">
                        <li>
                            <i class="feather-tool"></i>
                            <span>{{ professional.category ? professional.category.name : 'Renovation Expert' }}</span>
                        </li>
                        <li>
                            <i class="feather-map-pin"></i>
                            <span>{{ professional.city ?? 'Canada' }}</span>
                        </li>
                        <li>
                            <i class="feather-briefcase"></i>
                            <span>{{ professional.expYears ?? '5' }}+ years experience</span>
                        </li>
                        <li>
                            <i class="feather-globe"></i>
                            <span>{{ professional.languageCode ?? 'FR / EN' }}</span>
                        </li>
                    </ul>

                    {# Sticky Rating Row #}
                    <div class="drl-summary-rating-row">
                        <div class="drl-rating-stars-gold">
                            {% set fullStars = professional.stats ? professional.stats.averageRating|round(0, 'floor') : 5 %}
                            {% for i in range(1, 5) %}
                                {% if i <= fullStars %}
                                    <i class="fas fa-star"></i>
                                {% else %}
                                    <i class="far fa-star"></i>
                                {% endif %}
                            {% endfor %}
                        </div>
                        <span class="drl-rating-score-bold">{{ professional.stats ? professional.stats.averageRating|number_format(1) : '5.0' }}</span>
                        <span class="text-muted small ms-1">({{ professional.stats ? professional.stats.reviewCount : 0 }} reviews)</span>
                    </div>

                    {# Primary CTA Button #}
                    <div class="mt-4">
                        <a href="{{ path('individual_direct_request_new', {'type': 'professional', 'id': professional.id}) }}" 
                           class="btn-cta-premium">
                            <i class="feather-send"></i> REQUEST QUOTE
                        </a>
                        <p class="text-center text-muted small mt-4 fw-bold">
                            <i class="feather-clock me-1 text-primary"></i> Replies in ~2 hours
                        </p>
                    </div>

                </div>
            </div>
        </aside>

    </div>
</div>
{% endblock %}
