{% extends 'base.html.twig' %}

{% block title %}{{ professional.companyName }} – {{ professional.category ? professional.category.name : 'Professional' }} in {{ professional.city ?? 'Montreal' }} | Drilleedo{% endblock %}
{% block meta_description %}{{ professional.category ? professional.category.name : 'Professional services' }} in {{ professional.city ?? 'Montreal' }} by {{ professional.companyName }}. {{ professional.about ? professional.about|striptags|slice(0, 150) : 'View services, projects and customer reviews.' }}...{% endblock %}
{% block meta_keywords %}{{ professional.companyName }}, {{ professional.category ? professional.category.name : '' }}, {{ professional.city ?? '' }}, rénovation, Drilleedo{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/drilleedo/css/custom/professional_profile.css') }}">
{% endblock %}

{% block structured_data %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "{{ professional.companyName }}",
  "image": "{{ absolute_url(professional.logo ? asset('uploads/logos/' ~ professional.logo) : asset('assets/drilleedo/images/team/plumber.png')) }}",
  "@id": "{{ app.request.uri }}",
  "url": "{{ app.request.uri }}",
  "telephone": "{{ professional.phoneNum ?? '' }}",
  "address": { "@type": "PostalAddress", "addressLocality": "{{ professional.city ?? 'Montreal' }}", "addressRegion": "QC", "addressCountry": "CA" },
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": "{{ professional.stats ? professional.stats.averageRating : 5 }}", "reviewCount": "{{ professional.stats ? professional.stats.reviewCount : 1 }}" },
  "description": "{{ professional.about ? professional.about|striptags|slice(0, 200) : 'Professional services on Drilleedo.' }}"
}
</script>
{% endblock %}

{% block body %}
{# ── Variables ──────────────────────────────────────────────────────────── #}
{% set avg         = professional.stats ? professional.stats.averageRating : 5 %}
{% set fullStars   = avg|round(0, 'floor') %}
{% set reviewCount = professional.stats ? professional.stats.reviewCount : 0 %}
{% set initials    = professional.companyName|split(' ')|map(w => w|slice(0,1))|join('')|upper|slice(0,2) %}

{# SVG star path (reusable) #}
{% set starPath = 'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z' %}

<div class="drl-page">

{# ══════════════════════════════════════════════════════════════════════════
   1. HERO BANNER
══════════════════════════════════════════════════════════════════════════ #}
<div class="drl-hero-banner">
  {% if professional.banner %}
    <img src="{{ asset('uploads/banners/' ~ professional.banner) }}"
         alt="Banner {{ professional.companyName }}"
         class="drl-hero-banner__img">
  {% else %}
    <img src="{{ asset('uploads/banners/professionels.png') }}"
         alt="Professional banner"
         class="drl-hero-banner__img">
  {% endif %}
</div>

{# ══════════════════════════════════════════════════════════════════════════
   2. PROFILE CARD (floats over banner)
══════════════════════════════════════════════════════════════════════════ #}
<div class="drl-wrap">

  <div class="drl-profile-card drl-fade d1">

    {# ── Profile top row ── #}
    <div class="drl-profile-top">

      {# Avatar #}
      <div class="drl-avatar-wrap">
        <div class="drl-avatar-img">
          {% if professional.logo %}
            <img src="{{ asset('uploads/logos/' ~ professional.logo) }}"
                 alt="Logo {{ professional.companyName }}">
          {% else %}
            {{ initials }}
          {% endif %}
        </div>
        <div class="drl-verified-dot" title="Verified Profile">✔</div>
      </div>

      {# Info #}
      <div class="drl-profile-info">
        <div class="drl-company-row">
          <span class="drl-company-name">{{ professional.companyName }}</span>
          <span class="drl-fast-badge">⚡ Fast Response</span>
        </div>

        <div class="drl-category-row">
          {{ professional.category ? professional.category.name : 'Professional' }}
          · {{ professional.city ?? 'Montreal' }}
        </div>

        <div class="drl-rating-row">
          <div class="drl-stars-row" aria-label="Rating {{ avg|number_format(1) }} out of 5">
            {% for i in range(1, 5) %}
              <svg class="drl-star-svg {{ i <= fullStars ? '' : 'drl-star-svg--empty' }}" viewBox="0 0 20 20">
                <path d="{{ starPath }}"/>
              </svg>
            {% endfor %}
          </div>
          <span class="drl-rating-num">{{ avg|number_format(1) }}</span>
          <span class="drl-rating-cnt"
                data-bs-toggle="modal"
                data-bs-target="#reviewsModal"
                role="button"
                tabindex="0">
            {{ reviewCount }} verified reviews
          </span>
        </div>

        <div class="drl-badges-row">
          <span class="drl-chip drl-chip-green">✔ Verified</span>
          <span class="drl-chip drl-chip-orange">⭐ Premium Verified</span>
          <span class="drl-chip drl-chip-blue">⚡ Fast Response</span>
        </div>
      </div>

      {# CTA #}
      <div class="drl-profile-cta">
        <button class="drl-btn-contact"
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#contactProModal"
                aria-haspopup="dialog">
          Contact Me →
        </button>
        <a href="tel:{{ professional.phoneNum ?? '+15145550000' }}"
           class="drl-phone-btn">
          📞 {{ professional.phoneNum ?? '+1 514-555-0000' }}
        </a>
      </div>

    </div>{# /profile-top #}

    {# ── Stats Strip ── #}
    <div class="drl-stats-strip">
      <div class="drl-stat-cell">
        <div class="drl-stat-ico">🏗️</div>
        <div>
          <div class="drl-stat-label">Category</div>
          <div class="drl-stat-val">{{ professional.category ? professional.category.name : 'Renovation' }}</div>
        </div>
      </div>
      <div class="drl-stat-cell">
        <div class="drl-stat-ico">📅</div>
        <div>
          <div class="drl-stat-label">Experience</div>
          <div class="drl-stat-val">{{ professional.expYears ?? '10' }} years</div>
        </div>
      </div>
      <div class="drl-stat-cell">
        <div class="drl-stat-ico">👥</div>
        <div>
          <div class="drl-stat-label">Employees</div>
          <div class="drl-stat-val">6 to 10</div>
        </div>
      </div>
      <div class="drl-stat-cell">
        <div class="drl-stat-ico">💬</div>
        <div>
          <div class="drl-stat-label">Languages spoken</div>
          <div class="drl-stat-val">🇫🇷 French &nbsp;🇬🇧 English</div>
        </div>
      </div>
      <div class="drl-stat-cell">
        <div class="drl-stat-ico">✅</div>
        <div>
          <div class="drl-stat-label">Projects completed</div>
          <div class="drl-stat-val">
            {% if professional.projets|length > 0 %}
              {{ professional.projets|length }} project{{ professional.projets|length > 1 ? 's' : '' }}
            {% else %}
              —
            {% endif %}
          </div>
        </div>
      </div>
    </div>

  </div>{# /profile-card #}


  {# ══════════════════════════════════════════════════════════════════════════
     3. MAIN LAYOUT
  ══════════════════════════════════════════════════════════════════════════ #}
  <div class="drl-main-layout">

    {# ── LEFT COLUMN ── #}
    <div class="drl-left-col">

      {# About / Projects Overview #}
      <div class="drl-s-card drl-fade d2">
        <div class="drl-s-head">
          <div class="drl-s-title">
            <span class="drl-s-title-dot"></span>
            Projects Overview
          </div>
        </div>
        <div class="drl-s-body">

          {# About text #}
          {% if professional.about %}
            <p style="font-size:14px;color:#64748b;line-height:1.7;margin-bottom:16px;">
              {{ professional.about|nl2br }}
            </p>
          {% endif %}

          {# Portfolio 2×2 grid #}
          {% if professional.projets|length > 0 %}
            <div class="drl-pres-grid">
              {% for project in professional.projets|slice(0, 4) %}
                <div class="drl-pres-item"
                     data-bs-toggle="modal"
                     data-bs-target="#projectModal{{ project.id }}"
                     role="button"
                     tabindex="0"
                     aria-haspopup="dialog"
                     aria-label="View {{ project.name }}">
                  <img src="{{ project.mainPhoto
                          ? asset('uploads/images/' ~ project.mainPhoto)
                          : asset('assets/drilleedo/images/event/grid-type-01.jpg') }}"
                       alt="{{ project.name }}"
                       loading="lazy">
                  <div class="drl-pres-caption">{{ project.name }}</div>
                </div>
              {% endfor %}
            </div>
          {% else %}
            {# Fallback: static placeholder images #}
            <div class="drl-pres-grid">
              <div class="drl-pres-item">
                <img src="{{ asset('assets/drilleedo/images/event/grid-type-01.jpg') }}" alt="Complete Renovation">
                <div class="drl-pres-caption">🔨 Complete Renovation</div>
              </div>
              <div class="drl-pres-item">
                <img src="{{ asset('assets/drilleedo/images/event/grid-type-01.jpg') }}" alt="Modern Kitchen">
                <div class="drl-pres-caption">🍳 Modern Kitchen</div>
              </div>
            </div>
          {% endif %}

        </div>
      </div>

      {# Customer Reviews #}
      <div class="drl-s-card drl-fade d3">
        <div class="drl-s-head">
          <div class="drl-s-title">
            <span class="drl-s-title-dot"></span>
            Customer Reviews
          </div>
          <button type="button"
                  class="drl-s-link"
                  data-bs-toggle="modal"
                  data-bs-target="#reviewsModal"
                  aria-haspopup="dialog">
            View all reviews →
          </button>
        </div>
        <div class="drl-s-body">

          <div class="drl-review-summary">
            <div>
              <div class="drl-big-num" aria-label="Note {{ avg|number_format(1) }}">{{ avg|number_format(1) }}</div>
              <div class="drl-big-stars" aria-hidden="true">
                {% for i in range(1, 5) %}
                  <svg viewBox="0 0 20 20"><path d="{{ starPath }}"/></svg>
                {% endfor %}
              </div>
              <div class="drl-rev-count">out of {{ reviewCount }} verified reviews</div>
            </div>
            <div class="drl-bars" aria-label="Rating distribution">
              {% for stars, pct in {5: 85, 4: 10, 3: 4, 2: 1, 1: 0} %}
                <div class="drl-bar-r">
                  <span class="drl-bar-lbl">{{ stars }}</span>
                  <div class="drl-bar-track" role="progressbar" aria-valuenow="{{ pct }}" aria-valuemin="0" aria-valuemax="100">
                    <div class="drl-bar-fill" style="width:{{ pct }}%"></div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>

          {# Static sample reviews #}
          <div class="drl-review-item">
            <div class="drl-rev-head">
              <div class="drl-rev-ava" aria-hidden="true">SD</div>
              <div>
                <div class="drl-rev-name">Sophie Duhamel</div>
                <div class="drl-rev-s" aria-label="5 stars">
                  {% for i in range(1, 5) %}
                    <svg viewBox="0 0 20 20"><path d="{{ starPath }}"/></svg>
                  {% endfor %}
                </div>
              </div>
              <div class="drl-rev-tag">Kitchen Renovation</div>
            </div>
            <p class="drl-rev-text">
              The team did a complete renovation of my kitchen and interior finishes.
              Impeccable work, deadlines met, and excellent communication throughout the project. I highly recommend!
            </p>
            <div class="drl-rev-date">April 29, 2025</div>
          </div>

          <div class="drl-review-item">
            <div class="drl-rev-head">
              <div class="drl-rev-ava" aria-hidden="true">TM</div>
              <div>
                <div class="drl-rev-name">Thomas Martin</div>
                <div class="drl-rev-s" aria-label="5 stars">
                  {% for i in range(1, 5) %}
                    <svg viewBox="0 0 20 20"><path d="{{ starPath }}"/></svg>
                  {% endfor %}
                </div>
              </div>
              <div class="drl-rev-tag">Complete Renovation</div>
            </div>
            <p class="drl-rev-text">
              Very professional team. They adapted to our needs and delivered a result
              that met our expectations. Excellent value for money and a consistently clean site.
            </p>
            <div class="drl-rev-date">March 15, 2025</div>
          </div>

        </div>
      </div>

      {# Project Gallery #}
      {% if professional.projets|length > 0 %}
      <div class="drl-s-card drl-fade d4">
        <div class="drl-s-head">
          <div class="drl-s-title">
            <span class="drl-s-title-dot"></span>
            Project Gallery
            <span class="drl-count-badge">({{ professional.projets|length }})</span>
          </div>
          <span class="drl-s-link">View all projects →</span>
        </div>
        <div class="drl-s-body">
          <div class="drl-gallery-grid">
            {% for project in professional.projets %}
              <div class="drl-gal-item"
                   data-bs-toggle="modal"
                   data-bs-target="#projectModal{{ project.id }}"
                   role="button"
                   tabindex="0"
                   aria-haspopup="dialog"
                   aria-label="{{ project.name }}">
                <img src="{{ project.mainPhoto
                        ? asset('uploads/images/' ~ project.mainPhoto)
                        : asset('assets/drilleedo/images/event/grid-type-01.jpg') }}"
                     alt="{{ project.name }}"
                     loading="lazy">
                <div class="drl-gal-lbl">{{ project.name }}</div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
      {% endif %}

    </div>{# /left-col #}

    {# ── RIGHT SIDEBAR ── #}
    <div class="drl-right-col">
      <div class="drl-sidebar-sticky">

        {# Devis card #}
        <div class="drl-devis-card drl-fade d2">
          <div class="drl-devis-header">
            <h3>📋 Request a free quote</h3>
            <p>Guaranteed response within 24h</p>
          </div>
          <div class="drl-devis-body">
            <button class="drl-btn-devis"
                    type="button"
                    data-bs-toggle="modal"
                    data-bs-target="#contactProModal"
                    aria-haspopup="dialog">
              Get a free quote →
            </button>
            <div class="drl-hours-title">Opening Hours</div>
            <div class="drl-hour-row">
              <span class="drl-hour-day">Monday – Friday</span>
              <span class="drl-hour-time">08:00 – 18:00</span>
            </div>
            <div class="drl-hour-row">
              <span class="drl-hour-day">Saturday</span>
              <span class="drl-hour-time">08:00 – 14:00</span>
            </div>
            <div class="drl-hour-row">
              <span class="drl-hour-day">Sunday</span>
              <span class="drl-hour-closed">Closed</span>
            </div>
          </div>
        </div>

        {# Contact Details #}
        <div class="drl-contact-card drl-fade d3">
          <div class="drl-contact-head">📞 Contact Details</div>
          <div class="drl-contact-body">
            <div class="drl-c-item">
              <div class="drl-c-ico">👤</div>
              <div>
                <div class="drl-c-lbl">Company</div>
                <div class="drl-c-val">{{ professional.companyName }}</div>
              </div>
            </div>
            <div class="drl-c-item">
              <div class="drl-c-ico">📍</div>
              <div>
                <div class="drl-c-lbl">City</div>
                <div class="drl-c-val">{{ professional.city ?? 'Montreal' }}, QC</div>
              </div>
            </div>
            {% if professional.phoneNum %}
            <div class="drl-c-item">
              <div class="drl-c-ico">📞</div>
              <div>
                <div class="drl-c-lbl">Phone</div>
                <div class="drl-c-val">
                  <a href="tel:{{ professional.phoneNum }}">{{ professional.phoneNum }}</a>
                </div>
              </div>
            </div>
            {% else %}
            <div class="drl-c-item">
              <div class="drl-c-ico">📞</div>
              <div>
                <div class="drl-c-lbl">Phone</div>
                <div class="drl-c-val">+1 514-555-0000</div>
              </div>
            </div>
            {% endif %}
            <hr class="drl-c-divider">
            <div class="drl-c-item">
              <div class="drl-c-ico">🏗️</div>
              <div>
                <div class="drl-c-lbl">Category</div>
                <div class="drl-c-val">{{ professional.category ? professional.category.name : 'Renovation' }}</div>
              </div>
            </div>
            <div class="drl-c-item">
              <div class="drl-c-ico">📅</div>
              <div>
                <div class="drl-c-lbl">Experience</div>
                <div class="drl-c-val">{{ professional.expYears ?? '10' }}+ years</div>
              </div>
            </div>
          </div>
        </div>

        {# Advantages #}
        <div class="drl-adv-card drl-fade d3">
          <div class="drl-adv-head">✅ Our advantages</div>
          <div class="drl-adv-body">
            {% if professional.whyChooseUs and professional.whyChooseUs|length > 0 %}
              {% for item in professional.whyChooseUs %}
                <div class="drl-adv-item">
                  <span class="drl-adv-ico">✔</span>
                  <span class="drl-adv-txt">{{ item }}</span>
                </div>
              {% endfor %}
            {% else %}
              <div class="drl-adv-item"><span class="drl-adv-ico">📍</span><span class="drl-adv-txt">Intervention radius</span><span class="drl-adv-val">40 km</span></div>
              <div class="drl-adv-item"><span class="drl-adv-ico">⚡</span><span class="drl-adv-txt">Fast response</span></div>
              <div class="drl-adv-item"><span class="drl-adv-ico">💲</span><span class="drl-adv-txt">Minimum price</span><span class="drl-adv-val">$150</span></div>
              <div class="drl-adv-item"><span class="drl-adv-ico">📄</span><span class="drl-adv-txt">100% free quotes</span></div>
              <div class="drl-adv-item"><span class="drl-adv-ico">🛡️</span><span class="drl-adv-txt">Insured and RBQ certified</span></div>
              <div class="drl-adv-item"><span class="drl-adv-ico">✔</span><span class="drl-adv-txt">Guaranteed work</span></div>
            {% endif %}
          </div>
          <a class="drl-btn-see-all" role="button" tabindex="0">View all advantages</a>
        </div>

        {# Zone card #}
        <div class="drl-zone-card drl-fade d4">
          <div class="drl-zone-title">📍 Service Zone: {{ professional.city ?? 'Montreal' }}</div>
          <div class="drl-zone-sub">This professional works in the following areas:</div>
          <div class="drl-zone-chips">
            <span class="drl-zone-chip">🏙️ Montreal</span>
            <span class="drl-zone-chip">Laval</span>
            <span class="drl-zone-chip">Longueuil</span>
            <span class="drl-zone-chip">Brossard</span>
          </div>
        </div>

      </div>{# /sidebar-sticky #}
    </div>{# /right-col #}

  </div>{# /main-layout #}

</div>{# /drl-wrap #}
</div>{# /drl-page #}


{# ══════════════════════════════════════════════════════════════════════════
   MODALS (preserved intact)
══════════════════════════════════════════════════════════════════════════ #}

{# Project modals #}
{% for project in professional.projets %}
<div class="modal fade" id="projectModal{{ project.id }}" tabindex="-1" aria-modal="true" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content drl-modal-content">
      <div class="modal-body p-0">
        <div class="row g-0">
          <div class="col-lg-7">
            <img src="{{ project.mainPhoto
                    ? asset('uploads/images/' ~ project.mainPhoto)
                    : asset('assets/drilleedo/images/event/grid-type-01.jpg') }}"
                 class="drl-modal-project-img"
                 alt="{{ project.name }}">
          </div>
          <div class="col-lg-5">
            <div class="p-4 drl-modal-scroll-pane">
              <button type="button" class="btn-close float-end" data-bs-dismiss="modal" aria-label="Close"></button>
              <h2 class="drl-modal-title mt-3">{{ project.name }}</h2>
              <div class="mb-3">
                <span class="drl-chip drl-chip-blue drl-modal-badge-sm">
                  Completed Project
                </span>
              </div>
              <div class="drl-modal-desc mb-3">{{ project.description|nl2br }}</div>
              {% if project.gallery %}
                <p class="drl-modal-gallery-title">Gallery</p>
                <div class="row g-2 mb-3">
                  {% for photo in project.gallery %}
                    <div class="col-6">
                      <img src="{{ asset('uploads/images/' ~ photo) }}"
                           alt="Photo {{ project.name }}"
                           class="drl-modal-gallery-img">
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
              <div class="drl-modal-action-row">
                <button class="drl-btn-submit"
                        type="button"
                        data-bs-dismiss="modal"
                        data-bs-toggle="modal"
                        data-bs-target="#contactProModal">
                  Request a similar quote
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endfor %}

{# Reviews modal #}
<div class="modal fade" id="reviewsModal" tabindex="-1" aria-modal="true" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content drl-modal-content">
      <div class="drl-modal-header">
        Customer Reviews
        <button type="button" class="btn-close float-end" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="drl-modal-body">
        <div class="text-center py-3">
          <div class="drl-big-num">{{ avg|number_format(1) }}</div>
          <div class="drl-big-stars justify-content-center" aria-hidden="true">
            {% for i in range(1, 5) %}
              <svg viewBox="0 0 20 20"><path d="{{ starPath }}"/></svg>
            {% endfor %}
          </div>
          <p class="drl-rev-count mt-1">{{ reviewCount }} verified reviews</p>
          <hr class="drl-modal-sep">
          <p class="drl-reviews-note">Detailed reviews will appear here soon.</p>
        </div>
      </div>
    </div>
  </div>
</div>

{# Contact / Devis modal #}
<div class="modal fade" id="contactProModal" tabindex="-1" aria-modal="true" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content drl-modal-content">
      <div class="drl-modal-header">
        Contact {{ professional.companyName }}
        <button type="button" class="btn-close float-end" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="drl-modal-body">
        <p class="drl-modal-intro">
          Send a direct request for a quote, information or project consultation.
        </p>
        <div class="drl-modal-form">
          {{ form_start(directRequestForm) }}
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label">Subject of your request</label>
                {{ form_widget(directRequestForm.title) }}
              </div>
              <div class="col-12">
                <label class="form-label">Describe your needs</label>
                {{ form_widget(directRequestForm.description) }}
              </div>
              <div class="col-md-6">
                <label class="form-label">Main service required</label>
                {{ form_widget(directRequestForm.category) }}
              </div>
              <div class="col-md-6">
                <label class="form-label">Attach photos (optional)</label>
                {{ form_widget(directRequestForm.images) }}
              </div>
            </div>
            <div class="mt-3">
              <button type="submit" class="drl-btn-submit">
                Send my request to {{ professional.companyName }}
              </button>
            </div>
          {{ form_end(directRequestForm) }}
        </div>
      </div>
    </div>
  </div>
</div>

{% endblock %}
