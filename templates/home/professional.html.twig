{% extends 'base.html.twig' %}

{% block title %}{{ professional.companyName }} – {{ professional.category ? professional.category.localizedTitle(app.request.locale) : 'Professionnel' }} à {{ professional.city ?? 'Montréal' }} | Drilleedo{% endblock %}
{% block meta_description %}{{ professional.category ? professional.category.localizedTitle(app.request.locale) : 'Services professionnels' }} à {{ professional.city ?? 'Montréal' }} par {{ professional.companyName }}. {{ professional.about ? professional.about|striptags|slice(0, 150) : 'Découvrez les services, projets et avis clients.' }}...{% endblock %}
{% block meta_keywords %}{{ professional.companyName }}, {{ professional.category ? professional.category.localizedTitle(app.request.locale) : '' }}, {{ professional.city ?? '' }}, renovation, Drilleedo{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/drilleedo/css/custom/professional_profile.css') }}">
{% endblock %}

{% block structured_data %}
{{ parent() }}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "{{ professional.companyName }}",
  "image": "{{ absolute_url(professional.logo ? asset('uploads/logos/' ~ professional.logo) : asset('assets/drilleedo/images/team/plumber.png')) }}",
  "url": "{{ app.request.uri }}",
  "telephone": "{{ professional.phoneNum ?? '' }}",
  "address": { "@type": "PostalAddress", "addressLocality": "{{ professional.city ?? 'Montreal' }}", "addressRegion": "QC", "addressCountry": "CA" },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ (professional.reviews|length > 0 ? (professional.reviews|reduce((carry, r) => carry + r.rating, 0) / professional.reviews|length) : (professional.stats ? professional.stats.averageRating : 5))|number_format(1) }}",
    "reviewCount": "{{ professional.reviews|length }}"
  },
  "description": "{{ professional.about ? professional.about|striptags|slice(0, 200)|e('js') : 'Services professionnels sur Drilleedo.' }}"
}
</script>
{% endblock %}

{% block body %}
{# ── Computed variables ─────────────────────────────────────────────────── #}
{% set reviewCount = professional.reviews|length %}
{% set sumRatings  = 0 %}
{% set starCounts  = {5: 0, 4: 0, 3: 0, 2: 0, 1: 0} %}
{% set avg = professional.stats ? professional.stats.averageRating : 5 %}

{% if reviewCount > 0 %}
  {% for r in professional.reviews %}
    {% set sumRatings = sumRatings + r.rating %}
    {% set val = r.rating|round(0, 'floor') %}
    {% if val >= 1 and val <= 5 %}
      {% set starCounts = starCounts|merge({ (val): starCounts[val] + 1 }) %}
    {% endif %}
  {% endfor %}
  {% set avg = sumRatings / reviewCount %}
{% endif %}

{% set fullStars = avg|round(0, 'floor') %}
{% set initials  = professional.companyName|split(' ')|map(w => w|slice(0,1))|join('')|upper|slice(0,2) %}

{% set langMap = {'FR': 'Français', 'EN': 'English', 'ES': 'Español', 'IT': 'Italiano', 'AR': 'العربية', 'PT': 'Português'} %}

{% set starPath = 'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z' %}

<div class="pp-page">

{# ══════════════════════════════════════════════════════════════════════════
   HERO BANNER
══════════════════════════════════════════════════════════════════════════ #}
<div class="pp-hero">
  {% if professional.banner %}
    <img src="{{ asset('uploads/banners/' ~ professional.banner) }}"
         alt="Bannière {{ professional.companyName }}"
         class="pp-hero__img">
  {% else %}
    <img src="{{ asset('uploads/banners/professionels.png') }}"
         alt="Professional banner"
         class="pp-hero__img">
  {% endif %}

  {# Breadcrumb #}
  <div class="pp-breadcrumb">
    <div class="pp-wrap">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
          <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="{{ url('app_home') }}" itemprop="item"><span itemprop="name">Accueil</span></a>
            <meta itemprop="position" content="1">
          </li>
          <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="{{ url('professionals_list') }}" itemprop="item"><span itemprop="name">Professionnels</span></a>
            <meta itemprop="position" content="2">
          </li>
          {% if professional.category %}
          <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="{{ url('professionals_list') }}?category={{ professional.category.id }}" itemprop="item">
              <span itemprop="name">{{ professional.category.localizedTitle(app.request.locale) }}</span>
            </a>
            <meta itemprop="position" content="3">
          </li>
          <li class="breadcrumb-item active" aria-current="page">
            <span>{{ professional.companyName }}</span>
          </li>
          {% else %}
          <li class="breadcrumb-item active" aria-current="page">
            <span>{{ professional.companyName }}</span>
          </li>
          {% endif %}
        </ol>
      </nav>
    </div>
  </div>

  <div class="pp-hero-stripe"></div>
</div>{# /hero #}

<div class="pp-wrap">

{# ══════════════════════════════════════════════════════════════════════════
   IDENTITY CARD
══════════════════════════════════════════════════════════════════════════ #}
<div class="pp-identity pp-fade d1">

  <div class="pp-id-top">

    {# Avatar #}
    <div class="pp-avatar-wrap">
      <div class="pp-avatar">
        {% if professional.logo %}
          <img src="{{ asset('uploads/logos/' ~ professional.logo) }}"
               alt="Logo {{ professional.companyName }}">
        {% else %}
          {{ initials }}
        {% endif %}
      </div>
      {% if professional.isVerified %}
        <div class="pp-verified-ring" title="Professionnel vérifié">
          <i class="feather-check" style="font-size:12px;"></i>
        </div>
      {% endif %}
    </div>

    {# Info #}
    <div class="pp-id-info">
      <div class="pp-id-name-row">
        <span class="pp-id-name">{{ professional.companyName }}</span>
        {% if professional.stats and professional.stats.avgResponseTime and professional.stats.avgResponseTime < 7200 %}
          <span class="pp-fast-badge">
            <i class="feather-zap"></i> Réponse rapide
          </span>
        {% endif %}
      </div>

      <div class="pp-id-meta">
        <span>
          <i class="feather-briefcase"></i>
          {{ professional.category ? professional.category.localizedTitle(app.request.locale) : 'Professionnel' }}
        </span>
        <span>
          <i class="feather-map-pin"></i>
          {{ professional.city ?? 'Montréal' }}, QC
        </span>
        {% if professional.expYears %}
        <span>
          <i class="feather-award"></i>
          {{ professional.expYears }} ans d'expérience
        </span>
        {% endif %}
      </div>

      {% if reviewCount > 0 %}
      <div class="pp-stars-row">
        <div class="pp-stars" aria-label="Note {{ avg|number_format(1) }} sur 5">
          {% for i in range(1, 5) %}
            <svg class="pp-star-svg {{ i <= fullStars ? '' : 'pp-star-svg--empty' }}" viewBox="0 0 20 20">
              <path d="{{ starPath }}"/>
            </svg>
          {% endfor %}
        </div>
        <span class="pp-rating-num">{{ avg|number_format(1) }}</span>
        <span class="pp-rating-cnt"
              data-bs-toggle="modal"
              data-bs-target="#reviewsModal"
              role="button" tabindex="0">
          {{ reviewCount }} avis vérifiés
        </span>
      </div>
      {% endif %}

      <div class="pp-badges">
        {% if professional.isVerified %}
          <span class="pp-chip pp-chip--green">
            <i class="feather-shield"></i> Vérifié
          </span>
        {% endif %}
        {% if professional.isTopRated %}
          <span class="pp-chip pp-chip--orange">
            <i class="feather-star"></i> Top Évalué
          </span>
        {% endif %}
        {% if professional.hasInsurance %}
          <span class="pp-chip pp-chip--blue">
            <i class="feather-shield"></i> Assuré
          </span>
        {% endif %}
        {% if professional.isRbqCertified %}
          <span class="pp-chip pp-chip--blue">
            <i class="feather-check-square"></i> Certifié RBQ
          </span>
        {% endif %}
        {% if professional.hasFreeQuotes %}
          <span class="pp-chip pp-chip--green">
            <i class="feather-file-text"></i> Devis gratuit
          </span>
        {% endif %}
        {% if professional.availabilityStatus == 'AVAILABLE' %}
          <span class="pp-chip pp-chip--avail">
            <i class="feather-circle"></i> Disponible
          </span>
        {% elseif professional.availabilityStatus == 'BUSY' %}
          <span class="pp-chip pp-chip--busy">
            <i class="feather-clock"></i> Occupé
          </span>
        {% endif %}
      </div>
    </div>

    {# CTA #}
    <div class="pp-id-cta">
      <button class="pp-btn-primary"
              type="button"
              data-bs-toggle="modal"
              data-bs-target="#contactProModal"
              aria-haspopup="dialog">
        <i class="feather-send"></i>
        Demander un devis
      </button>
      {% if professional.phoneNum %}
      <a href="tel:{{ professional.phoneNum }}" class="pp-btn-outline">
        <i class="feather-phone"></i>
        {{ professional.phoneNum }}
      </a>
      {% endif %}
    </div>

  </div>{# /pp-id-top #}

  {# Stats strip #}
  <div class="pp-stats-strip">
    <div class="pp-stat-cell">
      <div class="pp-stat-ico"><i class="feather-briefcase"></i></div>
      <div>
        <div class="pp-stat-lbl">Secteur</div>
        <div class="pp-stat-val">{{ professional.category ? professional.category.localizedTitle(app.request.locale) : '—' }}</div>
      </div>
    </div>
    <div class="pp-stat-cell">
      <div class="pp-stat-ico"><i class="feather-calendar"></i></div>
      <div>
        <div class="pp-stat-lbl">Expérience</div>
        <div class="pp-stat-val">{{ professional.expYears ?? '—' }} ans</div>
      </div>
    </div>
    <div class="pp-stat-cell">
      <div class="pp-stat-ico"><i class="feather-layers"></i></div>
      <div>
        <div class="pp-stat-lbl">Projets</div>
        <div class="pp-stat-val">
          {% if professional.projets|length > 0 %}
            {{ professional.projets|length }} projet{{ professional.projets|length > 1 ? 's' : '' }}
          {% else %}—{% endif %}
        </div>
      </div>
    </div>
    <div class="pp-stat-cell">
      <div class="pp-stat-ico"><i class="feather-globe"></i></div>
      <div>
        <div class="pp-stat-lbl">Langues</div>
        <div class="pp-stat-val">
          {% if professional.languages and professional.languages|length > 0 %}
            {% for code in professional.languages %}
              {{ langMap[code] ?? code }}{{ not loop.last ? ', ' : '' }}
            {% endfor %}
          {% else %}Français{% endif %}
        </div>
      </div>
    </div>
  </div>

</div>{# /pp-identity #}


{# ══════════════════════════════════════════════════════════════════════════
   MAIN LAYOUT
══════════════════════════════════════════════════════════════════════════ #}
<div class="pp-layout">

  {# ── LEFT COLUMN ── #}
  <div class="pp-left">

    {# About + Services #}
    {% if professional.about or (professional.services and professional.services|length > 0) %}
    <div class="pp-card pp-fade d2">
      <div class="pp-card-head">
        <div class="pp-card-title">
          <span class="pp-card-title-bar"></span>
          Présentation
        </div>
      </div>
      <div class="pp-card-body">
        {% if professional.about %}
          <p class="pp-about-text">{{ professional.about|nl2br }}</p>
        {% else %}
          <p class="pp-about-text">
            {{ professional.companyName }} est un professionnel dédié offrant des services de
            {{ professional.category ? professional.category.localizedTitle(app.request.locale)|lower : 'rénovation' }}
            de haute qualité au {{ professional.city ?? 'Québec' }}.
          </p>
        {% endif %}

        {% if professional.services and professional.services|length > 0 %}
          <div class="pp-services-grid">
            {% for svc in professional.services %}
              <span class="pp-service-chip">
                <i class="feather-tool"></i> {{ svc }}
              </span>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
    {% endif %}

    {# Why choose us + Services highlights #}
    {% if (professional.whyChooseUs and professional.whyChooseUs|length > 0) or (professional.services and professional.services|length > 0) %}
    <div class="pp-card pp-fade d2">
      <div class="pp-card-head">
        <div class="pp-card-title">
          <span class="pp-card-title-bar"></span>
          Points forts
        </div>
      </div>
      <div class="pp-card-body">
        <div class="pp-highlights-grid">
          <div>
            <div class="pp-hl-subtitle"><i class="feather-award"></i> Pourquoi nous choisir</div>
            <ul class="pp-hl-list">
              {% if professional.whyChooseUs and professional.whyChooseUs|length > 0 %}
                {% for item in professional.whyChooseUs %}
                  <li class="pp-hl-item">
                    <span class="pp-hl-ico"><i class="feather-check"></i></span>
                    {{ item }}
                  </li>
                {% endfor %}
              {% else %}
                <li class="pp-hl-item"><span class="pp-hl-ico"><i class="feather-award"></i></span> {{ professional.expYears|default(1) }}+ ans d'expérience</li>
                <li class="pp-hl-item"><span class="pp-hl-ico"><i class="feather-check-circle"></i></span> Qualité garantie</li>
                <li class="pp-hl-item"><span class="pp-hl-ico"><i class="feather-clock"></i></span> Ponctuel & fiable</li>
                <li class="pp-hl-item"><span class="pp-hl-ico"><i class="feather-thumbs-up"></i></span> Centré sur le client</li>
              {% endif %}
            </ul>
          </div>
          <div>
            <div class="pp-hl-subtitle"><i class="feather-tool"></i> Services offerts</div>
            <ul class="pp-hl-list">
              {% if professional.services and professional.services|length > 0 %}
                {% for item in professional.services %}
                  <li class="pp-hl-item">
                    <span class="pp-hl-ico"><i class="feather-tool"></i></span>
                    {{ item }}
                  </li>
                {% endfor %}
              {% else %}
                <li class="pp-hl-item"><span class="pp-hl-ico"><i class="feather-tool"></i></span> {{ professional.category ? professional.category.localizedTitle(app.request.locale) : 'Service général' }}</li>
                <li class="pp-hl-item"><span class="pp-hl-ico"><i class="feather-clipboard"></i></span> Consultations</li>
                <li class="pp-hl-item"><span class="pp-hl-ico"><i class="feather-settings"></i></span> Maintenance & Réparation</li>
                <li class="pp-hl-item"><span class="pp-hl-ico"><i class="feather-package"></i></span> Installations personnalisées</li>
              {% endif %}
            </ul>
          </div>
        </div>
      </div>
    </div>
    {% endif %}

    {# Projects overview 2×2 #}
    {% if professional.projets|length > 0 %}
    <div class="pp-card pp-fade d3">
      <div class="pp-card-head">
        <div class="pp-card-title">
          <span class="pp-card-title-bar"></span>
          Aperçu des projets
        </div>
        <span class="pp-card-link">
          {{ professional.projets|length }} projet{{ professional.projets|length > 1 ? 's' : '' }}
        </span>
      </div>
      <div class="pp-card-body">
        <div class="pp-project-grid">
          {% for project in professional.projets|slice(0, 4) %}
            <div class="pp-project-item"
                 data-bs-toggle="modal"
                 data-bs-target="#projectModal{{ project.id }}"
                 role="button" tabindex="0"
                 aria-haspopup="dialog"
                 aria-label="{{ project.name }}">
              <img src="{{ project.mainPhoto
                       ? asset('uploads/projects/' ~ project.mainPhoto)
                       : asset('assets/drilleedo/images/event/grid-type-01.jpg') }}"
                   alt="{{ project.name }}" loading="lazy">
              <div class="pp-project-caption">
                <i class="feather-layers" style="font-size:11px; margin-right:4px;"></i>
                {{ project.name }}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}

    {# Reviews section #}
    {% if reviewCount > 0 %}
    <div class="pp-card pp-fade d3">
      <div class="pp-card-head">
        <div class="pp-card-title">
          <span class="pp-card-title-bar"></span>
          Avis clients
        </div>
        <button type="button" class="pp-card-link"
                data-bs-toggle="modal" data-bs-target="#reviewsModal"
                aria-haspopup="dialog">
          Voir tous <i class="feather-arrow-right"></i>
        </button>
      </div>
      <div class="pp-card-body">

        <div class="pp-review-summary">
          <div>
            <div class="pp-big-score" aria-label="Note {{ avg|number_format(1) }}">{{ avg|number_format(1) }}</div>
            <div class="pp-big-stars" aria-hidden="true">
              {% for i in range(1, 5) %}
                <svg viewBox="0 0 20 20"><path d="{{ starPath }}"/></svg>
              {% endfor %}
            </div>
            <div class="pp-rev-total">sur {{ reviewCount }} avis vérifiés</div>
          </div>
          <div class="pp-bars">
            {% for stars in 5..1 %}
              {% set count = starCounts[stars] %}
              {% set pct = (count / reviewCount * 100)|round %}
              <div class="pp-bar-r">
                <span class="pp-bar-lbl">{{ stars }}</span>
                <div class="pp-bar-track" role="progressbar" aria-valuenow="{{ pct }}" aria-valuemin="0" aria-valuemax="100">
                  <div class="pp-bar-fill" style="width:{{ pct }}%"></div>
                </div>
                <span class="pp-bar-val">{{ count }}</span>
              </div>
            {% endfor %}
          </div>
        </div>

        {% for review in professional.reviews|slice(0, 2) %}
          <div class="pp-review-card">
            <div class="pp-rev-head">
              <div class="pp-rev-ava" aria-hidden="true">{{ review.reviewerName|slice(0, 2)|upper }}</div>
              <div>
                <div class="pp-rev-name">{{ review.reviewerName }}</div>
                <div class="pp-rev-stars" aria-label="{{ review.rating }} étoiles">
                  {% for i in range(1, 5) %}
                    <svg viewBox="0 0 20 20" {{ i > review.rating ? 'style="opacity:.3"' : '' }}><path d="{{ starPath }}"/></svg>
                  {% endfor %}
                </div>
              </div>
              <div class="pp-rev-tag">Avis vérifié</div>
            </div>
            <div class="pp-rev-body">{{ review.comment|nl2br }}</div>
            <div class="pp-rev-date"><i class="feather-calendar" style="font-size:11px;"></i> {{ review.createdAt|date('d F Y') }}</div>
          </div>
        {% endfor %}

      </div>
    </div>
    {% endif %}

    {# Full gallery #}
    {% if professional.projets|length > 0 %}
    <div class="pp-card pp-fade d4">
      <div class="pp-card-head">
        <div class="pp-card-title">
          <span class="pp-card-title-bar"></span>
          Galerie de travaux
          <span style="font-family:var(--pp-font-ui);font-size:13px;font-weight:600;color:var(--pp-text-light);">({{ professional.projets|length }})</span>
        </div>
      </div>
      <div class="pp-card-body">
        <div class="pp-gallery-grid">
          {% for project in professional.projets %}
            <div class="pp-gal-item"
                 data-bs-toggle="modal"
                 data-bs-target="#projectModal{{ project.id }}"
                 role="button" tabindex="0"
                 aria-haspopup="dialog"
                 aria-label="{{ project.name }}">
              <img src="{{ project.mainPhoto
                       ? asset('uploads/projects/' ~ project.mainPhoto)
                       : asset('assets/drilleedo/images/event/grid-type-01.jpg') }}"
                   alt="{{ project.name }}" loading="lazy">
              <div class="pp-gal-lbl">{{ project.name }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}

    {# FAQ #}
    <div class="pp-card pp-fade d4">
      <div class="pp-card-head">
        <div class="pp-card-title">
          <span class="pp-card-title-bar"></span>
          Questions fréquentes
        </div>
      </div>
      <div class="pp-card-body" style="padding-top:14px;">
        <div class="accordion accordion-flush" id="ppFAQ">
          <div class="accordion-item" style="border-radius:8px;overflow:hidden;margin-bottom:8px;border:1px solid var(--pp-border);">
            <h2 class="accordion-header">
              <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#ppFaq1" style="font-size:14px;font-weight:600;font-family:var(--pp-font-ui);">
                <i class="feather-message-circle me-2" style="color:var(--pp-sky);"></i>
                Comment obtenir un devis ?
              </button>
            </h2>
            <div id="ppFaq1" class="accordion-collapse collapse show" data-bs-parent="#ppFAQ">
              <div class="accordion-body" style="font-size:13.5px;color:var(--pp-text-muted);">
                Utilisez le bouton <strong>« Demander un devis »</strong> sur cette page pour envoyer les détails de votre projet. Nous vous recontacterons rapidement pour discuter de vos besoins ou planifier une visite.
              </div>
            </div>
          </div>
          <div class="accordion-item" style="border-radius:8px;overflow:hidden;margin-bottom:8px;border:1px solid var(--pp-border);">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ppFaq2" style="font-size:14px;font-weight:600;font-family:var(--pp-font-ui);">
                <i class="feather-map-pin me-2" style="color:var(--pp-sky);"></i>
                Quelles zones desservez-vous ?
              </button>
            </h2>
            <div id="ppFaq2" class="accordion-collapse collapse" data-bs-parent="#ppFAQ">
              <div class="accordion-body" style="font-size:13.5px;color:var(--pp-text-muted);">
                Nous intervenons principalement à <strong>{{ professional.city ?? 'Montréal' }}</strong>
                {% if professional.interventionZone %} et dans les zones suivantes : {{ professional.interventionZone }}{% endif %}
                {% if professional.interventionRadius %} (rayon de {{ professional.interventionRadius }} km){% endif %}.
              </div>
            </div>
          </div>
          {% if professional.freeQuotes %}
          <div class="accordion-item" style="border-radius:8px;overflow:hidden;border:1px solid var(--pp-border);">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ppFaq3" style="font-size:14px;font-weight:600;font-family:var(--pp-font-ui);">
                <i class="feather-file-text me-2" style="color:var(--pp-sky);"></i>
                Le devis est-il payant ?
              </button>
            </h2>
            <div id="ppFaq3" class="accordion-collapse collapse" data-bs-parent="#ppFAQ">
              <div class="accordion-body" style="font-size:13.5px;color:var(--pp-text-muted);">
                Non, nos devis sont <strong>100 % gratuits</strong> et sans engagement de votre part.
              </div>
            </div>
          </div>
          {% endif %}
        </div>
      </div>
    </div>

  </div>{# /pp-left #}


  {# ── RIGHT SIDEBAR ── #}
