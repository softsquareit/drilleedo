          {% if professional.openingHours and professional.openingHours|length > 0 %}
            {% for hour in professional.openingHours %}
              {% if ':' in hour %}
                {% set parts = hour|split(':') %}
                {% set day   = parts[0]|trim %}
                {% set time  = parts[1:]|join(':')|trim %}
                {% set isClosed = (time|lower == 'closed' or time|lower == 'fermé' or time|lower == 'ferme') %}
                <div class="pp-hour-row">
                  <span class="pp-hour-day">{{ day }}</span>
                  <span class="{{ isClosed ? 'pp-hour-closed' : 'pp-hour-time' }}">{{ time }}</span>
                </div>
              {% else %}
                <div class="pp-hour-row">
                  <span class="pp-hour-day">{{ hour|trim }}</span>
                </div>
              {% endif %}
            {% endfor %}
          {% else %}
            <div class="pp-hour-row">
              <span class="pp-hour-day">Lun – Ven</span>
              <span class="pp-hour-time">08:00 – 18:00</span>
            </div>
            <div class="pp-hour-row">
              <span class="pp-hour-day">Samedi</span>
              <span class="pp-hour-time">08:00 – 14:00</span>
