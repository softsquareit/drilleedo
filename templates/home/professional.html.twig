{% extends 'base.html.twig' %}

{% block title %}{{ professional.companyName }} – {{ professional.category ? professional.category.name : 'Professionnel' }} à {{ professional.city ?? 'Montréal' }} | Drilleedo{% endblock %}

{% block meta_description %}Professionnel {{ professional.category ? professional.category.name : 'services' }} à {{ professional.city ?? 'Montréal' }} par {{ professional.companyName }}. {{ professional.about ? professional.about|striptags|slice(0, 150) : 'Consultez services, projets et avis clients.' }}...{% endblock %}

{% block meta_keywords %}{{ professional.companyName }}, {{ professional.category ? professional.category.name : '' }}, {{ professional.city ?? '' }}, rénovation, services professionnels, Drilleedo{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/drilleedo/css/custom/professional_profile.css') }}">
{% endblock %}

{% block structured_data %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "{{ professional.companyName }}",
    "image": "{{ absolute_url(professional.logo ? asset('uploads/logos/' ~ professional.logo) : asset('assets/drilleedo/images/team/plumber.png')) }}",
    "@id": "{{ app.request.uri }}",
    "url": "{{ app.request.uri }}",
    "telephone": "{{ professional.phoneNum ?? '' }}",
    "address": {
        "@type": "PostalAddress",
        "addressLocality": "{{ professional.city ?? 'Montréal' }}",
        "addressRegion": "QC",
        "addressCountry": "CA"
    },
    "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "{{ professional.stats ? professional.stats.averageRating : 5 }}",
        "reviewCount": "{{ professional.stats ? professional.stats.reviewCount : 1 }}"
    },
    "description": "{{ professional.about ? professional.about|striptags|slice(0, 200) : 'Services professionnels experts sur Drilleedo.' }}"
}
</script>
{% endblock %}

{% block body %}
{# ─── Variables ─────────────────────────────────────────────────────────── #}
{% set avg        = professional.stats ? professional.stats.averageRating : 5 %}
{% set fullStars  = avg|round(0, 'floor') %}
{% set reviewCount = professional.stats ? professional.stats.reviewCount : 0 %}
{% set initials   = professional.companyName|split(' ')|map(w => w|slice(0,1))|join('')|upper|slice(0,2) %}

<div class="drl-page">

  {# ══════════════════════════════════════════════════════════════════════
     1. HERO BANNER
     ══════════════════════════════════════════════════════════════════════ #}
  <header class="drl-hero" role="banner">

    <img src="{{ professional.banner
            ? asset('uploads/banners/' ~ professional.banner)
            : asset('uploads/banners/professionels.png') }}"
         alt="Bannière {{ professional.companyName }}"
         class="drl-hero__img">

    <div class="drl-hero__overlay" aria-hidden="true"></div>

    <div class="drl-hero__content">
      {% if professional.category %}
        <div class="drl-hero__category-badge">
          {% if professional.category.icon %}
            <img src="{{ asset('uploads/categories/' ~ professional.category.icon) }}"
                 alt="{{ professional.category.name }}"
                 class="drl-hero__category-icon">
          {% else %}
            <i class="feather-tool" aria-hidden="true"></i>
          {% endif %}
          {{ professional.category.name }}
        </div>
      {% endif %}

      <h1 class="drl-hero__title">{{ professional.companyName }}</h1>
    </div>

  </header>

  {# ══════════════════════════════════════════════════════════════════════
     2. IDENTITY BAR
     ══════════════════════════════════════════════════════════════════════ #}
  <section class="drl-identity-bar" aria-label="Identité du professionnel">
    <div class="drl-identity-bar__inner">

      {# Avatar #}
      <div class="drl-avatar-wrap">
        {% if professional.logo %}
          <img src="{{ asset('uploads/logos/' ~ professional.logo) }}"
               alt="Logo {{ professional.companyName }}"
               class="drl-avatar">
        {% else %}
          <div class="drl-avatar--initials" aria-label="{{ professional.companyName }}">
            {{ initials }}
          </div>
        {% endif %}
        <div class="drl-avatar-verified" title="Profil vérifié" aria-label="Profil vérifié">
          <i class="feather-check" aria-hidden="true"></i>
        </div>
      </div>

      {# Info #}
      <div class="drl-identity-info">
        <h2 class="drl-identity-info__name">{{ professional.companyName }}</h2>

        <div class="drl-identity-info__meta">
          {% if professional.category %}
            <span><i class="feather-briefcase" aria-hidden="true"></i> {{ professional.category.name }}</span>
          {% endif %}
          <span><i class="feather-map-pin" aria-hidden="true"></i> {{ professional.city ?? 'Montréal' }}, QC</span>
        </div>

        <div class="drl-identity-info__meta drl-meta-mb">
          <div class="drl-identity-info__stars"
               data-bs-toggle="modal"
               data-bs-target="#reviewsModal"
               role="button"
               tabindex="0"
               aria-label="Voir les avis — note {{ avg|number_format(1) }}">
            {% for i in range(1, 5) %}
              <i class="{{ i <= fullStars ? 'fas' : 'far' }} fa-star" aria-hidden="true"></i>
            {% endfor %}
            <span>{{ avg|number_format(1) }}</span>
            <small>({{ reviewCount }} avis)</small>
          </div>
        </div>

        <div class="drl-identity-info__badges">
          <span class="drl-badge drl-badge--green">
            <i class="feather-shield" aria-hidden="true"></i> Vérifié
          </span>
          <span class="drl-badge drl-badge--blue">
            <i class="feather-award" aria-hidden="true"></i> Premium
          </span>
          <span class="drl-badge drl-badge--orange">
            <i class="feather-zap" aria-hidden="true"></i> Réponse rapide
          </span>
        </div>
      </div>

      {# CTA column #}
      <div class="drl-identity-cta">
        <button class="drl-btn-quote"
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#contactProModal"
                aria-haspopup="dialog">
          <i class="feather-file-text" aria-hidden="true"></i>
          Obtenir un devis
        </button>
        {% if professional.phoneNum %}
          <div class="drl-phone-pill">
            <i class="feather-phone" aria-hidden="true"></i>
            {{ professional.phoneNum }}
          </div>
        {% else %}
          <div class="drl-phone-pill">
            <i class="feather-phone" aria-hidden="true"></i>
            +1 514-555-0000
          </div>
        {% endif %}
      </div>

    </div>
  </section>

  {# ══════════════════════════════════════════════════════════════════════
     3. STATS STRIP
     ══════════════════════════════════════════════════════════════════════ #}
  <div class="drl-stats-strip" role="complementary" aria-label="Statistiques">
    <div class="drl-stats-strip__inner">

      <div class="drl-stat-item">
        <span class="drl-stat-item__label">Catégorie</span>
        <span class="drl-stat-item__value">{{ professional.category ? professional.category.name : 'Rénovation' }}</span>
      </div>

      <div class="drl-stat-item">
        <span class="drl-stat-item__label">Expérience</span>
        <span class="drl-stat-item__value">{{ professional.expYears ?? '10' }}+ ans</span>
      </div>

      <div class="drl-stat-item">
        <span class="drl-stat-item__label">Employés</span>
        <span class="drl-stat-item__value">6 à 10</span>
      </div>

      <div class="drl-stat-item">
        <span class="drl-stat-item__label">Langues</span>
        <span class="drl-stat-item__value">🇫🇷 FR · 🇬🇧 EN</span>
      </div>

      <div class="drl-stat-item">
        <span class="drl-stat-item__label">Projets</span>
        <span class="drl-stat-item__value">{{ professional.projets|length > 0 ? professional.projets|length : '—' }}</span>
      </div>

    </div>
  </div>

  {# ══════════════════════════════════════════════════════════════════════
     4. MAIN LAYOUT
     ══════════════════════════════════════════════════════════════════════ #}
  <div class="drl-layout">

    {# ── Main Column ── #}
    <main class="drl-main" id="main-content">

      {# ── About ── #}
      <section class="drl-card drl-anim-fadeup" aria-labelledby="drl-about-heading">
        <h2 class="drl-card__title" id="drl-about-heading">
          <i class="feather-user" aria-hidden="true"></i>
          À propos
        </h2>

        <p class="drl-about-text">
          {% if professional.about %}
            {{ professional.about|nl2br }}
          {% else %}
            {{ professional.companyName }} est un professionnel de confiance engagé à fournir des services de qualité supérieure et une satisfaction client exceptionnelle.
            Chaque chantier est traité avec le même niveau d'exigence et de professionnalisme.
          {% endif %}
        </p>

        <div class="drl-highlights">

          {# Why Choose Me #}
          <div class="drl-highlight-panel">
            <p class="drl-highlight-panel__title">
              <i class="feather-check-circle" aria-hidden="true"></i>
              Pourquoi nous choisir
            </p>
            <ul class="drl-highlight-list" aria-label="Avantages">
              {% if professional.whyChooseUs and professional.whyChooseUs|length > 0 %}
                {% for item in professional.whyChooseUs %}
                  <li><i class="feather-check" aria-hidden="true"></i> {{ item }}</li>
                {% endfor %}
              {% else %}
                <li><i class="feather-check" aria-hidden="true"></i> Rayon d'intervention 40 km</li>
                <li><i class="feather-check" aria-hidden="true"></i> Intervention rapide garantie</li>
                <li><i class="feather-check" aria-hidden="true"></i> Devis gratuits et sans engagement</li>
                <li><i class="feather-check" aria-hidden="true"></i> Assuré RBQ</li>
                <li><i class="feather-check" aria-hidden="true"></i> Travaux garantis</li>
              {% endif %}
            </ul>
          </div>

          {# Services #}
          <div class="drl-highlight-panel">
            <p class="drl-highlight-panel__title">
              <i class="feather-settings" aria-hidden="true"></i>
              Nos services
            </p>
            <ul class="drl-highlight-list drl-highlight-list--blue" aria-label="Services proposés">
              {% if professional.services and professional.services|length > 0 %}
                {% for service in professional.services %}
                  <li><i class="feather-plus-circle" aria-hidden="true"></i> {{ service }}</li>
                {% endfor %}
              {% else %}
                <li><i class="feather-plus-circle" aria-hidden="true"></i> Rénovation résidentielle</li>
                <li><i class="feather-plus-circle" aria-hidden="true"></i> Consultation technique</li>
                <li><i class="feather-plus-circle" aria-hidden="true"></i> Aménagement intérieur</li>
              {% endif %}
            </ul>
          </div>

        </div>
      </section>

      {# ── Portfolio ── #}
      <section class="drl-card drl-anim-fadeup" aria-labelledby="drl-portfolio-heading">
        <h2 class="drl-card__title" id="drl-portfolio-heading">
          <i class="feather-grid" aria-hidden="true"></i>
          Portfolio de projets
        </h2>

        <div class="drl-portfolio-grid">
          {% if professional.projets|length > 0 %}
            {% for project in professional.projets %}
              <article class="drl-project-card"
                       data-bs-toggle="modal"
                       data-bs-target="#projectModal{{ project.id }}"
                       role="button"
                       tabindex="0"
                       aria-haspopup="dialog"
                       aria-label="Voir le projet {{ project.name }}">
                <div class="drl-project-card__img-wrap">
                  <img src="{{ project.mainPhoto
                          ? asset('uploads/images/' ~ project.mainPhoto)
                          : asset('assets/drilleedo/images/event/grid-type-01.jpg') }}"
                       alt="{{ project.name }}"
                       class="drl-project-card__img"
                       loading="lazy">
                  <div class="drl-project-card__overlay" aria-hidden="true">
                    <span class="drl-project-card__overlay-label">Voir le projet →</span>
                  </div>
                </div>
                <div class="drl-project-card__body">
                  <h3 class="drl-project-card__name">{{ project.name }}</h3>
                  <p class="drl-project-card__desc">{{ project.description|striptags }}</p>
                </div>
              </article>
            {% endfor %}
          {% else %}
            <div class="drl-portfolio-empty">
              <i class="feather-image drl-empty-icon" aria-hidden="true"></i>
              Aucun projet publié pour l'instant.
            </div>
          {% endif %}
        </div>
      </section>

      {# ── Reviews ── #}
      <section class="drl-card drl-anim-fadeup" aria-labelledby="drl-reviews-heading">
        <h2 class="drl-card__title" id="drl-reviews-heading">
          <i class="feather-star" aria-hidden="true"></i>
          Avis clients
        </h2>

        <div class="drl-reviews-score-row">
          <div>
            <div class="drl-reviews-big-score" aria-label="Note {{ avg|number_format(1) }} sur 5">
              {{ avg|number_format(1) }}
            </div>
            <div class="drl-reviews-stars" aria-hidden="true">
              {% for i in range(1, 5) %}
                <i class="{{ i <= fullStars ? 'fas' : 'far' }} fa-star"></i>
              {% endfor %}
            </div>
            <p class="drl-reviews-count">{{ reviewCount }} avis vérifiés</p>
          </div>

          <div class="drl-reviews-bars" aria-label="Répartition des notes">
            {% for stars in [5, 4, 3, 2, 1] %}
              {% set pct = stars == 5 ? 78 : (stars == 4 ? 14 : (stars == 3 ? 5 : (stars == 2 ? 2 : 1))) %}
              <div class="drl-bar-row">
                <span class="drl-bar-row__label">{{ stars }}★</span>
                <div class="drl-bar-track" role="progressbar" aria-valuenow="{{ pct }}" aria-valuemin="0" aria-valuemax="100">
                  <div class="drl-bar-fill" style="width: {{ pct }}%"></div>
                </div>
                <span>{{ pct }}%</span>
              </div>
            {% endfor %}
          </div>
        </div>

        <hr class="drl-reviews-divider">

        <div class="drl-reviews-list">
          {# Avis statiques réalistes #}
          <article class="drl-review-card">
            <div class="drl-review-card__header">
              <div class="drl-review-card__author">
                <div class="drl-review-card__avatar" aria-hidden="true">MA</div>
                <div>
                  <p class="drl-review-card__name">Marie A.</p>
                  <p class="drl-review-card__date">Février 2025</p>
                </div>
              </div>
              <div class="drl-review-card__stars" aria-label="5 étoiles">
                <i class="fas fa-star"></i><i class="fas fa-star"></i>
                <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
              </div>
            </div>
            <p class="drl-review-card__text">
              Excellent travail, très professionnel et ponctuel. Les finitions sont impeccables et le respect du budget a été total.
              Je recommande sans hésitation pour tous travaux de rénovation.
            </p>
          </article>

          <article class="drl-review-card">
            <div class="drl-review-card__header">
              <div class="drl-review-card__author">
                <div class="drl-review-card__avatar" aria-hidden="true">JL</div>
                <div>
                  <p class="drl-review-card__name">Jean-Luc B.</p>
                  <p class="drl-review-card__date">Janvier 2025</p>
                </div>
              </div>
              <div class="drl-review-card__stars" aria-label="5 étoiles">
                <i class="fas fa-star"></i><i class="fas fa-star"></i>
                <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
              </div>
            </div>
            <p class="drl-review-card__text">
              Très à l'écoute de nos besoins, réponse rapide et devis clair. Travaux réalisés dans les délais prévus.
              Une entreprise sérieuse à qui je fais entièrement confiance.
            </p>
          </article>
        </div>

        <div class="mt-3 text-center">
          <button class="drl-badge drl-badge--blue"
                  type="button"
                  data-bs-toggle="modal"
                  data-bs-target="#reviewsModal"
                  class="drl-badge drl-badge--blue drl-see-all-btn"
                  aria-haspopup="dialog">
            Voir tous les avis
          </button>
        </div>

      </section>

      {# ── Bottom CTA ── #}
      <div class="drl-cta-bottom drl-anim-fadeup">
        <button class="drl-btn-cta-full"
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#contactProModal"
                aria-haspopup="dialog">
          <i class="feather-message-circle" aria-hidden="true"></i>
          Contacter ce professionnel
        </button>
      </div>

    </main>

    {# ── SIDEBAR ── #}
    <aside class="drl-sidebar" aria-label="Informations pratiques">
      <div class="drl-sidebar-sticky">

        {# Card 1 : Demande de devis #}
        <div class="drl-sidebar-card drl-anim-fadeup">
          <div class="drl-sidebar-card__header">
            <i class="feather-file-text" aria-hidden="true"></i>
            <h3 class="drl-sidebar-card__header-title">Demande de devis</h3>
          </div>
          <div class="drl-sidebar-card__body">
            <button class="drl-btn-quote-sidebar"
                    type="button"
                    data-bs-toggle="modal"
                    data-bs-target="#contactProModal"
                    aria-haspopup="dialog">
              <i class="feather-send" aria-hidden="true"></i>
              Obtenir un devis gratuit
            </button>

            <ul class="drl-schedule-list" aria-label="Horaires d'ouverture">
              <li class="drl-schedule-row">
                <span class="drl-schedule-row__day">Lundi – Vendredi</span>
                <span class="drl-schedule-row__hours">08:00 – 18:00</span>
              </li>
              <li class="drl-schedule-row">
                <span class="drl-schedule-row__day">Samedi</span>
                <span class="drl-schedule-row__hours">08:00 – 14:00</span>
              </li>
              <li class="drl-schedule-row">
                <span class="drl-schedule-row__day">Dimanche</span>
                <span class="drl-schedule-row__hours drl-schedule-row__hours--closed">Fermé</span>
              </li>
            </ul>
          </div>
        </div>

        {# Card 2 : Contact #}
        <div class="drl-sidebar-card drl-anim-fadeup">
          <div class="drl-sidebar-card__header">
            <i class="feather-phone" aria-hidden="true"></i>
            <h3 class="drl-sidebar-card__header-title">Coordonnées</h3>
          </div>
          <div class="drl-sidebar-card__body">
            <ul class="drl-contact-list">
              <li class="drl-contact-row">
                <i class="feather-user" aria-hidden="true"></i>
                <span>{{ professional.companyName }}</span>
              </li>
              <li class="drl-contact-row">
                <i class="feather-map-pin" aria-hidden="true"></i>
                <span>{{ professional.city ?? 'Montréal' }}, QC</span>
              </li>
              {% if professional.phoneNum %}
                <li class="drl-contact-row">
                  <i class="feather-phone" aria-hidden="true"></i>
                  <a href="tel:{{ professional.phoneNum }}" class="drl-phone-link">
                    {{ professional.phoneNum }}
                  </a>
                </li>
              {% else %}
                <li class="drl-contact-row">
                  <i class="feather-phone" aria-hidden="true"></i>
                  <span>+1 514-555-0000</span>
                </li>
              {% endif %}
              {% if professional.category %}
                <li class="drl-contact-row">
                  <i class="feather-briefcase" aria-hidden="true"></i>
                  <span>{{ professional.category.name }}</span>
                </li>
              {% endif %}
              <li class="drl-contact-row">
                <i class="feather-clock" aria-hidden="true"></i>
                <span>{{ professional.expYears ?? '10' }}+ ans d'expérience</span>
              </li>
            </ul>
          </div>
        </div>

        {# Card 3 : Avantages #}
        <div class="drl-sidebar-card drl-anim-fadeup">
          <div class="drl-sidebar-card__header">
            <i class="feather-check-circle" aria-hidden="true"></i>
            <h3 class="drl-sidebar-card__header-title">Pourquoi nous choisir</h3>
          </div>
          <div class="drl-sidebar-card__body">
            <ul class="drl-advantages-list">
              {% if professional.whyChooseUs and professional.whyChooseUs|length > 0 %}
                {% for item in professional.whyChooseUs %}
                  <li>
                    <span class="drl-adv-icon" aria-hidden="true">✅</span>
                    <span>{{ item }}</span>
                  </li>
                {% endfor %}
              {% else %}
                <li><span class="drl-adv-icon" aria-hidden="true">📍</span><span>Rayon 40 km</span></li>
                <li><span class="drl-adv-icon" aria-hidden="true">⚡</span><span>Intervention rapide</span></li>
                <li><span class="drl-adv-icon" aria-hidden="true">💲</span><span>Prix min 150$</span></li>
                <li><span class="drl-adv-icon" aria-hidden="true">📄</span><span>Devis gratuits</span></li>
                <li><span class="drl-adv-icon" aria-hidden="true">🛡️</span><span>Assuré RBQ</span></li>
                <li><span class="drl-adv-icon" aria-hidden="true">✅</span><span>Travaux garantis</span></li>
              {% endif %}
            </ul>
          </div>
        </div>

        {# Card 4 : Zone de service #}
        <div class="drl-sidebar-card drl-anim-fadeup">
          <div class="drl-sidebar-card__header">
            <i class="feather-map" aria-hidden="true"></i>
            <h3 class="drl-sidebar-card__header-title">Zone de service</h3>
          </div>
          <div class="drl-sidebar-card__body">
            <div class="drl-zone-chips" role="list" aria-label="Villes desservies">
              <span class="drl-zone-chip" role="listitem"><i class="feather-map-pin" aria-hidden="true"></i> Montréal</span>
              <span class="drl-zone-chip" role="listitem"><i class="feather-map-pin" aria-hidden="true"></i> Laval</span>
              <span class="drl-zone-chip" role="listitem"><i class="feather-map-pin" aria-hidden="true"></i> Longueuil</span>
              <span class="drl-zone-chip" role="listitem"><i class="feather-map-pin" aria-hidden="true"></i> Brossard</span>
            </div>
          </div>
        </div>

      </div>
    </aside>

  </div>{# end drl-layout #}

</div>{# end drl-page #}


{# ══════════════════════════════════════════════════════════════════════════
   MODALS (preserved intact)
   ══════════════════════════════════════════════════════════════════════════ #}

{# ── Project Modals ── #}
{% for project in professional.projets %}
<div class="modal fade" id="projectModal{{ project.id }}" tabindex="-1" aria-modal="true" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content drl-modal-content">
      <div class="modal-body p-0">
        <div class="row g-0">
          <div class="col-lg-7">
            <img src="{{ project.mainPhoto
                    ? asset('uploads/images/' ~ project.mainPhoto)
                    : asset('assets/drilleedo/images/event/grid-type-01.jpg') }}"
                 class="drl-modal-project-img"
                 alt="{{ project.name }}">
          </div>
          <div class="col-lg-5">
            <div class="p-5 drl-modal-scroll-pane">
              <button type="button"
                      class="btn-close float-end"
                      data-bs-dismiss="modal"
                      aria-label="Fermer"></button>
              <h2 class="drl-modal-title mt-4">{{ project.name }}</h2>
              <div class="mb-4">
                <span class="drl-badge drl-badge--blue drl-modal-badge-sm">
                  <i class="feather-tag" aria-hidden="true"></i> Projet réalisé
                </span>
              </div>
              <div class="drl-modal-desc mb-4">
                {{ project.description|nl2br }}
              </div>

              {% if project.gallery %}
                <h3 class="drl-modal-gallery-title">
                  Galerie
                </h3>
                <div class="row g-3 mb-4">
                  {% for photo in project.gallery %}
                    <div class="col-6">
                      <img src="{{ asset('uploads/images/' ~ photo) }}"
                           alt="Photo du projet {{ project.name }}"
                           class="drl-modal-gallery-img">
                    </div>
                  {% endfor %}
                </div>
              {% endif %}

              <div class="drl-modal-action-row">
                <button class="drl-btn-submit"
                        type="button"
                        data-bs-dismiss="modal"
                        data-bs-toggle="modal"
                        data-bs-target="#contactProModal">
                  <i class="feather-send" aria-hidden="true"></i>
                  Demander un devis similaire
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endfor %}

{# ── Reviews Modal ── #}
<div class="modal fade" id="reviewsModal" tabindex="-1" aria-modal="true" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content drl-modal-content">
      <div class="drl-modal-header">
        <h2 class="drl-modal-title">Avis clients</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      <div class="drl-modal-body">
        <div class="text-center py-4">
          <div class="drl-reviews-big-score">{{ avg|number_format(1) }}</div>
          <div class="drl-reviews-stars justify-content-center mt-2" aria-hidden="true">
            {% for i in range(1, 5) %}
              <i class="{{ i <= fullStars ? 'fas' : 'far' }} fa-star"></i>
            {% endfor %}
          </div>
          <p class="drl-reviews-count mt-2">{{ reviewCount }} avis vérifiés</p>
          <hr class="drl-modal-sep">
          <p class="drl-reviews-note">
            Les avis détaillés sont en cours de synchronisation et apparaîtront ici prochainement.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

{# ── Contact / Quote Modal ── #}
<div class="modal fade" id="contactProModal" tabindex="-1" aria-modal="true" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content drl-modal-content">
      <div class="drl-modal-header">
        <h2 class="drl-modal-title">Contacter {{ professional.companyName }}</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      <div class="drl-modal-body">
        <p class="drl-modal-intro">
          Envoyez une demande directe pour un devis, des informations ou une consultation projet.
        </p>

        <div class="drl-modal-form">
          {{ form_start(directRequestForm) }}
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label">Objet de votre demande</label>
                {{ form_widget(directRequestForm.title) }}
              </div>
              <div class="col-12">
                <label class="form-label">Décrivez vos besoins</label>
                {{ form_widget(directRequestForm.description) }}
              </div>
              <div class="col-md-6">
                <label class="form-label">Service principal requis</label>
                {{ form_widget(directRequestForm.category) }}
              </div>
              <div class="col-md-6">
                <label class="form-label">Joindre des photos (optionnel)</label>
                {{ form_widget(directRequestForm.images) }}
              </div>
            </div>
            <div class="mt-4">
              <button type="submit" class="drl-btn-submit">
                <i class="feather-send" aria-hidden="true"></i>
                Envoyer ma demande à {{ professional.companyName }}
              </button>
            </div>
          {{ form_end(directRequestForm) }}
        </div>
      </div>
    </div>
  </div>
</div>

{% endblock %}
