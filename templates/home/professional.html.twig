{% extends 'base.html.twig' %}

{% block title %}{{ professional.companyName }} – {{ professional.category ? professional.category.name : 'Professionnel' }} à {{ professional.city ?? 'Montréal' }} | Drilleedo{% endblock %}
{% block meta_description %}{{ professional.category ? professional.category.name : 'Services professionnels' }} à {{ professional.city ?? 'Montréal' }} by {{ professional.companyName }}. {{ professional.about ? professional.about|striptags|slice(0, 150) : 'View services, projects and customer reviews.' }}...{% endblock %}
{% block meta_keywords %}{{ professional.companyName }}, {{ professional.category ? professional.category.name : '' }}, {{ professional.city ?? '' }}, renovation, Drilleedo{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/drilleedo/css/custom/professional_profile.css') }}">
{% endblock %}

{% block structured_data %}
{{ parent() }}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@id": "{{ app.request.uri }}",
  "@type": "LocalBusiness",
  "name": "{{ professional.companyName }}",
  "image": "{{ absolute_url(professional.logo ? asset('uploads/logos/' ~ professional.logo) : asset('assets/drilleedo/images/team/plumber.png')) }}",
  "url": "{{ app.request.uri }}",
  "telephone": "{{ professional.phoneNum ?? '' }}",
  "address": { "@type": "PostalAddress", "addressLocality": "{{ professional.city ?? 'Montreal' }}", "addressRegion": "QC", "addressCountry": "CA" },
  "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "{{ (professional.reviews|length > 0 ? (professional.reviews|reduce((carry, r) => carry + r.rating, 0) / professional.reviews|length) : (professional.stats ? professional.stats.averageRating : 5))|number_format(1) }}",
      "reviewCount": "{{ professional.reviews|length }}"
  },
  "description": "{{ professional.about ? professional.about|striptags|slice(0, 200)|e('js') : 'Services professionnels sur Drilleedo.' }}"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ url('app_home') }}"},
    {"@type": "ListItem", "position": 2, "name": "Professionnels", "item": "{{ url('professionals_list') }}"},
    {% if professional.category %}
    {"@type": "ListItem", "position": 3, "name": "{{ professional.category.name|e('js') }}", "item": "{{ url('professionals_list') }}?category={{ professional.category.id }}"},
    {"@type": "ListItem", "position": 4, "name": "{{ professional.companyName|e('js') }}"}
    {% else %}
    {"@type": "ListItem", "position": 3, "name": "{{ professional.companyName|e('js') }}"}
    {% endif %}
  ]
}
</script>
{% endblock %}

{% block body %}
{# ── Variables & Calculations ────────────────────────────────────────────── #}
{% set reviewCount = professional.reviews|length %}
{% set starCounts = {5: 0, 4: 0, 3: 0, 2: 0, 1: 0} %}
{% set sumRatings = 0 %}
{% set avg = professional.stats ? professional.stats.averageRating : 5 %}

{% if reviewCount > 0 %}
    {% for r in professional.reviews %}
        {% set sumRatings = sumRatings + r.rating %}
        {% set val = r.rating|round(0, 'floor') %}
        {% if val >= 1 and val <= 5 %}
            {% set starCounts = starCounts|merge({ (val): starCounts[val] + 1 }) %}
        {% endif %}
    {% endfor %}
    {% set avg = sumRatings / reviewCount %}
{% endif %}

{% set fullStars   = avg|round(0, 'floor') %}
{% set initials    = professional.companyName|split(' ')|map(w => w|slice(0,1))|join('')|upper|slice(0,2) %}

{% set langMap = {
    'FR': 'French',
    'EN': 'English',
    'ES': 'Spanish',
    'IT': 'Italian'
} %}

{# SVG star path (reusable) #}
{% set starPath = 'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z' %}

<div class="drl-page">

{# ── Breadcrumb navigation ────────────────────────────────────────────────── #}
<nav aria-label="breadcrumb" class="container pt-3 pb-1">
  <ol class="breadcrumb mb-0" itemscope itemtype="https://schema.org/BreadcrumbList">
    <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="{{ url('app_home') }}" itemprop="item"><span itemprop="name">Accueil</span></a>
      <meta itemprop="position" content="1">
    </li>
    <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="{{ url('professionals_list') }}" itemprop="item"><span itemprop="name">Professionnels</span></a>
      <meta itemprop="position" content="2">
    </li>
    {% if professional.category %}
    <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="{{ url('professionals_list') }}?category={{ professional.category.id }}" itemprop="item">
        <span itemprop="name">{{ professional.category.name }}</span>
      </a>
      <meta itemprop="position" content="3">
    </li>
    <li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <span itemprop="name">{{ professional.companyName }}</span>
      <meta itemprop="position" content="4">
    </li>
    {% else %}
    <li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <span itemprop="name">{{ professional.companyName }}</span>
      <meta itemprop="position" content="3">
    </li>
    {% endif %}
  </ol>
</nav>

{# ══════════════════════════════════════════════════════════════════════════
   1. HERO BANNER
══════════════════════════════════════════════════════════════════════════ #}
<div class="drl-hero-banner">
  {% if professional.banner %}
    <img src="{{ asset('uploads/banners/' ~ professional.banner) }}"
         alt="Banner {{ professional.companyName }}"
         class="drl-hero-banner__img">
  {% else %}
    <img src="{{ asset('uploads/banners/professionels.png') }}"
         alt="Professional banner"
         class="drl-hero-banner__img">
  {% endif %}
</div>

{# ══════════════════════════════════════════════════════════════════════════
   2. PROFILE CARD (floats over banner)
══════════════════════════════════════════════════════════════════════════ #}
<div class="drl-wrap">

  <div class="drl-profile-card drl-fade d1">

    {# ── Profile top row ── #}
    <div class="drl-profile-top">

      {# Avatar #}
      <div class="drl-avatar-wrap">
        <div class="drl-avatar-img">
          {% if professional.logo %}
            <img src="{{ asset('uploads/logos/' ~ professional.logo) }}"
                 alt="Logo {{ professional.companyName }}">
          {% else %}
            {{ initials }}
          {% endif %}
        </div>
        {% if professional.isVerified %}
          <div class="drl-verified-dot" title="Verified Profile">✔</div>
        {% endif %}
      </div>

      {# Info #}
      <div class="drl-profile-info">
        <div class="drl-company-row">
          <span class="drl-company-name">{{ professional.companyName }}</span>
          {% if professional.stats and professional.stats.avgResponseTime and professional.stats.avgResponseTime < 7200 %}
            <span class="drl-fast-badge">{{ 'public_profile.fast_response'|trans }}</span>
          {% endif %}
        </div>

        <div class="drl-category-row">
          {{ professional.category ? professional.category.name : 'Professionnel' }}
          · {{ professional.city ?? 'Montréal' }}
        </div>

        {% if reviewCount > 0 %}
        <div class="drl-rating-row">
          <div class="drl-stars-row" aria-label="Rating {{ avg|number_format(1) }} out of 5">
            {% for i in range(1, 5) %}
              <svg class="drl-star-svg {{ i <= fullStars ? '' : 'drl-star-svg--empty' }}" viewBox="0 0 20 20">
                <path d="{{ starPath }}"/>
              </svg>
            {% endfor %}
          </div>
          <span class="drl-rating-num">{{ avg|number_format(1) }}</span>
          <span class="drl-rating-cnt"
                data-bs-toggle="modal"
                data-bs-target="#reviewsModal"
                role="button"
                tabindex="0">
            {{ reviewCount }} verified reviews
          </span>
        </div>
        {% endif %}

        <div class="drl-badges-row">
          {% if professional.isVerified %}
            <span class="drl-chip drl-chip-green" title="Verified Professional">✔ Verified</span>
          {% endif %}
          {% if professional.isTopRated %}
            <span class="drl-chip drl-chip-orange" title="Membre Elite">⭐ Elite</span>
          {% endif %}
          {% if professional.hasInsurance %}
            <span class="drl-chip drl-chip-blue" title="Assurance responsabilité civile">🛡️ Insured</span>
          {% endif %}
          {% if professional.availabilityStatus == 'AVAILABLE' %}
            <span class="drl-chip drl-chip-green" style="background: rgba(34, 197, 94, 0.1); color: #16a34a; border-color: rgba(34, 197, 94, 0.2);">● {{ 'public_stats.available'|trans }}</span>
          {% elseif professional.availabilityStatus == 'BUSY' %}
            <span class="drl-chip drl-chip-orange" style="background: rgba(245, 158, 11, 0.1); color: #d97706; border-color: rgba(245, 158, 11, 0.2);">● {{ 'public_stats.busy'|trans }}</span>
          {% endif %}
          {% if professional.stats and professional.stats.avgResponseTime and professional.stats.avgResponseTime < 7200 %}
            <span class="drl-chip drl-chip-blue" title="Fast Response Time">⚡ Fast Response</span>
          {% endif %}
        </div>
      </div>

      {# CTA #}
      <div class="drl-profile-cta">
        <button class="drl-btn-contact"
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#contactProModal"
                aria-haspopup="dialog">
          {{ 'public_profile.contact_me'|trans }}
        </button>
        <a href="tel:{{ professional.phoneNum ?? '+15145550000' }}"
           class="drl-phone-btn">
          📞 {{ professional.phoneNum ?? '+1 514-555-0000' }}
        </a>
      </div>

    </div>{# /profile-top #}

    {# ── Stats Strip ── #}
    <div class="drl-stats-strip">
      <div class="drl-stat-cell">
        <div class="drl-stat-ico">🏗️</div>
        <div>
          <div class="drl-stat-label">{{ 'public_profile.category'|trans }}</div>
          <div class="drl-stat-val">{{ professional.category ? professional.category.name : 'Rénovation' }}</div>
        </div>
      </div>
      <div class="drl-stat-cell">
        <div class="drl-stat-ico">📅</div>
        <div>
          <div class="drl-stat-label">{{ 'public_profile.experience'|trans }}</div>
          <div class="drl-stat-val">{{ professional.expYears ?? '10' }} ans</div>
        </div>
      </div>
{# Employees stat removed #}
      <div class="drl-stat-cell">
        <div class="drl-stat-ico">💬</div>
        <div>
          <div class="drl-stat-label">{{ 'public_profile.languages'|trans }}</div>
          <div class="drl-stat-val">
            {% if professional.languages and professional.languages|length > 0 %}
              {% for code in professional.languages %}
                {{ langMap[code] ?? code }}{{ not loop.last ? ' & ' : '' }}
              {% endfor %}
            {% else %}
                French
            {% endif %}
          </div>
        </div>
      </div>
      <div class="drl-stat-cell">
        <div class="drl-stat-ico">✅</div>
        <div>
          <div class="drl-stat-label">{{ 'public_profile.completed_projects'|trans }}</div>
          <div class="drl-stat-val">
            {% if professional.projets|length > 0 %}
              {{ professional.projets|length }} projet{{ professional.projets|length > 1 ? 's' : '' }}
            {% else %}
              —
            {% endif %}
          </div>
        </div>
      </div>
    </div>

  </div>{# /profile-card #}


  {# ══════════════════════════════════════════════════════════════════════════
     3. MAIN LAYOUT
{# ══════════════════════════════════════════════════════════════════════════
   3. MAIN LAYOUT
══════════════════════════════════════════════════════════════════════════ #}
  <div class="drl-main-layout">

    {# ── LEFT COLUMN ── #}
    <div class="drl-left-col">
      {# About / Projects Overview #}
      {% if professional.about or (professional.services and professional.services|length > 0) or (professional.projets|length > 0) %}
      <div class="drl-s-card drl-fade d2">
        <div class="drl-s-head">
          <div class="drl-s-title">
            <span class="drl-s-title-dot"></span>
            {{ professional.projets|length > 0 ? 'public_profile.projects_overview'|trans : 'public_profile.bio_expertise'|trans }}
          </div>
        </div>
        <div class="drl-s-body">
          {% if professional.about %}
            <p style="font-size:14px;color:#64748b;line-height:1.7;margin-bottom:16px;">
              {{ professional.about|nl2br }}
            </p>
          {% endif %}

          {% if professional.services and professional.services|length > 0 %}
            <div class="mb-4">
                <div class="d-flex flex-wrap gap-2">
                    {% for svc in professional.services %}
                        <span class="badge bg-light border text-muted px-3 py-2 rounded-pill small fw-normal shadow-sm" style="font-size: 0.75rem;">
                            <i class="fas fa-check-circle text-primary me-1 opacity-50"></i> {{ svc }}
                        </span>
                    {% endfor %}
                </div>
            </div>
          {% endif %}

          {% if professional.projets|length > 0 %}
            <div class="drl-pres-grid">
              {% for project in professional.projets|slice(0, 4) %}
                <div class="drl-pres-item"
                     data-bs-toggle="modal"
                     data-bs-target="#projectModal{{ project.id }}"
                     role="button"
                     tabindex="0"
                     aria-haspopup="dialog"
                     aria-label="View {{ project.name }}">
                  <img src="{{ project.mainPhoto
                          ? asset('uploads/projects/' ~ project.mainPhoto)
                          : asset('assets/drilleedo/images/event/grid-type-01.jpg') }}"
                       alt="{{ project.name }}"
                       loading="lazy">
                  <div class="drl-pres-caption">{{ project.name }}</div>
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
      {% endif %}

      {# Customer Reviews #}
      {% if reviewCount > 0 %}
      <div class="drl-s-card drl-fade d3">
        <div class="drl-s-head">
          <div class="drl-s-title">
            <span class="drl-s-title-dot"></span>
            {{ 'public_profile.customer_reviews'|trans }}
          </div>
          <button type="button" class="drl-s-link" data-bs-toggle="modal" data-bs-target="#reviewsModal" aria-haspopup="dialog">
            View all reviews →
          </button>
        </div>
        <div class="drl-s-body">
          <div class="drl-review-summary">
            <div>
              <div class="drl-big-num" aria-label="Note {{ avg|number_format(1) }}">{{ avg|number_format(1) }}</div>
              <div class="drl-big-stars" aria-hidden="true">
                {% for i in range(1, 5) %}
                  <svg viewBox="0 0 20 20" class="{{ i <= avg|round ? 'text-warning' : 'text-light' }}"><path d="{{ starPath }}"/></svg>
                {% endfor %}
              </div>
              <div class="drl-rev-count">out of {{ reviewCount }} verified reviews</div>
            </div>
            <div class="drl-bars" aria-label="Rating distribution">
                {% for stars in 5..1 %}
                    {% set count = starCounts[stars] %}
                    {% set pct = (count / reviewCount * 100)|round %}
                    <div class="drl-bar-r">
                        <span class="drl-bar-lbl">{{ stars }}</span>
                        <div class="drl-bar-track" role="progressbar" aria-valuenow="{{ pct }}" aria-valuemin="0" aria-valuemax="100">
                            <div class="drl-bar-fill" style="width:{{ pct }}%"></div>
                        </div>
                        <span class="drl-bar-val">{{ count }}</span>
                    </div>
                {% endfor %}
            </div>
          </div>

          {% for review in professional.reviews|slice(0, 2) %}
            <div class="drl-review-item">
              <div class="drl-rev-head">
                <div class="drl-rev-ava" aria-hidden="true">{{ review.reviewerName|slice(0, 2)|upper }}</div>
                <div>
                  <div class="drl-rev-name">{{ review.reviewerName }}</div>
                  <div class="drl-rev-s" aria-label="{{ review.rating }} stars">
                    {% for i in range(1, 5) %}
                      <svg viewBox="0 0 20 20" class="{{ i <= review.rating ? 'text-warning' : 'text-light' }}"><path d="{{ starPath }}"/></svg>
                    {% endfor %}
                  </div>
                </div>
                <div class="drl-rev-tag">Avis client</div>
              </div>
              <p class="drl-rev-text">
                {{ review.comment|nl2br }}
              </p>
              <div class="drl-rev-date">{{ review.createdAt|date('F d, Y') }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {# Project Gallery #}
      {% if professional.projets|length > 0 %}
      <div class="drl-s-card drl-fade d4">
        <div class="drl-s-head">
          <div class="drl-s-title">
            <span class="drl-s-title-dot"></span>
            Project Gallery
            <span class="drl-count-badge">({{ professional.projets|length }})</span>
          </div>
          <span class="drl-s-link">View all projects →</span>
        </div>
        <div class="drl-s-body">
          <div class="drl-gallery-grid">
            {% for project in professional.projets %}
              <div class="drl-gal-item" data-bs-toggle="modal" data-bs-target="#projectModal{{ project.id }}" role="button" tabindex="0" aria-haspopup="dialog" aria-label="{{ project.name }}">
                <img src="{{ project.mainPhoto ? asset('uploads/projects/' ~ project.mainPhoto) : asset('assets/drilleedo/images/event/grid-type-01.jpg') }}" alt="{{ project.name }}" loading="lazy">
                <div class="drl-gal-lbl">{{ project.name }}</div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
      {% endif %}
    </div>{# /left-col #}

    {# ── RIGHT SIDEBAR ── #}
    <div class="drl-right-col">
      <div class="drl-sidebar-sticky">

        {# Devis card #}
        <div class="drl-devis-card drl-fade d2">
          <div class="drl-devis-header">
            <h3>{{ 'public_profile.request_quote'|trans }}</h3>
            <p>{{ 'public_profile.guaranteed_response'|trans }}</p>
          </div>
          <div class="drl-devis-body">
            <button class="drl-btn-devis"
                    type="button"
                    data-bs-toggle="modal"
                    data-bs-target="#contactProModal"
                    aria-haspopup="dialog">
              {{ 'public_profile.get_quote'|trans }}
            </button>
            <div class="drl-hours-title">{{ 'public_stats.opening_hours'|trans }}</div>
            {% if professional.openingHours and professional.openingHours|length > 0 %}
                {% for hour in professional.openingHours %}
                    {% if ':' in hour %}
                        {% set parts = hour|split(':') %}
                        {% set day   = parts[0]|trim %}
                        {% set time  = parts[1:]|join(':')|trim %}
                        {% set isClosed = (time|lower == 'closed' or time|lower == 'fermé' or time|lower == 'ferme') %}
                        <div class="drl-hour-row">
                            <span class="drl-hour-day">{{ day }}</span>
                            <span class="{{ isClosed ? 'drl-hour-closed' : 'drl-hour-time' }}">{{ time }}</span>
                        </div>
                    {% else %}
                        <div class="drl-hour-row">
                            <span class="drl-hour-day">{{ hour|trim }}</span>
                        </div>
                    {% endif %}
                {% endfor %}
            {% else %}
                <div class="drl-hour-row">
                  <span class="drl-hour-day">{{ 'public_stats.mon_fri'|trans }}</span>
                  <span class="drl-hour-time">08:00 – 18:00</span>
                </div>
                <div class="drl-hour-row">
                  <span class="drl-hour-day">{{ 'public_stats.sat'|trans }}</span>
                  <span class="drl-hour-time">08:00 – 14:00</span>
                </div>
                <div class="drl-hour-row">
                  <span class="drl-hour-day">{{ 'public_stats.sun'|trans }}</span>
                  <span class="drl-hour-closed">{{ 'public_stats.closed'|trans }}</span>
                </div>
            {% endif %}
          </div>
        </div>

        {# Contact Details #}
        <div class="drl-contact-card drl-fade d3">
          <div class="drl-contact-head">📞 {{ 'public_stats.contact_details'|trans }}</div>
          <div class="drl-contact-body">
            <div class="drl-c-item">
              <div class="drl-c-ico">👤</div>
              <div>
                <div class="drl-c-lbl">{{ 'public_profile.company'|trans }}</div>
                <div class="drl-c-val">{{ professional.companyName }}</div>
              </div>
            </div>
            <div class="drl-c-item">
              <div class="drl-c-ico">📍</div>
              <div>
                <div class="drl-c-lbl">City</div>
                <div class="drl-c-val">{{ professional.city ?? 'Montréal' }}, QC</div>
              </div>
            </div>
            {% if professional.phoneNum %}
            <div class="drl-c-item">
              <div class="drl-c-ico">📞</div>
              <div>
                <div class="drl-c-lbl">Phone</div>
                <div class="drl-c-val">
                  <a href="tel:{{ professional.phoneNum }}">{{ professional.phoneNum }}</a>
                </div>
              </div>
            </div>
            {% else %}
            <div class="drl-c-item">
              <div class="drl-c-ico">📞</div>
              <div>
                <div class="drl-c-lbl">Phone</div>
                <div class="drl-c-val">+1 514-555-0000</div>
              </div>
            </div>
            {% endif %}
            <hr class="drl-c-divider">
            <div class="drl-c-item">
              <div class="drl-c-ico">🏗️</div>
              <div>
                <div class="drl-c-lbl">Category</div>
                <div class="drl-c-val">{{ professional.category ? professional.category.name : 'Rénovation' }}</div>
              </div>
            </div>
            <div class="drl-c-item">
              <div class="drl-c-ico">📅</div>
              <div>
                <div class="drl-c-lbl">Experience</div>
                <div class="drl-c-val">{{ professional.expYears ?? '10' }}+ years</div>
              </div>
            </div>
          </div>
        </div>

        {# Advantages #}
        <div class="drl-adv-card drl-fade d3">
          <a class="drl-btn-see-all" role="button" tabindex="0">{{ 'public_profile.our_advantages'|trans }}</a>
          <div class="drl-adv-body">
            {% set hasSpecificAdv = professional.interventionRadius or professional.minPrice or professional.freeQuotes or professional.guaranteedWork or professional.rbqCertified %}
            
            {% if professional.whyChooseUs and professional.whyChooseUs|length > 0 %}
              {% for item in professional.whyChooseUs %}
                <div class="drl-adv-item">
                  <span class="drl-adv-ico">✔</span>
                  <span class="drl-adv-txt">{{ item }}</span>
                </div>
              {% endfor %}
            {% elseif hasSpecificAdv or (professional.stats and professional.stats.avgResponseTime and professional.stats.avgResponseTime < 7200) %}
                {% if professional.interventionRadius %}
                    <div class="drl-adv-item">
                        <span class="drl-adv-ico">📍</span>
                        <span class="drl-adv-txt">Service Zone</span>
                        <span class="drl-adv-val">{{ professional.interventionRadius }} km</span>
                    </div>
                {% endif %}
                {% if professional.stats and professional.stats.avgResponseTime and professional.stats.avgResponseTime < 7200 %}
                    <div class="drl-adv-item">
                        <span class="drl-adv-ico">⚡</span>
                        <span class="drl-adv-txt">Fast Response</span>
                    </div>
                {% endif %}
                {% if professional.minPrice %}
                    <div class="drl-adv-item">
                        <span class="drl-adv-ico">💲</span>
                        <span class="drl-adv-txt">Minimum Price</span>
                        <span class="drl-adv-val">${{ professional.minPrice }}</span>
                    </div>
                {% endif %}
                {% if professional.hasFreeQuotes %}
                    <div class="drl-adv-item">
                        <span class="drl-adv-ico">📄</span>
                        <span class="drl-adv-txt">100% Free Quotes</span>
                    </div>
                {% endif %}
                {% if professional.rbqCertified or professional.hasInsurance %}
                    <div class="drl-adv-item">
                        <span class="drl-adv-ico">🛡️</span>
                        <span class="drl-adv-txt">
                            {% if professional.rbqCertified and professional.hasInsurance %}
                                Insured & certifié RBQ
                            {% elseif professional.rbqCertified %}
                                RBQ Certified
                            {% else %}
                                Fully Insured
                            {% endif %}
                        </span>
                    </div>
                {% endif %}
                {% if professional.hasGuaranteedWork %}
                    <div class="drl-adv-item">
                        <span class="drl-adv-ico">✔</span>
                        <span class="drl-adv-txt">Guaranteed Work</span>
                    </div>
                {% endif %}
            {% else %}{% endif %}
          </div>
        </div>

        {# Zone card #}
        <div class="drl-zone-card drl-fade d4">
          <div class="drl-zone-title">📍 Service Zone: {{ professional.city ?? 'Montréal' }}</div>
          <div class="drl-zone-sub">This professional works in the following areas:</div>
          <div class="drl-zone-chips">
            {% if professional.interventionZone %}
              {% for zone in professional.interventionZone|split(',') %}
                <span class="drl-zone-chip">{{ zone|trim }}</span>
              {% endfor %}
            {% else %}
              <span class="drl-zone-chip">🏙️ {{ professional.city ?? 'Montréal' }}</span>
            {% endif %}
          </div>
        </div>

      </div>{# /sidebar-sticky #}
    </div>{# /right-col #}

  </div>{# /main-layout #}

</div>{# /drl-wrap #}
</div>{# /drl-page #}


{# ══════════════════════════════════════════════════════════════════════════
   MODALS (preserved intact)
══════════════════════════════════════════════════════════════════════════ #}

{# Project modals #}
{% for project in professional.projets %}
<div class="modal fade" id="projectModal{{ project.id }}" tabindex="-1" aria-modal="true" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content drl-modal-content">
      <div class="modal-body p-0">
        <div class="row g-0">
          <div class="col-lg-7">
            <img src="{{ project.mainPhoto
                    ? asset('uploads/projects/' ~ project.mainPhoto)
                    : asset('assets/drilleedo/images/event/grid-type-01.jpg') }}"
                 class="drl-modal-project-img"
                 alt="{{ project.name }}">
          </div>
          <div class="col-lg-5">
            <div class="p-4 drl-modal-scroll-pane">
              <button type="button" class="btn-close float-end" data-bs-dismiss="modal" aria-label="Close"></button>
              <h2 class="drl-modal-title mt-3">{{ project.name }}</h2>
              <div class="mb-3">
                <span class="drl-chip drl-chip-blue drl-modal-badge-sm">
                  Completed Project
                </span>
              </div>
              <div class="drl-modal-desc mb-3">{{ project.description|nl2br }}</div>
              {% if project.gallery %}
                <p class="drl-modal-gallery-title">Gallery</p>
                <div class="row g-2 mb-3">
                  {% for photo in project.gallery %}
                    <div class="col-6">
                      <img src="{{ asset('uploads/projects/' ~ photo) }}"
                           alt="Photo {{ project.name }}"
                           class="drl-modal-gallery-img">
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
              <div class="drl-modal-action-row">
                <button class="drl-btn-submit"
                        type="button"
                        data-bs-dismiss="modal"
                        data-bs-toggle="modal"
                        data-bs-target="#contactProModal">
                  Request a Quote similaire
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endfor %}

{# Reviews modal #}
<div class="modal fade" id="reviewsModal" tabindex="-1" aria-modal="true" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content drl-modal-content">
      <div class="drl-modal-header">
        Customer Reviews
        <button type="button" class="btn-close float-end" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="drl-modal-body">
        <div class="text-center py-3 mb-4">
          <div class="drl-big-num">{{ avg|number_format(1) }}</div>
          <div class="drl-big-stars justify-content-center" aria-hidden="true">
            {% for i in range(1, 5) %}
              <svg viewBox="0 0 20 20" class="{{ i <= avg|round ? 'text-warning' : 'text-light' }}"><path d="{{ starPath }}"/></svg>
            {% endfor %}
          </div>
          <p class="drl-rev-count mt-1">{{ reviewCount }} verified reviews</p>
        </div>
        
        <div class="drl-reviews-list">
          {% if reviewCount > 0 %}
            {% for review in professional.reviews %}
              <div class="drl-review-item border-bottom mb-3 pb-3">
                <div class="drl-rev-head">
                  <div class="drl-rev-ava" aria-hidden="true">{{ review.reviewerName|slice(0, 2)|upper }}</div>
                  <div>
                    <div class="drl-rev-name">{{ review.reviewerName }}</div>
                    <div class="drl-rev-s">
                      {% for i in range(1, 5) %}
                        <svg viewBox="0 0 20 20" class="{{ i <= review.rating ? 'text-warning' : 'text-light' }}"><path d="{{ starPath }}"/></svg>
                      {% endfor %}
                    </div>
                  </div>
                  {% if review.serviceTitle %}
                    <div class="drl-rev-tag">{{ review.serviceTitle }}</div>
                  {% endif %}
                </div>
                <p class="drl-rev-text mt-2 small">
                  {{ review.comment|nl2br }}
                </p>
                <div class="drl-rev-date small text-muted">{{ review.createdAt|date('d F Y') }}</div>
              </div>
            {% endfor %}
          {% else %}
            <p class="text-center text-muted py-4">No reviews yet. Be the first to leave one!</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{# Contact / Devis modal #}
<div class="modal fade" id="contactProModal" tabindex="-1" aria-modal="true" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content drl-modal-content">
      <div class="drl-modal-header">
        Contact {{ professional.companyName }}
        <button type="button" class="btn-close float-end" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="drl-modal-body">
        <p class="drl-modal-intro">
          Send a direct quote request, information, or project consultation.
        </p>
        <div class="drl-modal-form">
          {{ form_start(directRequestForm) }}
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label">Subject of your request</label>
                {{ form_widget(directRequestForm.title) }}
              </div>
              <div class="col-12">
                <label class="form-label">Describe your needs</label>
                {{ form_widget(directRequestForm.description) }}
              </div>
              <div class="col-md-6">
                <label class="form-label">Main service required</label>
                {{ form_widget(directRequestForm.category) }}
              </div>
              <div class="col-md-6">
                <label class="form-label">Attach photos (optional)</label>
                {{ form_widget(directRequestForm.images) }}
              </div>
            </div>
            <div class="mt-3">
              <button type="submit" class="drl-btn-submit">
                Send my request to {{ professional.companyName }}
              </button>
            </div>
          {{ form_end(directRequestForm) }}
        </div>
      </div>
    </div>
  </div>
</div>

{% endblock %}
