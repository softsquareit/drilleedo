          <hr class="pp-c-divider">
          <div class="pp-c-item">
            <div class="pp-c-ico"><i class="feather-briefcase"></i></div>
            <div>
              <div class="pp-c-lbl">Catégorie</div>
              <div class="pp-c-val">{{ professional.category ? professional.category.localizedTitle(app.request.locale) : '—' }}</div>
            </div>
          </div>
          <div class="pp-c-item">
            <div class="pp-c-ico"><i class="feather-calendar"></i></div>
            <div>
              <div class="pp-c-lbl">Expérience</div>
              <div class="pp-c-val">{{ professional.expYears ?? '—' }} ans</div>
            </div>
          </div>
          {% if professional.minPrice %}
          <div class="pp-c-item">
            <div class="pp-c-ico"><i class="feather-dollar-sign"></i></div>
            <div>
              <div class="pp-c-lbl">Prix minimum</div>
              <div class="pp-c-val">À partir de {{ professional.minPrice }}$</div>
            </div>
          </div>
          {% endif %}
        </div>
      </div>

      {# Advantages #}
      {% set hasAdv = professional.interventionRadius or professional.minPrice or professional.freeQuotes or professional.guaranteedWork or professional.rbqCertified or professional.hasInsurance or (professional.whyChooseUs and professional.whyChooseUs|length > 0) %}
      {% if hasAdv %}
