{% extends 'base.html.twig' %}

{% set firstCity    = company.Adresse|length > 0 ? company.Adresse|first.city : 'Canada' %}
{% set firstCatName = company.categories|length > 0 ? company.categories|first.name : 'Services' %}
{% set yearsExp     = company.foundationYear ? ("now"|date("Y") - company.foundationYear) : null %}
{% set projectCount = company.projets|length %}
{% set initials     = company.companyName|split(' ')|map(w => w|slice(0,1))|join('')|upper|slice(0,2) %}
{% set langMap      = {'FR': 'Français', 'EN': 'English', 'ES': 'Español', 'IT': 'Italiano', 'AR': 'العربية', 'PT': 'Português'} %}

{% block title %}{{ company.companyName }} – {{ firstCatName }} à {{ firstCity }} | Drilleedo{% endblock %}
{% block meta_description %}{{ company.about ? company.about|striptags|slice(0,150) : 'Découvrez ' ~ company.companyName ~ ', entreprise spécialisée en ' ~ firstCatName ~ ' à ' ~ firstCity ~ '. Obtenez une soumission gratuite sur Drilleedo.' }}{% endblock %}
{% block meta_keywords %}{{ company.companyName }}, {{ firstCatName }}, {{ firstCity }}, rénovation, entreprise, Drilleedo{% endblock %}
{% block og_title %}{{ company.companyName }} | Drilleedo{% endblock %}
{% block og_description %}{{ firstCatName }} à {{ firstCity }}. Découvrez les projets et demandez une soumission.{% endblock %}
{% block og_type %}profile{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('assets/drilleedo/css/custom/professional_profile.css') }}">
{% endblock %}

{% block structured_data %}
{{ parent() }}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "{{ company.companyName|e('js') }}",
  "image": "{{ company.logo ? absolute_url(asset('uploads/logos/' ~ company.logo)) : '' }}",
  "url": "{{ app.request.uri }}",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "{{ firstCity|e('js') }}",
    "addressRegion": "QC",
    "addressCountry": "CA"
  },
  "description": "{{ company.about ? company.about|striptags|slice(0,200)|e('js') : '' }}"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Accueil",    "item": "{{ url('app_home') }}"},
    {"@type": "ListItem", "position": 2, "name": "Entreprises","item": "{{ url('companies_list') }}"},
    {% if company.categories|length > 0 %}
    {"@type": "ListItem", "position": 3, "name": "{{ company.categories|first.name|e('js') }}", "item": "{{ url('companies_list') }}?category={{ company.categories|first.id }}"},
    {"@type": "ListItem", "position": 4, "name": "{{ company.companyName|e('js') }}"}
    {% else %}
    {"@type": "ListItem", "position": 3, "name": "{{ company.companyName|e('js') }}"}
    {% endif %}
  ]
}
</script>
{% endblock %}

{% block body %}

{% set starPath = 'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z' %}

<div class="pp-page">

{# ══════════════════════════════════════════════════════════════════════════
   HERO BANNER
══════════════════════════════════════════════════════════════════════════ #}
<div class="pp-hero">
  {% if company.banner %}
    <img src="{{ asset('uploads/banners/' ~ company.banner) }}"
         alt="Bannière {{ company.companyName }}"
         class="pp-hero__img">
  {% else %}
    <img src="{{ asset('uploads/banners/companies.png') }}"
         alt="Company banner"
         class="pp-hero__img"
         onerror="this.src='{{ asset('uploads/banners/professionels.png') }}'">
  {% endif %}

  <div class="pp-breadcrumb">
    <div class="pp-wrap">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
          <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="{{ url('app_home') }}" itemprop="item"><span itemprop="name">Accueil</span></a>
            <meta itemprop="position" content="1">
          </li>
          <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="{{ url('companies_list') }}" itemprop="item"><span itemprop="name">Entreprises</span></a>
            <meta itemprop="position" content="2">
          </li>
          {% if company.categories|length > 0 %}
          <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="{{ url('companies_list') }}?category={{ company.categories|first.id }}" itemprop="item">
              <span itemprop="name">{{ company.categories|first.name }}</span>
            </a>
            <meta itemprop="position" content="3">
          </li>
          <li class="breadcrumb-item active" aria-current="page">
            <span>{{ company.companyName }}</span>
          </li>
          {% else %}
          <li class="breadcrumb-item active" aria-current="page">
            <span>{{ company.companyName }}</span>
          </li>
          {% endif %}
        </ol>
      </nav>
    </div>
  </div>

  <div class="pp-hero-stripe"></div>
</div>{# /hero #}

<div class="pp-wrap">

{# ══════════════════════════════════════════════════════════════════════════
   IDENTITY CARD
══════════════════════════════════════════════════════════════════════════ #}
<div class="pp-identity pp-fade d1">

  <div class="pp-id-top">

    {# Avatar #}
    <div class="pp-avatar-wrap">
      <div class="pp-avatar">
        {% if company.logo %}
          <img src="{{ asset('uploads/logos/' ~ company.logo) }}"
               alt="Logo {{ company.companyName }}"
               style="object-fit:contain;padding:4px;">
        {% else %}
          {{ initials }}
        {% endif %}
      </div>
      {% if company.isVerified %}
        <div class="pp-verified-ring" title="Entreprise vérifiée">
          <i class="feather-check" style="font-size:12px;"></i>
        </div>
      {% endif %}
    </div>

    {# Info #}
    <div class="pp-id-info">
      <div class="pp-id-name-row">
        <span class="pp-id-name">{{ company.companyName }}</span>
        {% if company.tradeName and company.tradeName != company.companyName %}
          <span class="pp-fast-badge" style="font-size:11px;">
            <i class="feather-tag"></i> {{ company.tradeName }}
          </span>
        {% endif %}
      </div>

      <div class="pp-id-meta">
        {% if company.categories|length > 0 %}
        <span>
          <i class="feather-briefcase"></i>
          {{ company.categories|map(c => c.name)|join(' · ') }}
        </span>
        {% endif %}
        {% if firstCity != 'Canada' %}
        <span>
          <i class="feather-map-pin"></i>
          {{ firstCity }}, QC
        </span>
        {% endif %}
        {% if yearsExp %}
        <span>
          <i class="feather-award"></i>
          {{ yearsExp }}+ ans d'expérience
        </span>
        {% endif %}
      </div>

      <div class="pp-badges">
        {% if company.isVerified %}
          <span class="pp-chip pp-chip--green"><i class="feather-shield"></i> Vérifiée</span>
        {% endif %}
        {% if company.isTopRated %}
          <span class="pp-chip pp-chip--orange"><i class="feather-star"></i> Top Évaluée</span>
        {% endif %}
        {% if company.hasInsurance %}
          <span class="pp-chip pp-chip--blue"><i class="feather-shield"></i> Assurée</span>
        {% endif %}
        {% if company.rbqCertified %}
          <span class="pp-chip pp-chip--blue"><i class="feather-check-square"></i> Certifiée RBQ</span>
        {% endif %}
        {% if company.freeQuotes %}
          <span class="pp-chip pp-chip--green"><i class="feather-file-text"></i> Devis gratuit</span>
        {% endif %}
        {% if company.guaranteedWork %}
          <span class="pp-chip pp-chip--green"><i class="feather-check-circle"></i> Travaux garantis</span>
        {% endif %}
      </div>
    </div>

    {# CTA #}
    <div class="pp-id-cta">
      <button class="pp-btn-primary"
              type="button"
              data-bs-toggle="modal"
              data-bs-target="#contactCompanyModal"
              aria-haspopup="dialog">
        <i class="feather-send"></i>
        Demander un devis
      </button>
      {% if company.Website %}
      <a href="{{ company.Website }}" target="_blank" rel="noopener noreferrer" class="pp-btn-outline">
        <i class="feather-globe"></i>
        Site Web
      </a>
      {% endif %}
    </div>

  </div>{# /pp-id-top #}

  {# Stats strip #}
  <div class="pp-stats-strip">
    <div class="pp-stat-cell">
      <div class="pp-stat-ico"><i class="feather-briefcase"></i></div>
      <div>
        <div class="pp-stat-lbl">Type</div>
        <div class="pp-stat-val">{{ company.entrepreneurType ? company.entrepreneurType.type : 'Général' }}</div>
      </div>
    </div>
    {% if yearsExp %}
    <div class="pp-stat-cell">
      <div class="pp-stat-ico"><i class="feather-calendar"></i></div>
      <div>
        <div class="pp-stat-lbl">Fondée en</div>
        <div class="pp-stat-val">{{ company.foundationYear }} ({{ yearsExp }} ans)</div>
      </div>
    </div>
    {% endif %}
    {% if company.EmpNum %}
    <div class="pp-stat-cell">
      <div class="pp-stat-ico"><i class="feather-users"></i></div>
      <div>
        <div class="pp-stat-lbl">Employés</div>
        <div class="pp-stat-val">{{ company.EmpNum }}</div>
      </div>
    </div>
    {% endif %}
    <div class="pp-stat-cell">
      <div class="pp-stat-ico"><i class="feather-layers"></i></div>
      <div>
        <div class="pp-stat-lbl">Projets</div>
        <div class="pp-stat-val">
          {% if projectCount > 0 %}{{ projectCount }} projet{{ projectCount > 1 ? 's' : '' }}
          {% else %}—{% endif %}
        </div>
      </div>
    </div>
    {% if company.languages|length > 0 %}
    <div class="pp-stat-cell">
      <div class="pp-stat-ico"><i class="feather-globe"></i></div>
      <div>
        <div class="pp-stat-lbl">Langues</div>
        <div class="pp-stat-val">
          {% for code in company.languages %}{{ langMap[code] ?? code }}{{ not loop.last ? ', ' : '' }}{% endfor %}
        </div>
      </div>
    </div>
    {% endif %}
  </div>

</div>{# /pp-identity #}


{# ══════════════════════════════════════════════════════════════════════════
   MAIN LAYOUT
══════════════════════════════════════════════════════════════════════════ #}
<div class="pp-layout">

  {# ── LEFT COLUMN ── #}
  <div class="pp-left">

    {# About #}
    {% if company.about or company.services|length > 0 %}
    <div class="pp-card pp-fade d2">
      <div class="pp-card-head">
        <div class="pp-card-title"><span class="pp-card-title-bar"></span>À propos de l'entreprise</div>
      </div>
      <div class="pp-card-body">
        {% if company.about %}
          <p class="pp-about-text">{{ company.about|nl2br }}</p>
        {% endif %}
        {% if company.services|length > 0 %}
          <div class="pp-services-grid">
            {% for svc in company.services %}
              {% if svc|trim %}<span class="pp-service-chip"><i class="feather-tool"></i> {{ svc|trim }}</span>{% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
    {% endif %}

    {# Why choose us #}
    {% if company.whyChooseUs and company.whyChooseUs|length > 0 %}
    <div class="pp-card pp-fade d2">
      <div class="pp-card-head">
        <div class="pp-card-title"><span class="pp-card-title-bar"></span>Points forts</div>
      </div>
      <div class="pp-card-body">
        <div class="pp-highlights-grid">
          <div>
            <div class="pp-hl-subtitle"><i class="feather-award"></i> Pourquoi nous choisir</div>
            <ul class="pp-hl-list">
              {% for item in company.whyChooseUs %}
                {% if item|trim %}
                <li class="pp-hl-item">
                  <span class="pp-hl-ico"><i class="feather-check"></i></span>
                  {{ item|trim }}
                </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
          <div>
            <div class="pp-hl-subtitle"><i class="feather-tool"></i> Certifications & Garanties</div>
            <ul class="pp-hl-list">
              {% if company.rbqCertified %}
              <li class="pp-hl-item"><span class="pp-hl-ico"><i class="feather-check-square"></i></span> Certifiée RBQ</li>
              {% endif %}
              {% if company.hasInsurance %}
              <li class="pp-hl-item"><span class="pp-hl-ico"><i class="feather-shield"></i></span> Assurance responsabilité civile</li>
              {% endif %}
              {% if company.guaranteedWork %}
              <li class="pp-hl-item"><span class="pp-hl-ico"><i class="feather-check-circle"></i></span> Travaux garantis</li>
              {% endif %}
              {% if company.freeQuotes %}
              <li class="pp-hl-item"><span class="pp-hl-ico"><i class="feather-file-text"></i></span> Soumissions gratuites</li>
              {% endif %}
            </ul>
          </div>
        </div>
      </div>
    </div>
    {% endif %}

    {# Categories #}
    {% if company.categories|length > 0 %}
    <div class="pp-card pp-fade d3">
      <div class="pp-card-head">
        <div class="pp-card-title"><span class="pp-card-title-bar"></span>Catégories de services</div>
      </div>
      <div class="pp-card-body">
        <div class="pp-services-grid">
          {% for cat in company.categories %}
            <span class="pp-service-chip"><i class="feather-grid"></i> {{ cat.name }}</span>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}

    {# Project overview 2×2 #}
    {% if projectCount > 0 %}
    <div class="pp-card pp-fade d3">
      <div class="pp-card-head">
        <div class="pp-card-title"><span class="pp-card-title-bar"></span>Aperçu des projets</div>
        <span class="pp-card-link">{{ projectCount }} projet{{ projectCount > 1 ? 's' : '' }}</span>
      </div>
      <div class="pp-card-body">
        <div class="pp-project-grid">
          {% for project in company.projets|slice(0, 4) %}
            <div class="pp-project-item"
                 data-bs-toggle="modal"
                 data-bs-target="#projectModal{{ project.id }}"
                 role="button" tabindex="0"
                 aria-haspopup="dialog"
                 aria-label="{{ project.name }}">
              <img src="{{ project.mainPhoto
                       ? asset('uploads/projects/' ~ project.mainPhoto)
                       : asset('assets/drilleedo/images/event/grid-type-01.jpg') }}"
                   alt="{{ project.name }}" loading="lazy">
              <div class="pp-project-caption">
                <i class="feather-layers" style="font-size:11px;margin-right:4px;"></i>
                {{ project.name }}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}

    {# Full gallery #}
    {% if projectCount > 4 %}
    <div class="pp-card pp-fade d4">
      <div class="pp-card-head">
        <div class="pp-card-title"><span class="pp-card-title-bar"></span>Portfolio complet</div>
      </div>
      <div class="pp-card-body">
        <div class="pp-gallery-grid">
          {% for project in company.projets %}
            {% if project.state %}
            <div class="pp-gal-item"
                 data-bs-toggle="modal"
                 data-bs-target="#projectModal{{ project.id }}"
                 role="button" tabindex="0"
                 aria-label="{{ project.name }}">
              <img src="{{ project.mainPhoto
                       ? asset('uploads/projects/' ~ project.mainPhoto)
                       : asset('assets/drilleedo/images/event/grid-type-01.jpg') }}"
                   alt="{{ project.name }}" loading="lazy">
              <div class="pp-gal-lbl">{{ project.name }}</div>
            </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}

    {# Social links #}
    {% if company.links|length > 0 %}
    <div class="pp-card pp-fade d4">
      <div class="pp-card-head">
        <div class="pp-card-title"><span class="pp-card-title-bar"></span>Réseaux sociaux</div>
      </div>
      <div class="pp-card-body">
        <div class="d-flex flex-wrap gap-2">
          {% for lnk in company.links %}
            {% set ico = lnk.type|lower %}
            <a href="{{ lnk.link }}" target="_blank" rel="noopener noreferrer"
               class="pp-service-chip text-decoration-none" style="cursor:pointer;">
              {% if 'facebook' in ico %}<i class="feather-facebook"></i>
              {% elseif 'instagram' in ico %}<i class="feather-instagram"></i>
              {% elseif 'linkedin' in ico %}<i class="feather-linkedin"></i>
              {% elseif 'youtube' in ico %}<i class="feather-youtube"></i>
              {% elseif 'twitter' in ico or 'x' in ico %}<i class="feather-twitter"></i>
              {% else %}<i class="feather-link"></i>{% endif %}
              {{ lnk.type|capitalize }}
            </a>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}

  </div>{# /pp-left #}

  {# ── RIGHT SIDEBAR ── #}
  <div class="pp-right">
    <div class="pp-sidebar-sticky">

      {# Quote CTA card #}
      <div class="pp-quote-card pp-fade d2">
        <div class="pp-quote-head">
          <h3><i class="feather-clipboard" style="margin-right:8px;"></i>Demander un devis</h3>
          <p>Réponse garantie sous 24h</p>
        </div>
        <div class="pp-quote-body">
          <button class="pp-btn-cta-full"
                  type="button"
                  data-bs-toggle="modal"
                  data-bs-target="#contactCompanyModal"
                  aria-haspopup="dialog">
            <i class="feather-send"></i> Envoyer ma demande
          </button>

          {% if company.openingHours and company.openingHours|length > 0 %}
          <div class="pp-hours-title"><i class="feather-clock"></i> Horaires d'ouverture</div>
          {% for hour in company.openingHours %}
            {% if ':' in hour %}
              {% set parts = hour|split(':') %}
              {% set day   = parts[0]|trim %}
              {% set time  = parts[1:]|join(':')|trim %}
              {% set isClosed = (time|lower == 'closed' or time|lower == 'fermé' or time|lower == 'ferme') %}
              <div class="pp-hour-row">
                <span class="pp-hour-day">{{ day }}</span>
                <span class="{{ isClosed ? 'pp-hour-closed' : 'pp-hour-time' }}">{{ time }}</span>
              </div>
            {% else %}
              <div class="pp-hour-row"><span class="pp-hour-day">{{ hour|trim }}</span></div>
            {% endif %}
          {% endfor %}
          {% endif %}
        </div>
      </div>

      {# Contact details #}
      <div class="pp-contact-card pp-fade d3">
        <div class="pp-contact-head"><i class="feather-phone"></i> Coordonnées</div>
        <div class="pp-contact-body">

          <div class="pp-c-item">
            <div class="pp-c-ico"><i class="feather-home"></i></div>
            <div>
              <div class="pp-c-lbl">Entreprise</div>
              <div class="pp-c-val">{{ company.companyName }}</div>
            </div>
          </div>

          {% if company.Adresse|length > 0 %}
            {% for addr in company.Adresse %}
            <div class="pp-c-item">
              <div class="pp-c-ico"><i class="feather-map-pin"></i></div>
              <div>
                <div class="pp-c-lbl">{{ loop.first ? 'Siège social' : 'Succursale' }}</div>
                <div class="pp-c-val">{{ addr.city }}{% if addr.postalCode %}, {{ addr.postalCode }}{% endif %}</div>
                {% if addr.street %}<div style="font-size:11px;color:#94a3b8;">{{ addr.street }}</div>{% endif %}
              </div>
            </div>
            {% endfor %}
          {% endif %}

          {% if company.primaryContact %}
          <div class="pp-c-item">
            <div class="pp-c-ico"><i class="feather-user"></i></div>
            <div>
              <div class="pp-c-lbl">Contact</div>
              <div class="pp-c-val">{{ company.primaryContact.firstName }} {{ company.primaryContact.lastName }}</div>
              {% if company.primaryContact.phone %}
                <div><a href="tel:{{ company.primaryContact.phone }}" style="color:var(--pp-blue);font-weight:600;font-size:13px;">{{ company.primaryContact.phone }}</a></div>
              {% endif %}
            </div>
          </div>
          {% endif %}

          {% if company.Website %}
          <hr class="pp-c-divider">
          <div class="pp-c-item">
            <div class="pp-c-ico"><i class="feather-globe"></i></div>
            <div>
              <div class="pp-c-lbl">Site Web</div>
              <div class="pp-c-val"><a href="{{ company.Website }}" target="_blank" rel="noopener" style="font-size:12px;">{{ company.Website|replace({'https://': '', 'http://': ''}) }}</a></div>
            </div>
          </div>
          {% endif %}

          {% if company.interventionRadius %}
          <div class="pp-c-item">
            <div class="pp-c-ico"><i class="feather-navigation"></i></div>
            <div>
              <div class="pp-c-lbl">Rayon d'intervention</div>
              <div class="pp-c-val">{{ company.interventionRadius }} km</div>
            </div>
          </div>
          {% endif %}

        </div>
      </div>

      {# Service zones #}
      {% if company.interventionZone or company.Adresse|length > 0 %}
      <div class="pp-zone-card pp-fade d3">
        <div class="pp-zone-title"><i class="feather-map"></i> Zones desservies</div>
        <div class="pp-zone-sub">Cette entreprise intervient dans les zones suivantes :</div>
        <div class="pp-zone-chips">
          {% if company.interventionZone %}
            {% for zone in company.interventionZone|split(',') %}
              {% if zone|trim %}<span class="pp-zone-chip"><i class="feather-map-pin"></i> {{ zone|trim }}</span>{% endif %}
            {% endfor %}
          {% else %}
            {% for addr in company.Adresse %}
              <span class="pp-zone-chip"><i class="feather-map-pin"></i> {{ addr.city }}</span>
            {% endfor %}
          {% endif %}
          {% if company.interventionRadius %}
            <span class="pp-zone-chip"><i class="feather-navigation"></i> {{ company.interventionRadius }} km</span>
          {% endif %}
        </div>
      </div>
      {% endif %}

      {# Payment methods #}
      {% if company.paymentMethod|length > 0 %}
      <div class="pp-adv-card pp-fade d4">
        <div class="pp-adv-head"><i class="feather-credit-card"></i> Modes de paiement</div>
        <div class="pp-adv-list">
          {% for payment in company.paymentMethod %}
          <div class="pp-adv-item">
            <div class="pp-adv-ico"><i class="feather-check"></i></div>
            <span class="pp-adv-txt">{{ payment.name }}</span>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

    </div>
  </div>{# /pp-right #}

</div>{# /pp-layout #}

</div>{# /pp-wrap #}
</div>{# /pp-page #}


{# ══════════════════════════════════════════════════════════════════════════
   MODALS — Projects
══════════════════════════════════════════════════════════════════════════ #}
{% for project in company.projets %}
{% if project.state %}
<div class="modal fade pp-modal" id="projectModal{{ project.id }}" tabindex="-1" aria-modal="true" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body p-0">
        <div class="row g-0">
          <div class="col-lg-7">
            <img src="{{ project.mainPhoto
                    ? asset('uploads/projects/' ~ project.mainPhoto)
                    : asset('assets/drilleedo/images/event/grid-type-01.jpg') }}"
                 class="pp-modal-project-img"
                 alt="{{ project.name }}">
          </div>
          <div class="col-lg-5">
            <div class="pp-modal-scroll">
              <div class="d-flex align-items-start justify-content-between mb-3">
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Fermer"></button>
              </div>
              <div class="pp-modal-title mb-3">{{ project.name }}</div>
              <div class="mb-3 d-flex flex-wrap gap-2">
                {% if project.startDate %}
                  <span class="pp-chip pp-chip--blue" style="font-size:12px;">
                    {{ project.startDate|date('M Y') }}{% if project.EndDate %} – {{ project.EndDate|date('M Y') }}{% endif %}
                  </span>
                {% endif %}
                <span class="pp-chip pp-chip--green" style="font-size:12px;">
                  <i class="feather-check-circle"></i> Publié
                </span>
              </div>
              {% if project.description %}
                <div class="pp-modal-desc mb-4">{{ project.description|nl2br }}</div>
              {% endif %}
              {% if project.gallery %}
                <p style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:#94a3b8;margin-bottom:8px;">Galerie</p>
                <div class="row g-2 mb-4">
                  {% for photo in project.gallery %}
                    <div class="col-6">
                      <img src="{{ asset('uploads/projects/' ~ photo) }}"
                           alt="Photo {{ project.name }}"
                           class="pp-modal-gallery-img">
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
              <button class="pp-btn-submit w-100 justify-content-center"
                      type="button"
                      data-bs-dismiss="modal"
                      data-bs-toggle="modal"
                      data-bs-target="#contactCompanyModal">
                <i class="feather-send"></i> Demander un devis similaire
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endif %}
{% endfor %}


{# ══════════════════════════════════════════════════════════════════════════
   MODAL — Contact / Devis
══════════════════════════════════════════════════════════════════════════ #}
<div class="modal fade pp-modal" id="contactCompanyModal" tabindex="-1" aria-modal="true" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="pp-modal-header d-flex align-items-center justify-content-between">
        Contacter {{ company.companyName }}
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      <div class="pp-modal-body">
        <p class="pp-modal-intro">
          <i class="feather-info" style="color:var(--pp-sky);margin-right:6px;"></i>
          Envoyez une demande de devis directement à {{ company.companyName }}.
          Vous recevrez une réponse dans les 24 heures.
        </p>

        <div class="pp-form">
          {{ form_start(contactForm) }}
            <div class="row g-3">

              <div class="col-12">
                <label class="form-label">
                  <i class="feather-edit-3"></i> Sujet de votre demande
                </label>
                {{ form_widget(contactForm.title) }}
                {{ form_errors(contactForm.title) }}
              </div>

              <div class="col-12">
                <label class="form-label">
                  <i class="feather-align-left"></i> Description de vos besoins
                </label>
                {{ form_widget(contactForm.description) }}
                {{ form_errors(contactForm.description) }}
              </div>

              <div class="col-12">
                <label class="form-label">
                  <i class="feather-calendar"></i> Date souhaitée de début
                </label>
                {{ form_widget(contactForm.desiredStartDate) }}
                {{ form_errors(contactForm.desiredStartDate) }}
              </div>

              <div class="col-12">
                <label class="form-label">
                  <i class="feather-clock"></i> Disponibilités pour visite / devis
                </label>
                <div class="pp-chips">
                  {% for child in contactForm.availabilities %}
                    <label class="pp-toggle-chip" id="cc-avail-{{ loop.index }}" for="{{ child.vars.id }}">
                      {{ form_widget(child) }}
                      {% if child.vars.label == 'Matin' %}<i class="feather-sun"></i>
                      {% elseif child.vars.label == 'Après-midi' %}<i class="feather-sunset"></i>
                      {% elseif child.vars.label == 'Week-end' %}<i class="feather-coffee"></i>
                      {% else %}<i class="feather-sliders"></i>{% endif %}
                      {{ child.vars.label }}
                    </label>
                  {% endfor %}
                </div>
                {{ form_errors(contactForm.availabilities) }}
              </div>

              <div class="col-12">
                <label class="form-label">
                  <i class="feather-alert-circle"></i> Intervention urgente ?
                </label>
                <div class="pp-chips">
                  {% for child in contactForm.urgentIntervention %}
                    <label class="pp-toggle-chip pp-toggle-chip--urgence" id="cc-urg-{{ loop.index }}" for="{{ child.vars.id }}">
                      {{ form_widget(child) }}
                      {% if child.vars.label == 'Oui' %}<i class="feather-zap"></i>
                      {% else %}<i class="feather-minus-circle"></i>{% endif %}
                      {{ child.vars.label }}
                    </label>
                  {% endfor %}
                </div>
                {{ form_errors(contactForm.urgentIntervention) }}
              </div>

              <div class="col-12">
                <label class="form-label">
                  <i class="feather-image"></i> Photos du projet (optionnel)
                </label>
                {{ form_widget(contactForm.images) }}
                {{ form_errors(contactForm.images) }}
              </div>

              <div class="mt-4">
                <button type="submit" class="pp-btn-submit">
                  <i class="feather-send"></i>
                  Envoyer ma demande
                </button>
              </div>
            </div>
          {{ form_widget(contactForm._token) }}
          {{ form_end(contactForm, {'render_rest': false}) }}
        </div>
      </div>
    </div>
  </div>
</div>

{# ══════════════════════════════════════════════════════════════════════════
   MODAL — Confirmation envoi demande
══════════════════════════════════════════════════════════════════════════ #}
<div class="modal fade pp-modal" id="companySuccessModal" tabindex="-1" aria-modal="true" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered" style="max-width:440px;">
    <div class="modal-content" style="border-radius:20px;overflow:hidden;border:none;box-shadow:0 12px 48px rgba(0,73,127,.18);">
      <div class="modal-body p-0">
        <div style="background:linear-gradient(135deg,var(--pp-blue),#0066b8);padding:32px 28px 24px;text-align:center;color:#fff;">
          <div style="width:64px;height:64px;background:rgba(255,255,255,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:28px;">
            <i class="feather-check-circle"></i>
          </div>
          <h3 style="font-size:20px;font-weight:700;margin:0 0 6px;">Demande envoyée !</h3>
          <p style="font-size:14px;opacity:.85;margin:0;">{{ company.companyName }} va vous répondre sous 24h</p>
        </div>
        <div style="padding:24px 28px;text-align:center;">
          <p style="font-size:14px;color:#64748b;line-height:1.6;margin-bottom:20px;">
            Votre demande a bien été transmise.
            Vous recevrez une notification dès qu'une réponse est disponible.
          </p>
          <button type="button"
                  class="pp-btn-primary w-100 justify-content-center"
                  data-bs-dismiss="modal">
            <i class="feather-thumbs-up"></i> Parfait, merci !
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

  function initChips(selector, urgency) {
    urgency = urgency || false;
    document.querySelectorAll(selector).forEach(function (chip) {
      var input = chip.querySelector('input');
      if (!input) return;
      if (input.checked) {
        chip.classList.add(urgency && (input.value === '1' || input.value === 'true') ? 'checked-urgent' : 'checked');
      }
      input.addEventListener('change', function () {
        if (input.type === 'radio') {
          document.querySelectorAll(selector).forEach(function (c) {
            c.classList.remove('checked', 'checked-urgent');
          });
        }
        if (input.checked) {
          chip.classList.add(urgency && (input.value === '1' || input.value === 'true') ? 'checked-urgent' : 'checked');
        } else {
          chip.classList.remove('checked', 'checked-urgent');
        }
      });
      chip.addEventListener('click', function (e) {
        if (e.target.tagName === 'INPUT') return;
        e.preventDefault();
        if (input.type === 'checkbox') {
          input.checked = !input.checked;
          input.dispatchEvent(new Event('change'));
        } else if (input.type === 'radio' && !input.checked) {
          input.checked = true;
          input.dispatchEvent(new Event('change'));
        }
      });
    });
  }

  initChips('#contactCompanyModal .pp-toggle-chip:not(.pp-toggle-chip--urgence)');
  initChips('#contactCompanyModal .pp-toggle-chip--urgence', true);

});
</script>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
  var form = document.querySelector('#contactCompanyModal form');
  if (!form) return;

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    e.stopPropagation();

    var submitBtn = form.querySelector('[type="submit"]');
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Envoi...';
    }

    fetch(window.location.pathname, {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      body: new FormData(form),
    })
    .then(function (res) {
      if (!res.ok && res.status !== 422) throw new Error('server_error');
      return res.json();
    })
    .then(function (json) {
      if (json.success) {
        var contactModalEl = document.getElementById('contactCompanyModal');
        var bsContact = contactModalEl ? bootstrap.Modal.getInstance(contactModalEl) : null;
        if (bsContact) {
          contactModalEl.addEventListener('hidden.bs.modal', function openSuccess() {
            contactModalEl.removeEventListener('hidden.bs.modal', openSuccess);
            var successEl = document.getElementById('companySuccessModal');
            if (successEl) new bootstrap.Modal(successEl, { backdrop: 'static' }).show();
          }, { once: true });
          bsContact.hide();
        } else {
          var successEl = document.getElementById('companySuccessModal');
          if (successEl) new bootstrap.Modal(successEl, { backdrop: 'static' }).show();
        }
        form.reset();
        form.querySelectorAll('.pp-toggle-chip').forEach(function (c) {
          c.classList.remove('checked', 'checked-urgent');
        });
      } else if (json.error === 'not_logged_in') {
        alert('Vous devez être connecté en tant que particulier pour envoyer une demande.');
      } else if (json.errors && json.errors.length) {
        alert(json.errors.join('\n'));
      }
    })
    .catch(function () {
      alert('Une erreur est survenue. Veuillez réessayer.');
    })
    .finally(function () {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="feather-send me-2"></i>Envoyer ma demande';
      }
    });
  });
});
</script>
{% endblock %}
