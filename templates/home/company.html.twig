   {% extends 'base.html.twig' %}

{% set cityName = company.Adresse|first.city|default('Canada') %}
{% block title %}{{ company.companyName|default('Company') }} – {{ company.categories|first.name|default('Services') }} in {{ cityName }} | Drilleedo{% endblock %}
{% block meta_description %}Hire {{ company.companyName|default('a trusted company') }} for {{ company.categories|first.name|default('renovation') }} services in {{ cityName }}. Get a free quote on Drilleedo.{% endblock %}
{% block og_title %}{{ company.companyName|default('Company') }} | Drilleedo{% endblock %}
{% block og_description %}{{ company.categories|first.name|default('Renovation') }} services in {{ cityName }}. View projects and get a free quote.{% endblock %}
{% block og_type %}profile{% endblock %}

{% block structured_data %}
{{ parent() }}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "{{ company.companyName|default('')|e('js') }}",
    "address": {
        "@type": "PostalAddress",
        "addressLocality": "{{ cityName|e('js') }}",
        "addressCountry": "CA"
    }
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": "{{ url('app_home') }}"},
        {"@type": "ListItem", "position": 2, "name": "Companies", "item": "{{ url('companies_list') }}"},
        {"@type": "ListItem", "position": 3, "name": "{{ company.companyName|default('Company')|e('js') }}"}
    ]
}
</script>
{% endblock %}

{% block body %}

    <!-- Menus are handled by base.html.twig -->

<!-- Start breadcrumb Area -->
    <div class="rbt-page-banner-wrapper">
        <!-- Start Banner BG Image  -->
        <div class="rbt-banner-image" style="background-image: url('{{ asset('uploads/banners/companies.png') }}');"></div>
        <!-- End Banner BG Image  -->

    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                 <div class="content text-start">
                    <ul class="page-list">
                        <li class="rbt-breadcrumb-item"><a href="{{ path('app_home') }}">Home</a></li>
                        <li>
                            <div class="icon-right"><i class="feather-chevron-right"></i></div>
                        </li>
                        <li class="rbt-breadcrumb-item active">Renovation Services</li>
                    </ul>
                    <h1 class="title">
                        <span class="theme-gradient">{{ company.companyName }}</span>
                    </h1>

                    <h2 class="title">
                        {{ company.categories|map(c => c.name)|join(', ') ?: 'Company Services' }}
                    </h2>


                    <div class="d-flex align-items-center mb--20 flex-wrap rbt-course-details-feature">

                        <div class="feature-sin best-seller-badge">
                            <span class="rbt-badge-2">
                                <span class="image d-inline-flex align-items-center justify-content-center" style="width:24px;height:24px;background:#f0fdf4;border-radius:50%;">
                                    <i class="fas fa-award" style="color:#10b981;font-size:13px;"></i>
                                </span>
                                Top Rated
                            </span>
                        </div>

                        <div class="feature-sin rating">
                            <a href="#">4.8</a>
                            <a href="#"><i class="fa fa-star"></i></a>
                            <a href="#"><i class="fa fa-star"></i></a>
                            <a href="#"><i class="fa fa-star"></i></a>
                            <a href="#"><i class="fa fa-star"></i></a>
                            <a href="#"><i class="fa fa-star"></i></a>
                        </div>

                        <div class="feature-sin total-rating">
                            <a class="rbt-badge-4" href="#">215 verified reviews</a>
                        </div>

                        <div class="feature-sin total-student">
                            <span>616 completed projects</span>
                        </div>

                    </div>

                    <ul class="rbt-meta">
                        <li><i class="feather-map-pin"></i>{{ company.Adresse|first.city|default('Location not specified') }}</li>
                        <li><i class="feather-award"></i>Verified Company</li>
                    </ul>

                </div>

            </div>
        </div>
    </div>
</div>
<!-- End Breadcrumb Area -->

<div class="rbt-course-details-area rbt-section-gap">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-8">
                <div class="course-details-content">

                    {% if company.banner %}
                    <div class="rbt-feature-box rbt-shadow-box thuumbnail">
                        <img class="w-100" src="{{ asset('uploads/banners/' ~ company.banner) }}" alt="Company Work">
                    </div>
                    {% endif %}

                    <!-- Company Overview -->
                    <div class="rbt-feature-box rbt-shadow-box mt--60">
                        <div class="row g-5">
                            <div class="col-lg-12">
                                <div class="section-title">
                                    <h4 class="title mb--0">Company Overview</h4>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <ul class="rbt-list-style-1">
                                    <li><i class="feather-check"></i>Over {{ company.foundationYear ? ("now"|date("Y") - company.foundationYear) : 5 }} years of industry experience</li>
                                    <li><i class="feather-check"></i>Certified and fully insured</li>
                                    <li><i class="feather-check"></i>Residential renovation specialist</li>
                                    <li><i class="feather-check"></i>High-quality materials and finishes</li>
                                </ul>
                            </div>

                            <div class="col-lg-6">
                                <ul class="rbt-list-style-1">
                                    <li><i class="feather-check"></i>Free project estimates</li>
                                    <li><i class="feather-check"></i>Clear pricing and timelines</li>
                                    <li><i class="feather-check"></i>Strong client satisfaction record</li>
                                    <li><i class="feather-check"></i>Local expertise and support</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- About -->
                    <div class="rbt-feature-box rbt-shadow-box mt--60">
                        <div class="row g-5">
                            <div class="col-lg-12">
                                <div class="section-title">
                                    <h4 class="title mb--20">About the Company</h4>
                                </div>
                                {% if company.about %}
                                    <p>{{ company.about|nl2br }}</p>
                                {% else %}
                                    <p>
                                        {{ company.companyName }} is a trusted specialist known for delivering
                                        reliable, high-quality results. Their work ranges from small upgrades to full
                                        projects, always focusing on precision and durability.
                                    </p>
                                    <p>With a strong commitment to communication and transparency, the team ensures
                                        every project meets client expectations from start to finish.
                                    </p>
                                {% endif %}
                            </div>

                            <div class="col-lg-6">
                                <div class="section-title">
                                    <h4 class="title mb--20">Services Offered</h4>
                                </div>
                                <ul class="rbt-list-style-1">
                                    {% if company.categories|length > 0 %}
                                        {% for cat in company.categories %}
                                            <li><i class="feather-check"></i>{{ cat.name }}</li>
                                        {% endfor %}
                                    {% else %}
                                        <li><i class="feather-check"></i>Home renovation &amp; remodeling</li>
                                        <li><i class="feather-check"></i>Kitchen and bathroom upgrades</li>
                                        <li><i class="feather-check"></i>Flooring, painting, and finishing</li>
                                        <li><i class="feather-check"></i>Custom renovation solutions</li>
                                    {% endif %}
                                </ul>
                            </div>

                            {% if company.website or company.empNum %}
                            <div class="col-lg-6">
                                <ul class="rbt-list-style-1">
                                    {% if company.website %}
                                        <li><i class="feather-globe"></i><a href="{{ company.website }}" target="_blank" rel="noopener">{{ company.website }}</a></li>
                                    {% endif %}
                                    {% if company.empNum %}
                                        <li><i class="feather-users"></i>{{ company.empNum }} employees</li>
                                    {% endif %}
                                </ul>
                            </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- FAQ -->
                    <div class="course-content rbt-shadow-box mt--60">
                        <div class="section-title">
                            <h4 class="title mb--0">Frequently Asked Questions</h4>
                        </div>

                        <div class="rbt-accordion-style rbt-accordion-02 accordion mt--45">
                            <div class="accordion" id="accordionExampleb2">

                                <div class="accordion-item card">
                                    <h2 class="accordion-header card-header">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                                            How can I request a quote?
                                        </button>
                                    </h2>
                                    <div id="collapseOne" class="accordion-collapse collapse show">
                                        <div class="accordion-body card-body">
                                            <p>
                                                You can request a quote by contacting directly through the platform and
                                                providing basic project details.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item card">
                                    <h2 class="accordion-header card-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                                            What type of projects do you handle?
                                        </button>
                                    </h2>
                                    <div id="collapseTwo" class="accordion-collapse collapse">
                                        <div class="accordion-body card-body">
                                            <p>
                                                Projects range from minor renovations to full residential remodeling.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item card">
                                    <h2 class="accordion-header card-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree">
                                            Are you licensed and insured?
                                        </button>
                                    </h2>
                                    <div id="collapseThree" class="accordion-collapse collapse">
                                        <div class="accordion-body card-body">
                                            <p>
                                                Yes, all work is completed under valid certifications and insurance.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- Portfolio Gallery -->
                    <div class="related-course mt--60">
                        <div class="row">
                            <div class="col-lg-12 mb--40">
                                <div class="section-title text-start">
                                    <span class="subtitle bg-secondary-opacity">Our Work</span>
                                    <h2 class="title">Portfolio Gallery</h2>
                                </div>
                            </div>
                        </div>

                        <div class="row g-4">
                            {% for project in company.projets %}
                            {% set loopIdx = loop.index %}
                            <div class="col-lg-6 col-md-6 col-sm-6 col-12">
                                <div class="rbt-card event-grid-card variation-01 rbt-hover">
                                    <div class="rbt-card-img">
                                        {% set imgSrc = project.mainPhoto ? asset('uploads/images/' ~ project.mainPhoto) : asset('assets/drilleedo/images/event/grid-type-01.jpg') %}
                                        <a href="#" data-bs-toggle="modal" data-bs-target="#coLightbox{{ loopIdx }}"
                                           aria-label="View project: {{ project.name }}">
                                            <img src="{{ imgSrc }}" alt="{{ project.name }} — portfolio project"
                                                 loading="lazy" style="height:200px; object-fit:cover; width:100%;">
                                            <div class="pro-verified-badge" style="background:rgba(0,0,0,0.55);">
                                                <i class="feather-maximize-2"></i> View Full
                                            </div>
                                        </a>
                                    </div>
                                    <div class="rbt-card-body">
                                        <ul class="rbt-meta">
                                            <li><i class="feather-map-pin"></i>{{ company.Adresse|first.city|default('Canada') }}</li>
                                            {% if project.startDate and project.endDate %}
                                                <li><i class="feather-clock"></i>{{ project.startDate|date('M Y') }} – {{ project.endDate|date('M Y') }}</li>
                                            {% endif %}
                                        </ul>
                                        <h4 class="rbt-card-title">{{ project.name }}</h4>
                                    </div>
                                </div>
                            </div>

                            {# Lightbox Modal #}
                            <div class="modal fade" id="coLightbox{{ loopIdx }}" tabindex="-1"
                                 aria-label="{{ project.name }}" aria-hidden="true">
                                <div class="modal-dialog modal-lg modal-dialog-centered">
                                    <div class="modal-content" style="background:#111; border:none;">
                                        <div class="modal-header" style="border:none; padding:12px 16px;">
                                            <h5 class="modal-title" style="color:#fff;">{{ project.name }}</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body p-0">
                                            <img src="{{ imgSrc }}" alt="{{ project.name }}"
                                                 style="width:100%; max-height:70vh; object-fit:contain;">
                                        </div>
                                        {% if project.startDate or project.endDate %}
                                        <div class="modal-footer" style="border:none; padding:10px 16px;">
                                            <small style="color:rgba(255,255,255,0.6);">
                                                {% if project.startDate %}{{ project.startDate|date('M Y') }}{% endif %}
                                                {% if project.endDate %} – {{ project.endDate|date('M Y') }}{% endif %}
                                            </small>
                                        </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            {% else %}
                            <div class="col-12">
                                <p class="text-muted">No projects to display yet.</p>
                            </div>
                            {% endfor %}
                        </div>
                    </div>

                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4 mt_md--60 mt_sm--60">
                <div class="course-sidebar rbt-gradient-border sticky-top rbt-shadow-box course-sidebar-top">
                    <div class="inner">

                        <a class="video-popup-with-text video-popup-wrapper text-center mb--15" href="#">
                            <div class="video-content">
                             {% if company.logo %}
                                    <img class="w-100 rbt-radius" src="{{ asset('uploads/logos/' ~ company.logo) }}" alt="Company Logo">
                                {% else %}
                                    <img  class="w-100 rbt-radius" src="{{ asset('assets/images/client/avatar-02.png') }}" alt="Company Logo">
                                {% endif %}
                                <span class="play-view-text d-block color-white">
                                    <i class="feather-eye"></i> View portfolio preview
                                </span>
                            </div>
                        </a>

                        <div class="content pt--30">
                            <a class="rbt-btn btn-gradient w-100 mb--15 text-center"
                               href="{{ path('individual_quote_new') }}"
                               aria-label="Request a free quote from {{ company.companyName|default('this company') }}">
                                <span class="btn-text">Request a Free Quote</span>
                            </a>

                            <a class="rbt-btn btn-border w-100 text-center"
                               href="{{ path('contact') }}"
                               aria-label="Contact {{ company.companyName|default('this company') }} via Drilleedo">
                                <span class="btn-text">Contact via Drilleedo</span>
                            </a>

                            <ul class="rbt-course-details-list-wrapper mt--30">
                                <li><span>Experience</span><span class="rbt-feature-value">{{ company.foundationYear ? ("now"|date("Y") - company.foundationYear) : 5 }}+ Years</span></li>
                                <li><span>Projects Completed</span><span class="rbt-feature-value">{{ company.projets|length }}</span></li>
                                <li><span>Location</span><span class="rbt-feature-value">{{ company.Adresse|first.city|default('N/A') }}</span></li>
                                <li><span>Category</span><span class="rbt-feature-value">{{ company.categories|first.name|default('N/A') }}</span></li>
                            </ul>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
