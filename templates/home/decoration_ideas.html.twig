{% extends 'base.html.twig' %}

{% block title %}Idées Déco & Design — Inspiration Rénovation | Drilleedo{% endblock %}
{% block meta_description %}Découvrez des idées de rénovation et de décoration inspirantes pour votre maison. Conseils d'experts, tendances et projets réels — Drilleedo Canada.{% endblock %}

{% block body %}
<main id="main-content">

<style>
:root { --B:#00497F; --S:#3FA9F5; --O:#FF8A3D; --D:#0C1825; --M:#4A6073; --L:#E4EBF2; }
.di-hero {
    background: #00497F;
    padding: 80px 0 64px; text-align: center; position: relative; overflow: hidden;
}
.di-hero::before {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 28px 28px; pointer-events: none;
}
.di-hero-inner { position: relative; z-index: 2; max-width: 720px; margin: 0 auto; padding: 0 24px; }
.di-hero-pill {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,138,61,.15); border: 1px solid rgba(255,138,61,.3);
    color: #FF8A3D; font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase;
    padding: 5px 16px; border-radius: 50px; margin-bottom: 20px;
}
.di-hero h1 {
    font-size: clamp(28px, 4vw, 48px); font-weight: 900; color: #fff;
    margin: 0 0 16px; line-height: 1.1; letter-spacing: -.025em;
}
.di-hero h1 span { color: #FF8A3D; }
.di-hero-sub {
    font-size: 17px; color: rgba(255,255,255,.72);
    line-height: 1.75; max-width: 560px; margin: 0 auto 36px;
}
.di-hw { max-width: 1140px; margin: 0 auto; padding: 0 24px; }
.di-coming {
    background: #fff; border-radius: 24px;
    box-shadow: 0 8px 40px rgba(0,73,127,.10);
    padding: 80px 48px; text-align: center;
    border-top: 4px solid var(--O);
    margin: -40px auto 64px; position: relative; z-index: 2;
    max-width: 760px;
}
.di-coming-icon {
    width: 80px; height: 80px; border-radius: 20px;
    background: #FF8A3D;
    display: flex; align-items: center; justify-content: center;
    font-size: 36px; margin: 0 auto 28px;
    box-shadow: 0 8px 24px rgba(255,138,61,.35);
}
.di-coming h2 {
    font-size: clamp(22px,3vw,32px); font-weight: 900; color: var(--D);
    margin: 0 0 16px; letter-spacing: -.02em; line-height: 1.2;
}
.di-coming h2 span { color: var(--O); }
.di-coming-sub {
    font-size: 16px; color: var(--M); line-height: 1.75;
    max-width: 540px; margin: 0 auto 36px;
}
.di-notify-form {
    display: flex; gap: 0; max-width: 460px; margin: 0 auto 16px;
}
.di-notify-input {
    flex: 1; padding: 14px 20px;
    border: 1.5px solid var(--L); border-right: none;
    border-radius: 50px 0 0 50px;
    font-size: 14px; font-family: 'Instrument Sans', system-ui, sans-serif;
    outline: none; color: var(--D);
    transition: border-color .2s;
}
.di-notify-input:focus { border-color: var(--S); }
.di-notify-btn {
    background: var(--O); color: #fff; border: none;
    padding: 14px 24px; border-radius: 0 50px 50px 0;
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-weight: 700; font-size: 14px; cursor: pointer;
    white-space: nowrap; transition: background .2s;
}
.di-notify-btn:hover { background: #e87830; }
.di-hint {
    font-size: 12px; color: rgba(0,0,0,.4);
    display: flex; align-items: center; justify-content: center; gap: 5px;
}
.di-tags { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 32px; }
.di-tag {
    display: inline-flex; align-items: center; gap: 6px;
    background: #F0F4F8; border: 1.5px solid var(--L);
    color: var(--M); font-size: 13px; font-weight: 600;
    padding: 7px 16px; border-radius: 50px;
}
.di-cta-strip {
    background: #00497F;
    border-radius: 20px; padding: 48px 40px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px; flex-wrap: wrap; margin-bottom: 64px;
    box-shadow: 0 8px 36px rgba(0,73,127,.2);
}
.di-cta-strip { position: relative; overflow: hidden; }
.di-cta-strip::before {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 28px 28px; pointer-events: none;
}
.di-cta-strip > * { position: relative; z-index: 1; }
.di-cta-strip h3 { font-size: 22px; font-weight: 900; color: #fff; margin: 0 0 8px; letter-spacing: -.025em; }
.di-cta-strip p { font-size: 15px; color: rgba(255,255,255,.72); margin: 0; line-height: 1.6; }
.di-cta-btn {
    display: inline-flex; align-items: center; gap: 8px;
    background: #FF8A3D; color: #fff; font-weight: 700; font-size: 15px;
    padding: 14px 28px; border-radius: 50px; text-decoration: none;
    box-shadow: 0 4px 18px rgba(255,138,61,.4); transition: all .2s; white-space: nowrap;
}
.di-cta-btn:hover { background: #e87830; transform: translateY(-2px); color: #fff; }
@media (max-width: 600px) {
    .di-coming { padding: 48px 24px; }
    .di-notify-form { flex-direction: column; }
    .di-notify-input { border-radius: 50px; border-right: 1.5px solid var(--L); border-bottom: none; border-radius: 50px 50px 0 0; }
    .di-notify-btn { border-radius: 0 0 50px 50px; }
    .di-cta-strip { flex-direction: column; text-align: center; padding: 36px 24px; }
}
</style>

{# ── Hero ── #}
<section class="di-hero">
    <div class="di-hero-inner">
        <div class="di-hero-pill">
            <i class="feather-image"></i> Idées &amp; Inspiration
        </div>
        <h1>Idées &amp; Inspiration pour<br><span>votre maison</span></h1>
        <p class="di-hero-sub">
            Des conseils d'experts, des tendances et des projets réels — pour vous inspirer et mieux préparer vos travaux.
        </p>
    </div>
</section>

{# ── Main Content ── #}
<div class="di-hw">

    {# ── Coming Soon Card ── #}
    <div class="di-coming">
        <div class="di-coming-icon">💡</div>
        <h2>Des idées <span>qui arrivent</span> bientôt</h2>
        <p class="di-coming-sub">
            Notre section Idées &amp; Design est en cours de création. Des conseils d'experts, des tendances rénovation, des projets réels canadiens et des inspirations pour chaque pièce de votre maison — tout ça arrive très bientôt.
        </p>

        <form class="di-notify-form" action="#" method="post" novalidate>
            <label for="di-email" style="position:absolute;width:1px;height:1px;overflow:hidden;">Votre courriel</label>
            <input type="email" id="di-email" name="ideas_notify_email" class="di-notify-input"
                   placeholder="votre@courriel.ca" required autocomplete="email">
            <button type="submit" class="di-notify-btn">
                Me notifier au lancement
            </button>
        </form>
        <p class="di-hint">
            <i class="feather-lock" style="font-size:12px;"></i>
            Aucun spam. Désabonnement en un clic.
        </p>

        <div class="di-tags">
            <span class="di-tag">🏠 Design d'intérieur</span>
            <span class="di-tag">🍳 Cuisine</span>
            <span class="di-tag">🛁 Salle de bain</span>
            <span class="di-tag">🌿 Paysagement</span>
            <span class="di-tag">🪟 Portes &amp; Fenêtres</span>
            <span class="di-tag">🎨 Peinture</span>
            <span class="di-tag">🛋️ Mobilier</span>
            <span class="di-tag">🔌 Électricité</span>
        </div>
    </div>

    {# ── CTA Strip ── #}
    <div class="di-cta-strip">
        <div>
            <h3>Vous avez déjà un projet en tête ?</h3>
            <p>Publiez-le gratuitement et recevez jusqu'à 5 soumissions de professionnels vérifiés en moins de 24h.</p>
        </div>
        <a href="{{ path('individual_quote_new') }}" class="di-cta-btn">
            <i class="feather-send"></i> Publier mon projet — gratuitement
        </a>
    </div>

</div>

</main>
{% endblock %}
