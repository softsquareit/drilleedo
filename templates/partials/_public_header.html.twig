{# Skip-to-content — first focusable element on page for keyboard users #}
<a href="#main-content" class="skip-to-content">{{ 'skip_to_content'|trans }}</a>

<header class="rbt-header rbt-header-4 rbt-header-4-container-var" role="banner">
    <div class="rbt-sticky-placeholder"></div>
    
    {# Header styles → drilleedo.css (section: Public Header) #}

    <div class="rbt-header-wrapper header-space-betwween shadow-none bg-color-white header-sticky">
        <div class="container">
            <div class="mainbar-row rbt-navigation-start align-items-center">
                {# Logo #}
                <div class="header-left">
                    <div class="logo logo-dark">
                        <a href="{{ path('app_home') }}" aria-label="Drilleedo — Home">
                            <img src="{{ asset('assets/drilleedo/images/logo/logo-black.png') }}" alt="Drilleedo">
                        </a>
                    </div>
                </div>

                {# Desktop Navigation #}
                <div class="rbt-main-navigation d-none d-xl-block">
                    <nav class="mainmenu-nav">
                        <ul class="mainmenu">
                            <li class="has-dropdown has-menu-child-item">
                             <a href="{{ path('app_how_it_works') }}" {% if app.request.attributes.get('_route') in ['app_how_it_works', 'individual_quote_new', 'app_receive_quotes'] %}class="active"{% endif %}>{{ 'nav.how_it_works'|trans }}<i class="feather-chevron-down"></i></a>
                                <ul class="submenu">
                                    <li><a href="{{ path('app_for_professionals') }}">{{ 'nav.submenu_i_am_pro'|trans }}</a></li>
                                    <li><a href="{{ path('app_how_it_works') }}">{{ 'nav.submenu_post_proj'|trans }}</a></li>
                                    <li><a href="{{ path('app_find_a_pro') }}">{{ 'nav.submenu_find_pro'|trans }}</a></li>
                                </ul>
                            </li>

                            <li class="with-megamenu has-menu-child-item position-static">
                                <a href="{{ path('professionals_list') }}" {% if app.request.attributes.get('_route') == 'professionals_list' %}class="active"{% endif %}>{{ 'nav.find_professionals'|trans }} <i class="feather-chevron-down"></i></a>
                                <div class="rbt-megamenu drl-full-width-mega">
                                    <div class="wrapper">
                                        {{ render(controller('App\\Controller\\MenuController::categoryMegaMenu')) }}
                                    </div>
                                </div>
                            </li>

                            <li class="has-dropdown has-menu-child-item">
                                <a href="{{ path('smartideas') }}" {% if app.request.attributes.get('_route') in ['smartideas', 'app_project_photos', 'app_decoration_ideas', 'app_completed_projects'] %}class="active"{% endif %}>{{ 'nav.smart_ideas'|trans }}</a>
                            </li>

                            <li><a href="{{ path('app_about') }}" {% if app.request.attributes.get('_route') == 'app_about' %}class="active"{% endif %}>{{ 'nav.about_us'|trans }}</a></li>
                        </ul>
                    </nav>
                </div>

                


                {# Header Right (Auth + Hamburger) #}
                <div class="header-right">
                    <ul class="quick-access" role="list">
                      
                        {% if app.user %}
                            <li class="access-icon rbt-user-wrapper right-align-dropdown">
                                <a class="rbt-round-btn"
                                   href="#"
                                   aria-haspopup="true"
                                   aria-expanded="false"
                                   aria-label="My account menu">
                                    <i class="feather-user" aria-hidden="true"></i>
                                </a>
                                <div class="rbt-user-menu-list-wrapper" role="menu" aria-label="User menu">
                                    <div class="inner">
                                        <div class="rbt-admin-profile">
                                            <div class="admin-thumbnail">
                                                {% if app.user.logo is defined and app.user.logo %}
                                                    <img src="{{ asset('uploads/logos/' ~ app.user.logo) }}" alt="Your profile picture">
                                                {% else %}
                                                    <img src="{{ asset('assets/drilleedo/images/team/avatar.jpg') }}" alt="Default avatar">
                                                {% endif %}
                                            </div>
                                            <div class="admin-info">
                                                <span class="name">
                                                    {% if app.user.companyName is defined and app.user.companyName %}
                                                        {{ app.user.companyName }}
                                                    {% elseif app.user.personalInfos is defined and app.user.personalInfos %}
                                                        {{ app.user.personalInfos.firstName }}
                                                    {% else %}
                                                        {{ 'auth.my_account'|trans }}
                                                    {% endif %}
                                                </span>
                                                <a class="rbt-btn-link color-primary" href="{{ path('app_logout') }}">{{ 'auth.logout'|trans }}</a>
                                            </div>
                                        </div>
                                        <ul class="user-list-wrapper" role="menu">
                                            <li role="none">
                                                {% if is_granted('ROLE_ADMIN') %}
                                                    <a href="{{ path('admin_dashboard') }}" role="menuitem"><i class="feather-home" aria-hidden="true"></i> <span>{{ 'auth.admin_dashboard'|trans }}</span></a>
                                                {% elseif is_granted('ROLE_COMPANY') %}
                                                    <a href="{{ path('company_dashboard') }}" role="menuitem"><i class="feather-home" aria-hidden="true"></i> <span>{{ 'auth.company_dashboard'|trans }}</span></a>
                                                {% elseif is_granted('ROLE_PROFESSIONAL') %}
                                                    <a href="{{ path('professional_dashboard') }}" role="menuitem"><i class="feather-home" aria-hidden="true"></i> <span>{{ 'auth.pro_dashboard'|trans }}</span></a>
                                                {% elseif is_granted('ROLE_INDIVIDUAL') %}
                                                    <a href="{{ path('individual_dashboard') }}" role="menuitem"><i class="feather-home" aria-hidden="true"></i> <span>{{ 'auth.my_dashboard'|trans }}</span></a>
                                                {% endif %}
                                            </li>
                                        </ul>
                                        <hr class="mt--10 mb--10">
                                        <ul class="user-list-wrapper" role="menu">
                                            <li role="none">
                                                <a href="{{ path('app_logout') }}" role="menuitem">
                                                    <i class="feather-log-out" aria-hidden="true"></i>
                                                    <span>{{ 'auth.logout'|trans }}</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </li>
                        {% else %}
                            <li class="access-icon d-none d-xl-flex">
                                <a class="login-link" href="{{ path('app_login') }}" aria-label="{{ 'auth.login'|trans }}">
                                    <i class="fas fa-user-alt" aria-hidden="true"></i> {{ 'auth.login'|trans }}
                                </a>
                            </li>
                        {% endif %}
                        {# ── Language Switcher (Visible on all screens) ── #}
                        <li class="access-icon d-flex align-items-center" style="gap:4px; margin-right: 10px;">
                            {% set locales = {'fr': '🇫🇷 FR', 'en': '🇬🇧 EN'} %}
                            {% for code, label in locales %}
                                <a href="{{ path('app_change_locale', {locale: code}) }}"
                                   style="font-size:11px;font-weight:800;padding:4px 8px;text-decoration:none;
                                          background:{{ app.request.locale == code ? '#00497F' : 'transparent' }};
                                          color:{{ app.request.locale == code ? '#fff' : '#0C1825' }};
                                          border-radius: 6px; border: 1px solid {{ app.request.locale == code ? '#00497F' : '#E4EBF2' }};
                                          transition:all .2s;"
                                   title="{{ code == 'fr' ? 'Français' : 'English' }}">{{ label }}</a>
                            {% endfor %}
                        </li>
                        <li class="access-icon d-block d-xl-none">
                            <button class="hamberger-button rbt-round-btn" id="drl-menu-toggle" aria-label="Open mobile menu">
                                <i class="feather-menu" aria-hidden="true"></i>
                            </button>
                        </li>
                    </ul>


                </div>
            </div>
        </div>
    </div>

    {# ── Mobile Drawer ── #}
    <div class="drl-mobile-drawer" id="drl-mobile-drawer" role="dialog" aria-modal="true" aria-label="Navigation menu">
        {# Overlay #}
        <div class="drl-drawer-overlay" id="drl-drawer-overlay" tabindex="-1"></div>

        {# Panel #}
        <div class="drl-drawer-panel" role="document">
            <div class="drl-drawer-header">
                <a href="{{ path('app_home') }}" class="logo" aria-label="Drilleedo Home">
                    <img src="{{ asset('assets/drilleedo/images/logo/logo-black.png') }}" alt="Drilleedo">
                </a>
                <button class="drl-drawer-close"
                        id="drl-drawer-close"
                        aria-label="Close navigation menu">
                    <i class="feather-x" aria-hidden="true"></i>
                </button>
            </div>

            <nav class="drl-mobile-nav" aria-label="Mobile navigation">
                <ul role="list">
                    <li>
                        <a href="{{ path('app_how_it_works') }}" {% if app.request.attributes.get('_route') in ['app_how_it_works', 'individual_quote_new', 'app_receive_quotes'] %}aria-current="page"{% endif %}><i class="feather-info" aria-hidden="true"></i> {{ 'nav.how_it_works'|trans }}</a>
                        <ul style="padding-left: 1rem;">
                            <li><a href="{{ path('app_i_am_professional') }}">{{ 'nav.submenu_i_am_pro'|trans }}</a></li>
                            <li><a href="{{ path('app_i_seek_professional') }}">{{ 'nav.submenu_find_pro'|trans }}</a></li>
                            <li><a href="{{ path('app_submit_project') }}">{{ 'nav.submenu_submit_proj'|trans }}</a></li>
                            <li><a href="{{ path('individual_quote_new') }}">{{ 'nav.menu_post_project'|trans }}</a></li>
                            <li><a href="{{ path('professionals_list') }}">{{ 'nav.menu_find_professionals'|trans }}</a></li>
                            <li><a href="{{ path('app_receive_quotes') }}">{{ 'nav.menu_receive_quotes'|trans }}</a></li>
                        </ul>
                    </li>
                    <li><a href="{{ path('professionals_list') }}" {% if app.request.attributes.get('_route') == 'professionals_list' %}aria-current="page"{% endif %}>
                        <i class="feather-users" aria-hidden="true"></i> {{ 'nav.find_professionals'|trans }}
                    </a></li>
                    <li>
                        <a href="{{ path('smartideas') }}" {% if app.request.attributes.get('_route') in ['smartideas', 'app_project_photos', 'app_decoration_ideas', 'app_completed_projects'] %}aria-current="page"{% endif %}>
                            <i class="feather-book-open" aria-hidden="true"></i> {{ 'nav.smart_ideas'|trans }}
                        </a>
                        <ul style="padding-left: 1rem;">
                            <li><a href="{{ path('app_project_photos') }}">{{ 'nav.menu_project_photos'|trans }}</a></li>
                            <li><a href="{{ path('app_decoration_ideas') }}">{{ 'nav.menu_decoration_ideas'|trans }}</a></li>
                            <li><a href="{{ path('app_completed_projects') }}">{{ 'nav.menu_completed_projects'|trans }}</a></li>
                        </ul>
                    </li>
                    <li><a href="{{ path('app_about') }}" {% if app.request.attributes.get('_route') == 'app_about' %}aria-current="page"{% endif %}>
                        <i class="feather-info" aria-hidden="true"></i> {{ 'nav.about_us'|trans }}
                    </a></li>
                    <li>
                        <a href="{{ path('app_for_professionals') }}" {% if app.request.attributes.get('_route') in ['app_for_professionals', 'packages', 'app_register_pro', 'app_grow_business', 'app_how_it_works_pros'] %}aria-current="page"{% endif %}><i class="feather-briefcase" aria-hidden="true"></i> {{ 'nav.for_professionals'|trans }}</a>
                        <ul style="padding-left: 1rem;">
                            <li><a href="{{ path('app_for_professionals') }}">{{ 'nav.why_join'|trans }}</a></li>
                            <li><a href="{{ path('app_register_pro') }}">{{ 'nav.create_profile'|trans }}</a></li>
                            <li><a href="{{ path('app_grow_business') }}">{{ 'nav.grow_business'|trans }}</a></li>
                            <li><a href="{{ path('app_how_it_works_pros') }}">{{ 'nav.how_it_works_pros'|trans }}</a></li>
                        </ul>
                    </li>
                    <li><a href="{{ path('public_blog_list') }}" {% if app.request.attributes.get('_route') == 'public_blog_list' %}aria-current="page"{% endif %}>
                        <i class="feather-file-text" aria-hidden="true"></i> {{ 'nav.blog'|trans }}
                    </a></li>
                </ul>
            </nav>

            <div class="drl-drawer-auth">
                {# ── Mobile Language Switcher ── #}
                <div style="display:flex;gap:8px;margin-bottom:12px;justify-content:center;">
                    {% for code, label in {'fr': '🇫🇷 FR', 'en': '🇬🇧 EN'} %}
                        <a href="{{ path('app_change_locale', {locale: code}) }}"
                           style="font-size:.8rem;font-weight:700;padding:5px 14px;border-radius:20px;text-decoration:none;
                                  background:{{ app.request.locale == code ? '#00497F' : '#f1f5f9' }};
                                  color:{{ app.request.locale == code ? '#fff' : '#4A6073' }};
                                  border:1px solid {{ app.request.locale == code ? '#00497F' : '#E4EBF2' }};">{{ label }}</a>
                    {% endfor %}
                </div>
                {% if app.user %}
                    {% if is_granted('ROLE_PROFESSIONAL') %}
                        <a href="{{ path('professional_dashboard') }}" class="drl-btn-primary-fill">
                            <i class="feather-home" aria-hidden="true"></i> {{ 'auth.my_dashboard'|trans }}
                        </a>
                    {% elseif is_granted('ROLE_INDIVIDUAL') %}
                        <a href="{{ path('individual_dashboard') }}" class="drl-btn-primary-fill">
                            <i class="feather-home" aria-hidden="true"></i> {{ 'auth.my_dashboard'|trans }}
                        </a>
                    {% endif %}
                    <a href="{{ path('app_logout') }}" class="drl-btn-danger-outline">
                        <i class="feather-log-out" aria-hidden="true"></i> {{ 'auth.logout'|trans }}
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="drl-btn-primary-outline">
                        <i class="fas fa-user-alt" aria-hidden="true"></i> {{ 'auth.login'|trans }}
                    </a>
                    <a href="{{ path('app_register') }}" class="drl-btn-primary-fill">
                        <i class="far fa-check-square" aria-hidden="true"></i> {{ 'auth.signup'|trans }}
                    </a>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── Search Overlay ── #}
    <div class="drl-search-overlay" id="drl-search-overlay" role="dialog" aria-modal="true" aria-label="Search Drilleedo">
        <div class="drl-search-header">
            <div class="container">
                <div class="drl-search-input-wrapper">
                    <i class="feather-search search-icon" aria-hidden="true"></i>
                    <input type="text" 
                           id="drl-search-input" 
                           placeholder="{{ 'search.placeholder'|trans }}" 
                           autocomplete="off"
                           aria-label="Search query">
                    <button class="drl-search-close" id="drl-search-close" aria-label="Close search">
                        <i class="feather-x" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="drl-search-body">
            <div class="container">
                <div id="drl-search-results" class="drl-search-results-grid">
                    <div class="drl-search-hint">{{ 'search.hint'|trans }}</div>
                </div>
            </div>
        </div>
    </div>

    <script>
    (function() {
        const toggle   = document.getElementById('drl-menu-toggle');
        const drawer   = document.getElementById('drl-mobile-drawer');
        const overlay  = document.getElementById('drl-drawer-overlay');
        const closeBtn = document.getElementById('drl-drawer-close');

        if (!toggle || !drawer) return;

        const focusableSelectors = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

        function openDrawer() {
            drawer.classList.add('is-open');
            toggle.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
            // Focus first element in drawer
            setTimeout(() => {
                const first = drawer.querySelector(focusableSelectors);
                if (first) first.focus();
            }, 50);
        }

        function closeDrawer() {
            drawer.classList.remove('is-open');
            toggle.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
            toggle.focus(); // Return focus to trigger
        }

        toggle.addEventListener('click', () => {
            drawer.classList.contains('is-open') ? closeDrawer() : openDrawer();
        });

        overlay.addEventListener('click', closeDrawer);
        closeBtn.addEventListener('click', closeDrawer);

        // Keyboard: Escape to close, Tab trap inside drawer
        drawer.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') { closeDrawer(); return; }
            if (e.key !== 'Tab') return;

            const focusables = [...drawer.querySelectorAll(focusableSelectors)];
            const first = focusables[0];
            const last  = focusables[focusables.length - 1];

            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        });

        /* ── Search Functionality ── */
        const sToggle  = document.getElementById('drl-search-toggle');
        const sOverlay = document.getElementById('drl-search-overlay');
        const sClose   = document.getElementById('drl-search-close');
        const sInput   = document.getElementById('drl-search-input');
        const sResults = document.getElementById('drl-search-results');
        
        if (!sToggle || !sOverlay) return;

        function openSearch() {
            sOverlay.classList.add('is-open');
            sToggle.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
            setTimeout(() => sInput.focus(), 100);
        }

        function closeSearch() {
            sOverlay.classList.remove('is-open');
            sToggle.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
            sInput.value = '';
            sResults.innerHTML = '<div class="drl-search-hint">{{ "search.hint"|trans|escape("js") }}</div>';
        }

        sToggle.addEventListener('click', openSearch);
        sClose.addEventListener('click', closeSearch);
        sOverlay.addEventListener('click', (e) => {
            if (e.target === sOverlay) closeSearch();
        });

        // Search logic
        let debounceTimer;
        sInput.addEventListener('input', (e) => {
            const q = e.target.value.trim();
            clearTimeout(debounceTimer);
            
            if (q.length < 2) {
                sResults.innerHTML = '<div class="drl-search-hint">{{ "search.hint"|trans|escape("js") }}</div>';
                return;
            }

            debounceTimer = setTimeout(() => {
                fetch(`{{ path('api_search') }}?q=${encodeURIComponent(q)}`)
                    .then(res => res.json())
                    .then(data => {
                        if (data.length === 0) {
                            sResults.innerHTML = '<div class="drl-search-hint">{{ "search.no_results"|trans|escape("js") }} "' + q + '"</div>';
                            return;
                        }
                        
                        sResults.innerHTML = data.map(item => `
                            <a href="${item.url}" class="drl-search-result-item">
                                ${item.logo 
                                    ? `<img src="${item.logo}" alt="${item.label} logo" class="drl-search-result-logo">`
                                    : `<div class="drl-search-result-logo-placeholder"><i class="feather-user"></i></div>`
                                }
                                <div class="drl-search-result-info">
                                    <div class="drl-search-result-name">${item.label}</div>
                                    <div class="drl-search-result-meta">${item.category} ${item.city ? '• ' + item.city : ''}</div>
                                </div>
                                <span class="drl-search-type-badge ${item.type}">${item.type === 'pro' ? 'Pro' : 'Company'}</span>
                            </a>
                        `).join('');
                    });
            }, 300);
        });

        // Global hotkey: Cmd/Ctrl + K to search
        window.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                e.preventDefault();
                openSearch();
            }
            if (e.key === 'Escape' && sOverlay.classList.contains('is-open')) {
                closeSearch();
            }
        });
        /* ── User Dropdown Toggle ── */
        const userWrapper = document.querySelector('.rbt-user-wrapper');
        const userBtn     = userWrapper ? userWrapper.querySelector('.rbt-round-btn') : null;
        
        if (userWrapper && userBtn) {
            userBtn.addEventListener('click', (e) => {
                e.preventDefault();
                userWrapper.classList.toggle('active');
            });

            // Close when clicking outside
            document.addEventListener('click', (e) => {
                if (!userWrapper.contains(e.target)) {
                    userWrapper.classList.remove('active');
                }
            });
        }
    })();
    </script>
    
    <style>
        /* Ensure the dropdown is visible when 'active' class is present (for mobile/click) */
        /* Bouton "Sign in as a professional" — style référence */
        .drl-header-pro-btn {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 9px 16px; border-radius: 8px;
            border: 2px solid #00497F; color: #00497F;
            font-family: 'Instrument Sans', system-ui, sans-serif;
            font-weight: 700; font-size: 13px; line-height: 1;
            text-decoration: none; white-space: nowrap;
            transition: all .2s ease;
        }
        .drl-header-pro-btn:hover { background: #00497F; color: #fff; }
        .drl-header-pro-btn i { font-size: 14px; }

        .rbt-user-wrapper.active .rbt-user-menu-list-wrapper {
            visibility: visible !important;
            opacity: 1 !important;
            clip: rect(0px, 100vw, 200vh, -30px) !important;
            top: 100% !important;
        }
        
        /* Full-width mega menu overrides */
        .rbt-megamenu.drl-full-width-mega {
            width: 1140px !important;
            left: 50% !important;
            transform: translateX(-50%) !important;
            padding: 0 !important;
            border-radius: 0 0 20px 20px !important;
            box-shadow: 0 20px 40px rgba(0,0,0,0.12) !important;
            border: 1px solid #e2e8f0 !important;
            border-top: 3px solid var(--drl-blue) !important;
        }

        .rbt-megamenu.drl-full-width-mega .wrapper {
            padding: 0 !important;
        }

        /* Fix for layout overlap on small viewports */
        @media only screen and (max-width: 1199px) {
            .rbt-section-overlayping-top {
                margin-top: 0 !important;
            }
            .rbt-page-banner-wrapper {
                min-height: 200px !important;
            }
        }
    </style>
</header>
