{#
   Expected variables:
   - pro: Professional entity object
#}

<div class="hp-pro-card">

    {# Photo + badge rating absolu coin haut-droit #}
    <div class="hp-pro-card-img">
        <a href="{{ path('professional_details', {'id': pro.id, 'slug': pro.displayName|trim|lower|replace({' ': '-'})}) }}">
            <img src="{{ pro.banner ? asset('uploads/banners/' ~ pro.banner) : asset('assets/drilleedo/images/team/plumber.png') }}"
                 alt="{{ pro.displayName }} — Drilleedo pro"
                 loading="lazy">
        </a>
        <div class="hp-pro-card-rating">
            <span class="hp-star-icon">&#9733;</span>{{ (pro.stats ? pro.stats.averageRating : 4.5)|number_format(1) }}
        </div>
    </div>

    <div class="hp-pro-card-body">

        <div class="hp-pro-card-header">
            <h3 class="hp-pro-card-title">
                <a href="{{ path('professional_details', {'id': pro.id, 'slug': pro.displayName|trim|lower|replace({' ': '-'})}) }}">
                    {{ pro.category ? pro.category.localizedTitle(app.request.locale) : 'Plumber' }}
                </a>
            </h3>
        </div>

        <div class="hp-pro-card-sub">
            {{ pro.displayName }}
        </div>

        <div class="hp-pro-card-foot">
            <a href="{{ path('individual_direct_request_new', {'type': 'professional', 'id': pro.id}) }}" class="hp-pro-btn-contact">
                <span class="hp-btn-icon-circle"><img src="{{ asset('icons/Messages.svg') }}" style="width:14px;height:14px;filter:brightness(0) invert(1);" alt=""></span>
                Demander un devis
            </a>

            <span class="hp-pro-tag">
                {{ pro.minPrice ?? '15' }}$
            </span>

            <a href="{{ path('professional_details', {'id': pro.id, 'slug': pro.displayName|trim|lower|replace({' ': '-'})}) }}" class="hp-pro-btn-view" title="Voir le profil">
                <i class="feather-list"></i>
            </a>
        </div>
    </div>
</div>
