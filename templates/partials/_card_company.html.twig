{# 
   Expected variables:
   - pro: Company entity object (aliased as 'pro' for compatibility with shared logic)
#}

{% set rating = 5.0 %}
{% set reviewCount = 0 %}
{% set profileUrl = path('company_details', {'id': pro.id, 'slug': pro.displayName|trim|lower|replace({' ': '-'})}) %}

{% set mainCategory = pro.categories|first %}
<div class="fp-pro-card pro-card-item" data-category="{{ mainCategory ? mainCategory.id : '' }}">
    {% if pro.isTopRated %}
    <div class="fp-badge-top" aria-label="Top rated company">
        ⭐ Top Rated
    </div>
    {% endif %}

    <!-- Image Area -->
    <div class="fp-card-img-wrap">
        <a href="{{ profileUrl }}" tabindex="-1" aria-hidden="true">
            <img src="{{ pro.banner ? asset('uploads/banners/' ~ pro.banner) : asset('assets/drilleedo/images/team/plumber.png') }}"
                 alt="{{ pro.displayName }} — verified renovation company on Drilleedo"
                 loading="lazy">
        </a>
        <div class="fp-card-avatar" aria-hidden="true">
            {% if pro.logo %}
                <img src="{{ asset('uploads/logos/' ~ pro.logo) }}" alt="{{ pro.displayName }} logo">
            {% else %}
                {{ pro.displayName|slice(0,2)|upper }}
            {% endif %}
        </div>
    </div>

    <!-- Body Area -->
    <div class="fp-card-body">
        
        {# Verified Status #}
        <div class="fp-card-verified">
            <i class="fas fa-check-circle" aria-hidden="true"></i> Verified Company
        </div>

        {# Title #}
        <h3 class="fp-card-name">
            <a href="{{ profileUrl }}">
                {{ pro.displayName }}
            </a>
        </h3>

        {# Details List #}
        <div class="fp-card-meta">
            <span>
                <i class="feather-briefcase"></i>
                {{ mainCategory ? mainCategory.name : 'Renovation Company' }}
            </span>
            <span>
                <i class="feather-map-pin"></i>
                {{ pro.city ?? 'Canada' }}
            </span>
        </div>

        {# Ratings #}
        <div class="fp-card-rating">
            <div class="fp-stars" aria-label="Rating 5.0">
                {% for i in 1..5 %}
                <svg viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                {% endfor %}
            </div>
            <span class="fp-card-rating__num">5.0</span>
            <span class="fp-card-rating__cnt">(Local Expert)</span>
        </div>

        {# Action Buttons #}
        <div class="fp-card-actions">
            <a href="{{ profileUrl }}" class="fp-btn-outline">
                View Company
            </a>
            
            <a href="{{ path('individual_direct_request_new', {'type': 'company', 'id': pro.id}) }}" 
               class="fp-btn-solid">
                Get Quote
            </a>
        </div>
    </div>
</div>
