{# 
   Expected variables:
   - pro: Company entity object (aliased as 'pro' for compatibility with shared logic)
#}

<div class="drl-pro-card-new">
    {% if pro.isTopRated %}
    <div class="pro-badge-top-rated">
        <i class="fas fa-star" aria-hidden="true"></i> Top Rated
    </div>
    {% endif %}

    <!-- Image Area -->
    <div class="pro-card-img-wrapper">
        <a href="{{ path('company_details', {'id': pro.id}) }}">
            <img src="{{ pro.banner ? asset('uploads/banners/' ~ pro.banner) : asset('assets/drilleedo/images/team/plumber.png') }}"
                 alt="{{ pro.companyName ?? 'Company' }} — verified renovation company on Drilleedo"
                 loading="lazy">
        </a>
    </div>

    <!-- Body Area -->
    <div class="pro-card-body">
        
        {# Verified Status #}
        <div class="pro-verified-status">
            <i class="fas fa-check-circle text-success" aria-hidden="true"></i> <strong>Verified</strong> Company
        </div>

        {# Title #}
        <h3 class="pro-card-title">
            <a href="{{ path('company_details', {'id': pro.id}) }}">
                {{ pro.companyName ?? pro.email }}
            </a>
        </h3>

        {# Details List (Icon + Text) #}
        <ul class="pro-card-details-list">
            {# Category - Companies might have multiple or a main one #}
            <li>
                <div class="category-icon-wrapper-sm">
                    <i class="fas fa-building small text-muted"></i>
                </div>
                <span class="detail-text">Renovation Company</span>
            </li>
            
            {# Location #}
            <li>
                <i class="feather-map-pin" aria-hidden="true"></i>
                <span class="detail-text">{{ pro.city ?? 'Canada' }}</span>
            </li>
        </ul>

        {# Ratings & Reviews #}
        <div class="pro-card-ratings-row">
            <div class="pro-stars">
                {# Fallback ratings for companies if not present #}
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
            </div>
            <span class="pro-rating-number">5.0</span>
            <span class="pro-review-count">(Local Expert)</span>
        </div>

        {# Action Buttons #}
        <div class="pro-card-actions">
            <a href="{{ path('company_details', {'id': pro.id}) }}" 
               class="btn-pro-outline">
                View Company
            </a>
            
            <a href="{{ path('individual_direct_request_new', {'type': 'company', 'id': pro.id}) }}" 
               class="btn-pro-solid">
                Get Quote
            </a>
        </div>
    </div>
</div>
