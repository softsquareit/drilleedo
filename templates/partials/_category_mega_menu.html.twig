<div class="drl-mega-container">
    {# LEFT COLUMN: Parent Categories (Tabs) #}
    <div class="drl-mega-sidebar">
        <div class="drl-mega-title">Categories</div>
        <div class="drl-mega-nav">
            {% for parent in categoriesData %}
                <button class="drl-mega-nav-btn {% if loop.first %}active{% endif %}" 
                        data-category-id="{{ parent.id }}"
                        type="button">
                    <span class="drl-mega-nav-icon">
                        {% if parent.icon %}
                            <img src="{{ asset('uploads/categories/' ~ parent.icon) }}" alt="">
                        {% else %}
                            <i class="feather-folder"></i>
                        {% endif %}
                    </span>
                    <span class="drl-mega-nav-text">{{ parent.name }}</span>
                    <i class="feather-chevron-right drl-mega-nav-arrow"></i>
                </button>
            {% endfor %}
        </div>
    </div>

    {# CENTER COLUMN: Children Grid (Dynamic) #}
    <div class="drl-mega-content" id="drl-mega-content-area">
        {% for parent in categoriesData %}
            <div class="drl-mega-category-pane {% if loop.first %}active{% endif %}" id="pane-{{ parent.id }}">
                <div class="drl-pane-header">
                    <div class="drl-pane-icon">
                         {% if parent.icon %}
                            <img src="{{ asset('uploads/categories/' ~ parent.icon) }}" alt="">
                        {% else %}
                            <i class="feather-grid"></i>
                        {% endif %}
                    </div>
                    <div class="drl-pane-info">
                        <h3>{{ parent.name }}</h3>
                        <p>Discover specialized {{ parent.name|lower }} services in Canada</p>
                    </div>
                </div>

                {% if parent.children|length > 0 %}
                    <div class="drl-mega-grid">
                        {% for child in parent.children %}
                            <a href="{{ path('service_category_landing', {'categorySlug': child.slug}) }}" class="drl-mega-grid-item">
                                <span class="dot"></span>
                                {{ child.name }}
                            </a>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="drl-mega-empty">
                        <p>Explore all {{ parent.name|lower }} professionals</p>
                        <a href="{{ path('app_home') }}" class="rbt-btn btn-xs bdr-gradient">View All</a>
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    {# RIGHT COLUMN: Directory CTAs #}
    <div class="drl-mega-cta-side">
        <div class="drl-mega-cta-card pro">
            <div class="drl-mega-cta-icon"><i class="feather-users"></i></div>
            <h4>Professionals Directory</h4>
            <p>Connect with verified renovation experts nationwide.</p>
            <a href="{{ path('professionals_list') }}" class="drl-mega-cta-link">Browse Pros <i class="feather-arrow-right"></i></a>
        </div>

        <div class="drl-mega-cta-card company">
            <div class="drl-mega-cta-icon"><i class="feather-briefcase"></i></div>
            <h4>Company Directory</h4>
            <p>Explore top-rated renovation companies and teams.</p>
            <a href="{{ path('companies_list') }}" class="drl-mega-cta-link">Browse Companies <i class="feather-arrow-right"></i></a>
        </div>

        <div class="drl-mega-promo">
            <div class="promo-text">
                <strong>Are you a Pro?</strong>
                <span>Join Drilleedo today.</span>
            </div>
            <a href="{{ path('app_register_pro') }}" class="rbt-btn btn-white btn-sm">Get Started</a>
        </div>
    </div>
</div>

<style>
    /* Mega Menu Layout */
    .drl-mega-container {
        display: grid;
        grid-template-columns: 320px 1fr 280px;
        background: #fff;
        min-height: 520px;
        border-radius: 0 0 16px 16px;
        overflow: hidden;
    }

    /* Sidebar (Left Column) */
    .drl-mega-sidebar {
        background: #f8fafc;
        border-right: 1px solid #e2e8f0;
        padding: 30px 20px;
    }

    .drl-mega-title {
        font-size: 11px;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 20px;
        padding-left: 10px;
    }

    .drl-mega-nav {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .drl-mega-nav-btn {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        background: transparent;
        border: 1px solid transparent;
        border-radius: 12px;
        text-align: left;
        width: 100%;
        transition: all 0.2s;
        cursor: pointer;
    }

    .drl-mega-nav-btn:hover {
        background: #fff;
        border-color: #e2e8f0;
        transform: translateX(4px);
    }

    .drl-mega-nav-btn.active {
        background: #fff;
        border-color: #e2e8f0;
        box-shadow: 0 4px 12px rgba(13, 33, 81, 0.05);
    }

    .drl-mega-nav-btn.active .drl-mega-nav-text {
        color: var(--drl-blue);
        font-weight: 700;
    }

    .drl-mega-nav-btn.active .drl-mega-nav-arrow {
        opacity: 1;
        transform: translateX(0);
        color: var(--drl-blue);
    }

    .drl-mega-nav-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        border-radius: 8px;
        border: 1px solid #f1f5f9;
        font-size: 16px;
        color: #64748b;
        flex-shrink: 0;
    }
    
    .drl-mega-nav-icon img {
        width: 20px;
        height: 20px;
        object-fit: contain;
    }

    .drl-mega-nav-text {
        font-size: 14px;
        font-weight: 600;
        color: #475569;
        flex: 1;
    }

    .drl-mega-nav-arrow {
        font-size: 14px;
        opacity: 0;
        transform: translateX(-5px);
        transition: all 0.2s;
        color: #94a3b8;
    }

    /* Content Area (Center Column) */
    .drl-mega-content {
        padding: 40px;
        overflow-y: auto;
        position: relative;
    }

    .drl-mega-category-pane {
        display: none;
        animation: fadeIn 0.3s ease-out;
    }

    .drl-mega-category-pane.active {
        display: block;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .drl-pane-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 40px;
        padding-bottom: 20px;
        border-bottom: 1px solid #f1f5f9;
    }

    .drl-pane-icon {
        width: 56px;
        height: 56px;
        background: #f0f9ff;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        color: var(--drl-blue);
    }
    
    .drl-pane-icon img {
        width: 32px;
        height: 32px;
        object-fit: contain;
    }

    .drl-pane-info h3 {
        font-size: 22px;
        font-weight: 800;
        color: var(--drl-navy);
        margin: 0;
        line-height: 1;
    }

    .drl-pane-info p {
        font-size: 14px;
        color: #64748b;
        margin: 5px 0 0 0;
    }

    /* Grid for children */
    .drl-mega-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px 30px;
    }

    .drl-mega-grid-item {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 15px;
        font-weight: 500;
        color: #475569;
        padding: 8px 0;
        transition: all 0.2s;
    }

    .drl-mega-grid-item:hover {
        color: var(--drl-blue);
        transform: translateX(5px);
    }

    .drl-mega-grid-item .dot {
        width: 6px;
        height: 6px;
        background: #cbd5e1;
        border-radius: 50%;
        transition: all 0.2s;
    }

    .drl-mega-grid-item:hover .dot {
        background: var(--drl-blue);
        transform: scale(1.5);
    }

    /* CTA Side (Right Column) */
    .drl-mega-cta-side {
        background: #fafafa;
        border-left: 1px solid #e2e8f0;
        padding: 30px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .drl-mega-cta-card {
        padding: 24px;
        border-radius: 16px;
        color: #fff;
        position: relative;
        overflow: hidden;
        transition: all 0.3s;
    }

    .drl-mega-cta-card:hover {
        transform: translateY(-5px);
    }

    .drl-mega-cta-card.pro {
        background: linear-gradient(135deg, var(--drl-navy) 0%, var(--drl-blue) 100%);
    }

    .drl-mega-cta-card.company {
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    }

    .drl-mega-cta-icon {
        font-size: 24px;
        margin-bottom: 12px;
        opacity: 0.9;
    }

    .drl-mega-cta-card h4 {
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 8px;
    }

    .drl-mega-cta-card p {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.8);
        line-height: 1.4;
        margin-bottom: 16px;
    }

    .drl-mega-cta-link {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .drl-mega-cta-link i {
        transition: transform 0.2s;
    }

    .drl-mega-cta-card:hover .drl-mega-cta-link i {
        transform: translateX(5px);
    }

    .drl-mega-promo {
        margin-top: auto;
        padding: 20px;
        background: var(--drl-orange);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .drl-mega-promo .promo-text {
        display: flex;
        flex-direction: column;
        color: #fff;
    }

    .drl-mega-promo .promo-text strong { font-size: 14px; }
    .drl-mega-promo .promo-text span { font-size: 12px; opacity: 0.9; }

    /* Responsive adjustments */
    @media (max-width: 1200px) {
        .drl-mega-container {
            grid-template-columns: 260px 1fr 240px;
        }
    }
</style>

<script>
    (function() {
        const navBtns = document.querySelectorAll('.drl-mega-nav-btn');
        const panes = document.querySelectorAll('.drl-mega-category-pane');
        const contentArea = document.getElementById('drl-mega-content-area');

        navBtns.forEach(btn => {
            const handleInteract = () => {
                const catId = btn.getAttribute('data-category-id');
                
                // Update buttons
                navBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                
                // Update panes
                panes.forEach(p => p.classList.remove('active'));
                const targetPane = document.getElementById('pane-' + catId);
                if (targetPane) targetPane.classList.add('active');
                
                // Reset scroll
                contentArea.scrollTop = 0;
            };

            // Switch on hover for fast desktop experience
            btn.addEventListener('mouseenter', handleInteract);
            // Switch on click too
            btn.addEventListener('click', handleInteract);
        });
    })();
</script>