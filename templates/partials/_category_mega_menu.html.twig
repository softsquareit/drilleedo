{% set parentCount = 0 %}

{% for parent in categoriesData %}

    {# Nouvelle colonne tous les 2 parents #}
    {% if parentCount % 2 == 0 %}
        <div class="col-lg-12 col-xl-3 col-xxl-3 single-mega-item">

        {# Première colonne : ajouter Liste Companies en haut #}
        {% if parentCount == 0 %}
            <h3 class="rbt-short-title d-flex align-items-center gap-2 mb-2">
                <span class="category-icon-wrapper" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="fas fa-building" style="font-size: 20px; color: var(--color-body);"></i>
                </span>
                <span>
                    <a href="{{ path('companies_list') }}" style="text-decoration: none; color: inherit;">Companies List</a>
                </span>
            </h3>
        {% endif %}
    {% endif %}

    <h3 class="rbt-short-title d-flex align-items-center gap-2 mb-1">
        <span class="category-icon-wrapper" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center;">
            {% if parent.icon %}
                <img src="{{ asset('uploads/categories/' ~ parent.icon) }}" alt="" style="width: 100%; height: 100%; object-fit: contain;">
            {% else %}
                <i class="feather-folder" style="font-size: 20px; color: var(--color-body);"></i>
            {% endif %}
        </span>
        <span>{{ parent.name }}</span>
    </h3>

    {% if parent.children|length > 0 %}
        <ul class="mega-menu-item">
            {% for child in parent.children %}
                <li>
                    <a href="{{ path('service_category_landing', {'categorySlug': child.slug}) }}">
                        {{ child.name }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {% set parentCount = parentCount + 1 %}

    {# On ferme la colonne tous les 2 parents ou à la fin #}
    {% if parentCount % 2 == 0 or loop.last %}
        </div>
    {% endif %}

{% endfor %}