{# Footer styles -> drilleedo.css (section: Footer) #}
<style>
/* ════════════════════════════════════════════
   FOOTER — CHARTE OFFICIELLE DRILLEEDO 2025
   Fond : #0C1825 (Dark)
   Accent hover : #3FA9F5 (Action Sky)
   CTA : #FF8A3D (Toolbox Orange)
   ════════════════════════════════════════════ */

/* ── CTA Banner ── */
.df-cta {
  background: linear-gradient(135deg, #003660, #002848);
  padding: 40px 32px;
  border-radius: 16px;
  margin-bottom: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
  flex-wrap: wrap;
  box-shadow: 0 4px 24px rgba(0,0,0,0.25);
}

.df-cta__text h3 {
  font-size: 24px;
  font-weight: 700;
  color: #fff;
  margin: 0 0 8px;
  letter-spacing: -.5px;
}

.df-cta__text p {
  font-size: 15px;
  color: rgba(255,255,255,0.72);
  margin: 0;
  max-width: 480px;
  line-height: 1.6;
}

.df-cta__actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.df-btn-orange {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #FF8A3D;
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  padding: 12px 24px;
  border-radius: 10px;
  text-decoration: none;
  box-shadow: 0 4px 16px rgba(255,138,61,0.35);
  transition: background .2s, transform .2s;
}
.df-btn-orange:hover { background: #e87830; color: #fff; transform: translateY(-2px); text-decoration: none; }

.df-btn-outline {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  padding: 11px 22px;
  border-radius: 10px;
  text-decoration: none;
  border: 2px solid rgba(255,255,255,0.3);
  transition: background .2s, border-color .2s;
}
.df-btn-outline:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.6); color: #fff; text-decoration: none; }

/* ── 4 Columns ── */
.df-main {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 40px;
  margin-bottom: 40px;
}

/* Brand col */
.df-logo-wrap { margin-bottom: 14px; }
.df-logo-wrap img { height: 34px; display: block; filter: brightness(0) invert(1); }
.df-tagline {
  font-size: 11px;
  font-weight: 600;
  color: #3FA9F5;
  letter-spacing: .5px;
  margin-bottom: 16px;
  display: block;
}

.df-desc {
  font-size: 14px;
  color: rgba(255,255,255,0.55);
  line-height: 1.65;
  margin-bottom: 24px;
  max-width: 300px;
}

.df-socials {
  display: flex;
  gap: 10px;
}

.df-social {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  text-decoration: none;
  transition: background .2s, transform .2s, color .2s, border-color .2s;
}

.df-social:hover { transform: translateY(-3px); border-color: #3FA9F5; color: #3FA9F5; }
.df-social--fb:hover { background: #1877f2; border-color: #1877f2; color: #fff; }
.df-social--tw:hover { background: #000; border-color: #000; color: #fff; }
.df-social--in:hover { background: #e1306c; border-color: #e1306c; color: #fff; }
.df-social--li:hover { background: #0a66c2; border-color: #0a66c2; color: #fff; }

/* Links cols */
.df-col-title {
  font-size: 11px;
  font-weight: 700;
  color: rgba(255,255,255,0.3);
  margin: 0 0 18px;
  letter-spacing: 1.2px;
  text-transform: uppercase;
}

.df-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.df-links a {
  color: rgba(255,255,255,0.55);
  font-size: 14px;
  text-decoration: none;
  transition: color .15s, padding-left .15s;
}

.df-links a:hover {
  color: #3FA9F5;
  padding-left: 4px;
}

.df-contact-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  color: rgba(255,255,255,0.55);
  font-size: 14px;
  line-height: 1.5;
  margin-bottom: 14px;
}

.df-contact-icon {
  width: 16px;
  height: 16px;
  color: #3FA9F5;
  flex-shrink: 0;
  margin-top: 2px;
}
.df-contact-item i {
  color: #3FA9F5;
  font-size: 15px;
  margin-top: 3px;
}
.df-contact-item a { color: inherit; text-decoration: none; transition: color .15s; }
.df-contact-item a:hover { color: #fff; }

/* Separator */
.df-separator {
  border: none;
  border-top: 1px solid rgba(255,255,255,0.07);
  margin: 0;
}

/* ── Bottom Bar ── */
.df-bottom {
  margin-top: 0;
}

.df-bottom__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 18px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14px;
  font-size: 13px;
  color: rgba(255,255,255,0.35);
}

.df-bottom-links {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.df-bottom-links a {
  color: rgba(255,255,255,0.35);
  text-decoration: none;
  transition: color .15s;
}
.df-bottom-links a:hover { color: #3FA9F5; }

.df-made-in {
  display: flex;
  align-items: center;
  gap: 6px;
  color: rgba(255,255,255,0.35);
}
.df-maple { color: #FF8A3D; font-size: 14px; }

/* Wordmark */
.f-wordmark {
  text-align: center;
  padding: 20px 0;
  opacity: 0.04;
  pointer-events: none;
  overflow: hidden;
}
.f-wordmark img { height: 60px; filter: brightness(0) invert(1); }

/* Responsive */
@media (max-width: 1024px) {
  .df-main { grid-template-columns: 1fr 1fr 1fr; }
}
@media (max-width: 768px) {
  .df-main { grid-template-columns: 1fr 1fr; gap: 32px 20px; }
  .df-cta { flex-direction: column; text-align: center; padding: 28px 20px; }
  .df-cta__actions { justify-content: center; width: 100%; }
  .df-bottom__inner { flex-direction: column; text-align: center; justify-content: center; }
}
@media (max-width: 480px) {
  .df-main { grid-template-columns: 1fr; gap: 28px; }
  .df-btn-outline, .df-btn-orange { width: 100%; justify-content: center; }
}
</style>

<footer class="drld-footer" style="background-color:#00497F; font-family:'Instrument Sans','Segoe UI',sans-serif;">
    <div class="container" style="max-width:1200px;margin:auto;padding:48px 24px 0;">

        {# ── CTA Section ── #}
        <div class="df-cta">
            <div class="df-cta__text">
                <h3>{{ 'footer.cta_title'|trans }}</h3>
                <p>{{ 'footer.cta_desc'|trans }}</p>
            </div>
            <div class="df-cta__actions">
                <a href="{{ path('professionals_list') }}" class="df-btn-orange">
                    {{ 'footer.cta_find'|trans }}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
                <a href="{{ path('app_register') }}" class="df-btn-outline">
                    {{ 'footer.cta_join'|trans }}
                </a>
            </div>
        </div>

        {# ── 4 Columns ── #}
        <div class="df-main">

            {# Col 1: Brand & Socials #}
            <div>
                <div class="df-logo-wrap">
                    <img src="{{ asset('uploads/images/Logo_bottom.png') }}" alt="Drilleedo" loading="lazy">
                </div>
                <span class="df-tagline">easy help, fast solutions</span>
                <p class="df-desc">{{ 'footer.brand_desc'|trans }}</p>
                <div class="df-socials">
                    <a href="#" class="df-social df-social--fb" aria-label="Facebook"><i class="fab fa-facebook-f" aria-hidden="true"></i></a>
                    <a href="#" class="df-social df-social--tw" aria-label="Twitter / X"><i class="fab fa-twitter" aria-hidden="true"></i></a>
                    <a href="#" class="df-social df-social--in" aria-label="Instagram"><i class="fab fa-instagram" aria-hidden="true"></i></a>
                    <a href="#" class="df-social df-social--li" aria-label="LinkedIn"><i class="fab fa-linkedin-in" aria-hidden="true"></i></a>
                </div>
            </div>

            {# Col 2: Propriétaires #}
            <div>
                <h4 class="df-col-title">{{ 'footer.col_homeowners'|trans }}</h4>
                <ul class="df-links">
                    <li><a href="{{ path('professionals_list') }}">{{ 'nav.find_professionals'|trans }}</a></li>
                    <li><a href="{{ path('app_home') }}#how-it-works">{{ 'nav.how_it_works'|trans }}</a></li>
                    <li><a href="{{ path('smartideas') }}">{{ 'nav.smart_ideas'|trans }}</a></li>
                    <li><a href="{{ path('packages') }}">{{ 'nav.pricing'|trans }}</a></li>
                    <li><a href="{{ path('contact') }}">{{ 'nav.support'|trans }}</a></li>
                </ul>
            </div>

            {# Col 3: Villes & Compagnie #}
            <div>
                <h4 class="df-col-title">{{ 'footer.col_cities'|trans }}</h4>
                <ul class="df-links" style="margin-bottom:20px;">
                    <li><a href="{{ path('city_seo_landing', {citySlug: 'toronto'}) }}">Toronto</a></li>
                    <li><a href="{{ path('city_seo_landing', {citySlug: 'montreal'}) }}">Montréal</a></li>
                    <li><a href="{{ path('city_seo_landing', {citySlug: 'vancouver'}) }}">Vancouver</a></li>
                </ul>
                <h4 class="df-col-title">{{ 'footer.col_company'|trans }}</h4>
                <ul class="df-links">
                    <li><a href="{{ path('app_about') }}">{{ 'nav.about_us'|trans }}</a></li>
                    <li><a href="{{ path('public_blog_list') }}">{{ 'nav.blog'|trans }}</a></li>
                    <li><a href="{{ path('app_careers') }}">{{ 'nav.careers'|trans }}</a></li>
                </ul>
            </div>

            {# Col 4: Contact #}
            <div>
                <h4 class="df-col-title">{{ 'footer.col_contact'|trans }}</h4>
                <div class="df-contact-item">
                    <svg class="df-contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.29 6.29l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.02z"/></svg>
                    <span><a href="tel:+15149999999">+1 (514) 999-9999</a><br><span style="font-size:12px;opacity:.7;">{{ 'footer.hours'|trans }}</span></span>
                </div>
                <div class="df-contact-item">
                    <svg class="df-contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    <a href="mailto:hello@drilleedo.com">hello@drilleedo.com</a>
                </div>
                <div class="df-contact-item">
                    <svg class="df-contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    <span>Toronto, ON<br><span style="font-size:12px;opacity:.7;">{{ 'footer.country'|trans }}</span></span>
                </div>
            </div>

        </div>

    </div>{# /container #}

    {# ── Wordmark ── #}
    <div class="f-wordmark">
        <img src="{{ asset('uploads/images/Logo_bottom.png') }}" alt="" loading="lazy">
    </div>

    <hr class="df-separator">

    {# ── Bottom Bar ── #}
    <div class="df-bottom">
        <div class="df-bottom__inner">
            <div>{{ 'footer.copyright'|trans({'%year%': 'now'|date('Y')}) }}</div>
            <div class="df-bottom-links">
                <a href="#">{{ 'footer.privacy'|trans }}</a>
                <a href="#">{{ 'footer.terms'|trans }}</a>
                <a href="#">{{ 'footer.sitemap'|trans }}</a>
            </div>
            <div class="df-made-in">
                Fièrement fait au Canada <span class="df-maple">🍁</span>
            </div>
        </div>
    </div>

</footer>
