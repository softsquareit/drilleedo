{# Footer styles -> drilleedo.css (section: Footer) #}
<style>
/* ── Footer Redesign (Inner Blocks) ── */
.df-cta {
  background: linear-gradient(135deg, #00509e, #1a3a6b);
  padding: 40px 32px;
  border-radius: 16px;
  margin-bottom: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
  flex-wrap: wrap;
  box-shadow: 0 4px 24px rgba(0,0,0,0.15);
}

.df-cta__text h3 {
  font-size: 24px;
  font-weight: 900;
  color: #fff;
  margin: 0 0 8px;
}

.df-cta__text p {
  font-size: 15px;
  color: rgba(255,255,255,0.75);
  margin: 0;
  max-width: 500px;
  line-height: 1.6;
}

.df-cta__actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.df-btn-orange {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #e8501a;
  color: #fff;
  font-size: 14px;
  font-weight: 800;
  padding: 12px 24px;
  border-radius: 8px;
  text-decoration: none;
  box-shadow: 0 4px 16px rgba(232,80,26,0.3);
  transition: background 0.15s, transform 0.15s;
}
.df-btn-orange:hover { background: #c43d10; color: #fff; transform: translateY(-2px); }

.df-btn-outline {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  padding: 11px 22px;
  border-radius: 8px;
  text-decoration: none;
  border: 2px solid rgba(255,255,255,0.3);
  transition: background 0.15s, border-color 0.15s;
}
.df-btn-outline:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.6); color: #fff; }

/* ── 4 Columns ── */
.df-main {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 40px;
  margin-bottom: 40px;
}

/* Brand col */
.df-desc {
  font-size: 14px;
  color: rgba(255,255,255,0.65);
  line-height: 1.65;
  margin-bottom: 24px;
  max-width: 300px;
}

.df-socials {
  display: flex;
  gap: 10px;
}

.df-social {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: rgba(255,255,255,0.08);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  text-decoration: none;
  transition: background 0.15s, transform 0.15s, color 0.15s;
}

.df-social:hover { transform: translateY(-3px); }
.df-social--fb:hover { background: #1877f2; color: #fff; }
.df-social--tw:hover { background: #000; color: #fff; }
.df-social--in:hover { background: #e1306c; color: #fff; }
.df-social--li:hover { background: #0a66c2; color: #fff; }

/* Links cols */
.df-col-title {
  font-size: 15px;
  font-weight: 800;
  color: #fff;
  margin: 0 0 20px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.df-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.df-links a {
  color: rgba(255,255,255,0.65);
  font-size: 14px;
  text-decoration: none;
  transition: color 0.15s, padding-left 0.15s;
}

.df-links a:hover {
  color: #f97316;
  padding-left: 4px;
}

.df-contact-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  color: rgba(255,255,255,0.65);
  font-size: 14px;
  line-height: 1.5;
  margin-bottom: 14px;
}

.df-contact-item i {
  color: #f97316;
  font-size: 15px;
  margin-top: 3px;
}

.df-contact-item a { color: inherit; text-decoration: none; transition: color 0.15s; }
.df-contact-item a:hover { color: #fff; }

/* ── Bottom Bar ── */
.df-bottom {
  border-top: 1px solid rgba(255,255,255,0.1);
  background: rgba(0,0,0,0.15);
  margin-top: 20px;
}

.df-bottom__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  font-size: 13px;
  color: rgba(255,255,255,0.45);
}

.df-bottom-links {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.df-bottom-links a {
  color: rgba(255,255,255,0.45);
  text-decoration: none;
  transition: color 0.15s;
}
.df-bottom-links a:hover { color: #fff; }

/* Responsive */
@media (max-width: 1024px) {
  .df-main { grid-template-columns: 1fr 1fr 1fr; }
  .df-desc { grid-column: 1 / -1; max-width: 500px; margin-bottom: 0; }
  .df-socials { grid-column: 1 / -1; margin-bottom: 20px; }
}

@media (max-width: 768px) {
  .df-main { grid-template-columns: 1fr 1fr; gap: 40px 20px; }
  .df-cta { flex-direction: column; text-align: center; padding: 32px 20px; }
  .df-cta__actions { justify-content: center; width: 100%; }
  .df-bottom__inner { flex-direction: column; text-align: center; justify-content: center; }
}

@media (max-width: 480px) {
  .df-main { grid-template-columns: 1fr; gap: 32px; }
  .df-btn-outline { width: 100%; justify-content: center; }
  .df-btn-orange { width: 100%; justify-content: center; }
}
</style>

<footer class="drld-footer" style="background-color: #0d2151; font-family: 'Nunito', sans-serif;">
    <div class="container" style="margin:auto; padding-top: 40px;">

        {# ── NEW CTA Section ── #}
        <div class="df-cta">
            <div class="df-cta__text">
                <h3>{{ 'footer.cta_title'|trans }}</h3>
                <p>{{ 'footer.cta_desc'|trans }}</p>
            </div>
            <div class="df-cta__actions">
                <a href="{{ path('professionals_list') }}" class="df-btn-orange">
                    {{ 'footer.cta_find'|trans }} <i class="feather-arrow-right" aria-hidden="true"></i>
                </a>
                <a href="{{ path('app_register') }}" class="df-btn-outline">
                    {{ 'footer.cta_join'|trans }}
                </a>
            </div>
        </div>

        {# ── 4 Columns Redesigned ── #}
        <div class="df-main">
            
            {# Col 1: Brand & Socials #}
            <div>
                <img src="{{ asset('uploads/images/Logo_bottom.png') }}" alt="Drilleedo" style="height: 34px; margin-bottom: 20px; display: block;" loading="lazy">
                <p class="df-desc">
                    {{ 'footer.brand_desc'|trans }}
                </p>
                <div class="df-socials">
                    <a href="#" class="df-social df-social--fb" aria-label="Facebook"><i class="fab fa-facebook-f" aria-hidden="true"></i></a>
                    <a href="#" class="df-social df-social--tw" aria-label="Twitter"><i class="fab fa-twitter" aria-hidden="true"></i></a>
                    <a href="#" class="df-social df-social--in" aria-label="Instagram"><i class="fab fa-instagram" aria-hidden="true"></i></a>
                    <a href="#" class="df-social df-social--li" aria-label="LinkedIn"><i class="fab fa-linkedin-in" aria-hidden="true"></i></a>
                </div>
            </div>

            {# Col 2: For Homeowners #}
            <div>
                <h4 class="df-col-title">{{ 'footer.col_homeowners'|trans }}</h4>
                <ul class="df-links">
                    <li><a href="{{ path('professionals_list') }}">{{ 'nav.find_professionals'|trans }}</a></li>
                    <li><a href="{{ path('app_home') }}#how-it-works">{{ 'nav.how_it_works'|trans }}</a></li>
                    <li><a href="{{ path('smartideas') }}">{{ 'nav.smart_ideas'|trans }}</a></li>
                    <li><a href="{{ path('packages') }}">{{ 'nav.pricing'|trans }}</a></li>
                    <li><a href="{{ path('contact') }}">{{ 'nav.support'|trans }}</a></li>
                </ul>
            </div>

            {# Col 3: Company & Cities #}
            <div>
                <h4 class="df-col-title">{{ 'footer.col_cities'|trans }}</h4>
                <ul class="df-links" style="margin-bottom: 20px;">
                    <li><a href="{{ path('city_seo_landing', {citySlug: 'toronto'}) }}">Toronto</a></li>
                    <li><a href="{{ path('city_seo_landing', {citySlug: 'montreal'}) }}">Montréal</a></li>
                    <li><a href="{{ path('city_seo_landing', {citySlug: 'vancouver'}) }}">Vancouver</a></li>
                </ul>
                <h4 class="df-col-title" style="margin-bottom: 12px; font-size: 13px;">{{ 'footer.col_company'|trans }}</h4>
                <ul class="df-links">
                    <li><a href="{{ path('app_about') }}">{{ 'nav.about_us'|trans }}</a></li>
                    <li><a href="{{ path('public_blog_list') }}">{{ 'nav.blog'|trans }}</a></li>
                    <li><a href="{{ path('app_careers') }}">{{ 'nav.careers'|trans }}</a></li>
                </ul>
            </div>

            {# Col 4: Contact #}
            <div>
                <h4 class="df-col-title">{{ 'footer.col_contact'|trans }}</h4>
                <div class="df-contact-item">
                    <i class="feather-phone" aria-hidden="true"></i>
                    <span><a href="tel:+14065550120">(406) 555-0120</a><br><span style="font-size:12px;opacity:0.7;">{{ 'footer.hours'|trans }}</span></span>
                </div>
                <div class="df-contact-item">
                    <i class="feather-mail" aria-hidden="true"></i>
                    <a href="mailto:contact@drilleedo.com">contact@drilleedo.com</a>
                </div>
                <div class="df-contact-item">
                    <i class="feather-map-pin" aria-hidden="true"></i>
                    <span>Toronto, ON<br><span style="font-size:12px;opacity:0.7;">{{ 'footer.country'|trans }}</span></span>
                </div>
            </div>

        </div>

    </div>{# /container #}

    {# ── Large Drilleedo® wordmark ───────────────────── #}
    {# DO NOT MODIFY THIS BLOCK - RETAINS ORIGINAL STYLING #}
    <div class="f-wordmark">
        <img
            src="{{ asset('uploads/images/Logo_bottom.png') }}"
            alt="Drilleedo"
            loading="lazy"
        >
    </div>
  
    {# ── New Bottom Bar ── #}
    <div class="df-bottom">
        <div class="df-bottom__inner">
            <div>
                {{ 'footer.copyright'|trans({'%year%': 'now'|date('Y')}) }}
            </div>
            <div class="df-bottom-links">
                <a href="#">{{ 'footer.privacy'|trans }}</a>
                <a href="#">{{ 'footer.terms'|trans }}</a>
                <a href="#">{{ 'footer.sitemap'|trans }}</a>
            </div>
            <div class="df-made-in" style="display:flex;align-items:center;gap:6px;">
                {{ 'footer.made_in'|trans }} 
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" style="width:14px; height:14px;">
                    <g fill="#e8501a">
                        <path d="M470.83 234L351.62 254.19l32.12-101.4-96.16 63.48-31.54-216.27-31.42 216.27-96-63.48 31.95 101.4L41.31 234l67.62 50.8-108.93 69.85 137.47-5.07L167.92 462l88-69.85v119.85h.2v-119.85l87.89 69.85 30.54-112.43 137.37 5.07L403.07 284.8z"/>
                    </g>
                </svg>
                {{ 'footer.country'|trans }}
            </div>
        </div>
    </div>

</footer>
