<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>{% block title %}Drilleedo – Canadian Home Improvement Marketplace{% endblock %}</title>
    <meta name="robots" content="index, follow">
    <meta name="description" content="Drilleedo connects homeowners with trusted professionals for renovations, repairs, and home improvement services in Canada. Fast, reliable, and easy to use.">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="{{ asset('assets/drilleedo/images/favicon.png') }}">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">

    <!-- CSS
	============================================ -->
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/vendor/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/vendor/slick.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/vendor/slick-theme.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/sal.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/feather.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/fontawesome.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/euclid-circulara.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/swiper.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/odometer.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/animation.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/bootstrap-select.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/jquery-ui.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/magnigy-popup.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/plyr.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/jodit.min.css') }}">
	
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/styles.css') }}">

    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/drilleedo.css') }}">
 <style>
</style>
    {% block stylesheets %}{% endblock %}
</head>

<body class="rbt-header-sticky dm-serif-display-regular">

    <!-- Start Header Area -->
    {% include 'partials/_public_header.html.twig' %}
    <!-- End Header Area -->

    <main class="rbt-main-wrapper">
        {% block body %}{% endblock %}

        <!-- Start Footer Area  -->
        {% include 'partials/_public_footer.html.twig' %}
        <!-- End Footer Area  -->
    </main>

    <div class="rbt-progress-parent">
        <svg class="rbt-back-circle svg-inner" width="100%" height="100%" viewBox="-1 -1 102 102">
            <path d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98" />
        </svg>
    </div>

    <!-- JS
============================================ -->
    <!-- Modernizer JS -->
    <script src="{{ asset('assets/drilleedo/js/vendor/modernizr.min.js') }}"></script>
    <!-- jQuery JS -->
    <script src="{{ asset('assets/drilleedo/js/vendor/jquery.js') }}"></script>
    <!-- Bootstrap JS -->
    <script src="{{ asset('assets/drilleedo/js/vendor/bootstrap.min.js') }}"></script>
    <!-- sal.js -->
    <script src="{{ asset('assets/drilleedo/js/vendor/sal.js') }}"></script>
    <!-- Dark Mode Switcher -->
    <script src="{{ asset('assets/drilleedo/js/vendor/js.cookie.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/jquery.style.switcher.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/swiper.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/jquery-appear.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/odometer.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/backtotop.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/isotop.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/imageloaded.js') }}"></script>

    <script src="{{ asset('assets/drilleedo/js/vendor/wow.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/waypoint.min.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/easypie.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/text-type.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/jquery-one-page-nav.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/bootstrap-select.min.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/jquery-ui.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/magnify-popup.min.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/paralax-scroll.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/paralax.min.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/countdown.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/plyr.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/jodit.min.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/Sortable.min.js') }}"></script>

    <!-- Main JS -->
    <script src="{{ asset('assets/drilleedo/js/vendor/bootstrap-select.min.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/main.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/category-selector.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/confirm-modal.js') }}"></script>

    {# ── Global Confirmation Modal ── #}
    <div class="modal fade" id="globalConfirmModal" tabindex="-1" aria-hidden="true" style="z-index: 9999;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-body p-4 text-center">
                    <div class="mb-4">
                        <div class="pro-stat-icon warning mx-auto" style="width: 70px; height: 70px; font-size: 32px; background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                            <i class="feather-alert-triangle"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2" id="globalConfirmTitle">Confirm Action</h4>
                    <p class="text-muted px-4 mb-4" id="globalConfirmMessage">Are you sure you want to proceed?</p>
                    
                    <div class="d-flex flex-column gap-3 mt-4">
                        <button type="button" id="globalConfirmBtn" class="indiv-btn-primary w-100 py-3 justify-content-center" style="font-size: 1.15rem;">
                            Confirm
                        </button>
                        <button type="button" class="indiv-btn-secondary w-100 py-3 bg-light text-dark justify-content-center" style="border-color: #cbd5e1; font-size: 1.15rem;" data-bs-dismiss="modal">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% block javascripts %}{% endblock %}
</body>

</html>