{% extends 'admin/base_admin.html.twig' %}

{% block title %}Individual Users | Admin{% endblock %}



{% block body %}
    <div class="content-wrapper">
        <div class="content-inner">
            
            <div class="page-header page-header-light shadow-sm">
                <div class="page-header-content d-lg-flex">
                    <div class="d-flex">
                        <h4 class="page-title mb-0">
                            Individual Users - <span class="fw-normal">Management</span>
                        </h4>
                    </div>
                </div>

                <div class="page-header-content d-lg-flex border-top">
                    <div class="d-flex">
                        <div class="breadcrumb py-2">
                            <a href="{{ path('admin_dashboard') }}" class="breadcrumb-item"><i class="fas fa-home"></i></a>
                            <a href="{{ path('admin_dashboard') }}" class="breadcrumb-item">Admin</a>
                            <span class="breadcrumb-item active">Individuals</span>
                        </div>
                    </div>
                </div>
            </div>
            

            
            <div class="content px-4">

             
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-check-circle me-2"></i>
                        {{ message }}
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                 <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        {{ message }}
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 py-4 px-4 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-info bg-opacity-10 text-info rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fas fa-users"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold text-dark">Registered Users</h5>
                            <p class="text-muted small mb-0">{{ individuals|length }} users registered</p>
                        </div>
                    </div>
                    
                    <div class="d-flex gap-2">
                         <div class="position-relative">
                            <input type="text" class="form-control ps-5 rounded-pill border-0 bg-light" placeholder="Search users..." id="userSearch" style="width: 250px;">
                            <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        </div>
                        
                        <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addIndividualModal">
                            <i class="fas fa-plus me-2"></i> Add Individual
                        </button>
                    </div>
                </div>

                
                <div class="modal fade" id="addIndividualModal" tabindex="-1" aria-labelledby="addIndividualModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content rounded-4 border-0 shadow-lg">
                            <div class="modal-header bg-light border-0 rounded-top-3 py-3 px-4">
                                <h5 class="modal-title fw-bold text-dark" id="addIndividualModalLabel">Add New Individual</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <form action="{{ path('admin_individual_create') }}" method="POST">
                                <div class="modal-body p-4">
                                     <div class="mb-4">
                                         <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                                         <input type="email" class="form-control" name="individual[email]" required>
                                     </div>
                                     <div class="mb-4">
                                         <label class="form-label fw-semibold">Password <span class="text-danger">*</span></label>
                                         <input type="password" class="form-control" name="individual[password]" required>
                                     </div>
                                </div>
                                <div class="modal-footer bg-light border-0 py-3 rounded-bottom-3">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary px-4">Create Account</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                     <table class="table datatable-button-html5-columns">
                        <thead class="bg-light bg-opacity-50">
                            <tr>
                                <th class="border-0 px-4 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 5%;">#</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 10%;">ID</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 25%;">User Name</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 30%;">Email</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 10%;">Role</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 10%;">Status</th>
                                <th class="border-0 px-4 py-3 text-end text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 10%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for individual in individuals %}
                            <tr class="border-bottom border-light">
                                <td class="px-4 text-muted fw-semibold">{{ loop.index }}</td>
                                <td><span class="badge bg-light text-secondary border rounded-2 px-2 py-1 user-select-all">#{{ individual.id }}</span></td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-info bg-opacity-10 text-info rounded-circle p-2 me-3 d-flex align-items-center justify-content-center border border-info-subtle" style="width: 40px; height: 40px;">
                                            <i class="fas fa-user small"></i>
                                        </div>
                                        <div>
                                            {% if individual.personalInfos %}
                                                <span class="fw-bold text-dark">{{ individual.personalInfos.firstName }} {{ individual.personalInfos.lastName }}</span>
                                            {% else %}
                                                <span class="fw-bold text-muted">Unknown Name</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </td>
                                <td class="text-muted">{{ individual.email }}</td>
                                <td><span class="badge bg-light text-secondary border rounded-pill px-3">Individual</span></td>
                                <td>
                                     <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 status-badge">
                                        <i class="fas fa-check-circle me-1 small"></i> Active
                                     </span>
                                </td>
                                <td class="px-4 text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="{{ path('admin_individual_edit', {id: individual.id}) }}" class="btn btn-sm btn-light text-primary btn-icon rounded-circle shadow-sm" title="Edit Profile" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-edit small"></i>
                                        </a>
                                        <a href="{{ path('admin_individual_delete', {id: individual.id}) }}" class="btn btn-sm btn-light text-danger btn-icon rounded-circle shadow-sm" title="Delete User" data-confirm="Delete this user?" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-trash-alt small"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="d-flex flex-column align-items-center justify-content-center p-5">
                                        <div class="bg-light rounded-circle p-4 mb-4">
                                            <i class="fas fa-users fa-3x text-muted opacity-25"></i>
                                        </div>
                                        <h5 class="text-dark fw-bold mb-2">No Individuals Found</h5>
                                        <p class="text-muted mb-0">Registered individual users will appear here.</p>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                 <div class="card-footer bg-white border-0 py-3 px-4 rounded-bottom-4">
                    <small class="text-muted fw-medium">Showing {{ individuals|length }} entries</small>
                </div>
            </div>

            </div>
        </div>
    </div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('userSearch');
        if (searchInput) {
            searchInput.addEventListener('keyup', function() {
                const searchTerm = this.value.toLowerCase();
                const rows = document.querySelectorAll('table tbody tr');
                rows.forEach(row => {
                    if(row.querySelector('td[colspan]')) return;
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(searchTerm) ? '' : 'none';
                });
            });
        }
    });
</script>
{% endblock %}