{% extends 'admin/base_admin.html.twig' %}

{% block title %}Create Company{% endblock %}

{% block body %}
<div class="content-wrapper">
    <div class="content-inner">
        
        <div class="page-header page-header-light shadow-sm">
            <div class="page-header-content d-lg-flex">
                <div class="d-flex">
                    <h4 class="page-title mb-0">
                        Companies - <span class="fw-normal">Add New</span>
                    </h4>
                </div>
            </div>

            <div class="page-header-content d-lg-flex border-top">
                <div class="d-flex">
                    <div class="breadcrumb py-2">
                        <a href="{{ path('admin_dashboard') }}" class="breadcrumb-item"><i class="fas fa-home me-2"></i>Admin</a>
                        <a href="{{ path('admin_company_index') }}" class="breadcrumb-item">Companies</a>
                        <span class="breadcrumb-item active">Add New</span>
                    </div>
                </div>
            </div>
        </div>
        

        
        <div class="content p-4">
            <div class="row">
                <div class="col-lg-8 offset-lg-2">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-header bg-white border-bottom p-3 d-flex align-items-center">
                            <div class="bg-primary bg-opacity-10 p-2 rounded-2 me-3">
                                <i class="fas fa-building text-primary"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold">Company Details</h5>
                                <p class="text-muted small mb-0">Define the core information for the new company</p>
                            </div>
                        </div>

                        {{ form_start(form) }}
                        <div class="card-body p-4">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0"><i class="fas fa-envelope text-muted"></i></span>
                                            {{ form_widget(form.email, {'attr': {'class': 'form-control border-start-0', 'placeholder': 'company@example.com'}}) }}
                                        </div>
                                        {{ form_errors(form.email) }}
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Company Name <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0"><i class="fas fa-building text-muted"></i></span>
                                            {{ form_widget(form.company_name, {'attr': {'class': 'form-control border-start-0', 'placeholder': 'Global Tech Inc.'}}) }}
                                        </div>
                                        {{ form_errors(form.company_name) }}
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Main Photo</label>
                                        {{ form_widget(form.main_photo, {'attr': {'class': 'form-control'}}) }}
                                        <div class="form-text mt-2 small">Recommended size: 800x600px</div>
                                        {{ form_errors(form.main_photo) }}
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Banner Image</label>
                                        {{ form_widget(form.Banner, {'attr': {'class': 'form-control'}}) }}
                                        <div class="form-text mt-2 small">Recommended size: 1920x400px</div>
                                        {{ form_errors(form.Banner) }}
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Business Categories</label>
                                        {{ form_widget(form.category, {'attr': {'class': 'form-select select-multiple', 'style': 'height: 150px;'}}) }}
                                        <div class="form-text mt-2 small">Hold Ctrl (Cmd on Mac) to select multiple categories</div>
                                        {{ form_errors(form.category) }}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-light border-top p-3 text-end">
                            <a href="{{ path('admin_company_index') }}" class="btn btn-link text-muted fw-medium me-2">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                                <i class="fas fa-plus me-2"></i>Create Company
                            </button>
                        </div>
                        {{ form_rest(form) }}
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
        
    </div>
</div>
{% endblock %}