{% extends 'admin/base_admin.html.twig' %}

{% block header %}
    <style>
        /* Zenith Theme - Hyper Clean */
        :root {
            --zen-bg: #f9fafb;
            --zen-surface: #ffffff;
            --zen-border: #e5e7eb;
            --zen-text-main: #111827;
            --zen-text-muted: #6b7280;
            --zen-primary: #111827; /* Near Black */
            --zen-primary-hover: #000000;
            --zen-accent: #6366f1;
        }

        body {
            background-color: var(--zen-bg) !important;
            color: var(--zen-text-main);
        }

        .zen-card {
            position: relative;
            background: var(--zen-surface);
            border: 1px solid var(--zen-border);
            border-radius: 12px;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            margin-bottom: 24px;
            overflow: visible;
            transition: box-shadow 0.2s;
        }
        
        .zen-card:hover {
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }

        .zen-card-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--zen-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .zen-card-title {
            font-size: 1rem;
            font-weight: 600;
            color: var(--zen-text-main);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .zen-section-title {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--zen-text-muted);
            font-weight: 600;
            margin-bottom: 16px;
        }

        .zen-card-body {
            padding: 24px;
        }

        /* Profile Sidebar */
        .profile-sticky {
            position: sticky;
            top: 24px;
        }

        .profile-cover {
            position: relative;
            z-index: 0;
            height: 120px;
            background: linear-gradient(to top,transparent, #e2e8f0);
            cursor: pointer;
            overflow: hidden;
            {% if company.banner %}
                background-image: url('{{ asset('uploads/banners/' ~ company.banner) }}');
                background-size: cover;
                background-position: center;
            {% endif %}
        }

        .profile-cover:hover .profile-cover-overlay {
            opacity: 1;
        }

        .profile-cover-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.2s;
        }

        .profile-avatar-wrapper {
            position: relative;
            margin-top: -60px;
            z-index: 1;
            padding: 4px;
            background: #ffffffff;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .profile-avatar {
            position: relative;
            z-index: 2;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border: 1px solid #f3f4f6;
        }

        
        .profile-avatar img {
            max-width: 100%;
            height: auto;
        }

        .profile-avatar-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.2s;
            cursor: pointer;
            border-radius: 50%;
        }

        .profile-avatar:hover .profile-avatar-overlay {
            opacity: 1;
        }

        /* Zen Soft Buttons */
        .btn-soft-zen-primary {
            background: rgba(13, 33, 81, 0.05);
            border: 1px solid rgba(13, 33, 81, 0.1);
            color: #0d2151;
            transition: all 0.2s;
        }
        .btn-soft-zen-primary:hover {
            background: rgba(13, 33, 81, 0.1);
            color: #0d2151;
            transform: translateY(-1px);
        }
        .btn-soft-zen-danger {
            background: rgba(220, 53, 69, 0.05);
            border: 1px solid rgba(220, 53, 69, 0.1);
            color: #dc3545;
            transition: all 0.2s;
        }
        .btn-soft-zen-danger:hover {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
            transform: translateY(-1px);
        }
        .btn-zen-primary {
            background: #0d2151;
            border: none;
            color: #fff;
            font-weight: 600;
            border-radius: 50px;
            padding: 8px 24px;
            transition: all 0.3s;
        }
        .btn-zen-primary:hover {
            background: #162e64;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(13, 33, 81, 0.2);
        }
        /* Stats in Sidebar */
        .sidebar-stat {
            padding: 16px;
            border-bottom: 1px solid var(--zen-border);
        }
        .sidebar-stat:last-child {
            border-bottom: none;
        }
        
        .stat-value {
            font-size: 1.125rem;
            font-weight: 700;
            color: var(--zen-text-main);
        }
        
        .stat-label {
            font-size: 1.4rem;
            color: var(--zen-text-muted);
        }

        /* Forms & Inputs */
        .zen-input {
            border: 1px solid var(--zen-border);
            border-radius: 8px;
            padding: 10px 14px;
            transition: all 0.2s;
        }
        .zen-input:focus {
            border-color: var(--zen-accent);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }

        /* Buttons */
        .btn-zen-primary {
            background-color: var(--zen-primary);
            color: white;
            border: none;
            border-radius: 8px;
            padding: 8px 16px;
            font-weight: 500;
            transition: all 0.2s;
        }
        .btn-zen-primary:hover {
            background-color: var(--zen-primary-hover);
            color: white;
            transform: translateY(-1px);
        }

        .btn-zen-secondary {
            background-color: white;
            border: 1px solid var(--zen-border);
            color: var(--zen-text-main);
            border-radius: 8px;
            padding: 8px 16px;
            font-weight: 500;
            transition: all 0.2s;
        }
        .btn-zen-secondary:hover {
            border-color: #d1d5db;
            background-color: #f9fafb;
        }

        /* Badges */
        .badge-zen {
            background: #f3f4f6;
            color: var(--zen-text-main);
            border: 1px solid #e5e7eb;
            padding: 4px 10px;
            border-radius: 9999px;
            font-weight: 500;
            font-size: 0.75rem;
        }
        
        /* Zenith Modals */
        .modal-backdrop.show {
            opacity: 0.7;
            backdrop-filter: blur(5px);
            background-color: rgba(17, 24, 39, 0.7); /* Darker overlay */
        }

        .modal-content {
            border: none;
            border-radius: 20px; /* More rounded */
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            background: var(--zen-surface);
            overflow: hidden;
        }

        .modal-header {
            border-bottom: 1px solid var(--zen-border);
            padding: 24px 32px;
            background: #ffffff;
        }
        
        .modal-body {
            padding: 32px;
        }

        .modal-footer {
            border-top: 1px solid var(--zen-border);
            padding: 24px 32px;
            background: #fdfdfd;
        }

        /* Modal Animation - Scale In */
        .modal.fade .modal-dialog {
            transform: scale(0.95);
            opacity: 0;
            transition: transform 0.2s ease-out, opacity 0.2s ease-out;
        }
        
        .modal.show .modal-dialog {
            transform: scale(1) !important;
            opacity: 1;
        }
       
        /* Fix Z-Index & Display */
        body .modal.show {
            display: block !important;
            opacity: 1 !important;
            z-index: 1055 !important;
        }

        /* Zenith Selection Cards */
        .zen-check-card {
            display: flex;
            align-items: center;
            padding: 16px;
            border: 1px solid var(--zen-border);
            border-radius: 12px;
            background: #ffffff;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }
        
        .zen-check-card:hover {
            border-color: var(--zen-accent);
            background: #fdfdfd;
            transform: translateY(-1px);
        }

        .zen-check-card.checked {
            border-color: var(--zen-accent);
            background: rgba(99, 102, 241, 0.04);
            box-shadow: 0 4px 6px -1px rgba(99, 102, 241, 0.1);
        }

        .zen-check-card .form-check-input {
            width: 1.25em;
            height: 1.25em;
            margin-right: 12px;
            cursor: pointer;
        }

        /* Tab Specific Styles */
        .profile-tabs .nav-link {
            border-radius: 12px;
            padding: 10px 20px;
            font-weight: 600;
            color: #64748b;
            transition: all 0.2s ease;
            border: 1px solid transparent;
            background: #f8fafc;
        }
        .profile-tabs .nav-link.active {
            background: #fff !important;
            color: #111827 !important;
            border-color: #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }
        .bg-blue-soft { background-color: rgba(99, 102, 241, 0.05); }
        .hover-bg-light:hover { background-color: #f8fafc; }
        .btn-icon { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const checkCards = document.querySelectorAll('.zen-check-card');
            
            checkCards.forEach(card => {
                const input = card.querySelector('input');
                if(input && input.checked) card.classList.add('checked');
                
                if(input) {
                    input.addEventListener('change', () => {
                        if(input.type === 'radio') {
                             // clear siblings
                             const name = input.getAttribute('name');
                             document.querySelectorAll(`input[name="${name}"]`).forEach(el => {
                                 el.closest('.zen-check-card').classList.remove('checked');
                             });
                        }
                        if(input.checked) card.classList.add('checked');
                        else card.classList.remove('checked');
                    });
                }
                
                // Card click triggers input
                card.addEventListener('click', (e) => {
                    if(e.target !== input) {
                        input.click();
                    }
                });
            });

            // Password Confirmation Logic
            const changePassForm = document.getElementById('changePasswordForm');
            const newPasswordInput = document.getElementById('newPasswordInput');
            const confirmPassBtn = document.getElementById('confirmPassBtn');
            const realSubmitBtn = document.getElementById('realSubmitBtn');

            if(confirmPassBtn && realSubmitBtn && changePassForm) {
                confirmPassBtn.addEventListener('click', function() {
                    const password = newPasswordInput.value;
                    if(!password) {
                        globalAlert('Please enter a password', 'Validation Error');
                        return;
                    }
                    
                    const confirmModal = new bootstrap.Modal(document.getElementById('confirmPasswordChangeModal'));
                    confirmModal.show();
                    
                    // Hide the first modal if needed, or just stack them. 
                    // Bootstrap 5 handles stacked modals okay, but sometimes it's better to hide the first.
                    // Let's keep the first one open as the user might want to cancel the confirmation and change the password input.
                });

                realSubmitBtn.addEventListener('click', function() {
                    changePassForm.submit();
                });
            }

            // Project Edit Modal Logic
            const editProjectModal = document.getElementById('editProjectModal');
            if (editProjectModal) {
                editProjectModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget; // Button that triggered the modal
                    const projectId = button.getAttribute('data-id');
                    const projectName = button.getAttribute('data-name');
                    const projectDescription = button.getAttribute('data-description');
                    const projectStartDate = button.getAttribute('data-start');
                    const projectEndDate = button.getAttribute('data-end');

                    const form = editProjectModal.querySelector('#editProjectForm');
                    
                    document.getElementById('edit_project_name').value = projectName;
                    document.getElementById('edit_project_description').value = projectDescription;
                    document.getElementById('edit_project_start').value = projectStartDate;
                    document.getElementById('edit_project_end').value = projectEndDate;
                    
                    form.action = `/admin/projects/${projectId}/edit`;
                });
            }

            // Universal Delete Confirmation
            let deleteFormToSubmit = null;
            const confirmDeleteModal = new bootstrap.Modal(document.getElementById('confirmDeleteModal'));
            const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
            const deleteMessage = document.getElementById('deleteConfirmMessage');

            document.querySelectorAll('.btn-delete-confirm').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    deleteFormToSubmit = this.closest('form');
                    const msg = this.getAttribute('data-confirm-message') || 'This action cannot be undone.';
                    deleteMessage.textContent = msg;
                    confirmDeleteModal.show();
                });
            });

            if (confirmDeleteBtn) {
                confirmDeleteBtn.addEventListener('click', function() {
                    if (deleteFormToSubmit) deleteFormToSubmit.submit();
                });
            }
        });
    </script>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Edit Project Modal Population
            const editProjectModal = document.getElementById('editProjectModal');
            if (editProjectModal) {
                editProjectModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-id');
                    const name = button.getAttribute('data-name');
                    const description = button.getAttribute('data-description');
                    const start = button.getAttribute('data-start');
                    const end = button.getAttribute('data-end');
                    
                    document.getElementById('edit_project_name').value = name;
                    document.getElementById('edit_project_description').value = description;
                    document.getElementById('edit_project_start').value = start;
                    document.getElementById('edit_project_end').value = end;
                    
                    document.getElementById('editProjectForm').action = `/admin/projects/${id}/edit`;
                });
            }
        });
    </script>
{% endblock %}

{% block body %}
    <div class="content-wrapper">
        <div class="content-inner pb-5">
            
            
            <div class="container-xl pt-4 mb-4">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 small">
                        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}" class="text-muted text-decoration-none">Home</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('admin_company_index') }}" class="text-muted text-decoration-none">Companies</a></li>
                        <li class="breadcrumb-item active text-dark" aria-current="page">Manage Company</li>
                    </ol>
                </nav>
            </div>

            <div class="container-xl">
                <div class="row g-4">
                    
                    
                    <div class="col-lg-4 col-xl-3">
                        <div class="profile-sticky">
                            
                            
                            <div class="zen-card text-center pb-3">
                                <div class="profile-cover" data-bs-toggle="modal" data-bs-target="#updateBannerModal">
                                    <div class="profile-cover-overlay">
                                        <i class="fas fa-camera text-white fa-lg"></i>
                                    </div>
                                </div>
                                <div class="profile-avatar-wrapper">
                                    <div class="profile-avatar" style="position: relative; overflow: hidden;" data-bs-toggle="modal" data-bs-target="#updateLogoModal">
                                        {% if company.logo %}
                                            <img src="{{ asset('uploads/logos/' ~ company.logo) }}" alt="Logo">
                                        {% else %}
                                            <i class="fas fa-building fa-3x text-secondary opacity-50"></i>
                                        {% endif %}
                                        <div class="profile-avatar-overlay">
                                            <i class="fas fa-camera text-white"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="px-3 mt-3">
                                    <h5 class="fw-bold mb-1">{{ company.companyName }}</h5>
                                    {% if company.tradeName %}
                                        <p class="text-muted small mb-1">{{ company.tradeName }}</p>
                                    {% endif %}
                                    <p class="text-muted small mb-3">
                                        <i class="far fa-envelope me-1"></i> {{ company.email }}
                                    </p>
                                    
                                    <div class="d-flex justify-content-center gap-2 mb-4">
                                        <button class="btn btn-zen-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#BasicInfo">
                                            <i class="fas fa-edit me-1"></i> Edit Details
                                        </button>
                                        {% if company.Website %}
                                            <a href="{{ company.Website }}" target="_blank" class="btn btn-zen-secondary btn-sm">
                                                <i class="fas fa-external-link-alt"></i>
                                            </a>
                                        {% endif %}
                                    </div>
                                    
                                    <div class="text-start border-top">
                                        <div class="sidebar-stat d-flex justify-content-between align-items-center">
                                            <span class="stat-label">Founded</span>
                                            <span class="stat-value">{{ company.foundationYear ?: 'N/A' }}</span>
                                        </div>
                                        <div class="sidebar-stat d-flex justify-content-between align-items-center">
                                            <span class="stat-label">Employees</span>
                                            <span class="stat-value">{{ company.EmpNum ?: 0 }}</span>
                                        </div>
                                        <div class="sidebar-stat d-flex justify-content-between align-items-center">
                                            <span class="stat-label">Verified</span>
                                            {% if company.isVerified %}
                                                <span class="badge bg-success bg-opacity-10 text-success small fw-bold"><i class="fas fa-check-circle me-1"></i>Yes</span>
                                            {% else %}
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary small fw-bold">No</span>
                                            {% endif %}
                                        </div>
                                        <div class="sidebar-stat d-flex justify-content-between align-items-center">
                                            <span class="stat-label">Top Rated</span>
                                            {% if company.isTopRated %}
                                                <span class="badge bg-warning bg-opacity-10 text-warning small fw-bold"><i class="fas fa-star me-1"></i>Yes</span>
                                            {% else %}
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary small fw-bold">No</span>
                                            {% endif %}
                                        </div>
                                        <div class="sidebar-stat d-flex justify-content-between align-items-center">
                                            <span class="stat-label">Type</span>
                                            <span class="badge-zen">{{ company.entrepreneurType ? company.entrepreneurType.type : 'Standard' }}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            
                            <div class="zen-card p-0">
                                <div class="list-group list-group-flush">
                                    <button class="list-group-item list-group-item-action border-0 d-flex align-items-center gap-3" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                                        <i class="fas fa-tags text-muted fa-fw"></i>
                                        <span class="small fw-medium">Business Categories</span>
                                    </button>
                                    <button class="list-group-item list-group-item-action border-0 d-flex align-items-center gap-3" data-bs-toggle="modal" data-bs-target="#managePaymentModal">
                                        <i class="fas fa-credit-card text-muted fa-fw"></i>
                                        <span class="small fw-medium">Payment Methods</span>
                                    </button>
                                    <button class="list-group-item list-group-item-action border-0 d-flex align-items-center gap-3" data-bs-toggle="modal" data-bs-target="#Legal">
                                        <i class="fas fa-file-contract text-muted fa-fw"></i>
                                        <span class="small fw-medium">Legal Registration</span>
                                    </button>
                                    <button class="list-group-item list-group-item-action border-0 d-flex align-items-center gap-3" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                                        <i class="fas fa-key text-muted fa-fw"></i>
                                        <span class="small fw-medium">Change Password</span>
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>

                    
                    <div class="col-lg-8 col-xl-9">
                        
                        {# Tabs Navigation #}
                        <ul class="nav nav-pills mb-4 gap-2 profile-tabs" id="profileTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general-panel" type="button" role="tab" aria-controls="general-panel" aria-selected="true">
                                    <i class="fas fa-building me-2"></i>Company Info
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact-panel" type="button" role="tab" aria-controls="contact-panel" aria-selected="false">
                                    <i class="fas fa-address-book me-2"></i>Contact & Locations
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="portfolio-tab" data-bs-toggle="tab" data-bs-target="#portfolio-panel" type="button" role="tab" aria-controls="portfolio-panel" aria-selected="false">
                                    <i class="fas fa-project-diagram me-2"></i>Portfolio
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="settings-tab" data-bs-toggle="tab" data-bs-target="#settings-panel" type="button" role="tab" aria-controls="settings-panel" aria-selected="false">
                                    <i class="fas fa-cog me-2"></i>Settings
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content" id="profileTabsContent">
                            
                            {# PANEL 1: COMPANY INFORMATION #}
                            <div class="tab-pane fade show active" id="general-panel" role="tabpanel" aria-labelledby="general-tab">
                                <div class="row g-4 mb-4">
                                    <div class="col-md-6">
                                        <div class="zen-card h-100 mb-0 d-flex align-items-center px-4 py-3">
                                            <div class="bg-blue-soft rounded-circle p-2 me-3 text-primary"> <i class="fas fa-fingerprint"></i></div>
                                            <div>
                                                <div class="small fw-bold text-uppercase text-muted">Registration ID</div>
                                                <div class="fw-bold fs-5 font-monospace text-dark">{{ company.companyNum ?: 'N/A' }}</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="zen-card h-100 mb-0 d-flex align-items-center px-4 py-3">
                                            <div class="bg-blue-soft rounded-circle p-2 me-3 text-primary"> <i class="fas fa-certificate"></i></div>
                                            <div>
                                                <div class="small fw-bold text-uppercase text-muted">Licence Number</div>
                                                <div class="fw-bold fs-5 font-monospace text-dark">{{ company.licenceNum ?: 'N/A' }}</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="zen-card mb-4">
                                    <div class="zen-card-header">
                                        <div class="zen-card-title">Profile & Expertise</div>
                                        <button class="btn btn-zen-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#BasicInfo"><i class="fas fa-edit me-1"></i> Edit Details</button>
                                    </div>
                                    <div class="zen-card-body">
                                        <div class="mb-4">
                                            <label class="small fw-bold text-uppercase text-muted mb-2 d-block">About Company</label>
                                            <p class="mb-0 text-dark" style="line-height: 1.6;">{{ company.about ?: 'No description provided.' }}</p>
                                        </div>
                                        
                                        <div class="row g-4 pt-2">
                                            <div class="col-md-6">
                                                <label class="small fw-bold text-uppercase text-muted mb-2 d-block">Services</label>
                                                {% if company.services is not empty %}
                                                    <div class="d-flex flex-wrap gap-2">
                                                        {% for service in company.services %}
                                                            <span class="badge bg-light text-dark border fw-normal">{{ service }}</span>
                                                        {% endfor %}
                                                    </div>
                                                {% else %}
                                                    <span class="text-muted small italic">None listed</span>
                                                {% endif %}
                                            </div>
                                            <div class="col-md-6">
                                                <label class="small fw-bold text-uppercase text-muted mb-2 d-block">Intervention Zone</label>
                                                <p class="mb-0 text-dark fw-medium">{{ company.interventionZone ?: 'Not specified' }}</p>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="small fw-bold text-uppercase text-muted mb-2 d-block">Languages</label>
                                                <div class="d-flex gap-2">
                                                    {% if company.languages is not empty %}
                                                        {% for lang in company.languages %}
                                                            <span class="badge bg-primary bg-opacity-10 text-primary border-0">{{ lang }}</span>
                                                        {% endfor %}
                                                    {% else %}
                                                        <span class="text-muted small">Not specified</span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="small fw-bold text-uppercase text-muted mb-2 d-block">Insurance</label>
                                                {% if company.hasInsurance %}
                                                    <span class="text-success small fw-bold"><i class="fas fa-check-shield me-1"></i> Covered</span>
                                                {% else %}
                                                    <span class="text-danger small fw-bold"><i class="fas fa-times-circle me-1"></i> No Info</span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {# PANEL 2: CONTACT & LOCATIONS #}
                            <div class="tab-pane fade" id="contact-panel" role="tabpanel" aria-labelledby="contact-tab">
                                <div class="zen-card mb-4">
                                    <div class="zen-card-header">
                                        <div class="zen-card-title">Primary Contact Point</div>
                                        <button class="btn btn-zen-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#addContactModal"><i class="fas fa-user-edit me-1"></i> Manage</button>
                                    </div>
                                    <div class="zen-card-body">
                                        {% if company.primaryContact %}
                                            <div class="d-flex align-items-center gap-4">
                                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                                                    <i class="fas fa-user-circle fa-2x"></i>
                                                </div>
                                                <div>
                                                    <h6 class="fw-bold mb-1">{{ company.primaryContact.firstName }} {{ company.primaryContact.lastName }}</h6>
                                                    <div class="d-flex flex-wrap gap-3 text-muted small">
                                                        <span><i class="fas fa-envelope me-1"></i> {{ company.primaryContact.email }}</span>
                                                        <span><i class="fas fa-phone me-1"></i> {{ company.primaryContact.phone }}</span>
                                                    </div>
                                                </div>
                                            </div>
                                        {% else %}
                                            <div class="text-center py-3 text-muted">
                                                <p class="small mb-2">No primary contact assigned.</p>
                                                <button class="btn btn-link btn-sm" data-bs-toggle="modal" data-bs-target="#addContactModal">Assign Now</button>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="row g-4">
                                    <div class="col-md-7">
                                        <div class="zen-card h-100">
                                            <div class="zen-card-header">
                                                <div class="zen-card-title">Operating Locations</div>
                                                <button class="btn btn-zen-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#addAddressModal"><i class="fas fa-plus me-1"></i> Add</button>
                                            </div>
                                            <div class="zen-card-body">
                                                {% if company.Adresse is not empty %}
                                                    <div class="d-flex flex-column gap-3">
                                                        {% for address in company.Adresse %}
                                                            <div class="d-flex justify-content-between align-items-center p-2 rounded hover-bg-light">
                                                                <div class="d-flex gap-3">
                                                                    <i class="fas fa-map-marker-alt text-primary mt-1"></i>
                                                                    <div>
                                                                        <div class="fw-medium text-dark small">{{ address.street }}</div>
                                                                        <div class="text-muted" style="font-size: 0.75rem;">{{ address.city }}, {{ address.postalCode }}</div>
                                                                    </div>
                                                                </div>
                                                                <button class="btn btn-link btn-sm text-danger p-0"><i class="fas fa-trash-alt"></i></button>
                                                            </div>
                                                        {% endfor %}
                                                    </div>
                                                {% else %}
                                                    <p class="text-muted small mb-0">No locations added.</p>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-5">
                                        <div class="zen-card h-100">
                                            <div class="zen-card-header">
                                                <div class="zen-card-title">Communication</div>
                                            </div>
                                            <div class="zen-card-body">
                                                <div class="d-flex flex-column gap-2 mb-3">
                                                    {% set prefs = company.contactPrefs ?: [] %}
                                                    <div class="d-flex justify-content-between align-items-center small">
                                                        <span>Email Alerts</span>
                                                        {% if 'EMAIL_NOTIF' in prefs %}<span class="text-success fw-bold">Active</span>{% else %}<span class="text-muted">Muted</span>{% endif %}
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center small">
                                                        <span>SMS Alerts</span>
                                                        {% if 'SMS_NOTIF' in prefs %}<span class="text-success fw-bold">Active</span>{% else %}<span class="text-muted">Muted</span>{% endif %}
                                                    </div>
                                                </div>
                                                <hr>
                                                <div class="d-flex flex-wrap gap-2">
                                                    {% if company.links is not empty %}
                                                        {% for link in company.links %}
                                                            <a href="{{ link.link }}" target="_blank" class="btn btn-icon btn-sm btn-light border" title="{{ link.link }}">
                                                                <i class="fas fa-globe text-muted"></i>
                                                            </a>
                                                        {% endfor %}
                                                    {% else %}
                                                        <span class="text-muted small italic">No social links</span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {# PANEL 3: PORTFOLIO #}
                            <div class="tab-pane fade" id="portfolio-panel" role="tabpanel" aria-labelledby="portfolio-tab">
                                <div class="zen-card">
                                    <div class="zen-card-header">
                                        <div class="zen-card-title">Project Showcase</div>
                                        <button class="btn btn-zen-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addProjectModal"><i class="fas fa-plus me-1"></i> New Project</button>
                                    </div>
                                    <div class="p-0">
                                        {% if company.Projets is not empty %}
                                            <div class="table-responsive">
                                                <table class="table mb-0 align-middle">
                                                    <thead class="bg-light">
                                                        <tr>
                                                            <th class="ps-4 border-bottom-0 text-uppercase small text-muted fw-semibold py-3">Project</th>
                                                            <th class="border-bottom-0 text-uppercase small text-muted fw-semibold py-3">Timeline</th>
                                                            <th class="border-bottom-0 text-uppercase small text-muted fw-semibold py-3">Status</th>
                                                            <th class="pe-4 border-bottom-0 text-end">Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        {% for project in company.Projets %}
                                                            <tr>
                                                                <td class="ps-4 border-bottom py-3">
                                                                    <div class="fw-bold text-dark small">{{ project.name }}</div>
                                                                    <div class="text-muted text-truncate" style="max-width: 300px; font-size: 0.75rem;">{{ project.description }}</div>
                                                                </td>
                                                                <td class="border-bottom py-3 small text-muted">
                                                                    {{ project.startDate|date('M Y') }}
                                                                </td>
                                                                <td class="border-bottom py-3">
                                                                    {% if project.EndDate %}
                                                                        <span class="badge bg-light text-muted border fw-normal">Completed</span>
                                                                    {% else %}
                                                                        <span class="badge bg-success bg-opacity-10 text-success fw-normal">In Progress</span>
                                                                    {% endif %}
                                                                </td>
                                                                 <td class="pe-4 border-bottom py-3 text-end">
                                                                    <div class="d-flex justify-content-end gap-2 text-nowrap">
                                                                        <button class="btn btn-soft-zen-primary btn-sm btn-icon rounded-pill shadow-sm" 
                                                                                data-bs-toggle="modal" 
                                                                                data-bs-target="#editProjectModal"
                                                                                data-id="{{ project.id }}"
                                                                                data-name="{{ project.name }}"
                                                                                data-description="{{ project.description }}"
                                                                                data-start="{{ project.startDate|date('Y-m-d') }}"
                                                                                data-end="{{ project.EndDate ? project.EndDate|date('Y-m-d') : '' }}"
                                                                                title="Edit Project"
                                                                                style="width: 32px; height: 32px; padding: 0;">
                                                                            <i class="fas fa-edit small"></i>
                                                                        </button>
                                                                        <form action="{{ path('admin_project_delete', {'id': project.id}) }}" method="POST" class="d-inline">
                                                                            <button type="submit" class="btn btn-soft-zen-danger btn-sm btn-icon rounded-pill shadow-sm btn-delete-confirm" 
                                                                                    data-confirm-message="Are you sure you want to delete the project '{{ project.name }}'?"
                                                                                    title="Delete Project" style="width: 32px; height: 32px; padding: 0;">
                                                                                <i class="fas fa-trash-alt small"></i>
                                                                            </button>
                                                                        </form>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        {% endfor %}
                                                    </tbody>
                                                </table>
                                            </div>
                                        {% else %}
                                            <div class="text-center py-5">
                                                <div class="mb-3 text-muted opacity-25"><i class="fas fa-folder-open fa-3x"></i></div>
                                                <p class="text-muted small">Portfolio is currently empty.</p>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            {# PANEL 4: SETTINGS #}
                            <div class="tab-pane fade" id="settings-panel" role="tabpanel" aria-labelledby="settings-tab">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="zen-card h-100">
                                            <div class="zen-card-header">
                                                <div class="zen-card-title">Security & Access</div>
                                            </div>
                                            <div class="zen-card-body d-flex flex-column gap-3">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <div class="fw-bold small">Administrator Password</div>
                                                        <div class="text-muted" style="font-size: 0.75rem;">System generated or custom</div>
                                                    </div>
                                                    <button class="btn btn-outline-dark btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#changePasswordModal">Reset</button>
                                                </div>
                                                <hr class="my-0">
                                                 <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <div class="fw-bold small">Direct Link</div>
                                                        <div class="text-muted" style="font-size: 0.75rem;">View public profile</div>
                                                    </div>
                                                    <a href="{{ path('company_details', {'id': company.id}) }}" target="_blank" class="btn btn-icon btn-sm"><i class="fas fa-external-link-alt"></i></a>
                                                </div>
                                                <hr class="my-0">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <div class="fw-bold small">Agency Status</div>
                                                        <div class="text-muted" style="font-size: 0.75rem;">Last checked: {{ "now"|date("d/m/Y") }}</div>
                                                    </div>
                                                    <div class="form-check form-switch p-0">
                                                        <input class="form-check-input ms-0" type="checkbox" {% if company.isVerified %}checked{% endif %} disabled>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="zen-card h-100">
                                            <div class="zen-card-header">
                                                <div class="zen-card-title">Billing & Subscription</div>
                                                <button class="btn btn-link btn-sm p-0" data-bs-toggle="modal" data-bs-target="#managePaymentModal">Payment methods</button>
                                            </div>
                                            <div class="zen-card-body">
                                                <div class="mb-3">
                                                    <label class="small fw-bold text-uppercase text-muted mb-1 d-block">Entrepreneur Type</label>
                                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill">{{ company.entrepreneurType ? company.entrepreneurType.type : 'N/A' }}</span>
                                                </div>
                                                <div>
                                                    <label class="small fw-bold text-uppercase text-muted mb-1 d-block">Promotion</label>
                                                    {% if company.isTopRated %}
                                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill"><i class="fas fa-star me-1"></i> Top Rated</span>
                                                    {% else %}
                                                        <span class="text-muted small">Standard Listing</span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="col-12">
                                        <div class="zen-card border-danger border-opacity-10 bg-danger bg-opacity-10">
                                            <div class="zen-card-body d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h6 class="text-danger fw-bold mb-1">Critical Action</h6>
                                                    <p class="text-danger small mb-0 opacity-75">Suspending a company account disables all sub-profiles and active leads.</p>
                                                </div>
                                                <form action="{{ path('admin_company_delete', {'id': company.id}) }}" method="POST">
                                                    <button type="submit" class="btn btn-danger px-4 btn-delete-confirm" data-confirm-message="Warning: Suspending this company will revoke all public visibility and access for the main account and all sub-profiles. Proceed?">Suspend Company Account</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    
    
    
    <div class="modal fade" id="BasicInfo" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom-0 px-4 pt-4">
