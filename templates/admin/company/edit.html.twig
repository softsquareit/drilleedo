                                    {{ form_widget(form1.email, {'attr': {'class': 'form-control zen-input'}}) }}
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Phone Number</label>
                                    {{ form_widget(form1.phoneNum, {'attr': {'class': 'form-control zen-input'}}) }}
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Website URL</label>
                                    {{ form_widget(form1.Website, {'attr': {'class': 'form-control zen-input', 'placeholder': 'https://...'}}) }}
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Founded Year</label>
                                    {{ form_widget(form1.foundationYear, {'attr': {'class': 'form-control zen-input'}}) }}
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Total Employees</label>
                                    {{ form_widget(form1.EmpNum, {'attr': {'class': 'form-control zen-input'}}) }}
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Business Type</label>
                                    {{ form_widget(form1.entrepreneurType, {'attr': {'class': 'form-select zen-input'}}) }}
                                </div>
                            </div>
                        </div>

                        {# Tab 2: Expertise & Settings #}
                        <div class="tab-pane fade" id="comp-expert-panel" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Languages</label>
                                    {{ form_widget(form1.languages, {'attr': {'class': 'form-select select2 zen-input'}}) }}
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Intervention Zone</label>
                                    {{ form_widget(form1.interventionZone, {'attr': {'class': 'form-control zen-input', 'placeholder': 'e.g. Region or City'}}) }}
                                </div>

                                <div class="col-12">
                                    <label class="form-label small fw-bold text-uppercase text-muted">About the Company</label>
                                    {{ form_widget(form1.about, {'attr': {'class': 'form-control zen-input', 'rows': 4}}) }}
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Why Choose Us</label>
                                    <small class="d-block text-muted mb-1" style="font-size: 0.7rem;">One item per line</small>
                                    {{ form_widget(form1.whyChooseUs, {'attr': {'class': 'form-control zen-input', 'rows': 3}}) }}
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Services Provided</label>
                                    <small class="d-block text-muted mb-1" style="font-size: 0.7rem;">One item per line</small>
                                    {{ form_widget(form1.services, {'attr': {'class': 'form-control zen-input', 'rows': 3}}) }}
                                </div>

                                <div class="col-12 pt-2">
                                     <label class="form-label small fw-bold text-uppercase text-muted d-block mb-3">Status Badges</label>
