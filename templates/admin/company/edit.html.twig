                                        </div>
                                        <div class="form-check form-switch custom-switch">
                                            {{ form_widget(form1.isTopRated) }}
                                            <label class="form-check-label small fw-bold text-dark ms-2">Top Rated</label>
                                        </div>
                                     </div>
                                </div>

                                <div class="col-12 mt-3">
                                    <label class="form-label small fw-bold text-uppercase text-muted mb-2">Notification Preferences</label>
                                    <div class="bg-light p-3 rounded-3 border-dashed d-flex flex-wrap gap-3">
                                        {{ form_widget(form1.contactPrefs) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 px-4 pb-4">
