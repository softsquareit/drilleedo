{% block javascripts %}
    {{ parent() }}
    <script>
        function bindDeleteConfirmation() {
            const deleteButtons = document.querySelectorAll('.btn-delete-confirm');
            const confirmModalElement = document.getElementById('confirmDeleteModal');
            if (!confirmModalElement) return;
            const confirmModal = bootstrap.Modal.getOrCreateInstance(confirmModalElement);
            const confirmBtn = document.getElementById('confirmDeleteBtn');
            const confirmMsg = document.getElementById('deleteConfirmMessage');

            deleteButtons.forEach(btn => {
                if (btn.hasAttribute('data-listener-attached')) return;
                btn.setAttribute('data-listener-attached', 'true');

                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const msg = this.getAttribute('data-confirm-message') || "Voulez-vous vraiment supprimer cet élément ?";
                    if (confirmMsg) confirmMsg.textContent = msg;
                    
                    const url = this.tagName === 'A' ? this.href : null;
                    const form = this.tagName === 'BUTTON' ? this.closest('form') : null;

                    const newConfirmBtn = confirmBtn.cloneNode(true);
                    confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);
                    
                    newConfirmBtn.addEventListener('click', function() {
                        if (url) window.location.href = url;
                        if (form) form.submit();
                        confirmModal.hide();
                    });
                    
                    confirmModal.show();
                });
            });
        }

        function bindAjaxDelete() {
            const ajaxDeleteBtns = document.querySelectorAll('.btn-delete-confirm-ajax');
            const confirmModalElement = document.getElementById('confirmDeleteModal');
            if (!confirmModalElement) return;
            const confirmModal = bootstrap.Modal.getOrCreateInstance(confirmModalElement);
            const confirmBtn = document.getElementById('confirmDeleteBtn');
            const confirmMsg = document.getElementById('deleteConfirmMessage');

            ajaxDeleteBtns.forEach(btn => {
                if (btn.hasAttribute('data-listener-attached')) return;
                btn.setAttribute('data-listener-attached', 'true');

                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const url = this.href;
                    const msg = this.getAttribute('data-confirm-message') || "Voulez-vous vraiment supprimer cet élément ?";
                    if (confirmMsg) confirmMsg.textContent = msg;
                    
                    const parentDiv = this.closest('div.text-center');

                    const handler = function() {
                        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    parentDiv.remove();
                                } else {
                                    alert(data.message || 'Erreur lors de la suppression');
                                }
                            })
                            .catch(error => console.error('Error:', error));
                        
                        confirmModal.hide();
                        confirmBtn.removeEventListener('click', handler);
                    };

                    const newConfirmBtn = confirmBtn.cloneNode(true);
                    confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);
                    newConfirmBtn.addEventListener('click', handler);

                    confirmModal.show();
                });
            });
        }

        function populateProjectModal(id, name, start, end, description, state, mainPhoto, galleryJson) {
            const form = document.getElementById('editProjectForm');
            form.action = '/admin/professional/project/update/' + id;  // uses shared project update route
            document.getElementById('edit_project_name').value = name;
            document.getElementById('edit_project_start').value = start;
            document.getElementById('edit_project_end').value = end;
            document.getElementById('edit_project_description').value = description.replace(/<br\s*\/?>/mg, '');
            document.getElementById('edit_project_state').checked = (state == 1);

            const mainPhotoContainer = document.getElementById('existing_main_photo');
            const galleryContainer = document.getElementById('existing_gallery_container');
            
            mainPhotoContainer.innerHTML = '';
            galleryContainer.innerHTML = '';

            if (mainPhoto && mainPhoto !== 'null' && mainPhoto !== '') {
                const photoUrl = `/uploads/projects/${mainPhoto}`;
                mainPhotoContainer.innerHTML = `
                    <img src="${photoUrl}" class="rounded shadow-sm border" style="width: 80px; height: 80px; object-fit: cover;">
                `;
                document.getElementById('project-edit-preview').src = photoUrl;
            } else {
                document.getElementById('project-edit-preview').src = '/assets/images/placeholder.jpg';
            }

            if (galleryJson && galleryJson !== 'null') {
                try {
                    const gallery = JSON.parse(galleryJson);
                    if (Array.isArray(gallery)) {
                        gallery.forEach(img => {
                            const div = document.createElement('div');
                            div.className = 'text-center position-relative';
                            div.innerHTML = `
                                <img src="/uploads/projects/${img}" class="rounded shadow-sm border bg-white" style="width: 60px; height: 60px; object-fit: cover;">
                                <a href="/admin/projects/${id}/delete-image?type=gallery&image=${img}" class="position-absolute top-0 start-100 translate-middle badge rounded-circle bg-danger border border-light p-1 btn-delete-confirm-ajax" data-confirm-message="Supprimer cette image ?">
                                    <i class="fas fa-times fa-xs"></i>
                                </a>
                            `;
                            galleryContainer.appendChild(div);
                        });
                    }
                } catch(e) {}
            }
            
            bindAjaxDelete();
        }

        document.addEventListener('DOMContentLoaded', function() {
            bindDeleteConfirmation();
            bindAjaxDelete();
        });
    </script>
{% endblock %}
