{% extends 'admin/base_admin.html.twig' %}

{% block title %}Company Management | Admin{% endblock %}



{% block body %}
    <div class="content-wrapper">
        <div class="content px-4">
            
            
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                     <h4 class="mb-0 fw-bold text-dark">Companies</h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}" class="text-muted small">Home</a></li>
                            <li class="breadcrumb-item active small" aria-current="page">Companies</li>
                        </ol>
                    </nav>
                </div>
                <button type="button" class="btn btn-primary shadow-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addCompanyModal">
                    <i class="fas fa-plus me-2"></i>Add Company
                </button>
            </div>

            
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-check-circle me-2"></i>
                        {{ message }}
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                 <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        {{ message }}
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 py-4 px-4 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fas fa-building"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold text-dark">All Companies</h5>
                            <p class="text-muted small mb-0">{{ companies|length }} registered</p>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <div class="position-relative">
                            <input type="text" class="form-control ps-5 rounded-pill border-0 bg-light" placeholder="Search..." id="companySearch" style="width: 250px;">
                            <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        </div>
                        <select class="form-select rounded-pill border-0 bg-light w-auto text-muted ps-3 pe-5" id="statusFilter">
                            <option value="all">All Status</option>
                            <option value="verified">Verified</option>
                            <option value="pending">Pending</option>
                        </select>
                    </div>
                </div>

                <div class="table-responsive">
                     <table class="table datatable-button-html5-columns">
                        <thead class="bg-light bg-opacity-50">
                            <tr>
                                <th class="border-0 px-4 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 5%;">#</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 10%;">ID</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 25%;">Company Name</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 40%;">Expertise & Capacity</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 10%;">Status</th>
                                <th class="border-0 px-4 py-3 text-end text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 10%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for company in companies %}
                            <tr class="border-bottom border-light">
                                <td class="px-4 text-muted fw-semibold">{{ loop.index }}</td>
                                <td><span class="badge bg-light text-secondary border rounded-2 px-2 py-1 user-select-all">#{{ company.id }}</span></td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2 me-3 d-flex align-items-center justify-content-center border border-primary-subtle" style="width: 40px; height: 40px;">
                                            <i class="fas fa-building small"></i>
                                        </div>
                                        <div>
                                            <span class="d-block fw-bold text-dark">{{ company.companyName }}</span>
                                            <small class="text-muted">{{ company.email }}</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        {% if company.languages is not empty %}
                                            {% for lang in company.languages %}
                                                <span class="badge bg-light text-primary border-0 small" style="font-size: 0.7rem;">{{ lang }}</span>
                                            {% endfor %}
                                        {% endif %}
                                        {% if company.hasInsurance %}
                                            <span class="badge bg-success bg-opacity-10 text-success border-0 small" title="Insured" style="font-size: 0.7rem;"><i class="fas fa-shield-alt"></i></span>
                                        {% endif %}
                                        {% if company.EmpNum %}
                                            <span class="badge bg-info bg-opacity-10 text-info border-0 small" title="Employees" style="font-size: 0.7rem;"><i class="fas fa-users-cog"></i> {{ company.EmpNum }}</span>
                                        {% endif %}
                                    </div>
                                    <div class="text-muted small text-truncate mt-1" style="max-width: 300px;">
                                         {{ company.about|length > 60 ? company.about|slice(0, 60) ~ '...' : company.about ?: 'No description' }}
                                    </div>
                                </td>
                                <td>
                                     {% if company.isVerified %}
                                         <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 status-badge">
                                            <i class="fas fa-check-circle me-1 small"></i> Verified
                                         </span>
                                     {% else %}
                                         <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2 status-badge">
                                            <i class="fas fa-clock me-1 small"></i> Pending
                                         </span>
                                     {% endif %}
                                </td>
                                <td class="px-4 text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="{{ path('admin_company_edit', {id: company.id}) }}" class="btn btn-sm btn-light text-primary btn-icon rounded-circle shadow-sm" title="Edit Details" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-edit small"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-light text-danger btn-icon rounded-circle shadow-sm" title="Delete Company" 
                                                data-bs-toggle="modal" data-bs-target="#confirmDeleteModal"
                                                data-action="{{ path('admin_company_delete', {id: company.id}) }}"
                                                data-token="{{ csrf_token('delete' ~ company.id) }}"
                                                style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-trash-alt small"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="d-flex flex-column align-items-center justify-content-center p-5">
                                        <div class="bg-light rounded-circle p-4 mb-4">
                                            <i class="fas fa-folder-open fa-3x text-muted opacity-25"></i>
                                        </div>
                                        <h5 class="text-dark fw-bold mb-2">No Companies Found</h5>
                                        <p class="text-muted mb-4">Get started by adding a new company to the system.</p>
                                        <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addCompanyModal">
                                            <i class="fas fa-plus me-2"></i> Add First Company
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                <div class="card-footer bg-white border-0 py-3 px-4 rounded-bottom-4">
                    <small class="text-muted fw-medium">Showing {{ companies|length }} entries</small>
                </div>
            </div>

        </div>
    </div>


<div class="modal fade" id="addCompanyModal" tabindex="-1" aria-labelledby="addCompanyLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-white border-0 py-4 px-4">
                <h5 class="modal-title fw-bold text-dark" id="addCompanyLabel">Add New Company</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="{{ path('admin_company_create') }}" method="POST" enctype="multipart/form-data">
                <div class="modal-body p-4 pt-0">
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Company Name <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden">
                             <span class="input-group-text bg-light border-0 text-muted ps-4"><i class="fas fa-building"></i></span>
                            <input type="text" class="form-control bg-light border-0 ps-3" name="company_name" required placeholder="e.g. Acme Corp" style="font-size: 0.95rem;">
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Primary Email <span class="text-danger">*</span></label>
                         <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden">
                             <span class="input-group-text bg-light border-0 text-muted ps-4"><i class="fas fa-envelope"></i></span>
                            <input type="email" class="form-control bg-light border-0 ps-3" name="email" required placeholder="contact@company.com" style="font-size: 0.95rem;">
                        </div>
                    </div>
                     <input type="hidden" name="_source" value="manual_company">
                </div>
                <div class="modal-footer bg-light bg-opacity-50 border-0 py-3 px-4 rounded-bottom-4 justify-content-between">
                    <button type="button" class="btn btn-link text-muted text-decoration-none fw-medium" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                        <i class="fas fa-check me-2"></i> Create Company
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    $(document).ready(function() {
        const table = $('.datatable-button-html5-columns').DataTable();
        
        // Custom search input integration
        $('#companySearch').on('keyup', function() {
            table.search(this.value).draw();
        });
        
        // Status Filter integration
        $('#statusFilter').on('change', function() {
            const val = this.value;
            if (val === 'all') {
                table.column(4).search('').draw();
            } else {
                table.column(4).search(val === 'verified' ? 'Verified' : 'Pending').draw();
            }
        });
    });
</script>
{% endblock %}