{% extends 'admin/base_admin.html.twig' %}

{% block title %}User Management | Admin{% endblock %}

{% block body %}
    <div class="content-wrapper">
        <div class="content px-4">
            
            
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                     <h4 class="mb-0 fw-bold text-dark">User Management</h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}" class="text-muted small">Home</a></li>
                            <li class="breadcrumb-item active small" aria-current="page">All Users</li>
                        </ol>
                    </nav>
                </div>
            </div>

             
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-check-circle me-2"></i>
                        {{ message }}
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                 <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        {{ message }}
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 py-4 px-4 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fas fa-users-cog"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold text-dark">All Registered Users</h5>
                            <p class="text-muted small mb-0">{{ users|length }} total accounts</p>
                        </div>
                    </div>
                    
                    <div class="d-flex gap-2">
                         <div class="position-relative">
                            <input type="text" class="form-control ps-5 rounded-pill border-0 bg-light" placeholder="Search system users..." id="systemUserSearch" style="width: 250px;">
                            <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                     <table class="table datatable-button-html5-columns">
                        <thead class="bg-light bg-opacity-50">
                            <tr>
                                <th class="border-0 px-4 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 5%;">#</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 10%;">ID</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 30%;">User Identity</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 20%;">Type</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 20%;">Roles</th>
                                <th class="border-0 px-4 py-3 text-end text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 15%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in users %}
                                {% set userType = user.getType() %}
                                <tr class="border-bottom border-light">
                                    <td class="px-4 text-muted fw-semibold">{{ loop.index }}</td>
                                    <td><span class="badge bg-light text-secondary border rounded-2 px-2 py-1 user-select-all">#{{ user.id }}</span></td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                             <div class="rounded-circle p-2 me-3 d-flex align-items-center justify-content-center border" style="width: 40px; height: 40px; background-color: {% if userType == 'Admin' %}#fef3c7{% elseif userType == 'Company' %}#e0e7ff{% elseif userType == 'Professional' %}#d1fae5{% else %}#f3f4f6{% endif %}; color: {% if userType == 'Admin' %}#d97706{% elseif userType == 'Company' %}#4f46e5{% elseif userType == 'Professional' %}#059669{% else %}#6b7280{% endif %};">
                                                {% if userType == 'Admin' %}
                                                    <i class="fas fa-shield-alt small"></i>
                                                {% elseif userType == 'Company' %}
                                                    <i class="fas fa-building small"></i>
                                                {% elseif userType == 'Professional' %}
                                                    <i class="fas fa-user-tie small"></i>
                                                {% else %}
                                                    <i class="fas fa-user small"></i>
                                                {% endif %}
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block text-truncate" style="max-width: 200px;">
                                                    {% if user.personalInfos %}
                                                        {{ user.personalInfos.firstName }} {{ user.personalInfos.lastName }}
                                                    {% elseif user.companyName is defined and user.companyName %}
                                                        {{ user.companyName }}
                                                    {% else %}
                                                        {{ user.email }} (No Name)
                                                    {% endif %}
                                                </span>
                                                <span class="small text-muted">{{ user.email }}</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill border px-3 py-1 fw-medium
                                            {% if userType == 'Admin' %}bg-warning bg-opacity-10 text-warning border-warning-subtle
                                            {% elseif userType == 'Company' %}bg-primary bg-opacity-10 text-primary border-primary-subtle
                                            {% elseif userType == 'Professional' %}bg-success bg-opacity-10 text-success border-success-subtle
                                            {% else %}bg-secondary bg-opacity-10 text-secondary border-secondary-subtle{% endif %}">
                                            {{ userType }}
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            {% for role in user.roles %}
                                                <span class="badge bg-light text-muted border fw-normal" style="font-size: 1rem;">{{ role|replace({'ROLE_': ''}) }}</span>
                                            {% endfor %}
                                        </div>
                                    </td>
                                    <td class="px-4 text-end">
                                        <div class="dropdown">
                                            <button class="btn btn-light btn-sm btn-icon rounded-circle shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 32px; height: 32px;">
                                                <i class="fas fa-ellipsis-v text-muted small"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-3 mt-2">
                                                
                                                {% set editRoute = '' %}
                                                {% if userType == 'Individual' %}
                                                    {% set editRoute = 'admin_individual_edit' %}
                                                {% elseif userType == 'Professional' %}
                                                    {% set editRoute = 'admin_professional_edit' %}
                                                {% elseif userType == 'Company' %}
                                                    {% set editRoute = 'admin_company_edit' %}
                                                {% endif %}

                                                {% if editRoute %}
                                                    <li>
                                                        <a class="dropdown-item py-2 px-3 fw-medium" href="{{ path(editRoute, {id: user.id}) }}">
                                                            <i class="fas fa-edit me-2 text-primary opacity-75"></i> Edit Profile
                                                        </a>
                                                    </li>
                                                {% else %}
                                                    <li><span class="dropdown-item py-2 px-3 fw-medium text-muted disabled"><i class="fas fa-ban me-2"></i> No Edit View</span></li>
                                                {% endif %}
                                                
                                                <li><hr class="dropdown-divider bg-light my-1"></li>
                                                
                                                <li>
                                                    <a href="#" class="dropdown-item py-2 px-3 fw-medium text-danger" 
                                                       onclick="if(confirm('Are you sure you want to delete this user? This action cannot be undone.')) { document.getElementById('delete-user-{{ user.id }}').submit(); return false; }">
                                                        <i class="fas fa-trash-alt me-2 opacity-75"></i> Delete User
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                        
                                        <form id="delete-user-{{ user.id }}" action="{{ path('admin_user_delete', {'id': user.id}) }}" method="POST" style="display: none;">
                                        </form>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        <h5 class="text-muted">No users found.</h5>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                 <div class="card-footer bg-white border-0 py-3 px-4 rounded-bottom-4">
                    <small class="text-muted fw-medium">Showing {{ users|length }} entries</small>
                </div>
            </div>

        </div>
    </div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Search
        const searchInput = document.getElementById('systemUserSearch');
        if (searchInput) {
            searchInput.addEventListener('keyup', function() {
                const searchTerm = this.value.toLowerCase();
                const rows = document.querySelectorAll('table tbody tr');
                rows.forEach(row => {
                    if(row.querySelector('td[colspan]')) return;
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(searchTerm) ? '' : 'none';
                });
            });
        }
    });
</script>
{% endblock %}
