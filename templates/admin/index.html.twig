{% extends 'admin/base_admin.html.twig' %}

{% block title %}Admin Dashboard | Premium{% endblock %}



{% block body %}
    <div class="content-wrapper">
        <div class="content-inner">
            
            <div class="page-header page-header-light shadow-sm">
                <div class="page-header-content d-lg-flex">
                    <div class="d-flex">
                        <h4 class="page-title mb-0">
                            Dashboard - <span class="fw-normal">Overview</span>
                        </h4>
                    </div>
                </div>

                <div class="page-header-content d-lg-flex border-top">
                    <div class="d-flex">
                        <div class="breadcrumb py-2">
                            <a href="{{ path('admin_dashboard') }}" class="breadcrumb-item"><i class="fas fa-home"></i></a>
                            <span class="breadcrumb-item active">Dashboard</span>
                        </div>
                    </div>
                </div>
            </div>
            

            
            <div class="content px-4">

            
            <div class="row g-4">
                
                <div class="col-sm-6 col-xl-4">
                    <div class="card border-0 shadow rounded-4 h-100 position-relative link-card-hover" style="transition: all 0.3s ease;">
                        <div class="card-body p-4 p-xl-5">
                            <div class="d-flex align-items-start justify-content-between mb-4">
                                <div class="icon-box bg-success bg-opacity-10 text-success rounded-4 p-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                    <i class="fas fa-building fa-xl"></i>
                                </div>
                                <div class="dropdown">
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-semibold">+12% growth</span>
                                </div>
                            </div>
                            <h2 class="fw-bold text-dark mb-1 display-6">{{ companies }}</h2>
                             <p class="text-muted fw-medium mb-4">Registered Companies</p>
                            <a href="{{ path('admin_company_index') }}" class="btn btn-light bg-light-subtle text-success fw-bold w-100 rounded-pill py-2 stretched-link border-0">
                                Manage Companies <i class="fas fa-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>

                
                <div class="col-sm-6 col-xl-4">
                    <div class="card border-0 shadow rounded-4 h-100 position-relative link-card-hover" style="transition: all 0.3s ease;">
                        <div class="card-body p-4 p-xl-5">
                            <div class="d-flex align-items-start justify-content-between mb-4">
                                <div class="icon-box bg-primary bg-opacity-10 text-primary rounded-4 p-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                    <i class="fas fa-user-tie fa-xl"></i>
                                </div>
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-semibold">+5% growth</span>
                            </div>
                            <h2 class="fw-bold text-dark mb-1 display-6">{{ professionals }}</h2>
                            <p class="text-muted fw-medium mb-4">Active Professionals</p>
                            <a href="{{ path('admin_professionnel_index') }}" class="btn btn-light bg-light-subtle text-primary fw-bold w-100 rounded-pill py-2 stretched-link border-0">
                                Manage Professionals <i class="fas fa-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>

                
                <div class="col-sm-6 col-xl-4">
                    <div class="card border-0 shadow rounded-4 h-100 position-relative link-card-hover" style="transition: all 0.3s ease;">
                        <div class="card-body p-4 p-xl-5">
                            <div class="d-flex align-items-start justify-content-between mb-4">
                                <div class="icon-box bg-info bg-opacity-10 text-info rounded-4 p-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                    <i class="fas fa-user fa-xl"></i>
                                </div>
                                <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-2 fw-semibold">+8% growth</span>
                            </div>
                            <h2 class="fw-bold text-dark mb-1 display-6">{{ individuals }}</h2>
                            <p class="text-muted fw-medium mb-4">Individual Users</p>
                            <a href="{{ path('admin_individual_index') }}" class="btn btn-light bg-light-subtle text-info fw-bold w-100 rounded-pill py-2 stretched-link border-0">
                                Manage Individuals <i class="fas fa-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>

                
                <div class="col-sm-6 col-xl-4">
                    <div class="card border-0 shadow rounded-4 h-100 position-relative link-card-hover" style="transition: all 0.3s ease;">
                        <div class="card-body p-4 p-xl-5">
                            <div class="d-flex align-items-start justify-content-between mb-4">
                                <div class="icon-box bg-danger bg-opacity-10 text-danger rounded-4 p-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                    <i class="fas fa-newspaper fa-xl"></i>
                                </div>
                                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 fw-semibold">Content</span>
                            </div>
                            <h2 class="fw-bold text-dark mb-1 display-6">{{ blogs }}</h2>
                            <p class="text-muted fw-medium mb-4">Blog Posts</p>
                            <a href="{{ path('admin_blog_index') }}" class="btn btn-light bg-light-subtle text-danger fw-bold w-100 rounded-pill py-2 stretched-link border-0">
                                Manage Content <i class="fas fa-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>

                
                <div class="col-sm-6 col-xl-4">
                    <div class="card border-0 shadow rounded-4 h-100 position-relative link-card-hover" style="transition: all 0.3s ease;">
                        <div class="card-body p-4 p-xl-5">
                            <div class="d-flex align-items-start justify-content-between mb-4">
                                <div class="icon-box bg-warning bg-opacity-10 text-warning rounded-4 p-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                    <i class="fas fa-tags fa-xl"></i>
                                </div>
                                <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-2 fw-semibold">Structure</span>
                            </div>
                            <h2 class="fw-bold text-dark mb-1 display-6">{{ categories }}</h2>
                            <p class="text-muted fw-medium mb-4">Business Categories</p>
                            <a href="{{ path('admin_category_index') }}" class="btn btn-light bg-light-subtle text-warning fw-bold w-100 rounded-pill py-2 stretched-link border-0">
                                Manage Categories <i class="fas fa-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>

                
                <div class="col-sm-6 col-xl-4">
                    <div class="card border-0 shadow rounded-4 h-100 position-relative link-card-hover" style="transition: all 0.3s ease;">
                        <div class="card-body p-4 p-xl-5">
                            <div class="d-flex align-items-start justify-content-between mb-4">
                                <div class="icon-box bg-secondary bg-opacity-10 text-secondary rounded-4 p-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                    <i class="fas fa-layer-group fa-xl"></i>
                                </div>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 fw-semibold">Config</span>
                            </div>
                            <h2 class="fw-bold text-dark mb-1 display-6">{{ types }}</h2>
                            <p class="text-muted fw-medium mb-4">Entrepreneur Types</p>
                            <a href="{{ path('admin_type_index') }}" class="btn btn-light bg-light-subtle text-secondary fw-bold w-100 rounded-pill py-2 stretched-link border-0">
                                Manage Types <i class="fas fa-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            
            
            <div class="row mt-4">
                <div class="col-12">
                     <div class="card border-0 shadow rounded-4 overflow-hidden">
                        <div class="card-header bg-white border-bottom py-3 px-4 px-xl-5">
                            <h5 class="fw-bold text-dark mb-0">System Overview</h5>
                        </div>
                        <div class="card-body p-4 p-xl-5">
                            <div class="alert alert-success border-0 bg-success bg-opacity-10 rounded-pill d-flex align-items-center py-3 px-4" role="alert">
                                <i class="fas fa-check-circle text-success me-3 fa-xl"></i>
                                <div>
                                    <span class="fw-bold text-dark">System Operational</span>
                                    <span class="ms-2 text-muted small">All services running normally</span>
                                </div>
                            </div>
                        </div>
                     </div>
                </div>
            </div>

            </div>
        </div>
    </div>
{% endblock %}
