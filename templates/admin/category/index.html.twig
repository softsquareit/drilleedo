{% extends 'admin/base_admin.html.twig' %}

{% block title %}Admin Dashboard | Premium{% endblock %}



{% block body %}
    <div class="content-wrapper">
        <div class="content-inner">
            <div class="content px-4">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                     <h4 class="mb-0 fw-bold text-dark">Categories</h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}" class="text-muted small">Home</a></li>
                            <li class="breadcrumb-item active small" aria-current="page">Categories</li>
                        </ol>
                    </nav>
                </div>
                <button type="button" class="btn btn-primary shadow-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                    <i class="fas fa-plus me-2"></i>Add Category
                </button>
            </div>

             
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-check-circle me-2"></i>
                        {{ message }}
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                 <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        {{ message }}
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 py-4 px-4 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fas fa-tags"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold text-dark">All Categories</h5>
                            <p class="text-muted small mb-0">{{ categories|length }} items total</p>
                        </div>
                    </div>
                    
                    <div class="d-flex gap-2">
                         <div class="position-relative">
                            <input type="text" class="form-control ps-5 rounded-pill border-0 bg-light" placeholder="Search..." id="categorySearch" style="width: 250px;">
                            <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        </div>
                        <select class="form-select rounded-pill border-0 bg-light w-auto text-muted ps-3 pe-5" id="statusFilter">
                            <option value="all">All Status</option>
                            <option value="active">Published</option>
                            <option value="inactive">Hidden</option>
                        </select>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table datatable-button-html5-columns">
                        <thead class="bg-light bg-opacity-50">
                            <tr>
                                <th class="border-0 px-4 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 5%;">#</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 10%;">ID</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 25%;">Category Name</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 15%;">Visuals</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 15%;">Hierarchy</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 15%;">Related</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 10%;">Status</th>
                                <th class="border-0 px-4 py-3 text-end text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 5%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for category in categories %}
                            <tr class="border-bottom border-light">
                                <td class="px-4 text-muted fw-semibold">{{ loop.index }}</td>
                                <td><span class="badge bg-light text-secondary border rounded-2 px-2 py-1 user-select-all">#{{ category.id }}</span></td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded-3 p-2 me-3 d-flex align-items-center justify-content-center border" 
                                             style="width: 40px; height: 40px; border-color: {{ category.color|default('#ffc107') }} !important; background-color: {{ category.color|default('#ffc107') }}1a !important;">
                                            {% if category.icon %}
                                                <img src="{{ asset('uploads/categories/' ~ category.icon) }}" alt="" style="width: 24px; height: 24px; object-fit: contain;">
                                            {% else %}
                                                <i class="fas fa-folder-open small" style="color: {{ category.color|default('#ffc107') }}"></i>
                                            {% endif %}
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark d-block">{{ category.name }}</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle border shadow-sm" style="width: 20px; height: 20px; background-color: {{ category.color|default('#eee') }};" title="Category Color"></div>
                                        <span class="small text-muted font-monospace">{{ category.color|default('None') }}</span>
                                    </div>
                                </td>
                                <td>
                                    {% if category.parent %}
                                        <div class="d-flex align-items-center text-muted small">
                                            <div class="border-start border-bottom border-secondary ms-1 me-2" style="width: 10px; height: 10px; opacity: 0.3;"></div>
                                            <span class="fw-medium text-dark">{{ category.parent.name }}</span>
                                        </div>
                                    {% else %}
                                        <span class="badge bg-light text-secondary border rounded-pill fw-normal px-2">Root Category</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-2">
                                        {{ category.companies|length }} Companies
                                    </span>
                                </td>
                                <td>
                                    {% if category.isActive %}
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2">
                                            <i class="fas fa-check-circle me-1 small"></i> Published
                                        </span>
                                    {% else %}
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2">
                                            <i class="fas fa-times-circle me-1 small"></i> Hidden
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="px-4 text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <button class="btn btn-sm btn-light text-primary btn-icon rounded-circle shadow-sm" type="button" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#editCategoryModal"
                                                data-id="{{ category.id }}"
                                                data-name="{{ category.name }}"
                                                data-title-en="{{ category.titleEn }}"
                                                data-title-fr="{{ category.titleFr }}"
                                                data-parent="{{ category.parent ? category.parent.id : '' }}"
                                                data-color="{{ category.rawColor|default('#ffc107') }}"
                                                data-active="{{ category.isActive ? '1' : '0' }}"
                                                data-icon="{{ category.rawIcon }}"
                                                data-banner="{{ category.getBanner() }}"
                                                title="Edit Details"
                                                style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-edit small"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-light text-danger btn-icon rounded-circle shadow-sm" 
                                                title="Delete Category"
                                                data-bs-toggle="modal" data-bs-target="#confirmDeleteModal"
                                                data-action="{{ path('admin_category_delete', {'id': category.id}) }}"
                                                data-token="{{ csrf_token('delete' ~ category.id) }}"
                                                style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-trash-alt small"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="d-flex flex-column align-items-center justify-content-center p-5">
                                        <div class="bg-light rounded-circle p-4 mb-4">
                                            <i class="fas fa-tags fa-3x text-muted opacity-25"></i>
                                        </div>
                                        <h5 class="text-dark fw-bold mb-2">No Categories Found</h5>
                                        <p class="text-muted mb-4">Organize your content by adding categories.</p>
                                        <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                                            <i class="fas fa-plus me-2"></i> Create First Category
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>


<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-white border-0 py-4 px-4">
                <h5 class="modal-title fw-bold text-dark" id="addCategoryLabel">New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
             <form action="{{ path('admin_category_create') }}" method="POST" enctype="multipart/form-data" id="addCategoryForm">
                <div class="modal-body p-4 pt-0">
                     <div class="mb-4">
                        <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Category Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-lg bg-light border-0 rounded-3 fs-6" name="category[name]" required placeholder="e.g. Construction">
                        <input type="hidden" name="category[_token]" value="{{ csrf_token('category') }}">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Title (English) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-lg bg-light border-0 rounded-3 fs-6" name="category[titleEn]" required placeholder="e.g. Construction">
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Title (French) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-lg bg-light border-0 rounded-3 fs-6" name="category[titleFr]" required placeholder="e.g. Construction">
                        </div>
                    </div>
                    <div class="mb-4">
                         <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Parent Category</label>
                         <div class="input-group input-group-lg bg-light border-0 rounded-3 overflow-hidden">
                            <span class="input-group-text bg-transparent border-0 text-muted ps-3"><i class="fas fa-network-wired"></i></span>
                            <select class="form-select bg-transparent border-0 fs-6 ps-2" name="category[parent]">
                                <option value="">No Parent (Root Category)</option>
                                {% for cat in categories %}
                                    <option value="{{ cat.id }}">{{ cat.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Icon (Image)</label>
                            <label for="add_category_iconFile" class="zen-upload-container p-3 border-2 border-dashed rounded-4 bg-light cursor-pointer d-block" 
                                 style="border-style: dashed !important; border-color: #dee2e6 !important;">
                                <div class="text-muted mb-1 text-center"><i class="fas fa-cloud-upload-alt fa-lg"></i></div>
                                <div class="small fw-bold text-center">Select Icon</div>
                            </label>
                            <input type="file" id="add_category_iconFile" class="category-icon-input d-none" name="category[iconFile]" onchange="previewImage(this, 'add-category-icon-preview')">
                            <div class="mt-2 text-center">
                                <img id="add-category-icon-preview" src="{{ asset('assets/images/placeholder.jpg') }}" class="rounded-3 shadow-sm icon-preview-img" style="width: 48px; height: 48px; object-fit: cover;">
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Banner (Mega Menu)</label>
                            <label for="add_category_bannerFile" class="zen-upload-container p-3 border-2 border-dashed rounded-4 bg-light cursor-pointer d-block" 
                                 style="border-style: dashed !important; border-color: #dee2e6 !important;">
                                <div class="text-muted mb-1 text-center"><i class="fas fa-image fa-lg"></i></div>
                                <div class="small fw-bold text-center">Select Banner</div>
                            </label>
                            <input type="file" id="add_category_bannerFile" class="category-banner-input d-none" name="category[bannerFile]" onchange="previewImage(this, 'add-category-banner-preview')">
                            <div class="mt-2 text-center">
                                <img id="add-category-banner-preview" src="{{ asset('assets/images/placeholder.jpg') }}" class="rounded-3 shadow-sm banner-preview-img" style="width: 100%; height: 48px; object-fit: cover;">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mb-4">
                            <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Color</label>
                            <input type="color" class="form-control form-control-color w-100 border-0 bg-light rounded-3" name="category[color]" value="#ffc107" style="height: 48px;">
                        </div>
                    </div>
                    <div class="mb-0">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="category[isActive]" id="addCategoryActive" value="1" checked>
                            <label class="form-check-label fw-bold text-dark small text-uppercase letter-spacing-1" for="addCategoryActive">Published</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light bg-opacity-50 border-0 py-3 px-4 rounded-bottom-4 justify-content-between">
                    <button type="button" class="btn btn-link text-muted text-decoration-none fw-medium" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">Create Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-white border-0 py-4 px-4">
                <h5 class="modal-title fw-bold text-dark" id="editCategoryLabel">Edit Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
             <form action="" method="POST" id="editCategoryForm" enctype="multipart/form-data">
                 <div class="modal-body p-4 pt-0">
                     <div class="mb-4">
                        <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Category Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-lg bg-light border-0 rounded-3 fs-6" name="category[name]" id="editCategoryName" required>
                        <input type="hidden" name="category[_token]" value="{{ csrf_token('category') }}">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Title (English) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-lg bg-light border-0 rounded-3 fs-6" name="category[titleEn]" id="editCategoryTitleEn" required>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Title (French) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-lg bg-light border-0 rounded-3 fs-6" name="category[titleFr]" id="editCategoryTitleFr" required>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Parent Category</label>
                         <div class="input-group input-group-lg bg-light border-0 rounded-3 overflow-hidden">
                            <span class="input-group-text bg-transparent border-0 text-muted ps-3"><i class="fas fa-network-wired"></i></span>
                            <select class="form-select bg-transparent border-0 fs-6 ps-2" name="category[parent]" id="editCategoryParent">
                                <option value="">No Parent (Root Category)</option>
                                {% for cat in categories %}
                                    <option value="{{ cat.id }}">{{ cat.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Icon (Image)</label>
                            <label for="edit_category_iconFile" class="zen-upload-container p-3 border-2 border-dashed rounded-4 bg-light cursor-pointer d-block" 
                                 style="border-style: dashed !important; border-color: #dee2e6 !important;">
                                <div class="text-muted mb-1 text-center"><i class="fas fa-cloud-upload-alt fa-lg"></i></div>
                                <div class="small fw-bold text-center">Change Icon</div>
                            </label>
                            <input type="file" id="edit_category_iconFile" name="category[iconFile]" class="d-none" onchange="previewImage(this, 'edit-category-icon-preview')">
                            <div class="mt-2 text-center">
                                <img id="edit-category-icon-preview" src="{{ asset('assets/images/placeholder.jpg') }}" class="rounded-3 shadow-sm icon-preview-img" style="width: 48px; height: 48px; object-fit: cover;">
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Banner (Mega Menu)</label>
                            <label for="edit_category_bannerFile" class="zen-upload-container p-3 border-2 border-dashed rounded-4 bg-light cursor-pointer d-block" 
                                 style="border-style: dashed !important; border-color: #dee2e6 !important;">
                                <div class="text-muted mb-1 text-center"><i class="fas fa-image fa-lg"></i></div>
                                <div class="small fw-bold text-center">Change Banner</div>
                            </label>
                            <input type="file" id="edit_category_bannerFile" name="category[bannerFile]" class="d-none" onchange="previewImage(this, 'edit-category-banner-preview')">
                            <div class="mt-2 text-center">
                                <img id="edit-category-banner-preview" src="{{ asset('assets/images/placeholder.jpg') }}" class="rounded-3 shadow-sm banner-preview-img" style="width: 100%; height: 48px; object-fit: cover;">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mb-4">
                            <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Color</label>
                            <input type="color" class="form-control form-control-color w-100 border-0 bg-light rounded-3" name="category[color]" id="editCategoryColor" style="height: 48px;">
                        </div>
                    </div>
                    <div class="mb-0">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="category[isActive]" id="editCategoryActive" value="1">
                            <label class="form-check-label fw-bold text-dark small text-uppercase letter-spacing-1" for="editCategoryActive">Published</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light bg-opacity-50 border-0 py-3 px-4 rounded-bottom-4 justify-content-between">
                     <button type="button" class="btn btn-link text-muted text-decoration-none fw-medium" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>


            </div>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize DataTable
        const table = $('.datatable-button-html5-columns').DataTable();
        
        // Search
        $('#categorySearch').on('keyup', function() {
            table.search(this.value).draw();
        });
        
        // Status Filter
        $('#statusFilter').on('change', function() {
            const val = this.value;
            if (val === 'all') {
                table.column(6).search('').draw();
            } else {
                table.column(6).search(val === 'active' ? 'Published' : 'Hidden').draw();
            }
        });

        // Edit Modal Population
        const editModal = document.getElementById('editCategoryModal');
        if (editModal) {
            editModal.addEventListener('show.bs.modal', function(event) {
                const button = event.relatedTarget;
                const categoryId = button.getAttribute('data-id');
                const categoryName = button.getAttribute('data-name');
                const categoryTitleEn = button.getAttribute('data-title-en');
                const categoryTitleFr = button.getAttribute('data-title-fr');
                const categoryParent = button.getAttribute('data-parent');
                const categoryColor = button.getAttribute('data-color');
                const categoryActive = button.getAttribute('data-active');
                const categoryIcon = button.getAttribute('data-icon');
                const categoryBanner = button.getAttribute('data-banner');
                
                document.getElementById('editCategoryName').value = categoryName;
                document.getElementById('editCategoryTitleEn').value = categoryTitleEn;
                document.getElementById('editCategoryTitleFr').value = categoryTitleFr;
                document.getElementById('editCategoryParent').value = categoryParent;
                document.getElementById('editCategoryColor').value = categoryColor;
                document.getElementById('editCategoryActive').checked = (categoryActive === '1');
                
                if (categoryIcon) {
                    document.getElementById('edit-category-icon-preview').src = `/uploads/categories/${categoryIcon}`;
                } else {
                    document.getElementById('edit-category-icon-preview').src = '/assets/images/placeholder.jpg';
                }

                if (categoryBanner) {
                    document.getElementById('edit-category-banner-preview').src = `/uploads/categories/${categoryBanner}`;
                } else {
                    document.getElementById('edit-category-banner-preview').src = '/assets/images/placeholder.jpg';
                }

                document.getElementById('editCategoryForm').action = `/dashboard/categories/${categoryId}/edit`;
            });
        }
        // AJAX Form Submission
        const handleAjaxForm = (formId, modalId) => {
            const form = document.getElementById(formId);
            if (!form) return;

            form.addEventListener('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(form);
                const submitBtn = form.querySelector('button[type="submit"]');
                const originalBtnText = submitBtn.innerHTML;

                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';

                fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const modal = bootstrap.Modal.getInstance(document.getElementById(modalId));
                        if(modal) modal.hide();
                        window.location.reload();
                    } else {
                        alert('Error: ' + data.message + (data.errors ? '\n' + data.errors : ''));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An unexpected error occurred.');
                })
                .finally(() => {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalBtnText;
                });
            });
        };

        handleAjaxForm('addCategoryForm', 'addCategoryModal');
        handleAjaxForm('editCategoryForm', 'editCategoryModal');
    });

    function previewImage(input, previewId) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById(previewId).src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>

{% endblock %}
