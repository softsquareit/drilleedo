{% extends 'admin/base_admin.html.twig' %}

{% block title %}Admin Dashboard | Premium{% endblock %}



{% block body %}
    <div class="content-wrapper">
        <div class="content-inner">
            <div class="content px-4">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                     <h4 class="mb-0 fw-bold text-dark">Categories</h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}" class="text-muted small">Home</a></li>
                            <li class="breadcrumb-item active small" aria-current="page">Categories</li>
                        </ol>
                    </nav>
                </div>
                <button type="button" class="btn btn-primary shadow-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                    <i class="fas fa-plus me-2"></i>Add Category
                </button>
            </div>

             
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-check-circle me-2"></i>
                        {{ message }}
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                 <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        {{ message }}
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 py-4 px-4 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fas fa-tags"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold text-dark">All Categories</h5>
                            <p class="text-muted small mb-0">{{ categories|length }} items total</p>
                        </div>
                    </div>
                    
                    <div class="d-flex gap-2">
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table datatable-button-html5-columns">
                        <thead class="bg-light bg-opacity-50">
                            <tr>
                                <th class="border-0 px-4 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 5%;">#</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 10%;">ID</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 30%;">Category Name</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 25%;">Hierarchy</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 15%;">Related</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 10%;">Status</th>
                                <th class="border-0 px-4 py-3 text-end text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 5%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for category in categories %}
                            <tr class="border-bottom border-light">
                                <td class="px-4 text-muted fw-semibold">{{ loop.index }}</td>
                                <td><span class="badge bg-light text-secondary border rounded-2 px-2 py-1 user-select-all">#{{ category.id }}</span></td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-2 me-3 d-flex align-items-center justify-content-center border border-warning-subtle" style="width: 40px; height: 40px;">
                                            <i class="fas fa-folder-open small"></i>
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark d-block">{{ category.name }}</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    {% if category.parent %}
                                        <div class="d-flex align-items-center text-muted small">
                                            <div class="border-start border-bottom border-secondary ms-1 me-2" style="width: 10px; height: 10px; opacity: 0.3;"></div>
                                            <span class="fw-medium text-dark">{{ category.parent.name }}</span>
                                        </div>
                                    {% else %}
                                        <span class="badge bg-light text-secondary border rounded-pill fw-normal px-2">Root Category</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-2">
                                        {{ category.companies|length }} Companies
                                    </span>
                                </td>
                                <td>
                                     <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 status-badge">
                                        <i class="fas fa-dot-circle me-1 small"></i> Active
                                     </span>
                                </td>
                                <td class="px-4 text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <button class="btn btn-sm btn-light text-primary btn-icon rounded-circle shadow-sm" type="button" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#editCategoryModal"
                                                data-id="{{ category.id }}"
                                                data-name="{{ category.name }}"
                                                data-parent="{{ category.parent ? category.parent.id : '' }}"
                                                title="Edit Details"
                                                style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-edit small"></i>
                                        </button>
                                        <a href="#" class="btn btn-sm btn-light text-danger btn-icon rounded-circle shadow-sm" 
                                           data-confirm="Are you sure?">
                                           title="Delete Category"
                                           style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-trash-alt small"></i>
                                        </a>
                                    </div>
                                    
                                    <form id="delete-form-{{ category.id }}" action="{{ path('admin_category_delete', {'id': category.id}) }}" method="POST" style="display: none;">
                                    </form>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="d-flex flex-column align-items-center justify-content-center p-5">
                                        <div class="bg-light rounded-circle p-4 mb-4">
                                            <i class="fas fa-tags fa-3x text-muted opacity-25"></i>
                                        </div>
                                        <h5 class="text-dark fw-bold mb-2">No Categories Found</h5>
                                        <p class="text-muted mb-4">Organize your content by adding categories.</p>
                                        <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                                            <i class="fas fa-plus me-2"></i> Create First Category
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>


<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-white border-0 py-4 px-4">
                <h5 class="modal-title fw-bold text-dark" id="addCategoryLabel">New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
             <form action="{{ path('admin_category_create') }}" method="POST" enctype="multipart/form-data">
                <div class="modal-body p-4 pt-0">
                     <div class="mb-4">
                        <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Category Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-lg bg-light border-0 rounded-3 fs-6" name="category[Category]" required placeholder="e.g. Construction">
                    </div>
                    <div class="mb-4">
                         <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Parent Category</label>
                         <div class="input-group input-group-lg bg-light border-0 rounded-3 overflow-hidden">
                            <span class="input-group-text bg-transparent border-0 text-muted ps-3"><i class="fas fa-network-wired"></i></span>
                            <select class="form-select bg-transparent border-0 fs-6 ps-2" name="category[parent]">
                                <option value="">No Parent (Root Category)</option>
                                {% for cat in categories %}
                                    <option value="{{ cat.id }}">{{ cat.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                         <div class="form-text mt-2"><i class="fas fa-info-circle me-1"></i> Select a parent to make this a sub-category.</div>
                    </div>
                </div>
                <div class="modal-footer bg-light bg-opacity-50 border-0 py-3 px-4 rounded-bottom-4 justify-content-between">
                    <button type="button" class="btn btn-link text-muted text-decoration-none fw-medium" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">Create Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-white border-0 py-4 px-4">
                <h5 class="modal-title fw-bold text-dark" id="editCategoryLabel">Edit Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
             <form action="" method="POST" id="editCategoryForm">
                 <div class="modal-body p-4 pt-0">
                     <div class="mb-4">
                        <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Category Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-lg bg-light border-0 rounded-3 fs-6" name="category[name]" id="editCategoryName" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Parent Category</label>
                         <div class="input-group input-group-lg bg-light border-0 rounded-3 overflow-hidden">
                            <span class="input-group-text bg-transparent border-0 text-muted ps-3"><i class="fas fa-network-wired"></i></span>
                            <select class="form-select bg-transparent border-0 fs-6 ps-2" name="category[parent]" id="editCategoryParent">
                                <option value="">No Parent (Root Category)</option>
                                {% for cat in categories %}
                                    <option value="{{ cat.id }}">{{ cat.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light bg-opacity-50 border-0 py-3 px-4 rounded-bottom-4 justify-content-between">
                     <button type="button" class="btn btn-link text-muted text-decoration-none fw-medium" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>


            </div>
<script>
    document.addEventListener('DOMContentLoaded', function() {
   
        // Edit Modal Population
        const editModal = document.getElementById('editCategoryModal');
        if (editModal) {
            editModal.addEventListener('show.bs.modal', function(event) {
                const button = event.relatedTarget;
                const categoryId = button.getAttribute('data-id');
                const categoryName = button.getAttribute('data-name');
                const categoryParent = button.getAttribute('data-parent');
                
                document.getElementById('editCategoryName').value = categoryName;
                document.getElementById('editCategoryParent').value = categoryParent;
                document.getElementById('editCategoryForm').action = `/admin/categories/${categoryId}/edit`;
            });
        }
    });
</script>

{% endblock %}
