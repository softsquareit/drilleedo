{% extends 'admin/base_admin.html.twig' %}

{% block title %}Edit Testimonial{% endblock %}

{% block body %}
<div class="content-wrapper">
    <div class="content-inner">
        <div class="content p-4">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom p-4">
                    <h5 class="mb-0 fw-bold">Edit Testimonial</h5>
                </div>
                <div class="card-body p-4">
                    {% if testimonial.image %}
                        <div class="mb-4">
                            <p class="text-muted small fw-bold mb-2">Current Image</p>
                            <img src="{{ asset('uploads/testimonials/' ~ testimonial.image) }}" alt="Current Image" class="img-thumbnail rounded" style="max-width: 150px;">
                        </div>
                    {% endif %}
                    {{ form_start(form) }}
                        <div class="mb-4">
                            {{ form_label(form.clientName) }}
                            {{ form_widget(form.clientName) }}
                            {{ form_errors(form.clientName) }}
                        </div>
                        <div class="mb-4">
                            {{ form_label(form.clientRole) }}
                            {{ form_widget(form.clientRole) }}
                            {{ form_errors(form.clientRole) }}
                        </div>
                        <div class="mb-4">
                            {{ form_label(form.content) }}
                            {{ form_widget(form.content) }}
                            {{ form_errors(form.content) }}
                        </div>
                        <div class="mb-4">
                            {{ form_label(form.imageFile) }}
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-image text-muted"></i></span>
                                {{ form_widget(form.imageFile) }}
                            </div>
                            {{ form_errors(form.imageFile) }}
                            <div class="form-text mt-2"><i class="fas fa-info-circle me-1"></i> Leave empty to keep the current image (Formats: JPG, PNG, WEBP).</div>
                        </div>
                        <div class="mb-4">
                            <div class="form-check form-switch form-switch-lg mt-2 d-flex align-items-center gap-2">
                                {{ form_widget(form.isActive) }}
                                {{ form_label(form.isActive) }}
                            </div>
                        </div>
                        {{ form_rest(form) }}
                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="fas fa-save me-2"></i>Update Testimonial
                            </button>
                            <a href="{{ path('admin_testimonial_index') }}" class="btn btn-light rounded-pill px-4 ms-2">
                                <i class="fas fa-arrow-left me-2"></i>Back
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
