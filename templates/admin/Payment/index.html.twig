{% extends 'admin/base_admin.html.twig' %}

{% block title %}Payment Methods | Admin{% endblock %}



{% block body %}
    <div class="content-wrapper">
        <div class="content-inner">
            
            <div class="page-header page-header-light shadow-sm">
                <div class="page-header-content d-lg-flex">
                    <div class="d-flex">
                        <h4 class="page-title mb-0">
                            Payment Methods - <span class="fw-normal">Management</span>
                        </h4>
                    </div>
                </div>

                <div class="page-header-content d-lg-flex border-top">
                    <div class="d-flex">
                        <div class="breadcrumb py-2">
                            <a href="{{ path('admin_dashboard') }}" class="breadcrumb-item"><i class="fas fa-home"></i></a>
                            <a href="{{ path('admin_dashboard') }}" class="breadcrumb-item">Admin</a>
                            <span class="breadcrumb-item active">Payment Methods</span>
                        </div>
                    </div>
                </div>
            </div>
            

            
            <div class="content px-4">

             
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-check-circle me-2"></i>
                        {{ message }}
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                 <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        {{ message }}
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 py-4 px-4 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                             <i class="fas fa-credit-card"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold text-dark">Payment Methods</h5>
                            <p class="text-muted small mb-0">{{ payment_methods|length }} active methods</p>
                        </div>
                    </div>
                    
                    <div class="d-flex gap-2">
                         <div class="position-relative">
                            <input type="text" class="form-control ps-5 rounded-pill border-0 bg-light" placeholder="Search..." id="paymentSearch" style="width: 250px;">
                            <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        </div>
                         <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#addPaymentModal">
                            <i class="fas fa-plus me-2"></i>Add New
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                     <table class="table datatable-button-html5-columns">
                        <thead class="bg-light bg-opacity-50">
                            <tr>
                                <th class="border-0 px-4 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 5%;">#</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 10%;">ID</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 35%;">Method Name</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 25%;">Icon</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 15%;">Status</th>
                                <th class="border-0 px-4 py-3 text-end text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 10%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for payment in payment_methods %}
                            <tr class="border-bottom border-light">
                                <td class="px-4 text-muted fw-semibold">{{ loop.index }}</td>
                                <td><span class="badge bg-light text-secondary border rounded-2 px-2 py-1 user-select-all">#{{ payment.id }}</span></td>
                                <td>
                                    <span class="fw-bold text-dark">{{ payment.name }}</span>
                                </td>
                                <td>
                                    <div class="bg-light rounded-3 p-2 d-inline-flex align-items-center justify-content-center border border-light-subtle" style="width: 48px; height: 48px;">
                                        
                                        <i class="fas fa-credit-card text-secondary fa-lg"></i>
                                    </div>
                                </td>
                                <td>
                                     <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-semibold status-badge">
                                        <i class="fas fa-dot-circle me-1 small"></i> Active
                                     </span>
                                </td>
                                <td class="px-4 text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="{{ path('admin_payment_edit', {id: payment.id}) }}" class="btn btn-sm btn-light text-primary btn-icon rounded-circle shadow-sm" title="Edit Method" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-edit small"></i>
                                        </a>
                                        <a href="{{ path('admin_payment_delete', {id: payment.id}) }}" class="btn btn-sm btn-light text-danger btn-icon rounded-circle shadow-sm" title="Delete Method" onclick="return confirm('Delete this payment method?');" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-trash-alt small"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="d-flex flex-column align-items-center justify-content-center p-5">
                                        <div class="bg-light rounded-circle p-4 mb-4">
                                            <i class="fas fa-wallet fa-3x text-muted opacity-25"></i>
                                        </div>
                                        <h5 class="text-dark fw-bold mb-2">No Payment Methods</h5>
                                        <p class="text-muted mb-4">Get started by adding your first payment method.</p>
                                        <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addPaymentModal">
                                            <i class="fas fa-plus me-2"></i> Add First Method
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                 <div class="card-footer bg-white border-0 py-3 px-4 rounded-bottom-4">
                    <small class="text-muted fw-medium">Showing {{ payment_methods|length }} entries</small>
                </div>
            </div>

        </div>
    </div>


<div class="modal fade" id="addPaymentModal" tabindex="-1" aria-labelledby="addPaymentLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-white border-0 py-4 px-4">
                <h5 class="modal-title fw-bold text-dark" id="addPaymentLabel">New Payment Method</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
             <form action="{{ path('admin_payment_create') }}" method="POST">
                <div class="modal-body p-4 pt-0">
                     <div class="mb-4">
                        <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Method Name</label>
                        <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden">
                             <span class="input-group-text bg-light border-0 text-muted ps-4"><i class="fas fa-credit-card"></i></span>
                            <input type="text" class="form-control bg-light border-0 ps-3" name="payment_method[name]" required placeholder="e.g. PayPal" style="font-size: 0.95rem;">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light bg-opacity-50 border-0 py-3 px-4 rounded-bottom-4 justify-content-between">
                    <button type="button" class="btn btn-link text-muted text-decoration-none fw-medium" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">Add Method</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}