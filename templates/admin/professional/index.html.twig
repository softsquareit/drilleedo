{% extends 'admin/base_admin.html.twig' %}

{% block title %}Professional Users | Admin{% endblock %}



{% block body %}
    <div class="content-wrapper">
        <div class="content-inner">
            
            <div class="page-header page-header-light shadow-sm">
                <div class="page-header-content d-lg-flex">
                    <div class="d-flex">
                        <h4 class="page-title mb-0">
                            Professionals - <span class="fw-normal">Management</span>
                        </h4>
                    </div>
                </div>

                <div class="page-header-content d-lg-flex border-top">
                    <div class="d-flex">
                        <div class="breadcrumb py-2">
                            <a href="{{ path('admin_dashboard') }}" class="breadcrumb-item"><i class="fas fa-home"></i></a>
                            <a href="{{ path('admin_dashboard') }}" class="breadcrumb-item">Admin</a>
                            <span class="breadcrumb-item active">Professionals</span>
                        </div>
                    </div>
                </div>
            </div>
            

            
            <div class="content px-4">

             
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-check-circle me-2"></i>
                        {{ message }}
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                 <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        {{ message }}
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 py-4 px-4 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fas fa-user-tie"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold text-dark">All Professionals</h5>
                            <p class="text-muted small mb-0">{{ professionals|length }} pros registered</p>
                        </div>
                    </div>
                    
                    <div class="d-flex gap-2">
                         <div class="position-relative">
                            <input type="text" class="form-control ps-5 rounded-pill border-0 bg-light" placeholder="Search pros..." id="proSearch" style="width: 250px;">
                            <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                        </div>
                        <select class="form-select rounded-pill border-0 bg-light w-auto text-muted ps-3 pe-5" id="statusFilter">
                            <option value="all">All Status</option>
                            <option value="verified">Verified</option>
                            <option value="pending">Pending</option>
                        </select>
                        <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addProModal">
                            <i class="fas fa-plus me-2"></i> Add Professional
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                     <table class="table datatable-button-html5-columns">
                        <thead class="bg-light bg-opacity-50">
                            <tr>
                                <th class="border-0 px-4 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 5%;">#</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 10%;">ID</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 25%;">Name</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 30%;">Email</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 15%;">Expertise</th>
                                <th class="border-0 py-3 text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 10%;">Status</th>
                                <th class="border-0 px-4 py-3 text-end text-muted small fw-bold text-uppercase letter-spacing-1" style="width: 10%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for professional in professionals %}
                            <tr class="border-bottom border-light">
                                <td class="px-4 text-muted fw-semibold">{{ loop.index }}</td>
                                <td><span class="badge bg-light text-secondary border rounded-2 px-2 py-1 user-select-all">#{{ professional.id }}</span></td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3 d-flex align-items-center justify-content-center border border-primary-subtle" style="width: 40px; height: 40px;">
                                            <i class="fas fa-user-tie small"></i>
                                        </div>
                                        <div>
                                            {% if professional.personalInfos %}
                                                <span class="fw-bold text-dark">{{ professional.personalInfos.firstName }} {{ professional.personalInfos.lastName }}</span>
                                            {% elseif professional.primaryContact %}
                                                <span class="fw-bold text-dark">{{ professional.primaryContact.firstName }} {{ professional.primaryContact.lastName }}</span>
                                            {% else %}
                                                <span class="fw-bold text-muted">Unknown Name</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </td>
                                <td class="text-muted">{{ professional.email }}</td>
                                 <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        {% if professional.languages is not empty %}
                                            {% for lang in professional.languages %}
                                                <span class="badge bg-light text-primary border-0 small" style="font-size: 0.7rem;">{{ lang }}</span>
                                            {% endfor %}
                                        {% endif %}
                                        {% if professional.hasInsurance %}
                                            <span class="badge bg-success bg-opacity-10 text-success border-0 small" title="Insured" style="font-size: 0.7rem;"><i class="fas fa-shield-alt"></i></span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td>
                                     {% if professional.isVerified %}
                                         <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 status-badge">
                                            <i class="fas fa-check-circle me-1 small"></i> Verified
                                         </span>
                                     {% else %}
                                         <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2 status-badge">
                                            <i class="fas fa-clock me-1 small"></i> Pending
                                         </span>
                                     {% endif %}
                                </td>
                                <td class="px-4 text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="{{ path('admin_professional_edit', {id: professional.id}) }}" class="btn btn-sm btn-light text-primary btn-icon rounded-circle shadow-sm" title="Edit Profile" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-edit small"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-light text-danger btn-icon rounded-circle shadow-sm" title="Delete Professional" 
                                                data-bs-toggle="modal" data-bs-target="#confirmDeleteModal"
                                                data-action="{{ path('admin_professionnel_delete', {id: professional.id}) }}"
                                                data-token="{{ csrf_token('delete' ~ professional.id) }}"
                                                style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-trash-alt small"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="d-flex flex-column align-items-center justify-content-center p-5">
                                        <div class="bg-light rounded-circle p-4 mb-4">
                                            <i class="fas fa-briefcase fa-3x text-muted opacity-25"></i>
                                        </div>
                                        <h5 class="text-dark fw-bold mb-2">No Professionals Found</h5>
                                        <p class="text-muted mb-4">Add professionals to the platform manually.</p>
                                        <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addProModal">
                                            <i class="fas fa-plus me-2"></i> Add Professional
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                 <div class="card-footer bg-white border-0 py-3 px-4 rounded-bottom-4">
                    <small class="text-muted fw-medium">Showing {{ professionals|length }} entries</small>
                </div>
            </div>

        </div>
    </div>


<div class="modal fade" id="addProModal" tabindex="-1" aria-labelledby="addProLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
             <div class="modal-header bg-white border-0 py-4 px-4">
                <h5 class="modal-title fw-bold text-dark" id="addProLabel">Add New Professional</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="{{ path('admin_professional_create') }}" method="POST">
                <input type="hidden" name="_source" value="manual_professional">
                <div class="modal-body p-4 pt-0">
                     <div class="mb-4">
                         <label class="form-label fw-bold text-dark small text-uppercase letter-spacing-1">Email <span class="text-danger">*</span></label>
                          <div class="input-group input-group-lg bg-light border-0 rounded-3 overflow-hidden">
                             <span class="input-group-text bg-transparent border-0 text-muted ps-3"><i class="fas fa-envelope"></i></span>
                             <input type="email" class="form-control bg-transparent border-0 fs-6 ps-2" name="professional[email]" required placeholder="professional@example.com">
                        </div>
                        <div class="form-text mt-2">A temporary password will be generated automatically. You can configure other details on the next screen.</div>
                     </div>
                </div>
                <div class="modal-footer bg-light bg-opacity-50 border-0 py-3 px-4 rounded-bottom-4 justify-content-between">
                    <button type="button" class="btn btn-link text-muted text-decoration-none fw-medium" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">Create & Edit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        const table = $('.datatable-button-html5-columns').DataTable();
        
        // Search integration
        $('#proSearch').on('keyup', function() {
            table.search(this.value).draw();
        });

        // Status Filter integration
        $('#statusFilter').on('change', function() {
            const val = this.value;
            if (val === 'all') {
                table.column(5).search('').draw();
            } else {
                table.column(5).search(val === 'verified' ? 'Verified' : 'Pending').draw();
            }
        });
    });
</script>
{% endblock %}