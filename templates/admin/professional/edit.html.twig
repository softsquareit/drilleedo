{% extends 'admin/base_admin.html.twig' %}

{% block header %}

    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const checkCards = document.querySelectorAll('.zen-check-card');
            
            checkCards.forEach(card => {
                const input = card.querySelector('input');
                if(input && input.checked) card.classList.add('checked');
                
                if(input) {
                    input.addEventListener('change', () => {
                        if(input.type === 'radio') {
                             // clear siblings
                             const name = input.getAttribute('name');
                             document.querySelectorAll(`input[name="${name}"]`).forEach(el => {
                                 el.closest('.zen-check-card').classList.remove('checked');
                             });
                        }
                        if(input.checked) card.classList.add('checked');
                        else card.classList.remove('checked');
                    });
                }
                
                // Card click triggers input
                card.addEventListener('click', (e) => {
                    if(e.target !== input) {
                        input.click();
                    }
                });
            });


        });
    </script>
{% endblock %}

{% block body %}
    <div class="content-wrapper">
        <div class="content-inner pb-5">
            
            
            <div class="container-xl pt-4 mb-4">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 small">
                        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}" class="text-muted text-decoration-none">Home</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('admin_professionnel_index') }}" class="text-muted text-decoration-none">Professionals</a></li>
                        <li class="breadcrumb-item active text-dark" aria-current="page">Profile</li>
                    </ol>
                </nav>
            </div>

            <div class="container-xl">
                <div class="row g-4">
                    
                    
                    <div class="col-lg-4 col-xl-3">
                        <div class="profile-sticky">
                            
                            
                            <div class="zen-card text-center pb-3">
                                <div class="profile-cover" data-bs-toggle="modal" data-bs-target="#updateBannerModal">
                                    <div class="profile-cover-overlay">
                                        <i class="fas fa-camera text-white fa-lg"></i>
                                    </div>
                                </div>
                                <div class="profile-avatar-wrapper">
                                    <div class="profile-avatar" data-bs-toggle="modal" data-bs-target="#updatePhotoModal">
                                        {% if professional.logo %}
                                            <img src="{{ asset('uploads/logos/' ~ professional.logo) }}" alt="Photo" style="width: 100%; height: 100%; object-fit: cover;">
                                        {% else %}
                                            <i class="fas fa-user-tie fa-3x text-secondary opacity-50"></i>
                                        {% endif %}
                                        <div class="profile-avatar-overlay">
                                            <i class="fas fa-camera text-white"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="px-3 mt-3">
                                    <h5 class="fw-bold mb-1">
                                        {% if professional.personalInfos %}
                                            {{ professional.personalInfos.firstName }} {{ professional.personalInfos.lastName }}
                                        {% else %}
                                            {{ professional.email }}
                                        {% endif %}
                                    </h5>
                                    <p class="text-muted small mb-3">{{ professional.companyName }}</p>
                                    
                                    <div class="d-flex justify-content-center gap-2 mb-4">
                                        <button class="btn btn-zen-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#editProfessionalModal">
                                            Edit
                                        </button>
                                        <button class="btn btn-zen-primary btn-sm">
                                            Message
                                        </button>
                                    </div>
                                    
                                    <div class="text-start border-top">
                                        <div class="sidebar-stat d-flex justify-content-between align-items-center">
                                            <span class="stat-label">Category</span>
                                            <span class="badge-zen">{{ professional.category ? professional.category.name : 'Unspecified' }}</span>
                                        </div>
                                        <div class="sidebar-stat d-flex justify-content-between align-items-center">
                                            <span class="stat-label">Experience</span>
                                            <span class="stat-value">{{ professional.expYears }}y</span>
                                        </div>
                                        <div class="sidebar-stat d-flex justify-content-between align-items-center">
                                            <span class="stat-label">Verified</span>
                                            {% if professional.isVerified %}
                                                <span class="badge bg-success bg-opacity-10 text-success small fw-bold"><i class="fas fa-check-circle me-1"></i>Yes</span>
                                            {% else %}
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary small fw-bold">No</span>
                                            {% endif %}
                                        </div>
                                        <div class="sidebar-stat d-flex justify-content-between align-items-center">
                                            <span class="stat-label">Top Rated</span>
                                            {% if professional.isTopRated %}
                                                <span class="badge bg-warning bg-opacity-10 text-warning small fw-bold"><i class="fas fa-star me-1"></i>Yes</span>
                                            {% else %}
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary small fw-bold">No</span>
                                            {% endif %}
                                        </div>
                                        <div class="sidebar-stat d-flex justify-content-between align-items-center">
                                            <span class="stat-label">Availability</span>
                                            {% if professional.availabilityStatus == 'AVAILABLE' %}
                                                <span class="text-success small fw-bold">Available</span>
                                            {% elseif professional.availabilityStatus == 'BUSY' %}
                                                <span class="text-warning small fw-bold">Busy</span>
                                            {% else %}
                                                <span class="text-danger small fw-bold">Unavailable</span>
                                            {% endif %}
                                        </div>
                                        <div class="sidebar-stat d-flex justify-content-between align-items-center">
                                            <span class="stat-label">Location</span>
                                            <span class="text-dark small fw-medium text-truncate" style="max-width: 120px;">{{ professional.city }}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            
                            <div class="zen-card p-0">
                                <div class="list-group list-group-flush">
                                    <button class="list-group-item list-group-item-action border-0 d-flex align-items-center gap-3" data-bs-toggle="modal" data-bs-target="#manageCategoryModal">
                                        <i class="fas fa-tag text-muted fa-fw"></i>
                                        <span class="small fw-medium">Change Category</span>
                                    </button>
                                    <button class="list-group-item list-group-item-action border-0 d-flex align-items-center gap-3" data-bs-toggle="modal" data-bs-target="#managePaymentModal">
                                        <i class="fas fa-credit-card text-muted fa-fw"></i>
                                        <span class="small fw-medium">Payment Methods</span>
                                    </button>
                                    <button class="list-group-item list-group-item-action border-0 d-flex align-items-center gap-3 text-danger">
                                        <i class="fas fa-ban fa-fw"></i>
                                        <span class="small fw-medium">Suspend Account</span>
                                    </button>
                                    <button class="list-group-item list-group-item-action border-0 d-flex align-items-center gap-3" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                                        <i class="fas fa-key text-muted fa-fw"></i>
                                        <span class="small fw-medium">Change Password</span>
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>

                    
                    <div class="col-lg-8 col-xl-9">
                        
                        
                        <div class="zen-card mb-4">
                            <div class="zen-card-header">
                                <div class="zen-card-title">
                                    <i class="fas fa-address-card text-muted"></i> Primary Contact
                                </div>
                                <button class="btn btn-zen-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#addContactModal">Edit</button>
                            </div>
                            <div class="zen-card-body">
                                {% if professional.primaryContact %}
                                    <div class="d-flex align-items-center gap-4">
                                        <div class="bg-light rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                            <span class="fw-bold fs-4 text-muted">{{ professional.primaryContact.firstName|first }}</span>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-1">{{ professional.primaryContact.firstName }} {{ professional.primaryContact.lastName }}</h5>
                                            <div class="d-flex gap-3 text-muted small">
                                                <span><i class="fas fa-envelope me-1"></i> {{ professional.primaryContact.email }}</span>
                                                <span><i class="fas fa-phone me-1"></i> {{ professional.primaryContact.phone }}</span>
                                            </div>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="text-center py-4 text-muted">
                                        <p class="mb-2">No primary contact information</p>
                                        <button class="btn btn-link btn-sm" data-bs-toggle="modal" data-bs-target="#addContactModal">Add Contact</button>
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                         
                        <h6 class="zen-section-title mt-5">Professional Portfolio</h6>
                        <div class="zen-card">
                             <div class="zen-card-header">
                                <div class="zen-card-title">Projects History</div>
                                <button class="btn btn-zen-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addProjectModal"><i class="fas fa-plus me-1"></i> Add Project</button>
                            </div>
                            <div class="p-0">
                                {% if professional.Projets is not empty %}
                                    <div class="table-responsive">
                                        <table class="table mb-0 align-middle">
                                            <thead class="bg-light">
                                                <tr>
                                                    <th class="ps-4 border-bottom-0 text-uppercase small text-muted fw-semibold py-3">Project Name</th>
                                                    <th class="border-bottom-0 text-uppercase small text-muted fw-semibold py-3">Period</th>
                                                    <th class="border-bottom-0 text-uppercase small text-muted fw-semibold py-3">Status</th>
                                                    <th class="pe-4 border-bottom-0 text-end"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for project in professional.Projets %}
                                                    <tr>
                                                        <td class="ps-4 border-bottom py-3">
                                                            <div class="fw-medium text-dark">{{ project.name }}</div>
                                                            <div class="small text-muted text-truncate" style="max-width: 250px;">{{ project.description }}</div>
                                                        </td>
                                                        <td class="border-bottom py-3 small text-muted">
                                                            {{ project.startDate|date('M Y') }} - 
                                                            {% if project.EndDate %}
                                                                {{ project.EndDate|date('M Y') }}
                                                            {% else %}
                                                                Present
                                                            {% endif %}
                                                        </td>
                                                        <td class="border-bottom py-3">
                                                            {% if project.EndDate %}
                                                                <span class="badge bg-light text-muted border fw-normal">Completed</span>
                                                            {% else %}
                                                                <span class="badge bg-success bg-opacity-10 text-success fw-normal">Active</span>
                                                            {% endif %}
                                                        </td>
                                                        <td class="pe-4 border-bottom py-3 text-end">
                                                            <button class="btn btn-icon btn-sm text-muted hover-text-dark"><i class="fas fa-ellipsis-h"></i></button>
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                {% else %}
                                    <div class="text-center py-5">
                                        <div class="mb-3 text-muted opacity-25"><i class="fas fa-folder-open fa-3x"></i></div>
                                        <p class="text-muted small">No projects added yet.</p>
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        
                        <div class="row g-4 mt-1">
                            
                            
                            <div class="col-md-6">
                                <div class="zen-card h-100">
                                    <div class="zen-card-header">
                                        <div class="zen-card-title">Addresses</div>
                                        <button class="btn btn-zen-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#addAddressModal">Add</button>
                                    </div>
                                    <div class="zen-card-body">
                                        {% if professional.Adresse is not empty %}
                                            <ul class="list-unstyled mb-0 d-flex flex-column gap-3">
                                                {% for address in professional.Adresse %}
                                                    <li class="d-flex gap-3 align-items-start">
                                                        <i class="fas fa-map-pin text-muted mt-1"></i>
                                                        <div>
                                                            <div class="fw-medium text-dark">{{ address.street }}</div>
                                                            <div class="small text-muted">{{ address.city }}, {{ address.postalCode }}</div>
                                                        </div>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        {% else %}
                                            <p class="text-muted small mb-0">No addresses registered.</p>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            
                            
                            <div class="col-md-6">
                                <div class="zen-card h-100">
                                    <div class="zen-card-header">
                                        <div class="zen-card-title">Online Presence</div>
                                        <button class="btn btn-zen-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#addLinkModal">Add</button>
                                    </div>
                                     <div class="zen-card-body">
                                        {% if professional.links is not empty %}
                                            <div class="d-flex flex-column gap-2">
                                                {% for link in professional.links %}
                                                    <a href="{{ link.link }}" target="_blank" class="d-flex align-items-center gap-2 text-decoration-none p-2 rounded hover-bg-light transition-all">
                                                        <i class="fas fa-globe text-primary"></i>
                                                        <span class="text-dark small text-truncate">{{ link.link }}</span>
                                                        <i class="fas fa-external-link-alt ms-auto text-muted small fa-xs"></i>
                                                    </a>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            <p class="text-muted small mb-0">No links added.</p>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    
    
    
    <div class="modal fade" id="editProfessionalModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Edit Profile</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Email</label>
                            {{ form_widget(form.email, {'attr': {'class': 'form-control zen-input'}}) }}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Company Name</label>
                            {{ form_widget(form.company_name, {'attr': {'class': 'form-control zen-input'}}) }}
                        </div>


                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">City</label>
                            {{ form_widget(form.city, {'attr': {'class': 'form-control zen-input'}}) }}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Experience Years</label>
                            {{ form_widget(form.exp_years, {'attr': {'class': 'form-control zen-input'}}) }}
                        </div>

                         <div class="col-12">
                            <label class="form-label small fw-bold text-uppercase text-muted">About Me</label>
                            {{ form_widget(form.about, {'attr': {'class': 'form-control zen-input'}}) }}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Why Choose Me</label>
                             <small class="d-block text-muted mb-1" style="font-size: 1rem;">Enter one item per line</small>
                            {{ form_widget(form.whyChooseUs, {'attr': {'class': 'form-control zen-input'}}) }}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Services</label>
                            <small class="d-block text-muted mb-1" style="font-size: 1rem;">Enter one item per line</small>
                            {{ form_widget(form.services, {'attr': {'class': 'form-control zen-input'}}) }}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Availability</label>
                            {{ form_widget(form.availabilityStatus, {'attr': {'class': 'form-select zen-input'}}) }}
                        </div>
                        <div class="col-md-6 d-flex align-items-center gap-4 pt-4">
                            <div class="form-check">
                                {{ form_widget(form.isVerified) }}
                                {{ form_label(form.isVerified) }}
                            </div>
                            <div class="form-check">
                                {{ form_widget(form.isTopRated) }}
                                {{ form_label(form.isTopRated) }}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-zen-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-zen-primary">Save Changes</button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
            </div>
        </div>
    </div>

    
    <div class="modal fade" id="updatePhotoModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Update Profile Photo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                {{ form_start(photoForm) }}
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-muted">Select New Photo</label>
                        {{ form_widget(photoForm.logoFile, {'attr': {'class': 'form-control zen-input'}}) }}
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-zen-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-zen-primary">Upload</button>
                </div>
                {{ form_end(photoForm) }}
            </div>
        </div>
    </div>

    <div class="modal fade" id="updateBannerModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Update Banner</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                {{ form_start(bannerForm) }}
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-muted">Select New Banner</label>
                        {{ form_widget(bannerForm.bannerFile, {'attr': {'class': 'form-control zen-input'}}) }}
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-zen-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-zen-primary">Upload</button>
                </div>
                {{ form_end(bannerForm) }}
            </div>
        </div>
    </div>
    
    <div class="modal fade" id="addContactModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Manage Primary Contact</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                {{ form_start(contactForm) }}
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">First Name</label>
                            {{ form_widget(contactForm.firstName, {'attr': {'class': 'form-control zen-input'}}) }}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Last Name</label>
                            {{ form_widget(contactForm.lastName, {'attr': {'class': 'form-control zen-input'}}) }}
                        </div>
                         <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Email</label>
                            {{ form_widget(contactForm.email, {'attr': {'class': 'form-control zen-input'}}) }}
                        </div>
                         <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Phone</label>
                            {{ form_widget(contactForm.phone, {'attr': {'class': 'form-control zen-input'}}) }}
                        </div>
                    </div>
                </div>
                 <div class="modal-footer">
                    <button type="button" class="btn btn-zen-secondary" data-bs-dismiss="modal">Cancel</button>
                    {{ form_widget(contactForm.save, {'attr': {'class': 'btn btn-zen-primary'}}) }}
                </div>
                {{ form_end(contactForm) }}
            </div>
        </div>
    </div>

     
    <div class="modal fade" id="addAddressModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                     <h5 class="modal-title fw-bold">Add Address</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                {{ form_start(addressForm) }}
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-muted">Street</label>
                        {{ form_widget(addressForm.street, {'attr': {'class': 'form-control zen-input'}}) }}
                    </div>
                     <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">City</label>
                            {{ form_widget(addressForm.city, {'attr': {'class': 'form-control zen-input'}}) }}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Postal Code</label>
                            {{ form_widget(addressForm.postalCode, {'attr': {'class': 'form-control zen-input'}}) }}
                        </div>
                    </div>
                </div>
                 <div class="modal-footer">
                    <button type="button" class="btn btn-zen-secondary" data-bs-dismiss="modal">Cancel</button>
                    {{ form_widget(addressForm.save, {'attr': {'class': 'btn btn-zen-primary'}}) }}
                </div>
                {{ form_end(addressForm) }}
            </div>
        </div>
    </div>

    
    <div class="modal fade" id="addProjectModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Project</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                {{ form_start(projectForm) }}
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-muted">Project Name</label>
                        {{ form_widget(projectForm.name, {'attr': {'class': 'form-control zen-input'}}) }}
                    </div>
                     <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Start Date</label>
                            {{ form_widget(projectForm.startDate, {'attr': {'class': 'form-control zen-input'}}) }}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">End Date</label>
                            {{ form_widget(projectForm.EndDate, {'attr': {'class': 'form-control zen-input'}}) }}
                        </div>
                    </div>
                    <div>
                        <label class="form-label small fw-bold text-uppercase text-muted">Description</label>
                        {{ form_widget(projectForm.description, {'attr': {'class': 'form-control zen-input', 'rows': '4'}}) }}
                    </div>
                </div>
                 <div class="modal-footer">
                    <button type="button" class="btn btn-zen-secondary" data-bs-dismiss="modal">Cancel</button>
                   <button type="submit" class="btn btn-zen-primary">Save</button>
                </div>
                {{ form_end(projectForm) }}
            </div>
        </div>
    </div>

    
    <div class="modal fade" id="addLinkModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Link</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                {{ form_start(linkForm) }}
                <div class="modal-body">
                    <label class="form-label small fw-bold text-uppercase text-muted">URL</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-globe"></i></span>
                        {{ form_widget(linkForm.link, {'attr': {'class': 'form-control zen-input border-start-0 ps-0', 'placeholder': 'https://'}}) }}
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-zen-secondary" data-bs-dismiss="modal">Cancel</button>
                    {{ form_widget(linkForm.save, {'attr': {'class': 'btn btn-zen-primary'}}) }}
                </div>
                {{ form_end(linkForm) }}
            </div>
        </div>
    </div>

    
    <div class="modal fade" id="manageCategoryModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Change Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="{{ path('admin_professional_update_category', {'id': professional.id}) }}" method="POST">
                    <div class="modal-body">
                     <div class="row g-3">
                            {% for category in categories %}
                                <div class="col-md-6">
                                    <label class="zen-check-card h-100 w-100 mb-0">
                                        <div class="form-check mb-0">
                                            <input class="form-check-input" type="radio" name="category" value="{{ category.id }}" id="cat_{{ category.id }}" {% if professional.category and professional.category.id == category.id %}checked{% endif %}>
                                        </div>
                                        <div class="ms-2 flex-grow-1">
                                            <span class="d-block fw-semibold text-dark">{{ category.name }}</span>
                                        </div>
                                        <i class="fas fa-check-circle check-icon"></i>
                                    </label>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-zen-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-zen-primary">Update Category</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    
    <div class="modal fade" id="managePaymentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Manage Payment Methods</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                {{ form_start(paymentForm) }}
                <div class="modal-body">
                    <div class="row g-3">
                        {% for child in paymentForm.paymentMethod %}
                            <div class="col-md-6">
                                <label class="zen-check-card h-100 w-100 mb-0">
                                    <div class="form-check mb-0">
                                        {{ form_widget(child, {'attr': {'class': 'form-check-input'}}) }}
                                    </div>
                                    <div class="ms-2 flex-grow-1">
                                        <span class="d-block fw-semibold text-dark">{{ form_label(child) }}</span>
                                    </div>
                                    <i class="fas fa-check-circle check-icon"></i>
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-zen-secondary" data-bs-dismiss="modal">Cancel</button>
                    {{ form_widget(paymentForm.save, {'attr': {'class': 'btn btn-zen-primary'}}) }}
                </div>
                {{ form_end(paymentForm) }}
            </div>
        </div>
    </div>

    
    <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Change Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="{{ path('admin_user_change_password', {'id': professional.id}) }}" method="POST" data-confirm="Are you sure you want to change this user's password?">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">New Password</label>
                            <input type="password" name="new_password" class="form-control zen-input" required>
                        </div>
                        <div class="alert alert-info border-0 bg-info bg-opacity-10 text-info small mb-0">
                            <i class="fas fa-info-circle me-1"></i> This will immediately update the user's password.
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>


            </div>
        </div>
    </div>

{% endblock %}