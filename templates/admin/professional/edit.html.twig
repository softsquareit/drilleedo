{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/drilleedo/js/category-selector.js') }}"></script>
    <script>
        function populateProjectModal(id, name, start, end, description, state, mainPhoto, galleryJson) {
            const form = document.getElementById('editProjectForm');
            form.action = '/admin/professional/project/update/' + id;
            document.getElementById('edit_project_name').value = name;
            document.getElementById('edit_project_start').value = start;
            document.getElementById('edit_project_end').value = end;
            // Clean description of <br /> tags if they exist from nl2br
            document.getElementById('edit_project_description').value = description.replace(/<br\s*\/?>/mg, "");
            document.getElementById('edit_project_state').checked = (state == 1);

            // Clear previews
            document.getElementById('edit_main_photo_preview').innerHTML = '';
            document.getElementById('edit_gallery_preview').innerHTML = '';
            
            // Popule existing images
            const mainPhotoContainer = document.getElementById('existing_main_photo');
            const galleryContainer = document.getElementById('existing_gallery_container');
            
            mainPhotoContainer.innerHTML = '';
            galleryContainer.innerHTML = '';

            if (mainPhoto && mainPhoto !== 'null' && mainPhoto !== '') {
                mainPhotoContainer.innerHTML = `
                    <img src="{{ asset('uploads/projects/') }}/${mainPhoto}" class="rounded shadow-sm border" style="width: 80px; height: 80px; object-fit: cover;">
                `;
            } else {
                mainPhotoContainer.innerHTML = `
                    <div class="rounded bg-white border border-dashed d-flex align-items-center justify-content-center text-muted" style="width: 80px; height: 80px;">
                        <i class="fas fa-image"></i>
                    </div>
                `;
            }

            if (galleryJson && galleryJson !== 'null') {
                try {
                    const gallery = JSON.parse(galleryJson);
                    if (Array.isArray(gallery) && gallery.length > 0) {
                        gallery.forEach(img => {
                            const div = document.createElement('div');
                            div.className = 'text-center position-relative';
                            div.innerHTML = `
                                <img src="{{ asset('uploads/projects/') }}/${img}" class="rounded shadow-sm border bg-white" style="width: 60px; height: 60px; object-fit: cover;">
                                <a href="/admin/projects/${id}/delete-image?type=gallery&image=${img}&ajax=1" class="position-absolute top-0 start-100 translate-middle badge rounded-circle bg-danger border border-light p-1 btn-delete-confirm-ajax" data-confirm-message="Supprimer cette image de la galerie ?">
                                    <i class="fas fa-times fa-xs"></i>
                                </a>
                            `;
                            galleryContainer.appendChild(div);
                        });
                    } else {
                        galleryContainer.innerHTML = '<div class="text-muted small italic w-100 text-center py-2">Galerie vide</div>';
                    }
                } catch(e) {
                    console.error("Error parsing gallery JSON", e);
                }
            } else {
                galleryContainer.innerHTML = '<div class="text-muted small italic w-100 text-center py-2">Galerie vide</div>';
            }
            
            // Re-bind delete confirmation for newly created links
            bindDeleteConfirmation();
            bindAjaxDelete();
        }

        function bindAjaxDelete() {
            const ajaxDeleteBtns = document.querySelectorAll('.btn-delete-confirm-ajax');
            const confirmModalElement = document.getElementById('confirmDeleteModal');
            if (!confirmModalElement) return;
            const confirmModal = bootstrap.Modal.getOrCreateInstance(confirmModalElement);
            const confirmBtn = document.getElementById('confirmDeleteBtn');
            const confirmMsg = document.getElementById('deleteConfirmMessage');

            ajaxDeleteBtns.forEach(btn => {
                if (btn.hasAttribute('data-listener-attached')) return;
                btn.setAttribute('data-listener-attached', 'true');

                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const url = this.href;
                    const msg = this.getAttribute('data-confirm-message') || "Voulez-vous vraiment supprimer cet élément ?";
                    if (confirmMsg) confirmMsg.textContent = msg;
                    
                    const parentDiv = this.closest('div.text-center');

                    // Set up confirmation handler
                    const handler = function() {
                        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    parentDiv.remove();
                                    const galleryContainer = document.getElementById('existing_gallery_container');
                                    if (galleryContainer && galleryContainer.children.length === 0) {
                                        galleryContainer.innerHTML = '<div class="text-muted small italic w-100 text-center py-2">Galerie vide</div>';
                                    }
                                } else {
                                    alert(data.message || 'Error deleting image');
                                }
                            })
                            .catch(error => console.error('Error:', error));
                        
                        confirmModal.hide();
                        confirmBtn.removeEventListener('click', handler);
                    };

                    // Clean previous handlers on confirm button
                    const newConfirmBtn = confirmBtn.cloneNode(true);
                    confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);
                    newConfirmBtn.addEventListener('click', handler);

                    confirmModal.show();
                });
            });
        }

        function bindDeleteConfirmation() {
            const deleteButtons = document.querySelectorAll('.btn-delete-confirm');
            const confirmModalElement = document.getElementById('confirmDeleteModal');
            if (!confirmModalElement) return;
            const confirmModal = bootstrap.Modal.getOrCreateInstance(confirmModalElement);
            const confirmBtn = document.getElementById('confirmDeleteBtn');
            const confirmMsg = document.getElementById('deleteConfirmMessage');

            deleteButtons.forEach(btn => {
                // Ensure we only attach the listener once
                if (btn.hasAttribute('data-listener-attached')) return;
                btn.setAttribute('data-listener-attached', 'true');

                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const msg = this.getAttribute('data-confirm-message') || "Voulez-vous vraiment supprimer cet élément ?";
                    if (confirmMsg) confirmMsg.textContent = msg;
                    
                    const url = this.tagName === 'A' ? this.href : null;
                    const form = this.tagName === 'BUTTON' ? this.closest('form') : null;

                    // Clear previous handlers
                    const newConfirmBtn = confirmBtn.cloneNode(true);
                    confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);
                    
                    newConfirmBtn.addEventListener('click', function() {
                        if (url) window.location.href = url;
                        if (form) form.submit();
                        confirmModal.hide();
                    });
                    
                    confirmModal.show();
                });
            });
        }

        function populateLinkModal(id, type, url) {
            const form = document.getElementById('editLinkForm');
            form.action = '/admin/professional/link/update/' + id;
            document.getElementById('edit_link_type').value = type;
            document.getElementById('edit_link_url').value = url;
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Initialize delete confirmation for static elements
            bindDeleteConfirmation();

            // Image Preview Logic

            // Image Preview Logic
            function initImagePreviews() {
                const previewInputs = document.querySelectorAll('.image-preview-input');
                previewInputs.forEach(input => {
                    input.addEventListener('change', function() {
                        const containerId = this.getAttribute('data-preview-container');
                        const container = document.getElementById(containerId);
                        if (!container) return;
                        
                        container.innerHTML = '';
                        if (this.files) {
                            Array.from(this.files).forEach(file => {
                                if (file.type.startsWith('image/')) {
                                    const reader = new FileReader();
                                    reader.onload = function(e) {
                                        const imgWrapper = document.createElement('div');
                                        imgWrapper.className = 'position-relative';
                                        imgWrapper.innerHTML = `
                                            <img src="${e.target.result}" class="rounded shadow-sm border" style="width: 80px; height: 80px; object-fit: cover;">
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-circle bg-danger border border-light p-1" style="cursor:pointer" onclick="this.parentElement.remove()">
                                                <i class="fas fa-times fa-xs"></i>
                                            </span>
                                        `;
                                        container.appendChild(imgWrapper);
                                    }
                                    reader.readAsDataURL(file);
                                }
                            });
                        }
                    });
                });
            }

            initImagePreviews();
        });
    </script>
{% endblock %}
