<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>{% block title %}Individual Dashboard{%endblock %}</title>
    <meta name="robots" content="noindex, follow">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="{{ asset('assets/drilleedo/images/favicon.png') }}">

    <!-- CSS -->
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/vendor/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/vendor/slick.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/vendor/slick-theme.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/sal.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/feather.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/fontawesome.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/euclid-circulara.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/swiper.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/odometer.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/animation.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/bootstrap-select.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/jquery-ui.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/magnigy-popup.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/plyr.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/plugins/jodit.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/styles.css') }}">
    
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/drilleedo.css') }}">
    <!-- Individual Space Dashboard Styles (Harmonized with Index) -->
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/individual-dashboard.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/custom/professional_dashboard_charter.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/drilleedo/css/custom/drilleedo_components.css') }}">
    
    {% block stylesheets %}{% endblock %}
</head>

<body>
    {% include 'partials/_public_header.html.twig' %}

    <div class="rbt-page-banner-wrapper">
        <!-- Start Banner BG Image  -->
        <div class="rbt-banner-image"></div>
    </div>

    <!-- Start Dashboard Area -->
    <div class="rbt-dashboard-area rbt-section-overlayping-top rbt-section-gapBottom">
        <div class="container">
            <div class="dr-pro-header mb-5" style="background-image: url('{{ asset('uploads/banners/individual.png') }}'); position: relative; height: 160px; background-size: cover; background-position: center; border-radius: 16px; overflow: hidden;">
                <div class="dr-pro-header-overlay" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(to bottom, rgba(13,33,81,0.1), rgba(13,33,81,0.6));"></div>
                
                <div class="d-flex align-items-center h-100 px-4 position-relative" style="z-index: 2;">
                    <div class="pro-avatar-wrapper me-4">
                        <div class="pro-avatar-img d-flex align-items-center justify-content-center shadow-lg" style="width: 80px; height: 80px; border-radius: 50%; background: var(--drl-orange); color: white; font-size: 2rem; font-weight: 800; border: 4px solid rgba(255,255,255,0.2);">
                            {{ (app.user.personalInfos ? app.user.personalInfos.firstName|first : app.user.email|first)|upper }}
                        </div>
                    </div>
                    <div class="text-white">
                        <h3 class="mb-1 fw-bold text-white">{{ app.user.personalInfos ? (app.user.personalInfos.firstName ~ ' ' ~ app.user.personalInfos.lastName) : app.user.email }}</h3>
                        <div class="d-flex align-items-center gap-2 opacity-75">
                            <span class="badge bg-white text-dark fw-bold px-3 py-1">Individual Account</span>
                            <span class="text-white small">/ {{ app.user.email }}</span>
                        </div>
                    </div>
                    
                    <div class="ms-auto">
                        <a href="{{ path('individual_quote_new') }}" class="drl-btn-orange">
                            <i class="feather-plus me-2"></i> Post New Request
                        </a>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <div class="row g-5">
                        <!-- Start Dashboard Sidebar  -->
                        <div class="col-lg-3">
                            {% include 'individual/partials/_sidebar.html.twig' %}
                        </div>
                        <!-- End Dashboard Sidebar  -->

                        <div class="col-lg-9">
                             {% for label, messages in app.flashes %}
                                 {% for message in messages %}
                                     {% set alertType = label == 'error' ? 'danger' : label %}
                                     {% set alertIcon = 'feather-info' %}
                                     {% if label == 'success' %}{% set alertIcon = 'feather-check-circle' %}
                                     {% elseif label == 'error' or label == 'danger' %}{% set alertIcon = 'feather-alert-octagon' %}
                                     {% elseif label == 'warning' %}{% set alertIcon = 'feather-alert-triangle' %}
                                     {% endif %}

                                     <div class="drl-alert drl-alert--{{ alertType }} alert-dismissible fade show shadow-sm" role="alert">
                                         <i class="{{ alertIcon }} alert-icon"></i>
                                         <div class="alert-content">{{ message }}</div>
                                         <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                     </div>
                                 {% endfor %}
                             {% endfor %}
                            
                            {% block body %}{% endblock %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Dashboard Area -->


    {% include 'partials/_public_footer.html.twig' %}

    <!-- JS -->
    <script src="{{ asset('assets/drilleedo/js/vendor/modernizr.min.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/jquery.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/bootstrap.min.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/sal.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/odometer.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/backtotop.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/isotop.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/imageloaded.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/vendor/bootstrap-select.min.js') }}"></script>
    <script src="{{ asset('assets/drilleedo/js/main.js') }}"></script>
    
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    
    <script>
        $(document).ready(function() {
            if ($('.drl-table').length > 0) {
                $('.drl-table').DataTable({
                    autoWidth: false,
                    responsive: true,
                    dom: '<"d-flex justify-content-between align-items-center mb-0"fl>rt<"d-flex justify-content-between align-items-center mt-3"ip>',
                    language: {
                        search: '',
                        searchPlaceholder: 'Search anything...',
                        lengthMenu: '_MENU_',
                        info: 'Showing _START_ to _END_ of _TOTAL_ entries',
                        paginate: { 
                            'next': '<i class="feather-chevron-right"></i>', 
                            'previous': '<i class="feather-chevron-left"></i>' 
                        }
                    },
                    drawCallback: function() {
                        $('.dataTables_paginate > .paginate_button').addClass('shadow-sm');
                    }
                });
            }
        });
    </script>
    
    {% block javascripts %}
        <script src="{{ asset('assets/drilleedo/js/category-selector.js') }}"></script>
    {% endblock %}
    {% block modals %}
        {{ include('individual/partials/_dashboard_modals.html.twig') }}
    {% endblock %}
</body>
</html>
