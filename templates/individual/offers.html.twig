{% extends 'individual/base_individual.html.twig' %}

{% block title %}{{ 'individual.received_offers'|trans }} - Drilleedo{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ══════════════════════════════════════════
   OFFERS CARD GRID
══════════════════════════════════════════ */
.offer-card {
    background: #fff;
    border: 1.5px solid #e8edf5;
    border-radius: 16px;
    overflow: hidden;
    transition: box-shadow .2s, transform .2s;
    display: flex;
    flex-direction: column;
    height: 100%;
}
.offer-card:hover {
    box-shadow: 0 8px 28px rgba(13,33,81,.1);
    transform: translateY(-2px);
}
.offer-card.unread { border-color: #fed7aa; box-shadow: 0 2px 12px rgba(249,115,22,.1); }
.offer-card.accepted { border-color: #86efac; }
.offer-card.rejected { opacity: .75; }
.offer-card-bar { height: 4px; width: 100%; }
.offer-card-bar.published  { background: var(--drl-orange,#f97316); }
.offer-card-bar.interested { background: #f59e0b; }
.offer-card-bar.accepted   { background: #10b981; }
.offer-card-bar.rejected   { background: #ef4444; }
.offer-card-bar.closed     { background: #94a3b8; }
.offer-card-body { padding: 18px 20px; flex: 1; }
.offer-card-footer {
    padding: 12px 20px;
    border-top: 1px solid #f1f5f9;
    background: #f8fafc;
    display: flex; align-items: center; gap: 8px;
}
.offer-price {
    font-size: 2rem; font-weight: 800; color: #0d2151; line-height: 1;
}
.offer-price-curr { font-size: .95rem; color: #64748b; font-weight: 600; margin-left: 3px; }
.offer-unread-dot {
    width: 9px; height: 9px; border-radius: 50%;
    background: #f97316;
    display: inline-block;
    box-shadow: 0 0 0 3px rgba(249,115,22,.2);
}
.offer-star { color: #fbbf24; font-size: 12px; }
.offer-star.empty { color: #e2e8f0; }

/* Filter bar */
.of-filter-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
}
.of-filter-pill {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 16px; border-radius: 50px;
    font-size: 13px; font-weight: 500;
    border: 1.5px solid #e2e8f0; background: #f8fafc; color: #64748b;
    cursor: pointer; transition: all .2s; user-select: none;
}
.of-filter-pill:hover { border-color: #f97316; color: #f97316; background: #fff7ed; }
.of-filter-pill.active { background: #fff7ed; border-color: #f97316; color: #f97316; font-weight: 600; }
.of-filter-pill.active-new { background: #fff7ed; border-color: #f97316; color: #f97316; font-weight: 700; }
.of-filter-pill.active-accepted { background: #f0fdf4; border-color: #10b981; color: #059669; font-weight: 600; }

/* Search bar */
.of-search {
    flex: 1; min-width: 180px; max-width: 280px;
    padding: 8px 14px 8px 36px;
    border: 1.5px solid #e2e8f0; border-radius: 10px;
    font-size: 13px; color: #1e293b; background: #f8fafc;
    outline: none; transition: all .2s;
}
.of-search:focus { border-color: #f97316; background: #fff; box-shadow: 0 0 0 3px rgba(249,115,22,.1); }
.of-search-wrap { position: relative; }
.of-search-wrap i { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 14px; pointer-events: none; }

/* Sort select */
.of-sort {
    padding: 8px 14px; border-radius: 10px;
    border: 1.5px solid #e2e8f0; background: #f8fafc;
    font-size: 13px; color: #475569; cursor: pointer; outline: none;
}

@media (max-width: 575px) {
    .offer-price { font-size: 1.6rem; }
}
</style>
{% endblock %}

{% block body %}
{# ── Count unread ── #}
{% set unreadOffers = 0 %}
{% set newOffers = [] %}
{% for o in offers %}
    {% if not o.isViewed and o.status|upper in ['PUBLISHED','INTERESTED'] %}
        {% set unreadOffers = unreadOffers + 1 %}
    {% endif %}
{% endfor %}

{# ── Header ── #}
<div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="color:#0d2151;">
            <i class="ph-tray me-2" style="color:#f97316;"></i>{{ 'individual.received_offers'|trans }}
        </h4>
        <p class="text-muted mb-0" style="font-size:14px;">{{ 'individual.received_offers_sub'|trans }}</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        {% if unreadOffers > 0 %}
            <span class="drl-tag" style="background:#fff7ed;border-color:#fed7aa;color:#c2410c;font-weight:700;">
                <span class="offer-unread-dot me-1"></span>
                {{ unreadOffers }} non lue{{ unreadOffers > 1 ? 's' : '' }}
            </span>
        {% endif %}
        <span class="drl-tag drl-tag--sent">{{ offers|length }} {{ 'individual.total'|trans }}</span>
    </div>
</div>

{% if unreadOffers > 0 %}
<div class="d-flex align-items-center gap-3 p-3 rounded-3 mb-4 shadow-sm"
     style="background:#fff7ed;border:1.5px solid #fed7aa;border-left:4px solid #f97316;">
    <i class="ph-eye-slash" style="color:#f97316;font-size:20px;"></i>
    <div class="flex-grow-1">
        <div class="fw-bold" style="color:#c2410c;">{{ unreadOffers }} offre{{ unreadOffers > 1 ? 's' : '' }} non lue{{ unreadOffers > 1 ? 's' : '' }} — consultez-les pour que les prestataires soient notifiés</div>
        <div class="small text-muted">La lecture d'une offre notifie automatiquement le prestataire.</div>
    </div>
</div>
{% endif %}

{% if offers|length > 0 %}
    {# ── Filter + Search bar ── #}
    <div class="of-filter-bar">
        <div class="of-search-wrap">
            <i class="ph-magnifying-glass"></i>
            <input type="text" id="offerSearch" class="of-search" placeholder="Rechercher une demande ou un pro...">
        </div>

        <button class="of-filter-pill active" data-filter="all">
            <i class="ph-stack"></i> Toutes
        </button>
        {% if unreadOffers > 0 %}
        <button class="of-filter-pill" data-filter="unread">
            <span class="offer-unread-dot"></span> Non lues
        </button>
        {% endif %}
        <button class="of-filter-pill" data-filter="PUBLISHED">
            <i class="ph-paper-plane-tilt"></i> Envoyées
        </button>
        <button class="of-filter-pill" data-filter="INTERESTED">
            <i class="ph-bookmark"></i> Intéressé
        </button>
        <button class="of-filter-pill" data-filter="ACCEPTED">
            <i class="ph-check-circle"></i> Acceptées
        </button>
        <button class="of-filter-pill" data-filter="REJECTED">
            <i class="ph-x-circle"></i> Refusées
        </button>

        <select id="offerSort" class="of-sort ms-auto">
            <option value="date-desc">Plus récentes</option>
            <option value="date-asc">Plus anciennes</option>
            <option value="price-asc">Prix croissant</option>
            <option value="price-desc">Prix décroissant</option>
        </select>
    </div>

    {# ── Empty filter result ── #}
    <div id="offerEmptyFilter" style="display:none;" class="py-5 text-center">
        <i class="ph-funnel text-muted" style="font-size:3rem;opacity:.3;"></i>
        <p class="text-muted mt-3">Aucune offre ne correspond aux filtres sélectionnés.</p>
    </div>

    {# ── Cards Grid ── #}
    <div class="row g-4" id="offersGrid">
        {% for offer in offers %}
            {% set parentRequest = offer.quoteRequest ?? offer.directRequest %}
            {% set providerName = offer.provider.primaryContact
                ? (offer.provider.primaryContact.firstName ~ ' ' ~ offer.provider.primaryContact.lastName)
                : (offer.provider.companyName|default(offer.provider.email)) %}
            {% set isUnread = not offer.isViewed and offer.status|upper in ['PUBLISHED','INTERESTED'] %}
            {% set st = offer.status|lower %}
            {% set avgRating = offer.provider.stats ? offer.provider.stats.averageRating : 0 %}
            {% set reviewCount = offer.provider.stats ? offer.provider.stats.reviewCount : 0 %}

            <div class="col-md-6 col-xl-4 offer-card-wrap"
                 data-status="{{ offer.status|upper }}"
                 data-unread="{{ isUnread ? '1' : '0' }}"
                 data-price="{{ offer.price }}"
                 data-date="{{ offer.createdAt|date('U') }}"
                 data-search="{{ providerName|lower }} {{ parentRequest ? parentRequest.title|lower : '' }}">

                <div class="offer-card {{ isUnread ? 'unread' : '' }} {{ st }}">
                    <div class="offer-card-bar {{ st }}"></div>
                    <div class="offer-card-body">

                        {# Unread pulse badge #}
                        {% if isUnread %}
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="offer-unread-dot"></span>
                                <span style="font-size:11px;color:#f97316;font-weight:700;">Nouvelle offre — non lue</span>
                            </div>
                        {% endif %}

                        {# Provider row #}
                        <div class="d-flex align-items-center gap-3 mb-3">
                            {% if offer.provider.logo %}
                                <img src="{{ asset('uploads/logos/' ~ offer.provider.logo) }}" alt="{{ providerName }}"
                                     style="width:46px;height:46px;border-radius:50%;object-fit:cover;border:2px solid #e2e8f0;flex-shrink:0;">
                            {% else %}
                                <div class="drl-stat-icon drl-stat-icon--1 m-0 flex-shrink-0"
                                     style="width:46px;height:46px;font-size:17px;border-radius:50%;">
                                    {{ providerName|slice(0,1)|upper }}
                                </div>
                            {% endif %}
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-bold text-dark" style="font-size:14px;line-height:1.2;">{{ providerName }}</div>
                                <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">
                                    <span class="drl-tag drl-tag--draft p-0 px-2" style="font-size:10px;">{{ offer.provider.getType() }}</span>
                                    {% if avgRating > 0 %}
                                        <span class="d-inline-flex align-items-center gap-1" style="font-size:12px;">
                                            {% for i in 1..5 %}
                                                <i class="ph-star offer-star {{ i <= avgRating ? '' : 'empty' }}"
                                                   style="{{ i <= avgRating ? 'fill:#fbbf24;' : '' }}"></i>
                                            {% endfor %}
                                            <span class="fw-semibold ms-1" style="color:#92400e;">{{ avgRating|number_format(1) }}</span>
                                            {% if reviewCount > 0 %}<span class="text-muted">({{ reviewCount }})</span>{% endif %}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                            {# Status badge #}
                            {% set stMap = {
                                'PUBLISHED':  {'class':'drl-tag--sent',    'label':'Envoyée'},
                                'INTERESTED': {'class':'drl-tag--warning', 'label':'Intéressé'},
                                'ACCEPTED':   {'class':'drl-tag--success', 'label':'Acceptée'},
                                'REJECTED':   {'class':'drl-tag--danger',  'label':'Refusée'},
                                'CLOSED':     {'class':'drl-tag--draft',   'label':'Terminée'}
                            } %}
                            {% set stInfo = stMap[offer.status|upper]|default({'class':'drl-tag--draft','label':offer.status}) %}
                            <span class="drl-tag {{ stInfo.class }} flex-shrink-0" style="font-size:11px;">{{ stInfo.label }}</span>
                        </div>

                        {# Price #}
                        <div class="mb-3 p-3 rounded-3" style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:1px solid #86efac;">
                            <div class="d-flex align-items-baseline">
                                <span class="offer-price">{{ offer.price|number_format(0,',',' ') }}</span>
                                <span class="offer-price-curr">$</span>
                            </div>
                            <div class="small text-muted mt-1" style="font-size:11px;">
                                <i class="ph-calendar me-1"></i>Reçue le {{ offer.createdAt|date('d/m/Y') }}
                                {% if offer.viewedAt %}
                                    · <i class="ph-eye me-1"></i>Lue le {{ offer.viewedAt|date('d/m/Y') }}
                                {% endif %}
                            </div>
                        </div>

                        {# Related request #}
                        {% if parentRequest %}
                            <div class="d-flex align-items-center gap-2 p-2 rounded-3 mb-3" style="background:#f8fafc;border:1px solid #e2e8f0;">
                                <i class="ph-link text-muted" style="font-size:12px;flex-shrink:0;"></i>
                                <div class="min-w-0">
                                    <span class="small fw-semibold text-dark d-block" style="font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                        {{ parentRequest.title|slice(0,55) }}{% if parentRequest.title|length > 55 %}…{% endif %}
                                    </span>
                                    <span style="font-size:10px;color:#94a3b8;">{{ offer.quoteRequest ? 'Demande de devis' : 'Demande directe' }}</span>
                                </div>
                            </div>
                        {% endif %}

                        {# Offer description snippet #}
                        {% if offer.description %}
                            <p class="text-muted mb-0" style="font-size:12px;line-height:1.5;">
                                {{ offer.description|slice(0,120) }}{% if offer.description|length > 120 %}…{% endif %}
                            </p>
                        {% endif %}

                        {# Meta chips #}
                        {% if offer.estimatedDuration or offer.possibleStartDate %}
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                {% if offer.estimatedDuration %}
                                    <span style="font-size:11px;padding:3px 8px;border-radius:20px;background:#f1f5f9;color:#475569;">
                                        <i class="ph-clock me-1"></i>{{ offer.estimatedDuration }} {{ offer.estimatedDurationUnit|default('j') }}
                                    </span>
                                {% endif %}
                                {% if offer.possibleStartDate %}
                                    <span style="font-size:11px;padding:3px 8px;border-radius:20px;background:#f1f5f9;color:#475569;">
                                        <i class="ph-calendar me-1"></i>Début {{ offer.possibleStartDate|date('d/m') }}
                                    </span>
                                {% endif %}
                                {% if offer.documents|length > 0 %}
                                    <span style="font-size:11px;padding:3px 8px;border-radius:20px;background:#f1f5f9;color:#475569;">
                                        <i class="ph-paperclip me-1"></i>{{ offer.documents|length }} doc{{ offer.documents|length > 1 ? 's' : '' }}
                                    </span>
                                {% endif %}
                            </div>
                        {% endif %}

                    </div>{# /body #}

                    <div class="offer-card-footer">
                        {# Primary CTA #}
                        <a href="{{ path('individual_offer_show', {'id': offer.id}) }}"
                           class="drl-act-btn drl-act-btn--view flex-grow-1 justify-content-center" style="font-size:13px;">
                            <i class="ph-eye me-1"></i> Voir l'offre
                        </a>

                        {# Quick actions #}
                        {% if parentRequest and parentRequest.status|upper not in ['CLOSED'] %}
                            {% if offer.status|upper in ['PUBLISHED','INTERESTED'] %}
                                <button type="button"
                                        class="drl-btn-orange justify-content-center shadow-sm"
                                        style="font-size:12px;padding:8px 14px;"
                                        data-bs-toggle="modal"
                                        data-bs-target="#acceptOfferQuickModal{{ offer.id }}">
                                    <i class="ph-check-circle me-1"></i> Accepter
                                </button>
                            {% elseif offer.status|upper == 'ACCEPTED' %}
                                <span class="drl-tag drl-tag--success" style="font-size:11px;">
                                    <i class="ph-medal me-1"></i>Acceptée
                                </span>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>{# /offer-card-wrap #}
        {% endfor %}
    </div>{# /offersGrid #}

{% else %}
    {# ── Empty state ── #}
    <div class="drl-card">
        <div class="py-5 text-center">
            <div class="mb-4 text-muted opacity-20" style="font-size:5rem;">
                <i class="ph-tray"></i>
            </div>
            <h5 class="fw-bold text-dark">{{ 'individual.empty_offers_title'|trans }}</h5>
            <p class="text-muted mb-4 px-5">{{ 'individual.empty_offers_sub'|trans }}</p>
            <div class="d-flex justify-content-center gap-3 flex-wrap mt-4">
                <a href="{{ path('individual_quote_new') }}" class="drl-btn-orange px-5 shadow-lg">
                    <i class="ph-plus me-2"></i> {{ 'individual.btn_post_global'|trans }}
                </a>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}

{% block modals %}
{{ parent() }}
{% for offer in offers %}
    {% set parentRequest = offer.quoteRequest ?? offer.directRequest %}
    {% set providerName2 = offer.provider.primaryContact
        ? (offer.provider.primaryContact.firstName ~ ' ' ~ offer.provider.primaryContact.lastName)
        : (offer.provider.companyName|default(offer.provider.email)) %}
    {% if parentRequest and parentRequest.status|upper not in ['CLOSED'] and offer.status|upper in ['PUBLISHED','INTERESTED'] %}
    <div class="modal fade" id="acceptOfferQuickModal{{ offer.id }}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content drl-modal-content">
                <div class="modal-body drl-modal-body p-5 text-center">
                    <div class="mb-4">
                        <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle"
                             style="width:72px;height:72px;background:rgba(16,185,129,.12);">
                            <i class="ph-check-circle" style="font-size:2rem;color:#10b981;"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Accepter cette offre ?</h4>
                    <p class="text-muted px-2 mb-1">
                        Offre de <strong>{{ providerName2 }}</strong>
                        au prix de <strong style="color:#059669;">{{ offer.price|number_format(0,',',' ') }} $</strong>.
                    </p>
                    <p class="small text-muted px-2 mb-4">Les autres offres sur cette demande seront archivées.</p>
                    <div class="d-flex flex-column gap-3">
                        <form action="{{ path('individual_offer_accept', {'id': offer.id}) }}" method="POST">
                            <input type="hidden" name="_token" value="{{ csrf_token('offer-action-' ~ offer.id) }}">
                            <button type="submit"
                                    class="w-100 py-3 d-flex align-items-center justify-content-center gap-2 rounded-3 border-0 fw-bold"
                                    style="background:linear-gradient(135deg,#10b981,#059669);color:#fff;font-size:1rem;">
                                <i class="ph-check-circle"></i> Oui, accepter
                            </button>
                        </form>
                        <button type="button" class="drl-act-btn drl-act-btn--view w-100 py-3 justify-content-center border-0" data-bs-dismiss="modal">
                            Annuler
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
{% endfor %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const cards     = Array.from(document.querySelectorAll('.offer-card-wrap'));
    const pills     = document.querySelectorAll('.of-filter-pill');
    const searchEl  = document.getElementById('offerSearch');
    const sortEl    = document.getElementById('offerSort');
    const emptyMsg  = document.getElementById('offerEmptyFilter');
    const grid      = document.getElementById('offersGrid');
    let activeFilter = 'all';

    function applyFilters() {
        const q = searchEl ? searchEl.value.toLowerCase().trim() : '';
        let visible = 0;

        cards.forEach(card => {
            const status  = card.dataset.status;
            const unread  = card.dataset.unread === '1';
            const search  = card.dataset.search || '';

            let show = true;
            if (activeFilter !== 'all') {
                if (activeFilter === 'unread') { show = unread; }
                else { show = status === activeFilter; }
            }
            if (show && q) { show = search.includes(q); }

            card.style.display = show ? '' : 'none';
            if (show) visible++;
        });

        if (emptyMsg) emptyMsg.style.display = visible === 0 ? 'block' : 'none';
    }

    function sortCards() {
        if (!sortEl || !grid) return;
        const val = sortEl.value;
        const sorted = cards.slice().sort((a, b) => {
            if (val === 'price-asc')  return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
            if (val === 'price-desc') return parseFloat(b.dataset.price) - parseFloat(a.dataset.price);
            if (val === 'date-asc')   return parseInt(a.dataset.date) - parseInt(b.dataset.date);
            return parseInt(b.dataset.date) - parseInt(a.dataset.date); // date-desc default
        });
        sorted.forEach(c => grid.appendChild(c));
        applyFilters();
    }

    pills.forEach(pill => {
        pill.addEventListener('click', function () {
            pills.forEach(p => p.classList.remove('active'));
            this.classList.add('active');
            activeFilter = this.dataset.filter;
            applyFilters();
        });
    });

    if (searchEl) searchEl.addEventListener('input', applyFilters);
    if (sortEl)   sortEl.addEventListener('change', sortCards);
});
</script>
{% endblock %}
