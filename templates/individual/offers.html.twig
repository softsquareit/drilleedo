{% extends 'individual/base_individual.html.twig' %}

{% block title %}Received Offers - {{ app.user.firstname|default('Individual') }}{% endblock %}

{% block body %}
    <div class="pro-card pro-card-elevated">
        <div class="pro-card-header">
            <div>
                <h4 class="pro-card-title">Received Offers</h4>
                <p class="pro-card-subtitle">All offers received for your quote and direct requests</p>
            </div>
            <div class="d-flex gap-2">
                <span class="pro-badge info">{{ offers|length }} Total</span>
            </div>
        </div>

        <div class="pro-table-wrapper border-0">
            <table class="pro-table">
                <thead>
                    <tr>
                        <th style="width: 25%">Related Request</th>
                        <th>Professional / Company</th>
                        <th>Offer Details</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for offer in offers %}
                        {% set parentRequest = offer.quoteRequest ?? offer.directRequest %}
                        <tr>
                            <td>
                                <div>
                                    <span class="pro-fw-semibold d-block text-dark">{{ parentRequest.title }}</span>
                                    <span class="pro-badge secondary p-0 px-2" style="font-size: 1rem;">
                                        {{ offer.quoteRequest ? 'Quote Request' : 'Direct Request' }}
                                    </span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="pro-stat-icon primary m-0" style="width: 40px; height: 40px; min-width: 40px; font-size: 1rem;">
                                        {% set providerName = offer.provider.primaryContact ? (offer.provider.primaryContact.firstName ~ ' ' ~ offer.provider.primaryContact.lastName) : (offer.provider.companyName|default(offer.provider.email)) %}
                                        {{ providerName|slice(0, 1)|upper }}
                                    </div>
                                    <div>
                                        <span class="fw-bold d-block text-dark" style="font-size: 1.05rem;">{{ providerName }}</span>
                                        <span class="text-muted small" style="font-size: 1rem;">{{ offer.provider.getType() }}</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark" style="font-size: 1.2rem;">{{ offer.price|number_format(2) }} $</div>
                                <div class="text-muted small" style="font-size: 1rem;">Received {{ offer.createdAt|date('M d, Y') }}</div>
                            </td>
                            <td>
                                {% set offerStatusMap = {
                                    'PENDING': {'class': 'warning', 'label': 'Pending', 'icon': 'feather-clock'},
                                    'ACCEPTED': {'class': 'success', 'label': 'Accepted', 'icon': 'feather-check-circle'},
                                    'REJECTED': {'class': 'danger', 'label': 'Rejected', 'icon': 'feather-x-circle'}
                                } %}
                                {% set offerInfo = offerStatusMap[offer.status|upper]|default({'class': 'secondary', 'label': offer.status, 'icon': 'feather-help-circle'}) %}
                                <span class="pro-badge {{ offerInfo.class }}">
                                    <i class="{{ offerInfo.icon }} me-1"></i>{{ offerInfo.label }}
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="{{ path('individual_offer_show', {'id': offer.id}) }}" class="indiv-action-badge view">
                                        <i class="feather-eye"></i> View
                                    </a>

                                    {% if parentRequest.status not in ['Closed'] %}
                                        {% if offer.status|upper == 'PENDING' %}
                                            <form action="{{ path('individual_offer_accept', {'id': offer.id}) }}" method="POST" class="d-inline"
                                                  onsubmit="return confirm('Accept this offer? This will notify the provider.');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('offer-action-' ~ offer.id) }}">
                                                <button type="submit" class="indiv-action-badge view" style="color: var(--indiv-success); background: var(--indiv-success-bg);">
                                                    <i class="feather-check"></i> Accept
                                                </button>
                                            </form>
                                            <form action="{{ path('individual_offer_reject', {'id': offer.id}) }}" method="POST" class="d-inline"
                                                  onsubmit="return confirm('Reject this offer?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('offer-action-' ~ offer.id) }}">
                                                <button type="submit" class="indiv-action-badge delete">
                                                    <i class="feather-x"></i> Reject
                                                </button>
                                            </form>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="pro-table-empty">
                                <div class="pro-empty-state">
                                    <div class="pro-empty-icon">
                                        <i class="feather-inbox"></i>
                                    </div>
                                    <h6 class="pro-empty-title">No offers received yet</h6>
                                    <p class="pro-empty-text">Professionals will send you offers for your requests</p>
                                    <div class="d-flex justify-content-center gap-3 mt-4">
                                        <a href="{{ path('individual_quote_new') }}" class="indiv-btn-primary pro-btn-sm">
                                            <i class="feather-plus"></i> Post Global Request
                                        </a>
                                        <a href="{{ path('professionals_list') }}" class="indiv-btn-secondary pro-btn-sm">
                                            <i class="feather-search"></i> Direct Inquiry
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
