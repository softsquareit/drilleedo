{% extends 'individual/base_individual.html.twig' %}

{% block title %}Received Offers - {{ app.user.firstname|default('Individual') }}{% endblock %}

{% block body %}
    <div class="drl-card">
        <div class="drl-card-head">
            <div>
                <h4 class="drl-card-title">Received Offers</h4>
                <p class="drl-card-sub">All offers received for your quote and direct requests</p>
            </div>
            <div class="d-flex gap-2">
                <span class="drl-tag drl-tag--sent">{{ offers|length }} Total</span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="drl-table w-100">
                <thead>
                    <tr>
                        <th style="width: 25%">Related Request</th>
                        <th>Professional / Company</th>
                        <th>Offer Details</th>
                        <th>Status</th>
                        <th class="text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for offer in offers %}
                        {% set parentRequest = offer.quoteRequest ?? offer.directRequest %}
                        <tr>
                            <td>
                                <div class="px-2">
                                    <span class="fw-bold d-block text-dark mb-1" style="font-size: 1.1rem;">{{ parentRequest.title }}</span>
                                    <span class="drl-tag drl-tag--draft p-0 px-2 mt-1" style="font-size: 10px;">
                                        {{ offer.quoteRequest ? 'Quote Request' : 'Direct Request' }}
                                    </span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-3 px-2">
                                    <div class="drl-stat-icon drl-stat-icon--1 m-0 shadow-sm" style="width: 36px; height: 36px; font-size: 14px;">
                                        {% set providerName = offer.provider.primaryContact ? (offer.provider.primaryContact.firstName ~ ' ' ~ offer.provider.primaryContact.lastName) : (offer.provider.companyName|default(offer.provider.email)) %}
                                        {{ providerName|slice(0, 1)|upper }}
                                    </div>
                                    <div>
                                        <span class="fw-bold d-block text-dark small">{{ providerName }}</span>
                                        <span class="text-muted" style="font-size: 10px;">{{ offer.provider.getType() }}</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark px-2" style="font-size: 1.1rem;">{{ offer.price|number_format(2) }} $</div>
                                <div class="text-muted small px-2" style="font-size: 10px;">Received {{ offer.createdAt|date('M d, Y') }}</div>
                            </td>
                            <td>
                                {% set offerStatusMap = {
                                    'DRAFT': {'class': 'drl-tag--draft', 'label': 'Draft', 'icon': 'feather-file'},
                                    'PUBLISHED': {'class': 'drl-tag--sent', 'label': 'New', 'icon': 'feather-star'},
                                    'ACCEPTED': {'class': 'drl-tag--success', 'label': 'Accepted', 'icon': 'feather-check-circle'},
                                    'REJECTED': {'class': 'drl-tag--danger', 'label': 'Rejected', 'icon': 'feather-x-circle'},
                                    'CLOSED': {'class': 'drl-tag--danger', 'label': 'Closed', 'icon': 'feather-lock'}
                                } %}
                                {% set offerInfo = offerStatusMap[offer.status|upper]|default({'class': 'drl-tag--draft', 'label': offer.status, 'icon': 'feather-help-circle'}) %}
                                <span class="drl-tag {{ offerInfo.class }}">
                                    <i class="{{ offerInfo.icon }} me-1"></i>{{ offerInfo.label }}
                                </span>
                            </td>
                            <td class="text-end px-3">
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="{{ path('individual_offer_show', {'id': offer.id}) }}" class="drl-act-btn drl-act-btn--view shadow-sm">
                                        <i class="feather-eye"></i> View
                                    </a>

                                    {% if parentRequest.status not in ['Closed'] %}
                                        {% if offer.status|upper == 'PUBLISHED' %}
                                            <form action="{{ path('individual_offer_accept', {'id': offer.id}) }}" method="POST" class="d-inline"
                                                  data-confirm="Accept this offer? All other pending offers will be automatically rejected.">
                                                <input type="hidden" name="_token" value="{{ csrf_token('offer-action-' ~ offer.id) }}">
                                                <button type="submit" class="drl-act-btn shadow-sm" style="background: rgba(40, 167, 69, 0.1); color: #28a745; border: none;">
                                                    <i class="feather-check"></i> Accept
                                                </button>
                                            </form>
                                            <form action="{{ path('individual_offer_reject', {'id': offer.id}) }}" method="POST" class="d-inline"
                                                  data-confirm="Reject this offer?">
                                                <input type="hidden" name="_token" value="{{ csrf_token('offer-action-' ~ offer.id) }}">
                                                <button type="submit" class="drl-act-btn shadow-sm" style="background: rgba(220, 53, 69, 0.1); color: #dc3545; border: none;">
                                                    <i class="feather-x"></i> Reject
                                                </button>
                                            </form>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="py-5 text-center">
                                <div class="mb-4 text-muted opacity-25">
                                    <i class="feather-inbox" style="font-size: 5rem;"></i>
                                </div>
                                <h5 class="fw-bold text-dark">No offers received yet</h5>
                                <p class="text-muted mb-4 px-5">Professionals will send you offers for your requests. Try posting a new one!</p>
                                <div class="d-flex justify-content-center gap-3 mt-4">
                                    <a href="{{ path('individual_quote_new') }}" class="drl-btn-orange px-4 shadow-lg">
                                        <i class="feather-plus me-2"></i> Post Global Request
                                    </a>
                                    <a href="{{ path('professionals_list') }}" class="drl-act-btn drl-act-btn--view px-4 py-2 border-0 shadow-sm">
                                        <i class="feather-search me-2"></i> Find Professionals
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
            </table>
        </div>
    </div>
{% endblock %}
