{% extends 'individual/base_individual.html.twig' %}

{% block title %}{{ quote.title }} - Drilleedo{% endblock %}

{% block stylesheets %}{{ parent() }}
<style>
.qs-photo-thumb {
    width: 72px; height: 72px; object-fit: cover;
    border-radius: 10px; border: 2px solid #e2e8f0;
    cursor: pointer; transition: transform .2s, border-color .2s;
}
.qs-photo-thumb:hover { transform: scale(1.06); border-color: #f97316; }
.qs-offer-rating { display:inline-flex; align-items:center; gap:3px; font-size:12px; }
.qs-star { color:#fbbf24; font-size:11px; }
</style>
{% endblock %}

{% block body %}
    {# ── Status Banners ── #}
    {% if quote.status|upper == 'CLOSED' %}
        <div class="drl-alert drl-alert--warning d-flex align-items-center gap-3 mb-4">
            <i class="ph-lock alert-icon"></i>
            <div>
                <div class="fw-bold">{{ 'individual.request_closed'|trans }}</div>
                <div class="small opacity-75">{{ 'individual.request_closed_sub'|trans }}</div>
            </div>
        </div>
    {% elseif quote.status|upper == 'IN_PROGRESS' %}
        <div class="drl-alert drl-alert--success d-flex align-items-center gap-3 mb-4">
            <i class="ph-wrench alert-icon"></i>
            <div>
                <div class="fw-bold">{{ 'individual.status_in_progress_msg'|trans }}</div>
            </div>
        </div>
    {% elseif quote.status|upper == 'ACCEPTED' %}
        <div class="drl-alert drl-alert--success d-flex align-items-center gap-3 mb-4">
            <i class="ph-medal alert-icon"></i>
            <div>
                <div class="fw-bold">{{ 'individual.status_accepted_msg'|trans }}</div>
            </div>
        </div>
    {% endif %}

    {# ── Workflow Stepper ── #}
    {% set steps = [
        {'key': 'DRAFT',       'label': 'Brouillon',  'icon': 'ph-file'},
        {'key': 'PUBLISHED',   'label': 'Publiée',    'icon': 'ph-paper-plane-tilt'},
        {'key': 'ACCEPTED',    'label': 'Acceptée',   'icon': 'ph-medal'},
        {'key': 'IN_PROGRESS', 'label': 'En cours',   'icon': 'ph-wrench'},
        {'key': 'CLOSED',      'label': 'Clôturée',   'icon': 'ph-check-square'}
    ] %}
    {% set stepOrder = {'DRAFT': 0, 'PUBLISHED': 1, 'ACCEPTED': 2, 'IN_PROGRESS': 3, 'CLOSED': 4} %}
    {% set currentStep = stepOrder[quote.status|upper]|default(0) %}
    <div class="drl-card mb-4 px-4 py-3" style="background: #f8fafc;">
        <div class="d-flex align-items-center justify-content-between position-relative" style="gap: 0;">
            {# Connecting line behind steps #}
            <div style="position: absolute; top: 50%; left: 10%; right: 10%; height: 2px; background: #e2e8f0; z-index: 0; transform: translateY(-50%);"></div>
            {% for step in steps %}
                {% set idx = loop.index0 %}
                {% set isDone = idx < currentStep %}
                {% set isCurrent = idx == currentStep %}
                <div class="d-flex flex-column align-items-center gap-1 position-relative" style="z-index: 1; flex: 1;">
                    <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                         style="width: 38px; height: 38px; font-size: 16px; transition: all 0.2s;
                                {{ isDone ? 'background: #10b981; color: #fff; border: 2px solid #10b981;' :
                                   (isCurrent ? 'background: var(--drl-orange); color: #fff; border: 2px solid var(--drl-orange); box-shadow: 0 0 0 4px rgba(249,115,22,0.15);' :
                                   'background: #fff; color: #94a3b8; border: 2px solid #e2e8f0;') }}">
                        {% if isDone %}
                            <i class="ph-check" style="font-size: 14px;"></i>
                        {% else %}
                            <i class="{{ step.icon }}" style="font-size: 14px;"></i>
                        {% endif %}
                    </div>
                    <span style="font-size: 10px; font-weight: {{ isCurrent ? '700' : '500' }};
                                 color: {{ isDone ? '#10b981' : (isCurrent ? 'var(--drl-orange)' : '#94a3b8') }};
                                 white-space: nowrap;">
                        {{ step.label }}
                    </span>
                </div>
            {% endfor %}
        </div>
    </div>

    {# ── Header Actions ── #}
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <a href="{{ path('individual_quotes') }}" class="btn btn-link text-decoration-none text-muted p-0 d-flex align-items-center gap-2">
            <i class="ph-arrow-left"></i> {{ 'individual.back_quotes'|trans }}
        </a>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            {% if quote.status|upper == 'DRAFT' %}
                {# Publish #}
                <button type="button" class="drl-btn-orange shadow-sm d-flex align-items-center gap-2"
                        data-bs-toggle="modal" data-bs-target="#publishQuoteModal">
                    <i class="ph-cloud-arrow-up"></i> {{ 'individual.publish_request'|trans }}
                </button>
            {% endif %}

            {% if quote.status|upper in ['ACCEPTED', 'IN_PROGRESS'] %}
                {# Revert to Published #}
                <button type="button" class="drl-act-btn shadow-sm d-flex align-items-center gap-2"
                        style="background: rgba(251,146,60,0.1); color: #ea580c; border: none;"
                        data-bs-toggle="modal" data-bs-target="#revertQuoteModal">
                    <i class="ph-arrow-counter-clockwise"></i> {{ 'individual.revert_published'|trans }}
                </button>
            {% endif %}

            {% if quote.status|upper == 'ACCEPTED' %}
                {# Start Project #}
                <button type="button" class="drl-btn-orange shadow-sm d-flex align-items-center gap-2"
                        data-bs-toggle="modal" data-bs-target="#startQuoteModal">
                    <i class="ph-play-circle"></i> {{ 'individual.start_project'|trans }}
                </button>
            {% endif %}

            {% if quote.status|upper in ['ACCEPTED', 'IN_PROGRESS'] %}
                {# Close definitively #}
                <button type="button" class="drl-act-btn shadow-sm d-flex align-items-center gap-2"
                        style="background: rgba(100,116,139,0.1); color: #475569; border: none;"
                        data-bs-toggle="modal" data-bs-target="#closeQuoteModal">
                    <i class="ph-lock"></i> {{ 'individual.close_request'|trans }}
                </button>
            {% endif %}

            {% if quote.status|upper == 'DRAFT' %}
                {# Edit #}
                <a href="{{ path('individual_quote_edit', {'id': quote.id}) }}"
                   class="drl-act-btn drl-act-btn--view shadow-sm d-flex align-items-center gap-2 text-decoration-none">
                    <i class="ph-pencil-2"></i> {{ 'individual.edit_request'|trans }}
                </a>
            {% endif %}

            {% if quote.status|upper not in ['CLOSED'] %}                {# Delete #}
                <button type="button" class="drl-act-btn shadow-sm d-flex align-items-center gap-2"
                        style="background: rgba(220,53,69,0.1); color: #dc3545; border: none;"
                        data-bs-toggle="modal" data-bs-target="#deleteQuoteModal">
                    <i class="ph-trash"></i> {{ 'individual.delete'|trans }}
                </button>
            {% endif %}
        </div>
    </div>

    {# ── Quote Details Card ── #}
    <div class="drl-card mb-4">
        <div class="drl-card-head border-bottom pb-3">
            <div>
                <h4 class="drl-card-title mb-1">{{ quote.title }}</h4>
                <p class="mb-0 text-muted small"><i class="ph-calendar me-1"></i> {{ 'individual.posted_on'|trans }} {{ quote.creationDate|date('F j, Y') }}</p>
            </div>
            {% set statusMap = {
                'DRAFT':       {'class': 'drl-tag--draft',    'icon': 'ph-file'},
                'PUBLISHED':   {'class': 'drl-tag--sent',     'icon': 'ph-globe'},
                'ACCEPTED':    {'class': 'drl-tag--success',  'icon': 'ph-check-circle'},
                'IN_PROGRESS': {'class': 'drl-tag--warning',  'icon': 'ph-wrench'},
                'CLOSED':      {'class': 'drl-tag--danger',   'icon': 'ph-lock'}
            } %}
            {% set statusInfo = statusMap[quote.status]|default({'class': 'drl-tag--draft', 'icon': 'ph-question'}) %}
            <span class="drl-tag {{ statusInfo.class }}">
                <i class="{{ statusInfo.icon }} me-1"></i>{{ ('status.' ~ quote.status)|trans({}, 'messages') }}
            </span>
        </div>

        <div class="p-4">
            <div class="row g-4">
                <div class="col-md-8">
                    <div class="drl-label text-muted small mb-1">{{ 'individual.description'|trans }}</div>
                    <div class="text-dark text-wrap text-break" style="white-space: pre-line; line-height: 1.7;">
                        {{ quote.description|default('') }}
                    </div>
                </div>
                <div class="col-md-4 border-start">
                    <div class="ps-md-3">
                        <div class="drl-label text-muted small mb-1">{{ 'individual.category'|trans }}</div>
                        <div class="mb-4">
                            <div class="d-flex flex-column gap-2">
                                {% if quote.category and quote.category.parent %}
                                    <span class="drl-tag drl-tag--draft" style="width:fit-content;">
                                        <i class="ph-folder me-1"></i>{{ quote.category.parent.localizedTitle(app.request.locale) }}
                                    </span>
                                {% endif %}
                                <span class="drl-tag drl-tag--sent" style="width:fit-content;">
                                    <i class="ph-tag me-1"></i>{{ quote.category ? quote.category.localizedTitle(app.request.locale) : 'individual.general'|trans }}
                                </span>
                            </div>
                        </div>

                        {% if quote.desiredStartDate or quote.desiredEndDate %}
                            <div class="drl-label text-muted small mb-1">{{ 'individual.desired_start'|trans }}</div>
                            <div class="mb-4 fw-semibold text-dark small">
                                <i class="ph-calendar me-1 text-muted"></i>
                                {% if quote.desiredStartDate %}{{ quote.desiredStartDate|date('d/m/Y') }}{% endif %}
                                {% if quote.desiredStartDate and quote.desiredEndDate %} → {% endif %}
                                {% if quote.desiredEndDate %}{{ quote.desiredEndDate|date('d/m/Y') }}{% endif %}
                            </div>
                        {% endif %}

                        {% if quote.address %}
                            <div class="drl-label text-muted small mb-1"><i class="ph-map-pin me-1"></i> Adresse</div>
                            <div class="mb-4 fw-semibold text-dark small">{{ quote.address }}</div>
                        {% endif %}

                        {% if quote.budget %}
                            <div class="drl-label text-muted small mb-1"><i class="ph-currency-dollar-simple me-1"></i> Budget estimé</div>
                            <div class="mb-4 fw-semibold text-dark small">{{ quote.budget|number_format(2) }} $</div>
                        {% endif %}

                        {% if quote.languages and quote.languages|length > 0 %}
                            <div class="drl-label text-muted small mb-1">{{ 'individual.languages'|trans }}</div>
                            <div class="mb-4 d-flex flex-wrap gap-1">
                                {% for lang in quote.languages %}
                                    <span class="drl-tag drl-tag--draft p-0 px-2" style="font-size: 11px;">{{ lang }}</span>
                                {% endfor %}
                            </div>
                        {% endif %}

                        {% if quote.availabilities and quote.availabilities|length > 0 %}
                            <div class="drl-label text-muted small mb-1">{{ 'individual.avail_visit'|trans }}</div>
                            <div class="mb-4 d-flex flex-wrap gap-1">
                                {% for slot in quote.availabilities %}
                                    <span class="drl-tag drl-tag--draft p-0 px-2" style="font-size: 11px;">{{ slot }}</span>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <div class="drl-label text-muted small mb-1">{{ 'individual.urgent_intervention'|trans }}</div>
                        <div class="mb-4">
                            {% if quote.urgentIntervention %}
                                <span class="drl-tag drl-tag--danger"><i class="ph-lightning me-1"></i>{{ 'individual.yes'|trans }}</span>
                            {% else %}
                                <span class="drl-tag drl-tag--draft">{{ 'individual.no'|trans }}</span>
                            {% endif %}
                        </div>

                        <div class="drl-label text-muted small mb-1">{{ 'individual.attached_photos'|trans }}</div>
                        <div>
                            {% if quote.images|length > 0 %}
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    {% for image in quote.images %}
                                        <div class="position-relative">
                                            <img src="{{ asset('uploads/quote_requests/' ~ image) }}" alt="Photo"
                                                 class="qs-photo-thumb"
                                                 onclick="openPhotoLightbox('{{ asset('uploads/quote_requests/' ~ image) }}')"
                                                 title="Voir en grand">
                                            {% if quote.status|upper != 'CLOSED' %}
                                                <button type="button"
                                                        class="position-absolute top-0 end-0 d-flex align-items-center justify-content-center"
                                                        style="width: 20px; height: 20px; margin-top: -6px; margin-right: -6px; border-radius: 50%; background: #ef4444; color: #fff; border: 2px solid #fff; font-size: 10px; cursor: pointer; padding: 0;"
                                                        data-bs-toggle="modal" data-bs-target="#deleteImageModal{{ loop.index0 }}"
                                                        title="{{ 'individual.delete'|trans }}">
                                                    <i class="ph-x"></i>
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <span class="text-muted small fst-italic">{{ 'individual.no_photos'|trans }}</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Contact Reveal (when an offer is accepted) ── #}
    {% set acceptedOffer = null %}
    {% for offer in quote.offers %}
        {% if offer.status|upper == 'ACCEPTED' %}
            {% set acceptedOffer = offer %}
        {% endif %}
    {% endfor %}

    {% if acceptedOffer %}
        <div class="drl-card mb-4" style="border-left: 5px solid #10b981;">
            <div class="drl-card-head">
                <div class="d-flex align-items-center gap-4">
                    <div class="drl-stat-icon drl-stat-icon--3 m-0 shadow-sm" style="width: 56px; height: 56px; font-size: 24px;">
                        <i class="ph-medal"></i>
                    </div>
                    <div>
                        <h4 class="mb-1 fw-bold text-dark">{{ 'individual.provider_selected'|trans }}</h4>
                        <p class="mb-0 text-muted small">{{ 'individual.provider_selected_sub'|trans }}</p>
                    </div>
                </div>
            </div>
            <div class="p-4 pt-0">
                <div class="row g-4 mt-2">
                    {% set provider = acceptedOffer.provider %}
                    {% set provName = provider.primaryContact ? (provider.primaryContact.firstName ~ ' ' ~ provider.primaryContact.lastName) : (provider.companyName|default(provider.email)) %}
                    <div class="col-md-4">
                        <div class="p-4 rounded-4 bg-light shadow-sm h-100">
                            <div class="drl-label text-muted small mb-2"><i class="ph-user me-2 text-primary"></i>{{ 'individual.hired_pro'|trans }}</div>
                            <div class="fw-bold text-dark mb-1">{{ provName }}</div>
                            <span class="drl-tag drl-tag--sent">{{ provider.getType() }}</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-4 rounded-4 bg-light shadow-sm h-100">
                            <div class="drl-label text-muted small mb-2"><i class="ph-envelope me-2 text-primary"></i>{{ 'individual.email_address'|trans }}</div>
                            <a href="mailto:{{ provider.email }}" class="fw-bold text-dark text-decoration-none">{{ provider.email }}</a>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-4 rounded-4 bg-light shadow-sm h-100">
                            <div class="drl-label text-muted small mb-2"><i class="ph-phone me-2 text-primary"></i>{{ 'individual.phone_number'|trans }}</div>
                            <div class="fw-bold text-dark">{{ provider.phoneNum|default('individual.not_provided'|trans) }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ── Comparison Table (shown when ≥2 non-draft offers) ── #}
    {% set comparableOffers = [] %}
    {% for o in quote.offers %}
        {% if o.status|upper not in ['DRAFT'] %}
            {% set comparableOffers = comparableOffers|merge([o]) %}
        {% endif %}
    {% endfor %}

    {% if comparableOffers|length >= 2 %}
    <div class="drl-card mb-4" id="compare">
        <div class="drl-card-head">
            <div>
                <h5 class="drl-card-title mb-0"><i class="ph-chart-bar me-2 text-primary"></i>Comparaison des offres</h5>
                <p class="drl-card-sub mb-0">Comparez les {{ comparableOffers|length }} offres reçues côte à côte</p>
            </div>
            <span class="drl-tag drl-tag--sent" style="font-size:12px;">{{ comparableOffers|length }} offres</span>
        </div>
        <div class="table-responsive">
            <table class="w-100" style="border-collapse:collapse;">
                <thead>
                    <tr style="background:#f8fafc;">
                        <th style="padding:12px 16px;font-size:12px;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;border-bottom:2px solid #f1f5f9;white-space:nowrap;">Critère</th>
                        {% for o in comparableOffers %}
                            {% set pName = o.provider.primaryContact
                                ? (o.provider.primaryContact.firstName ~ ' ' ~ o.provider.primaryContact.lastName)
                                : (o.provider.companyName|default(o.provider.email)) %}
                            <th style="padding:12px 16px;border-bottom:2px solid #f1f5f9;text-align:center;min-width:150px;">
                                <div class="d-flex flex-column align-items-center gap-1">
                                    {% if o.provider.logo %}
                                        <img src="{{ asset('uploads/logos/' ~ o.provider.logo) }}" alt="{{ pName }}"
                                             style="width:38px;height:38px;border-radius:50%;object-fit:cover;border:2px solid #e2e8f0;">
                                    {% else %}
                                        <div class="drl-stat-icon drl-stat-icon--1 m-0" style="width:38px;height:38px;font-size:14px;border-radius:50%;">{{ pName|slice(0,1)|upper }}</div>
                                    {% endif %}
                                    <span class="fw-bold text-dark" style="font-size:12px;text-align:center;">{{ pName|slice(0,20) }}{% if pName|length > 20 %}…{% endif %}</span>
                                    {# Status badge #}
                                    {% if o.status|upper == 'ACCEPTED' %}
                                        <span class="drl-tag drl-tag--success" style="font-size:10px;"><i class="ph-check-circle me-1"></i>Acceptée</span>
                                    {% elseif o.status|upper == 'INTERESTED' %}
                                        <span class="drl-tag drl-tag--warning" style="font-size:10px;"><i class="ph-bookmark me-1"></i>Intéressé</span>
                                    {% elseif o.status|upper == 'REJECTED' %}
                                        <span class="drl-tag drl-tag--danger" style="font-size:10px;"><i class="ph-x-circle me-1"></i>Refusée</span>
                                    {% else %}
                                        <span class="drl-tag drl-tag--sent" style="font-size:10px;"><i class="ph-paper-plane-tilt me-1"></i>Envoyée</span>
                                    {% endif %}
                                </div>
                            </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {# Find best price #}
                    {% set minPrice = null %}
                    {% for o in comparableOffers %}
                        {% if minPrice is null or o.price < minPrice %}{% set minPrice = o.price %}{% endif %}
                    {% endfor %}
                    {# Find best rating #}
                    {% set maxRating = 0 %}
                    {% for o in comparableOffers %}
                        {% set r = o.provider.stats ? o.provider.stats.averageRating : 0 %}
                        {% if r > maxRating %}{% set maxRating = r %}{% endif %}
                    {% endfor %}

                    {# Row: Prix #}
                    <tr style="border-bottom:1px solid #f1f5f9;">
                        <td style="padding:12px 16px;font-size:13px;font-weight:600;color:#475569;white-space:nowrap;">
                            <i class="ph-currency-dollar-simple me-2 text-muted"></i>Prix proposé
                        </td>
                        {% for o in comparableOffers %}
                            {% set isBest = o.price == minPrice %}
                            <td style="padding:12px 16px;text-align:center;background:{{ isBest ? 'rgba(16,185,129,.04)' : '' }};">
                                <span class="fw-bold" style="font-size:1.25rem;color:{{ isBest ? '#059669' : '#0d2151' }};">
                                    {{ o.price|number_format(0,',',' ') }}
                                    <span style="font-size:.8rem;color:#94a3b8;">$</span>
                                </span>
                                {% if isBest %}
                                    <div style="font-size:10px;color:#10b981;font-weight:700;margin-top:2px;">
                                        <i class="ph-trend-down me-1"></i>Meilleur prix
                                    </div>
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>

                    {# Row: Note #}
                    <tr style="border-bottom:1px solid #f1f5f9;">
                        <td style="padding:12px 16px;font-size:13px;font-weight:600;color:#475569;white-space:nowrap;">
                            <i class="ph-star me-2 text-muted"></i>Note prestataire
                        </td>
                        {% for o in comparableOffers %}
                            {% set r = o.provider.stats ? o.provider.stats.averageRating : 0 %}
                            {% set rc = o.provider.stats ? o.provider.stats.reviewCount : 0 %}
                            {% set isBest = r > 0 and r == maxRating %}
                            <td style="padding:12px 16px;text-align:center;background:{{ isBest ? 'rgba(245,158,11,.04)' : '' }};">
                                {% if r > 0 %}
                                    <div class="d-flex align-items-center justify-content-center gap-1">
                                        <i class="ph-star" style="color:#fbbf24;font-size:13px;fill:#fbbf24;"></i>
                                        <span class="fw-bold" style="color:{{ isBest ? '#b45309' : '#475569' }};">{{ r|number_format(1) }}</span>
                                        {% if rc > 0 %}<span class="text-muted" style="font-size:11px;">({{ rc }})</span>{% endif %}
                                    </div>
                                    {% if isBest %}
                                        <div style="font-size:10px;color:#f59e0b;font-weight:700;margin-top:2px;">
                                            <i class="ph-medal me-1"></i>Meilleure note
                                        </div>
                                    {% endif %}
                                {% else %}
                                    <span class="text-muted" style="font-size:12px;">—</span>
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>

                    {# Row: Délai #}
                    <tr style="border-bottom:1px solid #f1f5f9;">
                        <td style="padding:12px 16px;font-size:13px;font-weight:600;color:#475569;white-space:nowrap;">
                            <i class="ph-clock me-2 text-muted"></i>Durée estimée
                        </td>
                        {% for o in comparableOffers %}
                            <td style="padding:12px 16px;text-align:center;">
                                {% if o.estimatedDuration %}
                                    <span class="fw-semibold" style="color:#475569;">{{ o.estimatedDuration }} {{ o.estimatedDurationUnit|default('j') }}</span>
                                {% else %}
                                    <span class="text-muted" style="font-size:12px;">—</span>
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>

                    {# Row: Début possible #}
                    <tr style="border-bottom:1px solid #f1f5f9;">
                        <td style="padding:12px 16px;font-size:13px;font-weight:600;color:#475569;white-space:nowrap;">
                            <i class="ph-calendar me-2 text-muted"></i>Début possible
                        </td>
                        {% for o in comparableOffers %}
                            <td style="padding:12px 16px;text-align:center;">
                                {% if o.possibleStartDate %}
                                    <span class="fw-semibold" style="color:#475569;">{{ o.possibleStartDate|date('d/m/Y') }}</span>
                                {% else %}
                                    <span class="text-muted" style="font-size:12px;">—</span>
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>

                    {# Row: Visite préalable #}
                    <tr style="border-bottom:1px solid #f1f5f9;">
                        <td style="padding:12px 16px;font-size:13px;font-weight:600;color:#475569;white-space:nowrap;">
                            <i class="ph-map-pin me-2 text-muted"></i>Visite préalable
                        </td>
                        {% for o in comparableOffers %}
                            <td style="padding:12px 16px;text-align:center;">
                                {% if o.priorVisit is not null %}
                                    {% if o.priorVisit %}
                                        <span class="drl-tag drl-tag--sent" style="font-size:11px;"><i class="ph-check me-1"></i>Oui</span>
                                    {% else %}
                                        <span class="drl-tag drl-tag--draft" style="font-size:11px;">Non</span>
                                    {% endif %}
                                {% else %}
                                    <span class="text-muted" style="font-size:12px;">—</span>
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>

                    {# Row: Documents #}
                    <tr style="border-bottom:1px solid #f1f5f9;">
                        <td style="padding:12px 16px;font-size:13px;font-weight:600;color:#475569;white-space:nowrap;">
                            <i class="ph-paperclip me-2 text-muted"></i>Documents joints
                        </td>
                        {% for o in comparableOffers %}
                            <td style="padding:12px 16px;text-align:center;">
                                {% if o.documents|length > 0 %}
                                    <span class="drl-tag drl-tag--sent" style="font-size:11px;">{{ o.documents|length }} fichier{{ o.documents|length > 1 ? 's' : '' }}</span>
                                {% else %}
                                    <span class="text-muted" style="font-size:12px;">—</span>
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>

                    {# Row: Action #}
                    {% if quote.status|upper not in ['CLOSED', 'ACCEPTED', 'IN_PROGRESS'] %}
                    <tr>
                        <td style="padding:12px 16px;font-size:13px;font-weight:600;color:#475569;">Action</td>
                        {% for o in comparableOffers %}
                            <td style="padding:12px 16px;text-align:center;">
                                {% if o.status|upper in ['PUBLISHED','INTERESTED'] %}
                                    <a href="{{ path('individual_offer_show', {'id': o.id}) }}"
                                       class="drl-btn-orange" style="font-size:12px;padding:8px 14px;text-decoration:none;">
                                        <i class="ph-eye me-1"></i>Voir & Décider
                                    </a>
                                {% else %}
                                    <a href="{{ path('individual_offer_show', {'id': o.id}) }}"
                                       class="drl-act-btn drl-act-btn--view" style="font-size:12px;">
                                        <i class="ph-eye me-1"></i>Voir
                                    </a>
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    {# ── Offers Section ── #}
    {% set newOfferCount = 0 %}
    {% for o in quote.offers %}{% if not o.isViewed and o.status|upper == 'PUBLISHED' %}{% set newOfferCount = newOfferCount + 1 %}{% endif %}{% endfor %}

    <div class="drl-card" id="offres">
        <div class="drl-card-head">
            <div>
                <h4 class="drl-card-title d-flex align-items-center gap-2">
                    <i class="ph-tray text-primary"></i> {{ 'individual.received_offers'|trans }}
                    {% if newOfferCount > 0 %}
                        <span class="badge rounded-pill fw-bold px-2 py-1" style="background: var(--drl-orange); color:#fff; font-size:11px;">
                            {{ newOfferCount }} {{ 'individual.offer_new_badge'|trans }}
                        </span>
                    {% endif %}
                </h4>
                <p class="drl-card-sub">{{ 'individual.review_quotes_sub'|trans }}</p>
            </div>
            <span class="drl-tag drl-tag--sent">{{ quote.offers|length }} {{ 'individual.total'|trans }}</span>
        </div>

        <div class="p-3 p-md-4">
            {% for offer in quote.offers %}
                {% set providerName = offer.provider.primaryContact
                    ? (offer.provider.primaryContact.firstName ~ ' ' ~ offer.provider.primaryContact.lastName)
                    : (offer.provider.companyName|default(offer.provider.email)) %}
                {% set isNew = not offer.isViewed and offer.status|upper in ['PUBLISHED', 'INTERESTED'] %}
                {% set offerStatusMap = {
                    'DRAFT':      {'class': 'drl-tag--draft',   'icon': 'ph-file',         'border': '#94a3b8'},
                    'PUBLISHED':  {'class': 'drl-tag--sent',    'icon': 'ph-paper-plane-tilt',          'border': 'var(--drl-orange)'},
                    'INTERESTED': {'class': 'drl-tag--warning', 'icon': 'ph-bookmark',      'border': '#f59e0b'},
                    'ACCEPTED':   {'class': 'drl-tag--success', 'icon': 'ph-check-circle',  'border': '#10b981'},
                    'REJECTED':   {'class': 'drl-tag--danger',  'icon': 'ph-x-circle',      'border': '#ef4444'},
                    'CLOSED':     {'class': 'drl-tag--draft',   'icon': 'ph-check-square',  'border': '#64748b'}
                } %}
                {% set offerInfo = offerStatusMap[offer.status|upper]|default({'class': 'drl-tag--draft', 'icon': 'ph-question', 'border': '#e2e8f0'}) %}

                <div class="rounded-4 border mb-3 overflow-hidden {{ isNew ? 'shadow-sm' : '' }}"
                     style="border-left: 4px solid {{ offerInfo.border }} !important; background: {{ isNew ? '#fffbf7' : '#fafbfc' }};">

                    {# ── Top row: Provider + Price + Status ── #}
                    <div class="d-flex align-items-center justify-content-between gap-3 p-4 pb-3 flex-wrap">

                        {# Provider identity #}
                        <div class="d-flex align-items-center gap-3 flex-grow-1">
                            {% if isNew %}
                                <span class="position-relative">
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill"
                                          style="background: var(--drl-orange); font-size: 9px; padding: 3px 6px; z-index:1;">
                                        {{ 'individual.offer_new_badge'|trans }}
                                    </span>
                                {% endif %}
                                {% if offer.provider.logo %}
                                    <img src="{{ asset('uploads/logos/' ~ offer.provider.logo) }}" alt="{{ providerName }}"
                                         style="width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 2px solid #e2e8f0; flex-shrink:0;">
                                {% else %}
                                    <div class="drl-stat-icon drl-stat-icon--1 m-0 flex-shrink-0" style="width: 48px; height: 48px; font-size: 18px; border-radius: 50%;">
                                        {{ providerName|slice(0,1)|upper }}
                                    </div>
                                {% endif %}
                                {% if isNew %}</span>{% endif %}
                            <div>
                                <a href="{{ path('individual_offer_show', {'id': offer.id}) }}"
                                   class="fw-bold text-dark text-decoration-none d-block" style="font-size: 15px;">
                                    {{ providerName }}
                                </a>
                                <div class="d-flex align-items-center gap-1 mt-1 flex-wrap">
                                    <span class="drl-tag drl-tag--draft p-0 px-2" style="font-size: 10px;">
                                        <i class="ph-briefcase me-1"></i>{{ offer.provider.getType() }}
                                    </span>
                                    {% if offer.provider.entrepreneurType %}
                                        <span class="drl-tag drl-tag--sent p-0 px-2" style="font-size: 10px;">
                                            {{ offer.provider.entrepreneurType.name }}
                                        </span>
                                    {% endif %}
                                    {% if offer.provider.stats and offer.provider.stats.averageRating > 0 %}
                                        <span class="qs-offer-rating">
                                            <i class="ph-star qs-star" style="fill:#fbbf24;"></i>
                                            <span class="fw-semibold" style="color:#92400e;">{{ offer.provider.stats.averageRating|number_format(1) }}</span>
                                            {% if offer.provider.stats.reviewCount > 0 %}
                                                <span class="text-muted">({{ offer.provider.stats.reviewCount }})</span>
                                            {% endif %}
                                        </span>
                                    {% endif %}
                                    {% if offer.viewedAt %}
                                        <span class="text-muted" style="font-size: 10px;">
                                            <i class="ph-eye me-1"></i>{{ 'individual.offer_seen_on'|trans }} {{ offer.viewedAt|date('d/m/Y') }}
                                        </span>
                                    {% else %}
                                        <span style="font-size: 10px; color: var(--drl-orange); font-weight: 700;">
                                            <i class="ph-eye-slash me-1"></i>{{ 'individual.offer_not_seen'|trans }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        {# Price + status #}
                        <div class="d-flex align-items-center gap-3 flex-shrink-0">
                            <div class="text-end">
                                <div class="fw-bold" style="font-size: 1.6rem; color: var(--drl-navy); line-height: 1;">
                                    {{ offer.price|number_format(2) }}<span class="text-muted ms-1" style="font-size: 0.9rem;">$</span>
                                </div>
                                <div class="text-muted small" style="font-size: 10px;">{{ 'individual.submitted'|trans }} {{ offer.createdAt|date('d/m/Y') }}</div>
                            </div>
                            <span class="drl-tag {{ offerInfo.class }} flex-shrink-0">
                                <i class="{{ offerInfo.icon }} me-1"></i>{{ ('status.' ~ offer.status)|trans({}, 'messages') }}
                            </span>
                        </div>
                    </div>

                    {# ── Details row ── #}
                    {% if offer.description or offer.estimatedDuration or offer.possibleStartDate or offer.priorVisit is not null %}
                    <div class="px-4 pb-3 border-top pt-3" style="border-color: #f1f5f9 !important;">
                        <div class="row g-3">
                            {% if offer.description %}
                                <div class="col-md-7">
                                    <div class="text-muted small mb-1" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.4px;">{{ 'individual.offer_message'|trans }}</div>
                                    <p class="mb-0 text-dark small" style="line-height: 1.6;">
                                        {{ offer.description|slice(0, 160) }}{% if offer.description|length > 160 %}&nbsp;<a href="{{ path('individual_offer_show', {'id': offer.id}) }}" class="text-primary" style="font-size:12px;">{{ 'individual.read_more'|trans }}</a>{% endif %}
                                    </p>
                                </div>
                            {% endif %}
                            <div class="col-md-5">
                                <div class="d-flex flex-column gap-2">
                                    {% if offer.estimatedDuration %}
                                        <div class="d-flex align-items-center gap-2 small text-muted">
                                            <i class="ph-clock" style="font-size: 13px; color: var(--drl-orange);"></i>
                                            <span>{{ 'individual.estimated_duration'|trans }} : <strong class="text-dark">{{ offer.estimatedDuration }} {{ offer.estimatedDurationUnit|default('j') }}</strong></span>
                                        </div>
                                    {% endif %}
                                    {% if offer.possibleStartDate %}
                                        <div class="d-flex align-items-center gap-2 small text-muted">
                                            <i class="ph-calendar" style="font-size: 13px; color: var(--drl-orange);"></i>
                                            <span>{{ 'individual.possible_start'|trans }} : <strong class="text-dark">{{ offer.possibleStartDate|date('d/m/Y') }}</strong></span>
                                        </div>
                                    {% endif %}
                                    {% if offer.priorVisit is not null %}
                                        <div class="d-flex align-items-center gap-2 small text-muted">
                                            <i class="ph-map-pin" style="font-size: 13px; color: var(--drl-orange);"></i>
                                            <span>{{ 'individual.prior_visit'|trans }} : <strong class="text-dark">{{ offer.priorVisit ? 'individual.yes'|trans : 'individual.no'|trans }}</strong></span>
                                        </div>
                                    {% endif %}
                                    {% if offer.documents|length > 0 %}
                                        <div class="d-flex align-items-center gap-2 small text-muted">
                                            <i class="ph-paperclip" style="font-size: 13px; color: var(--drl-orange);"></i>
                                            <span>{{ offer.documents|length }} {{ 'individual.attached_docs'|trans }}</span>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}

                    {# ── Actions row ── #}
                    <div class="px-4 py-3 d-flex align-items-center justify-content-between flex-wrap gap-2"
                         style="background: rgba(0,0,0,0.02); border-top: 1px solid #f1f5f9;">
                        <a href="{{ path('individual_offer_show', {'id': offer.id}) }}"
                           class="drl-act-btn drl-act-btn--view shadow-sm" style="font-size: 13px;">
                            <i class="ph-eye me-1"></i> {{ 'individual.view_full_offer'|trans }}
                        </a>

                        {% if quote.status|upper not in ['CLOSED'] and offer.status|upper in ['PUBLISHED', 'INTERESTED'] %}
                            <div class="d-flex gap-2 flex-wrap">
                                {% if offer.status|upper == 'PUBLISHED' %}
                                    {# Interested #}
                                    <form action="{{ path('individual_offer_interested', {'id': offer.id}) }}" method="POST" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('offer-action-' ~ offer.id) }}">
                                        <button type="submit" class="drl-act-btn shadow-sm" style="background: rgba(245,158,11,0.12); color: #b45309; border: none; font-size:13px;">
                                            <i class="ph-bookmark me-1"></i> {{ 'individual.interested'|trans }}
                                        </button>
                                    </form>
                                {% endif %}
                                {# Accept #}
                                <button type="button" class="drl-act-btn shadow-sm" style="background: rgba(16,185,129,0.12); color: #059669; border: none; font-size:13px;"
                                        data-bs-toggle="modal" data-bs-target="#acceptOfferModal{{ offer.id }}">
                                    <i class="ph-check-circle me-1"></i> {{ 'individual.accept'|trans }}
                                </button>
                                {# Reject #}
                                <button type="button" class="drl-act-btn shadow-sm" style="background: rgba(220,53,69,0.1); color: #dc3545; border: none; font-size:13px;"
                                        data-bs-toggle="modal" data-bs-target="#rejectOfferModal{{ offer.id }}">
                                    <i class="ph-x-circle me-1"></i> {{ 'individual.reject'|trans }}
                                </button>
                            </div>
                        {% elseif offer.status|upper == 'ACCEPTED' %}
                            <span class="drl-tag drl-tag--success" style="font-size: 13px;">
                                <i class="ph-medal me-1"></i> {{ 'individual.offer_accepted_msg'|trans }}
                            </span>
                        {% elseif offer.status|upper == 'REJECTED' %}
                            <span class="text-muted small fst-italic">
                                <i class="ph-x-circle me-1"></i> {{ 'individual.offer_rejected_msg'|trans }}
                            </span>
                        {% elseif offer.status|upper == 'CLOSED' %}
                            <span class="drl-tag drl-tag--draft" style="font-size: 13px;">
                                <i class="ph-check-square me-1"></i> {{ ('status.CLOSED')|trans({}, 'messages') }}
                            </span>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="py-5 text-center">
                    <div class="mb-3 text-muted">
                        <i class="ph-tray" style="font-size: 4rem; opacity: 0.2;"></i>
                    </div>
                    <h5 class="fw-bold text-dark">{{ 'individual.empty_offers_title'|trans }}</h5>
                    <p class="text-muted small">{{ 'individual.empty_offers_review'|trans }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% block modals %}
    {{ parent() }}
    {% set acceptedOffer = null %}
    {% for offer in quote.offers %}{% if offer.status|upper == 'ACCEPTED' %}{% set acceptedOffer = offer %}{% endif %}{% endfor %}

    {# ── Revert to Published Modal ── #}
    <div class="modal fade" id="revertQuoteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content drl-modal-content">
                <div class="modal-body drl-modal-body p-5 text-center">
                    <div class="mb-4">
                        <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle" style="width: 70px; height: 70px; background: rgba(234,88,12,0.1);">
                            <i class="ph-arrow-counter-clockwise" style="font-size: 2rem; color: #ea580c;"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">{{ 'individual.revert_published'|trans }}</h4>
                    {% if acceptedOffer %}
                        {% set revProv = acceptedOffer.provider %}
                        {% set revProvName = revProv.primaryContact
                            ? (revProv.primaryContact.firstName ~ ' ' ~ revProv.primaryContact.lastName)
                            : (revProv.companyName|default(revProv.email)) %}
                        <div class="p-3 rounded-3 mb-3" style="background: #fff7ed; border: 1px solid #fed7aa;">
                            <div class="small fw-bold" style="color: #c2410c;">
                                <i class="ph-warning me-1"></i>
                                L'offre de <strong>{{ revProvName }}</strong> sera annulée et remise en attente. Vous devrez choisir un nouveau prestataire.
                            </div>
                        </div>
                    {% endif %}
                    <p class="text-muted px-3 mb-4 small">{{ 'individual.revert_published_confirm'|trans }}</p>
                    <div class="d-flex flex-column gap-3 mt-4">
                        <form action="{{ path('individual_quote_revert_published', {'id': quote.id}) }}" method="POST" class="w-100">
                            <input type="hidden" name="_token" value="{{ csrf_token('revert-quote-' ~ quote.id) }}">
                            <button type="submit" class="w-100 py-3 d-flex align-items-center justify-content-center gap-2 rounded-3 border-0 fw-bold"
                                    style="background: #ea580c; color: #fff; font-size: 1rem;">
                                <i class="ph-arrow-counter-clockwise"></i> {{ 'individual.revert_published'|trans }}
                            </button>
                        </form>
                        <button type="button" class="drl-act-btn drl-act-btn--view w-100 py-3 justify-content-center border-0" data-bs-dismiss="modal">
                            {{ 'individual.cancel'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Start Project Modal ── #}
    <div class="modal fade" id="startQuoteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content drl-modal-content">
                <div class="modal-body drl-modal-body p-5 text-center">
                    <div class="mb-4">
                        <div class="drl-stat-icon drl-stat-icon--2 mx-auto" style="width: 70px; height: 70px; font-size: 32px;">
                            <i class="ph-play-circle"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">{{ 'individual.start_project'|trans }}</h4>
                    <p class="text-muted px-3 mb-4">{{ 'individual.start_project_confirm'|trans }}</p>
                    <div class="d-flex flex-column gap-3 mt-4">
                        <form action="{{ path('individual_quote_start', {'id': quote.id}) }}" method="POST" class="w-100">
                            <input type="hidden" name="_token" value="{{ csrf_token('start-quote-' ~ quote.id) }}">
                            <button type="submit" class="drl-btn-orange w-100 py-3 justify-content-center shadow-lg">
                                <i class="ph-play-circle me-2"></i> {{ 'individual.start_project'|trans }}
                            </button>
                        </form>
                        <button type="button" class="drl-act-btn drl-act-btn--view w-100 py-3 justify-content-center border-0" data-bs-dismiss="modal">
                            {{ 'individual.cancel'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Close Request Modal ── #}
    <div class="modal fade" id="closeQuoteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content drl-modal-content">
                <div class="modal-body drl-modal-body p-5 text-center">
                    <div class="mb-4">
                        <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle" style="width: 70px; height: 70px; background: rgba(71,85,105,0.1);">
                            <i class="ph-lock" style="font-size: 2rem; color: #475569;"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">{{ 'individual.close_request'|trans }}</h4>
                    <p class="text-muted px-3 mb-4">{{ 'individual.close_request_confirm'|trans }}</p>
                    <div class="d-flex flex-column gap-3 mt-4">
                        <form action="{{ path('individual_quote_close', {'id': quote.id}) }}" method="POST" class="w-100">
                            <input type="hidden" name="_token" value="{{ csrf_token('close-quote-' ~ quote.id) }}">
                            <button type="submit" class="w-100 py-3 d-flex align-items-center justify-content-center gap-2 rounded-3 border-0 fw-bold"
                                    style="background: #475569; color: #fff; font-size: 1rem;">
                                <i class="ph-lock"></i> {{ 'individual.close_request'|trans }}
                            </button>
                        </form>
                        <button type="button" class="drl-act-btn drl-act-btn--view w-100 py-3 justify-content-center border-0" data-bs-dismiss="modal">
                            {{ 'individual.cancel'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Publish Quote Modal ── #}
    <div class="modal fade" id="publishQuoteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content drl-modal-content">
                <div class="modal-body drl-modal-body p-5 text-center">
                    <div class="mb-4">
                        <div class="drl-stat-icon drl-stat-icon--2 mx-auto" style="width: 70px; height: 70px; font-size: 32px;">
                            <i class="ph-cloud-arrow-up"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">{{ 'individual.publish_confirm'|trans }}</h4>
                    <p class="text-muted px-3 mb-4">
                        {{ 'individual.publish_desc'|trans({'%title%': quote.title}) }} <span class="fw-bold text-dark">{{ quote.category.localizedTitle(app.request.locale)|default('individual.general'|trans) }}</span>.
                    </p>
                    <div class="d-flex flex-column gap-3 mt-4">
                        <form action="{{ path('individual_quote_publish', {'id': quote.id}) }}" method="POST" class="w-100">
                            <input type="hidden" name="_token" value="{{ csrf_token('publish-quote-' ~ quote.id) }}">
                            <button type="submit" class="drl-btn-orange w-100 py-3 justify-content-center shadow-lg">
                                <i class="ph-check me-2"></i> {{ 'individual.btn_yes_publish'|trans }}
                            </button>
                        </form>
                        <button type="button" class="drl-act-btn drl-act-btn--view w-100 py-3 justify-content-center border-0" data-bs-dismiss="modal">
                            {{ 'individual.btn_keep_draft'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Delete Confirmation Modal ── #}
    <div class="modal fade" id="deleteQuoteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content drl-modal-content">
                <div class="modal-body drl-modal-body p-5 text-center">
                    <div class="mb-4">
                        <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle" style="width: 70px; height: 70px; background: rgba(239,68,68,0.1);">
                            <i class="ph-warning" style="font-size: 2rem; color: #ef4444;"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">{{ 'individual.delete_title'|trans }}</h4>
                    <p class="text-muted px-3 mb-4">
                        {{ 'individual.delete_confirm'|trans({'%title%': quote.title}) }}
                    </p>
                    <div class="d-flex flex-column gap-3 mt-4">
                        <form action="{{ path('individual_quote_delete', {'id': quote.id}) }}" method="POST" class="w-100">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-quote-' ~ quote.id) }}">
                            <button type="submit" class="w-100 py-3 d-flex align-items-center justify-content-center gap-2 rounded-3 border-0 fw-bold"
                                    style="background: #ef4444; color: #fff; font-size: 1rem;">
                                <i class="ph-trash"></i> {{ 'individual.btn_yes_delete'|trans }}
                            </button>
                        </form>
                        <button type="button" class="drl-act-btn drl-act-btn--view w-100 py-3 justify-content-center border-0" data-bs-dismiss="modal">
                            {{ 'individual.btn_no_keep'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Delete Image Modals ── #}
    {% for image in quote.images %}
        <div class="modal fade" id="deleteImageModal{{ loop.index0 }}" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content drl-modal-content">
                    <div class="modal-body drl-modal-body p-5 text-center">
                        <div class="mb-4">
                            <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle" style="width: 70px; height: 70px; background: rgba(239,68,68,0.1);">
                                <i class="ph-image" style="font-size: 2rem; color: #ef4444;"></i>
                            </div>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">{{ 'individual.remove_image_title'|trans }}</h4>
                        <p class="text-muted px-3 mb-4">{{ 'individual.remove_image_confirm'|trans }}</p>
                        <div class="d-flex flex-column gap-3 mt-4">
                            <form action="{{ path('individual_quote_remove_image', {'id': quote.id, 'index': loop.index0}) }}" method="POST" class="w-100">
                                <input type="hidden" name="_token" value="{{ csrf_token('remove-image-' ~ quote.id) }}">
                                <button type="submit" class="w-100 py-3 d-flex align-items-center justify-content-center gap-2 rounded-3 border-0 fw-bold"
                                        style="background: #ef4444; color: #fff; font-size: 1rem;">
                                    <i class="ph-trash"></i> {{ 'individual.btn_yes_remove'|trans }}
                                </button>
                            </form>
                            <button type="button" class="drl-act-btn drl-act-btn--view w-100 py-3 justify-content-center border-0" data-bs-dismiss="modal">
                                {{ 'individual.cancel'|trans }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}

    {% for offer in quote.offers %}
        {% set provName = offer.provider.primaryContact ? (offer.provider.primaryContact.firstName ~ ' ' ~ offer.provider.primaryContact.lastName) : (offer.provider.companyName|default(offer.provider.email)) %}

        {# Accept Offer Modal #}
        <div class="modal fade" id="acceptOfferModal{{ offer.id }}" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content drl-modal-content">
                    <div class="modal-body drl-modal-body p-5 text-center">
                        <div class="mb-4">
                            <div class="drl-stat-icon drl-stat-icon--3 mx-auto" style="width: 70px; height: 70px; font-size: 32px;">
                                <i class="ph-check-circle"></i>
                            </div>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">{{ 'individual.accept_offer_title'|trans }}</h4>
                        <p class="text-muted px-3 mb-4">
                            {{ 'individual.accept_offer_desc'|trans({'%name%': provName, '%price%': offer.price|number_format(2)}) }}
                        </p>
                        <div class="d-flex flex-column gap-3 mt-4">
                            <form action="{{ path('individual_offer_accept', {'id': offer.id}) }}" method="POST" class="w-100">
                                <input type="hidden" name="_token" value="{{ csrf_token('offer-action-' ~ offer.id) }}">
                                <button type="submit" class="drl-btn-orange w-100 py-3 justify-content-center shadow-lg">
                                    <i class="ph-check me-2"></i>{{ 'individual.accept'|trans }}
                                </button>
                            </form>
                            <button type="button" class="drl-act-btn drl-act-btn--view w-100 py-3 justify-content-center border-0" data-bs-dismiss="modal">
                                {{ 'individual.cancel'|trans }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Reject Offer Modal #}
        <div class="modal fade" id="rejectOfferModal{{ offer.id }}" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content drl-modal-content">
                    <div class="modal-body drl-modal-body p-5 text-center">
                        <div class="mb-4">
                            <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle" style="width: 70px; height: 70px; background: rgba(239,68,68,0.1);">
                                <i class="ph-x-circle" style="font-size: 2rem; color: #ef4444;"></i>
                            </div>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">{{ 'individual.reject_offer_title'|trans }}</h4>
                        <p class="text-muted px-3 mb-4">{{ 'individual.reject_offer_desc'|trans({'%name%': provName}) }}</p>
                        <div class="d-flex flex-column gap-3 mt-4">
                            <form action="{{ path('individual_offer_reject', {'id': offer.id}) }}" method="POST" class="w-100">
                                <input type="hidden" name="_token" value="{{ csrf_token('offer-action-' ~ offer.id) }}">
                                <button type="submit" class="w-100 py-3 d-flex align-items-center justify-content-center gap-2 rounded-3 border-0 fw-bold"
                                        style="background: #ef4444; color: #fff; font-size: 1rem;">
                                    <i class="ph-x"></i>{{ 'individual.reject'|trans }}
                                </button>
                            </form>
                            <button type="button" class="drl-act-btn drl-act-btn--view w-100 py-3 justify-content-center border-0" data-bs-dismiss="modal">
                                {{ 'individual.cancel'|trans }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}

    <script>
        function previewImages(input) {
            const container = document.getElementById('imagePreviewContainer');
            container.innerHTML = '';
            
            if (input.files) {
                Array.from(input.files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const wrapper = document.createElement('div');
                        wrapper.className = 'position-relative';
                        wrapper.innerHTML = `
                            <img src="${e.target.result}" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px; border: 2px solid var(--drl-orange);">
                            <div class="position-absolute top-0 end-0 text-white rounded-circle d-flex align-items-center justify-content-center"
                                 style="width: 16px; height: 16px; font-size: 10px; margin-top: -5px; margin-right: -5px; background: var(--drl-orange);">
                                <i class="ph-check"></i>
                            </div>
                        `;
                        container.appendChild(wrapper);
                    }
                    reader.readAsDataURL(file);
                });
            }
        }
    </script>

    {# ── Photo Lightbox Modal ── #}
    <div class="modal fade" id="photoLightboxModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" style="background:transparent;border:none;">
                <div class="modal-body p-0 text-center">
                    <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" style="z-index:9;"></button>
                    <img id="photoLightboxImg" src="" alt="Photo"
                         style="max-width:100%;max-height:82vh;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,.6);">
                </div>
            </div>
        </div>
    </div>

    <script>
    function openPhotoLightbox(src) {
        document.getElementById('photoLightboxImg').src = src;
        new bootstrap.Modal(document.getElementById('photoLightboxModal')).show();
    }
    </script>
{% endblock %}
