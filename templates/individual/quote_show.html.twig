{% extends 'individual/base_individual.html.twig' %}

{% block title %}{{ quote.title }} - Drilleedo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .pro-detail-label {
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #64748b;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }
        .pro-detail-value {
            font-size: 1rem;
            color: #1e293b;
            font-weight: 500;
            margin-bottom: 1.5rem;
        }
        .offer-message-snippet {
            max-width: 220px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: inline-block;
        }
        /* Image gallery with delete overlay */
        .quote-img-wrapper {
            position: relative;
            display: inline-block;
        }
        .quote-img-wrapper .img-delete-btn {
            position: absolute;
            top: -6px;
            right: -6px;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: #ef4444;
            color: #fff;
            border: 2px solid #fff;
            font-size: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0;
            transition: opacity 0.2s ease;
            padding: 0;
            line-height: 1;
        }
        .quote-img-wrapper:hover .img-delete-btn {
            opacity: 1;
        }
        /* Offer action buttons */
        .offer-action-btn {
            padding: 0.4rem 0.8rem;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            transition: all 0.2s ease;
        }
        .offer-action-btn.accept { background: #22c55e; color: #fff; }
        .offer-action-btn.accept:hover { background: #16a34a; }
        .offer-action-btn.reject { background: #ef4444; color: #fff; }
        .offer-action-btn.reject:hover { background: #dc2626; }
        .offer-action-btn.pending-revert { background: #f59e0b; color: #fff; }
        .offer-action-btn.pending-revert:hover { background: #d97706; }
        /* Closed banner */
        .closed-banner {
            background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            padding: 1rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
        }
        .closed-banner i { font-size: 1.5rem; color: #64748b; }
        .closed-banner .closed-text { font-size: 0.95rem; color: #475569; font-weight: 500; }
        /* Contact reveal card */
        .contact-reveal {
            background: linear-gradient(135deg, #ecfdf5, #d1fae5);
            border: 1px solid #6ee7b7;
            border-radius: 10px;
            padding: 1rem 1.25rem;
        }
    </style>
{% endblock %}

{% block body %}
    {# ── Closed Banner ── #}
    {% if quote.status == 'Closed' %}
        <div class="closed-banner">
            <i class="feather-lock"></i>
            <div>
                <span class="closed-text mb-1" style="font-size: 1.1rem; display: block;">This request is closed.</span>
                <span class="text-muted small d-block" style="font-size: 1rem;">The professional has finalized this job. No further offers can be submitted.</span>
            </div>
        </div>
    {% endif %}

    {# ── Header Actions ── #}
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <a href="{{ path('individual_quotes') }}" class="btn btn-link text-decoration-none text-muted p-0 d-flex align-items-center gap-2">
            <i class="feather-arrow-left"></i> Back to My Quotes
        </a>

        {% if quote.status not in ['Closed'] %}
            <div class="d-flex align-items-center gap-2 flex-wrap">
                {# Toggle Active/Inactive #}
                {% if quote.status not in ['Accepted'] %}
                    <form action="{{ path('individual_quote_toggle', {'id': quote.id}) }}" method="POST" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle-quote-' ~ quote.id) }}">
                        {% if quote.status == 'Inactive' %}
                            <button type="submit" class="indiv-btn-primary pro-btn-sm d-flex align-items-center gap-2">
                                <i class="feather-eye"></i> Activate
                            </button>
                        {% else %}
                            <button type="submit" class="indiv-btn-secondary pro-btn-sm d-flex align-items-center gap-2">
                                <i class="feather-eye-off"></i> Deactivate
                            </button>
                        {% endif %}
                    </form>
                {% endif %}

                {# Edit Button #}
                <button type="button" class="indiv-btn-secondary pro-btn-sm d-flex align-items-center gap-2"
                        data-bs-toggle="modal" data-bs-target="#editQuoteModal">
                    <i class="feather-edit-2"></i> Edit Request
                </button>

                {# Delete Button #}
                <button type="button" class="indiv-btn-secondary pro-btn-sm d-flex align-items-center gap-2" style="border-color: var(--indiv-danger); color: var(--indiv-danger);"
                        data-bs-toggle="modal" data-bs-target="#deleteQuoteModal">
                    <i class="feather-trash-2"></i> Delete
                </button>
            </div>
        {% endif %}
    </div>

    {# ── Quote Details Card ── #}
    <div class="row g-4 mb-4">
        <div class="col-lg-12">
            <div class="pro-card pro-card-elevated h-100">
                <div class="pro-card-header border-bottom d-flex justify-content-between align-items-start">
                    <div>
                        <h4 class="pro-card-title mb-1">{{ quote.title }}</h4>
                        <p class="mb-0 text-muted small"><i class="feather-calendar me-1"></i> Posted on {{ quote.creationDate|date('F j, Y') }}</p>
                    </div>
                    <div>
                        {% set statusMap = {
                            'Pending': {'class': 'warning', 'icon': 'feather-clock'},
                            'Active': {'class': 'success', 'icon': 'feather-zap'},
                            'Inactive': {'class': 'secondary', 'icon': 'feather-pause-circle'},
                            'Accepted': {'class': 'success', 'icon': 'feather-check-circle'},
                            'Closed': {'class': 'danger', 'icon': 'feather-lock'}
                        } %}
                        {% set statusInfo = statusMap[quote.status]|default({'class': 'secondary', 'icon': 'feather-help-circle'}) %}
                        <span class="pro-badge {{ statusInfo.class }} px-4 py-2" style="font-size: 1.15rem;">
                            <i class="{{ statusInfo.icon }} me-2"></i>{{ quote.status }}
                        </span>
                    </div>
                </div>

                <div class="pro-card-body pt-4">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="pro-detail-label">Description</div>
                            <div class="pro-detail-value text-wrap text-break" style="white-space: pre-line;">
                                {{ quote.description }}
                            </div>
                        </div>
                        <div class="col-md-4 border-start">
                            <div class="ps-md-3">
                                <div class="pro-detail-label">Category</div>
                                <div class="pro-detail-value">
                                    <span class="pro-badge secondary">
                                        <i class="feather-tag me-1"></i>{{ quote.category.name|default('General') }}
                                    </span>
                                </div>

                                <div class="pro-detail-label mt-4">Attached Photos</div>
                                <div class="pro-detail-value">
                                    {% if quote.images|length > 0 %}
                                        <div class="d-flex flex-wrap gap-2 mt-2">
                                            {% for image in quote.images %}
                                                    <div class="position-relative">
                                                        <a href="{{ asset('uploads/quote_requests/' ~ image) }}" target="_blank">
                                                            <img src="{{ asset('uploads/quote_requests/' ~ image) }}" alt="Reference Image"
                                                                 style="width: 64px; height: 64px; object-fit: cover; border-radius: 6px; border: 1px solid #dee2e6;">
                                                        </a>
                                                        {% if quote.status not in ['Closed'] %}
                                                            <button type="button" class="img-delete-btn" title="Remove image" data-bs-toggle="modal" data-bs-target="#deleteImageModal{{ loop.index0 }}">×</button>
                                                            
                                                            <div class="modal fade" id="deleteImageModal{{ loop.index0 }}" tabindex="-1" aria-hidden="true">
                                                                <div class="modal-dialog modal-dialog-centered" style="z-index: 1060;">
                                                                    <div class="modal-content border-0 shadow-lg text-start" style="border-radius: 16px;">
                                                                        <div class="modal-body p-4 text-center">
                                                                            <div class="mb-4">
                                                                                <div class="pro-stat-icon danger mx-auto" style="width: 70px; height: 70px; font-size: 32px; background: rgba(239, 68, 68, 0.1); color: var(--indiv-danger);">
                                                                                    <i class="feather-alert-triangle"></i>
                                                                                </div>
                                                                            </div>
                                                                            <h4 class="fw-bold text-dark mb-2">Remove Image?</h4>
                                                                            <p class="text-muted px-4 mb-4">Are you sure you want to delete this attached photo from your request?</p>
                                                                            <div class="d-flex flex-column gap-3 mt-4">
                                                                                <form action="{{ path('individual_quote_remove_image', {'id': quote.id, 'index': loop.index0}) }}" method="POST" class="w-100">
                                                                                    <input type="hidden" name="_token" value="{{ csrf_token('remove-image-' ~ quote.id) }}">
                                                                                    <button type="submit" class="indiv-btn-primary w-100 py-3 justify-content-center" style="background: var(--indiv-danger); font-size: 1.15rem;">
                                                                                        <i class="feather-trash-2"></i> Yes, Remove Image
                                                                                    </button>
                                                                                </form>
                                                                                <button type="button" class="indiv-btn-secondary w-100 py-3 bg-light text-dark justify-content-center" style="border-color: #cbd5e1; font-size: 1.15rem;" data-bs-dismiss="modal">
                                                                                    Cancel
                                                                                </button>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                            {% endfor %}
                                        </div>
                                    {% else %}
                                        <span class="text-muted small fst-italic">No photos attached</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Contact Reveal (when an offer is accepted) ── #}
    {% set acceptedOffer = null %}
    {% for offer in quote.offers %}
        {% if offer.status|upper == 'ACCEPTED' %}
            {% set acceptedOffer = offer %}
        {% endif %}
    {% endfor %}

    {% if acceptedOffer %}
        <div class="pro-card pro-card-elevated mb-5" style="border-left: 5px solid var(--pro-success);">
            <div class="pro-card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-4">
                    <div class="d-flex align-items-center gap-4">
                        <div class="pro-stat-icon success" style="width: 64px; height: 64px; font-size: 28px;">
                            <i class="feather-award"></i>
                        </div>
                        <div>
                            <h4 class="mb-1 fw-bold text-dark">Provider Selected & Hired</h4>
                            <p class="mb-0 text-muted">You have accepted an offer. You can now contact the professional below.</p>
                        </div>
                    </div>
                </div>

                <div class="row mt-5 g-4">
                    {% set provider = acceptedOffer.provider %}
                    {% set provName = provider.primaryContact ? (provider.primaryContact.firstName ~ ' ' ~ provider.primaryContact.lastName) : (provider.companyName|default(provider.email)) %}
                    <div class="col-md-4">
                        <div class="p-4 rounded-3 bg-light border-0 shadow-sm h-100">
                            <label class="pro-form-label mb-2"><i class="feather-user me-2 text-primary"></i>Hired Professional</label>
                            <div class="h6 fw-bold text-dark mb-1">{{ provName }}</div>
                            <span class="badge pro-badge info">{{ provider.getType() }}</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-4 rounded-3 bg-light border-0 shadow-sm h-100">
                            <label class="pro-form-label mb-2"><i class="feather-mail me-2 text-primary"></i>Email Address</label>
                            <div class="h6 fw-bold mb-0">
                                <a href="mailto:{{ provider.email }}" class="text-dark text-decoration-none hover-primary">{{ provider.email }}</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-4 rounded-3 bg-light border-0 shadow-sm h-100">
                            <label class="pro-form-label mb-2"><i class="feather-phone me-2 text-primary"></i>Phone Number</label>
                            <div class="h5 fw-bold text-dark mb-0">{{ provider.phoneNum|default('Not provided') }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ── Offers Section ── #}
    <div class="pro-card pro-card-elevated">
        <div class="pro-card-header">
            <div>
                <h4 class="pro-card-title d-flex align-items-center gap-3">
                    <i class="feather-inbox text-primary"></i> Received Offers
                </h4>
                <p class="pro-card-subtitle">Review quotes from local professionals</p>
            </div>
            <span class="pro-badge info">{{ quote.offers|length }} Total</span>
        </div>

        <div class="pro-table-wrapper border-0">
            <table class="pro-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 30%">Professional / Company</th>
                        <th>Amount</th>
                        <th style="width: 25%">Message</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for offer in quote.offers %}
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="pro-stat-icon primary m-0" style="width: 48px; height: 48px; min-width: 48px; font-size: 1.25rem;">
                                        {% set providerName = offer.provider.primaryContact ? (offer.provider.primaryContact.firstName ~ ' ' ~ offer.provider.primaryContact.lastName) : (offer.provider.companyName|default(offer.provider.email)) %}
                                        {{ providerName|slice(0, 1)|upper }}
                                    </div>
                                    <div>
                                        <a href="{{ path('individual_offer_show', {'id': offer.id}) }}" class="fw-bold d-block text-dark text-decoration-none" style="font-size: 1.05rem;">
                                            {{ providerName }}
                                        </a>
                                        <div class="d-flex align-items-center gap-2 mt-1">
                                            <span class="pro-badge secondary p-0 px-2" style="font-size: 1rem;">
                                                <i class="feather-briefcase me-1"></i>{{ offer.provider.getType() }}
                                            </span>
                                            {% if offer.provider.entrepreneurType %}
                                                <span class="pro-badge info p-0 px-2" style="font-size: 1rem;">
                                                    {{ offer.provider.entrepreneurType.name }}
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark" style="font-size: 1.2rem;">
                                    {{ offer.price|number_format(2) }} <span class="text-muted small">$</span>
                                </div>
                                <div class="text-muted small" style="font-size: 1rem;">Submitted {{ offer.createdAt|date('M d, Y') }}</div>
                            </td>
                             <td>
                                 <div class="text-muted" style="font-size: 1rem; line-height: 1.5; max-width: 250px;">
                                     {{ offer.description|default('No notes provided.')|slice(0, 100) }}{% if offer.description|default('')|length > 100 %}...{% endif %}
                                 </div>
                             </td>
                            <td>
                                {% set offerStatusMap = {
                                    'PENDING': {'class': 'warning', 'label': 'Pending', 'icon': 'feather-clock'},
                                    'ACCEPTED': {'class': 'success', 'label': 'Accepted', 'icon': 'feather-check-circle'},
                                    'REJECTED': {'class': 'danger', 'label': 'Rejected', 'icon': 'feather-x-circle'}
                                } %}
                                {% set offerInfo = offerStatusMap[offer.status|upper]|default({'class': 'secondary', 'label': offer.status, 'icon': 'feather-help-circle'}) %}
                                <span class="pro-badge {{ offerInfo.class }}">
                                    <i class="{{ offerInfo.icon }} me-1"></i>{{ offerInfo.label }}
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="{{ path('individual_offer_show', {'id': offer.id}) }}" class="indiv-action-badge view">
                                        <i class="feather-eye"></i> View
                                    </a>
                                    
                                    {% if quote.status not in ['Closed'] %}
                                        {% if offer.status|upper == 'PENDING' %}
                                            <form action="{{ path('individual_offer_accept', {'id': offer.id}) }}" method="POST" class="d-inline"
                                                  onsubmit="return confirm('Accept this offer? This will notify the provider and reject other pending offers.');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('offer-action-' ~ offer.id) }}">
                                                <button type="submit" class="indiv-action-badge view" style="color: var(--indiv-success); background: var(--indiv-success-bg);">
                                                    <i class="feather-check"></i> Accept
                                                </button>
                                            </form>
                                            <form action="{{ path('individual_offer_reject', {'id': offer.id}) }}" method="POST" class="d-inline"
                                                  onsubmit="return confirm('Reject this offer?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('offer-action-' ~ offer.id) }}">
                                                <button type="submit" class="indiv-action-badge delete">
                                                    <i class="feather-x"></i> Reject
                                                </button>
                                            </form>
                                        {% elseif offer.status|upper == 'REJECTED' and quote.status not in ['Accepted'] %}
                                            <form action="{{ path('individual_offer_pending', {'id': offer.id}) }}" method="POST" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('offer-action-' ~ offer.id) }}">
                                                <button type="submit" class="indiv-action-badge edit">
                                                    <i class="feather-rotate-ccw"></i> Revert
                                                </button>
                                            </form>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="py-5 text-center">
                                <div class="mb-3 text-muted">
                                    <i class="feather-inbox" style="font-size: 4rem; opacity: 0.2;"></i>
                                </div>
                                <h5 class="fw-bold text-dark">No offers received yet</h5>
                                <p class="text-muted small">Professionals will review your request and submit their quotes here.</p>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block modals %}
    {{ parent() }}

    {# ── Edit Quote Modal (Modernized) ── #}
    <div class="modal fade" id="editQuoteModal" tabindex="-1" aria-labelledby="editQuoteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <div>
                        <h4 class="modal-title fw-bold text-dark" id="editQuoteModalLabel">Edit Quote Request</h4>
                        <p class="text-muted small mb-0">Update your project details and requirements</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    {{ form_start(form, {'attr': {'class': 'needs-validation', 'id': 'editQuoteForm'}}) }}
                        
                        <div class="row g-4">
                            <div class="col-md-12">
                                <div class="pro-form-group">
                                    <label class="pro-form-label fw-bold text-dark mb-2" for="{{ form.title.vars.id }}">
                                        <i class="feather-type me-2 text-primary"></i>Request Title
                                    </label>
                                    {{ form_widget(form.title, {'attr': {'class': 'pro-form-input', 'placeholder': 'e.g. Need urgent plumbing repair'}}) }}
                                    <div class="form-text text-muted small mt-1">Keep it short and descriptive.</div>
                                    <div class="text-danger small mt-1">{{ form_errors(form.title) }}</div>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="pro-form-group">
                                    <label class="pro-form-label fw-bold text-dark mb-2" for="{{ form.category.vars.id }}">
                                        <i class="feather-grid me-2 text-primary"></i>Service Category
                                    </label>
                                    {{ form_widget(form.category, {'attr': {'class': 'pro-form-input'}}) }}
                                    <div class="text-danger small mt-1">{{ form_errors(form.category) }}</div>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="pro-form-group">
                                    <label class="pro-form-label fw-bold text-dark mb-2" for="{{ form.description.vars.id }}">
                                        <i class="feather-align-left me-2 text-primary"></i>Detailed Description
                                    </label>
                                    {{ form_widget(form.description, {'attr': {'class': 'pro-form-input', 'rows': '6', 'placeholder': 'Describe your project in detail...'}}) }}
                                    <div class="form-text text-muted small mt-1">Specify timeline, materials, or special requests.</div>
                                    <div class="text-danger small mt-1">{{ form_errors(form.description) }}</div>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="pro-form-group">
                                    <label class="pro-form-label fw-bold text-dark mb-2" for="{{ form.images.vars.id }}">
                                        <i class="feather-image me-2 text-primary"></i>Photos & Attachments
                                    </label>
                                    
                                    {# Existing Images Preview #}
                                    {% if quote.images|length > 0 %}
                                        <div class="mb-3 p-3 bg-light rounded-3 border">
                                            <p class="small text-muted mb-2 fw-semibold">Current Photos</p>
                                            <div class="d-flex flex-wrap gap-2">
                                                {% for image in quote.images %}
                                                    <div class="position-relative">
                                                        <img src="{{ asset('uploads/quote_requests/' ~ image) }}" alt="Existing Photo" 
                                                             style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0;">
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endif %}

                                    <div class="custom-file-upload mt-2">
                                        {{ form_widget(form.images, {'attr': {
                                            'class': 'form-control pro-form-input', 
                                            'accept': 'image/*', 
                                            'multiple': 'multiple',
                                            'onchange': 'previewImages(this)'
                                        }}) }}
                                        <div id="imagePreviewContainer" class="d-flex flex-wrap gap-2 mt-3"></div>
                                        <div class="form-text text-muted small mt-2">
                                            <i class="feather-info me-1"></i> New photos will be added to your current ones. Max 5MB per file.
                                        </div>
                                    </div>
                                    <div class="text-danger small mt-1">{{ form_errors(form.images) }}</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 pt-4 border-top mt-5">
                            <button type="button" class="indiv-btn-secondary px-4" data-bs-dismiss="modal">Discard Changes</button>
                            <button type="submit" class="indiv-btn-primary px-5 shadow-sm">
                                <i class="feather-save me-2"></i> Update Request
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    {# ── Delete Confirmation Modal (Premium Redesign) ── #}
    <div class="modal fade" id="deleteQuoteModal" tabindex="-1" aria-labelledby="deleteQuoteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-body p-4 text-center">
                    <div class="mb-4">
                        <div class="pro-stat-icon danger mx-auto" style="width: 70px; height: 70px; font-size: 32px; background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                            <i class="feather-alert-triangle"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Delete this request?</h4>
                    <p class="text-muted px-4 mb-4">
                        Are you sure you want to remove <span class="fw-bold text-dark">"{{ quote.title }}"</span>? 
                        This action cannot be undone and will delete all associated offers.
                    </p>
                    
                    <div class="d-flex flex-column gap-3 mt-4">
                        <form action="{{ path('individual_quote_delete', {'id': quote.id}) }}" method="POST" class="w-100">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-quote-' ~ quote.id) }}">
                            <button type="submit" class="indiv-btn-primary w-100 py-3 d-flex align-items-center justify-content-center gap-2" 
                                    style="background: var(--indiv-danger); font-size: 1.15rem;">
                                <i class="feather-trash-2"></i> Yes, Delete Permanently
                            </button>
                        </form>
                        <button type="button" class="indiv-btn-secondary w-100 py-3 bg-light text-dark justify-content-center" style="border-color: #cbd5e1; font-size: 1.15rem;" data-bs-dismiss="modal">
                            No, Keep Request
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function previewImages(input) {
            const container = document.getElementById('imagePreviewContainer');
            container.innerHTML = '';
            
            if (input.files) {
                Array.from(input.files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const wrapper = document.createElement('div');
                        wrapper.className = 'position-relative';
                        wrapper.innerHTML = `
                            <img src="${e.target.result}" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px; border: 2px solid var(--pro-primary);">
                            <div class="position-absolute top-0 end-0 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" 
                                 style="width: 16px; height: 16px; font-size: 10px; margin-top: -5px; margin-right: -5px;">
                                <i class="feather-check"></i>
                            </div>
                        `;
                        container.appendChild(wrapper);
                    }
                    reader.readAsDataURL(file);
                });
            }
        }
    </script>
{% endblock %}
