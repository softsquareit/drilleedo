{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {

    /* ── 1. DRAG-DROP PHOTO UPLOAD ── */
    const dropzone   = document.getElementById('nqDropzone');
    const fileInput  = dropzone ? dropzone.querySelector('input[type="file"]') : null;
    const photoGrid  = document.getElementById('nqPhotoGrid');
    const photoCount = document.getElementById('nqPhotoCount');
    const MAX_FILES  = {{ 5 - quote.images|length }};
    let selectedFiles = [];

    if (dropzone && fileInput) {
        dropzone.addEventListener('click', e => { if (e.target !== fileInput) fileInput.click(); });
        dropzone.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') fileInput.click(); });
        ['dragenter','dragover'].forEach(evt => {
            dropzone.addEventListener(evt, e => { e.preventDefault(); dropzone.classList.add('drag-over'); });
        });
        ['dragleave','drop'].forEach(evt => {
            dropzone.addEventListener(evt, e => { e.preventDefault(); dropzone.classList.remove('drag-over'); });
        });
        dropzone.addEventListener('drop', e => { addFiles(Array.from(e.dataTransfer.files)); });
        fileInput.addEventListener('change', () => { addFiles(Array.from(fileInput.files)); });
    }

    function addFiles(newFiles) {
        const images = newFiles.filter(f => f.type.startsWith('image/') && f.size <= 5 * 1024 * 1024);
        const slots  = MAX_FILES - selectedFiles.length;
        if (slots <= 0) return;
        selectedFiles = [...selectedFiles, ...images.slice(0, slots)];
        renderPreviews(); syncFileInput(); updateStep(2, selectedFiles.length > 0);
    }

    function removeFile(index) {
        selectedFiles.splice(index, 1);
        renderPreviews(); syncFileInput(); updateStep(2, selectedFiles.length > 0);
    }

    function renderPreviews() {
        if (!photoGrid) return;
        photoGrid.innerHTML = '';
        if (selectedFiles.length === 0) {
            photoGrid.style.setProperty('display','none','important');
            if (photoCount) photoCount.style.display = 'none';
            return;
        }
        photoGrid.style.removeProperty('display');
        photoGrid.style.display = 'grid';
        selectedFiles.forEach((file, idx) => {
            const reader = new FileReader();
            reader.onload = e => {
                const item = document.createElement('div');
                item.className = 'nq-photo-item';
                item.innerHTML = `<img src="${e.target.result}" alt="Photo ${idx+1}"><button type="button" class="nq-photo-remove" data-idx="${idx}" title="Supprimer"><i class="feather-x"></i></button>`;
                item.querySelector('.nq-photo-remove').addEventListener('click', ev => { ev.stopPropagation(); removeFile(parseInt(ev.currentTarget.dataset.idx)); });
                photoGrid.appendChild(item);
            };
            reader.readAsDataURL(file);
        });
        if (photoCount) {
            const remaining = MAX_FILES - selectedFiles.length;
            photoCount.style.display = 'flex';
            photoCount.innerHTML = `<i class="feather-image" style="color:#f97316;font-size:13px;"></i><span>${selectedFiles.length}</span> nouvelle${selectedFiles.length > 1 ? 's' : ''} photo${selectedFiles.length > 1 ? 's' : ''}${remaining > 0 ? ` · ${remaining} emplacement${remaining > 1 ? 's' : ''} restant${remaining > 1 ? 's' : ''}` : ' · Limite atteinte'}`;
        }
    }

    function syncFileInput() {
        if (!fileInput) return;
        const dt = new DataTransfer();
        selectedFiles.forEach(f => dt.items.add(f));
        fileInput.files = dt.files;
    }

    /* ── 2. CHIPS ── */
    function checkStep3() {
        const anyAvail   = document.querySelectorAll('.nq-chip:not(.nq-chip-urgence) input:checked').length > 0;
        const urgChecked = document.querySelectorAll('.nq-chip-urgence input:checked').length > 0;
        updateStep(3, anyAvail || urgChecked);
    }

    function initChips(selector, urgency = false) {
        document.querySelectorAll(selector).forEach(chip => {
            const input = chip.querySelector('input');
            if (!input) return;
            if (input.checked) chip.classList.add(urgency && (input.value === '1' || input.value === 'true') ? 'checked-urgent' : 'checked');
            input.addEventListener('change', () => {
                if (input.type === 'radio') document.querySelectorAll(selector).forEach(c => c.classList.remove('checked','checked-urgent'));
                if (input.checked) chip.classList.add(urgency && (input.value === '1' || input.value === 'true') ? 'checked-urgent' : 'checked');
                else chip.classList.remove('checked','checked-urgent');
                checkStep3();
            });
            chip.addEventListener('click', e => {
                if (e.target.tagName === 'INPUT') return;
                e.preventDefault();
                if (input.type === 'checkbox') { input.checked = !input.checked; input.dispatchEvent(new Event('change')); }
                else if (input.type === 'radio' && !input.checked) { input.checked = true; input.dispatchEvent(new Event('change')); }
            });
        });
    }
    initChips('.nq-chip:not(.nq-chip-urgence)');
    initChips('.nq-chip-urgence', true);
    checkStep3();

    /* ── 3. CHARACTER COUNTER ── */
    const descTA    = document.getElementById('{{ form.description.vars.id }}');
    const descCount = document.getElementById('descCharCount');
    const descBar   = document.getElementById('descCharBar');
    if (descTA && descCount) {
        const update = () => {
            const len = descTA.value.length;
            const pct = Math.min(len / 50, 1) * 100;
            const color = len >= 50 ? '#10b981' : (len >= 20 ? '#f97316' : '#e2e8f0');
            descCount.textContent = `${len} caractère${len > 1 ? 's' : ''}`;
            descCount.style.color = len >= 50 ? '#10b981' : (len >= 20 ? '#f97316' : '#94a3b8');
            if (descBar) { descBar.style.width = pct + '%'; descBar.style.background = color; }
            updateStep(4, len > 10);
        };
        descTA.addEventListener('input', update);
        update();
    }

    /* ── 4. LIVE SUMMARY ── */
    function updateSummary() {
        const titleVal = document.getElementById('{{ form.title.vars.id }}')?.value?.trim();
        const catOpt   = document.querySelector('.child-category-select option:checked');
        const descVal  = descTA?.value?.trim();
        setSummaryItem('sum-title', titleVal || null, 'Titre non rempli');
        setSummaryItem('sum-cat', catOpt && catOpt.value ? catOpt.text : null, 'Service non sélectionné');
        setSummaryItem('sum-desc', descVal && descVal.length > 10 ? descVal.substring(0,60) + (descVal.length > 60 ? '…' : '') : null, 'Description vide');
    }

    function setSummaryItem(id, val, emptyText) {
        const el = document.getElementById(id);
        if (!el) return;
        const dot = el.querySelector('div'); const span = el.querySelector('span');
        if (val) { dot.style.background = '#10b981'; span.style.color = '#1e293b'; span.style.fontWeight = '500'; span.textContent = val; }
        else { dot.style.background = '#e2e8f0'; span.style.color = '#94a3b8'; span.style.fontWeight = '400'; span.textContent = emptyText; }
    }

    document.getElementById('{{ form.title.vars.id }}')?.addEventListener('input', updateSummary);
    document.querySelector('.child-category-select')?.addEventListener('change', updateSummary);
    descTA?.addEventListener('input', updateSummary);
    updateSummary();

    /* ── 5. STEPS ── */
    function updateStep(step, done) {
        const dot = document.querySelector(`.nq-step[data-step="${step}"]`);
        if (dot) dot.classList.toggle('done', done);
    }
    function checkStep1() {
        const titleOk = (document.getElementById('{{ form.title.vars.id }}')?.value?.trim()?.length ?? 0) > 2;
        const catOk   = !!(document.querySelector('.child-category-select')?.value);
        updateStep(1, titleOk && catOk);
    }
    document.getElementById('{{ form.title.vars.id }}')?.addEventListener('input', checkStep1);
    document.querySelector('.child-category-select')?.addEventListener('change', checkStep1);
    checkStep1();
    // Mark existing photos as done if any
    {% if quote.images|length > 0 %}updateStep(2, true);{% endif %}

    /* ── 6. SUBMIT STATE ── */
    document.getElementById('editQuoteForm')?.addEventListener('submit', () => {
        const btn = document.getElementById('editSubmitBtn');
        if (btn) { btn.disabled = true; btn.innerHTML = '<i class="feather-loader me-2" style="animation:spin 1s linear infinite;"></i> Sauvegarde en cours…'; }
    });
});

/* ── 7. AI WRITING ASSISTANT ── */
(function () {
    'use strict';
    const GEMINI_API_KEY  = '{{ app.request.server.get("GEMINI_API_KEY")|default("") }}';
    const GEMINI_ENDPOINT = 'https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-lite:generateContent';
    const COOLDOWN_KEY    = 'ai_quote_cooldown';
    const COOLDOWN_MS     = 5 * 60 * 1000;

    (function cleanCooldown() {
        const until = sessionStorage.getItem(COOLDOWN_KEY);
        if (until && Date.now() >= parseInt(until)) sessionStorage.removeItem(COOLDOWN_KEY);
    })();

    function cooldownLeft() {
        const until = sessionStorage.getItem(COOLDOWN_KEY);
        if (!until) return 0;
        const r = parseInt(until) - Date.now();
        return r > 0 ? Math.ceil(r / 1000) : 0;
    }

    function getContext() {
        const title    = (document.getElementById('{{ form.title.vars.id }}')?.value || '').trim();
        const catLabel = document.querySelector('.child-category-select option:checked')?.text || 'Général';
        return { title, category: catLabel };
    }

    function buildPrompt(ctx, currentDesc) {
        return `Tu es un assistant qui aide un propriétaire à décrire son projet de rénovation sur une plateforme de services à domicile.

Contexte :
- Titre du projet : ${ctx.title}
- Catégorie de service : ${ctx.category}
${currentDesc ? `- Brouillon fourni : ${currentDesc}` : ''}

Tâche :
- Rédige une description claire, naturelle, à la première personne, du point de vue du propriétaire
- Concentre-toi sur : les travaux nécessaires, la portée, les contraintes ou préférences
- Utilise un langage chaleureux et accessible (pas de jargon)
- Maximum 200 mots
- Ne mentionne PAS les prix, délais ou garanties
- Si un brouillon est fourni, améliore-le en conservant le sens principal

Retourne UNIQUEMENT le texte de description, sans préambule, sans explication.`;
    }

    async function callGemini(prompt) {
        const secs = cooldownLeft();
        if (secs > 0) {
            const err = new Error('LOCAL_COOLDOWN');
            err.type = 'LOCAL_COOLDOWN';
            err.remaining = secs > 60 ? `${Math.floor(secs/60)}m ${secs%60}s` : `${secs}s`;
            throw err;
        }
        const payload = { contents: [{ parts: [{ text: prompt }] }], generationConfig: { maxOutputTokens: 400, temperature: 0.75 }};
        const res = await fetch(`${GEMINI_ENDPOINT}?key=${GEMINI_API_KEY}`, {
            method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload)
        });
        if (!res.ok) {
            const errData = await res.json().catch(() => ({}));
            const e = new Error(errData?.error?.message || `API ${res.status}`);
            e.status = res.status; e.code = errData?.error?.status;
            if (res.status === 429 || e.code === 'RESOURCE_EXHAUSTED') sessionStorage.setItem(COOLDOWN_KEY, Date.now() + COOLDOWN_MS);
            throw e;
        }
        const data = await res.json();
        const text = data?.candidates?.[0]?.content?.parts?.[0]?.text;
        if (!text) throw new Error('Réponse IA vide.');
        return text.trim();
    }

    function showState(s) {
        ['Loading','Error','Result'].forEach(st => {
            const el = document.getElementById(`ai${st}State`);
            if (el) el.style.display = st.toLowerCase() === s ? 'block' : 'none';
        });
        const apply = document.getElementById('aiApplyBtn');
        const regen = document.getElementById('aiRegenerateBtn');
        if (apply) apply.style.display = s === 'result' ? 'inline-flex' : 'none';
        if (regen) regen.style.display = s === 'result' ? 'inline-flex' : 'none';
    }

    async function triggerAI() {
        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('aiPreviewModal'));
        if (!GEMINI_API_KEY) {
            document.getElementById('aiErrorMessage').textContent = 'Assistant IA non configuré. Ajoutez GEMINI_API_KEY dans .env.local.';
            showState('error'); modal.show(); return;
        }
        const ctx = getContext();
        if (!ctx.title) {
            document.getElementById('aiErrorMessage').textContent = 'Veuillez remplir le titre avant d\'utiliser l\'assistant IA.';
            showState('error'); modal.show(); return;
        }
        showState('loading'); modal.show();
        try {
            const currentDesc = document.getElementById('{{ form.description.vars.id }}')?.value?.trim() || '';
            document.getElementById('aiContextSummary').innerHTML = `<strong>Catégorie :</strong> ${ctx.category} &nbsp;|&nbsp; <strong>Titre :</strong> ${ctx.title}`;
            const suggestion = await callGemini(buildPrompt(ctx, currentDesc));
            document.getElementById('aiSuggestionTextarea').value = suggestion;
            showState('result');
        } catch (err) {
            let msg;
            if (err.type === 'LOCAL_COOLDOWN') msg = `<strong>Veuillez patienter.</strong><br>Réessayez dans <strong>${err.remaining}</strong>.`;
            else if (err.status === 429 || err.code === 'RESOURCE_EXHAUSTED') msg = '<strong>Quota IA dépassé.</strong><br>Attendez quelques minutes et réessayez.';
            else if (err.status === 401 || err.status === 403) msg = '<strong>Clé API invalide ou manquante.</strong>';
            else if (err.message === 'Failed to fetch') msg = '<strong>Erreur réseau.</strong><br>Vérifiez votre connexion internet.';
            else msg = 'L\'assistant IA est temporairement indisponible.';
            document.getElementById('aiErrorMessage').innerHTML = msg;
            showState('error');
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('aiImproveBtn')?.addEventListener('click', triggerAI);
        document.getElementById('aiRegenerateBtn')?.addEventListener('click', triggerAI);
        document.getElementById('aiApplyBtn')?.addEventListener('click', function () {
            const sug  = document.getElementById('aiSuggestionTextarea')?.value || '';
            const desc = document.getElementById('{{ form.description.vars.id }}');
            if (desc && sug) { desc.value = sug; desc.dispatchEvent(new Event('input')); }
            bootstrap.Modal.getOrCreateInstance(document.getElementById('aiPreviewModal')).hide();
        });
    });
})();
</script>

{# ── Auto-save to localStorage (edit — keyed by quote ID) ── #}
<script>
(function () {
    const STORAGE_KEY = 'drl_edit_quote_{{ quote.id }}';
    const TEXT_FIELDS = [
        '{{ form.title.vars.id }}',
        '{{ form.description.vars.id }}',
        '{{ form.address.vars.id }}',
    ];

    let saveTimer = null;

    function collectDraft() {
        const data = {};
        TEXT_FIELDS.forEach(id => {
            const el = document.getElementById(id);
            if (el) data[id] = el.value;
        });
        const budgetEl = document.querySelector('[id$="_budget"]') || document.getElementById('{{ form.budget.vars.id }}');
        if (budgetEl) data['budget'] = budgetEl.value;
        ['{{ form.desiredStartDate.vars.id }}', '{{ form.desiredEndDate.vars.id }}'].forEach(id => {
            const el = document.getElementById(id);
            if (el) data[id] = el.value;
        });
        return data;
    }

    function showToast(msg) {
        let toast = document.getElementById('drl-autosave-toast');
        if (!toast) {
            toast = document.createElement('div');
            toast.id = 'drl-autosave-toast';
            toast.style.cssText = 'position:fixed;bottom:20px;right:20px;z-index:9999;background:#1e293b;color:#fff;padding:10px 18px;border-radius:10px;font-size:13px;box-shadow:0 4px 14px rgba(0,0,0,.25);opacity:0;transition:opacity .3s;pointer-events:none;';
            document.body.appendChild(toast);
        }
        toast.textContent = msg;
        toast.style.opacity = '1';
        clearTimeout(toast._timer);
        toast._timer = setTimeout(() => { toast.style.opacity = '0'; }, 2500);
    }

    function scheduleSave() {
        clearTimeout(saveTimer);
        saveTimer = setTimeout(() => {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(collectDraft()));
            showToast('💾 Modifications sauvegardées localement');
        }, 30000);
    }

    document.addEventListener('DOMContentLoaded', function () {
        TEXT_FIELDS.forEach(id => {
            document.getElementById(id)?.addEventListener('input', scheduleSave);
        });
        document.querySelectorAll('select, input[type="date"]').forEach(el => el.addEventListener('change', scheduleSave));

        // Clear local draft on successful submit (server save takes over)
        document.getElementById('quoteRequestForm')?.addEventListener('submit', function () {
            localStorage.removeItem(STORAGE_KEY);
        });
    });
})();
</script>
{% endblock %}
