<!-- Update Profile Photo Modal -->
<div class="modal fade" id="editLogoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content drl-modal-content">
            <div class="modal-header drl-modal-header">
                <h5 class="modal-title drl-modal-title">
                    <i class="ph-image me-2"></i>{{ 'individual.update_photo'|trans }}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body drl-modal-body">
                <form id="uploadLogoForm" enctype="multipart/form-data">
                    <label for="logoInput" class="d-block border-2 border-dashed rounded-4 p-5 text-center mb-4" style="border: 2px dashed #e2e8f0; cursor: pointer; background: #f8fafc; transition: all .2s;" onmouseover="this.style.borderColor='#f97316'" onmouseout="this.style.borderColor='#e2e8f0'">
                        <div class="drl-stat-icon drl-stat-icon--1 mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                            <i class="ph-image"></i>
                        </div>
                        <p class="fw-bold text-dark mb-1" style="font-size: 14px;">{{ 'individual.upload_photo_click'|trans }}</p>
                        <p class="text-muted small mb-0">{{ 'individual.upload_photo_spec'|trans }}</p>
                        <input type="file" id="logoInput" name="profilePhoto" class="d-none" accept="image/*" required>
                    </label>
                    <div class="d-flex justify-content-end gap-3 pt-3 border-top">
                        <button type="button" class="btn btn-link text-muted text-decoration-none fw-bold" data-bs-dismiss="modal">{{ 'individual.cancel'|trans }}</button>
                        <button type="submit" class="drl-btn-orange">
                            <i class="ph-upload me-2"></i> {{ 'individual.upload_photo_btn'|trans }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
.animate-spin { animation: spin 1s linear infinite; }
@keyframes spin { 100% { transform: rotate(360deg); } }
</style>
