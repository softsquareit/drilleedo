<!-- Edit Profile Photo Modal -->
<div class="modal fade" id="editLogoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content pro-modal-content">
            <div class="modal-header pro-modal-header">
                <h5 class="modal-title fw-bold">Update Profile Photo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pro-modal-body">
                <form id="uploadLogoForm" enctype="multipart/form-data">
                    <label for="logoInput" class="pro-upload-area mb-4">
                        <div class="pro-upload-icon">
                            <i class="feather-image"></i>
                        </div>
                        <p class="pro-upload-text">Click to select or drag image here</p>
                        <p class="pro-text-muted" style="font-size: 0.8125rem; margin-top: 8px;">Recommended: Square image, at least 400x400px</p>
                        <input type="file" id="logoInput" name="profilePhoto" class="pro-file-input" accept="image/*" required>
                    </label>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="pro-btn pro-btn-outline" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="pro-btn pro-btn-primary">
                            <i class="feather-upload"></i> Upload Photo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
.animate-spin { animation: spin 1s linear infinite; }
@keyframes spin { 100% { transform: rotate(360deg); } }
</style>
