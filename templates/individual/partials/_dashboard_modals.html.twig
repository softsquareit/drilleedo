<!-- Edit Profile Photo Modal -->
<div class="modal fade" id="editLogoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content drl-modal-content">
            <div class="modal-header drl-modal-header">
                <h5 class="modal-title drl-modal-title">
                    <i class="feather-image me-2"></i>Update Profile Photo
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body drl-modal-body">
                <form id="uploadLogoForm" enctype="multipart/form-data">
                    <label for="logoInput" class="pro-upload-area mb-4">
                        <div class="pro-upload-icon">
                            <i class="feather-image"></i>
                        </div>
                        <p class="pro-upload-text">Click to select or drag image here</p>
                        <p class="pro-text-muted" style="font-size: 1rem; margin-top: 8px;">Recommended: Square image, at least 400x400px</p>
                        <input type="file" id="logoInput" name="profilePhoto" class="pro-file-input" accept="image/*" required>
                    </label>
                    <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-link text-muted text-decoration-none fw-bold" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="drl-btn-orange">
                            <i class="feather-upload me-2"></i> Upload Photo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
.animate-spin { animation: spin 1s linear infinite; }
@keyframes spin { 100% { transform: rotate(360deg); } }
</style>
