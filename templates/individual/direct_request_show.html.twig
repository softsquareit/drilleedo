{% extends 'individual/base_individual.html.twig' %}

{% block title %}{{ request.title }} – {{ 'individual.direct_req_detail_title'|trans }} - Drilleedo{% endblock %}

{% block body %}
    {# ── Status Banners ── #}
    {% if request.status|upper == 'IN_PROGRESS' %}
        <div class="drl-alert drl-alert--success d-flex align-items-center gap-3 mb-4">
            <i class="feather-tool alert-icon"></i>
            <div><div class="fw-bold">{{ 'individual.status_in_progress_msg'|trans }}</div></div>
        </div>
    {% elseif request.status|upper == 'ACCEPTED' %}
        <div class="drl-alert drl-alert--success d-flex align-items-center gap-3 mb-4">
            <i class="feather-award alert-icon"></i>
            <div><div class="fw-bold">{{ 'individual.status_accepted_msg'|trans }}</div></div>
        </div>
    {% elseif request.status|upper == 'CLOSED' %}
        <div class="drl-alert drl-alert--warning d-flex align-items-center gap-3 mb-4">
            <i class="feather-lock alert-icon"></i>
            <div>
                <div class="fw-bold">{{ 'individual.request_closed'|trans }}</div>
                <div class="small opacity-75">{{ 'individual.request_closed_sub'|trans }}</div>
            </div>
        </div>
    {% endif %}

    {# ── Back link + Workflow Actions ── #}
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <a href="{{ path('individual_direct_requests') }}" class="btn btn-link text-decoration-none text-muted p-0 d-flex align-items-center gap-2" style="font-size: 14px; font-weight: 600;">
            <i class="feather-arrow-left"></i> {{ 'individual.back_to_direct_list'|trans }}
        </a>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            {% if request.status|upper in ['ACCEPTED', 'IN_PROGRESS'] %}
                <button type="button" class="drl-act-btn shadow-sm d-flex align-items-center gap-2"
                        style="background: rgba(251,146,60,0.1); color: #ea580c; border: none;"
                        data-bs-toggle="modal" data-bs-target="#revertDirectRequestModal">
                    <i class="feather-rotate-ccw"></i> {{ 'individual.revert_published'|trans }}
                </button>
            {% endif %}
            {% if request.status|upper == 'ACCEPTED' %}
                <button type="button" class="drl-btn-orange shadow-sm d-flex align-items-center gap-2"
                        data-bs-toggle="modal" data-bs-target="#startDirectRequestModal">
                    <i class="feather-play-circle"></i> {{ 'individual.start_project'|trans }}
                </button>
            {% endif %}
            {% if request.status|upper in ['ACCEPTED', 'IN_PROGRESS'] %}
                <button type="button" class="drl-act-btn shadow-sm d-flex align-items-center gap-2"
                        style="background: rgba(100,116,139,0.1); color: #475569; border: none;"
                        data-bs-toggle="modal" data-bs-target="#closeDirectRequestModal">
                    <i class="feather-lock"></i> {{ 'individual.close_request'|trans }}
                </button>
            {% endif %}
        </div>
    </div>

    <div class="row g-4">
        {# ── Left column: Recipient + Meta ── #}
        <div class="col-lg-4">

            {# Recipient card #}
            <div class="drl-card mb-4">
                <div class="drl-card-head border-bottom pb-3">
                    <h5 class="drl-card-title mb-0"><i class="feather-send me-2 text-primary"></i>{{ 'individual.target_recipient'|trans }}</h5>
                </div>
                <div class="p-4 text-center">
                    {% if request.targetProfessional %}
                        {% set target = request.targetProfessional %}
                        {% set targetName = target.tradeName ?: target.userIdentifier %}
                        {% if target.logo %}
                            <img src="{{ asset('uploads/logos/' ~ target.logo) }}" alt="{{ targetName }}"
                                 style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 3px solid #e2e8f0;"
                                 class="mb-3 mx-auto d-block shadow-sm">
                        {% else %}
                            <div class="drl-stat-icon drl-stat-icon--1 mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem; border-radius: 50%;">
                                {{ targetName|slice(0,1)|upper }}
                            </div>
                        {% endif %}
                        <h5 class="fw-bold text-dark mb-1">{{ targetName }}</h5>
                        <span class="drl-tag drl-tag--sent">{{ 'individual.type_professional'|trans }}</span>
                    {% elseif request.targetCompany %}
                        {% set target = request.targetCompany %}
                        <div class="drl-stat-icon mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem; border-radius: 50%; background: #faf5ff; color: #6b21a8; border: 2px solid #f3e8ff; display:flex;align-items:center;justify-content:center;">
                            <i class="feather-briefcase"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">{{ target.companyName }}</h5>
                        <span class="drl-tag" style="background: #f3e8ff; color: #6b21a8;">{{ 'individual.type_company'|trans }}</span>
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endif %}
                </div>
            </div>

            {# Request meta card #}
            <div class="drl-card">
                <div class="drl-card-head border-bottom pb-3">
                    <h5 class="drl-card-title mb-0"><i class="feather-info me-2 text-primary"></i>{{ 'individual.request_info'|trans }}</h5>
                </div>
                <div class="p-4">
                    <ul class="list-unstyled mb-0" style="font-size: 14px;">
                        <li class="mb-3">
                            <div class="text-muted small mb-1">{{ 'individual.th_status'|trans }}</div>
                            {% set stField = request.status|upper %}
                            {% set statusMap = {
                                'DRAFT':       {'class': 'drl-tag--draft',   'icon': 'feather-file'},
                                'PUBLISHED':   {'class': 'drl-tag--sent',    'icon': 'feather-globe'},
                                'ACCEPTED':    {'class': 'drl-tag--success', 'icon': 'feather-check-circle'},
                                'IN_PROGRESS': {'class': 'drl-tag--warning', 'icon': 'feather-tool'},
                                'CLOSED':      {'class': 'drl-tag--danger',  'icon': 'feather-lock'}
                            } %}
                            {% set st = statusMap[stField]|default({'class': 'drl-tag--draft', 'icon': 'feather-help-circle'}) %}
                            <span class="drl-tag {{ st.class }}">
                                <i class="{{ st.icon }} me-1" style="font-size: 10px;"></i>{{ ('status.' ~ request.status)|trans({}, 'messages') }}
                            </span>
                        </li>
                        <li class="mb-3">
                            <div class="text-muted small mb-1">{{ 'individual.th_category'|trans }}</div>
                            <span class="drl-tag drl-tag--sent">
                                <i class="feather-tag me-1"></i>{{ request.category.localizedTitle(app.request.locale)|default('individual.general'|trans) }}
                            </span>
                        </li>
                        <li class="mb-3">
                            <div class="text-muted small mb-1">{{ 'individual.sent_on'|trans }}</div>
                            <div class="fw-semibold text-dark">{{ request.creationDate|date('F j, Y') }}</div>
                        </li>
                        {% if request.desiredStartDate %}
                            <li class="mb-3">
                                <div class="text-muted small mb-1">{{ 'individual.desired_start'|trans }}</div>
                                <div class="fw-semibold text-dark">{{ request.desiredStartDate|date('F j, Y') }}</div>
                            </li>
                        {% endif %}
                        {% if request.languages and request.languages|length > 0 %}
                            <li class="mb-3">
                                <div class="text-muted small mb-1">{{ 'individual.languages'|trans }}</div>
                                <div class="fw-semibold text-dark">{{ request.languages|join(', ') }}</div>
                            </li>
                        {% endif %}
                        {% if request.availabilities and request.availabilities|length > 0 %}
                            <li class="mb-3">
                                <div class="text-muted small mb-1">{{ 'individual.avail_visit'|trans }}</div>
                                <div class="fw-semibold text-dark">{{ request.availabilities|join(', ') }}</div>
                            </li>
                        {% endif %}
                        <li>
                            <div class="text-muted small mb-1">{{ 'individual.urgent_intervention'|trans }}</div>
                            {% if request.urgentIntervention %}
                                <span class="drl-tag drl-tag--danger"><i class="feather-zap me-1"></i>{{ 'individual.yes'|trans }}</span>
                            {% else %}
                                <span class="drl-tag drl-tag--draft">{{ 'individual.no'|trans }}</span>
                            {% endif %}
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        {# ── Right column: Request details + Offers ── #}
        <div class="col-lg-8">

            {# Request details card #}
            <div class="drl-card mb-4">
                <div class="drl-card-head border-bottom pb-3">
                    <h5 class="drl-card-title mb-0"><i class="feather-file-text me-2 text-primary"></i>{{ request.title }}</h5>
                    <span class="drl-tag drl-tag--draft" style="font-size: 11px;">
                        <i class="feather-send me-1"></i>{{ 'individual.my_direct_requests'|trans }}
                    </span>
                </div>
                <div class="p-4">
                    <div class="text-muted small mb-2">{{ 'individual.description'|trans }}</div>
                    <div class="p-4 bg-light rounded-4 border mb-4" style="white-space: pre-line; color: #334155; line-height: 1.6;">
                        {{ request.description|default('individual.no_notes'|trans) }}
                    </div>

                    {# Images #}
                    {% if request.images and request.images|length > 0 %}
                        <div class="text-muted small mb-2">{{ 'individual.attached_photos'|trans }}</div>
                        <div class="d-flex flex-wrap gap-3 mb-4">
                            {% for image in request.images %}
                                <a href="{{ asset('uploads/quote_requests/' ~ image) }}" target="_blank">
                                    <img src="{{ asset('uploads/quote_requests/' ~ image) }}" alt=""
                                         style="width: 90px; height: 90px; object-fit: cover; border-radius: 12px; border: 2px solid #e2e8f0;"
                                         class="shadow-sm">
                                </a>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {# IN_PROGRESS inline reminder #}
                    {% if request.status|upper == 'IN_PROGRESS' %}
                        <div class="drl-alert drl-alert--success d-flex align-items-center gap-3 mt-2" style="font-size: 13px;">
                            <i class="feather-tool alert-icon"></i>
                            <div class="alert-content">{{ 'individual.close_request'|trans }} → {{ 'individual.close_request_confirm'|trans }}</div>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Offers card #}
            {% set newOfferCountDR = 0 %}
            {% for o in request.offers %}{% if not o.isViewed and o.status|upper in ['PUBLISHED', 'INTERESTED'] %}{% set newOfferCountDR = newOfferCountDR + 1 %}{% endif %}{% endfor %}

            <div class="drl-card" id="offres">
                <div class="drl-card-head">
                    <div>
                        <h4 class="drl-card-title d-flex align-items-center gap-2">
                            <i class="feather-inbox text-primary"></i> {{ 'individual.offers_on_request'|trans }}
                            {% if newOfferCountDR > 0 %}
                                <span class="badge rounded-pill fw-bold px-2 py-1" style="background: var(--drl-orange); color:#fff; font-size:11px;">
                                    {{ newOfferCountDR }} {{ 'individual.offer_new_badge'|trans }}
                                </span>
                            {% endif %}
                        </h4>
                        <p class="drl-card-sub">{{ 'individual.review_quotes_sub'|trans }}</p>
                    </div>
                    <span class="drl-tag drl-tag--sent">{{ request.offers|length }} {{ 'individual.total'|trans }}</span>
                </div>

                <div class="p-3 p-md-4">
                    {% if request.offers|length > 0 %}
                        {% for offer in request.offers %}
                            {% set providerName = offer.provider.primaryContact
                                ? (offer.provider.primaryContact.firstName ~ ' ' ~ offer.provider.primaryContact.lastName)
                                : (offer.provider.companyName|default(offer.provider.email)) %}
                            {% set isNew = not offer.isViewed and offer.status|upper in ['PUBLISHED', 'INTERESTED'] %}
                            {% set offerStatusMap = {
                                'DRAFT':      {'class': 'drl-tag--draft',   'icon': 'feather-file',         'border': '#94a3b8'},
                                'PUBLISHED':  {'class': 'drl-tag--sent',    'icon': 'feather-send',          'border': 'var(--drl-orange)'},
                                'INTERESTED': {'class': 'drl-tag--warning', 'icon': 'feather-bookmark',      'border': '#f59e0b'},
                                'ACCEPTED':   {'class': 'drl-tag--success', 'icon': 'feather-check-circle',  'border': '#10b981'},
                                'REJECTED':   {'class': 'drl-tag--danger',  'icon': 'feather-x-circle',      'border': '#ef4444'},
                                'CLOSED':     {'class': 'drl-tag--draft',   'icon': 'feather-check-square',  'border': '#64748b'}
                            } %}
                            {% set offerInfo = offerStatusMap[offer.status|upper]|default({'class': 'drl-tag--draft', 'icon': 'feather-help-circle', 'border': '#e2e8f0'}) %}

                            <div class="rounded-4 border mb-3 overflow-hidden {{ isNew ? 'shadow-sm' : '' }}"
                                 style="border-left: 4px solid {{ offerInfo.border }} !important; background: {{ isNew ? '#fffbf7' : '#fafbfc' }};">

                                {# ── Top row: Provider + Price + Status ── #}
                                <div class="d-flex align-items-center justify-content-between gap-3 p-4 pb-3 flex-wrap">
                                    {# Provider identity #}
                                    <div class="d-flex align-items-center gap-3 flex-grow-1">
                                        {% if isNew %}
                                            <span class="position-relative">
                                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill"
                                                      style="background: var(--drl-orange); font-size: 9px; padding: 3px 6px; z-index:1;">
                                                    {{ 'individual.offer_new_badge'|trans }}
                                                </span>
                                        {% endif %}
                                        {% if offer.provider.logo %}
                                            <img src="{{ asset('uploads/logos/' ~ offer.provider.logo) }}" alt="{{ providerName }}"
                                                 style="width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 2px solid #e2e8f0; flex-shrink:0;">
                                        {% else %}
                                            <div class="drl-stat-icon drl-stat-icon--1 m-0 flex-shrink-0" style="width: 48px; height: 48px; font-size: 18px; border-radius: 50%;">
                                                {{ providerName|slice(0,1)|upper }}
                                            </div>
                                        {% endif %}
                                        {% if isNew %}</span>{% endif %}
                                        <div>
                                            <a href="{{ path('individual_offer_show', {'id': offer.id}) }}"
                                               class="fw-bold text-dark text-decoration-none d-block" style="font-size: 15px;">
                                                {{ providerName }}
                                            </a>
                                            <div class="d-flex align-items-center gap-1 mt-1 flex-wrap">
                                                <span class="drl-tag drl-tag--draft p-0 px-2" style="font-size: 10px;">
                                                    <i class="feather-briefcase me-1"></i>{{ offer.provider.getType() }}
                                                </span>
                                                {% if offer.provider.entrepreneurType %}
                                                    <span class="drl-tag drl-tag--sent p-0 px-2" style="font-size: 10px;">
                                                        {{ offer.provider.entrepreneurType.name }}
                                                    </span>
                                                {% endif %}
                                                {% if offer.viewedAt %}
                                                    <span class="text-muted" style="font-size: 10px;">
                                                        <i class="feather-eye me-1"></i>{{ 'individual.offer_seen_on'|trans }} {{ offer.viewedAt|date('d/m/Y') }}
                                                    </span>
                                                {% else %}
                                                    <span style="font-size: 10px; color: var(--drl-orange); font-weight: 700;">
                                                        <i class="feather-eye-off me-1"></i>{{ 'individual.offer_not_seen'|trans }}
                                                    </span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>

                                    {# Price + status #}
                                    <div class="d-flex align-items-center gap-3 flex-shrink-0">
                                        <div class="text-end">
                                            <div class="fw-bold" style="font-size: 1.6rem; color: var(--drl-navy); line-height: 1;">
                                                {{ offer.price|number_format(2) }}<span class="text-muted ms-1" style="font-size: 0.9rem;">$</span>
                                            </div>
                                            <div class="text-muted small" style="font-size: 10px;">{{ 'individual.submitted'|trans }} {{ offer.createdAt|date('d/m/Y') }}</div>
                                        </div>
                                        <span class="drl-tag {{ offerInfo.class }} flex-shrink-0">
                                            <i class="{{ offerInfo.icon }} me-1"></i>{{ ('status.' ~ offer.status)|trans({}, 'messages') }}
                                        </span>
                                    </div>
                                </div>

                                {# ── Details row ── #}
                                {% if offer.description or offer.estimatedDuration or offer.possibleStartDate or offer.priorVisit is not null %}
                                <div class="px-4 pb-3 border-top pt-3" style="border-color: #f1f5f9 !important;">
                                    <div class="row g-3">
                                        {% if offer.description %}
                                            <div class="col-md-7">
                                                <div class="text-muted small mb-1" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.4px;">{{ 'individual.offer_message'|trans }}</div>
                                                <p class="mb-0 text-dark small" style="line-height: 1.6;">
                                                    {{ offer.description|slice(0, 160) }}{% if offer.description|length > 160 %}&nbsp;<a href="{{ path('individual_offer_show', {'id': offer.id}) }}" class="text-primary" style="font-size:12px;">{{ 'individual.read_more'|trans }}</a>{% endif %}
                                                </p>
                                            </div>
                                        {% endif %}
                                        <div class="col-md-5">
                                            <div class="d-flex flex-column gap-2">
                                                {% if offer.estimatedDuration %}
                                                    <div class="d-flex align-items-center gap-2 small text-muted">
                                                        <i class="feather-clock" style="font-size: 13px; color: var(--drl-orange);"></i>
                                                        <span>{{ 'individual.estimated_duration'|trans }} : <strong class="text-dark">{{ offer.estimatedDuration }} {{ offer.estimatedDurationUnit|default('j') }}</strong></span>
                                                    </div>
                                                {% endif %}
                                                {% if offer.possibleStartDate %}
                                                    <div class="d-flex align-items-center gap-2 small text-muted">
                                                        <i class="feather-calendar" style="font-size: 13px; color: var(--drl-orange);"></i>
                                                        <span>{{ 'individual.possible_start'|trans }} : <strong class="text-dark">{{ offer.possibleStartDate|date('d/m/Y') }}</strong></span>
                                                    </div>
                                                {% endif %}
                                                {% if offer.priorVisit is not null %}
                                                    <div class="d-flex align-items-center gap-2 small text-muted">
                                                        <i class="feather-map-pin" style="font-size: 13px; color: var(--drl-orange);"></i>
                                                        <span>{{ 'individual.prior_visit'|trans }} : <strong class="text-dark">{{ offer.priorVisit ? 'individual.yes'|trans : 'individual.no'|trans }}</strong></span>
                                                    </div>
                                                {% endif %}
                                                {% if offer.documents|length > 0 %}
                                                    <div class="d-flex align-items-center gap-2 small text-muted">
                                                        <i class="feather-paperclip" style="font-size: 13px; color: var(--drl-orange);"></i>
                                                        <span>{{ offer.documents|length }} {{ 'individual.attached_docs'|trans }}</span>
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {% endif %}

                                {# ── Contact revealed on ACCEPTED ── #}
                                {% if offer.status|upper == 'ACCEPTED' %}
                                    <div class="px-4 pb-3">
                                        <div class="p-3 rounded-4 bg-light border d-flex gap-4">
                                            <div>
                                                <div class="text-muted small mb-1">{{ 'individual.email_address'|trans }}</div>
                                                <a href="mailto:{{ offer.provider.email }}" class="fw-bold text-decoration-none" style="color: var(--drl-navy); font-size: 14px;">{{ offer.provider.email }}</a>
                                            </div>
                                            <div>
                                                <div class="text-muted small mb-1">{{ 'individual.phone_number'|trans }}</div>
                                                <div class="fw-bold text-dark" style="font-size: 14px;">{{ offer.provider.phoneNum|default('individual.not_provided'|trans) }}</div>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}

                                {# ── Actions row ── #}
                                <div class="px-4 py-3 d-flex align-items-center justify-content-between flex-wrap gap-2"
                                     style="background: rgba(0,0,0,0.02); border-top: 1px solid #f1f5f9;">
                                    <a href="{{ path('individual_offer_show', {'id': offer.id}) }}"
                                       class="drl-act-btn drl-act-btn--view shadow-sm" style="font-size: 13px;">
                                        <i class="feather-eye me-1"></i> {{ 'individual.view_full_offer'|trans }}
                                    </a>

                                    {% if request.status|upper not in ['CLOSED'] and offer.status|upper in ['PUBLISHED', 'INTERESTED'] %}
                                        <div class="d-flex gap-2 flex-wrap">
                                            {% if offer.status|upper == 'PUBLISHED' %}
                                                {# Interested #}
                                                <form action="{{ path('individual_offer_interested', {'id': offer.id}) }}" method="POST" class="d-inline">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('offer-action-' ~ offer.id) }}">
                                                    <button type="submit" class="drl-act-btn shadow-sm" style="background: rgba(245,158,11,0.12); color: #b45309; border: none; font-size:13px;">
                                                        <i class="feather-bookmark me-1"></i> {{ 'individual.interested'|trans }}
                                                    </button>
                                                </form>
                                            {% endif %}
                                            {# Accept #}
                                            <button type="button" class="drl-act-btn shadow-sm" style="background: rgba(16,185,129,0.12); color: #059669; border: none; font-size:13px;"
                                                    data-bs-toggle="modal" data-bs-target="#acceptOfferDRModal{{ offer.id }}">
                                                <i class="feather-check-circle me-1"></i> {{ 'individual.accept'|trans }}
                                            </button>
                                            {# Reject #}
                                            <button type="button" class="drl-act-btn shadow-sm" style="background: rgba(220,53,69,0.1); color: #dc3545; border: none; font-size:13px;"
                                                    data-bs-toggle="modal" data-bs-target="#rejectOfferDRModal{{ offer.id }}">
                                                <i class="feather-x-circle me-1"></i> {{ 'individual.reject'|trans }}
                                            </button>
                                        </div>
                                    {% elseif offer.status|upper == 'ACCEPTED' %}
                                        <span class="drl-tag drl-tag--success" style="font-size: 13px;">
                                            <i class="feather-award me-1"></i> {{ 'individual.offer_accepted_msg'|trans }}
                                        </span>
                                    {% elseif offer.status|upper == 'REJECTED' %}
                                        <span class="text-muted small fst-italic">
                                            <i class="feather-x-circle me-1"></i> {{ 'individual.offer_rejected_msg'|trans }}
                                        </span>
                                    {% elseif offer.status|upper == 'CLOSED' %}
                                        <span class="drl-tag drl-tag--draft" style="font-size: 13px;">
                                            <i class="feather-check-square me-1"></i> {{ ('status.CLOSED')|trans({}, 'messages') }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="py-5 text-center">
                            <div class="mb-3 text-muted">
                                <i class="feather-inbox" style="font-size: 4rem; opacity: 0.2;"></i>
                            </div>
                            <h5 class="fw-bold text-dark">{{ 'individual.no_offer_yet_direct'|trans }}</h5>
                            <p class="text-muted small">{{ 'individual.no_offer_yet_direct_sub'|trans }}</p>
                        </div>
                    {% endif %}
                </div>{# end .p-3.p-md-4 #}
            </div>{# end .drl-card #offres #}

        </div>{# end .col-lg-8 #}
    </div>{# end .row #}
{% endblock %}

{% block modals %}
    {{ parent() }}

    {# ── Per-offer Accept / Reject Modals ── #}
    {% for offer in request.offers %}
        {% if offer.status|upper in ['PUBLISHED', 'INTERESTED'] %}
            {% set providerName = offer.provider.primaryContact
                ? (offer.provider.primaryContact.firstName ~ ' ' ~ offer.provider.primaryContact.lastName)
                : (offer.provider.companyName|default(offer.provider.email)) %}

            {# Accept modal #}
            <div class="modal fade" id="acceptOfferDRModal{{ offer.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content drl-modal-content">
                        <div class="modal-body drl-modal-body p-5 text-center">
                            <div class="mb-4">
                                <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle"
                                     style="width: 70px; height: 70px; background: rgba(16,185,129,0.1);">
                                    <i class="feather-check-circle" style="font-size: 2rem; color: #059669;"></i>
                                </div>
                            </div>
                            <h4 class="fw-bold text-dark mb-2">{{ 'individual.accept_offer_title'|trans }}</h4>
                            <p class="text-muted px-3 mb-4">{{ 'individual.accept_offer_desc'|trans({'%name%': providerName, '%price%': offer.price|number_format(2)}) }}</p>
                            <div class="d-flex flex-column gap-3 mt-4">
                                <form action="{{ path('individual_offer_accept', {'id': offer.id}) }}" method="POST" class="w-100">
                                    <input type="hidden" name="_token" value="{{ csrf_token('offer-action-' ~ offer.id) }}">
                                    <button type="submit" class="w-100 py-3 d-flex align-items-center justify-content-center gap-2 rounded-3 border-0 fw-bold"
                                            style="background: #059669; color: #fff; font-size: 1rem;">
                                        <i class="feather-check-circle"></i> {{ 'individual.accept'|trans }}
                                    </button>
                                </form>
                                <button type="button" class="drl-act-btn drl-act-btn--view w-100 py-3 justify-content-center border-0" data-bs-dismiss="modal">
                                    {{ 'individual.cancel'|trans }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Reject modal #}
            <div class="modal fade" id="rejectOfferDRModal{{ offer.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content drl-modal-content">
                        <div class="modal-body drl-modal-body p-5 text-center">
                            <div class="mb-4">
                                <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle"
                                     style="width: 70px; height: 70px; background: rgba(220,53,69,0.1);">
                                    <i class="feather-x-circle" style="font-size: 2rem; color: #dc3545;"></i>
                                </div>
                            </div>
                            <h4 class="fw-bold text-dark mb-2">{{ 'individual.reject_offer_title'|trans }}</h4>
                            <p class="text-muted px-3 mb-4">{{ 'individual.reject_offer_desc'|trans({'%name%': providerName}) }}</p>
                            <div class="d-flex flex-column gap-3 mt-4">
                                <form action="{{ path('individual_offer_reject', {'id': offer.id}) }}" method="POST" class="w-100">
                                    <input type="hidden" name="_token" value="{{ csrf_token('offer-action-' ~ offer.id) }}">
                                    <button type="submit" class="w-100 py-3 d-flex align-items-center justify-content-center gap-2 rounded-3 border-0 fw-bold"
                                            style="background: #dc3545; color: #fff; font-size: 1rem;">
                                        <i class="feather-x-circle"></i> {{ 'individual.reject'|trans }}
                                    </button>
                                </form>
                                <button type="button" class="drl-act-btn drl-act-btn--view w-100 py-3 justify-content-center border-0" data-bs-dismiss="modal">
                                    {{ 'individual.cancel'|trans }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}

    {# ── Revert to Published Modal ── #}
    <div class="modal fade" id="revertDirectRequestModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content drl-modal-content">
                <div class="modal-body drl-modal-body p-5 text-center">
                    <div class="mb-4">
                        <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle" style="width: 70px; height: 70px; background: rgba(234,88,12,0.1);">
                            <i class="feather-rotate-ccw" style="font-size: 2rem; color: #ea580c;"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">{{ 'individual.revert_published'|trans }}</h4>
                    <p class="text-muted px-3 mb-4">{{ 'individual.revert_published_confirm'|trans }}</p>
                    <div class="d-flex flex-column gap-3 mt-4">
                        <form action="{{ path('individual_direct_request_revert_published', {'id': request.id}) }}" method="POST" class="w-100">
                            <input type="hidden" name="_token" value="{{ csrf_token('revert-direct-request-' ~ request.id) }}">
                            <button type="submit" class="w-100 py-3 d-flex align-items-center justify-content-center gap-2 rounded-3 border-0 fw-bold"
                                    style="background: #ea580c; color: #fff; font-size: 1rem;">
                                <i class="feather-rotate-ccw"></i> {{ 'individual.revert_published'|trans }}
                            </button>
                        </form>
                        <button type="button" class="drl-act-btn drl-act-btn--view w-100 py-3 justify-content-center border-0" data-bs-dismiss="modal">
                            {{ 'individual.cancel'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Start Project Modal ── #}
    <div class="modal fade" id="startDirectRequestModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content drl-modal-content">
                <div class="modal-body drl-modal-body p-5 text-center">
                    <div class="mb-4">
                        <div class="drl-stat-icon drl-stat-icon--2 mx-auto" style="width: 70px; height: 70px; font-size: 32px;">
                            <i class="feather-play-circle"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">{{ 'individual.start_project'|trans }}</h4>
                    <p class="text-muted px-3 mb-4">{{ 'individual.start_project_confirm'|trans }}</p>
                    <div class="d-flex flex-column gap-3 mt-4">
                        <form action="{{ path('individual_direct_request_start', {'id': request.id}) }}" method="POST" class="w-100">
                            <input type="hidden" name="_token" value="{{ csrf_token('start-direct-request-' ~ request.id) }}">
                            <button type="submit" class="drl-btn-orange w-100 py-3 justify-content-center shadow-lg">
                                <i class="feather-play-circle me-2"></i> {{ 'individual.start_project'|trans }}
                            </button>
                        </form>
                        <button type="button" class="drl-act-btn drl-act-btn--view w-100 py-3 justify-content-center border-0" data-bs-dismiss="modal">
                            {{ 'individual.cancel'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Close Request Modal ── #}
    <div class="modal fade" id="closeDirectRequestModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content drl-modal-content">
                <div class="modal-body drl-modal-body p-5 text-center">
                    <div class="mb-4">
                        <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle" style="width: 70px; height: 70px; background: rgba(71,85,105,0.1);">
                            <i class="feather-lock" style="font-size: 2rem; color: #475569;"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">{{ 'individual.close_request'|trans }}</h4>
                    <p class="text-muted px-3 mb-4">{{ 'individual.close_request_confirm'|trans }}</p>
                    <div class="d-flex flex-column gap-3 mt-4">
                        <form action="{{ path('individual_direct_request_close', {'id': request.id}) }}" method="POST" class="w-100">
                            <input type="hidden" name="_token" value="{{ csrf_token('close-direct-request-' ~ request.id) }}">
                            <button type="submit" class="w-100 py-3 d-flex align-items-center justify-content-center gap-2 rounded-3 border-0 fw-bold"
                                    style="background: #475569; color: #fff; font-size: 1rem;">
                                <i class="feather-lock"></i> {{ 'individual.close_request'|trans }}
                            </button>
                        </form>
                        <button type="button" class="drl-act-btn drl-act-btn--view w-100 py-3 justify-content-center border-0" data-bs-dismiss="modal">
                            {{ 'individual.cancel'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
