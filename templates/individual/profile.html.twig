{% extends 'individual/base_individual.html.twig' %}

{% block title %}My Profile - Drilleedo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <div class="drl-card">
        <div class="drl-card-head">
            <div>
                <h4 class="drl-card-title">My Profile</h4>
                <p class="drl-card-sub">View and manage your personal information</p>
            </div>
            <button type="button" class="drl-btn-orange shadow-lg" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                <i class="feather-edit me-1"></i> Edit Profile
            </button>
        </div>

        <div class="p-5">
            <!-- Profile Photo -->
            <div class="text-center mb-5 pb-5 border-bottom">
                <div class="drl-avatar-container mx-auto" style="width: 120px; height: 120px; border-radius: 50%; background: var(--drl-navy); color: white; display: flex; align-items: center; justify-content: center; font-size: 3rem; font-weight: 700; border: 4px solid #fff; box-shadow: 0 10px 25px rgba(13, 33, 81, 0.15);">
                    {{ (user.personalInfos and user.personalInfos.firstName ? user.personalInfos.firstName|first : user.email|first)|upper }}
                </div>
                <h4 class="mt-4 mb-1 fw-bold text-dark">{{ user.personalInfos and (user.personalInfos.firstName or user.personalInfos.lastName) ? user.personalInfos.firstName ~ ' ' ~ user.personalInfos.lastName : 'Individual User' }}</h4>
                <p class="text-muted mb-0">{{ user.email }}</p>
                <div class="mt-3">
                    <span class="drl-tag drl-tag--sent">Individual Member</span>
                </div>
            </div>

            <!-- Profile Information -->
            <div class="row g-5">
                <div class="col-md-6">
                    <div class="drl-info-item p-4 rounded-4 border bg-light shadow-sm h-100">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="drl-stat-icon drl-stat-icon--1 m-0 shadow-sm" style="width: 40px; height: 40px; font-size: 16px;">
                                <i class="feather-user"></i>
                            </div>
                            <span class="text-muted small fw-bold text-uppercase ls-1">First Name</span>
                        </div>
                        <p class="h5 fw-bold text-dark mb-0 ps-5 ms-2">
                            {{ user.personalInfos and user.personalInfos.firstName ? user.personalInfos.firstName : '<span class="text-muted fst-italic fw-normal opacity-50">Not provided</span>'|raw }}
                        </p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="drl-info-item p-4 rounded-4 border bg-light shadow-sm h-100">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="drl-stat-icon drl-stat-icon--1 m-0 shadow-sm" style="width: 40px; height: 40px; font-size: 16px;">
                                <i class="feather-user"></i>
                            </div>
                            <span class="text-muted small fw-bold text-uppercase ls-1">Last Name</span>
                        </div>
                        <p class="h5 fw-bold text-dark mb-0 ps-5 ms-2">
                            {{ user.personalInfos and user.personalInfos.lastName ? user.personalInfos.lastName : '<span class="text-muted fst-italic fw-normal opacity-50">Not provided</span>'|raw }}
                        </p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="drl-info-item p-4 rounded-4 border bg-light shadow-sm h-100">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="drl-stat-icon drl-stat-icon--2 m-0 shadow-sm" style="width: 40px; height: 40px; font-size: 16px;">
                                <i class="feather-phone"></i>
                            </div>
                            <span class="text-muted small fw-bold text-uppercase ls-1">Phone Number</span>
                        </div>
                        <p class="h5 fw-bold text-dark mb-0 ps-5 ms-2">
                            {{ user.personalInfos and user.personalInfos.phoneNum ? user.personalInfos.phoneNum : '<span class="text-muted fst-italic fw-normal opacity-50">Not provided</span>'|raw }}
                        </p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="drl-info-item p-4 rounded-4 border bg-light shadow-sm h-100">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="drl-stat-icon drl-stat-icon--1 m-0 shadow-sm" style="width: 40px; height: 40px; font-size: 16px; background: rgba(54, 162, 235, 0.1); color: #36a2eb;">
                                <i class="feather-mail"></i>
                            </div>
                            <span class="text-muted small fw-bold text-uppercase ls-1">Email Address</span>
                        </div>
                        <p class="h5 fw-bold text-dark mb-0 ps-5 ms-2">{{ user.email }}</p>
                    </div>
                </div>

                <div class="col-12">
                    <div class="drl-info-item p-4 rounded-4 border bg-light shadow-sm h-100">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="drl-stat-icon drl-stat-icon--1 m-0 shadow-sm" style="width: 40px; height: 40px; font-size: 16px; background: rgba(255, 159, 64, 0.1); color: #ff9f40;">
                                <i class="feather-map-pin"></i>
                            </div>
                            <span class="text-muted small fw-bold text-uppercase ls-1">Service Address</span>
                        </div>
                        <p class="h5 fw-bold text-dark mb-0 ps-5 ms-2">
                            {{ user.personalInfos and user.personalInfos.adresse ? user.personalInfos.adresse : '<span class="text-muted fst-italic fw-normal opacity-50">Not provided</span>'|raw }}
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block script %}
    {{ parent() }}
{% endblock %}

{% block modals %}
    {{ parent() }}
    <!-- Edit Profile Modal -->
    <div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content drl-modal-content">
                <div class="drl-modal-header" style="background: var(--drl-navy);">
                    <h5 class="drl-modal-title text-white" id="editProfileModalLabel">
                        <i class="feather-edit-3 me-2"></i>Edit My Profile
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-5">
                    {{ form_start(form, {'attr': {'class': 'row g-4'}}) }}
                        <div class="col-lg-6">
                            <div class="form-group mb-0">
                                <label class="drl-label" for="{{ form.first_name.vars.id }}">First Name</label>
                                {{ form_widget(form.first_name, {'attr': {'class': 'drl-input', 'placeholder': 'e.g. John'}}) }}
                                <div class="text-danger small mt-1">{{ form_errors(form.first_name) }}</div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="form-group mb-0">
                                <label class="drl-label" for="{{ form.last_name.vars.id }}">Last Name</label>
                                {{ form_widget(form.last_name, {'attr': {'class': 'drl-input', 'placeholder': 'e.g. Doe'}}) }}
                                <div class="text-danger small mt-1">{{ form_errors(form.last_name) }}</div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="form-group mb-0">
                                <label class="drl-label" for="{{ form.phone_num.vars.id }}">Phone Number</label>
                                {{ form_widget(form.phone_num, {'attr': {'class': 'drl-input', 'placeholder': 'e.g. +1 555-0000'}}) }}
                                <div class="text-danger small mt-1">{{ form_errors(form.phone_num) }}</div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="form-group mb-0">
                                <label class="drl-label opacity-50">Email (Read Only)</label>
                                <input type="email" class="drl-input bg-light border-dashed" value="{{ user.email }}" disabled>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group mb-0">
                                <label class="drl-label" for="{{ form.adresse.vars.id }}">Address</label>
                                {{ form_widget(form.adresse, {'attr': {'class': 'drl-input', 'placeholder': 'Enter your full address'}}) }}
                                <div class="text-danger small mt-1">{{ form_errors(form.adresse) }}</div>
                            </div>
                        </div>
                </div>
                <div class="modal-footer bg-light border-0 p-4">
                    <button type="button" class="btn btn-link text-muted text-decoration-none fw-bold me-3" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="drl-btn-orange px-5 shadow-lg">
                        <i class="feather-save me-2"></i> Save Changes
                    </button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
