{% extends 'individual/base_individual.html.twig' %}

{% block title %}{{ 'individual.account_settings'|trans }} - Drilleedo{% endblock %}

{% block body %}
    <div class="row g-4">
        <div class="col-lg-8 mx-auto">
            <div class="drl-card">
                <div class="drl-card-head">
                    <div>
                        <h4 class="drl-card-title">{{ 'individual.account_settings'|trans }}</h4>
                        <p class="drl-card-sub">{{ 'individual.account_settings_sub'|trans }}</p>
                    </div>
                </div>

                <div class="p-5">
                    {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                        
                        <div class="mb-5">
                            <h6 class="fw-bold mb-4 d-flex align-items-center gap-2 text-dark">
                                <div class="drl-stat-icon drl-stat-icon--1 m-0 shadow-sm" style="width: 32px; height: 32px; font-size: 14px;">
                                    <i class="ph-lock"></i>
                                </div>
                                {{ 'individual.change_password'|trans }}
                            </h6>
                            
                            <div class="form-group mb-4">
                                <label class="drl-label" for="{{ form.plainPassword.first.vars.id }}">{{ 'individual.new_password'|trans }}</label>
                                {{ form_widget(form.plainPassword.first, {
                                    'attr': {
                                        'class': 'drl-input',
                                        'placeholder': 'individual.pw_placeholder'|trans
                                    }
                                }) }}
                                <div class="text-danger small mt-1">{{ form_errors(form.plainPassword.first) }}</div>
                            </div>

                            <div class="form-group mb-0">
                                <label class="drl-label" for="{{ form.plainPassword.second.vars.id }}">{{ 'individual.confirm_new_password'|trans }}</label>
                                {{ form_widget(form.plainPassword.second, {
                                    'attr': {
                                        'class': 'drl-input',
                                        'placeholder': 'individual.pw_confirm_placeholder'|trans
                                    }
                                }) }}
                                <div class="text-danger small mt-1">{{ form_errors(form.plainPassword.second) }}</div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-end pt-5 border-top">
                            <button type="submit" class="drl-btn-orange px-5 shadow-lg">
                                <i class="ph-floppy-disk me-2"></i> {{ 'individual.update_password'|trans }}
                            </button>
                        </div>

                    {{ form_end(form) }}
                </div>
            </div>
            
            <div class="mt-4 p-4 rounded-4 border bg-white shadow-sm d-flex align-items-start gap-3">
                <div class="drl-stat-icon drl-stat-icon--1 m-0" style="width: 40px; height: 40px; min-width: 40px; font-size: 18px; background: rgba(54, 162, 235, 0.1); color: #36a2eb;">
                    <i class="ph-info"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1 text-dark">{{ 'individual.need_profile_change'|trans }}</h6>
                    <p class="small text-muted mb-2">{{ 'individual.profile_change_sub'|trans }}</p>
                    <a href="{{ path('individual_profile') }}" class="btn btn-link p-0 text-decoration-none small fw-bold" style="color: var(--drl-navy);">
                        {{ 'individual.go_to_profile'|trans }} <i class="ph-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
