{% extends 'individual/base_individual.html.twig' %}

{% block title %}Account Settings - Drilleedo{% endblock %}

{% block body %}
    <div class="row g-4">
        <div class="col-lg-8 mx-auto">
            <div class="drl-card">
                <div class="drl-card-head">
                    <div>
                        <h4 class="drl-card-title">Account Settings</h4>
                        <p class="drl-card-sub">Manage your account security and password</p>
                    </div>
                </div>

                <div class="p-5">
                    {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                        
                        <div class="mb-5">
                            <h6 class="fw-bold mb-4 d-flex align-items-center gap-2 text-dark">
                                <div class="drl-stat-icon drl-stat-icon--1 m-0 shadow-sm" style="width: 32px; height: 32px; font-size: 14px;">
                                    <i class="feather-lock"></i>
                                </div>
                                Change Password
                            </h6>
                            
                            <div class="form-group mb-4">
                                <label class="drl-label" for="{{ form.plainPassword.first.vars.id }}">New Password</label>
                                {{ form_widget(form.plainPassword.first, {
                                    'attr': {
                                        'class': 'drl-input',
                                        'placeholder': 'Enter your new password'
                                    }
                                }) }}
                                <div class="text-danger small mt-1">{{ form_errors(form.plainPassword.first) }}</div>
                            </div>

                            <div class="form-group mb-0">
                                <label class="drl-label" for="{{ form.plainPassword.second.vars.id }}">Confirm New Password</label>
                                {{ form_widget(form.plainPassword.second, {
                                    'attr': {
                                        'class': 'drl-input',
                                        'placeholder': 'Confirm your new password'
                                    }
                                }) }}
                                <div class="text-danger small mt-1">{{ form_errors(form.plainPassword.second) }}</div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-end pt-5 border-top">
                            <button type="submit" class="drl-btn-orange px-5 shadow-lg">
                                <i class="feather-save me-2"></i> Update Password
                            </button>
                        </div>

                    {{ form_end(form) }}
                </div>
            </div>
            
            <div class="mt-4 p-4 rounded-4 border bg-white shadow-sm d-flex align-items-start gap-3">
                <div class="drl-stat-icon drl-stat-icon--1 m-0" style="width: 40px; height: 40px; min-width: 40px; font-size: 18px; background: rgba(54, 162, 235, 0.1); color: #36a2eb;">
                    <i class="feather-info"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1 text-dark">Need to change your profile details?</h6>
                    <p class="small text-muted mb-2">Basic details like your name, phone number, and address can be updated on your profile page.</p>
                    <a href="{{ path('individual_profile') }}" class="btn btn-link p-0 text-decoration-none small fw-bold" style="color: var(--drl-navy);">
                        Go to My Profile <i class="feather-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
