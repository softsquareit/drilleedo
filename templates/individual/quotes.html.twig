{% extends 'individual/base_individual.html.twig' %}

{% block title %}My Quote Requests - Drilleedo{% endblock %}

{% block body %}
    <div class="pro-card pro-card-elevated">
        <div class="pro-card-header border-bottom">
            <div>
                <h4 class="pro-card-title">My Quote Requests</h4>
                <p class="pro-card-subtitle">Manage your public requests sent to local professionals</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="pro-badge info">{{ quotes|length }} Total</span>
                <a href="{{ path('individual_quote_new') }}" class="pro-btn pro-btn-primary pro-btn-sm d-flex align-items-center gap-2">
                    <i class="feather-plus"></i> New Request
                </a>
            </div>
        </div>

        <div class="pro-table-wrapper border-0">
            <table class="pro-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 35%">Request Details</th>
                        <th>Category</th>
                        <th>Offers</th>
                        <th>Status</th>
                        <th style="width: 15%" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for quote in quotes %}
                        <tr>
                            <td>
                                <div>
                                    <a href="{{ path('individual_quote_show', {'id': quote.id}) }}" class="fw-bold d-block text-dark text-decoration-none hover-primary" style="font-size: 1.05rem;">
                                        {{ quote.title }}
                                    </a>
                                    <div class="text-muted small mt-1" style="font-size: 0.8rem;">
                                        <i class="feather-calendar me-1"></i>Posted {{ quote.creationDate|date('M d, Y') }}
                                    </div>
                                    <div class="text-muted mt-2 small text-truncate" style="max-width: 300px;">
                                        {{ quote.description|slice(0, 100) }}...
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="pro-badge secondary">
                                    <i class="feather-tag me-1"></i>{{ quote.category.name|default('General') }}
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="pro-stat-icon info m-0" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                        {{ quote.offers|length }}
                                    </div>
                                    <span class="text-muted small">Bid{{ quote.offers|length != 1 ? 's' : '' }}</span>
                                </div>
                            </td>
                            <td>
                                {% set statusMap = {
                                    'Pending': {'class': 'warning', 'label': 'Pending', 'icon': 'feather-clock'},
                                    'Active': {'class': 'success', 'label': 'Active', 'icon': 'feather-zap'},
                                    'Inactive': {'class': 'secondary', 'label': 'Inactive', 'icon': 'feather-eye-off'},
                                    'Accepted': {'class': 'primary', 'label': 'Accepted', 'icon': 'feather-check-circle'},
                                    'Closed': {'class': 'dark', 'label': 'Closed', 'icon': 'feather-lock'},
                                    'Completed': {'class': 'success', 'label': 'Completed', 'icon': 'feather-award'},
                                    'Rejected': {'class': 'danger', 'label': 'Rejected', 'icon': 'feather-x-circle'}
                                } %}
                                {% set st = statusMap[quote.status]|default({'class': 'secondary', 'label': quote.status, 'icon': 'feather-help-circle'}) %}
                                <span class="pro-badge {{ st.class }}">
                                    <i class="{{ st.icon }} me-1"></i>{{ st.label }}
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center justify-content-end gap-2">
                                    <a href="{{ path('individual_quote_show', {'id': quote.id}) }}"
                                       class="pro-btn pro-btn-icon"
                                       title="View Details">
                                        <i class="feather-eye"></i>
                                    </a>
                                    {% if quote.status not in ['Closed', 'Accepted'] %}
                                        <form action="{{ path('individual_quote_toggle', {'id': quote.id}) }}" method="POST" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('toggle-quote-' ~ quote.id) }}">
                                            <button type="submit"
                                                    class="pro-btn pro-btn-icon"
                                                    title="{{ quote.status == 'Inactive' ? 'Activate' : 'Deactivate' }}"
                                                    style="{{ quote.status == 'Inactive' ? 'color: var(--pro-success); border-color: rgba(34, 197, 94, 0.3);' : '' }}">
                                                <i class="feather-{{ quote.status == 'Inactive' ? 'play' : 'pause-circle' }}"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                    {% if quote.status not in ['Closed'] %}
                                        <form action="{{ path('individual_quote_delete', {'id': quote.id}) }}" method="POST" class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this request?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete-quote-' ~ quote.id) }}">
                                            <button type="submit"
                                                    class="pro-btn pro-btn-icon"
                                                    title="Delete"
                                                    style="color: var(--pro-danger); border-color: rgba(239, 68, 68, 0.3);">
                                                <i class="feather-trash-2"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="py-5 text-center">
                                <div class="mb-4 text-muted">
                                    <i class="feather-file-text" style="font-size: 4rem; opacity: 0.1;"></i>
                                </div>
                                <h5 class="fw-bold text-dark">No quote requests found</h5>
                                <p class="text-muted mb-4">You haven't posted any quote requests yet. Get started by describing what you need!</p>
                                <a href="{{ path('individual_quote_new') }}" class="pro-btn pro-btn-primary px-4">
                                    <i class="feather-plus me-2"></i> Post Your First Request
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
