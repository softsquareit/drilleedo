{% extends 'individual/base_individual.html.twig' %}

{% block title %}My Quote Requests - Drilleedo{% endblock %}

{% block body %}
    <div class="pro-card pro-card-elevated">
        <div class="pro-card-header border-bottom">
            <div>
                <h4 class="pro-card-title">My Quote Requests</h4>
                <p class="pro-card-subtitle">Manage your public requests sent to local professionals</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="pro-badge primary">{{ quotes|length }} Total</span>
                <a href="{{ path('individual_quote_new') }}" class="indiv-btn-primary pro-btn-sm d-flex align-items-center gap-2">
                    <i class="feather-plus"></i> New Request
                </a>
            </div>
        </div>

        <div class="pro-table-wrapper border-0">
            <table class="pro-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 35%">Request Details</th>
                        <th>Category</th>
                        <th>Offers</th>
                        <th>Status</th>
                        <th style="width: 15%" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for quote in quotes %}
                        <tr>
                            <td>
                                <div>
                                    <a href="{{ path('individual_quote_show', {'id': quote.id}) }}" class="fw-bold d-block text-dark text-decoration-none hover-primary" style="font-size: 1.4rem;">
                                        {{ quote.title }}
                                    </a>
                                    <div class="text-muted small mt-1" style="font-size: 1rem;">
                                        <i class="feather-calendar me-1"></i>Posted {{ quote.creationDate|date('M d, Y') }}
                                    </div>
                                    <div class="text-muted mt-2 small text-truncate" style="font-size: 1rem; max-width: 300px;">
                                        {{ quote.description|slice(0, 100) }}...
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="pro-badge secondary">
                                    <i class="feather-tag me-1"></i>{{ quote.category.name|default('General') }}
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="pro-stat-icon info m-0" style="width: 32px; height: 32px; font-size: 1.4rem;">
                                        {{ quote.offers|length }}
                                    </div>
                                    <span class="text-muted small" style="font-size: 1rem;">Bid{{ quote.offers|length != 1 ? 's' : '' }}</span>
                                </div>
                            </td>
                            <td>
                                {% set statusMap = {
                                    'DRAFT': {'class': 'secondary', 'label': 'Draft', 'icon': 'feather-file'},
                                    'PUBLISHED': {'class': 'info', 'label': 'Published', 'icon': 'feather-globe'},
                                    'ACCEPTED': {'class': 'success', 'label': 'Accepted', 'icon': 'feather-check-circle'},
                                    'CLOSED': {'class': 'danger', 'label': 'Closed', 'icon': 'feather-lock'}
                                } %}
                                {% set st = statusMap[quote.status]|default({'class': 'secondary', 'label': quote.status, 'icon': 'feather-help-circle'}) %}
                                <span class="pro-badge {{ st.class }}">
                                    <i class="{{ st.icon }} me-1"></i>{{ st.label }}
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center justify-content-end gap-2">
                                    {% if quote.status == 'DRAFT' %}
                                        <button type="button" class="indiv-action-badge edit" style="background: var(--pro-primary-light); color: var(--pro-primary);"
                                                data-bs-toggle="modal" data-bs-target="#publishQuoteModal{{ quote.id }}">
                                            <i class="feather-upload-cloud"></i> Publish
                                        </button>
                                    {% endif %}
                                    <a href="{{ path('individual_quote_show', {'id': quote.id}) }}"
                                       class="indiv-action-badge view">
                                        <i class="feather-eye"></i> View
                                    </a>
                                </div>
                            </td>
                        </tr>

                    {% else %}
                        <tr>
                            <td colspan="5" class="py-5 text-center">
                                <div class="mb-4 text-muted">
                                    <i class="feather-file-text" style="font-size: 4rem; opacity: 0.1;"></i>
                                </div>
                                <h5 class="fw-bold text-dark">No quote requests found</h5>
                                <p class="text-muted mb-4">You haven't posted any quote requests yet. Get started by describing what you need!</p>
                                <a href="{{ path('individual_quote_new') }}" class="indiv-btn-primary px-4">
                                    <i class="feather-plus me-2"></i> Post Your First Request
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block modals %}
    {{ parent() }}
    {% for quote in quotes %}
        {% if quote.status == 'DRAFT' %}
            {# Publish Quote Modal #}
            <div class="modal fade" id="publishQuoteModal{{ quote.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                        <div class="modal-body p-4 text-center">
                            <div class="mb-4">
                                <div class="pro-stat-icon primary mx-auto" style="width: 70px; height: 70px; font-size: 32px; background: var(--pro-primary-light); color: var(--pro-primary);">
                                    <i class="feather-upload-cloud"></i>
                                </div>
                            </div>
                            <h4 class="fw-bold text-dark mb-2">Publish your request?</h4>
                            <p class="text-muted px-4 mb-4">
                                Your request <span class="fw-bold text-dark">"{{ quote.title }}"</span> will become visible to all registered professionals in the <span class="fw-bold text-dark">{{ quote.category.name|default('selected') }}</span> category.
                            </p>
                            
                            <div class="d-flex flex-column gap-3 mt-4">
                                <form action="{{ path('individual_quote_publish', {'id': quote.id}) }}" method="POST" class="w-100">
                                    <input type="hidden" name="_token" value="{{ csrf_token('publish-quote-' ~ quote.id) }}">
                                    <button type="submit" class="indiv-btn-primary w-100 py-3 justify-content-center shadow-sm" style="background: var(--pro-primary); border-color: var(--pro-primary); font-size: 1.15rem;">
                                        <i class="feather-check"></i> Yes, Publish Now
                                    </button>
                                </form>
                                <button type="button" class="indiv-btn-secondary w-100 py-3 bg-light text-dark justify-content-center" style="border-color: #cbd5e1; font-size: 1.15rem;" data-bs-dismiss="modal">
                                    Not Yet, Keep Draft
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}
{% endblock %}
