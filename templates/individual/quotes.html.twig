{% extends 'individual/base_individual.html.twig' %}

{% block title %}My Quote Requests - Drilleedo{% endblock %}

{% block body %}
    <div class="drl-card">
        <div class="drl-card-head">
            <div>
                <h4 class="drl-card-title">My Quote Requests</h4>
                <p class="drl-card-sub">Manage your public requests sent to local professionals</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="drl-tag drl-tag--sent">{{ quotes|length }} Total</span>
                <a href="{{ path('individual_quote_new') }}" class="drl-btn-orange">
                    <i class="feather-plus me-2"></i> New Request
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="drl-table w-100">
                <thead>
                    <tr>
                        <th style="width: 35%">Request Details</th>
                        <th>Category</th>
                        <th>Offers</th>
                        <th>Status</th>
                        <th style="width: 15%" class="text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for quote in quotes %}
                        <tr>
                            <td>
                                <div class="px-2">
                                    <a href="{{ path('individual_quote_show', {'id': quote.id}) }}" class="fw-bold d-block text-dark text-decoration-none hover-primary mb-1" style="font-size: 1.15rem;">
                                        {{ quote.title }}
                                    </a>
                                    <div class="text-muted small d-flex align-items-center gap-1">
                                        <i class="feather-calendar"></i> Posted {{ quote.creationDate|date('M d, Y') }}
                                    </div>
                                    <div class="text-muted mt-2 small text-truncate" style="max-width: 300px;">
                                        {{ quote.description|slice(0, 100) }}...
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="drl-tag drl-tag--sent">
                                    <i class="feather-tag me-1"></i>{{ quote.category.name|default('General') }}
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="drl-stat-icon drl-stat-icon--1 m-0" style="width: 32px; height: 32px; font-size: 14px;">
                                        {{ quote.offers|length }}
                                    </div>
                                    <span class="text-muted small">Bid{{ quote.offers|length != 1 ? 's' : '' }}</span>
                                </div>
                            </td>
                            <td>
                                {% set statusMap = {
                                    'DRAFT': {'class': 'drl-tag--draft', 'label': 'Draft', 'icon': 'feather-file'},
                                    'PUBLISHED': {'class': 'drl-tag--sent', 'label': 'Published', 'icon': 'feather-globe'},
                                    'ACCEPTED': {'class': 'drl-tag--success', 'label': 'Accepted', 'icon': 'feather-check-circle'},
                                    'CLOSED': {'class': 'drl-tag--danger', 'label': 'Closed', 'icon': 'feather-lock'}
                                } %}
                                {% set st = statusMap[quote.status]|default({'class': 'drl-tag--draft', 'label': quote.status, 'icon': 'feather-help-circle'}) %}
                                <span class="drl-tag {{ st.class }}">
                                    <i class="{{ st.icon }} me-1"></i>{{ st.label }}
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center justify-content-end gap-2 px-3">
                                    {% if quote.status == 'DRAFT' %}
                                        <button type="button" class="drl-act-btn" style="background: rgba(232, 80, 26, 0.1); color: var(--drl-orange); border: none;"
                                                data-bs-toggle="modal" data-bs-target="#publishQuoteModal{{ quote.id }}">
                                            <i class="feather-upload-cloud"></i> Publish
                                        </button>
                                    {% endif %}
                                    <a href="{{ path('individual_quote_show', {'id': quote.id}) }}"
                                       class="drl-act-btn drl-act-btn--view">
                                        <i class="feather-eye"></i> View
                                    </a>
                                </div>
                            </td>
                        </tr>

                    {% else %}
                        <tr>
                            <td colspan="5" class="py-5 text-center">
                                <div class="mb-4 text-muted opacity-25">
                                    <i class="feather-file-text" style="font-size: 5rem;"></i>
                                </div>
                                <h5 class="fw-bold text-dark">No quote requests found</h5>
                                <p class="text-muted mb-4 px-5">You haven't posted any quote requests yet. Get started by describing what you need!</p>
                                <a href="{{ path('individual_quote_new') }}" class="drl-btn-orange px-5">
                                    <i class="feather-plus me-2"></i> Post Your First Request
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block modals %}
    {{ parent() }}
    {% for quote in quotes %}
        {% if quote.status == 'DRAFT' %}
            {# Publish Quote Modal #}
            <div class="modal fade" id="publishQuoteModal{{ quote.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content drl-modal-content">
                        <div class="drl-modal-header" style="background: var(--drl-navy);">
                            <h4 class="drl-modal-title text-white">Publish Request</h4>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body p-5 text-center">
                            <div class="mb-4">
                                <div class="drl-stat-icon drl-stat-icon--2 mx-auto" style="width: 70px; height: 70px; font-size: 32px;">
                                    <i class="feather-upload-cloud"></i>
                                </div>
                            </div>
                            <h4 class="fw-bold text-dark mb-2">Publish your request?</h4>
                            <p class="text-muted px-3 mb-4">
                                Your request <span class="fw-bold text-dark">"{{ quote.title }}"</span> will become visible to all registered professionals in the <span class="fw-bold text-dark">{{ quote.category.name|default('selected') }}</span> category.
                            </p>
                            
                            <div class="d-flex flex-column gap-3 mt-4">
                                <form action="{{ path('individual_quote_publish', {'id': quote.id}) }}" method="POST" class="w-100">
                                    <input type="hidden" name="_token" value="{{ csrf_token('publish-quote-' ~ quote.id) }}">
                                    <button type="submit" class="drl-btn-orange w-100 py-3 justify-content-center shadow-lg">
                                        <i class="feather-check"></i> Yes, Publish Now
                                    </button>
                                </form>
                                <button type="button" class="drl-act-btn drl-act-btn--view w-100 py-3 justify-content-center border-0" data-bs-dismiss="modal">
                                    Not Yet, Keep Draft
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}
{% endblock %}
