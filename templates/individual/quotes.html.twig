{% extends 'individual/base_individual.html.twig' %}

{% block title %}{{ 'individual.my_quote_requests'|trans }} - Drilleedo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .qr-card {
            background: #fff;
            border: 1px solid #e8edf5;
            border-radius: 16px;
            padding: 0;
            overflow: hidden;
            transition: box-shadow 0.2s ease, transform 0.2s ease;
            display: flex;
            flex-direction: column;
            height: 100%;
        }
        .qr-card:hover {
            box-shadow: 0 8px 30px rgba(13,33,81,0.10);
            transform: translateY(-2px);
        }
        .qr-card-status {
            height: 4px;
            width: 100%;
        }
        .qr-card-status.draft       { background: #94a3b8; }
        .qr-card-status.published   { background: var(--drl-orange); }
        .qr-card-status.accepted    { background: #10b981; }
        .qr-card-status.in_progress { background: #f59e0b; }
        .qr-card-status.closed      { background: #ef4444; }
        .qr-card-body { padding: 20px; flex: 1; }
        .qr-card-footer {
            padding: 14px 20px;
            border-top: 1px solid #f1f5f9;
            background: #f8fafc;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .qr-offer-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }
        .qr-offer-pill.has-offers { background: #d1fae5; color: #065f46; }
        .qr-offer-pill.no-offers  { background: #f1f5f9; color: #64748b; }
    </style>
{% endblock %}

{% block body %}
    {# Header #}
    <div class="drl-card-head mb-4 p-0">
        <div>
            <h4 class="drl-card-title">{{ 'individual.my_quote_requests'|trans }}</h4>
            <p class="drl-card-sub mb-0">{{ 'individual.my_quote_requests_sub'|trans }}</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="drl-tag drl-tag--sent">{{ quotes|length }} {{ 'individual.total'|trans }}</span>
            <a href="{{ path('individual_quote_new') }}" class="drl-btn-orange shadow-sm">
                <i class="feather-plus me-2"></i> {{ 'individual.new_request'|trans }}
            </a>
        </div>
    </div>

    {% if quotes|length > 0 %}
        <div class="row g-4">
            {% for quote in quotes %}
                {% set statusKey = quote.status|lower %}
                {% set statusMap = {
                    'draft':       {'class': 'drl-tag--draft',   'icon': 'feather-file',         'bar': 'draft'},
                    'published':   {'class': 'drl-tag--sent',    'icon': 'feather-globe',         'bar': 'published'},
                    'accepted':    {'class': 'drl-tag--success', 'icon': 'feather-check-circle',  'bar': 'accepted'},
                    'in_progress': {'class': 'drl-tag--warning', 'icon': 'feather-tool',          'bar': 'in_progress'},
                    'closed':      {'class': 'drl-tag--danger',  'icon': 'feather-lock',          'bar': 'closed'}
                } %}
                {% set st = statusMap[statusKey]|default({'class': 'drl-tag--draft', 'icon': 'feather-help-circle', 'bar': 'draft'}) %}
                {% set offerCount = quote.offers|length %}
                {% set pubOffers = 0 %}
                {% for o in quote.offers %}{% if o.status|upper == 'PUBLISHED' %}{% set pubOffers = pubOffers + 1 %}{% endif %}{% endfor %}

                <div class="col-lg-6">
                    <div class="qr-card shadow-sm">
                        <div class="qr-card-status {{ st.bar }}"></div>
                        <div class="qr-card-body">
                            {# Title + status #}
                            <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                                <div class="flex-grow-1 min-width-0">
                                    <a href="{{ path('individual_quote_show', {'id': quote.id}) }}"
                                       class="fw-bold text-dark text-decoration-none d-block mb-1"
                                       style="font-size: 1rem; line-height: 1.35;">{{ quote.title }}</a>
                                    <span class="text-muted" style="font-size: 11px;">
                                        <i class="feather-calendar me-1"></i>{{ quote.creationDate|date('M d, Y') }}
                                    </span>
                                </div>
                                <span class="drl-tag {{ st.class }} flex-shrink-0" style="font-size: 11px;">
                                    <i class="{{ st.icon }} me-1"></i>{{ ('status.' ~ quote.status)|trans({}, 'messages') }}
                                </span>
                            </div>

                            {# Description #}
                            <p class="text-muted mb-3" style="font-size: 13px; line-height: 1.6;">
                                {{ quote.description|default('')|slice(0, 120) }}{% if (quote.description|default(''))|length > 120 %}…{% endif %}
                            </p>

                            {# Category + offers row #}
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="drl-tag drl-tag--sent" style="font-size: 11px;">
                                    <i class="feather-tag me-1"></i>{{ quote.category.localizedTitle(app.request.locale)|default('individual.general'|trans) }}
                                </span>
                                <span class="qr-offer-pill {{ offerCount > 0 ? 'has-offers' : 'no-offers' }}">
                                    <i class="feather-inbox"></i>
                                    {% if offerCount > 0 %}
                                        {{ offerCount }} {{ 'individual.bid'|trans }}{{ offerCount > 1 ? 's' : '' }}
                                        {% if pubOffers > 0 %}&nbsp;· <span style="color:#d97706;">{{ pubOffers }} {{ 'individual.new_offers'|trans }}</span>{% endif %}
                                    {% else %}
                                        {{ 'individual.no_offers_yet'|trans }}
                                    {% endif %}
                                </span>
                            </div>
                        </div>

                        <div class="qr-card-footer">
                            <a href="{{ path('individual_quote_show', {'id': quote.id}) }}"
                               class="drl-act-btn drl-act-btn--view flex-grow-1 justify-content-center">
                                <i class="feather-eye me-1"></i> {{ 'individual.view'|trans }}
                            </a>
                            {% if quote.status == 'DRAFT' %}
                                <button type="button" class="drl-btn-orange flex-grow-1 justify-content-center shadow-sm"
                                        style="font-size: 13px;"
                                        data-bs-toggle="modal" data-bs-target="#publishQuoteModal{{ quote.id }}">
                                    <i class="feather-upload-cloud me-1"></i> {{ 'individual.publish'|trans }}
                                </button>
                            {% elseif quote.status == 'PUBLISHED' and offerCount > 0 %}
                                <a href="{{ path('individual_quote_show', {'id': quote.id}) }}#offres"
                                   class="drl-btn-orange flex-grow-1 justify-content-center shadow-sm" style="font-size: 13px; text-decoration:none;">
                                    <i class="feather-inbox me-1"></i> {{ 'individual.view_offers'|trans }}
                                </a>
                            {% elseif quote.status == 'ACCEPTED' %}
                                <a href="{{ path('individual_quote_show', {'id': quote.id}) }}"
                                   class="drl-btn-orange flex-grow-1 justify-content-center shadow-sm" style="font-size: 13px; text-decoration:none; background:linear-gradient(135deg,#059669,#10b981);">
                                    <i class="feather-play-circle me-1"></i> {{ 'individual.start_project'|trans }}
                                </a>
                            {% elseif quote.status == 'IN_PROGRESS' %}
                                <a href="{{ path('individual_quote_show', {'id': quote.id}) }}"
                                   class="drl-act-btn drl-act-btn--view flex-grow-1 justify-content-center" style="font-size: 13px; text-decoration:none;">
                                    <i class="feather-tool me-1"></i> {{ 'individual.status_in_progress_msg'|trans }}
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

    {% else %}
        {# Empty state #}
        <div class="drl-card">
            <div class="py-5 text-center">
                <div class="mb-4 text-muted opacity-25">
                    <i class="feather-file-text" style="font-size: 5rem;"></i>
                </div>
                <h5 class="fw-bold text-dark">{{ 'individual.empty_quotes_title'|trans }}</h5>
                <p class="text-muted mb-4 px-5">{{ 'individual.empty_quotes_sub'|trans }}</p>
                <a href="{{ path('individual_quote_new') }}" class="drl-btn-orange px-5 shadow-lg">
                    <i class="feather-plus me-2"></i> {{ 'individual.btn_post_first'|trans }}
                </a>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block modals %}
    {{ parent() }}
    {% for quote in quotes %}
        {% if quote.status == 'DRAFT' %}
            <div class="modal fade" id="publishQuoteModal{{ quote.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content drl-modal-content">
                        <div class="modal-body drl-modal-body p-5 text-center">
                            <div class="mb-4">
                                <div class="drl-stat-icon drl-stat-icon--2 mx-auto" style="width: 70px; height: 70px; font-size: 32px;">
                                    <i class="feather-upload-cloud"></i>
                                </div>
                            </div>
                            <h4 class="fw-bold text-dark mb-2">{{ 'individual.publish_confirm'|trans }}</h4>
                            <p class="text-muted px-3 mb-0">
                                {{ 'individual.publish_desc'|trans({'%title%': quote.title}) }}
                                <strong class="text-dark">{{ quote.category.localizedTitle(app.request.locale)|default('individual.general'|trans) }}</strong>.
                            </p>
                            <div class="d-flex flex-column gap-3 mt-4">
                                <form action="{{ path('individual_quote_publish', {'id': quote.id}) }}" method="POST" class="w-100">
                                    <input type="hidden" name="_token" value="{{ csrf_token('publish-quote-' ~ quote.id) }}">
                                    <button type="submit" class="drl-btn-orange w-100 py-3 justify-content-center shadow-lg">
                                        <i class="feather-check me-2"></i> {{ 'individual.btn_yes_publish'|trans }}
                                    </button>
                                </form>
                                <button type="button" class="drl-act-btn drl-act-btn--view w-100 py-3 justify-content-center border-0" data-bs-dismiss="modal">
                                    {{ 'individual.btn_keep_draft'|trans }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}
{% endblock %}
