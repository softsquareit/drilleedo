{% extends 'individual/base_individual.html.twig' %}

{% block title %}Dashboard - {{ app.user.firstname|default('Individual') }}{% endblock %}

{% block body %}

    {# ── CTA Banner: nudge the user to post their first request ── #}
    {% if publishedCount == 0 %}
    <div class="drl-pro-info p-4 mb-5 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h4 class="mb-1 text-white fw-bold">Ready to find the right professional?</h4>
            <p class="mb-0 text-white opacity-75">
                Post your first renovation request in under 2 minutes and receive free quotes from verified pros.
            </p>
        </div>
        <a href="{{ path('individual_quote_new') }}" class="drl-btn-orange shadow-lg" style="background: white !important; color: var(--drl-navy) !important;">
            <i class="feather-plus me-2"></i> Post a Request
        </a>
    </div>
    {% endif %}

    {# ── KPI Cards ── #}
    <div class="row g-4 mb-5">
        <div class="col-md-3 col-sm-6">
            <a href="{{ path('individual_quotes') }}" class="d-block text-decoration-none h-100">
                <div class="drl-stat">
                    <div class="drl-stat-icon drl-stat-icon--1">
                        <i class="feather-file-text"></i>
                    </div>
                    <div>
                        <h3 class="drl-stat-val">{{ totalRequests }}</h3>
                        <p class="drl-stat-lbl">Total Requests</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a href="{{ path('individual_quotes') }}?status=PUBLISHED" class="d-block text-decoration-none h-100">
                <div class="drl-stat">
                    <div class="drl-stat-icon drl-stat-icon--2" style="background: #eff6ff; color: #00509e; border-color: #dbeafe;">
                        <i class="feather-send"></i>
                    </div>
                    <div>
                        <h3 class="drl-stat-val">{{ publishedCount }}</h3>
                        <p class="drl-stat-lbl">Published</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a href="{{ path('individual_offers') }}" class="d-block text-decoration-none h-100">
                <div class="drl-stat">
                    <div class="drl-stat-icon drl-stat-icon--3">
                        <i class="feather-message-square"></i>
                    </div>
                    <div>
                        <h3 class="drl-stat-val">{{ receivedOffersCount }}</h3>
                        <p class="drl-stat-lbl">Offers Received</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 col-sm-6">
            <a href="{{ path('individual_quotes') }}?status=ACCEPTED" class="d-block text-decoration-none h-100">
                <div class="drl-stat">
                    <div class="drl-stat-icon drl-stat-icon--4">
                        <i class="feather-check-circle"></i>
                    </div>
                    <div>
                        <h3 class="drl-stat-val">{{ acceptedOffersCount }}</h3>
                        <p class="drl-stat-lbl">Accepted</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="row g-4 mt-1">
        <!-- Recent Quotes -->
        <div class="col-lg-8">
            <div class="drl-card h-100">
            <div class="drl-card-head">
                <div>
                    <h5 class="drl-card-title">Recent Requests</h5>
                    <p class="drl-card-sub">Your latest quote requests and their status</p>
                </div>
                <a href="{{ path('individual_quotes') }}" class="drl-act-btn drl-act-btn--view">View all</a>
            </div>

            <div class="table-responsive">
                <table class="drl-table w-100">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Date</th>
                            <th>Offers</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for quote in quotes|slice(0, 5) %}
                            <tr>
                                 <td>
                                    <div>
                                        <span class="fw-bold d-block text-dark">{{ quote.title }}</span>
                                        <span class="text-muted small">{{ quote.description|slice(0, 50) }}...</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted">{{ quote.creationDate|date('M d, Y') }}</span>
                                </td>
                                <td>
                                    {% set offerCount = quote.offers|length %}
                                    {% if offerCount > 0 %}
                                        <span class="drl-tag drl-tag--success">{{ offerCount }} {{ offerCount == 1 ? 'offer' : 'offers' }}</span>
                                    {% else %}
                                        <span class="drl-tag drl-tag--draft">No offers yet</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="drl-tag {{ quote.status == 'PUBLISHED' ? 'drl-tag--sent' : (quote.status == 'ACCEPTED' ? 'drl-tag--success' : 'drl-tag--draft') }}">{{ quote.status }}</span>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="pro-table-empty">
                                    <div class="pro-empty-state">
                                        <div class="pro-empty-icon">
                                            <i class="feather-file-text"></i>
                                        </div>
                                        <h6 class="pro-empty-title">No requests yet</h6>
                                        <p class="pro-empty-text">Post your first quote request to get started</p>
                                        <a href="{{ path('individual_quote_new') }}" class="drl-btn-orange mt-3">
                                            <i class="feather-plus me-2"></i> Post Request
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        </div>

        {# ── Notifications Panel ── #}
        <div class="col-lg-4">
            <div class="drl-card h-100">
                <div class="drl-card-head">
                    <div>
                        <h4 class="drl-card-title">
                            Notifications
                            {% if unreadCount > 0 %}
                                <span class="drl-tag drl-tag--danger ms-2">{{ unreadCount }}</span>
                            {% endif %}
                        </h4>
                    </div>
                    {% if unreadCount > 0 %}
                        <form method="post" action="{{ path('notification_mark_all_read') }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('mark-all-read') }}">
                            <button type="submit" class="drl-act-btn drl-act-btn--view border-0" style="font-size: 12px;">
                                Mark all read
                            </button>
                        </form>
                    {% endif %}
                </div>

                <div class="pro-card-body" style="max-height: 420px; overflow-y: auto; padding: 0;">
                    {% for notification in notifications %}
                        <div class="drl-noti-item {{ not notification.read ? 'unread' : '' }}">
                            <div class="drl-noti-icon {% if 'Accepted' in notification.title or 'Completed' in notification.title %}drl-noti-icon--success{% elseif 'Rejected' in notification.title or 'Withdrawn' in notification.title %}drl-noti-icon--danger{% else %}drl-noti-icon--info{% endif %}">
                                {% if 'Accepted' in notification.title or 'Completed' in notification.title %}
                                    <i class="feather-check-circle"></i>
                                {% elseif 'Rejected' in notification.title or 'Withdrawn' in notification.title %}
                                    <i class="feather-x-circle"></i>
                                {% else %}
                                    <i class="feather-bell"></i>
                                {% endif %}
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="drl-noti-title {{ not notification.read ? 'unread' : '' }}">{{ notification.title }}</h6>
                                <p class="drl-noti-p text-truncate" style="max-width: 250px;">{{ notification.message }}</p>
                                <span class="drl-noti-time">{{ notification.createdAt|date('M d, H:i') }}</span>
                            </div>
                        </div>
                    {% else %}
                        <div class="text-center py-5 px-3">
                            <div style="width: 48px; height: 48px; border-radius: 50%; background: var(--indiv-bg-gray); display:inline-flex; align-items:center; justify-content:center; margin-bottom:12px;">
                                <i class="feather-bell-off" style="font-size:1.2rem; color:var(--indiv-text-muted);"></i>
                            </div>
                            <p class="pro-text-muted mb-0" style="font-size:1rem;">No notifications yet</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
