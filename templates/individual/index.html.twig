{% extends 'individual/base_individual.html.twig' %}

{% block title %}Dashboard - {{ app.user.firstname|default('Individual') }}{% endblock %}

{% block body %}

    <!-- Main Content Grid -->
    <div class="row g-4 mt-1">
        <!-- Recent Quotes -->
        <div class="col-lg-8">
            <div class="pro-card pro-card-elevated h-100">
            <div class="pro-card-header">
                <div>
                    <h5 class="pro-card-title">Recent Requests</h5>
                    <p class="pro-card-subtitle">Your latest quote requests and their status</p>
                </div>
                <a href="{{ path('individual_quotes') }}" class="indiv-btn-secondary pro-btn-sm">View all</a>
            </div>

            <div class="pro-table-wrapper">
                <table class="pro-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Date</th>
                            <th>Offers</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for quote in quotes|slice(0, 5) %}
                            <tr>
                                <td>
                                    <div>
                                        <span class="pro-fw-semibold d-block" style="color:var(--indiv-primary);">{{ quote.title }}</span>
                                        <span class="pro-text-muted" style="font-size: 0.95rem; font-weight: 400;">{{ quote.description|slice(0, 50) }}...</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="pro-text-muted">{{ quote.creationDate|date('M d, Y') }}</span>
                                </td>
                                <td>
                                    <span class="pro-badge info">{{ quote.offers|length }} offers</span>
                                </td>
                                <td>
                                    <span class="pro-badge {{ quote.status == 'Pending' ? 'warning' : 'success' }}">{{ quote.status }}</span>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="pro-table-empty">
                                    <div class="pro-empty-state">
                                        <div class="pro-empty-icon">
                                            <i class="feather-file-text"></i>
                                        </div>
                                        <h6 class="pro-empty-title">No requests yet</h6>
                                        <p class="pro-empty-text">Post your first quote request to get started</p>
                                        <a href="{{ path('individual_quote_new') }}" class="indiv-btn-primary pro-btn-sm style="margin-top: 1rem;">
                                            <i class="feather-plus"></i> Post Request
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        </div>

        {# ── Notifications Panel ── #}
        <div class="col-lg-4">
            <div class="pro-card pro-card-elevated h-100">
                <div class="pro-card-header">
                    <div>
                        <h4 class="pro-card-title">
                            Notifications
                            {% if unreadCount > 0 %}
                                <span class="pro-badge danger" style="font-size:0.7rem; vertical-align:middle; margin-left:6px;">{{ unreadCount }}</span>
                            {% endif %}
                        </h4>
                    </div>
                    {% if unreadCount > 0 %}
                        <form method="post" action="{{ path('notification_mark_all_read') }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('mark-all-read') }}">
                            <button type="submit" class="indiv-btn-secondary pro-btn-sm" style="font-size:0.9rem;">
                                Mark all read
                            </button>
                        </form>
                    {% endif %}
                </div>

                <div class="pro-card-body" style="max-height: 420px; overflow-y: auto; padding: 0;">
                    {% for notification in notifications %}
                        <div class="d-flex align-items-start gap-3 px-3 py-3 {{ not notification.read ? 'bg-light' : '' }}" style="border-bottom: 1px solid var(--indiv-border);">
                            <div style="min-width: 36px; width: 36px; height: 36px; border-radius: 50%; display:flex; align-items:center; justify-content:center;
                                {% if 'Accepted' in notification.title or 'Completed' in notification.title %}background:var(--indiv-success-bg);{% elseif 'Rejected' in notification.title or 'Withdrawn' in notification.title %}background:var(--indiv-danger-bg);{% else %}background:rgba(0, 80, 158, 0.1);{% endif %}">
                                {% if 'Accepted' in notification.title or 'Completed' in notification.title %}
                                    <i class="feather-check-circle" style="font-size:0.85rem; color:var(--indiv-success);"></i>
                                {% elseif 'Rejected' in notification.title or 'Withdrawn' in notification.title %}
                                    <i class="feather-x-circle" style="font-size:0.85rem; color:var(--indiv-danger);"></i>
                                {% else %}
                                    <i class="feather-bell" style="font-size:0.85rem; color:var(--indiv-primary);"></i>
                                {% endif %}
                            </div>
                            <div class="flex-grow-1" style="min-width:0;">
                                <p class="mb-1 {{ not notification.read ? 'pro-fw-semibold' : '' }}" style="font-size:1rem; line-height:1.4; color:var(--indiv-text-main);">
                                    {{ notification.title }}
                                </p>
                                <p class="mb-0 pro-text-muted text-truncate" style="font-size:0.95rem;">{{ notification.message|slice(0, 80) }}{% if notification.message|length > 80 %}...{% endif %}</p>
                                <small class="pro-text-muted" style="font-size:0.85rem;">{{ notification.createdAt|date('M d, H:i') }}</small>
                            </div>
                        </div>
                    {% else %}
                        <div class="text-center py-5 px-3">
                            <div style="width: 48px; height: 48px; border-radius: 50%; background: var(--indiv-bg-gray); display:inline-flex; align-items:center; justify-content:center; margin-bottom:12px;">
                                <i class="feather-bell-off" style="font-size:1.2rem; color:var(--indiv-text-muted);"></i>
                            </div>
                            <p class="pro-text-muted mb-0" style="font-size:1rem;">No notifications yet</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
