{% extends 'individual/base_individual.html.twig' %}

{% block title %}Dashboard - {{ app.user.firstname|default('Individual') }}{% endblock %}

{% block body %}
    <!-- Stats Overview -->
    <div class="pro-stats-grid">
        <div class="pro-stat-card primary">
            <div class="pro-stat-header">
                <div class="pro-stat-icon">
                    <i class="feather-file-text"></i>
                </div>
                <span class="pro-stat-label">Posted Quotes</span>
            </div>
            <div class="pro-stat-value">{{ quotes|length }}</div>
            <div class="pro-stat-footer">
                <a href="{{ path('individual_quotes') }}" class="pro-stat-link">
                    View all <i class="feather-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="pro-stat-card info">
            <div class="pro-stat-header">
                <div class="pro-stat-icon">
                    <i class="feather-inbox"></i>
                </div>
                <span class="pro-stat-label">Received Offers</span>
            </div>
            <div class="pro-stat-value">
                {% set totalOffers = 0 %}
                {% for quote in quotes %}
                    {% set totalOffers = totalOffers + quote.offers|length %}
                {% endfor %}
                {{ totalOffers }}
            </div>
            <div class="pro-stat-footer">
                <a href="{{ path('individual_offers') }}" class="pro-stat-link">
                    Review <i class="feather-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="pro-stat-card success">
            <div class="pro-stat-header">
                <div class="pro-stat-icon">
                    <i class="feather-check-circle"></i>
                </div>
                <span class="pro-stat-label">Active Requests</span>
            </div>
            <div class="pro-stat-value">
                {% set activeQuotes = 0 %}
                {% for quote in quotes %}
                    {% if quote.status == 'Pending' %}
                        {% set activeQuotes = activeQuotes + 1 %}
                    {% endif %}
                {% endfor %}
                {{ activeQuotes }}
            </div>
            <div class="pro-stat-footer">
                <span class="pro-stat-trend up">
                    <i class="feather-trending-up"></i> Open
                </span>
            </div>
        </div>

        <div class="pro-stat-card warning">
            <div class="pro-stat-header">
                <div class="pro-stat-icon">
                    <i class="feather-user"></i>
                </div>
                <span class="pro-stat-label">Account Status</span>
            </div>
            <div class="pro-stat-value" style="font-size: 1.5rem;">Active</div>
            <div class="pro-stat-footer">
                <a href="{{ path('individual_settings') }}" class="pro-stat-link">
                    Settings <i class="feather-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="row g-4 mt-1">
        <!-- Recent Quotes -->
        <div class="col-lg-8">
            <div class="pro-card pro-card-elevated h-100">
            <div class="pro-card-header">
                <div>
                    <h5 class="pro-card-title">Recent Requests</h5>
                    <p class="pro-card-subtitle">Your latest quote requests and their status</p>
                </div>
                <a href="{{ path('individual_quotes') }}" class="pro-btn pro-btn-outline pro-btn-sm">View all</a>
            </div>

            <div class="pro-table-wrapper">
                <table class="pro-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Date</th>
                            <th>Offers</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for quote in quotes|slice(0, 5) %}
                            <tr>
                                <td>
                                    <div>
                                        <span class="pro-fw-semibold d-block">{{ quote.title }}</span>
                                        <span class="pro-text-muted" style="font-size: 1rem; font-weight: 400;">{{ quote.description|slice(0, 50) }}...</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="pro-text-muted">{{ quote.creationDate|date('M d, Y') }}</span>
                                </td>
                                <td>
                                    <span class="pro-badge info">{{ quote.offers|length }} offers</span>
                                </td>
                                <td>
                                    <span class="pro-badge {{ quote.status == 'Pending' ? 'warning' : 'success' }}">{{ quote.status }}</span>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="pro-table-empty">
                                    <div class="pro-empty-state">
                                        <div class="pro-empty-icon">
                                            <i class="feather-file-text"></i>
                                        </div>
                                        <h6 class="pro-empty-title">No requests yet</h6>
                                        <p class="pro-empty-text">Post your first quote request to get started</p>
                                        <a href="{{ path('individual_quote_new') }}" class="pro-btn pro-btn-primary pro-btn-sm pro-mt-3">
                                            <i class="feather-plus"></i> Post Request
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        </div>

        {# ── Notifications Panel ── #}
        <div class="col-lg-4">
            <div class="pro-card pro-card-elevated h-100">
                <div class="pro-card-header">
                    <div>
                        <h4 class="pro-card-title">
                            Notifications
                            {% if unreadCount > 0 %}
                                <span class="pro-badge danger" style="font-size:0.7rem; vertical-align:middle; margin-left:6px;">{{ unreadCount }}</span>
                            {% endif %}
                        </h4>
                    </div>
                    {% if unreadCount > 0 %}
                        <form method="post" action="{{ path('notification_mark_all_read') }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('mark-all-read') }}">
                            <button type="submit" class="pro-btn pro-btn-outline pro-btn-sm" style="font-size:1rem;">
                                Mark all read
                            </button>
                        </form>
                    {% endif %}
                </div>

                <div class="pro-card-body" style="max-height: 420px; overflow-y: auto; padding: 0;">
                    {% for notification in notifications %}
                        <div class="d-flex align-items-start gap-3 px-3 py-3 {{ not notification.read ? 'bg-light' : '' }}" style="border-bottom: 1px solid rgba(0,0,0,0.06);">
                            <div style="min-width: 36px; width: 36px; height: 36px; border-radius: 50%; display:flex; align-items:center; justify-content:center;
                                {% if 'Accepted' in notification.title or 'Completed' in notification.title %}background:rgba(16,185,129,0.12);{% elseif 'Rejected' in notification.title or 'Withdrawn' in notification.title %}background:rgba(239,68,68,0.12);{% else %}background:rgba(67,97,238,0.12);{% endif %}">
                                {% if 'Accepted' in notification.title or 'Completed' in notification.title %}
                                    <i class="feather-check-circle" style="font-size:0.85rem; color:#10b981;"></i>
                                {% elseif 'Rejected' in notification.title or 'Withdrawn' in notification.title %}
                                    <i class="feather-x-circle" style="font-size:0.85rem; color:#ef4444;"></i>
                                {% else %}
                                    <i class="feather-bell" style="font-size:0.85rem; color:#4361ee;"></i>
                                {% endif %}
                            </div>
                            <div class="flex-grow-1" style="min-width:0;">
                                <p class="mb-1 {{ not notification.read ? 'pro-fw-semibold' : '' }}" style="font-size:1rem; line-height:1.4; color:var(--pro-text-dark,#1e293b);">
                                    {{ notification.title }}
                                </p>
                                <p class="mb-0 pro-text-muted text-truncate" style="font-size:1.4rem;">{{ notification.message|slice(0, 80) }}{% if notification.message|length > 80 %}...{% endif %}</p>
                                <small class="pro-text-muted" style="font-size:1rem;">{{ notification.createdAt|date('M d, H:i') }}</small>
                            </div>
                        </div>
                    {% else %}
                        <div class="text-center py-5 px-3">
                            <div style="width: 48px; height: 48px; border-radius: 50%; background: rgba(67,97,238,0.1); display:inline-flex; align-items:center; justify-content:center; margin-bottom:12px;">
                                <i class="feather-bell-off" style="font-size:1.2rem; color:var(--pro-primary,#4361ee);"></i>
                            </div>
                            <p class="pro-text-muted mb-0" style="font-size:1rem;">No notifications yet</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
