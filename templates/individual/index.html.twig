{% extends 'individual/base_individual.html.twig' %}

{% block title %}Dashboard - {{ app.user.personalInfos ? app.user.personalInfos.firstName : 'Individual' }}{% endblock %}

{% block body %}

    {# ── Alerts stack ── #}
    {% if unseenOffersCount > 0 %}
    <div class="drl-alert d-flex align-items-center gap-3 mb-3 shadow-sm"
         style="background: #fff7ed; border-color: #fed7aa; border-left: 4px solid #f97316;">
        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
             style="width: 40px; height: 40px; background: rgba(249,115,22,0.15);">
            <i class="feather-eye-off" style="color: #f97316; font-size: 18px;"></i>
        </div>
        <div class="alert-content flex-grow-1">
            <div class="fw-bold" style="color: #c2410c;">
                {{ unseenOffersCount }} {{ unseenOffersCount > 1 ? 'offre(s) non lue(s)' : 'offre non lue' }} — action requise
            </div>
            <div class="small text-muted">Vous avez des devis que vous n'avez pas encore consultés. Cliquez pour les examiner.</div>
        </div>
        <a href="{{ path('individual_offers') }}" class="drl-btn-orange flex-shrink-0 shadow-sm" style="font-size: 13px; padding: 8px 16px;">
            <i class="feather-eye me-1"></i> Voir les offres
        </a>
    </div>
    {% endif %}

    {% if inProgressCount > 0 %}
    <div class="drl-alert drl-alert--success d-flex align-items-center gap-3 mb-3 shadow-sm">
        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
             style="width: 40px; height: 40px; background: rgba(16,185,129,0.15);">
            <i class="feather-tool" style="color: #059669; font-size: 18px;"></i>
        </div>
        <div class="alert-content flex-grow-1">
            <div class="fw-bold">{{ inProgressCount }} chantier{{ inProgressCount > 1 ? 's' : '' }} en cours</div>
            <div class="small opacity-75">N'oubliez pas de clôturer vos demandes une fois les travaux terminés.</div>
        </div>
        <a href="{{ path('individual_quotes') }}" class="drl-act-btn drl-act-btn--view flex-shrink-0 shadow-sm" style="font-size:13px;">
            <i class="feather-tool me-1"></i> Voir les chantiers
        </a>
    </div>
    {% endif %}

    {# ── CTA Banner: nudge the user to post their first request ── #}
    {% if publishedCount == 0 %}
    <div class="drl-pro-info p-4 mb-5 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h4 class="mb-1 text-white fw-bold">{{ 'individual.dashboard_title'|trans }}</h4>
            <p class="mb-0 text-white opacity-75">
                {{ 'individual.dashboard_sub'|trans }}
            </p>
        </div>
        <a href="{{ path('individual_quote_new') }}" class="drl-btn-orange shadow-lg" style="background: white !important; color: var(--drl-navy) !important;">
            <i class="feather-plus me-2"></i> {{ 'individual.dashboard_btn_post'|trans }}
        </a>
    </div>
    {% endif %}

    {# ── KPI Cards ── #}
    <div class="row g-3 mb-5">
        {# Total demandes #}
        <div class="col-xl col-md-4 col-sm-6">
            <a href="{{ path('individual_quotes') }}" class="d-block text-decoration-none h-100">
                <div class="drl-stat">
                    <div class="drl-stat-icon drl-stat-icon--1">
                        <i class="feather-file-text"></i>
                    </div>
                    <div>
                        <h3 class="drl-stat-val">{{ totalRequests }}</h3>
                        <p class="drl-stat-lbl">{{ 'individual.stat_total_requests'|trans }}</p>
                    </div>
                </div>
            </a>
        </div>
        {# Publiées #}
        <div class="col-xl col-md-4 col-sm-6">
            <a href="{{ path('individual_quotes') }}" class="d-block text-decoration-none h-100">
                <div class="drl-stat">
                    <div class="drl-stat-icon drl-stat-icon--2" style="background: #eff6ff; color: #00509e; border-color: #dbeafe;">
                        <i class="feather-send"></i>
                    </div>
                    <div>
                        <h3 class="drl-stat-val">{{ publishedCount }}</h3>
                        <p class="drl-stat-lbl">{{ 'individual.stat_published'|trans }}</p>
                    </div>
                </div>
            </a>
        </div>
        {# Offres reçues + badge non vues #}
        <div class="col-xl col-md-4 col-sm-6">
            <a href="{{ path('individual_offers') }}" class="d-block text-decoration-none h-100">
                <div class="drl-stat {% if unseenOffersCount > 0 %}drl-stat--highlight{% endif %}" style="{{ unseenOffersCount > 0 ? 'border-color: #fed7aa;' : '' }}">
                    <div class="position-relative">
                        <div class="drl-stat-icon drl-stat-icon--3" style="{{ unseenOffersCount > 0 ? 'background: #fff7ed; color: #f97316; border-color: #fed7aa;' : '' }}">
                            <i class="feather-inbox"></i>
                        </div>
                        {% if unseenOffersCount > 0 %}
                            <span class="position-absolute top-0 end-0 badge rounded-pill"
                                  style="background: #f97316; font-size: 9px; padding: 3px 6px; transform: translate(25%, -25%);">
                                {{ unseenOffersCount }}
                            </span>
                        {% endif %}
                    </div>
                    <div>
                        <h3 class="drl-stat-val">{{ receivedOffersCount }}</h3>
                        <p class="drl-stat-lbl">{{ 'individual.stat_offers'|trans }}</p>
                        {% if unseenOffersCount > 0 %}
                            <span style="font-size: 11px; color: #f97316; font-weight: 700;">
                                <i class="feather-eye-off" style="font-size: 10px;"></i> {{ unseenOffersCount }} non lue{{ unseenOffersCount > 1 ? 's' : '' }}
                            </span>
                        {% endif %}
                    </div>
                </div>
            </a>
        </div>
        {# En cours #}
        <div class="col-xl col-md-6 col-sm-6">
            <a href="{{ path('individual_quotes') }}" class="d-block text-decoration-none h-100">
                <div class="drl-stat">
                    <div class="drl-stat-icon" style="background: #fff7ed; color: #f97316; border-color: #fed7aa; width:52px; height:52px; border-radius:14px; border:1.5px solid; display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0;">
                        <i class="feather-tool"></i>
                    </div>
                    <div>
                        <h3 class="drl-stat-val">{{ inProgressCount }}</h3>
                        <p class="drl-stat-lbl">Chantiers en cours</p>
                    </div>
                </div>
            </a>
        </div>
        {# Acceptées #}
        <div class="col-xl col-md-6 col-sm-6">
            <a href="{{ path('individual_quotes') }}" class="d-block text-decoration-none h-100">
                <div class="drl-stat">
                    <div class="drl-stat-icon drl-stat-icon--4">
                        <i class="feather-check-circle"></i>
                    </div>
                    <div>
                        <h3 class="drl-stat-val">{{ acceptedOffersCount }}</h3>
                        <p class="drl-stat-lbl">{{ 'individual.stat_accepted'|trans }}</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="row g-4 mt-1">
        <!-- Recent Quote Requests -->
        <div class="col-12">
            <div class="drl-card">
                <div class="drl-card-head">
                    <div>
                        <h5 class="drl-card-title">{{ 'individual.recent_requests'|trans }}</h5>
                        <p class="drl-card-sub">{{ 'individual.recent_sub'|trans }}</p>
                    </div>
                    <a href="{{ path('individual_quotes') }}" class="drl-act-btn drl-act-btn--view">{{ 'individual.view_all'|trans }}</a>
                </div>

                <div class="table-responsive">
                    <table class="drl-table w-100">
                        <thead>
                            <tr>
                                <th>{{ 'individual.th_title'|trans }}</th>
                                <th>{{ 'individual.th_date'|trans }}</th>
                                <th>{{ 'individual.th_offers'|trans }}</th>
                                <th>{{ 'individual.th_status'|trans }}</th>
                                <th class="text-end px-4">{{ 'individual.th_actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for quote in quotes|slice(0, 5) %}
                                {% set pendingOnQuote = 0 %}
                                {% for o in quote.offers %}{% if o.status|upper == 'PUBLISHED' %}{% set pendingOnQuote = pendingOnQuote + 1 %}{% endif %}{% endfor %}
                                <tr>
                                    <td>
                                        <div class="px-2">
                                            <a href="{{ path('individual_quote_show', {'id': quote.id}) }}" class="fw-bold d-block text-dark text-decoration-none mb-1">{{ quote.title }}</a>
                                            <span class="text-muted small">{{ quote.description|default('')|slice(0, 60) }}{% if (quote.description|default(''))|length > 60 %}…{% endif %}</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted small">{{ quote.creationDate|date('d/m/Y') }}</span>
                                    </td>
                                    <td>
                                        {% set offerCount = quote.offers|length %}
                                        {% if offerCount > 0 %}
                                            <span class="drl-tag drl-tag--success">{{ 'individual.offers_count'|trans({'%count%': offerCount}) }}</span>
                                            {% if pendingOnQuote > 0 %}
                                                <span class="ms-1" style="font-size: 11px; color: #f97316; font-weight: 700;">
                                                    <i class="feather-zap" style="font-size: 10px;"></i> {{ pendingOnQuote }} {{ 'individual.stat_pending'|trans }}
                                                </span>
                                            {% endif %}
                                        {% else %}
                                            <span class="drl-tag drl-tag--draft">{{ 'individual.no_offers_yet'|trans }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% set qStatusMap = {
                                            'DRAFT':       'drl-tag--draft',
                                            'PUBLISHED':   'drl-tag--sent',
                                            'ACCEPTED':    'drl-tag--success',
                                            'IN_PROGRESS': 'drl-tag--warning',
                                            'CLOSED':      'drl-tag--draft'
                                        } %}
                                        <span class="drl-tag {{ qStatusMap[quote.status|upper]|default('drl-tag--draft') }}">
                                            {{ ('status.' ~ quote.status)|trans({}, 'messages') }}
                                        </span>
                                    </td>
                                    <td class="text-end px-3">
                                        <a href="{{ path('individual_quote_show', {'id': quote.id}) }}" class="drl-act-btn drl-act-btn--view shadow-sm">
                                            <i class="feather-eye"></i> {{ 'individual.view'|trans }}
                                        </a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="py-5 text-center">
                                        <div>
                                            <div class="mb-3 text-muted opacity-25" style="font-size: 4rem;">
                                                <i class="feather-file-text"></i>
                                            </div>
                                            <h6 class="fw-bold text-dark">{{ 'individual.empty_requests_title'|trans }}</h6>
                                            <p class="text-muted small">{{ 'individual.empty_requests_sub'|trans }}</p>
                                            <a href="{{ path('individual_quote_new') }}" class="drl-btn-orange mt-3">
                                                <i class="feather-plus me-2"></i> {{ 'individual.dashboard_btn_post'|trans }}
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
