{% extends 'individual/base_individual.html.twig' %}

{% block title %}My Direct Requests - {{ app.user.firstname|default('Individual') }}{% endblock %}

{% block body %}
    <div class="pro-card pro-card-elevated">
        <div class="pro-card-header border-bottom">
            <div>
                <h4 class="pro-card-title">My Direct Requests</h4>
                <p class="pro-card-subtitle">Inquiries sent specifically to professionals or companies</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="pro-badge info">{{ directRequests|length }} Total</span>
                <a href="{{ path('professionals_list') }}" class="indiv-btn-primary pro-btn-sm d-flex align-items-center gap-2">
                    <i class="feather-search"></i> Find Professionals
                </a>
            </div>
        </div>

        <div class="pro-table-wrapper border-0">
            <table class="pro-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 35%">Request Details</th>
                        <th>Target Recipient</th>
                        <th>Category</th>
                        <th>Offers</th>
                        <th>Status</th>
                        <th style="width: 10%" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for request in directRequests %}
                        <tr>
                            <td>
                                <div>
                                    <span class="fw-bold d-block text-dark" style="font-size: 1.4rem;">{{ request.title }}</span>
                                    <div class="text-muted small mt-1" style="font-size: 1rem;">
                                        <i class="feather-calendar me-1"></i>Sent {{ request.creationDate|date('M d, Y') }}
                                    </div>
                                    <div class="text-muted mt-2 small text-truncate" style="max-width: 300px; font-size: 1rem;">
                                        {{ request.description|slice(0, 100) }}...
                                    </div>
                                </div>
                            </td>
                            <td>
                                {% if request.targetProfessional %}
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="pro-stat-icon primary m-0" style="width: 40px; height: 40px; font-size: 1rem;">
                                            <i class="feather-user"></i>
                                        </div>
                                        <div>
                                            <span class="fw-bold d-block text-dark">{{ request.targetProfessional.tradeName ?: request.targetProfessional.userIdentifier }}</span>
                                            <span class="pro-badge info p-0 px-2" style="font-size: 1rem;">Professional</span>
                                        </div>
                                    </div>
                                {% elseif request.targetCompany %}
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="pro-stat-icon purple m-0" style="width: 40px; height: 40px; font-size: 1rem;">
                                            <i class="feather-briefcase"></i>
                                        </div>
                                        <div>
                                            <span class="fw-bold d-block text-dark">{{ request.targetCompany.companyName }}</span>
                                            <span class="pro-badge purple p-0 px-2" style="font-size: 1rem;">Company</span>
                                        </div>
                                    </div>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="pro-badge secondary">
                                    <i class="feather-tag me-1"></i>{{ request.category.name|default('General') }}
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="pro-stat-icon info m-0" style="width: 32px; height: 32px; font-size: 1.4rem;">
                                        {{ request.offers|length }}
                                    </div>
                                    <span class="text-muted small" style="font-size: 1rem;">Offer{{ request.offers|length != 1 ? 's' : '' }}</span>
                                </div>
                            </td>
                            <td>
                                {% set stField = request.status|upper %}
                                {% set statusInfo = {
                                    'DRAFT': {'class': 'secondary', 'label': 'Draft', 'icon': 'feather-file'},
                                    'PUBLISHED': {'class': 'info', 'label': 'Published', 'icon': 'feather-globe'},
                                    'ACCEPTED': {'class': 'success', 'label': 'Accepted', 'icon': 'feather-check-circle'},
                                    'CLOSED': {'class': 'danger', 'label': 'Closed', 'icon': 'feather-lock'}
                                } %}
                                {% set st = statusInfo[stField]|default({'class': 'secondary', 'label': request.status, 'icon': 'feather-help-circle'}) %}
                                <span class="pro-badge {{ st.class }}">
                                    <i class="{{ st.icon }} me-1" style="font-size:0.65rem;"></i>{{ st.label }}
                                </span>
                            </td>
                            <td class="text-end">
                                <a href="{{ path('individual_offers') }}" class="indiv-action-badge view">
                                    <i class="feather-inbox"></i> Offers
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="py-5 text-center">
                                <div class="mb-4 text-muted">
                                    <i class="feather-send" style="font-size: 4rem; opacity: 0.1;"></i>
                                </div>
                                <h5 class="fw-bold text-dark">No direct requests sent</h5>
                                <p class="text-muted mb-4">You haven't sent any direct requests to professionals or companies yet.</p>
                                <a href="{{ path('professionals_list') }}" class="indiv-btn-primary-light px-4">
                                    <i class="feather-search me-2"></i> Find Professionals
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
