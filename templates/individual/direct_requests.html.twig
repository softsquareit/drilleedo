{% extends 'individual/base_individual.html.twig' %}

{% block title %}{{ 'individual.my_direct_requests'|trans }} - Drilleedo{% endblock %}

{% block body %}
    <div class="drl-card">
        <div class="drl-card-head">
            <div>
                <h4 class="drl-card-title">{{ 'individual.my_direct_requests'|trans }}</h4>
                <p class="drl-card-sub">{{ 'individual.my_direct_requests_sub'|trans }}</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="drl-tag drl-tag--sent">{{ directRequests|length }} {{ 'individual.total'|trans }}</span>
                <a href="{{ path('professionals_list') }}" class="drl-btn-orange shadow-lg">
                    <i class="feather-search me-2"></i> {{ 'individual.btn_find_pros'|trans }}
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="drl-table w-100">
                <thead>
                    <tr>
                        <th style="width: 35%">{{ 'individual.th_req_details'|trans }}</th>
                        <th>{{ 'individual.th_target_recipient'|trans }}</th>
                        <th>{{ 'individual.th_category'|trans }}</th>
                        <th>{{ 'individual.th_offers'|trans }}</th>
                        <th>{{ 'individual.th_status'|trans }}</th>
                        <th style="width: 10%" class="text-end px-4">{{ 'individual.th_actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for request in directRequests %}
                        <tr>
                            <td>
                                <div class="px-2">
                                    <a href="{{ path('individual_direct_request_show', {'id': request.id}) }}" class="fw-bold d-block text-dark text-decoration-none mb-1" style="font-size: 1.05rem;">{{ request.title }}</a>
                                    <div class="text-muted small d-flex align-items-center gap-1">
                                        <i class="feather-calendar"></i> {{ 'individual.sent_on'|trans }} {{ request.creationDate|date('d/m/Y') }}
                                    </div>
                                    <div class="text-muted mt-2 small text-truncate" style="max-width: 300px;">
                                        {{ request.description|default('')|slice(0, 100) }}{% if (request.description|default(''))|length > 100 %}…{% endif %}
                                    </div>
                                </div>
                            </td>
                            <td>
                                {% if request.targetProfessional %}
                                    <div class="d-flex align-items-center gap-3 px-2">
                                        <div class="drl-stat-icon drl-stat-icon--1 m-0 shadow-sm" style="width: 36px; height: 36px; font-size: 14px;">
                                            <i class="feather-user"></i>
                                        </div>
                                        <div>
                                            <span class="fw-bold d-block text-dark small">{{ request.targetProfessional.tradeName ?: request.targetProfessional.userIdentifier }}</span>
                                            <span class="drl-tag drl-tag--sent p-0 px-2 mt-1" style="font-size: 10px;">{{ 'individual.type_professional'|trans }}</span>
                                        </div>
                                    </div>
                                {% elseif request.targetCompany %}
                                    <div class="d-flex align-items-center gap-3 px-2">
                                        <div class="drl-stat-icon m-0 shadow-sm" style="width: 36px; height: 36px; font-size: 14px; background: #faf5ff; color: #6b21a8; border: 1px solid #f3e8ff; border-radius: 10px; display:flex;align-items:center;justify-content:center;">
                                            <i class="feather-briefcase"></i>
                                        </div>
                                        <div>
                                            <span class="fw-bold d-block text-dark small">{{ request.targetCompany.companyName }}</span>
                                            <span class="drl-tag p-0 px-2 mt-1" style="font-size: 10px; background: #f3e8ff; color: #6b21a8;">{{ 'individual.type_company'|trans }}</span>
                                        </div>
                                    </div>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="drl-tag drl-tag--sent">
                                    <i class="feather-tag me-1"></i>{{ request.category.localizedTitle(app.request.locale)|default('individual.general'|trans) }}
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="drl-stat-icon drl-stat-icon--1 m-0" style="width: 32px; height: 32px; font-size: 14px;">
                                        {{ request.offers|length }}
                                    </div>
                                    <span class="text-muted small">{{ 'individual.bid'|trans }}{{ request.offers|length > 1 ? 's' : '' }}</span>
                                </div>
                            </td>
                            <td>
                                {% set stField = request.status|upper %}
                                {% set statusMap = {
                                    'DRAFT':       {'class': 'drl-tag--draft',   'icon': 'feather-file'},
                                    'PUBLISHED':   {'class': 'drl-tag--sent',    'icon': 'feather-globe'},
                                    'ACCEPTED':    {'class': 'drl-tag--success', 'icon': 'feather-check-circle'},
                                    'IN_PROGRESS': {'class': 'drl-tag--warning', 'icon': 'feather-tool'},
                                    'CLOSED':      {'class': 'drl-tag--danger',  'icon': 'feather-lock'}
                                } %}
                                {% set st = statusMap[stField]|default({'class': 'drl-tag--draft', 'icon': 'feather-help-circle'}) %}
                                <span class="drl-tag {{ st.class }}">
                                    <i class="{{ st.icon }} me-1" style="font-size: 10px;"></i>{{ ('status.' ~ request.status)|trans({}, 'messages') }}
                                </span>
                            </td>
                            <td class="text-end px-3">
                                <a href="{{ path('individual_direct_request_show', {'id': request.id}) }}" class="drl-act-btn drl-act-btn--view shadow-sm">
                                    <i class="feather-eye me-1"></i> {{ 'individual.view'|trans }}
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="py-5 text-center">
                                <div class="mb-4 text-muted opacity-25">
                                    <i class="feather-send" style="font-size: 5rem;"></i>
                                </div>
                                <h5 class="fw-bold text-dark">{{ 'individual.empty_direct_title'|trans }}</h5>
                                <p class="text-muted mb-4 px-5">{{ 'individual.empty_direct_sub'|trans }}</p>
                                <a href="{{ path('professionals_list') }}" class="drl-btn-orange px-5 shadow-lg">
                                    <i class="feather-search me-2"></i> {{ 'individual.btn_find_pros'|trans }}
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
