{% extends 'individual/base_individual.html.twig' %}

{% block title %}My Direct Requests - {{ app.user.firstname|default('Individual') }}{% endblock %}

{% block body %}
    <div class="drl-card">
        <div class="drl-card-head">
            <div>
                <h4 class="drl-card-title">My Direct Requests</h4>
                <p class="drl-card-sub">Inquiries sent specifically to professionals or companies</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="drl-tag drl-tag--sent">{{ directRequests|length }} Total</span>
                <a href="{{ path('professionals_list') }}" class="drl-btn-orange shadow-lg">
                    <i class="feather-search me-2"></i> Find Professionals
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="drl-table w-100">
                <thead>
                    <tr>
                        <th style="width: 35%">Request Details</th>
                        <th>Target Recipient</th>
                        <th>Category</th>
                        <th>Offers</th>
                        <th>Status</th>
                        <th style="width: 10%" class="text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for request in directRequests %}
                        <tr>
                            <td>
                                <div class="px-2">
                                    <span class="fw-bold d-block text-dark mb-1" style="font-size: 1.15rem;">{{ request.title }}</span>
                                    <div class="text-muted small d-flex align-items-center gap-1">
                                        <i class="feather-calendar"></i> Sent {{ request.creationDate|date('M d, Y') }}
                                    </div>
                                    <div class="text-muted mt-2 small text-truncate" style="max-width: 300px;">
                                        {{ request.description|slice(0, 100) }}...
                                    </div>
                                </div>
                            </td>
                            <td>
                                {% if request.targetProfessional %}
                                    <div class="d-flex align-items-center gap-3 px-2">
                                        <div class="drl-stat-icon drl-stat-icon--1 m-0 shadow-sm" style="width: 36px; height: 36px; font-size: 14px;">
                                            <i class="feather-user"></i>
                                        </div>
                                        <div>
                                            <span class="fw-bold d-block text-dark small">{{ request.targetProfessional.tradeName ?: request.targetProfessional.userIdentifier }}</span>
                                            <span class="drl-tag drl-tag--sent p-0 px-2 mt-1" style="font-size: 10px;">Professional</span>
                                        </div>
                                    </div>
                                {% elseif request.targetCompany %}
                                    <div class="d-flex align-items-center gap-3 px-2">
                                        <div class="drl-stat-icon drl-stat-icon--2 m-0 shadow-sm" style="width: 36px; height: 36px; font-size: 14px; background: #faf5ff; color: #6b21a8; border-color: #f3e8ff;">
                                            <i class="feather-briefcase"></i>
                                        </div>
                                        <div>
                                            <span class="fw-bold d-block text-dark small">{{ request.targetCompany.companyName }}</span>
                                            <span class="drl-tag p-0 px-2 mt-1" style="font-size: 10px; background: #f3e8ff; color: #6b21a8;">Company</span>
                                        </div>
                                    </div>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="drl-tag drl-tag--sent">
                                    <i class="feather-tag me-1"></i>{{ request.category.name|default('General') }}
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="drl-stat-icon drl-stat-icon--1 m-0" style="width: 32px; height: 32px; font-size: 14px;">
                                        {{ request.offers|length }}
                                    </div>
                                    <span class="text-muted small">Offer{{ request.offers|length != 1 ? 's' : '' }}</span>
                                </div>
                            </td>
                            <td>
                                {% set stField = request.status|upper %}
                                {% set statusInfo = {
                                    'DRAFT': {'class': 'drl-tag--draft', 'label': 'Draft', 'icon': 'feather-file'},
                                    'PUBLISHED': {'class': 'drl-tag--sent', 'label': 'Published', 'icon': 'feather-globe'},
                                    'ACCEPTED': {'class': 'drl-tag--success', 'label': 'Accepted', 'icon': 'feather-check-circle'},
                                    'CLOSED': {'class': 'drl-tag--danger', 'label': 'Closed', 'icon': 'feather-lock'}
                                } %}
                                {% set st = statusInfo[stField]|default({'class': 'drl-tag--draft', 'label': request.status, 'icon': 'feather-help-circle'}) %}
                                <span class="drl-tag {{ st.class }}">
                                    <i class="{{ st.icon }} me-1" style="font-size: 10px;"></i>{{ st.label }}
                                </span>
                            </td>
                            <td class="text-end px-3">
                                <a href="{{ path('individual_offers') }}" class="drl-act-btn drl-act-btn--view shadow-sm">
                                    <i class="feather-inbox me-1"></i> Offers
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="py-5 text-center">
                                <div class="mb-4 text-muted opacity-25">
                                    <i class="feather-send" style="font-size: 5rem;"></i>
                                </div>
                                <h5 class="fw-bold text-dark">No direct requests sent</h5>
                                <p class="text-muted mb-4 px-5">You haven't sent any direct requests to professionals or companies yet.</p>
                                <a href="{{ path('professionals_list') }}" class="drl-btn-orange px-5 shadow-lg">
                                    <i class="feather-search me-2"></i> Find Professionals
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
