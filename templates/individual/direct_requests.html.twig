{% extends 'individual/base_individual.html.twig' %}

{% block title %}My Direct Requests - {{ app.user.firstname|default('Individual') }}{% endblock %}

{% block body %}
    <div class="pro-card pro-card-elevated">
        <div class="pro-card-header">
            <div>
                <h4 class="pro-card-title">My Direct Requests</h4>
                <p class="pro-card-subtitle">Direct inquiries sent to specific professionals or companies</p>
            </div>
            <div class="d-flex gap-2">
                <span class="pro-badge info">{{ directRequests|length }} Total</span>
                <a href="{{ path('professionals_list') }}" class="pro-btn pro-btn-primary pro-btn-sm">
                    <i class="feather-search"></i> Find Professionals
                </a>
            </div>
        </div>

        <div class="pro-table-wrapper">
            <table class="pro-table">
                <thead>
                    <tr>
                        <th>Request Details</th>
                        <th>Target</th>
                        <th>Type</th>
                        <th>Category</th>
                        <th>Date Sent</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for request in directRequests %}
                        <tr>
                            <td>
                                <div>
                                    <span class="pro-fw-semibold d-block">{{ request.title }}</span>
                                    <span class="pro-text-muted" style="font-size: 0.8125rem; font-weight: 400;">{{ request.description|slice(0, 70) }}...</span>
                                </div>
                            </td>
                            <td>
                                {% if request.targetProfessional %}
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light border rounded-circle p-2 me-2" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="feather-user text-primary"></i>
                                        </div>
                                        <span class="pro-fw-semibold">{{ request.targetProfessional.tradeName ?: request.targetProfessional.userIdentifier }}</span>
                                    </div>
                                {% elseif request.targetCompany %}
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light border rounded-circle p-2 me-2" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="feather-briefcase text-primary"></i>
                                        </div>
                                        <span class="pro-fw-semibold">{{ request.targetCompany.companyName }}</span>
                                    </div>
                                {% else %}
                                    <span class="pro-text-muted">Unknown</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if request.targetProfessional %}
                                    <span class="pro-badge primary">Professional</span>
                                {% elseif request.targetCompany %}
                                    <span class="pro-badge purple">Company</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="pro-badge secondary">{{ request.category.name|default('General') }}</span>
                            </td>
                            <td>
                                <span class="pro-text-muted">{{ request.creationDate|date('M d, Y') }}</span>
                            </td>
                            <td>
                                <span class="pro-badge {{ request.status == 'Pending' ? 'warning' : (request.status == 'Accepté' ? 'success' : 'secondary') }}">
                                    {{ request.status }}
                                </span>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="pro-table-empty">
                                <div class="pro-empty-state">
                                    <div class="pro-empty-icon">
                                        <i class="feather-send"></i>
                                    </div>
                                    <h6 class="pro-empty-title">No direct requests sent</h6>
                                    <p class="pro-empty-text">You haven't sent any direct requests to professionals or companies yet</p>
                                    <a href="{{ path('professionals_list') }}" class="pro-btn pro-btn-primary pro-btn-sm pro-mt-3">
                                        <i class="feather-search"></i> Find Professionals
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
