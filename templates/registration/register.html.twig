{% extends 'base.html.twig' %}

{% block title %}{{ 'security.register_link'|trans }} | Drilleedo{% endblock %}
{% block meta_description %}Register on Drilleedo to connect with Canada's best renovation professionals, post projects, and receive competitive quotes — or join as a verified professional to grow your business.{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block stylesheets %}
<script src="https://unpkg.com/@phosphor-icons/web"></script>
<style>
/* ══ REGISTER PAGE ════════════════════════════════════════════════════════
   Charte : --B:#00497F · --S:#3FA9F5 · --O:#FF8A3D · --D:#0C1825 · --M:#4A6073
   ═════════════════════════════════════════════════════════════════════════ */
:root {
    --B:#00497F; --S:#3FA9F5; --O:#FF8A3D; --D:#0C1825; --M:#4A6073;
    --L:#E4EBF2;
}

body { background: #f4f8fc; }

.reg-main {
    min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    padding: 40px 20px;
    background: var(--B);
    position: relative; overflow: hidden;
}
.reg-main::before {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 28px 28px; pointer-events: none;
}

.reg-card {
    width: 100%; max-width: 1100px;
    background: #fff; border-radius: 24px;
    display: flex; overflow: hidden;
    box-shadow: 0 40px 100px rgba(0,0,0,.30);
    position: relative; z-index: 10;
}

/* ── SIDEBAR ── */
.reg-sidebar {
    width: 420px; flex-shrink: 0;
    position: relative; overflow: hidden;
    display: flex; flex-direction: column;
}

.reg-sidebar-bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    transition: opacity .5s ease;
}
.reg-sidebar-bg--pro {
    background-image: url('{{ asset('assets/drilleedo/images/bg/bg-professionals.jpg') }}');
}
.reg-sidebar-bg--ind {
    background-image: url('{{ asset('assets/drilleedo/images/bg/bg-ideas.jpg') }}');
    opacity: 0;
}
.reg-sidebar-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(160deg, rgba(0,73,127,.92) 0%, rgba(0,73,127,.75) 60%, rgba(0,73,127,.88) 100%);
    z-index: 1;
}
.reg-sidebar-inner {
    position: relative; z-index: 2;
    padding: 44px 36px; display: flex; flex-direction: column; height: 100%;
}
.reg-sidebar-logo {
    font-size: 26px; font-weight: 900; color: #fff;
    text-decoration: none; margin-bottom: 48px; display: block;
}
.reg-sidebar-logo span { color: var(--O); }

/* Account type visual badge */
.reg-sidebar-type-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 7px 18px; border-radius: 999px;
    font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    margin-bottom: 20px;
    transition: all .3s;
}
.reg-sidebar-type-badge--pro {
    background: rgba(255,138,61,.2); color: var(--O);
    border: 1px solid rgba(255,138,61,.4);
}
.reg-sidebar-type-badge--ind {
    background: rgba(63,169,245,.2); color: var(--S);
    border: 1px solid rgba(63,169,245,.4);
    display: none;
}

.reg-sidebar-title {
    font-size: 28px; font-weight: 900; color: #fff;
    margin-bottom: 28px; line-height: 1.2;
}
.reg-sidebar-title span { color: var(--O); }

.reg-benefit-list { list-style: none; padding: 0; margin: 0; flex: 1; }
.reg-benefit-item { display: flex; gap: 14px; margin-bottom: 22px; }
.reg-benefit-icon {
    width: 40px; height: 40px; border-radius: 12px; flex-shrink: 0;
    background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.2);
    display: flex; align-items: center; justify-content: center;
    color: var(--O); font-size: 18px;
}
.reg-benefit-text h5 { font-size: 15px; font-weight: 700; color: #fff; margin: 0 0 3px; }
.reg-benefit-text p { font-size: 13px; color: rgba(255,255,255,.68); margin: 0; line-height: 1.5; }

.reg-sidebar-trust {
    display: flex; gap: 8px; flex-wrap: wrap; margin-top: 28px;
}
.reg-trust-pill {
    display: inline-flex; align-items: center; gap: 5px;
    background: rgba(255,255,255,.1); color: rgba(255,255,255,.8);
    border: 1px solid rgba(255,255,255,.18); border-radius: 999px;
    padding: 5px 12px; font-size: 11px; font-weight: 700;
}
.reg-trust-pill i { color: var(--S); }

/* ── FORM SIDE ── */
.reg-form-side {
    flex: 1; padding: 52px 60px;
    display: flex; flex-direction: column;
    overflow-y: auto;
}

/* Type Toggle */
.reg-type-toggle {
    display: flex; background: var(--L);
    padding: 5px; border-radius: 16px;
    margin-bottom: 36px; align-self: flex-start;
    gap: 4px;
}
.reg-type-btn {
    padding: 11px 24px; border-radius: 12px;
    font-size: 14px; font-weight: 700;
    border: none; cursor: pointer;
    transition: all .28s; color: var(--M);
    background: transparent;
    display: flex; align-items: center; gap: 8px;
}
.reg-type-btn:hover { color: var(--D); background: rgba(0,73,127,.06); }
.reg-type-btn.active.pro {
    background: var(--B); color: #fff;
    box-shadow: 0 6px 18px rgba(0,73,127,.28);
}
.reg-type-btn.active.ind {
    background: var(--O); color: #fff;
    box-shadow: 0 6px 18px rgba(255,138,61,.30);
}

/* Form header */
.reg-form-title {
    font-size: 26px; font-weight: 900; color: var(--B);
    margin-bottom: 8px; line-height: 1.2;
}
.reg-form-sub { font-size: 15px; color: var(--M); margin-bottom: 32px; line-height: 1.5; }

/* Form controls */
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 20px; }
.form-group-premium { margin-bottom: 20px; }
.form-group-premium label {
    display: block; font-size: 13px; font-weight: 700;
    color: var(--D); margin-bottom: 7px;
}
.form-control-premium, .form-select-premium {
    width: 100%; height: 50px;
    background: #f8fafc; border: 2px solid var(--L);
    border-radius: 12px; padding: 0 16px;
    font-size: 15px; font-weight: 500; color: var(--D);
    transition: all .2s;
}
.form-control-premium::placeholder { color: #94a3b8; }
.form-control-premium:focus, .form-select-premium:focus {
    background: #fff; border-color: var(--S);
    box-shadow: 0 0 0 4px rgba(63,169,245,.12); outline: none;
}

.modern-checkbox-area {
    display: flex; align-items: center; gap: 12px; margin: 28px 0;
}
.modern-checkbox {
    width: 20px; height: 20px; accent-color: var(--B); cursor: pointer;
}
.modern-checkbox-area label { font-size: 13px; color: var(--M); font-weight: 600; cursor: pointer; }
.modern-checkbox-area a { color: var(--S); text-decoration: none; }

/* Submit buttons */
.btn-reg {
    width: 100%; height: 54px;
    border: none; border-radius: 12px;
    font-size: 16px; font-weight: 800;
    display: flex; align-items: center; justify-content: center; gap: 10px;
    cursor: pointer; transition: all .28s;
}
.btn-reg-pro {
    background: var(--B); color: #fff;
    box-shadow: 0 8px 24px rgba(0,73,127,.28);
}
.btn-reg-pro:hover { background: #003a66; transform: translateY(-2px); box-shadow: 0 12px 32px rgba(0,73,127,.36); }
.btn-reg-ind {
    background: var(--O); color: #fff;
    box-shadow: 0 8px 24px rgba(255,138,61,.30);
}
.btn-reg-ind:hover { background: #e87830; transform: translateY(-2px); box-shadow: 0 12px 32px rgba(255,138,61,.40); }

.reg-footer {
    margin-top: 32px; text-align: center;
    font-size: 14px; color: var(--M);
}
.reg-footer a { font-weight: 700; color: var(--S); text-decoration: none; }
.reg-footer a:hover { color: var(--B); }

/* Responsive */
@media (max-width: 1024px) { .reg-sidebar { display: none; } .reg-form-side { padding: 40px; } }
@media (max-width: 768px) {
    .form-row { grid-template-columns: 1fr; gap: 0; }
    .reg-main { padding: 16px; }
    .reg-card { border-radius: 18px; }
    .reg-form-side { padding: 28px 20px; }
}
</style>
{% endblock %}

{% block body %}
<div class="reg-main">
    <div class="reg-card">

        {# ── SIDEBAR ── #}
        <div class="reg-sidebar">
            <div class="reg-sidebar-bg reg-sidebar-bg--pro" id="sidebar-bg-pro"></div>
            <div class="reg-sidebar-bg reg-sidebar-bg--ind" id="sidebar-bg-ind"></div>
            <div class="reg-sidebar-overlay"></div>
            <div class="reg-sidebar-inner">
                <a href="{{ path('app_home') }}" class="reg-sidebar-logo">Drilleed<span>o.</span></a>

                {# Pro context #}
                <div id="sidebar-pro-content">
                    <div class="reg-sidebar-type-badge reg-sidebar-type-badge--pro">
                        <i class="ph-bold ph-hard-hat"></i> Professionnel
                    </div>
                    <h2 class="reg-sidebar-title">{{ 'security.reg_title'|trans }}</h2>
                    <ul class="reg-benefit-list">
                        <li class="reg-benefit-item">
                            <div class="reg-benefit-icon"><i class="ph-bold ph-shield-check"></i></div>
                            <div class="reg-benefit-text">
                                <h5>{{ 'security.reg_ben1'|trans }}</h5>
                                <p>{{ 'security.reg_ben1_desc'|trans }}</p>
                            </div>
                        </li>
                        <li class="reg-benefit-item">
                            <div class="reg-benefit-icon"><i class="ph-bold ph-chat-circle"></i></div>
                            <div class="reg-benefit-text">
                                <h5>{{ 'security.reg_ben2'|trans }}</h5>
                                <p>{{ 'security.reg_ben2_desc'|trans }}</p>
                            </div>
                        </li>
                        <li class="reg-benefit-item">
                            <div class="reg-benefit-icon"><i class="ph-bold ph-trend-up"></i></div>
                            <div class="reg-benefit-text">
                                <h5>{{ 'security.reg_ben3'|trans }}</h5>
                                <p>{{ 'security.reg_ben3_desc'|trans }}</p>
                            </div>
                        </li>
                    </ul>
                    <div class="reg-sidebar-trust">
                        <span class="reg-trust-pill"><i class="ph-bold ph-seal-check"></i> 0% commission</span>
                        <span class="reg-trust-pill"><i class="ph-bold ph-lightning"></i> &lt;24h premier lead</span>
                        <span class="reg-trust-pill"><i class="ph-bold ph-users"></i> +1500 pros actifs</span>
                    </div>
                </div>

                {# Individual context #}
                <div id="sidebar-ind-content" style="display:none;">
                    <div class="reg-sidebar-type-badge reg-sidebar-type-badge--ind" style="display:inline-flex !important;">
                        <i class="ph-bold ph-house-line"></i> Particulier
                    </div>
                    <h2 class="reg-sidebar-title">Trouvez le <span>pro idéal</span> pour votre projet</h2>
                    <ul class="reg-benefit-list">
                        <li class="reg-benefit-item">
                            <div class="reg-benefit-icon" style="color:var(--S);"><i class="ph-bold ph-magnifying-glass"></i></div>
                            <div class="reg-benefit-text">
                                <h5>Accès à +1 500 pros vérifiés</h5>
                                <p>Consultez les profils, avis et portfolios des meilleurs entrepreneurs de votre région.</p>
                            </div>
                        </li>
                        <li class="reg-benefit-item">
                            <div class="reg-benefit-icon" style="color:var(--S);"><i class="ph-bold ph-currency-dollar-simple"></i></div>
                            <div class="reg-benefit-text">
                                <h5>Devis gratuits sans engagement</h5>
                                <p>Recevez jusqu'à 5 soumissions compétitives et choisissez en toute liberté.</p>
                            </div>
                        </li>
                        <li class="reg-benefit-item">
                            <div class="reg-benefit-icon" style="color:var(--S);"><i class="ph-bold ph-star"></i></div>
                            <div class="reg-benefit-text">
                                <h5>Avis certifiés & transparents</h5>
                                <p>Chaque avis est vérifié. Embauchez en confiance avec une totale transparence.</p>
                            </div>
                        </li>
                    </ul>
                    <div class="reg-sidebar-trust">
                        <span class="reg-trust-pill"><i class="ph-bold ph-check-circle"></i> Gratuit à utiliser</span>
                        <span class="reg-trust-pill"><i class="ph-bold ph-shield-check"></i> Pros certifiés</span>
                        <span class="reg-trust-pill"><i class="ph-bold ph-map-pin"></i> Partout au Canada</span>
                    </div>
                </div>

            </div>
        </div>

        {# ── FORM SIDE ── #}
        <div class="reg-form-side">

            <div class="reg-type-toggle" role="tablist">
                <button class="reg-type-btn active pro" id="professional-tab" type="button">
                    <i class="ph-bold ph-hard-hat"></i> {{ 'security.tab_pro'|trans }}
                </button>
                <button class="reg-type-btn ind" id="individual-tab" type="button">
                    <i class="ph-bold ph-user"></i> {{ 'security.tab_ind'|trans }}
                </button>
            </div>

            <div class="tab-content w-100">

                {# ── Pro Form ── #}
                <div class="tab-pane fade show active" id="tab-professional" role="tabpanel">
                    <h2 class="reg-form-title">{{ 'security.join_pro'|trans }}</h2>
                    <p class="reg-form-sub">{{ 'security.join_pro_sub'|trans }}</p>

                    {{ form_start(professionalForm, {'attr': {'class': 'rbt-form-modern', 'novalidate': 'novalidate'}}) }}
                        {% if not professionalForm.vars.valid %}
                            <div class="alert alert-danger border-0 rounded-4 p-3 mb-4" style="background:#fff1f2;color:#e11d48;font-size:14px;">Corrigez les erreurs ci-dessous.</div>
                        {% endif %}

                        <div class="form-row">
                            <div class="form-group-premium">
                                <label>{{ 'security.lbl_business_email'|trans }}</label>
                                {{ form_widget(professionalForm.email, {'attr': {'class': 'form-control-premium', 'placeholder': 'pro@company.ca'}}) }}
                                <div class="text-danger small mt-1 fw-bold">{{ form_errors(professionalForm.email) }}</div>
                            </div>
                            <div class="form-group-premium">
                                <label>{{ 'security.lbl_secure_password'|trans }}</label>
                                {{ form_widget(professionalForm.plainPassword, {'attr': {'class': 'form-control-premium', 'placeholder': '••••••••'}}) }}
                                <div class="text-danger small mt-1 fw-bold">{{ form_errors(professionalForm.plainPassword) }}</div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group-premium">
                                <label>{{ 'security.lbl_sector'|trans }}</label>
                                {{ form_widget(professionalForm.parentCategory, {'attr': {'class': 'form-select-premium parent-category-select selectpicker', 'data-live-search': 'true'}}) }}
                                <div class="text-danger small mt-1 fw-bold">{{ form_errors(professionalForm.parentCategory) }}</div>
                            </div>
                            <div class="form-group-premium">
                                <label>{{ 'security.lbl_service'|trans }}</label>
                                {{ form_widget(professionalForm.category, {'attr': {'class': 'form-select-premium child-category-select selectpicker', 'data-live-search': 'true', 'data-selected-id': professionalForm.category.vars.data ? professionalForm.category.vars.data.id : ''}}) }}
                                <div class="text-danger small mt-1 fw-bold">{{ form_errors(professionalForm.category) }}</div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group-premium">
                                <label>{{ 'security.lbl_city'|trans }}</label>
                                {{ form_widget(professionalForm.city, {'attr': {'class': 'form-control-premium', 'placeholder': 'ex. Montréal'}}) }}
                                <div class="text-danger small mt-1 fw-bold">{{ form_errors(professionalForm.city) }}</div>
                            </div>
                            <div class="form-group-premium">
                                <label>{{ 'security.lbl_exp'|trans }}</label>
                                {{ form_widget(professionalForm.expYears, {'attr': {'class': 'form-control-premium', 'placeholder': 'Années d\'expérience'}}) }}
                                <div class="text-danger small mt-1 fw-bold">{{ form_errors(professionalForm.expYears) }}</div>
                            </div>
                        </div>

                        <div class="modern-checkbox-area">
                            {{ form_widget(professionalForm.agreeTerms, {'attr': {'id': 'pro-terms', 'class': 'modern-checkbox'}}) }}
                            <label for="pro-terms">{{ 'security.agree_pro'|trans|raw }}</label>
                        </div>

                        <button type="submit" class="btn-reg btn-reg-pro">
                            {{ 'security.btn_reg_pro'|trans }} <i class="ph-bold ph-arrow-right"></i>
                        </button>
                    {{ form_end(professionalForm) }}
                </div>

                {# ── Individual Form ── #}
                <div class="tab-pane fade" id="tab-individual" role="tabpanel">
                    <h2 class="reg-form-title">{{ 'security.join_ind'|trans }}</h2>
                    <p class="reg-form-sub">{{ 'security.join_ind_sub'|trans }}</p>

                    {{ form_start(individualForm, {'attr': {'class': 'rbt-form-modern', 'novalidate': 'novalidate'}}) }}
                        {% if not individualForm.vars.valid %}
                            <div class="alert alert-danger border-0 rounded-4 p-3 mb-4" style="background:#fff1f2;color:#e11d48;font-size:14px;">Corrigez les erreurs ci-dessous.</div>
                        {% endif %}

                        <div class="form-group-premium">
                            <label>{{ 'security.lbl_personal_email'|trans }}</label>
                            {{ form_widget(individualForm.email, {'attr': {'class': 'form-control-premium', 'placeholder': 'mon@email.com'}}) }}
                            <div class="text-danger small mt-1 fw-bold">{{ form_errors(individualForm.email) }}</div>
                        </div>

                        <div class="form-group-premium">
                            <label>{{ 'security.lbl_secure_password'|trans }}</label>
                            {{ form_widget(individualForm.plainPassword, {'attr': {'class': 'form-control-premium', 'placeholder': '••••••••'}}) }}
                            <div class="text-danger small mt-1 fw-bold">{{ form_errors(individualForm.plainPassword) }}</div>
                        </div>

                        <div class="modern-checkbox-area">
                            {{ form_widget(individualForm.agreeTerms, {'attr': {'id': 'ind-terms', 'class': 'modern-checkbox'}}) }}
                            <label for="ind-terms">{{ 'security.agree_ind'|trans|raw }}</label>
                        </div>

                        <button type="submit" class="btn-reg btn-reg-ind">
                            {{ 'security.btn_reg_ind'|trans }} <i class="ph-bold ph-arrow-right"></i>
                        </button>
                    {{ form_end(individualForm) }}
                </div>

            </div>

            <div class="reg-footer">
                {{ 'security.already_account'|trans }} <a href="{{ path('app_login') }}">{{ 'security.signin_here'|trans }}</a>
            </div>
        </div>

    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const proBtn   = document.getElementById('professional-tab');
    const indBtn   = document.getElementById('individual-tab');
    const proPane  = document.getElementById('tab-professional');
    const indPane  = document.getElementById('tab-individual');
    const bgPro    = document.getElementById('sidebar-bg-pro');
    const bgInd    = document.getElementById('sidebar-bg-ind');
    const conPro   = document.getElementById('sidebar-pro-content');
    const conInd   = document.getElementById('sidebar-ind-content');

    function switchTo(type) {
        if (type === 'pro') {
            proBtn.classList.add('active', 'pro');
            indBtn.classList.remove('active', 'ind');
            proPane.classList.add('show', 'active');
            indPane.classList.remove('show', 'active');
            bgPro.style.opacity = '1';
            bgInd.style.opacity = '0';
            conPro.style.display = '';
            conInd.style.display = 'none';
        } else {
            indBtn.classList.add('active', 'ind');
            proBtn.classList.remove('active', 'pro');
            indPane.classList.add('show', 'active');
            proPane.classList.remove('show', 'active');
            bgPro.style.opacity = '0';
            bgInd.style.opacity = '1';
            conPro.style.display = 'none';
            conInd.style.display = '';
        }
    }

    proBtn.addEventListener('click', function (e) { e.preventDefault(); switchTo('pro'); });
    indBtn.addEventListener('click', function (e) { e.preventDefault(); switchTo('ind'); });

    // Restore tab after validation error
    const indHasErrors = document.querySelector('#tab-individual .text-danger:not(:empty)');
    const proHasErrors = document.querySelector('#tab-professional .text-danger:not(:empty)');
    switchTo((indHasErrors && !proHasErrors) ? 'ind' : 'pro');
});
</script>
{% endblock %}
