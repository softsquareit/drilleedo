{% extends 'base.html.twig' %}

{% block title %}{{ 'security.register_link'|trans }} | Drilleedo{% endblock %}
{% block meta_description %}Register on Drilleedo to connect with Canada's best renovation professionals, post projects, and receive competitive quotes — or join as a verified professional to grow your business.{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --drl-navy: #0d2151;
            --drl-blue: #00509e;
            --drl-orange: #e8501a;
            --drl-orange-hover: #c43d10;
        }

        body {
            background: #f1f5f9;
        }

        .reg-main {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            background: linear-gradient(135deg, #0d2151 0%, #1e293b 100%);
            position: relative;
            overflow: hidden;
        }

        .reg-main::before {
            content: '';
            position: absolute;
            inset: 0;
            background: url('{{ asset('uploads/banners/login.png') }}') center/cover no-repeat;
            opacity: 0.1;
        }

        .reg-card {
            width: 100%;
            max-width: 1100px;
            background: #fff;
            border-radius: 24px;
            display: flex;
            overflow: hidden;
            box-shadow: 0 40px 100px rgba(0, 0, 0, 0.3);
            position: relative;
            z-index: 10;
        }

        /* Left Sidebar: Value Prop */
        .reg-sidebar {
            width: 400px;
            background: linear-gradient(135deg, var(--drl-navy) 0%, var(--drl-blue) 100%);
            padding: 60px 40px;
            border-right: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            flex-direction: column;
            color: #fff;
            position: relative;
            overflow: hidden;
        }

        .reg-sidebar::before {
            content: '';
            position: absolute;
            inset: 0;
            background: url('{{ asset('uploads/banners/login.png') }}') center/cover no-repeat;
            opacity: 0.1;
            z-index: 1;
        }

        .reg-sidebar-logo {
            font-size: 28px;
            font-weight: 900;
            color: #fff;
            text-decoration: none;
            margin-bottom: 60px;
            position: relative;
            z-index: 10;
        }
        .reg-sidebar-logo span { color: var(--drl-orange); }

        .reg-sidebar-content {
            flex: 1;
            position: relative;
            z-index: 10;
        }

        .reg-sidebar-title {
            font-size: 32px;
            font-weight: 800;
            color: #fff;
            margin-bottom: 24px;
            line-height: 1.2;
        }

        .reg-benefit-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .reg-benefit-item {
            display: flex;
            gap: 16px;
            margin-bottom: 24px;
        }

        .reg-benefit-icon {
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--drl-orange);
            font-size: 18px;
        }

        .reg-benefit-text h5 {
            font-size: 16px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 4px;
        }

        .reg-benefit-text p {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.7);
            margin: 0;
            line-height: 1.5;
        }

        .reg-sidebar-footer {
            position: relative;
            z-index: 10;
        }

        /* Right Side: Forms */
        .reg-form-side {
            flex: 1;
            padding: 60px 80px;
            display: flex;
            flex-direction: column;
        }

        .reg-type-toggle {
            display: flex;
            background: #f1f5f9;
            padding: 6px;
            border-radius: 16px;
            margin-bottom: 40px;
            align-self: flex-start;
        }

        .reg-type-btn {
            padding: 12px 28px;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 700;
            border: 2px solid transparent;
            cursor: pointer;
            transition: all 0.3s;
            color: #475569; /* Darker grey for better non-active contrast */
            background: transparent;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .reg-type-btn:hover {
            color: var(--drl-navy);
            background: rgba(13, 33, 81, 0.05);
        }

        .reg-type-btn.active.pro {
            background: var(--drl-navy);
            color: #fff;
            border-color: var(--drl-navy);
            box-shadow: 0 10px 20px rgba(13, 33, 81, 0.2);
        }

        .reg-type-btn.active.ind {
            background: var(--drl-orange);
            color: #fff;
            border-color: var(--drl-orange);
            box-shadow: 0 10px 20px rgba(232, 80, 26, 0.2);
        }

        /* Form Styling */
        .reg-form-title {
            font-size: 28px;
            font-weight: 800;
            color: var(--drl-navy);
            margin-bottom: 12px;
        }

        .reg-form-sub {
            font-size: 16px;
            color: #64748b;
            margin-bottom: 40px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        .form-group-premium {
            margin-bottom: 24px;
        }

        .form-group-premium label {
            display: block;
            font-size: 14px;
            font-weight: 700;
            color: var(--drl-navy);
            margin-bottom: 8px;
        }

        .form-control-premium, .form-select-premium {
            width: 100%;
            height: 52px;
            background: #f8fafc;
            border: 2px solid #f1f5f9;
            border-radius: 12px;
            padding: 0 16px;
            font-size: 15px;
            font-weight: 500;
            color: var(--drl-navy);
            transition: all 0.2s;
        }

        .form-control-premium::placeholder {
            color: #94a3b8;
        }

        .form-control-premium:focus, .form-select-premium:focus {
            background: #fff;
            border-color: var(--drl-blue);
            box-shadow: 0 0 0 4px rgba(0, 80, 158, 0.1);
            outline: none;
        }

        .modern-checkbox-area {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 32px 0;
        }

        .modern-checkbox {
            width: 22px;
            height: 22px;
            accent-color: var(--drl-orange);
            cursor: pointer;
        }

        .modern-checkbox-area label {
            font-size: 14px;
            color: #475569;
            font-weight: 600;
            cursor: pointer;
        }

        .modern-checkbox-area a {
            color: var(--drl-blue);
            text-decoration: none;
        }

        .btn-reg {
            width: 100%;
            height: 56px;
            background: var(--drl-orange);
            color: #fff;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 8px 24px rgba(232, 80, 26, 0.2);
        }

        .btn-reg:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(232, 80, 26, 0.3);
        }

        .btn-reg-navy { background: var(--drl-navy); box-shadow: 0 8px 24px rgba(13, 33, 81, 0.2); }
        .btn-reg-navy:hover { background: #081636; }

        .reg-footer {
            margin-top: 40px;
            text-align: center;
            font-size: 15px;
            color: #64748b;
        }

        .reg-footer a {
            font-weight: 700;
            color: var(--drl-blue);
            text-decoration: none;
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .reg-sidebar { display: none; }
            .reg-form-side { padding: 40px; }
        }

        @media (max-width: 768px) {
            .form-row { grid-template-columns: 1fr; gap: 0; }
            .reg-main { padding: 20px 10px; }
            .reg-card { border-radius: 16px; }
            .reg-form-side { padding: 30px 20px; }
        }
    </style>
{% endblock %}

{% block body %}
<div class="reg-main">
    <div class="reg-card">
        <!-- Sidebar: Why join our platform? -->
        <div class="reg-sidebar">
            <a href="{{ path('app_home') }}" class="reg-sidebar-logo">Drilleedo<span>.</span></a>
            <div class="reg-sidebar-content">
                <h1 class="reg-sidebar-title">{{ 'security.reg_title'|trans }}</h1>
                
                <div class="reg-benefit-list">
                    <div class="reg-benefit-item">
                        <div class="reg-benefit-icon"><i class="feather-shield"></i></div>
                        <div class="reg-benefit-text">
                            <h5>{{ 'security.reg_ben1'|trans }}</h5>
                            <p>{{ 'security.reg_ben1_desc'|trans }}</p>
                        </div>
                    </div>
                    <div class="reg-benefit-item">
                        <div class="reg-benefit-icon"><i class="feather-message-square"></i></div>
                        <div class="reg-benefit-text">
                            <h5>{{ 'security.reg_ben2'|trans }}</h5>
                            <p>{{ 'security.reg_ben2_desc'|trans }}</p>
                        </div>
                    </div>
                    <div class="reg-benefit-item">
                        <div class="reg-benefit-icon"><i class="feather-trending-up"></i></div>
                        <div class="reg-benefit-text">
                            <h5>{{ 'security.reg_ben3'|trans }}</h5>
                            <p>{{ 'security.reg_ben3_desc'|trans }}</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="reg-sidebar-footer">
                <p style="font-size: 13px; color: #94a3b8; font-weight: 500;">© 2024 Drilleedo Inc. All rights reserved.</p>
            </div>
        </div>

        <!-- Form Side -->
        <div class="reg-form-side">
            <!-- Account Type Switcher -->
            <div class="reg-type-toggle" role="tablist">
                <button class="reg-type-btn active pro" id="professional-tab" type="button">
                    <i class="feather-briefcase"></i> {{ 'security.tab_pro'|trans }}
                </button>
                <button class="reg-type-btn ind" id="individual-tab" type="button">
                    <i class="feather-user"></i> {{ 'security.tab_ind'|trans }}
                </button>
            </div>

            <div class="tab-content w-100">
                <!-- Professional Form -->
                <div class="tab-pane fade show active" id="tab-professional" role="tabpanel">
                    <h2 class="reg-form-title">{{ 'security.join_pro'|trans }}</h2>
                    <p class="reg-form-sub">{{ 'security.join_pro_sub'|trans }}</p>

                    {{ form_start(professionalForm, {'attr': {'class': 'rbt-form-modern', 'novalidate': 'novalidate'}}) }}
                        {% if not professionalForm.vars.valid %}
                            <div class="alert alert-danger border-0 rounded-4 p-3 mb-4" style="background: #fff1f2; color: #e11d48; font-size: 14px;">Resolve highlighting below.</div>
                        {% endif %}

                        <div class="form-row">
                            <div class="form-group-premium">
                                <label>{{ 'security.lbl_business_email'|trans }}</label>
                                {{ form_widget(professionalForm.email, {'attr': {'class': 'form-control-premium', 'placeholder': 'pro@company.ca'}}) }}
                                <div class="text-danger small mt-1 font-weight-bold">{{ form_errors(professionalForm.email) }}</div>
                            </div>
                            <div class="form-group-premium">
                                <label>{{ 'security.lbl_secure_password'|trans }}</label>
                                {{ form_widget(professionalForm.plainPassword, {'attr': {'class': 'form-control-premium', 'placeholder': '••••••••'}}) }}
                                <div class="text-danger small mt-1 font-weight-bold">{{ form_errors(professionalForm.plainPassword) }}</div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group-premium">
                                <label>{{ 'security.lbl_sector'|trans }}</label>
                                {{ form_widget(professionalForm.parentCategory, {'attr': {'class': 'form-select-premium parent-category-select selectpicker', 'data-live-search': 'true'}}) }}
                                <div class="text-danger small mt-1 font-weight-bold">{{ form_errors(professionalForm.parentCategory) }}</div>
                            </div>
                            <div class="form-group-premium">
                                <label>{{ 'security.lbl_service'|trans }}</label>
                                {{ form_widget(professionalForm.category, {'attr': {'class': 'form-select-premium child-category-select selectpicker', 'data-live-search': 'true', 'data-selected-id': professionalForm.category.vars.data ? professionalForm.category.vars.data.id : ''}}) }}
                                <div class="text-danger small mt-1 font-weight-bold">{{ form_errors(professionalForm.category) }}</div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group-premium">
                                <label>{{ 'security.lbl_city'|trans }}</label>
                                {{ form_widget(professionalForm.city, {'attr': {'class': 'form-control-premium', 'placeholder': 'e.g. Montreal'}}) }}
                                <div class="text-danger small mt-1 font-weight-bold">{{ form_errors(professionalForm.city) }}</div>
                            </div>
                            <div class="form-group-premium">
                                <label>{{ 'security.lbl_exp'|trans }}</label>
                                {{ form_widget(professionalForm.expYears, {'attr': {'class': 'form-control-premium', 'placeholder': 'Total years'}}) }}
                                <div class="text-danger small mt-1 font-weight-bold">{{ form_errors(professionalForm.expYears) }}</div>
                            </div>
                        </div>

                        <div class="modern-checkbox-area">
                            {{ form_widget(professionalForm.agreeTerms, {'attr': {'id': 'pro-terms', 'class': 'modern-checkbox'}}) }}
                            <label for="pro-terms">{{ 'security.agree_pro'|trans|raw }}</label>
                        </div>

                        <button type="submit" class="btn-reg btn-reg-navy">
                            {{ 'security.btn_reg_pro'|trans }} <i class="feather-arrow-right"></i>
                        </button>
                    {{ form_end(professionalForm) }}
                </div>

                <!-- Individual Form -->
                <div class="tab-pane fade" id="tab-individual" role="tabpanel">
                    <h2 class="reg-form-title">{{ 'security.join_ind'|trans }}</h2>
                    <p class="reg-form-sub">{{ 'security.join_ind_sub'|trans }}</p>

                    {{ form_start(individualForm, {'attr': {'class': 'rbt-form-modern', 'novalidate': 'novalidate'}}) }}
                        {% if not individualForm.vars.valid %}
                            <div class="alert alert-danger border-0 rounded-4 p-3 mb-4" style="background: #fff1f2; color: #e11d48; font-size: 14px;">Resolve highlighting below.</div>
                        {% endif %}

                        <div class="form-group-premium">
                            <label>{{ 'security.lbl_personal_email'|trans }}</label>
                            {{ form_widget(individualForm.email, {'attr': {'class': 'form-control-premium', 'placeholder': 'my@email.com'}}) }}
                            <div class="text-danger small mt-1 font-weight-bold">{{ form_errors(individualForm.email) }}</div>
                        </div>

                        <div class="form-group-premium">
                            <label>{{ 'security.lbl_secure_password'|trans }}</label>
                            {{ form_widget(individualForm.plainPassword, {'attr': {'class': 'form-control-premium', 'placeholder': '••••••••'}}) }}
                            <div class="text-danger small mt-1 font-weight-bold">{{ form_errors(individualForm.plainPassword) }}</div>
                        </div>

                        <div class="modern-checkbox-area">
                            {{ form_widget(individualForm.agreeTerms, {'attr': {'id': 'ind-terms', 'class': 'modern-checkbox'}}) }}
                            <label for="ind-terms">{{ 'security.agree_ind'|trans|raw }}</label>
                        </div>

                        <button type="submit" class="btn-reg">
                            {{ 'security.btn_reg_ind'|trans }} <i class="feather-arrow-right"></i>
                        </button>
                    {{ form_end(individualForm) }}
                </div>
            </div>

            <div class="reg-footer">
                {{ 'security.already_account'|trans }} <a href="{{ path('app_login') }}">{{ 'security.signin_here'|trans }}</a>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Optimized Manual Tab Switching Logic
        const proBtn = document.getElementById('professional-tab');
        const indBtn = document.getElementById('individual-tab');
        const proPane = document.getElementById('tab-professional');
        const indPane = document.getElementById('tab-individual');
        
        function switchTo(type) {
            if (type === 'pro') {
                // Button styles
                proBtn.classList.add('active', 'pro');
                indBtn.classList.remove('active', 'ind');
                // Pane visibility
                proPane.classList.add('show', 'active');
                indPane.classList.remove('show', 'active');
            } else {
                // Button styles
                indBtn.classList.add('active', 'ind');
                proBtn.classList.remove('active', 'pro');
                // Pane visibility
                indPane.classList.add('show', 'active');
                proPane.classList.remove('show', 'active');
            }
        }

        proBtn.addEventListener('click', function(e) {
            e.preventDefault();
            switchTo('pro');
        });
        
        indBtn.addEventListener('click', function(e) {
            e.preventDefault();
            switchTo('ind');
        });
        
        // Restore the correct tab after a validation error (check which form was submitted)
        const proFormHasErrors = document.querySelector('#tab-professional .text-danger:not(:empty)');
        const indFormHasErrors = document.querySelector('#tab-individual .text-danger:not(:empty)');
        if (indFormHasErrors && !proFormHasErrors) {
            switchTo('ind');
        } else {
            switchTo('pro');
        }

        // Logic for checkbox IDs and labels association
        const checkWrappers = document.querySelectorAll('.modern-checkbox-area');
        checkWrappers.forEach(wrapper => {
            const label = wrapper.querySelector('label');
            const checkbox = wrapper.querySelector('input[type="checkbox"]');
            if (checkbox && label) {
                const id = label.getAttribute('for');
                if (id) checkbox.id = id;
            }
        });
    });
</script>
{% endblock %}
