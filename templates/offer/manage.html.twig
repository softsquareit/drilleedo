{% extends 'individual/base_individual.html.twig' %}

{% block title %}Manage Offers - {{ quote.title }}{% endblock %}

{% block body %}
    <div class="pro-card pro-card-elevated">
        <div class="pro-card-header">
            <div>
                <h4 class="pro-card-title">Offers for: {{ quote.title }}</h4>
                <p class="pro-card-subtitle">Review and select the best provider for your request</p>
            </div>
            <a href="{{ path('individual_quote_show', {id: quote.id}) }}" class="pro-btn pro-btn-outline pro-btn-sm">
                <i class="feather-arrow-left"></i> Back to Quote
            </a>
        </div>

        <div class="pro-table-wrapper">
            <table class="pro-table">
                <thead>
                    <tr>
                        <th>Provider</th>
                        <th>Price</th>
                        <th>Documents</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for offer in offers %}
                        <tr>
                            <th>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="thumbnail rbt-avatars size-sm">
                                        {% if offer.provider.logo %}
                                            <img src="{{ asset('uploads/logos/' ~ offer.provider.logo) }}" alt="Logo" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;">
                                        {% else %}
                                            <img src="{{ asset('assets/drilleedo/images/team/avatar.jpg') }}" alt="Logo" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;">
                                        {% endif %}
                                    </div>
                                    <div>
                                        <span class="pro-fw-semibold d-block">{{ offer.provider.companyName }}</span>
                                        <small class="pro-text-muted">{{ offer.provider.city }}</small>
                                    </div>
                                </div>
                                <div class="mt-2 pro-text-muted small">
                                    {{ offer.description|slice(0, 100) }}...
                                </div>
                            </th>
                            <td>
                                <span class="pro-text-primary pro-fw-bold">${{ offer.price }}</span>
                            </td>
                            <td>
                                {% if offer.documents|length > 0 %}
                                    <div class="d-flex flex-wrap gap-1">
                                        {% for doc in offer.documents %}
                                            <a href="{{ asset('uploads/offers/' ~ doc) }}" target="_blank" class="pro-badge info" title="Download">
                                                <i class="feather-file"></i>
                                            </a>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <span class="pro-text-muted small">None</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if offer.status == 'PENDING' %}
                                    <span class="pro-badge primary">New</span>
                                {% elseif offer.status == 'SELECTED' %}
                                    <span class="pro-badge warning">Selected</span>
                                {% elseif offer.status == 'ACCEPTED' %}
                                    <span class="pro-badge success">Accepted</span>
                                {% elseif offer.status == 'REJECTED' or offer.status == 'DECLINED_BY_PROVIDER' %}
                                    <span class="pro-badge danger">Declined</span>
                                {% else %}
                                    <span class="pro-badge secondary">{{ offer.status }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button class="pro-btn pro-btn-outline pro-btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Actions <i class="feather-chevron-down ms-1"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end p-2 border-0 shadow-sm">
                                        {% if offer.status == 'PENDING' %}
                                            <li><a class="dropdown-item rounded py-2" href="{{ path('offer_status', {id: offer.id, status: 'SELECTED'}) }}"><i class="feather-check text-success me-2"></i> Select this Offer</a></li>
                                            <li><a class="dropdown-item rounded py-2 text-danger" href="{{ path('offer_status', {id: offer.id, status: 'REJECTED'}) }}"><i class="feather-x me-2"></i> Reject Offer</a></li>
                                        {% endif %}
                                        <li><a class="dropdown-item rounded py-2" href="{{ path('professional_public_show', {id: offer.provider.id}) }}" target="_blank"><i class="feather-user me-2"></i> View Profile</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="pro-table-empty">
                                <div class="pro-empty-state">
                                    <div class="pro-empty-icon">
                                        <i class="feather-inbox"></i>
                                    </div>
                                    <h6 class="pro-empty-title">No offers yet</h6>
                                    <p class="pro-empty-text">No providers have sent offers for this quote request yet.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
