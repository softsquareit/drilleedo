{% extends app.user and is_granted('ROLE_PROFESSIONAL') ? 'professional/base_professional.html.twig' : (app.user and is_granted('ROLE_COMPANY') ? 'company/base_company.html.twig' : 'base.html.twig') %}

{% block title %}Complete Request - {{ quote.title }}{% endblock %}

{% block body %}
    <div class="pro-card pro-card-elevated mx-auto" style="max-width: 700px;">
        <div class="pro-card-header text-center" style="border-bottom: none; padding-bottom: 0;">
            <div style="width: 100%;">
                <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(16,185,129,0.12); display:inline-flex; align-items:center; justify-content:center; margin-bottom:16px;">
                    <i class="feather-check-circle" style="font-size:1.75rem; color:#10b981;"></i>
                </div>
                <h4 class="pro-card-title">Finalize This Request</h4>
                <p class="pro-card-subtitle">Confirm that the work for "{{ quote.title }}" is complete</p>
            </div>
        </div>
        
        <div class="pro-card-body">
            {# Offer Summary #}
            <div class="pro-alert info mb-4" style="border-radius: var(--pro-radius-md, 8px);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong>Your Offer</strong>
                    <span class="pro-badge success">Accepted</span>
                </div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="feather-dollar-sign" style="font-size:0.85rem;"></i>
                    <strong style="font-size:1.1rem;">{{ offer.price|number_format(2) }} $</strong>
                </div>
                <p class="pro-text-muted small mb-0">{{ offer.description|slice(0, 150) }}{% if offer.description|length > 150 %}...{% endif %}</p>
            </div>

            {# Client Info #}
            {% set clientName = quote.individual and quote.individual.personalInfos ? (quote.individual.personalInfos.firstName|default('') ~ ' ' ~ quote.individual.personalInfos.lastName|default(''))|trim : '' %}
            <p class="mb-4 text-center">
                By finalizing, you confirm that the work for 
                <strong>{{ clientName ?: quote.individual.email|default('the client') }}</strong> 
                is complete. The request will be marked as <strong>Closed</strong>.
            </p>

            {# Actions #}
            <div class="d-flex flex-column gap-3">
                <form method="post" action="{{ path('offer_finalize', {id: offer.id}) }}" onsubmit="return confirm('Are you sure? This will close the request permanently.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('finalize-offer-' ~ offer.id) }}">
                    <button type="submit" class="pro-btn pro-btn-primary pro-btn-lg w-100">
                        <i class="feather-check"></i> Mark as Completed
                    </button>
                </form>
                <a href="{{ is_granted('ROLE_COMPANY') ? path('company_dashboard') : path('professional_offers') }}" class="pro-btn pro-btn-outline pro-btn-lg w-100">
                    <i class="feather-arrow-left"></i> Go Back
                </a>
            </div>
        </div>
    </div>
{% endblock %}
