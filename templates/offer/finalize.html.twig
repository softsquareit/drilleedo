{% extends app.user and is_granted('ROLE_PROFESSIONAL') ? 'professional/base_professional.html.twig' : (app.user and is_granted('ROLE_COMPANY') ? 'company/base_company.html.twig' : 'base.html.twig') %}

{% block title %}Finalize Selection - {{ quote.title }}{% endblock %}

{% block body %}
    <div class="pro-card pro-card-elevated max-width-700 mx-auto">
        <div class="pro-card-header text-center">
            <div class="pro-icon-box pro-icon-box-lg pro-icon-box-success mx-auto mb-3">
                <i class="feather-check-circle"></i>
            </div>
            <h4 class="pro-card-title">You've Been Selected!</h4>
            <p class="pro-card-subtitle">The client is interested in your offer for "{{ quote.title }}". Please confirm if you can take this job.</p>
        </div>
        
        <div class="pro-card-body">
            <div class="pro-alert info mb-4">
                <p class="mb-0"><strong>Your Offer:</strong> ${{ offer.price }}</p>
                <p class="pro-text-muted small mt-1">{{ offer.description|slice(0, 100) }}...</p>
            </div>

            <p class="mb-4 text-center">Confirming will share your contact details (Email and Phone) with <strong>{{ quote.individual.firstName }} {{ quote.individual.lastName }}</strong> so you can finalize the work details.</p>

            <div class="d-flex flex-column gap-3">
                <a href="{{ path('offer_finalize_action', {id: offer.id, decision: 'ACCEPT'}) }}" class="pro-btn pro-btn-primary pro-btn-lg w-100">
                    <i class="feather-check"></i> I Accept this Job
                </a>
                <a href="{{ path('offer_finalize_action', {id: offer.id, decision: 'REJECT'}) }}" class="pro-btn pro-btn-outline pro-btn-lg w-100 text-danger" onclick="return confirm('Are you sure you want to decline this job opportunity?');">
                    <i class="feather-x"></i> Decline Job
                </a>
            </div>
        </div>
        
        <div class="pro-card-footer text-center">
            <a href="{{ is_granted('ROLE_COMPANY') ? path('company_dashboard') : path('professional_dashboard') }}" class="pro-link">Go back to Dashboard</a>
        </div>
    </div>
{% endblock %}
