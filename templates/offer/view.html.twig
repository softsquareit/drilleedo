{% extends app.user and is_granted('ROLE_PROFESSIONAL') ? 'professional/base_professional.html.twig' : (app.user and is_granted('ROLE_COMPANY') ? 'company/base_company.html.twig' : 'base.html.twig') %}

{% block title %}Offer Details{% endblock %}

{% block body %}
    <div class="mb-3">
        <a href="{{ is_granted('ROLE_COMPANY') ? path('company_dashboard') : path('professional_offers') }}" class="pro-link">
            <i class="feather-arrow-left"></i> Back to My Offers
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            {# ── Offer Details ── #}
            <div class="pro-card pro-card-elevated mb-4">
                <div class="pro-card-header">
                    <h4 class="pro-card-title">Your Offer</h4>
                    {% if offer.status == 'PENDING' %}
                        <span class="pro-badge primary">Pending</span>
                    {% elseif offer.status == 'ACCEPTED' %}
                        <span class="pro-badge success">Accepted</span>
                    {% elseif offer.status == 'REJECTED' %}
                        <span class="pro-badge danger">Rejected</span>
                    {% else %}
                        <span class="pro-badge secondary">{{ offer.status }}</span>
                    {% endif %}
                </div>
                <div class="pro-card-body">
                    <div class="d-flex align-items-center gap-3 mb-4" style="padding:16px; background: rgba(16,185,129,0.06); border-radius: var(--pro-radius-md, 8px); border: 1px solid rgba(16,185,129,0.15);">
                        <i class="feather-dollar-sign" style="font-size:1.5rem; color:#10b981;"></i>
                        <div>
                            <small class="pro-text-muted d-block">Your Proposed Price</small>
                            <strong style="font-size:1.5rem; color:#10b981;">{{ offer.price|number_format(2) }} $</strong>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="pro-form-label" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.04em; color:#94a3b8;">Message to Client</label>
                        <p style="white-space: pre-line;">{{ offer.description }}</p>
                    </div>

                    {% if offer.documents|length > 0 %}
                        <div class="mb-3">
                            <label class="pro-form-label" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.04em; color:#94a3b8;">Attached Documents</label>
                            <div class="d-flex flex-wrap gap-2">
                                {% for doc in offer.documents %}
                                    <a href="{{ asset('uploads/offers/' ~ doc) }}" target="_blank" class="pro-btn pro-btn-outline pro-btn-sm">
                                        <i class="feather-file"></i> Document {{ loop.index }}
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center gap-2">
                                <i class="feather-calendar" style="color:#94a3b8;"></i>
                                <div>
                                    <small class="pro-text-muted d-block">Submitted on</small>
                                    <span class="pro-fw-semibold">{{ offer.createdAt|date('M d, Y \\a\\t H:i') }}</span>
                                </div>
                            </div>
                        </div>
                        {% if offer.updatedAt %}
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="feather-edit-3" style="color:#94a3b8;"></i>
                                    <div>
                                        <small class="pro-text-muted d-block">Last updated</small>
                                        <span class="pro-fw-semibold">{{ offer.updatedAt|date('M d, Y \\a\\t H:i') }}</span>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# ── Actions ── #}
            <div class="d-flex gap-2 flex-wrap">
                {% if offer.status == 'PENDING' and offer.quoteRequest %}
                    <a href="{{ path('offer_send', {id: offer.quoteRequest.id}) }}" class="pro-btn pro-btn-primary">
                        <i class="feather-edit-2"></i> Edit Offer
                    </a>
                    <form method="post" action="{{ path('offer_delete', {id: offer.id}) }}" style="display:inline;" onsubmit="return confirm('Delete this offer?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-offer-' ~ offer.id) }}">
                        <button type="submit" class="pro-btn" style="background:rgba(239,68,68,0.1); color:#ef4444; border:1px solid rgba(239,68,68,0.3);">
                            <i class="feather-trash-2"></i> Delete
                        </button>
                    </form>
                {% endif %}
                {% if offer.status == 'ACCEPTED' and offer.quoteRequest and offer.quoteRequest.status != 'Closed' %}
                    <form method="post" action="{{ path('offer_finalize', {id: offer.id}) }}" style="display:inline;" onsubmit="return confirm('Mark this request as completed?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('finalize-offer-' ~ offer.id) }}">
                        <button type="submit" class="pro-btn pro-btn-success">
                            <i class="feather-check-circle"></i> Finalize Request
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>

        {# ── Quote Request Info ── #}
        <div class="col-lg-4">
            {% if quote %}
                <div class="pro-card pro-card-elevated sticky-top" style="top: 100px;">
                    <div class="pro-card-header">
                        <h5 class="pro-card-title">Quote Request</h5>
                    </div>
                    <div class="pro-card-body">
                        <h6 class="mb-2">{{ quote.title }}</h6>
                        <p class="pro-text-muted mb-3" style="font-size:1rem;">{{ quote.description|slice(0, 200) }}{% if quote.description|length > 200 %}...{% endif %}</p>
                        
                        {% if quote.category %}
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="feather-tag" style="color:#94a3b8; font-size:0.85rem;"></i>
                                <span class="pro-badge info" >{{ quote.category.name }}</span>
                            </div>
                        {% endif %}

                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="feather-calendar" style="color:#94a3b8; font-size:0.85rem;"></i>
                            <small class="pro-text-muted">{{ quote.creationDate|date('M d, Y') }}</small>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <i class="feather-info" style="color:#94a3b8; font-size:0.85rem;"></i>
                            {% if quote.status == 'Closed' %}
                                <span class="pro-badge secondary" >Closed</span>
                            {% elseif quote.status == 'Accepted' %}
                                <span class="pro-badge success" >Accepted</span>
                            {% else %}
                                <span class="pro-badge primary" >{{ quote.status }}</span>
                            {% endif %}
                        </div>

                        {# Client contact — revealed only if offer is ACCEPTED #}
                        {% if offer.status == 'ACCEPTED' and quote.individual %}
                            <div class="mt-4 p-3" style="background:rgba(16,185,129,0.06); border-radius:var(--pro-radius-md,8px); border:1px solid rgba(16,185,129,0.15);">
                                <label class="pro-form-label mb-2" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.04em; color:#10b981;">
                                    <i class="feather-unlock" ></i> Client Contact
                                </label>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="feather-mail" style="font-size:0.85rem; color:#10b981;"></i>
                                    <a href="mailto:{{ quote.individual.email }}" style="color:#10b981;">{{ quote.individual.email }}</a>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
