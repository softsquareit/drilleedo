{% extends app.user and is_granted('ROLE_PROFESSIONAL') ? 'professional/base_professional.html.twig' : (app.user and is_granted('ROLE_COMPANY') ? 'company/base_company.html.twig' : 'base.html.twig') %}

{% block title %}Offer Details{% endblock %}

{% block body %}
    <div class="mb-4">
        <a href="{{ is_granted('ROLE_COMPANY') ? path('company_dashboard') : path('professional_offers') }}" class="pro-link d-inline-flex align-items-center gap-2">
            <i class="ph-bold ph-arrow-left"></i>
            <span>Back to My Offers</span>
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            {# ── Offer Details ── #}
            <div class="pro-card pro-card-elevated mb-4">
                <div class="pro-card-header d-flex justify-content-between align-items-center">
                    <h4 class="pro-card-title mb-0">Your Offer</h4>
                    {% if offer.status == 'DRAFT' %}
                        <span class="pro-badge warning">Brouillon</span>
                    {% elseif offer.status == 'PUBLISHED' %}
                        <span class="pro-badge info">Envoyée</span>
                    {% elseif offer.status == 'ACCEPTED' %}
                        <span class="pro-badge success">Acceptée</span>
                    {% elseif offer.status == 'REJECTED' %}
                        <span class="pro-badge danger">Refusée</span>
                    {% elseif offer.status == 'CLOSED' %}
                        <span class="pro-badge secondary">Terminée</span>
                    {% else %}
                        <span class="pro-badge secondary">{{ offer.status }}</span>
                    {% endif %}
                </div>
                <div class="pro-card-body">
                    <div class="p-4 mb-4" style="background: rgba(16, 185, 129, 0.04); border-radius: 16px; border: 1px solid rgba(16, 185, 129, 0.1);">
                        <div class="d-flex align-items-center gap-3">
                            <div class="flex-shrink-0 bg-white shadow-sm d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; border-radius: 12px;">
                                <i class="ph-bold ph-currency-dollar" style="font-size: 1.5rem; color: #10b981;"></i>
                            </div>
                            <div>
                                <small class="pro-text-muted d-block" style="text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.75rem;">Your Proposed Price</small>
                                <strong class="h3 mb-0" style="color: #0f172a;">{{ offer.price|number_format(2) }} $</strong>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="pro-form-label mb-2 d-block" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted);">
                            <i class="ph-bold ph-chat-centered-text me-1"></i> Message to Client
                        </label>
                        <div class="p-3 bg-light rounded-3" style="white-space: pre-line; color: var(--color-text-body); line-height: 1.6;">{{ offer.description }}</div>
                    </div>

                    {% if offer.documents|length > 0 %}
                        <div class="mb-4">
                            <label class="pro-form-label mb-2 d-block" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted);">
                                <i class="ph-bold ph-paperclip me-1"></i> Attached Documents
                            </label>
                            <div class="d-flex flex-wrap gap-2">
                                {% for doc in offer.documents %}
                                    <a href="{{ asset('uploads/offers/' ~ doc) }}" target="_blank" class="pro-btn pro-btn-outline pro-btn-sm rounded-pill d-inline-flex align-items-center gap-2">
                                        <i class="ph-bold ph-file-pdf"></i>
                                        <span>Document {{ loop.index }}</span>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    {# ── Nouveaux champs de l'offre ── #}
                    <div class="row g-3 mb-4">
                        {% if offer.priorVisit is not null %}
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3">
                                    <div class="bg-white d-flex align-items-center justify-content-center shadow-sm" style="width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0;">
                                        <i class="ph-bold ph-eye" style="color: var(--color-text-muted);"></i>
                                    </div>
                                    <div>
                                        <small class="pro-text-muted d-block" style="text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.05em;">Visite préalable</small>
                                        <span class="pro-fw-semibold">{{ offer.priorVisit ? 'Oui' : 'Non' }}</span>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        {% if offer.possibleStartDate %}
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3">
                                    <div class="bg-white d-flex align-items-center justify-content-center shadow-sm" style="width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0;">
                                        <i class="ph-bold ph-calendar-check" style="color: var(--color-text-muted);"></i>
                                    </div>
                                    <div>
                                        <small class="pro-text-muted d-block" style="text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.05em;">Date possible de début</small>
                                        <span class="pro-fw-semibold">{{ offer.possibleStartDate|date('d/m/Y') }}</span>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        {% if offer.estimatedDuration %}
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3">
                                    <div class="bg-white d-flex align-items-center justify-content-center shadow-sm" style="width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0;">
                                        <i class="ph-bold ph-timer" style="color: var(--color-text-muted);"></i>
                                    </div>
                                    <div>
                                        <small class="pro-text-muted d-block" style="text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.05em;">Délai de réalisation</small>
                                        <span class="pro-fw-semibold">{{ offer.estimatedDuration }} {{ offer.estimatedDurationUnit ?? 'jours' }}</span>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>

                    <div class="row g-3 border-top pt-4 mt-2">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-light d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; border-radius: 10px;">
                                    <i class="ph-bold ph-calendar" style="color: var(--color-text-muted);"></i>
                                </div>
                                <div>
                                    <small class="pro-text-muted d-block">Soumis le</small>
                                    <span class="pro-fw-semibold">{{ offer.createdAt|date('d/m/Y \\à H:i') }}</span>
                                </div>
                            </div>
                        </div>
                        {% if offer.updatedAt %}
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-light d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; border-radius: 10px;">
                                        <i class="ph-bold ph-clock-counter-clockwise" style="color: var(--color-text-muted);"></i>
                                    </div>
                                    <div>
                                        <small class="pro-text-muted d-block">Dernière mise à jour</small>
                                        <span class="pro-fw-semibold">{{ offer.updatedAt|date('d/m/Y \\à H:i') }}</span>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# ── Actions ── #}
            <div class="d-flex gap-3 flex-wrap">
                {% if offer.status == 'DRAFT' %}
                    <form method="post" action="{{ path('offer_delete', {id: offer.id}) }}" class="d-inline" data-confirm="Delete this offer?">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-offer-' ~ offer.id) }}">
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-4 py-2 d-inline-flex align-items-center gap-2">
                            <i class="ph-bold ph-trash"></i> Delete Draft
                        </button>
                    </form>
                {% endif %}
                {% set activeReq = offer.quoteRequest ?? offer.directRequest %}
                {% if offer.status == 'ACCEPTED' and activeReq and activeReq.status|upper != 'CLOSED' %}
                    <form method="post" action="{{ path('offer_finalize', {id: offer.id}) }}" class="d-inline" data-confirm="Confirmer la fin des travaux ? Le client sera notifié.">
                        <input type="hidden" name="_token" value="{{ csrf_token('finalize-offer-' ~ offer.id) }}">
                        <button type="submit" class="pro-btn pro-btn-success rounded-pill px-4 py-2 d-inline-flex align-items-center gap-2">
                            <i class="ph-bold ph-check-circle"></i> Terminer la mission
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>

        {# ── Request Context Sidebar ── #}
        <div class="col-lg-4">
            {% set activeRequest = quote ?? directRequest %}
            {% if activeRequest %}
                <div class="pro-card pro-card-elevated sticky-top" style="top: 100px;">
                    <div class="pro-card-header">
                        <h5 class="pro-card-title mb-0">
                            {{ quote ? 'Quote Request' : 'Direct Request' }}
                        </h5>
                    </div>
                    <div class="pro-card-body">
                        <h6 class="pro-fw-bold mb-2">{{ activeRequest.title }}</h6>
                        <p class="pro-text-muted mb-4 small" style="line-height: 1.6;">
                            {{ activeRequest.description|slice(0, 180) }}{% if activeRequest.description|length > 180 %}...{% endif %}
                        </p>
                        
                        <div class="space-y-3">
                            {% if quote and quote.category %}
                                <div class="d-flex align-items-center gap-3">
                                    <i class="ph-bold ph-tag text-muted"></i>
                                    <span class="pro-badge info">{{ quote.category.name }}</span>
                                </div>
                            {% endif %}

                            <div class="d-flex align-items-center gap-3">
                                <i class="ph-bold ph-calendar-blank text-muted"></i>
                                <small class="pro-text-muted">
                                    {{ quote ? quote.creationDate|date('d/m/Y') : activeRequest.creationDate|date('d/m/Y') }}
                                </small>
                            </div>

                            {% if activeRequest.desiredStartDate %}
                                <div class="d-flex align-items-center gap-3">
                                    <i class="ph-bold ph-calendar-check text-muted"></i>
                                    <div>
                                        <small class="pro-text-muted d-block" style="font-size: 0.7rem;">Début souhaité</small>
                                        <span class="pro-fw-semibold small">{{ activeRequest.desiredStartDate|date('d/m/Y') }}</span>
                                    </div>
                                </div>
                            {% endif %}

                            {% if activeRequest.urgentIntervention %}
                                <div class="d-flex align-items-center gap-3">
                                    <i class="ph-bold ph-lightning text-muted"></i>
                                    <span class="pro-badge danger">Intervention urgente</span>
                                </div>
                            {% endif %}

                            {% if activeRequest.availabilities|length > 0 %}
                                <div class="d-flex align-items-start gap-3">
                                    <i class="ph-bold ph-clock text-muted mt-1"></i>
                                    <div>
                                        <small class="pro-text-muted d-block" style="font-size: 0.7rem;">Disponibilités</small>
                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                            {% for dispo in activeRequest.availabilities %}
                                                <span class="pro-badge secondary" style="font-size: 0.7rem;">{{ dispo }}</span>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}

                            {% if activeRequest.languages|length > 0 %}
                                <div class="d-flex align-items-start gap-3">
                                    <i class="ph-bold ph-globe text-muted mt-1"></i>
                                    <div>
                                        <small class="pro-text-muted d-block" style="font-size: 0.7rem;">Langue(s) souhaitée(s)</small>
                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                            {% for lang in activeRequest.languages %}
                                                <span class="pro-badge info" style="font-size: 0.7rem;">{{ lang }}</span>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}

                            <div class="d-flex align-items-center gap-3">
                                <i class="ph-bold ph-info text-muted"></i>
                                {% set reqStatus = activeRequest.status|upper %}
                                {% if reqStatus == 'CLOSED' %}
                                    <span class="pro-badge secondary">Clôturée</span>
                                {% elseif reqStatus == 'IN_PROGRESS' %}
                                    <span class="pro-badge warning">En cours</span>
                                {% elseif reqStatus == 'ACCEPTED' %}
                                    <span class="pro-badge success">Acceptée</span>
                                {% elseif reqStatus == 'PUBLISHED' %}
                                    <span class="pro-badge info">Publiée</span>
                                {% else %}
                                    <span class="pro-badge primary">{{ activeRequest.status }}</span>
                                {% endif %}
                            </div>
                        </div>

                        {# Client contact revealed only if offer is ACCEPTED #}
                        {% if offer.status == 'ACCEPTED' and activeRequest.individual %}
                            <div class="mt-4 p-4" style="background: rgba(16, 185, 129, 0.05); border-radius: 12px; border: 1px dashed rgba(16, 185, 129, 0.3);">
                                <label class="pro-form-label mb-3 d-block" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: #10b981; font-weight: 800;">
                                    <i class="ph-bold ph-lock-key-open me-1"></i> Client Contact
                                </label>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-white shadow-sm d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; border-radius: 8px;">
                                        <i class="ph-bold ph-envelope-simple" style="color: #10b981;"></i>
                                    </div>
                                    <a href="mailto:{{ activeRequest.individual.email }}" class="pro-fw-bold" style="color: #10b981; text-decoration: none;">
                                        {{ activeRequest.individual.email }}
                                    </a>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
